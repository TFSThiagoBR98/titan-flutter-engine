# Why: give every target CPU and libc a deterministic default sysroot while
# preserving explicit target_sysroot values and the x64 glibc Chromium sysroot.
diff --git a/engine/src/build/config/sysroot.gni b/engine/src/build/config/sysroot.gni
index 12c8df99f44..2dffbcd94b2 100644
--- a/engine/src/build/config/sysroot.gni
+++ b/engine/src/build/config/sysroot.gni
@@ -23,14 +23,50 @@ if (current_toolchain == default_toolchain && target_sysroot != "") {
 } else if (is_linux && !is_chromeos) {
   if (use_default_linux_sysroot && !is_fuchsia) {
     if (current_cpu == "x64") {
-      sysroot =
-          rebase_path("//build/linux/debian_bullseye_amd64-sysroot", root_build_dir)
+      if (current_toolchain == default_toolchain && titan_target_libc == "musl") {
+        sysroot = rebase_path("//build/linux/titan_x64_musl-sysroot", root_build_dir)
+      } else {
+        # Keep the Chromium Debian sysroot for the x64 glibc bundle and host tools.
+        sysroot = rebase_path(
+            "//build/linux/debian_bullseye_amd64-sysroot", root_build_dir)
+      }
     } else if (current_cpu == "arm64") {
