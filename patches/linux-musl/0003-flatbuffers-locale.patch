# Why: disable flatbuffers locale helpers absent from musl despite its X/Open
# version macro.
diff --git a/engine/src/flutter/build/secondary/flutter/third_party/flatbuffers/BUILD.gn b/engine/src/flutter/build/secondary/flutter/third_party/flatbuffers/BUILD.gn
index a760addb04a..da1c8cda8d7 100644
--- a/engine/src/flutter/build/secondary/flutter/third_party/flatbuffers/BUILD.gn
+++ b/engine/src/flutter/build/secondary/flutter/third_party/flatbuffers/BUILD.gn
@@ -8,6 +8,11 @@ config("flatbuffers_public_configs") {
   include_dirs = [ "$_src_root/include" ]
 
   cflags = [ "-Wno-newline-eof" ]
+
+  if (titan_target_libc == "musl") {
+    # musl reports _XOPEN_VERSION 700 but has no strtoll_l/strtoull_l.
+    defines = [ "FLATBUFFERS_LOCALE_INDEPENDENT=0" ]
+  }
 }
 
