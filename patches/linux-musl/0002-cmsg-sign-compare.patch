# Why: silence the musl CMSG_NXTHDR sign comparison that becomes an error in
# Dart's socket code.
diff --git a/engine/src/build/config/compiler/BUILD.gn b/engine/src/build/config/compiler/BUILD.gn
index ad938db2379..b8325b02427 100644
--- a/engine/src/build/config/compiler/BUILD.gn
+++ b/engine/src/build/config/compiler/BUILD.gn
@@ -840,6 +840,12 @@ config("chromium_code") {
       ]
     }
 
+    if (titan_target_libc == "musl") {
+      # musl's CMSG_NXTHDR compares size_t with ptrdiff_t inside the macro,
+      # which -Wsign-compare rejects in Dart's socket code. Must follow -Wextra.
+      cflags += [ "-Wno-sign-compare" ]
+    }
+
     # In Chromium code, we define __STDC_foo_MACROS in order to get the
     # C99 macros on Mac and Linux.
     defines = [
