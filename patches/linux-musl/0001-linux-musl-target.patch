# Why: the Kindle target uses the Buildroot musl sysroot instead of glibc.
# Select its ARM soft-float target triple and sysroot only when requested;
# glibc remains the default for every existing target.
diff --git a/engine/src/build/config/BUILDCONFIG.gn b/engine/src/build/config/BUILDCONFIG.gn
--- a/engine/src/build/config/BUILDCONFIG.gn
+++ b/engine/src/build/config/BUILDCONFIG.gn
@@ -115,6 +115,9 @@
 #   even if the value is overridden, which is wasteful. See first bullet.
 
 declare_args() {
+  # Select the libc used by TitanDM's non-default Linux target sysroots.
+  titan_target_libc = "glibc"
+
   # How many symbols to include in the build. This affects the performance of
   # the build since the symbols are large and dealing with them is slow.
   #   2 means regular build with symbols.
diff --git a/engine/src/build/config/compiler/BUILD.gn b/engine/src/build/config/compiler/BUILD.gn
--- a/engine/src/build/config/compiler/BUILD.gn
+++ b/engine/src/build/config/compiler/BUILD.gn
@@ -412,7 +412,10 @@
       ldflags += [ "--target=aarch64-linux-gnu" ]
       cflags += [ "-DBORINGSSL_CLANG_SUPPORTS_DOT_ARCH" ]
     } else if (current_cpu == "arm") {
-      if (arm_float_abi == "hard") {
+      if (titan_target_libc == "musl") {
+        cflags += [ "--target=arm-linux-musleabi" ]
+        ldflags += [ "--target=arm-linux-musleabi" ]
+      } else if (arm_float_abi == "hard") {
         cflags += [ "--target=arm-linux-gnueabihf" ]
         ldflags += [ "--target=arm-linux-gnueabihf" ]
       } else {
