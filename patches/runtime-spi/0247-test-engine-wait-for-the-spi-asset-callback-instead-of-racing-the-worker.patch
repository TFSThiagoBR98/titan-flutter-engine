# Why: Wait for the worker-posted asset callback before asserting its result
# so the test does not race the UI task queue.
diff --git a/engine/src/flutter/runtime_spi/spi_runtime_backend_unittests.cc b/engine/src/flutter/runtime_spi/spi_runtime_backend_unittests.cc
index 0a11e7a1b06..7736a131dd1 100644
--- a/engine/src/flutter/runtime_spi/spi_runtime_backend_unittests.cc
+++ b/engine/src/flutter/runtime_spi/spi_runtime_backend_unittests.cc
@@ -6,6 +6,7 @@
 #include "flutter/runtime_spi/spi_runtime_backend_factory.h"
 
 #include <atomic>
+#include <chrono>
 #include <cstring>
 #include <memory>
 #include <string>
@@ -1312,7 +1313,15 @@ TEST_F(SpiRuntimeBackendTest, SpiAsset_ReadsOnTheConcurrentWorker) {
             kFlutterSpiOk);
 
   resolver_pointer->WaitForRequest();
-  RunPendingTasks();
+  const auto callback_deadline =
+      std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (!capture.called &&
+         std::chrono::steady_clock::now() < callback_deadline) {
+    RunPendingTasks();
+    if (!capture.called) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+  }
 
   ASSERT_TRUE(capture.called);
   EXPECT_TRUE(resolver_pointer->called_on_worker);
