 }
 
+FlutterSpiResult SpiPaintCache::Convert(const FlutterSpiPaint& paint,
+                                        DlTileMode tile_mode,
+                                        const DlPaint** out_paint) {
+  if (out_paint == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_paint = nullptr;
+  if (!Matches(paint, tile_mode)) {
+    DlPaint converted_paint;
+    const FlutterSpiResult result =
+        TryToDlPaint(paint, tile_mode, &converted_paint);
+    if (result != kFlutterSpiOk) {
+      return result;
+    }
+    Store(paint, tile_mode, std::move(converted_paint));
+  }
+  *out_paint = &paint_;
+  return kFlutterSpiOk;
+}
+
+bool SpiPaintCache::Matches(const FlutterSpiPaint& paint,
+                            DlTileMode tile_mode) const {
+  const std::size_t bytes_size =
+      std::min(paint.struct_size, sizeof(FlutterSpiPaint));
+  return has_paint_ && struct_size_ == paint.struct_size &&
+         tile_mode_ == tile_mode && paint_bytes_.size() == bytes_size &&
+         std::memcmp(paint_bytes_.data(), &paint, bytes_size) == 0 &&
+         HandlesAreValid(paint);
+}
+
+bool SpiPaintCache::HandlesAreValid(const FlutterSpiPaint& paint) const {
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, shader),
+                    sizeof(paint.shader)) &&
+      paint.shader != nullptr && SpiShaderGetRaw(paint.shader) == nullptr) {
+    return false;
+  }
+  if (ContainsField(paint.struct_size,
+                    offsetof(FlutterSpiPaint, color_filter),
+                    sizeof(paint.color_filter)) &&
+      paint.color_filter != nullptr &&
+      SpiColorFilterGetRaw(paint.color_filter) == nullptr) {
+    return false;
+  }
+  if (ContainsField(paint.struct_size,
+                    offsetof(FlutterSpiPaint, image_filter),
+                    sizeof(paint.image_filter)) &&
+      paint.image_filter != nullptr &&
+      SpiImageFilterResolve(paint.image_filter, tile_mode_) == nullptr) {
+    return false;
+  }
+  return true;
+}
+
+void SpiPaintCache::Store(const FlutterSpiPaint& paint,
+                          DlTileMode tile_mode,
+                          DlPaint converted_paint) {
+  const std::size_t bytes_size =
+      std::min(paint.struct_size, sizeof(FlutterSpiPaint));
+  paint_bytes_.resize(bytes_size);
+  std::memcpy(paint_bytes_.data(), &paint, bytes_size);
+  struct_size_ = paint.struct_size;
+  tile_mode_ = tile_mode;
+  paint_ = std::move(converted_paint);
+  has_paint_ = true;
+}
