+TEST(SpiImageDecoding, DecodeOptionsCarryTheTargetPixelFormat) {
+  const FlutterSpiImageDecodeOptions dont_care = {
+      .struct_size = sizeof(FlutterSpiImageDecodeOptions),
+      .target_width = 3,
+      .target_height = 2,
+      .target_pixel_format = 0,
+  };
+  const FlutterSpiImageDecodeOptions rgba_float = {
+      .struct_size = sizeof(FlutterSpiImageDecodeOptions),
+      .target_width = 3,
+      .target_height = 2,
+      .target_pixel_format = 1,
+  };
+  const FlutterSpiImageDecodeOptions r_float = {
+      .struct_size = sizeof(FlutterSpiImageDecodeOptions),
+      .target_width = 3,
+      .target_height = 2,
+      .target_pixel_format = 2,
+  };
+  const FlutterSpiImageDecodeOptions old_options = {
+      .struct_size = offsetof(FlutterSpiImageDecodeOptions, target_pixel_format),
+      .target_width = 3,
+      .target_height = 2,
+  };
+
+  EXPECT_EQ(SpiToImageDecoderOptions(3, 2, &dont_care).target_format,
+            ImageDecoder::TargetPixelFormat::kDontCare);
+  EXPECT_EQ(SpiToImageDecoderOptions(3, 2, &rgba_float).target_format,
+            ImageDecoder::TargetPixelFormat::kR32G32B32A32Float);
+  EXPECT_EQ(SpiToImageDecoderOptions(3, 2, &r_float).target_format,
+            ImageDecoder::TargetPixelFormat::kR32Float);
+  EXPECT_EQ(SpiToImageDecoderOptions(3, 2, &old_options).target_format,
+            ImageDecoder::TargetPixelFormat::kDontCare);
+}
