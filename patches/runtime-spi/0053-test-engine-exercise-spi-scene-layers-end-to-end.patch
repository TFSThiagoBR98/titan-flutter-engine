+static void test_runtime_submit_retained_layers_scene(
+    CTestRuntime* runtime,
+    const FlutterSpiFrameInfo* frame_info) {
+  const FlutterSpiSceneApi* scene_api = runtime->engine_api->scene;
+  FlutterSpiSceneBuilder* builder = NULL;
+  FlutterSpiPicture* picture = NULL;
+  FlutterSpiScene* scene = NULL;
+
+  if (runtime->retained_layer == NULL) {
+    if (scene_api == NULL ||
+        !create_scene_picture(scene_api, runtime->engine, &picture) ||
+        scene_api->scene_builder_create(runtime->engine, &builder) !=
+            kFlutterSpiOk ||
+        scene_api->scene_push_opacity(builder, 128, 3.0f, 4.0f) !=
+            kFlutterSpiOk ||
+        scene_api->scene_add_picture(builder, 0.0f, 0.0f, picture, false,
+                                     false) != kFlutterSpiOk ||
+        scene_api->scene_take_last_layer(builder, &runtime->retained_layer) !=
+            kFlutterSpiOk ||
+        scene_api->scene_build(
+            builder, (int64_t)runtime->last_view_metrics.physical_width,
+            (int64_t)runtime->last_view_metrics.physical_height,
+            &scene) != kFlutterSpiOk) {
+      if (builder != NULL) {
+        scene_api->scene_builder_release(builder);
+      }
+      if (picture != NULL) {
+        scene_api->picture_release(picture);
+      }
+      if (runtime->retained_layer != NULL) {
+        scene_api->engine_layer_release(runtime->retained_layer);
+        runtime->retained_layer = NULL;
+      }
+      return;
+    }
+
+    scene_api->picture_release(picture);
+    runtime->engine_api->submit_frame(
+        runtime->engine, runtime->last_view_metrics.view_id,
+        frame_info->frame_token, scene,
+        runtime->last_view_metrics.device_pixel_ratio);
+    return;
+  }
+
+  const FlutterSpiPaintEffectsApi* effects_api =
+      runtime->engine_api->paint_effects;
+  FlutterSpiColorFilter* filter = NULL;
+  const FlutterSpiColor filter_color = {
+      .red = 0.2f,
+      .green = 0.3f,
+      .blue = 0.4f,
+      .alpha = 1.0f,
+      .color_space = kFlutterSpiColorSpaceSRGB};
+  if (scene_api == NULL || effects_api == NULL ||
+      effects_api->color_filter_mode(
+          runtime->engine, filter_color, kFlutterSpiBlendModeScreen,
+          &filter) != kFlutterSpiOk ||
+      scene_api->scene_builder_create(runtime->engine, &builder) !=
+          kFlutterSpiOk ||
+      scene_api->scene_push_color_filter(builder, filter) != kFlutterSpiOk ||
+      scene_api->scene_add_retained(builder, runtime->retained_layer) !=
+          kFlutterSpiOk ||
+      scene_api->scene_build(
+          builder, (int64_t)runtime->last_view_metrics.physical_width,
+          (int64_t)runtime->last_view_metrics.physical_height,
+          &scene) != kFlutterSpiOk) {
+    if (builder != NULL) {
+      scene_api->scene_builder_release(builder);
+    }
+    if (filter != NULL) {
+      effects_api->color_filter_release(filter);
+    }
+    return;
+  }
+
+  effects_api->color_filter_release(filter);
+  runtime->engine_api->submit_frame(
+      runtime->engine, runtime->last_view_metrics.view_id,
+      frame_info->frame_token, scene,
+      runtime->last_view_metrics.device_pixel_ratio);
+  scene_api->engine_layer_release(runtime->retained_layer);
+  runtime->retained_layer = NULL;
+}
