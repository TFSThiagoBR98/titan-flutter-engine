@@ -18,6 +18,7 @@
 #include "flutter/fml/synchronization/waitable_event.h"
 #include "flutter/fml/time/time_delta.h"
 #include "flutter/fml/time/time_point.h"
+#include "flutter/flow/layers/container_layer.h"
 #include "flutter/lib/ui/window/key_data_packet.h"
 #include "flutter/lib/ui/window/pointer_data_packet.h"
 #include "flutter/runtime/dart_vm.h"
@@ -312,6 +313,56 @@ TEST_F(SpiConformance, SceneApiAnnouncedByCapability) {
   EXPECT_NE(runtime_->engine_api->capabilities & kFlutterSpiCapScene, 0u);
 }
 
+TEST_F(SpiConformance, SceneLayersAnnouncedByCapability) {
+  StartShell();
+
+  ASSERT_NE(runtime_->engine_api, nullptr);
+  ASSERT_NE(runtime_->engine_api->scene, nullptr);
+  EXPECT_NE(runtime_->engine_api->capabilities & kFlutterSpiCapSceneLayers,
+            0u);
+  EXPECT_NE(runtime_->engine_api->scene->scene_take_last_layer, nullptr);
+  EXPECT_NE(runtime_->engine_api->scene->scene_add_retained, nullptr);
+}
+
+TEST_F(SpiConformance, RetainedLayerFrameRoundTrip) {
+  runtime_->retained_layers_on_begin_frame = true;
+  StartShell();
+
+  const Layer* first_layer = nullptr;
+  PumpOneFrame(shell_.get());
+  PostSync(shell_->GetTaskRunners().GetRasterTaskRunner(), [&] {
+    auto* layer_tree =
+        shell_->GetRasterizer()->GetLastLayerTree(kImplicitViewId);
+    ASSERT_NE(layer_tree, nullptr);
+    const auto* root = layer_tree->root_layer()->as_container_layer();
+    ASSERT_NE(root, nullptr);
+    ASSERT_EQ(root->layers().size(), 1u);
+    first_layer = root->layers()[0].get();
+  });
+
+  PumpOneFrame(shell_.get());
+  PostSync(shell_->GetTaskRunners().GetRasterTaskRunner(), [&] {
+    auto* layer_tree =
+        shell_->GetRasterizer()->GetLastLayerTree(kImplicitViewId);
+    ASSERT_NE(layer_tree, nullptr);
+    const auto* root = layer_tree->root_layer()->as_container_layer();
+    ASSERT_NE(root, nullptr);
+    ASSERT_EQ(root->layers().size(), 1u);
+    const auto* color_filter = root->layers()[0]->as_container_layer();
+    ASSERT_NE(color_filter, nullptr);
+    ASSERT_EQ(color_filter->layers().size(), 1u);
+    EXPECT_EQ(color_filter->layers()[0].get(), first_layer);
+    EXPECT_EQ(SceneTrace(*layer_tree),
+              "scene 1x1\n"
+              "container\n"
+              "  color_filter type 0 color 4281552230 mode 14\n"
+              "    opacity 128 3 4\n"
+              "      picture 0 0\n"
+              "        drawRect 1 2 3 4\n"
+              "        drawCircle 5 6 2\n");
+  });
+}
+
