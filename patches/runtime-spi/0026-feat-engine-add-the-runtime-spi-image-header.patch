@@ -0,0 +1,112 @@
+#ifndef FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_IMAGE_H_
+#define FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_IMAGE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "flutter_scene.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct FlutterSpiImage FlutterSpiImage;
+
+typedef enum {
+  kFlutterSpiPixelFormatRGBA8888 = 0,
+  kFlutterSpiPixelFormatBGRA8888 = 1,
+  kFlutterSpiPixelFormatRGBAFloat32 = 2,
+  kFlutterSpiPixelFormatRFloat32 = 3,
+} FlutterSpiPixelFormat;
+
+typedef enum {
+  kFlutterSpiFilterQualityNone = 0,
+  kFlutterSpiFilterQualityLow = 1,
+  kFlutterSpiFilterQualityMedium = 2,
+  kFlutterSpiFilterQualityHigh = 3,
+} FlutterSpiFilterQuality;
+
+typedef struct {
+  size_t struct_size;
+  const uint8_t* pixels;
+  size_t pixels_size;
+  int32_t width;
+  int32_t height;
+  int32_t row_bytes;
+  int32_t pixel_format;
+} FlutterSpiPixels;
+
+typedef struct {
+  size_t struct_size;
+  int32_t target_width;
+  int32_t target_height;
+} FlutterSpiImageDecodeOptions;
+
+typedef struct {
+  float scos;
+  float ssin;
+  float tx;
+  float ty;
+} FlutterSpiRSTransform;
+
+typedef void (*FlutterSpiImageCallback)(void* user_data,
+                                        FlutterSpiResult result,
+                                        FlutterSpiImage* image);
+
+typedef struct FlutterSpiImageApi {
+  size_t struct_size;
+  FlutterSpiResult (*image_decode)(
+      FlutterSpiEngine* engine,
+      const uint8_t* data,
+      size_t size,
+      const FlutterSpiImageDecodeOptions* options,
+      FlutterSpiImageCallback callback,
+      void* user_data);
+  FlutterSpiResult (*image_create_from_pixels)(
+      FlutterSpiEngine* engine,
+      const FlutterSpiPixels* pixels,
+      const FlutterSpiImageDecodeOptions* options,
+      FlutterSpiImageCallback callback,
+      void* user_data);
+  FlutterSpiResult (*image_get_size)(FlutterSpiImage* image,
+                                     int32_t* out_width,
+                                     int32_t* out_height);
+  FlutterSpiResult (*image_retain)(FlutterSpiImage* image);
+  FlutterSpiResult (*image_release)(FlutterSpiImage* image);
+  FlutterSpiResult (*canvas_draw_image)(FlutterSpiPictureRecorder* recorder,
+                                        FlutterSpiImage* image,
+                                        FlutterSpiPoint offset,
+                                        int32_t filter_quality,
+                                        const FlutterSpiPaint* paint);
+  FlutterSpiResult (*canvas_draw_image_rect)(
+      FlutterSpiPictureRecorder* recorder,
+      FlutterSpiImage* image,
+      const FlutterSpiRect* src,
+      const FlutterSpiRect* dst,
+      int32_t filter_quality,
+      const FlutterSpiPaint* paint);
+  FlutterSpiResult (*canvas_draw_image_nine)(
+      FlutterSpiPictureRecorder* recorder,
+      FlutterSpiImage* image,
+      const FlutterSpiRect* center,
+      const FlutterSpiRect* dst,
+      int32_t filter_quality,
+      const FlutterSpiPaint* paint);
+  FlutterSpiResult (*canvas_draw_atlas)(
+      FlutterSpiPictureRecorder* recorder,
+      FlutterSpiImage* image,
+      const FlutterSpiRSTransform* transforms,
+      const FlutterSpiRect* rects,
+      const FlutterSpiColor* colors,
+      size_t count,
+      int32_t blend_mode,
+      int32_t filter_quality,
+      const FlutterSpiRect* cull_rect,
+      const FlutterSpiPaint* paint);
+} FlutterSpiImageApi;
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_IMAGE_H_
