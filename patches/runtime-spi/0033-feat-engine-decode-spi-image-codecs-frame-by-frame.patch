+#include "flutter/runtime_spi/image/spi_image_decoding.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+
+namespace flutter {
+namespace {
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+class SpiImageCodec final : public std::enable_shared_from_this<SpiImageCodec> {
+ public:
+  SpiImageCodec(SpiImageDecoding* image_decoding,
+                const fml::RefPtr<fml::TaskRunner>& ui_task_runner,
+                const fml::RefPtr<fml::TaskRunner>& io_task_runner,
+                sk_sp<SkData> encoded_data,
+                std::shared_ptr<AnimatedImageFrames> animated_frames,
+                const FlutterSpiImageDecodeOptions& decode_options,
+                int32_t frame_count,
+                int32_t repetition_count)
+      : image_decoding_(image_decoding),
+        ui_task_runner_(ui_task_runner),
+        io_task_runner_(io_task_runner),
+        encoded_data_(std::move(encoded_data)),
+        animated_frames_(std::move(animated_frames)),
+        decode_options_(decode_options),
+        frame_count_(frame_count),
+        repetition_count_(repetition_count),
+        gpu_disabled_sync_switch_(std::make_shared<fml::SyncSwitch>(true)) {}
+
+  FlutterSpiResult GetInfo(int32_t* out_frame_count,
+                           int32_t* out_repetition_count) const {
+    if (out_frame_count == nullptr || out_repetition_count == nullptr) {
+      return kFlutterSpiInvalidArgument;
+    }
+    *out_frame_count = frame_count_;
+    *out_repetition_count = repetition_count_;
+    return kFlutterSpiOk;
+  }
+
+  FlutterSpiResult GetNextFrame(FlutterSpiFrameCallback callback,
+                                void* user_data) {
+    if (callback == nullptr) {
+      return kFlutterSpiInvalidArgument;
+    }
+    if (released_.load()) {
+      return kFlutterSpiInvalidHandle;
+    }
+    if (frame_count_ == 1) {
+      return GetNextStaticFrame(callback, user_data);
+    }
+    return GetNextAnimatedFrame(callback, user_data);
+  }
+
+  void MarkReleased() {
+    released_.store(true);
+  }
+
+ private:
+  struct PendingCallback {
+    FlutterSpiFrameCallback callback;
+    void* user_data;
+  };
+
+  struct StaticCallbackContext {
+    std::shared_ptr<SpiImageCodec> codec;
+  };
+
+  static void CaptureStaticFrame(void* user_data,
+                                 FlutterSpiResult result,
+                                 FlutterSpiImage* image) {
+    std::unique_ptr<StaticCallbackContext> context(
+        static_cast<StaticCallbackContext*>(user_data));
+    if (context->codec != nullptr) {
+      context->codec->CompleteStaticFrame(result, image);
+    }
+  }
+
+  FlutterSpiResult GetNextStaticFrame(FlutterSpiFrameCallback callback,
+                                      void* user_data) {
+    if (cached_image_ != nullptr) {
+      PostFrame(callback, user_data, kFlutterSpiOk, cached_image_, 0);
+      return kFlutterSpiOk;
+    }
+
+    pending_callbacks_.push_back({callback, user_data});
+    if (decoding_in_progress_) {
+      return kFlutterSpiOk;
+    }
+    decoding_in_progress_ = true;
+
+    auto* context = new StaticCallbackContext{shared_from_this()};
+    const FlutterSpiResult result = image_decoding_->DecodeEncoded(
+        static_cast<const uint8_t*>(encoded_data_->data()), encoded_data_->size(),
+        &decode_options_, CaptureStaticFrame, context);
+    if (result != kFlutterSpiOk) {
+      delete context;
+      decoding_in_progress_ = false;
+      pending_callbacks_.clear();
+    }
+    return result;
+  }
+
+  FlutterSpiResult GetNextAnimatedFrame(FlutterSpiFrameCallback callback,
+                                        void* user_data) {
+    const auto self = shared_from_this();
+    io_task_runner_->PostTask([self, callback, user_data] {
+      AnimatedImageFrames::Frame frame =
+          self->animated_frames_->DecodeNextFrame({
+              .resource_context = {},
+              .gpu_disabled_sync_switch = self->gpu_disabled_sync_switch_,
+              .impeller_context = nullptr,
+              .unref_queue = nullptr,
+          });
+      self->ui_task_runner_->PostTask([
+          self, callback, user_data, frame = std::move(frame)]() mutable {
+        self->DeliverFrame(callback, user_data, std::move(frame));
+      });
+    });
+    return kFlutterSpiOk;
+  }
+
+  void CompleteStaticFrame(FlutterSpiResult result, FlutterSpiImage* image) {
+    sk_sp<DlImage> decoded_image;
+    if (result == kFlutterSpiOk && image != nullptr) {
+      decoded_image = SpiImageGet(image);
+      SpiImageRelease(image);
+    }
+
+    decoding_in_progress_ = false;
+    if (decoded_image != nullptr) {
+      cached_image_ = decoded_image;
+    } else {
+      result = kFlutterSpiInternalError;
+    }
+    auto pending_callbacks = std::move(pending_callbacks_);
+    pending_callbacks_.clear();
+    for (const PendingCallback& pending : pending_callbacks) {
+      PostFrame(pending.callback, pending.user_data, result, cached_image_, 0);
+    }
+  }
+
+  void DeliverFrame(FlutterSpiFrameCallback callback,
+                    void* user_data,
+                    AnimatedImageFrames::Frame frame) {
+    const FlutterSpiResult result =
+        frame.image == nullptr ? kFlutterSpiInternalError : kFlutterSpiOk;
+    PostFrame(callback, user_data, result, std::move(frame.image),
+              frame.duration_ms);
+  }
+
+  void PostFrame(FlutterSpiFrameCallback callback,
+                 void* user_data,
+                 FlutterSpiResult result,
+                 sk_sp<DlImage> image,
+                 int32_t duration_ms) {
+    const auto self = shared_from_this();
+    ui_task_runner_->PostTask(
+        [self, callback, user_data, result, image = std::move(image),
+         duration_ms]() mutable {
+          FlutterSpiImage* handle = nullptr;
+          FlutterSpiResult callback_result = result;
+          if (callback_result == kFlutterSpiOk &&
+              SpiImageWrap(std::move(image), &handle) != kFlutterSpiOk) {
+            callback_result = kFlutterSpiInternalError;
+          }
+          callback(user_data, callback_result, handle,
+                   callback_result == kFlutterSpiOk ? duration_ms : 0);
+        });
+  }
+
+  SpiImageDecoding* image_decoding_;
+  fml::RefPtr<fml::TaskRunner> ui_task_runner_;
+  fml::RefPtr<fml::TaskRunner> io_task_runner_;
+  sk_sp<SkData> encoded_data_;
+  std::shared_ptr<AnimatedImageFrames> animated_frames_;
+  FlutterSpiImageDecodeOptions decode_options_;
+  const int32_t frame_count_;
+  const int32_t repetition_count_;
+  const std::shared_ptr<const fml::SyncSwitch> gpu_disabled_sync_switch_;
+  std::atomic_bool released_ = false;
+  bool decoding_in_progress_ = false;
+  sk_sp<DlImage> cached_image_;
+  std::vector<PendingCallback> pending_callbacks_;
+};
+
+SpiHandleTable<SpiImageCodec>& Codecs() {
+  static SpiHandleTable<SpiImageCodec> codecs;
+  return codecs;
+}
+
+std::shared_ptr<SpiImageCodec> FindCodec(FlutterSpiCodec* codec) {
+  return Codecs().Find(HandleValue(codec));
+}
+
+}  // namespace
+
+FlutterSpiResult SpiCodecCreate(
+    SpiImageDecoding* image_decoding,
+    const TaskRunners& task_runners,
+    const uint8_t* data,
+    size_t size,
+    const FlutterSpiImageDecodeOptions* options,
+    FlutterSpiCodec** out_codec) {
+  if (image_decoding == nullptr || data == nullptr || size == 0 ||
+      out_codec == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_codec = nullptr;
+
+  auto registry = std::make_unique<ImageGeneratorRegistry>();
+  auto encoded_data = SkData::MakeWithCopy(data, size);
+  auto descriptor =
+      ImageDescriptorData::MakeEncoded(encoded_data, *registry);
+  if (descriptor == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto generator = registry->CreateCompatibleGenerator(descriptor->data());
+  if (generator == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  const int32_t frame_count = static_cast<int32_t>(generator->GetFrameCount());
+  const unsigned int play_count = generator->GetPlayCount();
+  const int32_t repetition_count =
+      frame_count == 1
+          ? 0
+          : play_count == ImageGenerator::kInfinitePlayCount
+                ? -1
+                : static_cast<int32_t>(play_count - 1);
+  FlutterSpiImageDecodeOptions decode_options = {
+      .struct_size = sizeof(FlutterSpiImageDecodeOptions),
+      .target_width = 0,
+      .target_height = 0,
+  };
+  if (options != nullptr) {
+    decode_options.target_width = options->target_width;
+    decode_options.target_height = options->target_height;
+  }
+  const SkISize target_size = ResolveTargetSize(
+      descriptor->width(), descriptor->height(), &decode_options);
+  decode_options.target_width = target_size.width();
+  decode_options.target_height = target_size.height();
+
+  std::shared_ptr<AnimatedImageFrames> animated_frames;
+  if (frame_count > 1) {
+    animated_frames =
+        std::make_shared<AnimatedImageFrames>(std::move(generator), false);
+  }
+  auto codec = std::make_shared<SpiImageCodec>(
+      image_decoding, task_runners.GetUITaskRunner(),
+      task_runners.GetIOTaskRunner(), std::move(encoded_data),
+      std::move(animated_frames), decode_options, frame_count,
+      repetition_count);
+  *out_codec = MakeHandle<FlutterSpiCodec>(Codecs().Insert(std::move(codec)));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiCodecGetInfo(FlutterSpiCodec* codec,
+                                 int32_t* out_frame_count,
+                                 int32_t* out_repetition_count) {
+  const auto codec_value = FindCodec(codec);
+  return codec_value == nullptr
+             ? kFlutterSpiInvalidHandle
+             : codec_value->GetInfo(out_frame_count, out_repetition_count);
+}
+
+FlutterSpiResult SpiCodecGetNextFrame(FlutterSpiCodec* codec,
+                                      FlutterSpiFrameCallback callback,
+                                      void* user_data) {
+  const auto codec_value = FindCodec(codec);
+  return codec_value == nullptr
+             ? kFlutterSpiInvalidHandle
+             : codec_value->GetNextFrame(callback, user_data);
+}
+
+FlutterSpiResult SpiCodecRelease(FlutterSpiCodec* codec) {
+  const auto codec_value = FindCodec(codec);
+  if (codec_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  codec_value->MarkReleased();
+  return Codecs().Release(HandleValue(codec)) ? kFlutterSpiOk
+                                               : kFlutterSpiInvalidHandle;
+}
+
+}  // namespace flutter
