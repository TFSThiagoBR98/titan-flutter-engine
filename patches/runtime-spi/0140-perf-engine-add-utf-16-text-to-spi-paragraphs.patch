 }
 
+FlutterSpiResult SpiParagraphBuilderAddTextUtf16(
+    FlutterSpiParagraphBuilder* builder,
+    const uint16_t* utf16,
+    size_t length) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return builder_value->AddTextUtf16(utf16, length);
+}
