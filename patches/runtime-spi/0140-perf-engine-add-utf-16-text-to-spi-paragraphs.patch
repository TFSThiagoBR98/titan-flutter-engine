--- a/engine/src/flutter/runtime_spi/text/spi_paragraph.cc
+++ b/engine/src/flutter/runtime_spi/text/spi_paragraph.cc
@@ -60,6 +60,18 @@ class SpiParagraphBuilder final {
     return kFlutterSpiOk;
   }
 
+  FlutterSpiResult AddTextUtf16(const uint16_t* utf16, size_t length) {
+    if (utf16 == nullptr && length != 0) {
+      return kFlutterSpiInvalidArgument;
+    }
+    const std::u16string text =
+        length == 0
+            ? std::u16string()
+            : std::u16string(reinterpret_cast<const char16_t*>(utf16), length);
+    builder_->AddText(text);
+    return kFlutterSpiOk;
+  }
+
   FlutterSpiResult AddPlaceholder(float width,
                                    float height,
                                    int32_t alignment,
@@ -247,6 +259,17 @@ FlutterSpiResult SpiParagraphBuilderAddText(FlutterSpiParagraphBuilder* builder,
