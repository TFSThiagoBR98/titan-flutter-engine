+TEST_F(SpiGpuContextTest, TextureCreateRejectsInvalidCounts) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  SpiGpuSetDefaultContextOverride(CreateMockContext(&capabilities));
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuTextureDescriptor descriptor = MakeTextureDescriptor();
+  FlutterSpiGpuTexture* gpu_texture = nullptr;
+
+  descriptor.mip_level_count = 0;
+  EXPECT_EQ(SpiGpuTextureCreate(gpu_context, &descriptor, &gpu_texture),
+            kFlutterSpiInvalidArgument);
+  descriptor = MakeTextureDescriptor();
+  descriptor.layer_count = 0;
+  EXPECT_EQ(SpiGpuTextureCreate(gpu_context, &descriptor, &gpu_texture),
+            kFlutterSpiInvalidArgument);
+  descriptor = MakeTextureDescriptor();
+  descriptor.sample_count = 2;
+  EXPECT_EQ(SpiGpuTextureCreate(gpu_context, &descriptor, &gpu_texture),
+            kFlutterSpiInvalidArgument);
+  descriptor = MakeTextureDescriptor();
+  descriptor.texture_type = kFlutterSpiGpuTextureTypeCube;
