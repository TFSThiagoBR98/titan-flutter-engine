+  FlutterSpiGpuTexture* gpu_texture = nullptr;
+  ASSERT_EQ(SpiGpuTextureCreate(gpu_context, &descriptor, &gpu_texture),
+            kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuTextureRelease(gpu_texture), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuTextureRetain(gpu_texture), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuTextureOverwrite(gpu_texture, data, sizeof(data), 0, 0),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuTextureGetImpeller(gpu_texture), nullptr);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
