@@ -0,0 +1,291 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/gpu/spi_gpu_texture.h"
+
+#include <limits>
+
+#include "flutter/fml/logging.h"
+#include "flutter/fml/make_copyable.h"
+#include "flutter/fml/task_runner.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_context.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_formats.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "impeller/core/allocator.h"
+#include "impeller/core/buffer_view.h"
+#include "impeller/core/texture.h"
+#include "impeller/core/texture_descriptor.h"
+#include "impeller/geometry/rect.h"
+#include "impeller/renderer/blit_pass.h"
+#include "impeller/renderer/command_buffer.h"
+#include "impeller/renderer/command_queue.h"
+#include "impeller/renderer/context.h"
+
+namespace flutter {
+namespace {
+
+class SpiGpuTexture final {
+ public:
+  SpiGpuTexture(std::shared_ptr<impeller::Context> context,
+                fml::RefPtr<fml::TaskRunner> raster_task_runner,
+                std::shared_ptr<impeller::Texture> texture)
+      : context_(std::move(context)),
+        raster_task_runner_(std::move(raster_task_runner)),
+        texture_(std::move(texture)) {}
+
+  const std::shared_ptr<impeller::Context>& context() const { return context_; }
+
+  const std::shared_ptr<impeller::Texture>& texture() const { return texture_; }
+
+  const fml::RefPtr<fml::TaskRunner>& raster_task_runner() const {
+    return raster_task_runner_;
+  }
+
+ private:
+  std::shared_ptr<impeller::Context> context_;
+  fml::RefPtr<fml::TaskRunner> raster_task_runner_;
+  std::shared_ptr<impeller::Texture> texture_;
+};
+
+SpiHandleTable<SpiGpuTexture>& Textures() {
+  return LeakedHandleTable<SpiGpuTexture>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuTexture* texture) {
+  return reinterpret_cast<uintptr_t>(texture);
+}
+
+FlutterSpiGpuTexture* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuTexture*>(value);
+}
+
+SpiGpuTexture* FindTexture(FlutterSpiGpuTexture* texture) {
+  return Textures().FindRaw(HandleValue(texture));
+}
+
+bool IsValidStorageMode(int32_t storage_mode) {
+  return storage_mode >= kFlutterSpiGpuStorageModeHostVisible &&
+         storage_mode <= kFlutterSpiGpuStorageModeDeviceTransient;
+}
+
+bool HasCompleteDescriptor(const FlutterSpiGpuTextureDescriptor* descriptor) {
+  return descriptor->struct_size >=
+         offsetof(FlutterSpiGpuTextureDescriptor, layer_count) +
+             sizeof(descriptor->layer_count);
+}
+
+FlutterSpiResult InsertTexture(std::shared_ptr<impeller::Context> context,
+                               fml::RefPtr<fml::TaskRunner> raster_task_runner,
+                               std::shared_ptr<impeller::Texture> texture,
+                               FlutterSpiGpuTexture** out_texture) {
+  if (texture == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  const uintptr_t handle = Textures().Insert(std::make_shared<SpiGpuTexture>(
+      std::move(context), std::move(raster_task_runner), std::move(texture)));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_texture = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+int32_t MipDimensionAtLevel(int32_t base_dimension, uint32_t mip_level) {
+  if (mip_level >= std::numeric_limits<int32_t>::digits) {
+    return 1;
+  }
+  const int32_t shifted = base_dimension >> mip_level;
+  return shifted > 0 ? shifted : 1;
+}
+
+bool EncodeAndSubmitOverwrite(
+    impeller::Context& context,
+    const std::shared_ptr<impeller::Texture>& texture,
+    const std::shared_ptr<impeller::DeviceBuffer>& staging_buffer,
+    size_t source_length,
+    impeller::IRect destination_region,
+    uint32_t mip_level,
+    uint32_t slice) {
+  auto command_buffer = context.CreateCommandBuffer();
+  if (command_buffer == nullptr) {
+    return false;
+  }
+  auto blit_pass = command_buffer->CreateBlitPass();
+  if (blit_pass == nullptr) {
+    return false;
+  }
+  impeller::BufferView buffer_view(staging_buffer,
+                                   impeller::Range(0, source_length));
+  if (!blit_pass->AddCopy(std::move(buffer_view), texture, destination_region,
+                          "Texture.overwrite", mip_level, slice)) {
+    return false;
+  }
+  if (!blit_pass->EncodeCommands()) {
+    return false;
+  }
+  auto command_queue = context.GetCommandQueue();
+  return command_queue != nullptr &&
+         command_queue->Submit({std::move(command_buffer)}).ok();
+}
+
+}  // namespace
+
+FlutterSpiResult SpiGpuTextureCreate(
+    FlutterSpiGpuContext* context,
+    const FlutterSpiGpuTextureDescriptor* descriptor,
+    FlutterSpiGpuTexture** out_texture) {
+  if (out_texture == nullptr || descriptor == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_texture = nullptr;
+  if (!HasCompleteDescriptor(descriptor) ||
+      !IsValidStorageMode(descriptor->storage_mode) ||
+      descriptor->mip_level_count < 1 || descriptor->layer_count < 1 ||
+      descriptor->layer_count > std::numeric_limits<uint16_t>::max()) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  impeller::SampleCount sample_count;
+  switch (descriptor->sample_count) {
+    case 1:
+      sample_count = impeller::SampleCount::kCount1;
+      break;
+    case 4:
+      sample_count = impeller::SampleCount::kCount4;
+      break;
+    default:
+      return kFlutterSpiInvalidArgument;
+  }
+
+  const std::shared_ptr<impeller::Context> context_value =
+      SpiGpuContextGetImpeller(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+
+  impeller::TextureDescriptor impeller_descriptor;
+  impeller_descriptor.storage_mode =
+      SpiGpuToImpellerStorageMode(descriptor->storage_mode);
+  impeller_descriptor.type =
+      SpiGpuToImpellerTextureType(descriptor->texture_type);
+  impeller_descriptor.format = SpiGpuToImpellerPixelFormat(descriptor->format);
+  impeller_descriptor.size = {descriptor->width, descriptor->height};
+  impeller_descriptor.sample_count = sample_count;
+  impeller_descriptor.mip_count =
+      static_cast<size_t>(descriptor->mip_level_count);
+  impeller_descriptor.array_layer_count =
+      static_cast<uint16_t>(descriptor->layer_count);
+  impeller_descriptor.usage = SpiGpuToImpellerTextureUsage(descriptor->usage);
+  if (!impeller::IsMultisampleCapable(impeller_descriptor.type) &&
+      impeller_descriptor.sample_count != impeller::SampleCount::kCount1) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  auto texture = context_value->GetResourceAllocator()->CreateTexture(
+      impeller_descriptor, true);
+  return InsertTexture(context_value, SpiGpuContextGetRasterTaskRunner(context),
+                       std::move(texture), out_texture);
+}
+
+FlutterSpiResult SpiGpuTextureOverwrite(FlutterSpiGpuTexture* texture,
+                                        const uint8_t* data,
+                                        size_t size,
+                                        int32_t mip_level,
+                                        int32_t slice) {
+  SpiGpuTexture* texture_value = FindTexture(texture);
+  if (texture_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if ((data == nullptr && size != 0) || mip_level < 0 || slice < 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  const auto& texture_descriptor =
+      texture_value->texture()->GetTextureDescriptor();
+  if (static_cast<size_t>(mip_level) >= texture_descriptor.mip_count ||
+      !texture_value->texture()->IsSliceValid(static_cast<size_t>(slice))) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  auto staging_buffer =
+      texture_value->context()->GetResourceAllocator()->CreateBufferWithCopy(
+          data, size);
+  if (staging_buffer == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  const impeller::ISize base_size = texture_value->texture()->GetSize();
+  const impeller::IRect destination_region = impeller::IRect::MakeXYWH(
+      0, 0, MipDimensionAtLevel(base_size.width, mip_level),
+      MipDimensionAtLevel(base_size.height, mip_level));
+  const uint32_t mip_level_value = static_cast<uint32_t>(mip_level);
+  const uint32_t slice_value = static_cast<uint32_t>(slice);
+
+  if (texture_value->context()->GetBackendType() ==
+      impeller::Context::BackendType::kOpenGLES) {
+    const auto& raster_task_runner = texture_value->raster_task_runner();
+    if (!raster_task_runner) {
+      return kFlutterSpiInternalError;
+    }
+    auto context = texture_value->context();
+    auto texture_value_shared = texture_value->texture();
+    raster_task_runner->PostTask(
+        fml::MakeCopyable(
+            [context, texture_value_shared, staging_buffer, size,
+             destination_region, mip_level_value, slice_value]() mutable {
+              if (!EncodeAndSubmitOverwrite(
+                      *context, texture_value_shared, staging_buffer, size,
+                      destination_region, mip_level_value, slice_value)) {
+                FML_LOG(ERROR)
+                    << "Failed to encode texture overwrite blit on the raster "
+                       "thread.";
+              }
+              context->DisposeThreadLocalCachedResources();
+            }));
+    return kFlutterSpiOk;
+  }
+
+  if (!EncodeAndSubmitOverwrite(
+          *texture_value->context(), texture_value->texture(), staging_buffer,
+          size, destination_region, mip_level_value, slice_value)) {
+    return kFlutterSpiInternalError;
+  }
+  texture_value->context()->DisposeThreadLocalCachedResources();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuTextureRetain(FlutterSpiGpuTexture* texture) {
+  return Textures().Retain(HandleValue(texture)) ? kFlutterSpiOk
+                                                 : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuTextureRelease(FlutterSpiGpuTexture* texture) {
+  return Textures().Release(HandleValue(texture)) ? kFlutterSpiOk
+                                                  : kFlutterSpiInvalidHandle;
+}
+
+std::shared_ptr<impeller::Texture> SpiGpuTextureGetImpeller(
+    FlutterSpiGpuTexture* texture) {
+  SpiGpuTexture* texture_value = FindTexture(texture);
+  return texture_value == nullptr ? nullptr : texture_value->texture();
+}
+
+FlutterSpiResult SpiGpuTextureWrapImpeller(
+    FlutterSpiGpuContext* context,
+    std::shared_ptr<impeller::Texture> texture,
+    FlutterSpiGpuTexture** out_texture) {
+  if (out_texture == nullptr || texture == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_texture = nullptr;
+  std::shared_ptr<impeller::Context> context_value =
+      SpiGpuContextGetImpeller(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return InsertTexture(std::move(context_value),
+                       SpiGpuContextGetRasterTaskRunner(context),
+                       std::move(texture), out_texture);
+}
+
+}  // namespace flutter
