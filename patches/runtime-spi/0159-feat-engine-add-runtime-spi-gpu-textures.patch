+  EXPECT_EQ(SpiGpuTextureOverwrite(gpu_texture, data, sizeof(data), 0, -1),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuTextureRelease(gpu_texture), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
