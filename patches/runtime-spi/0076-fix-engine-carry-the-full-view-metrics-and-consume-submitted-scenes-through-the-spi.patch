+        sizeof(metrics.display_features_state));
+    if (count != 0 && has_bounds && metrics.display_features_bounds != nullptr) {
+      result.physical_display_features_bounds.assign(
+          metrics.display_features_bounds,
+          metrics.display_features_bounds + count * 4);
+    }
+    if (count != 0 && has_types && metrics.display_features_type != nullptr) {
+      result.physical_display_features_type.assign(
+          metrics.display_features_type, metrics.display_features_type + count);
+    }
+    if (count != 0 && has_states && metrics.display_features_state != nullptr) {
+      result.physical_display_features_state.assign(
+          metrics.display_features_state, metrics.display_features_state + count);
+    }
+  }
   return result;
 }
 
