+struct ViewportMetricsCapture {
+  const FlutterSpiEngineApi* engine_api = nullptr;
+  FlutterSpiEngine* engine = nullptr;
+  FlutterSpiViewMetrics metrics = {};
+  std::vector<double> display_features_bounds;
+  std::vector<int32_t> display_features_type;
+  std::vector<int32_t> display_features_state;
+};
+
+FlutterSpiResult CaptureViewportMetricsRuntimeStart(
+    void* user_data,
+    const FlutterSpiEngineApi* api,
+    FlutterSpiEngine* engine) {
+  auto* capture = static_cast<ViewportMetricsCapture*>(user_data);
+  capture->engine_api = api;
+  capture->engine = engine;
+  return kFlutterSpiOk;
+}
+
+void CaptureViewportMetrics(void* user_data,
+                            const FlutterSpiViewMetrics* metrics) {
+  auto* capture = static_cast<ViewportMetricsCapture*>(user_data);
+  capture->metrics = *metrics;
+  capture->display_features_bounds.assign(
+      metrics->display_features_bounds,
+      metrics->display_features_bounds + 4 * metrics->display_features_count);
+  capture->display_features_type.assign(
+      metrics->display_features_type,
+      metrics->display_features_type + metrics->display_features_count);
+  capture->display_features_state.assign(
+      metrics->display_features_state,
+      metrics->display_features_state + metrics->display_features_count);
+}
+
+void IgnoreViewportMetricsRuntimeCallback(void*) {}
+
+FlutterSpiRuntimeTable MakeViewportMetricsTable(
+    ViewportMetricsCapture* capture) {
+  FlutterSpiRuntimeTable table = {};
+  table.struct_size = sizeof(table);
+  table.version_major = FLUTTER_SPI_VERSION_MAJOR;
+  table.version_minor = FLUTTER_SPI_VERSION_MINOR;
+  table.user_data = capture;
+  table.start = CaptureViewportMetricsRuntimeStart;
+  table.stop = IgnoreViewportMetricsRuntimeCallback;
+  table.destroy = IgnoreViewportMetricsRuntimeCallback;
+  table.set_view_metrics = CaptureViewportMetrics;
+  return table;
+}
