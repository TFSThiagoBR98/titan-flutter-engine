# Why: prove the UTF-16 SPI path matches UTF-8 before adding the ABI entry
# point.
diff --git a/engine/src/flutter/runtime_spi/text/spi_paragraph_parity_unittests.cc b/engine/src/flutter/runtime_spi/text/spi_paragraph_parity_unittests.cc
index 2120837d95d..34fc575fe12 100644
--- a/engine/src/flutter/runtime_spi/text/spi_paragraph_parity_unittests.cc
+++ b/engine/src/flutter/runtime_spi/text/spi_paragraph_parity_unittests.cc
@@ -184,6 +184,83 @@ TEST_F(SpiParagraphTest, RectsForRangeMatchTxt) {
   EXPECT_EQ(SpiParagraphRelease(paragraph), kFlutterSpiOk);
 }
 
+TEST_F(SpiParagraphTest, AddTextUtf16MatchesUtf8) {
+  const auto style = ParagraphStyle();
+  const auto text_utf16 = std::u16string(u"Hello, SPI world");
+  const auto text_style = TextStyle();
+
+  FlutterSpiParagraphBuilder* utf8_builder = nullptr;
+  ASSERT_EQ(SpiParagraphBuilderCreate(TxtFontCollection(), false, &style,
+                                      &utf8_builder),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderPushStyle(utf8_builder, &text_style),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderAddText(utf8_builder, "Hello, SPI world", 16),
+            kFlutterSpiOk);
+  FlutterSpiParagraph* utf8_paragraph = nullptr;
+  ASSERT_EQ(SpiParagraphBuilderBuild(utf8_builder, &utf8_paragraph),
+            kFlutterSpiOk);
+
+  FlutterSpiParagraphBuilder* utf16_builder = nullptr;
+  ASSERT_EQ(SpiParagraphBuilderCreate(TxtFontCollection(), false, &style,
+                                      &utf16_builder),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderPushStyle(utf16_builder, &text_style),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderAddTextUtf16(
+                utf16_builder,
+                reinterpret_cast<const uint16_t*>(text_utf16.data()),
+                text_utf16.size()),
+            kFlutterSpiOk);
+  FlutterSpiParagraph* utf16_paragraph = nullptr;
+  ASSERT_EQ(SpiParagraphBuilderBuild(utf16_builder, &utf16_paragraph),
+            kFlutterSpiOk);
+
+  ASSERT_EQ(SpiParagraphLayout(utf8_paragraph, kLayoutWidth), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphLayout(utf16_paragraph, kLayoutWidth), kFlutterSpiOk);
+
+  FlutterSpiParagraphMetrics utf8_metrics = {
+      .struct_size = sizeof(FlutterSpiParagraphMetrics)};
+  FlutterSpiParagraphMetrics utf16_metrics = {
+      .struct_size = sizeof(FlutterSpiParagraphMetrics)};
+  ASSERT_EQ(SpiParagraphGetMetrics(utf8_paragraph, &utf8_metrics),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphGetMetrics(utf16_paragraph, &utf16_metrics),
+            kFlutterSpiOk);
+  EXPECT_EQ(utf8_metrics.width, utf16_metrics.width);
+  EXPECT_EQ(utf8_metrics.height, utf16_metrics.height);
+  EXPECT_EQ(utf8_metrics.longest_line, utf16_metrics.longest_line);
+  EXPECT_EQ(utf8_metrics.line_count, utf16_metrics.line_count);
+
+  FlutterSpiTextBox utf8_boxes[4] = {};
+  FlutterSpiTextBox utf16_boxes[4] = {};
+  size_t utf8_count = 0;
+  size_t utf16_count = 0;
+  ASSERT_EQ(SpiParagraphGetRectsForRange(
+                utf8_paragraph, 0, text_utf16.size(),
+                static_cast<int32_t>(txt::Paragraph::RectHeightStyle::kTight),
+                static_cast<int32_t>(txt::Paragraph::RectWidthStyle::kMax),
+                utf8_boxes, 4, &utf8_count),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphGetRectsForRange(
+                utf16_paragraph, 0, text_utf16.size(),
+                static_cast<int32_t>(txt::Paragraph::RectHeightStyle::kTight),
+                static_cast<int32_t>(txt::Paragraph::RectWidthStyle::kMax),
+                utf16_boxes, 4, &utf16_count),
+            kFlutterSpiOk);
+  ASSERT_EQ(utf8_count, utf16_count);
+  for (size_t index = 0; index < utf8_count; index++) {
+    EXPECT_EQ(utf8_boxes[index].rect.left, utf16_boxes[index].rect.left);
+    EXPECT_EQ(utf8_boxes[index].rect.top, utf16_boxes[index].rect.top);
+    EXPECT_EQ(utf8_boxes[index].rect.right, utf16_boxes[index].rect.right);
+    EXPECT_EQ(utf8_boxes[index].rect.bottom, utf16_boxes[index].rect.bottom);
+    EXPECT_EQ(utf8_boxes[index].direction, utf16_boxes[index].direction);
+  }
+
+  EXPECT_EQ(SpiParagraphRelease(utf8_paragraph), kFlutterSpiOk);
+  EXPECT_EQ(SpiParagraphRelease(utf16_paragraph), kFlutterSpiOk);
+}
