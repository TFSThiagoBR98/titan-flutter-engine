+FlutterSpiResult SpiScenePushClipRSuperellipse(FlutterSpiSceneBuilder* builder,
+                                               const FlutterSpiRRect* shape,
+                                               int32_t clip_behavior) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (shape == nullptr || !IsFinite(*shape) ||
+      !IsValidClipBehavior(clip_behavior)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<ClipRSuperellipseLayer>(
+                ToDlRoundSuperellipse(*shape), ToClip(clip_behavior)),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushColorFilter(FlutterSpiSceneBuilder* builder,
+                                         FlutterSpiColorFilter* filter) {
+  const auto builder_value = FindBuilder(builder);
+  const auto filter_value = SpiColorFilterGet(filter);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (filter_value == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<ColorFilterLayer>(filter_value), builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushImageFilter(FlutterSpiSceneBuilder* builder,
+                                         FlutterSpiImageFilter* filter,
+                                         float dx,
+                                         float dy) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!std::isfinite(dx) || !std::isfinite(dy)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto filter_value = SpiImageFilterResolve(filter, DlTileMode::kDecal);
+  if (filter_value == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<ImageFilterLayer>(filter_value, DlPoint(dx, dy)),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushBackdropFilter(FlutterSpiSceneBuilder* builder,
+                                            FlutterSpiImageFilter* filter,
+                                            int32_t blend_mode,
+                                            bool has_backdrop_id,
+                                            int64_t backdrop_id) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!IsValidBlendMode(blend_mode)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto filter_value = SpiImageFilterResolve(filter, DlTileMode::kMirror);
+  if (filter_value == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(
+      std::make_shared<BackdropFilterLayer>(
+          filter_value, static_cast<DlBlendMode>(blend_mode),
+          has_backdrop_id ? std::optional<int64_t>(backdrop_id) : std::nullopt),
+      builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushShaderMask(FlutterSpiSceneBuilder* builder,
+                                        FlutterSpiShader* shader,
+                                        const FlutterSpiRect* mask_rect,
+                                        int32_t blend_mode,
+                                        int32_t filter_quality) {
+  const auto builder_value = FindBuilder(builder);
+  DlRect dl_rect;
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (mask_rect == nullptr || !ToDlRect(*mask_rect, &dl_rect) ||
+      !IsValidBlendMode(blend_mode)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto shader_value = SpiShaderGet(shader);
+  if (shader_value == nullptr || !IsValidFilterQuality(filter_quality)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (shader_value->asImage() != nullptr) {
+    shader_value = shader_value->asImage()->WithSampling(
+        SamplingFromFilterQuality(filter_quality));
+  }
+  PushLayer(std::make_shared<ShaderMaskLayer>(
+                shader_value, dl_rect, static_cast<DlBlendMode>(blend_mode)),
             builder_value);
   return kFlutterSpiOk;
 }
