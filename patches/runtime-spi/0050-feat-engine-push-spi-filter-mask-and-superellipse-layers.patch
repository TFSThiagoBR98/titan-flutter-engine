+bool IsFinite(const FlutterSpiRRect& shape) {
+  return std::isfinite(shape.rect.left) && std::isfinite(shape.rect.top) &&
+         std::isfinite(shape.rect.right) && std::isfinite(shape.rect.bottom) &&
+         std::isfinite(shape.radii[0].x) && std::isfinite(shape.radii[0].y) &&
+         std::isfinite(shape.radii[1].x) && std::isfinite(shape.radii[1].y) &&
+         std::isfinite(shape.radii[2].x) && std::isfinite(shape.radii[2].y) &&
+         std::isfinite(shape.radii[3].x) && std::isfinite(shape.radii[3].y);
+}
+
+DlRoundSuperellipse ToDlRoundSuperellipse(const FlutterSpiRRect& shape) {
+  return DlRoundSuperellipse::MakeRectRadii(
+      DlRect::MakeLTRB(shape.rect.left, shape.rect.top, shape.rect.right,
+                       shape.rect.bottom)
+          .GetPositive(),
+      {.top_left = {shape.radii[0].x, shape.radii[0].y},
+       .top_right = {shape.radii[1].x, shape.radii[1].y},
+       .bottom_left = {shape.radii[3].x, shape.radii[3].y},
+       .bottom_right = {shape.radii[2].x, shape.radii[2].y}});
+}
+
+bool IsValidBlendMode(int32_t blend_mode) {
+  return blend_mode >= kFlutterSpiBlendModeClear &&
+         blend_mode <= kFlutterSpiBlendModeLuminosity;
+}
+
+bool IsValidFilterQuality(int32_t filter_quality) {
+  return filter_quality >= -1 && filter_quality <= 3;
+}
+
+DlImageSampling SamplingFromFilterQuality(int32_t filter_quality) {
+  if (filter_quality <= 0) {
+    return DlImageSampling::kNearestNeighbor;
+  }
+  if (filter_quality == 1) {
+    return DlImageSampling::kLinear;
+  }
+  if (filter_quality == 2) {
+    return DlImageSampling::kMipmapLinear;
+  }
+  return DlImageSampling::kCubic;
+}
+
