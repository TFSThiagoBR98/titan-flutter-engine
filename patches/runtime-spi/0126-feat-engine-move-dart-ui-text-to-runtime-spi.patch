+void DecodeTextShadows(Dart_Handle shadows_data,
+                       std::vector<FlutterSpiTextShadow>& shadows) {
+  tonic::DartByteData byte_data(shadows_data);
+  FML_CHECK(byte_data.length_in_bytes() % kBytesPerShadow == 0);
+
+  const uint32_t* uint_data = static_cast<const uint32_t*>(byte_data.data());
+  const float* float_data = static_cast<const float*>(byte_data.data());
+  const size_t shadow_count =
+      byte_data.length_in_bytes() / kBytesPerShadow;
+  shadows.reserve(shadow_count);
+  for (size_t index = 0; index < shadow_count; index++) {
+    const size_t offset = index * kShadowPropertiesCount;
+    shadows.push_back({
+        .color = ToSpiColor(uint_data[offset + kColorOffset] ^ kColorDefault),
+        .offset = {.x = float_data[offset + kXOffset],
+                   .y = float_data[offset + kYOffset]},
+        .blur_sigma = float_data[offset + kBlurOffset],
+    });
+  }
+}
+
+void DecodeFontFeatures(Dart_Handle data,
+                        std::vector<FlutterSpiFontFeature>& features) {
+  tonic::DartByteData byte_data(data);
+  FML_CHECK(byte_data.length_in_bytes() % kBytesPerFontFeature == 0);
+  const size_t count = byte_data.length_in_bytes() / kBytesPerFontFeature;
+  features.resize(count);
+  const char* bytes = static_cast<const char*>(byte_data.data());
+  for (size_t index = 0; index < count; index++) {
+    const char* entry = bytes + index * kBytesPerFontFeature;
+    std::memcpy(features[index].tag, entry, kFontFeatureTagLength);
+    features[index].value =
+        *reinterpret_cast<const int32_t*>(entry + kFontFeatureTagLength);
   }
 }
 
+void DecodeFontVariations(Dart_Handle data,
+                          std::vector<FlutterSpiFontVariation>& variations) {
+  tonic::DartByteData byte_data(data);
+  FML_CHECK(byte_data.length_in_bytes() % kBytesPerFontVariation == 0);
+  const size_t count = byte_data.length_in_bytes() / kBytesPerFontVariation;
+  variations.resize(count);
+  const char* bytes = static_cast<const char*>(byte_data.data());
+  for (size_t index = 0; index < count; index++) {
+    const char* entry = bytes + index * kBytesPerFontVariation;
+    std::memcpy(variations[index].axis, entry, kFontVariationTagLength);
+    variations[index].value =
+        *reinterpret_cast<const float*>(entry + kFontVariationTagLength);
+  }
+}
