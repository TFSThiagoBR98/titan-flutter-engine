+tonic::Float32List EncodeTextBoxes(
+    const std::vector<FlutterSpiTextBox>& boxes) {
+  tonic::Float32List result(
+      Dart_NewTypedData(Dart_TypedData_kFloat32, boxes.size() * 5));
+  uint64_t position = 0;
+  for (const FlutterSpiTextBox& box : boxes) {
+    result[position++] = box.rect.left;
+    result[position++] = box.rect.top;
+    result[position++] = box.rect.right;
+    result[position++] = box.rect.bottom;
+    result[position++] = static_cast<float>(box.direction);
+  }
+  return result;
+}
