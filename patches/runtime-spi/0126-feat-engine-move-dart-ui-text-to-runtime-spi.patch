+FlutterSpiParagraphMetrics GetMetrics(FlutterSpiParagraph* paragraph) {
+  FlutterSpiParagraphMetrics metrics = {};
+  metrics.struct_size = sizeof(FlutterSpiParagraphMetrics);
+  FML_CHECK(TextApi()->paragraph_get_metrics(paragraph, &metrics) ==
+            kFlutterSpiOk);
