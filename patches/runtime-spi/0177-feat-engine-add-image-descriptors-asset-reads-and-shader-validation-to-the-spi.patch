+FlutterSpiResult SpiRuntimeBackend::ReadAsset(
+    const char* name,
+    FlutterSpiBytesCallback callback,
+    void* user_data) {
+  if (stop_requested_) {
+    return kFlutterSpiInternalError;
+  }
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  if (name == nullptr || callback == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const std::shared_ptr<AssetManager> asset_manager =
+      runtime_delegate_.GetAssetManager();
+  if (asset_manager == nullptr) {
+    task_runners_.GetUITaskRunner()->PostTask([callback, user_data] {
+      callback(user_data, kFlutterSpiInternalError, nullptr, 0);
+    });
+    return kFlutterSpiOk;
+  }
+  std::unique_ptr<fml::Mapping> mapping = asset_manager->GetAsMapping(name);
+  if (mapping == nullptr) {
+    task_runners_.GetUITaskRunner()->PostTask([callback, user_data] {
+      callback(user_data, kFlutterSpiInvalidArgument, nullptr, 0);
+    });
+    return kFlutterSpiOk;
+  }
+  std::vector<uint8_t> bytes(mapping->GetMapping(),
+                             mapping->GetMapping() + mapping->GetSize());
+  task_runners_.GetUITaskRunner()->PostTask(
+      [callback, user_data, bytes = std::move(bytes)]() mutable {
+        callback(user_data, kFlutterSpiOk, bytes.data(), bytes.size());
+      });
+  return kFlutterSpiOk;
+}
