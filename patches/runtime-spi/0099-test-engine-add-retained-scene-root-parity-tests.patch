# Why: specify reusable retained roots, builder lifetime, and invalid argument
# behavior before adding the ABI entries.
diff --git a/engine/src/flutter/runtime_spi/scene/spi_scene_builder_parity_unittests.cc b/engine/src/flutter/runtime_spi/scene/spi_scene_builder_parity_unittests.cc
index 8c1cab0a508..8be594fa642 100644
