+++ b/engine/src/flutter/runtime_spi/scene/spi_scene_builder_parity_unittests.cc
@@ -5,6 +5,7 @@
 #include "flutter/runtime_spi/scene/spi_canvas.h"
 
 #include <memory>
+#include <string>
 
 #include "flutter/display_list/dl_builder.h"
 #include "flutter/display_list/geometry/dl_path_builder.h"
@@ -188,5 +189,124 @@ TEST_F(SpiSceneBuilderTest, BuildClosesOpenLayersAndConsumesBuilder) {
   EXPECT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
 }
 
+FlutterSpiEngineLayer* BuildRetainedRoot(const FlutterSpiSceneApi* api,
+                                         FlutterSpiEngine* engine) {
+  FlutterSpiSceneBuilder* builder = nullptr;
+  EXPECT_EQ(api->scene_builder_create(engine, &builder), kFlutterSpiOk);
+  EXPECT_EQ(api->scene_push_offset(builder, 3.0f, 4.0f), kFlutterSpiOk);
+  EXPECT_EQ(api->scene_push_opacity(builder, 128, 5.0f, 6.0f), kFlutterSpiOk);
+
+  FlutterSpiEngineLayer* root = nullptr;
+  EXPECT_EQ(api->scene_build_root(builder, &root), kFlutterSpiOk);
+  return root;
+}
+
+std::string SceneTraceFor(const FlutterSpiScene* scene) {
+  EXPECT_NE(scene, nullptr);
+  EXPECT_NE(scene->layer_tree, nullptr);
+  return SceneTrace(*scene->layer_tree);
+}
+
+TEST_F(SpiSceneBuilderTest, BuildRootMatchesBuild) {
+  ASSERT_NE(api()->scene_build_root, nullptr);
+  ASSERT_NE(api()->scene_create_from_root, nullptr);
+  FlutterSpiEngineLayer* root = BuildRetainedRoot(api(), engine());
+  ASSERT_NE(root, nullptr);
+
+  FlutterSpiScene* root_scene = nullptr;
+  ASSERT_EQ(api()->scene_create_from_root(root, 100, 80, &root_scene),
+            kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* builder = nullptr;
+  ASSERT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_offset(builder, 3.0f, 4.0f), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_opacity(builder, 128, 5.0f, 6.0f),
+            kFlutterSpiOk);
+  FlutterSpiScene* built_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(builder, 100, 80, &built_scene), kFlutterSpiOk);
+
+  EXPECT_EQ(SceneTraceFor(root_scene), SceneTraceFor(built_scene));
+  EXPECT_EQ(SpiSceneRelease(root_scene), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(built_scene), kFlutterSpiOk);
+  EXPECT_EQ(api()->engine_layer_release(root), kFlutterSpiOk);
+}
+
+TEST_F(SpiSceneBuilderTest, RootIsReusableAcrossScenes) {
+  ASSERT_NE(api()->scene_build_root, nullptr);
+  ASSERT_NE(api()->scene_create_from_root, nullptr);
+  FlutterSpiEngineLayer* root = BuildRetainedRoot(api(), engine());
+  ASSERT_NE(root, nullptr);
+
+  FlutterSpiScene* first_scene = nullptr;
+  FlutterSpiScene* second_scene = nullptr;
+  ASSERT_EQ(api()->scene_create_from_root(root, 100, 80, &first_scene),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_create_from_root(root, 100, 80, &second_scene),
+            kFlutterSpiOk);
+  const std::string expected_trace = SceneTraceFor(first_scene);
+  ASSERT_EQ(SpiSceneRelease(first_scene), kFlutterSpiOk);
+
+  EXPECT_EQ(SceneTraceFor(second_scene), expected_trace);
+  EXPECT_EQ(SpiSceneRelease(second_scene), kFlutterSpiOk);
+  EXPECT_EQ(api()->engine_layer_release(root), kFlutterSpiOk);
+}
+
+TEST_F(SpiSceneBuilderTest, RootOutlivesBuilderAndScenes) {
+  ASSERT_NE(api()->scene_build_root, nullptr);
+  ASSERT_NE(api()->scene_create_from_root, nullptr);
+  ASSERT_NE(api()->scene_add_retained, nullptr);
+  FlutterSpiEngineLayer* root = BuildRetainedRoot(api(), engine());
+  ASSERT_NE(root, nullptr);
+
+  FlutterSpiScene* scene = nullptr;
+  ASSERT_EQ(api()->scene_create_from_root(root, 100, 80, &scene), kFlutterSpiOk);
+  const std::string expected_trace = SceneTraceFor(scene);
+  ASSERT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* builder = nullptr;
+  ASSERT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_add_retained(builder, root), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_builder_release(builder), kFlutterSpiOk);
+
+  ASSERT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_add_retained(builder, root), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_build(builder, 100, 80, &scene), kFlutterSpiOk);
+  EXPECT_EQ(SceneTraceFor(scene), expected_trace);
+  EXPECT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
+  EXPECT_EQ(api()->engine_layer_release(root), kFlutterSpiOk);
+}
+
+TEST_F(SpiSceneBuilderTest, InvalidRootArgumentsAreRejected) {
+  ASSERT_NE(api()->scene_build_root, nullptr);
+  ASSERT_NE(api()->scene_create_from_root, nullptr);
+  ASSERT_NE(api()->scene_builder_release, nullptr);
+
+  FlutterSpiSceneBuilder* builder = nullptr;
+  ASSERT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+  FlutterSpiEngineLayer* root = nullptr;
+  EXPECT_EQ(api()->scene_build_root(builder, nullptr), kFlutterSpiInvalidArgument);
+  EXPECT_EQ(api()->scene_build_root(nullptr, &root), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(api()->scene_builder_release(builder), kFlutterSpiOk);
+
+  FlutterSpiScene* scene = nullptr;
+  EXPECT_EQ(api()->scene_create_from_root(nullptr, 100, 80, &scene),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(api()->scene_create_from_root(nullptr, 0, 80, &scene),
+            kFlutterSpiInvalidHandle);
+
+  root = BuildRetainedRoot(api(), engine());
+  ASSERT_NE(root, nullptr);
+  EXPECT_EQ(api()->scene_create_from_root(root, 0, 80, &scene),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(api()->scene_create_from_root(root, 100, 0, &scene),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(api()->scene_create_from_root(root, 100, 80, nullptr),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(api()->scene_create_from_root(root, 100, 80, &scene),
+            kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
+  EXPECT_EQ(api()->engine_layer_release(root), kFlutterSpiOk);
+}
