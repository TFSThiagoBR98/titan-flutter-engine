+#ifndef FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_RUNTIME_EXTENSIONS_H_
+#define FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_RUNTIME_EXTENSIONS_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+  const uint8_t* data;
+  size_t size;
+  void* release_user_data;
+  void (*release)(void* release_user_data);
+} FlutterSpiMapping;
+
+typedef enum {
+  kFlutterSpiRuntimeErrorNone = 0,
+  kFlutterSpiRuntimeErrorUnknown = 1,
+  kFlutterSpiRuntimeErrorApi = 2,
+  kFlutterSpiRuntimeErrorCompilation = 3,
+} FlutterSpiRuntimeErrorType;
+
+typedef struct FlutterSpiRuntimeExtensions {
+  size_t struct_size;
+  void* user_data;
+  void (*free_string)(void* user_data, char* string);
+  int64_t (*get_main_port)(void* user_data);
+  bool (*get_root_isolate_service_id)(void* user_data, char** out_utf8);
+  bool (*get_root_isolate_return_code)(void* user_data, uint32_t* out_code);
+  char* (*get_isolate_name)(void* user_data);
+  int32_t (*get_last_error)(void* user_data);
+  bool (*has_live_ports)(void* user_data);
+  bool (*has_pending_microtasks)(void* user_data);
+  void (*flush_microtask_queue)(void* user_data);
+  void (*load_deferred_library)(void* user_data,
+                                int64_t loading_unit_id,
+                                FlutterSpiMapping snapshot_data,
+                                FlutterSpiMapping snapshot_instructions);
+  void (*load_deferred_library_error)(void* user_data,
+                                      int64_t loading_unit_id,
+                                      const char* error_message,
+                                      bool transient);
+  void (*shutdown_platform_isolates)(void* user_data);
+  void (*set_root_isolate_owner_to_current_thread)(void* user_data);
+} FlutterSpiRuntimeExtensions;
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_RUNTIME_EXTENSIONS_H_
