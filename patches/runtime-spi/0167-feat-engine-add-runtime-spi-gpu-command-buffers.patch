+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  AllowTextureDimensions(*allocator);
+  auto texture = std::make_shared<NiceMock<impeller::testing::MockTexture>>(
+      impeller::TextureDescriptor{.size = impeller::ISize(64, 32),
+                                  .mip_count = 1,
+                                  .array_layer_count = 1});
+  auto device_buffer =
+      std::make_shared<NiceMock<impeller::testing::MockDeviceBuffer>>(
+          impeller::DeviceBufferDescriptor{.size = 1024});
+  ON_CALL(*context, CreateCommandBuffer())
+      .WillByDefault(Return(command_buffer));
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  ON_CALL(*allocator, OnCreateTexture(::testing::_, true))
+      .WillByDefault(Return(texture));
+  ON_CALL(*allocator, OnCreateBuffer(::testing::_))
+      .WillByDefault(Return(device_buffer));
+  ON_CALL(*texture, GetSize()).WillByDefault(Return(impeller::ISize(64, 32)));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuCommandBuffer* gpu_command_buffer = nullptr;
+  ASSERT_EQ(SpiGpuCommandBufferCreate(gpu_context, &gpu_command_buffer),
+            kFlutterSpiOk);
+  auto texture_descriptor = MakeTextureDescriptor();
+  FlutterSpiGpuTexture* gpu_texture = nullptr;
+  ASSERT_EQ(SpiGpuTextureCreate(gpu_context, &texture_descriptor, &gpu_texture),
+            kFlutterSpiOk);
+  FlutterSpiGpuBufferDescriptor buffer_descriptor = {
+      .struct_size = sizeof(buffer_descriptor),
+      .storage_mode = kFlutterSpiGpuStorageModeHostVisible,
+      .size = 1024,
+  };
+  FlutterSpiGpuBuffer* gpu_buffer = nullptr;
+  ASSERT_EQ(SpiGpuBufferCreate(gpu_context, &buffer_descriptor, &gpu_buffer),
+            kFlutterSpiOk);
+  const FlutterSpiGpuRegion region = {.x = 60, .y = 0, .width = 8, .height = 1};
+
+  EXPECT_EQ(SpiGpuCommandBufferCopyTextureToBuffer(
+                gpu_command_buffer, gpu_texture, &region, gpu_buffer, 0),
+            kFlutterSpiInvalidArgument);
+
+  EXPECT_EQ(SpiGpuBufferRelease(gpu_buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuTextureRelease(gpu_texture), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuCommandBufferRelease(gpu_command_buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
