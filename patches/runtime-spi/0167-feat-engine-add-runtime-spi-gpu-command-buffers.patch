+SpiHandleTable<SpiGpuCommandBuffer>& CommandBuffers() {
+  return LeakedHandleTable<SpiGpuCommandBuffer>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuCommandBuffer* command_buffer) {
+  return reinterpret_cast<uintptr_t>(command_buffer);
+}
+
+FlutterSpiGpuCommandBuffer* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuCommandBuffer*>(value);
+}
+
+SpiGpuCommandBuffer* FindCommandBuffer(
+    FlutterSpiGpuCommandBuffer* command_buffer) {
+  return CommandBuffers().FindRaw(HandleValue(command_buffer));
+}
+
+int32_t MipDimension(int32_t dimension, int32_t mip_level) {
+  const uint32_t shift = static_cast<uint32_t>(mip_level);
+  if (shift >= std::numeric_limits<int32_t>::digits) {
+    return 1;
+  }
+  return std::max(1, dimension >> shift);
+}
+
+bool IsRegionInsideTexture(const impeller::Texture& texture,
+                           const FlutterSpiGpuRegion& region,
+                           int32_t mip_level) {
+  if (mip_level < 0 || region.x < 0 || region.y < 0 || region.width <= 0 ||
+      region.height <= 0) {
+    return false;
+  }
+  const auto& descriptor = texture.GetTextureDescriptor();
+  if (static_cast<size_t>(mip_level) >= descriptor.mip_count) {
+    return false;
+  }
+  const int32_t width = MipDimension(texture.GetSize().width, mip_level);
+  const int32_t height = MipDimension(texture.GetSize().height, mip_level);
+  return region.x <= width && region.y <= height &&
+         region.width <= width - region.x && region.height <= height - region.y;
+}
+
+impeller::IRect ToImpellerRegion(const FlutterSpiGpuRegion& region) {
+  return impeller::IRect::MakeXYWH(region.x, region.y, region.width,
+                                   region.height);
+}
+
+FlutterSpiResult StatusToResult(impeller::CommandBuffer::Status status) {
+  return status == impeller::CommandBuffer::Status::kCompleted
+             ? kFlutterSpiOk
+             : kFlutterSpiInternalError;
+}
