+TEST_F(SpiGpuContextTest, CommandBufferSubmitCallsBackOnceOnUiThread) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto command_buffer =
+      std::make_shared<NiceMock<impeller::testing::MockCommandBuffer>>(context);
+  auto command_queue =
+      std::make_shared<NiceMock<impeller::testing::MockCommandQueue>>();
+  ON_CALL(*context, CreateCommandBuffer())
+      .WillByDefault(Return(command_buffer));
+  ON_CALL(*context, GetCommandQueue()).WillByDefault(Return(command_queue));
+  ON_CALL(*command_queue, Submit(::testing::_, ::testing::_))
+      .WillByDefault(DoAll(
+          [](const std::vector<std::shared_ptr<impeller::CommandBuffer>>&,
+             const impeller::CommandQueue::CompletionCallback& callback) {
+            callback(impeller::CommandBuffer::Status::kCompleted);
+          },
+          Return(fml::Status())));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuCommandBuffer* gpu_command_buffer = nullptr;
+  ASSERT_EQ(SpiGpuCommandBufferCreate(gpu_context, &gpu_command_buffer),
+            kFlutterSpiOk);
+
+  SubmitCallbackState state;
+  state.ui_task_runner = task_runners_->GetUITaskRunner();
+  EXPECT_EQ(SpiGpuCommandBufferSubmit(gpu_command_buffer, CaptureSubmitResult,
+                                      &state),
+            kFlutterSpiOk);
+  EXPECT_EQ(state.call_count, 1u);
+  EXPECT_TRUE(state.called_on_ui_thread);
+  EXPECT_EQ(state.result, kFlutterSpiOk);
+
+  EXPECT_EQ(SpiGpuCommandBufferRelease(gpu_command_buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
