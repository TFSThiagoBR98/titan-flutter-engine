+bool SpiGpuCommandBuffer::Encodable::EncodeCommands() const {
+  if (render_pass != nullptr) {
+    return render_pass->EncodeCommands();
+  }
+  if (blit_pass != nullptr) {
+    return blit_pass->EncodeCommands();
+  }
+  return false;
+}
+
+std::shared_ptr<impeller::CommandBuffer>
+SpiGpuCommandBuffer::GetCommandBuffer() {
+  return command_buffer_;
+}
+
+void SpiGpuCommandBuffer::AddRenderPass(
+    std::shared_ptr<impeller::RenderPass> render_pass) {
+  encodables_.push_back({.render_pass = std::move(render_pass)});
+}
+
+bool SpiGpuCommandBuffer::AddCompletionCallback(
+    CompletionCallback completion_callback) {
+  if (submitted_) {
+    return false;
+  }
+  if (completion_callback) {
+    completion_callbacks_.push_back(std::move(completion_callback));
+  }
+  return true;
+}
+
+std::shared_ptr<impeller::BlitPass> SpiGpuCommandBuffer::GetOrCreateBlitPass() {
+  if (!encodables_.empty() && encodables_.back().blit_pass != nullptr) {
+    return encodables_.back().blit_pass;
+  }
+  auto blit_pass = command_buffer_->CreateBlitPass();
+  if (blit_pass == nullptr) {
+    return nullptr;
+  }
+  encodables_.push_back({.blit_pass = blit_pass});
+  return blit_pass;
+}
+
+bool SpiGpuCommandBuffer::CopyBufferToTexture(
+    std::shared_ptr<impeller::DeviceBuffer> source,
+    size_t source_offset,
+    size_t source_length,
+    std::shared_ptr<impeller::Texture> destination,
+    impeller::IRect destination_region,
+    uint32_t mip_level,
+    uint32_t slice) {
+  auto blit_pass = GetOrCreateBlitPass();
+  if (blit_pass == nullptr) {
+    return false;
+  }
+  buffers_.push_back(source);
+  textures_.push_back(destination);
+  impeller::BufferView source_view(
+      source, impeller::Range(source_offset, source_length));
+  return blit_pass->AddCopy(
+      std::move(source_view), destination, destination_region,
+      "CommandBuffer.copyBufferToTexture", mip_level, slice);
+}
+
+bool SpiGpuCommandBuffer::CopyTextureToBuffer(
+    std::shared_ptr<impeller::Texture> source,
+    impeller::IRect source_region,
+    std::shared_ptr<impeller::DeviceBuffer> destination,
+    size_t destination_offset) {
+  auto blit_pass = GetOrCreateBlitPass();
+  if (blit_pass == nullptr) {
+    return false;
+  }
+  textures_.push_back(source);
+  buffers_.push_back(destination);
+  return blit_pass->AddCopy(source, destination, source_region,
+                            destination_offset,
+                            "CommandBuffer.copyTextureToBuffer");
+}
+
+bool SpiGpuCommandBuffer::CopyTextureToTexture(
+    std::shared_ptr<impeller::Texture> source,
+    std::shared_ptr<impeller::Texture> destination,
+    impeller::IRect source_region,
+    impeller::IPoint destination_origin) {
+  auto blit_pass = GetOrCreateBlitPass();
+  if (blit_pass == nullptr) {
+    return false;
+  }
+  textures_.push_back(source);
+  textures_.push_back(destination);
+  return blit_pass->AddCopy(source, destination, source_region,
+                            destination_origin,
+                            "CommandBuffer.copyTextureToTexture");
+}
+
+void SpiGpuCommandBuffer::DispatchCompletion(
+    const CompletionCallback& callback,
+    impeller::CommandBuffer::Status status) const {
+  if (!callback) {
+    return;
+  }
+  auto deliver = [callback, status]() { callback(status); };
+  if (!ui_task_runner_ || ui_task_runner_->RunsTasksOnCurrentThread()) {
+    deliver();
+    return;
+  }
+  ui_task_runner_->PostTask(deliver);
+}
+
+bool SpiGpuCommandBuffer::Submit() {
+  return Submit({});
+}
+
+bool SpiGpuCommandBuffer::Submit(
+    const CompletionCallback& completion_callback) {
+  if (submitted_) {
+    DispatchCompletion(completion_callback,
+                       impeller::CommandBuffer::Status::kError);
+    return false;
+  }
+  submitted_ = true;
+
+  std::vector<CompletionCallback> callbacks = std::move(completion_callbacks_);
+  if (completion_callback) {
+    callbacks.push_back(completion_callback);
+  }
+
+  std::shared_ptr<std::atomic_bool> callback_called =
+      std::make_shared<std::atomic_bool>(false);
+  CompletionCallback combined_completion_callback;
+  if (!callbacks.empty()) {
+    combined_completion_callback =
+        [callbacks = std::move(callbacks), callback_called,
+         this](impeller::CommandBuffer::Status status) mutable {
+          if (callback_called->exchange(true)) {
+            return;
+          }
+          for (const auto& callback : callbacks) {
+            DispatchCompletion(callback, status);
+          }
+        };
+  }
+
+  if (context_->GetBackendType() == impeller::Context::BackendType::kOpenGLES) {
+    if (!raster_task_runner_) {
+      if (combined_completion_callback) {
+        combined_completion_callback(impeller::CommandBuffer::Status::kError);
+      }
+      return false;
+    }
+    raster_task_runner_->PostTask(
+        fml::MakeCopyable([context = context_, command_buffer = command_buffer_,
+                           completion_callback = combined_completion_callback,
+                           encodables = encodables_]() mutable {
+          for (const auto& encodable : encodables) {
+            if (!encodable.EncodeCommands()) {
+              if (completion_callback) {
+                completion_callback(impeller::CommandBuffer::Status::kError);
+              }
+              context->DisposeThreadLocalCachedResources();
+              return;
+            }
+          }
+          auto command_queue = context->GetCommandQueue();
+          if (command_queue == nullptr) {
+            if (completion_callback) {
+              completion_callback(impeller::CommandBuffer::Status::kError);
+            }
+            context->DisposeThreadLocalCachedResources();
+            return;
+          }
+          const auto status =
+              command_queue->Submit({command_buffer}, completion_callback);
+          if (!status.ok() && completion_callback) {
+            completion_callback(impeller::CommandBuffer::Status::kError);
+          }
+          context->DisposeThreadLocalCachedResources();
+        }));
+    return true;
+  }
+
+  for (const auto& encodable : encodables_) {
+    if (!encodable.EncodeCommands()) {
+      if (combined_completion_callback) {
+        combined_completion_callback(impeller::CommandBuffer::Status::kError);
+      }
+      return false;
+    }
+  }
+
+  auto command_queue = context_->GetCommandQueue();
+  if (command_queue == nullptr) {
+    if (combined_completion_callback) {
+      combined_completion_callback(impeller::CommandBuffer::Status::kError);
+    }
+    context_->DisposeThreadLocalCachedResources();
+    return false;
+  }
+  const auto status =
+      command_queue->Submit({command_buffer_}, combined_completion_callback);
+  if (!status.ok() && combined_completion_callback) {
+    combined_completion_callback(impeller::CommandBuffer::Status::kError);
+  }
+  context_->DisposeThreadLocalCachedResources();
+  return status.ok();
+}
+
+FlutterSpiResult SpiGpuCommandBuffer::Submit(
+    FlutterSpiGpuSubmitCallback callback,
+    void* user_data) {
+  if (submitted_) {
+    if (callback != nullptr) {
+      DispatchCompletion(
+          [callback, user_data](impeller::CommandBuffer::Status status) {
+            callback(user_data, StatusToResult(status));
+          },
+          impeller::CommandBuffer::Status::kError);
+    }
+    return kFlutterSpiInvalidArgument;
+  }
+  CompletionCallback completion_callback;
+  if (callback != nullptr) {
+    completion_callback = [callback,
+                           user_data](impeller::CommandBuffer::Status status) {
+      callback(user_data, StatusToResult(status));
+    };
+  }
+  return Submit(completion_callback) ? kFlutterSpiOk : kFlutterSpiInternalError;
+}
+
+FlutterSpiResult SpiGpuCommandBufferCreate(
+    FlutterSpiGpuContext* context,
+    FlutterSpiGpuCommandBuffer** out_command_buffer) {
+  if (out_command_buffer == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_command_buffer = nullptr;
+  auto context_value = SpiGpuContextGetImpeller(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  auto command_buffer = context_value->CreateCommandBuffer();
+  if (command_buffer == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  auto core = std::make_shared<SpiGpuCommandBuffer>(
+      context_value, std::move(command_buffer),
+      SpiGpuContextGetRasterTaskRunner(context),
+      SpiGpuContextGetUiTaskRunner(context));
+  const uintptr_t handle = CommandBuffers().Insert(std::move(core));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_command_buffer = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuCommandBufferCopyBufferToTexture(
+    FlutterSpiGpuCommandBuffer* command_buffer,
+    FlutterSpiGpuBuffer* source,
+    size_t source_offset,
+    size_t source_length,
+    FlutterSpiGpuTexture* destination,
+    const FlutterSpiGpuRegion* destination_region,
+    int32_t mip_level,
+    int32_t slice) {
+  auto* command_buffer_value = FindCommandBuffer(command_buffer);
+  if (command_buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (destination_region == nullptr || mip_level < 0 || slice < 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto source_value = SpiGpuBufferGetImpeller(source);
+  auto destination_value = SpiGpuTextureGetImpeller(destination);
+  if (source_value == nullptr || destination_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const size_t source_size = source_value->GetDeviceBufferDescriptor().size;
+  if (source_offset > source_size ||
+      source_length > source_size - source_offset ||
+      !IsRegionInsideTexture(*destination_value, *destination_region,
+                             mip_level) ||
+      !destination_value->IsSliceValid(static_cast<size_t>(slice))) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return command_buffer_value->CopyBufferToTexture(
+             std::move(source_value), source_offset, source_length,
+             std::move(destination_value),
+             ToImpellerRegion(*destination_region),
+             static_cast<uint32_t>(mip_level), static_cast<uint32_t>(slice))
+             ? kFlutterSpiOk
+             : kFlutterSpiInternalError;
+}
+
+FlutterSpiResult SpiGpuCommandBufferCopyTextureToBuffer(
+    FlutterSpiGpuCommandBuffer* command_buffer,
+    FlutterSpiGpuTexture* source,
+    const FlutterSpiGpuRegion* source_region,
+    FlutterSpiGpuBuffer* destination,
+    size_t destination_offset) {
+  auto* command_buffer_value = FindCommandBuffer(command_buffer);
+  if (command_buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (source_region == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto source_value = SpiGpuTextureGetImpeller(source);
+  auto destination_value = SpiGpuBufferGetImpeller(destination);
+  if (source_value == nullptr || destination_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (destination_offset >
+          destination_value->GetDeviceBufferDescriptor().size ||
+      !IsRegionInsideTexture(*source_value, *source_region, 0)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return command_buffer_value->CopyTextureToBuffer(
+             std::move(source_value), ToImpellerRegion(*source_region),
+             std::move(destination_value), destination_offset)
+             ? kFlutterSpiOk
+             : kFlutterSpiInternalError;
+}
+
+FlutterSpiResult SpiGpuCommandBufferCopyTextureToTexture(
+    FlutterSpiGpuCommandBuffer* command_buffer,
+    FlutterSpiGpuTexture* source,
+    FlutterSpiGpuTexture* destination,
+    const FlutterSpiGpuRegion* source_region,
+    int32_t destination_x,
+    int32_t destination_y) {
+  auto* command_buffer_value = FindCommandBuffer(command_buffer);
+  if (command_buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (source_region == nullptr || destination_x < 0 || destination_y < 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto source_value = SpiGpuTextureGetImpeller(source);
+  auto destination_value = SpiGpuTextureGetImpeller(destination);
+  if (source_value == nullptr || destination_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!IsRegionInsideTexture(*source_value, *source_region, 0) ||
+      source_region->width >
+          destination_value->GetSize().width - destination_x ||
+      source_region->height >
+          destination_value->GetSize().height - destination_y) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return command_buffer_value->CopyTextureToTexture(
+             std::move(source_value), std::move(destination_value),
+             ToImpellerRegion(*source_region),
+             impeller::IPoint(destination_x, destination_y))
+             ? kFlutterSpiOk
+             : kFlutterSpiInternalError;
+}
+
+FlutterSpiResult SpiGpuCommandBufferSubmit(
+    FlutterSpiGpuCommandBuffer* command_buffer,
+    FlutterSpiGpuSubmitCallback callback,
+    void* user_data) {
+  auto* command_buffer_value = FindCommandBuffer(command_buffer);
+  if (command_buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return command_buffer_value->Submit(callback, user_data);
+}
+
+FlutterSpiResult SpiGpuCommandBufferRetain(
+    FlutterSpiGpuCommandBuffer* command_buffer) {
+  return CommandBuffers().Retain(HandleValue(command_buffer))
+             ? kFlutterSpiOk
+             : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuCommandBufferRelease(
+    FlutterSpiGpuCommandBuffer* command_buffer) {
+  return CommandBuffers().Release(HandleValue(command_buffer))
+             ? kFlutterSpiOk
+             : kFlutterSpiInvalidHandle;
+}
+
+SpiGpuCommandBuffer* SpiGpuCommandBufferGetCore(
+    FlutterSpiGpuCommandBuffer* command_buffer) {
+  return FindCommandBuffer(command_buffer);
+}
+
+}  // namespace flutter
