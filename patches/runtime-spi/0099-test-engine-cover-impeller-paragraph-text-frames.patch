+TEST_F(SpiParagraphDrawTest, ImpellerEngineRecordsTextFrames) {
+  fml::MessageLoop::EnsureInitializedForCurrentThread();
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  auto task_runner = fml::MessageLoop::GetCurrent().GetTaskRunner();
+#pragma clang diagnostic pop
+  TaskRunners task_runners("spi-paragraph-draw-test", task_runner, task_runner,
+                           task_runner, task_runner);
+  TestEngineDelegate engine_delegate;
+  Settings settings;
+  auto engine = std::make_unique<Engine>(
+      engine_delegate, nullptr, task_runners, settings,
+      std::unique_ptr<Animator>(), fml::WeakPtr<IOManager>(), font_collection_,
+      std::unique_ptr<RuntimeController>(), nullptr);
+  FlutterSpiRuntimeTable runtime_table = {};
+  auto backend = std::make_unique<SpiRuntimeBackend>(
+      *engine, task_runners, runtime_table,
+      fml::TaskRunnerAffineWeakPtr<ImageDecoder>(),
+      fml::TaskRunnerAffineWeakPtr<ImageGeneratorRegistry>(),
+      fml::TaskRunnerAffineWeakPtr<SnapshotDelegate>(), nullptr, true);
+
+  const FlutterSpiTextApi* text_api = backend->engine_api().text;
+  ASSERT_NE(text_api, nullptr);
+  const FlutterSpiParagraphStyle paragraph_style = {
+      .struct_size = sizeof(FlutterSpiParagraphStyle),
+      .font_family = "Roboto",
+      .font_size = 18.0f,
+  };
+  const FlutterSpiTextStyle text_style = {
+      .struct_size = sizeof(FlutterSpiTextStyle),
+      .color = kTextColor,
+      .font_families = kRobotoFamilies,
+      .font_family_count = 1,
+      .font_size = 18.0f,
+  };
+  FlutterSpiParagraphBuilder* builder = nullptr;
+  ASSERT_EQ(text_api->paragraph_builder_create(backend->engine_handle(),
+                                               &paragraph_style, &builder),
+            kFlutterSpiOk);
+  ASSERT_EQ(text_api->paragraph_builder_push_style(builder, &text_style),
+            kFlutterSpiOk);
+  ASSERT_EQ(text_api->paragraph_builder_add_text(builder, "Hello, SPI", 10),
+            kFlutterSpiOk);
+  FlutterSpiParagraph* paragraph = nullptr;
+  ASSERT_EQ(text_api->paragraph_builder_build(builder, &paragraph),
+            kFlutterSpiOk);
+  ASSERT_EQ(text_api->paragraph_layout(paragraph, kLayoutWidth), kFlutterSpiOk);
+
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(SpiSceneApi()->recorder_create(backend->engine_handle(), nullptr,
+                                            &recorder),
+            kFlutterSpiOk);
+  ASSERT_EQ(text_api->canvas_draw_paragraph(recorder, paragraph, kParagraphX,
+                                             kParagraphY),
+            kFlutterSpiOk);
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(SpiSceneApi()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+  const DisplayList* display_list = SpiPictureDisplayListForTesting(picture);
+  ASSERT_NE(display_list, nullptr);
+
+  TextTypeRecorder type_recorder;
+  display_list->Dispatch(type_recorder);
+  ASSERT_FALSE(type_recorder.texts.empty());
+  ASSERT_NE(type_recorder.texts.front(), nullptr);
+  EXPECT_NE(type_recorder.texts.front()->GetTextFrame(), nullptr);
+  EXPECT_EQ(type_recorder.texts.front()->GetTextBlob(), nullptr);
+
+  EXPECT_EQ(text_api->paragraph_release(paragraph), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneApi()->picture_release(picture), kFlutterSpiOk);
+}
