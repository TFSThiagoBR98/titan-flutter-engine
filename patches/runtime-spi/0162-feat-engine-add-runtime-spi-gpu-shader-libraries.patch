+}  // namespace
+
+std::shared_ptr<SpiGpuShaderLibrary> SpiGpuShaderLibrary::MakeFromFlatbuffer(
+    impeller::Context::BackendType backend_type,
+    std::shared_ptr<fml::Mapping> payload,
+    std::string library_id) {
+  if (payload == nullptr || !payload->GetMapping()) {
+    return nullptr;
+  }
+  if (library_id.empty()) {
+    library_id = impeller::ShaderKey::MakeFallbackLibraryId();
+  }
+  ShaderMap shader_map = ParseShaderBundle(backend_type, payload, library_id);
+  if (shader_map.empty()) {
+    return nullptr;
+  }
+  return std::shared_ptr<SpiGpuShaderLibrary>(
+      new SpiGpuShaderLibrary(std::move(payload), std::move(shader_map),
+                              std::move(library_id), backend_type));
+}
+
+std::string SpiGpuShaderLibrary::ReloadFromFlatbuffer(
+    impeller::Context::BackendType backend_type,
+    std::shared_ptr<fml::Mapping> payload) {
+  if (payload == nullptr || !payload->GetMapping()) {
+    return "Empty shader bundle payload.";
+  }
+  ShaderMap new_shaders = ParseShaderBundle(backend_type, payload, library_id_);
+  if (new_shaders.empty()) {
+    return "Shader bundle could not be parsed.";
+  }
+
+  ShaderMap merged;
+  for (auto& [name, parsed] : new_shaders) {
+    auto it = shaders_.find(name);
+    if (it != shaders_.end()) {
+      it->second->ResetFrom(*parsed);
+      merged[name] = it->second;
+    } else {
+      merged[name] = std::move(parsed);
+    }
+  }
+  shaders_ = std::move(merged);
+  payload_ = std::move(payload);
+  return "";
+}
+
+std::shared_ptr<SpiGpuShader> SpiGpuShaderLibrary::FindShader(
+    const std::string& shader_name) const {
+  auto it = shaders_.find(shader_name);
+  return it == shaders_.end() ? nullptr : it->second;
+}
+
+SpiGpuShaderLibrary::SpiGpuShaderLibrary(
+    std::shared_ptr<fml::Mapping> payload,
+    ShaderMap shaders,
+    std::string library_id,
+    impeller::Context::BackendType backend_type)
+    : payload_(std::move(payload)),
+      shaders_(std::move(shaders)),
+      library_id_(std::move(library_id)),
+      backend_type_(backend_type) {}
+
+FlutterSpiResult SpiGpuShaderLibraryCreate(
+    FlutterSpiGpuContext* context,
+    const FlutterSpiGpuShaderLibraryDescriptor* descriptor,
+    FlutterSpiGpuShaderLibrary** out_library,
+    char** out_error) {
+  if (out_error != nullptr) {
+    *out_error = nullptr;
+  }
+  if (descriptor == nullptr || out_library == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_library = nullptr;
+  if (descriptor->struct_size <
+      offsetof(FlutterSpiGpuShaderLibraryDescriptor, library_id) +
+          sizeof(descriptor->library_id)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!IsSupportedFormat(descriptor->format)) {
+    SetError(out_error, "Unsupported shader format.");
+    return kFlutterSpiUnsupported;
+  }
+  std::shared_ptr<impeller::Context> context_value =
+      SpiGpuContextGetImpeller(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  std::shared_ptr<fml::Mapping> payload = MappingFromDescriptor(*descriptor);
+  if (payload == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto library = SpiGpuShaderLibrary::MakeFromFlatbuffer(
+      context_value->GetBackendType(), std::move(payload),
+      descriptor->library_id == nullptr ? "" : descriptor->library_id);
+  if (library == nullptr) {
+    SetError(out_error,
+             "Failed to parse the shader bundle bytes. The bytes must be a "
+             "shader bundle compiled by a compatible impellerc.");
+    return kFlutterSpiInvalidArgument;
+  }
+  const uintptr_t handle = Libraries().Insert(std::move(library));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_library = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderLibraryReload(
+    FlutterSpiGpuShaderLibrary* library,
+    const FlutterSpiGpuShaderLibraryDescriptor* descriptor,
+    char** out_error) {
+  if (out_error != nullptr) {
+    *out_error = nullptr;
+  }
+  SpiGpuShaderLibrary* library_value = FindLibrary(library);
+  if (library_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (descriptor == nullptr ||
+      descriptor->struct_size <
+          offsetof(FlutterSpiGpuShaderLibraryDescriptor, library_id) +
+              sizeof(descriptor->library_id)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!IsSupportedFormat(descriptor->format)) {
+    SetError(out_error, "Unsupported shader format.");
+    return kFlutterSpiUnsupported;
+  }
+  std::shared_ptr<fml::Mapping> payload = MappingFromDescriptor(*descriptor);
+  if (payload == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::string error = library_value->ReloadFromFlatbuffer(
+      library_value->GetBackendType(), std::move(payload));
+  if (!error.empty()) {
+    SetError(out_error, error);
+    return kFlutterSpiInvalidArgument;
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderLibraryGetShader(
+    FlutterSpiGpuShaderLibrary* library,
+    const char* name,
+    FlutterSpiGpuShader** out_shader) {
+  SpiGpuShaderLibrary* library_value = FindLibrary(library);
+  if (library_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (name == nullptr || out_shader == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_shader = nullptr;
+  std::shared_ptr<SpiGpuShader> shader = library_value->FindShader(name);
+  if (shader == nullptr) {
+    return kFlutterSpiOk;
+  }
+  *out_shader = SpiGpuShaderInsertHandle(std::move(shader));
+  return *out_shader == nullptr ? kFlutterSpiInternalError : kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderLibraryRetain(
+    FlutterSpiGpuShaderLibrary* library) {
+  return Libraries().Retain(HandleValue(library)) ? kFlutterSpiOk
+                                                  : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuShaderLibraryRelease(
+    FlutterSpiGpuShaderLibrary* library) {
+  return Libraries().Release(HandleValue(library)) ? kFlutterSpiOk
+                                                   : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuShaderLibraryCreateForBackend(
+    int32_t backend,
+    const uint8_t* data,
+    size_t size,
+    const char* library_id,
+    FlutterSpiGpuShaderLibrary** out_library) {
+  if (out_library == nullptr || (data == nullptr && size != 0)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_library = nullptr;
+  std::shared_ptr<fml::Mapping> payload = CopyPayload(data, size);
+  if (payload == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto library = SpiGpuShaderLibrary::MakeFromFlatbuffer(
+      static_cast<impeller::Context::BackendType>(backend), std::move(payload),
+      library_id == nullptr ? "" : library_id);
+  if (library == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const uintptr_t handle = Libraries().Insert(std::move(library));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_library = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
