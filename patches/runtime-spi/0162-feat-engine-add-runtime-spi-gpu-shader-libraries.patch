+SpiGpuShaderLibrary::ShaderMap ParseShaderBundle(
+    impeller::Context::BackendType backend_type,
+    const std::shared_ptr<fml::Mapping>& payload,
+    const std::string& library_id) {
+  SpiGpuShaderLibrary::ShaderMap shader_map;
+  if (payload == nullptr || !payload->GetMapping()) {
+    return shader_map;
+  }
+  if (payload->GetSize() <
+      sizeof(flatbuffers::uoffset_t) + flatbuffers::kFileIdentifierLength) {
+    return shader_map;
+  }
+  if (!impeller::fb::shaderbundle::ShaderBundleBufferHasIdentifier(
+          payload->GetMapping())) {
+    return shader_map;
+  }
+  flatbuffers::Verifier verifier(
+      reinterpret_cast<const uint8_t*>(payload->GetMapping()),
+      payload->GetSize());
+  if (!impeller::fb::shaderbundle::VerifyShaderBundleBuffer(verifier)) {
+    return shader_map;
+  }
+  auto* bundle =
+      impeller::fb::shaderbundle::GetShaderBundle(payload->GetMapping());
+  if (bundle == nullptr || bundle->shaders() == nullptr) {
+    return shader_map;
+  }
+  const auto version = bundle->format_version();
+  const auto expected = static_cast<uint32_t>(
+      impeller::fb::shaderbundle::ShaderBundleFormatVersion::kVersion);
+  if (version != expected) {
+    VALIDATION_LOG << "Unsupported shader bundle format version: " << version
+                   << ", expected: " << expected;
+    return shader_map;
+  }
+
+  for (const auto* bundled_shader : *bundle->shaders()) {
+    const auto* backend_shader = GetShaderBackend(backend_type, bundled_shader);
+    if (backend_shader == nullptr || backend_shader->shader() == nullptr) {
+      continue;
+    }
+    auto code_mapping = std::make_shared<fml::NonOwnedMapping>(
+        backend_shader->shader()->data(), backend_shader->shader()->size(),
+        [payload](auto, auto) {});
+
+    std::vector<impeller::DescriptorSetLayout> descriptor_set_layouts;
+    std::unordered_map<std::string, SpiGpuShader::UniformBinding>
+        uniform_structs;
+    if (backend_shader->uniform_structs() != nullptr) {
+      for (const auto& uniform : *backend_shader->uniform_structs()) {
+        if (uniform->ext_res_0() == impeller::kOptimizedOutBinding) {
+          continue;
+        }
+        std::vector<impeller::ShaderStructMemberMetadata> members;
+        if (uniform->fields() != nullptr) {
+          for (const auto& member : *uniform->fields()) {
+            const impeller::ShaderType type = FromUniformType(member->type());
+            members.push_back(impeller::ShaderStructMemberMetadata{
+                .type = type,
+                .name = member->name()->c_str(),
+                .offset = static_cast<size_t>(member->offset_in_bytes()),
+                .size = static_cast<size_t>(member->element_size_in_bytes()),
+                .byte_length =
+                    static_cast<size_t>(member->total_size_in_bytes()),
+                .array_elements =
+                    member->array_elements() == 0
+                        ? std::optional<size_t>(std::nullopt)
+                        : static_cast<size_t>(member->array_elements()),
+                .float_type = impeller::DeriveShaderFloatType(
+                    type, static_cast<size_t>(member->vec_size()),
+                    static_cast<size_t>(member->columns())),
+            });
+          }
+        }
+        uniform_structs[uniform->name()->str()] = SpiGpuShader::UniformBinding{
+            .slot =
+                impeller::ShaderUniformSlot{
+                    .name = uniform->name()->c_str(),
+                    .ext_res_0 = static_cast<size_t>(uniform->ext_res_0()),
+                    .set = static_cast<size_t>(uniform->set()),
+                    .binding = static_cast<size_t>(uniform->binding()),
+                },
+            .metadata =
+                impeller::ShaderMetadata{
+                    .name = uniform->name()->c_str(),
+                    .members = members,
+                },
+            .size_in_bytes = static_cast<size_t>(uniform->size_in_bytes()),
+        };
+        descriptor_set_layouts.push_back({
+            static_cast<uint32_t>(uniform->binding()),
+            impeller::DescriptorType::kUniformBuffer,
+            ToShaderStage(backend_shader->stage()),
+        });
+      }
+    }
+
+    std::unordered_map<std::string, SpiGpuShader::TextureBinding>
+        uniform_textures;
+    if (backend_shader->uniform_textures() != nullptr) {
+      for (const auto& uniform : *backend_shader->uniform_textures()) {
+        if (uniform->ext_res_0() == impeller::kOptimizedOutBinding) {
+          continue;
+        }
+        uniform_textures[uniform->name()->str()] = SpiGpuShader::TextureBinding{
+            .slot =
+                impeller::SampledImageSlot{
+                    .name = uniform->name()->c_str(),
+                    .texture_index = static_cast<size_t>(uniform->ext_res_0()),
+                    .set = static_cast<size_t>(uniform->set()),
+                    .binding = static_cast<size_t>(uniform->binding()),
+                },
+            .metadata =
+                impeller::ShaderMetadata{
+                    .name = uniform->name()->c_str(),
+                    .members = {},
+                },
+        };
+        descriptor_set_layouts.push_back({
+            static_cast<uint32_t>(uniform->binding()),
+            impeller::DescriptorType::kSampledImage,
+            ToShaderStage(backend_shader->stage()),
+        });
+      }
+    }
+
+    std::vector<impeller::ShaderStageIOSlot> inputs;
+    std::vector<impeller::ShaderStageBufferLayout> layouts;
+    if (backend_shader->stage() ==
+        impeller::fb::shaderbundle::ShaderStage::kVertex) {
+      auto inputs_fb = backend_shader->inputs();
+      if (inputs_fb != nullptr) {
+        inputs.reserve(inputs_fb->size());
+        size_t default_stride = 0;
+        for (const auto& input : *inputs_fb) {
+          impeller::ShaderStageIOSlot slot{
+              .name = input->name()->c_str(),
+              .location = input->location(),
+              .set = input->set(),
+              .binding = input->binding(),
+              .type = FromInputType(input->type()),
+              .bit_width = input->bit_width(),
+              .vec_size = input->vec_size(),
+              .columns = input->columns(),
+              .offset = input->offset(),
+          };
+          inputs.push_back(slot);
+          default_stride +=
+              SizeOfInputType(input->type()) * slot.vec_size * slot.columns;
+        }
+        layouts = {{.stride = default_stride, .binding = 0u}};
+      }
+    }
+
+    shader_map[bundled_shader->name()->str()] = SpiGpuShader::Make(
+        library_id, backend_shader->entrypoint()->str(),
+        ToShaderStage(backend_shader->stage()), std::move(code_mapping),
+        std::move(inputs), std::move(layouts), std::move(uniform_structs),
+        std::move(uniform_textures), std::move(descriptor_set_layouts));
+  }
+  return shader_map;
+}
+
+char* AllocateError(const std::string& error) {
+  char* result = static_cast<char*>(std::malloc(error.size() + 1));
+  if (result == nullptr) {
+    return nullptr;
+  }
+  std::memcpy(result, error.c_str(), error.size() + 1);
+  return result;
+}
+
+void SetError(char** out_error, const std::string& error) {
+  if (out_error != nullptr) {
+    *out_error = AllocateError(error);
+  }
+}
+
+bool IsSupportedFormat(int32_t format) {
+  return format == kFlutterSpiGpuShaderFormatImpellerBundle;
+}
+
+std::shared_ptr<fml::Mapping> MappingFromDescriptor(
+    const FlutterSpiGpuShaderLibraryDescriptor& descriptor) {
+  return CopyPayload(descriptor.data, descriptor.size);
+}
