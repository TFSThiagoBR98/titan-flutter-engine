@@ -0,0 +1,338 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/gpu/spi_gpu_shader.h"
+
+#include <algorithm>
+#include <cstring>
+#include <future>
+#include <utility>
+
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "fml/make_copyable.h"
+#include "impeller/renderer/context.h"
+#include "impeller/renderer/pipeline_library.h"
+#include "impeller/renderer/shader_function.h"
+#include "impeller/renderer/shader_key.h"
+#include "impeller/renderer/shader_library.h"
+
+namespace flutter {
+namespace {
+
+SpiHandleTable<SpiGpuShader>& Shaders() {
+  return LeakedHandleTable<SpiGpuShader>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuShader* shader) {
+  return reinterpret_cast<uintptr_t>(shader);
+}
+
+FlutterSpiGpuShader* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuShader*>(value);
+}
+
+SpiGpuShader* FindShader(FlutterSpiGpuShader* shader) {
+  return Shaders().FindRaw(HandleValue(shader));
+}
+
+}  // namespace
+
+const impeller::ShaderStructMemberMetadata*
+SpiGpuShader::UniformBinding::GetMemberMetadata(const std::string& name) const {
+  auto result =
+      std::find_if(metadata.members.begin(), metadata.members.end(),
+                   [&name](const impeller::ShaderStructMemberMetadata& member) {
+                     return member.name == name;
+                   });
+  return result == metadata.members.end() ? nullptr : &(*result);
+}
+
+SpiGpuShader::SpiGpuShader() = default;
+
+std::shared_ptr<SpiGpuShader> SpiGpuShader::Make(
+    std::string library_id,
+    std::string entrypoint,
+    impeller::ShaderStage stage,
+    std::shared_ptr<fml::Mapping> code_mapping,
+    std::vector<impeller::ShaderStageIOSlot> inputs,
+    std::vector<impeller::ShaderStageBufferLayout> layouts,
+    std::unordered_map<std::string, UniformBinding> uniform_structs,
+    std::unordered_map<std::string, TextureBinding> uniform_textures,
+    std::vector<impeller::DescriptorSetLayout> descriptor_set_layouts) {
+  auto shader = std::shared_ptr<SpiGpuShader>(new SpiGpuShader());
+  shader->library_id_ = std::move(library_id);
+  shader->entrypoint_ = std::move(entrypoint);
+  shader->stage_ = stage;
+  shader->code_mapping_ = std::move(code_mapping);
+  shader->inputs_ = std::move(inputs);
+  shader->layouts_ = std::move(layouts);
+  shader->uniform_structs_ = std::move(uniform_structs);
+  shader->uniform_textures_ = std::move(uniform_textures);
+  shader->descriptor_set_layouts_ = std::move(descriptor_set_layouts);
+  shader->RebuildBindingOrder();
+  return shader;
+}
+
+std::string SpiGpuShader::GetScopedName() const {
+  return impeller::ShaderKey::MakeUserScopedName(
+      impeller::ShaderKey::kScopeFlutterGPU, library_id_, entrypoint_);
+}
+
+std::shared_ptr<const impeller::ShaderFunction>
+SpiGpuShader::GetFunctionFromLibrary(impeller::ShaderLibrary& library) {
+  return library.GetFunction(GetScopedName(), stage_);
+}
+
+bool SpiGpuShader::IsRegistered(impeller::Context& context) {
+  auto& library = *context.GetShaderLibrary();
+  return GetFunctionFromLibrary(library) != nullptr;
+}
+
+bool SpiGpuShader::IsDirty() const {
+  return is_dirty_;
+}
+
+void SpiGpuShader::SetClean() {
+  is_dirty_ = false;
+}
+
+void SpiGpuShader::ResetFrom(SpiGpuShader& other) {
+  const bool code_changed =
+      code_mapping_ == nullptr || other.code_mapping_ == nullptr ||
+      code_mapping_->GetSize() != other.code_mapping_->GetSize() ||
+      std::memcmp(code_mapping_->GetMapping(),
+                  other.code_mapping_->GetMapping(),
+                  code_mapping_->GetSize()) != 0;
+
+  entrypoint_ = std::move(other.entrypoint_);
+  stage_ = other.stage_;
+  code_mapping_ = std::move(other.code_mapping_);
+  inputs_ = std::move(other.inputs_);
+  layouts_ = std::move(other.layouts_);
+  uniform_structs_ = std::move(other.uniform_structs_);
+  uniform_textures_ = std::move(other.uniform_textures_);
+  descriptor_set_layouts_ = std::move(other.descriptor_set_layouts_);
+  RebuildBindingOrder();
+  if (code_changed) {
+    is_dirty_ = true;
+  }
+}
+
+bool SpiGpuShader::RegisterSync(impeller::Context& context) {
+  auto& library = *context.GetShaderLibrary();
+  const std::string scoped_name = GetScopedName();
+  std::shared_ptr<const impeller::ShaderFunction> existing =
+      library.GetFunction(scoped_name, stage_);
+  if (existing && !is_dirty_) {
+    return true;
+  }
+  if (existing && is_dirty_) {
+    context.GetPipelineLibrary()->RemovePipelinesWithEntryPoint(existing);
+    library.UnregisterFunction(scoped_name, stage_);
+  }
+
+  std::promise<bool> promise;
+  auto future = promise.get_future();
+  library.RegisterFunction(
+      scoped_name, stage_, code_mapping_,
+      fml::MakeCopyable([promise = std::move(promise)](bool result) mutable {
+        promise.set_value(result);
+      }));
+  if (!future.get()) {
+    return false;
+  }
+  is_dirty_ = false;
+  return true;
+}
+
+std::shared_ptr<impeller::VertexDescriptor>
+SpiGpuShader::CreateVertexDescriptor() const {
+  auto descriptor = std::make_shared<impeller::VertexDescriptor>();
+  descriptor->SetStageInputs(inputs_, layouts_);
+  return descriptor;
+}
+
+const std::vector<impeller::ShaderStageIOSlot>& SpiGpuShader::GetStageInputs()
+    const {
+  return inputs_;
+}
+
+const std::vector<impeller::ShaderStageBufferLayout>&
+SpiGpuShader::GetStageBufferLayouts() const {
+  return layouts_;
+}
+
+const std::vector<impeller::DescriptorSetLayout>&
+SpiGpuShader::GetDescriptorSetLayouts() const {
+  return descriptor_set_layouts_;
+}
+
+impeller::ShaderStage SpiGpuShader::GetShaderStage() const {
+  return stage_;
+}
+
+const std::string& SpiGpuShader::GetEntrypoint() const {
+  return entrypoint_;
+}
+
+const SpiGpuShader::UniformBinding* SpiGpuShader::GetUniformStruct(
+    const std::string& name) const {
+  auto uniform = uniform_structs_.find(name);
+  return uniform == uniform_structs_.end() ? nullptr : &uniform->second;
+}
+
+const SpiGpuShader::TextureBinding* SpiGpuShader::GetUniformTexture(
+    const std::string& name) const {
+  auto uniform = uniform_textures_.find(name);
+  return uniform == uniform_textures_.end() ? nullptr : &uniform->second;
+}
+
+int SpiGpuShader::GetUniformStructIndex(const std::string& name) const {
+  const UniformBinding* binding = GetUniformStruct(name);
+  if (binding == nullptr) {
+    return -1;
+  }
+  for (size_t index = 0; index < uniform_struct_order_.size(); index++) {
+    if (uniform_struct_order_[index] == binding) {
+      return static_cast<int>(index);
+    }
+  }
+  return -1;
+}
+
+const SpiGpuShader::UniformBinding* SpiGpuShader::GetUniformStructAt(
+    int index) const {
+  if (index < 0 || static_cast<size_t>(index) >= uniform_struct_order_.size()) {
+    return nullptr;
+  }
+  return uniform_struct_order_[index];
+}
+
+int SpiGpuShader::GetUniformTextureIndex(const std::string& name) const {
+  const TextureBinding* binding = GetUniformTexture(name);
+  if (binding == nullptr) {
+    return -1;
+  }
+  for (size_t index = 0; index < uniform_texture_order_.size(); index++) {
+    if (uniform_texture_order_[index] == binding) {
+      return static_cast<int>(index);
+    }
+  }
+  return -1;
+}
+
+const SpiGpuShader::TextureBinding* SpiGpuShader::GetUniformTextureAt(
+    int index) const {
+  if (index < 0 ||
+      static_cast<size_t>(index) >= uniform_texture_order_.size()) {
+    return nullptr;
+  }
+  return uniform_texture_order_[index];
+}
+
+void SpiGpuShader::RebuildBindingOrder() {
+  uniform_struct_order_.clear();
+  uniform_struct_order_.reserve(uniform_structs_.size());
+  for (const auto& entry : uniform_structs_) {
+    uniform_struct_order_.push_back(&entry.second);
+  }
+  uniform_texture_order_.clear();
+  uniform_texture_order_.reserve(uniform_textures_.size());
+  for (const auto& entry : uniform_textures_) {
+    uniform_texture_order_.push_back(&entry.second);
+  }
+}
+
+SpiGpuShader* SpiGpuShaderGetCore(FlutterSpiGpuShader* shader) {
+  return FindShader(shader);
+}
+
+FlutterSpiGpuShader* SpiGpuShaderInsertHandle(
+    std::shared_ptr<SpiGpuShader> shader) {
+  if (shader == nullptr) {
+    return nullptr;
+  }
+  const uintptr_t handle = Shaders().Insert(std::move(shader));
+  return handle == 0 ? nullptr : MakeHandle(handle);
+}
+
+bool SpiGpuShaderIsDirtyForTesting(FlutterSpiGpuShader* shader) {
+  SpiGpuShader* shader_value = FindShader(shader);
+  return shader_value != nullptr && shader_value->IsDirty();
+}
+
+FlutterSpiResult SpiGpuShaderGetUniformStructSize(FlutterSpiGpuShader* shader,
+                                                  const char* struct_name,
+                                                  int32_t* out_size) {
+  SpiGpuShader* shader_value = FindShader(shader);
+  if (shader_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (struct_name == nullptr || out_size == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto* binding = shader_value->GetUniformStruct(struct_name);
+  *out_size =
+      binding == nullptr ? -1 : static_cast<int32_t>(binding->size_in_bytes);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderGetUniformMemberOffset(FlutterSpiGpuShader* shader,
+                                                    const char* struct_name,
+                                                    const char* member_name,
+                                                    int32_t* out_offset) {
+  SpiGpuShader* shader_value = FindShader(shader);
+  if (shader_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (struct_name == nullptr || member_name == nullptr ||
+      out_offset == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto* binding = shader_value->GetUniformStruct(struct_name);
+  const auto* member =
+      binding == nullptr ? nullptr : binding->GetMemberMetadata(member_name);
+  *out_offset = member == nullptr ? -1 : static_cast<int32_t>(member->offset);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderGetUniformStructIndex(FlutterSpiGpuShader* shader,
+                                                   const char* name,
+                                                   int32_t* out_index) {
+  SpiGpuShader* shader_value = FindShader(shader);
+  if (shader_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (name == nullptr || out_index == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_index = shader_value->GetUniformStructIndex(name);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderGetUniformTextureIndex(FlutterSpiGpuShader* shader,
+                                                    const char* name,
+                                                    int32_t* out_index) {
+  SpiGpuShader* shader_value = FindShader(shader);
+  if (shader_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (name == nullptr || out_index == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_index = shader_value->GetUniformTextureIndex(name);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderRetain(FlutterSpiGpuShader* shader) {
+  return Shaders().Retain(HandleValue(shader)) ? kFlutterSpiOk
+                                               : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuShaderRelease(FlutterSpiGpuShader* shader) {
+  return Shaders().Release(HandleValue(shader)) ? kFlutterSpiOk
+                                                : kFlutterSpiInvalidHandle;
+}
+
+}  // namespace flutter
