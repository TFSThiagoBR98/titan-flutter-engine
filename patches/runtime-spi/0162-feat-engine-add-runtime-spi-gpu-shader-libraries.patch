+  EXPECT_EQ(SpiGpuShaderLibraryRelease(nullptr), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuShaderLibraryGetShader(nullptr, "test", nullptr),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuShaderRetain(nullptr), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuShaderRelease(nullptr), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuShaderGetUniformStructIndex(nullptr, "test", &value),
+            kFlutterSpiInvalidHandle);
+
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  SpiGpuSetDefaultContextOverride(CreateMockContext(&capabilities));
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* context = GetDefaultContext(backend.get());
+  auto bundle = BuildShaderBundle("Frame", 1);
+  auto descriptor = MakeShaderLibraryDescriptor(bundle);
+  FlutterSpiGpuShaderLibrary* library = nullptr;
+  ASSERT_EQ(SpiGpuShaderLibraryCreate(context, &descriptor, &library, nullptr),
+            kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuShaderLibraryRelease(library), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuShaderLibraryRetain(library), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuShaderLibraryGetShader(library, "test", nullptr),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuContextRelease(context), kFlutterSpiOk);
+}
