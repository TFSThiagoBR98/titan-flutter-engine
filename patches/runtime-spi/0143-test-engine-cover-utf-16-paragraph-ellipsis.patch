 TEST(SpiTextStyle, ConvertsEveryField) {
   const char* families[] = {"Roboto", "Noto Sans"};
@@ -339,5 +340,44 @@ TEST(SpiTextStyle, StructWithoutSetFieldsKeepsAllFields) {
   EXPECT_TRUE(result.has_height_override);
