+TEST(SpiTextStyle, EllipsisUtf16MatchesUtf8) {
+  const uint16_t ellipsis_utf16[] = {0x2026};
+  const FlutterSpiParagraphStyle utf8_input = {
+      .struct_size = sizeof(FlutterSpiParagraphStyle),
+      .ellipsis = "\xE2\x80\xA6",
+      .set_fields = kFlutterSpiStyleFieldsMasked |
+                    kFlutterSpiParagraphStyleFieldEllipsis,
+  };
+  const FlutterSpiParagraphStyle utf16_input = {
+      .struct_size = sizeof(FlutterSpiParagraphStyle),
+      .ellipsis = "ignored",
+      .set_fields = kFlutterSpiStyleFieldsMasked |
+                    kFlutterSpiParagraphStyleFieldEllipsis,
+      .ellipsis_utf16 = ellipsis_utf16,
+      .ellipsis_utf16_length = kEllipsisUtf16Length,
+  };
+
+  const txt::ParagraphStyle utf8_result = ToTxtParagraphStyle(&utf8_input);
+  const txt::ParagraphStyle utf16_result = ToTxtParagraphStyle(&utf16_input);
+
+  EXPECT_EQ(utf16_result.ellipsis, utf8_result.ellipsis);
+}
+
+TEST(SpiTextStyle, EllipsisUtf16WinsOverUtf8) {
+  const uint16_t ellipsis_utf16[] = {0x2026};
+  const FlutterSpiParagraphStyle input = {
+      .struct_size = sizeof(FlutterSpiParagraphStyle),
+      .ellipsis = "...",
+      .set_fields = kFlutterSpiStyleFieldsMasked |
+                    kFlutterSpiParagraphStyleFieldEllipsis,
+      .ellipsis_utf16 = ellipsis_utf16,
+      .ellipsis_utf16_length = kEllipsisUtf16Length,
+  };
+
+  const txt::ParagraphStyle result = ToTxtParagraphStyle(&input);
+
+  EXPECT_EQ(result.ellipsis, u"\u2026");
+}
+
 }  // namespace
