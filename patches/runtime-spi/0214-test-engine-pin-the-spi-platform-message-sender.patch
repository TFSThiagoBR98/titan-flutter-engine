+TEST_F(SpiPlatformMessageSender, SendsFromAnotherThread) {
+  auto handler = std::make_shared<SenderTestPlatformMessageHandler>(false);
+  delegate.platform_message_handler = handler;
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+
+  ASSERT_NE(runtime->engine_api, nullptr);
+  const FlutterSpiEngineApi* api = runtime->engine_api;
+  ASSERT_NE(api->platform_message_sender_create, nullptr);
+  ASSERT_NE(api->platform_message_sender_send, nullptr);
+  ASSERT_NE(api->platform_message_sender_release, nullptr);
+
+  FlutterSpiPlatformMessageSender* sender = nullptr;
+  ASSERT_EQ(api->platform_message_sender_create(runtime->engine, &sender),
+            kFlutterSpiOk);
+  ASSERT_NE(sender, nullptr);
+
+  SenderReplyCapture reply;
+  std::atomic<FlutterSpiResult> result{kFlutterSpiInternalError};
+  std::thread worker([&] {
+    const uint8_t payload[] = {1, 2, 3};
+    result = api->platform_message_sender_send(
+        sender, "background", payload, sizeof(payload), CaptureSenderReply,
+        &reply);
+  });
+  worker.join();
+
+  EXPECT_EQ(result.load(), kFlutterSpiOk);
+  EXPECT_EQ(handler->channel(), "background");
+  EXPECT_EQ(handler->payload(), std::vector<uint8_t>({1, 2, 3}));
+  EXPECT_TRUE(reply.called);
+  EXPECT_EQ(reply.bytes, std::vector<uint8_t>({4, 5}));
+  EXPECT_EQ(api->platform_message_sender_release(sender), kFlutterSpiOk);
+}
