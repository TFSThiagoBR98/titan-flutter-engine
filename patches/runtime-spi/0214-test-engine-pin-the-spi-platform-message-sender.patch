+class SenderTestPlatformMessageHandler final : public PlatformMessageHandler {
+ public:
+  explicit SenderTestPlatformMessageHandler(bool complete_empty)
+      : complete_empty_(complete_empty) {}
+
+  void HandlePlatformMessage(
+      std::unique_ptr<PlatformMessage> message) override {
+    channel_ = message->channel();
+    if (message->data().GetSize() != 0) {
+      payload_.assign(message->data().GetMapping(),
+                      message->data().GetMapping() +
+                          message->data().GetSize());
+    }
+    if (!message->response()) {
+      return;
+    }
+    if (complete_empty_) {
+      message->response()->CompleteEmpty();
+      return;
+    }
+    const std::vector<uint8_t> reply = {4, 5};
+    message->response()->Complete(std::make_unique<fml::MallocMapping>(
+        fml::MallocMapping::Copy(reply.data(), reply.data() + reply.size())));
+  }
+
+  bool DoesHandlePlatformMessageOnPlatformThread() const override {
+    return false;
+  }
+
+  void InvokePlatformMessageResponseCallback(
+      int response_id,
+      std::unique_ptr<fml::Mapping> mapping) override {}
+
+  void InvokePlatformMessageEmptyResponseCallback(int response_id) override {}
+
+  const std::string& channel() const { return channel_; }
+  const std::vector<uint8_t>& payload() const { return payload_; }
+
+ private:
+  bool complete_empty_;
+  std::string channel_;
+  std::vector<uint8_t> payload_;
+};
+
+struct SenderReplyCapture {
+  bool called = false;
+  std::vector<uint8_t> bytes;
+};
+
+void CaptureSenderReply(void* user_data,
+                        const uint8_t* data,
+                        size_t size) {
+  auto* capture = static_cast<SenderReplyCapture*>(user_data);
+  capture->called = true;
+  if (data != nullptr) {
+    capture->bytes.assign(data, data + size);
+  }
+}
