+FlutterSpiResult SpiEngineApi::PlatformMessageSenderCreate(
+    FlutterSpiEngine* engine,
+    FlutterSpiPlatformMessageSender** out_sender) {
+  if (engine == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return engine->backend->CreatePlatformMessageSender(out_sender);
+}
+
+FlutterSpiResult SpiEngineApi::PlatformMessageSenderSend(
+    FlutterSpiPlatformMessageSender* sender,
+    const char* channel,
+    const uint8_t* data,
+    size_t data_size,
+    void (*on_reply)(void* user_data, const uint8_t* data, size_t size),
+    void* reply_user_data) {
+  return SpiRuntimeBackend::SendPlatformMessageFromSender(
+      sender, channel, data, data_size, on_reply, reply_user_data);
+}
+
+FlutterSpiResult SpiEngineApi::PlatformMessageSenderRelease(
+    FlutterSpiPlatformMessageSender* sender) {
+  return SpiRuntimeBackend::ReleasePlatformMessageSender(sender);
+}
