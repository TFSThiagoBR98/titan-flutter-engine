+FlutterSpiResult SpiRuntimeBackend::CreatePlatformMessageSender(
+    FlutterSpiPlatformMessageSender** out_sender) {
+  if (out_sender == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  *out_sender = new FlutterSpiPlatformMessageSender{
+      runtime_delegate_.GetPlatformMessageHandler()};
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiRuntimeBackend::SendPlatformMessageFromSender(
+    FlutterSpiPlatformMessageSender* sender,
+    const char* channel,
+    const uint8_t* data,
+    size_t data_size,
+    void (*on_reply)(void* user_data, const uint8_t* data, size_t size),
+    void* reply_user_data) {
+  if (sender == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const std::shared_ptr<PlatformMessageHandler> handler =
+      sender->handler.lock();
+  if (handler == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (channel == nullptr || (data == nullptr && data_size != 0)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  fml::RefPtr<PlatformMessageResponse> response;
+  if (on_reply != nullptr) {
+    response = fml::AdoptRef(
+        new SpiPlatformMessageSenderResponse(on_reply, reply_user_data));
+  }
+  handler->HandlePlatformMessage(
+      CreatePlatformMessage(channel, data, data_size, response));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiRuntimeBackend::ReleasePlatformMessageSender(
+    FlutterSpiPlatformMessageSender* sender) {
+  if (sender == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  delete sender;
+  return kFlutterSpiOk;
+}
