 #include "flutter/runtime_spi/gpu/spi_gpu_test_fixture.h"
 
 #include <memory>
+#include <unordered_map>
 
 #include "flutter/fml/message_loop.h"
 #include "flutter/runtime_spi/spi_runtime_backend.h"
@@ -140,5 +142,36 @@ TEST(SpiGpuComputeApiTest, DispatchReportsTheUpstreamRecordingMessage) {
   EXPECT_EQ(SpiGpuComputePassRelease(pass), kFlutterSpiOk);
 }
 
+TEST(SpiGpuComputeApiTest, ShaderUniformStructIndexWorksForComputeStage) {
+  SpiGpuShader::UniformBinding uniform{
+      .slot = impeller::ShaderUniformSlot{
+          .name = "TriangleInfo",
+          .ext_res_0 = 0,
+          .set = 0,
+          .binding = 0,
+      },
+      .metadata = impeller::ShaderMetadata{
+          .name = "TriangleInfo",
+          .members = {},
+      },
+      .size_in_bytes = 16,
+  };
+  std::unordered_map<std::string, SpiGpuShader::UniformBinding> uniforms;
+  uniforms.emplace("TriangleInfo", uniform);
+  auto shader = SpiGpuShader::Make(
+      "test_bundle", "compute_main", impeller::ShaderStage::kCompute,
+      nullptr, {}, {}, std::move(uniforms), {}, {});
+  FlutterSpiGpuShader* shader_handle = SpiGpuShaderInsertHandle(shader);
+  ASSERT_NE(shader_handle, nullptr);
+
+  int32_t index = -1;
+  EXPECT_EQ(SpiGpuShaderGetUniformStructIndex(shader_handle, "TriangleInfo",
+                                              &index),
+            kFlutterSpiOk);
+  EXPECT_EQ(index, 0);
+
+  EXPECT_EQ(SpiGpuShaderRelease(shader_handle), kFlutterSpiOk);
+}
+
 }  // namespace
 }  // namespace flutter::testing
