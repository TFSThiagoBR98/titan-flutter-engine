+++ b/engine/src/flutter/runtime_spi/include/flutter_runtime_spi.h
@@ -0,0 +1,229 @@
+#ifndef FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_RUNTIME_SPI_H_
+#define FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_RUNTIME_SPI_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FLUTTER_SPI_VERSION_MAJOR 0
+#define FLUTTER_SPI_VERSION_MINOR 1
+
+typedef enum {
+  kFlutterSpiOk = 0,
+  kFlutterSpiInvalidArgument,
+  kFlutterSpiIncompatibleVersion,
+  kFlutterSpiUnsupported,
+  kFlutterSpiInvalidHandle,
+  kFlutterSpiStaleFrame,
+  kFlutterSpiWrongThread,
+  kFlutterSpiInternalError,
+} FlutterSpiResult;
+
+typedef uint64_t FlutterSpiCapabilities;
+
+enum {
+  kFlutterSpiCapTasks = 1ULL << 0,
+  kFlutterSpiCapPlatformMessages = 1ULL << 1,
+  kFlutterSpiCapPointerEvents = 1ULL << 2,
+  kFlutterSpiCapKeyEvents = 1ULL << 3,
+  kFlutterSpiCapSemantics = 1ULL << 4,
+  kFlutterSpiCapViewFocus = 1ULL << 5,
+  kFlutterSpiCapEmptyScene = 1ULL << 6,
+};
+
+typedef struct FlutterSpiEngine FlutterSpiEngine;
+typedef struct FlutterSpiScene FlutterSpiScene;
+typedef struct FlutterSpiResponseHandle FlutterSpiResponseHandle;
+typedef struct FlutterSpiEngineApi FlutterSpiEngineApi;
+
+typedef struct {
+  size_t struct_size;
+  int64_t view_id;
+  double device_pixel_ratio;
+  double physical_width;
+  double physical_height;
+  double physical_padding_top;
+  double physical_padding_right;
+  double physical_padding_bottom;
+  double physical_padding_left;
+  double physical_view_inset_top;
+  double physical_view_inset_right;
+  double physical_view_inset_bottom;
+  double physical_view_inset_left;
+} FlutterSpiViewMetrics;
+
+typedef struct {
+  size_t struct_size;
+  uint64_t frame_token;
+  uint64_t frame_number;
+  int64_t frame_start_ns;
+  int64_t deadline_ns;
+} FlutterSpiFrameInfo;
+
+typedef enum {
+  kFlutterSpiPointerChangeCancel = 0,
+  kFlutterSpiPointerChangeAdd,
+  kFlutterSpiPointerChangeRemove,
+  kFlutterSpiPointerChangeHover,
+  kFlutterSpiPointerChangeDown,
+  kFlutterSpiPointerChangeMove,
+  kFlutterSpiPointerChangeUp,
+  kFlutterSpiPointerChangePanZoomStart,
+  kFlutterSpiPointerChangePanZoomUpdate,
+  kFlutterSpiPointerChangePanZoomEnd,
+} FlutterSpiPointerChange;
+
+typedef enum {
+  kFlutterSpiPointerDeviceKindTouch = 0,
+  kFlutterSpiPointerDeviceKindMouse,
+  kFlutterSpiPointerDeviceKindStylus,
+  kFlutterSpiPointerDeviceKindInvertedStylus,
+  kFlutterSpiPointerDeviceKindTrackpad,
+} FlutterSpiPointerDeviceKind;
+
+typedef struct {
+  size_t struct_size;
+  int64_t view_id;
+  int64_t timestamp_us;
+  int32_t change;
+  int32_t device_kind;
+  int64_t device;
+  int64_t pointer_id;
+  double physical_x;
+  double physical_y;
+  int64_t buttons;
+  double scroll_delta_x;
+  double scroll_delta_y;
+  double pressure;
+} FlutterSpiPointerEvent;
+
+typedef enum {
+  kFlutterSpiKeyEventTypeDown = 0,
+  kFlutterSpiKeyEventTypeUp,
+  kFlutterSpiKeyEventTypeRepeat,
+} FlutterSpiKeyEventType;
+
+typedef enum {
+  kFlutterSpiKeyEventDeviceTypeKeyboard = 0,
+  kFlutterSpiKeyEventDeviceTypeDirectionalPad,
+  kFlutterSpiKeyEventDeviceTypeGamepad,
+  kFlutterSpiKeyEventDeviceTypeJoystick,
+  kFlutterSpiKeyEventDeviceTypeHdmi,
+} FlutterSpiKeyEventDeviceType;
+
+typedef struct {
+  size_t struct_size;
+  uint64_t timestamp_us;
+  int32_t type;
+  int32_t device_type;
+  uint64_t physical;
+  uint64_t logical;
+  const char* character;
+  bool synthesized;
+} FlutterSpiKeyEvent;
+
+typedef struct {
+  size_t struct_size;
+  const char* channel;
+  const uint8_t* data;
+  size_t data_size;
+  FlutterSpiResponseHandle* response;
+} FlutterSpiPlatformMessage;
+
+typedef struct {
+  size_t struct_size;
+  uint32_t version_major;
+  uint32_t version_minor;
+  FlutterSpiCapabilities required_capabilities;
+  void* user_data;
+  FlutterSpiResult (*start)(void* user_data,
+                            const FlutterSpiEngineApi* api,
+                            FlutterSpiEngine* engine);
+  void (*stop)(void* user_data);
+  void (*destroy)(void* user_data);
+  void (*add_view)(void* user_data, const FlutterSpiViewMetrics* metrics);
+  void (*remove_view)(void* user_data, int64_t view_id);
+  void (*set_view_metrics)(void* user_data,
+                           const FlutterSpiViewMetrics* metrics);
+  void (*begin_frame)(void* user_data, const FlutterSpiFrameInfo* frame_info);
+  void (*pointer_events)(void* user_data,
+                         const FlutterSpiPointerEvent* events,
+                         size_t count);
+  void (*key_event)(void* user_data, const FlutterSpiKeyEvent* event);
+  void (*platform_message)(void* user_data,
+                           const FlutterSpiPlatformMessage* message);
+  void (*set_semantics_enabled)(void* user_data, bool enabled);
+  void (*semantics_action)(void* user_data,
+                           int64_t view_id,
+                           int32_t node_id,
+                           int32_t action,
+                           const uint8_t* args,
+                           size_t args_size);
+  void (*set_accessibility_features)(void* user_data, int32_t flags);
+  void (*set_locales)(void* user_data,
+                      const char* const* locales,
+                      size_t count);
+  void (*set_user_settings)(void* user_data, const char* json);
+  void (*set_lifecycle_state)(void* user_data, const char* state);
+  void (*view_focus)(void* user_data,
+                     int64_t view_id,
+                     int32_t state,
+                     int32_t direction);
+  void (*notify_idle)(void* user_data, int64_t deadline_ns);
+} FlutterSpiRuntimeTable;
+
+struct FlutterSpiEngineApi {
+  size_t struct_size;
+  uint32_t version_major;
+  uint32_t version_minor;
+  FlutterSpiCapabilities capabilities;
+  FlutterSpiResult (*request_frame)(FlutterSpiEngine* engine);
+  FlutterSpiResult (*scene_create_empty)(FlutterSpiEngine* engine,
+                                         int64_t width_px,
+                                         int64_t height_px,
+                                         FlutterSpiScene** out_scene);
+  FlutterSpiResult (*scene_release)(FlutterSpiScene* scene);
+  FlutterSpiResult (*submit_frame)(FlutterSpiEngine* engine,
+                                   int64_t view_id,
+                                   uint64_t frame_token,
+                                   FlutterSpiScene* scene,
+                                   double device_pixel_ratio);
+  FlutterSpiResult (*frames_done)(FlutterSpiEngine* engine);
+  FlutterSpiResult (*send_platform_message)(
+      FlutterSpiEngine* engine,
+      const char* channel,
+      const uint8_t* data,
+      size_t data_size,
+      void (*on_reply)(void* user_data, const uint8_t* data, size_t size),
+      void* reply_user_data);
+  FlutterSpiResult (*respond)(FlutterSpiResponseHandle* response,
+                              const uint8_t* data,
+                              size_t data_size);
+  FlutterSpiResult (*post_task)(FlutterSpiEngine* engine,
+                                void (*task)(void* user_data),
+                                void* user_data,
+                                int64_t delay_ns);
+  int64_t (*now_ns)(FlutterSpiEngine* engine);
+  void (*log)(FlutterSpiEngine* engine,
+              int32_t level,
+              const char* tag,
+              const char* message);
+  FlutterSpiResult (*report_error)(FlutterSpiEngine* engine,
+                                   const char* message);
+};
+
+/*
+ * Input pointers are borrowed and remain valid only for the duration of the
+ * call. Strings are UTF-8 and terminated by zero. The runtime copies every
+ * value it needs after the callback returns.
+ */
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_RUNTIME_SPI_H_
