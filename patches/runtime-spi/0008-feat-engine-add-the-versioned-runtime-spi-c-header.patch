+
+namespace flutter {
+namespace testing {
+
+#define EXPECT_SPI_OFFSET(type, member, offset_64, offset_32)                 \
+  EXPECT_EQ(offsetof(type, member),                                         \
+            static_cast<std::size_t>(sizeof(void*) == 8 ? offset_64 : offset_32))
+
+TEST(SpiAbi, ResultValuesAreFrozen) {
+  EXPECT_EQ(kFlutterSpiOk, 0);
+  EXPECT_EQ(kFlutterSpiInvalidArgument, 1);
+  EXPECT_EQ(kFlutterSpiIncompatibleVersion, 2);
+  EXPECT_EQ(kFlutterSpiUnsupported, 3);
+  EXPECT_EQ(kFlutterSpiInvalidHandle, 4);
+  EXPECT_EQ(kFlutterSpiStaleFrame, 5);
+  EXPECT_EQ(kFlutterSpiWrongThread, 6);
+  EXPECT_EQ(kFlutterSpiInternalError, 7);
+  EXPECT_EQ(sizeof(FlutterSpiResult), 4u);
+}
+
+TEST(SpiAbi, CapabilityValuesAreFrozen) {
+  EXPECT_EQ(kFlutterSpiCapTasks, 1u << 0);
+  EXPECT_EQ(kFlutterSpiCapPlatformMessages, 1u << 1);
+  EXPECT_EQ(kFlutterSpiCapPointerEvents, 1u << 2);
+  EXPECT_EQ(kFlutterSpiCapKeyEvents, 1u << 3);
+  EXPECT_EQ(kFlutterSpiCapSemantics, 1u << 4);
+  EXPECT_EQ(kFlutterSpiCapViewFocus, 1u << 5);
+  EXPECT_EQ(kFlutterSpiCapEmptyScene, 1u << 6);
+}
+
+TEST(SpiAbi, PointerEnumValuesAreFrozen) {
+  EXPECT_EQ(kFlutterSpiPointerChangeCancel, 0);
+  EXPECT_EQ(kFlutterSpiPointerChangeAdd, 1);
+  EXPECT_EQ(kFlutterSpiPointerChangeRemove, 2);
+  EXPECT_EQ(kFlutterSpiPointerChangeHover, 3);
+  EXPECT_EQ(kFlutterSpiPointerChangeDown, 4);
+  EXPECT_EQ(kFlutterSpiPointerChangeMove, 5);
+  EXPECT_EQ(kFlutterSpiPointerChangeUp, 6);
+  EXPECT_EQ(kFlutterSpiPointerChangePanZoomStart, 7);
+  EXPECT_EQ(kFlutterSpiPointerChangePanZoomUpdate, 8);
+  EXPECT_EQ(kFlutterSpiPointerChangePanZoomEnd, 9);
+  EXPECT_EQ(kFlutterSpiPointerDeviceKindTouch, 0);
+  EXPECT_EQ(kFlutterSpiPointerDeviceKindMouse, 1);
+  EXPECT_EQ(kFlutterSpiPointerDeviceKindStylus, 2);
+  EXPECT_EQ(kFlutterSpiPointerDeviceKindInvertedStylus, 3);
+  EXPECT_EQ(kFlutterSpiPointerDeviceKindTrackpad, 4);
+}
+
+TEST(SpiAbi, KeyEnumValuesAreFrozen) {
+  EXPECT_EQ(kFlutterSpiKeyEventTypeDown, 0);
+  EXPECT_EQ(kFlutterSpiKeyEventTypeUp, 1);
+  EXPECT_EQ(kFlutterSpiKeyEventTypeRepeat, 2);
+  EXPECT_EQ(kFlutterSpiKeyEventDeviceTypeKeyboard, 0);
+  EXPECT_EQ(kFlutterSpiKeyEventDeviceTypeDirectionalPad, 1);
+  EXPECT_EQ(kFlutterSpiKeyEventDeviceTypeGamepad, 2);
+  EXPECT_EQ(kFlutterSpiKeyEventDeviceTypeJoystick, 3);
+  EXPECT_EQ(kFlutterSpiKeyEventDeviceTypeHdmi, 4);
+}
+
+TEST(SpiAbi, ViewMetricsLayoutIsFrozen) {
+  EXPECT_SPI_OFFSET(FlutterSpiViewMetrics, struct_size, 0, 0);
+  EXPECT_SPI_OFFSET(FlutterSpiViewMetrics, view_id, 8, 4);
