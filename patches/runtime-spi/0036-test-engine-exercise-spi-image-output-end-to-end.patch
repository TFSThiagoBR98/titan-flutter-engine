+static void test_runtime_snapshot_bytes_callback(void* user_data,
+                                                 FlutterSpiResult result,
+                                                 const uint8_t* bytes,
+                                                 size_t size) {
+  CTestRuntime* runtime = (CTestRuntime*)user_data;
+  size_t byte_count = size < sizeof(runtime->snapshot_bytes)
+                          ? size
+                          : sizeof(runtime->snapshot_bytes);
+
+  runtime->snapshot_bytes_callback_count++;
+  runtime->snapshot_bytes_result = result;
+  runtime->snapshot_byte_count = byte_count;
+  if (bytes != NULL && byte_count != 0) {
+    memcpy(runtime->snapshot_bytes, bytes, byte_count);
+  }
+  runtime->snapshot_bytes_ready =
+      result == kFlutterSpiOk && byte_count == sizeof(runtime->snapshot_bytes);
+  if (runtime->snapshot_bytes_ready && runtime->engine_api != NULL &&
+      runtime->engine != NULL) {
+    runtime->engine_api->request_frame(runtime->engine);
+  }
+}
+
+static void test_runtime_snapshot_image_callback(void* user_data,
+                                                 FlutterSpiResult result,
+                                                 FlutterSpiImage* image) {
+  CTestRuntime* runtime = (CTestRuntime*)user_data;
+  const FlutterSpiImageApi* api = runtime->engine_api->image;
+
+  runtime->snapshot_callback_count++;
+  runtime->snapshot_callback_result = result;
+  if (runtime->snapshot_picture != NULL) {
+    runtime->engine_api->scene->picture_release(runtime->snapshot_picture);
+    runtime->snapshot_picture = NULL;
+  }
+  if (result != kFlutterSpiOk || image == NULL || api == NULL ||
+      api->image_to_bytes == NULL) {
+    if (image != NULL && api != NULL && api->image_release != NULL) {
+      api->image_release(image);
+    }
+    return;
+  }
+  runtime->image = image;
+  if (api->image_to_bytes(runtime->engine, image,
+                          kFlutterSpiImageByteFormatRawRGBA,
+                          test_runtime_snapshot_bytes_callback,
+                          runtime) != kFlutterSpiOk) {
+    runtime->snapshot_bytes_result = kFlutterSpiInternalError;
+    api->image_release(image);
+    runtime->image = NULL;
+  }
+}
+
+static bool test_runtime_create_snapshot_picture(CTestRuntime* runtime,
+                                                 FlutterSpiPicture** out_picture) {
+  const FlutterSpiSceneApi* api = runtime->engine_api->scene;
+  FlutterSpiPictureRecorder* recorder = NULL;
+  const FlutterSpiRect rect = {
+      .left = 0.0f, .top = 0.0f, .right = 1.0f, .bottom = 1.0f};
+
+  if (api == NULL ||
+      api->recorder_create(runtime->engine, NULL, &recorder) !=
+          kFlutterSpiOk ||
+      api->canvas_draw_rect(recorder, &rect, &k_snapshot_paint) !=
+          kFlutterSpiOk ||
+      api->recorder_finish(recorder, out_picture) != kFlutterSpiOk) {
+    if (recorder != NULL) {
+      api->recorder_release(recorder);
+    }
+    return false;
+  }
+  return true;
+}
