+  FlutterSpiResult SceneToImage(FlutterSpiScene* scene,
+                                int32_t width,
+                                int32_t height,
+                                FlutterSpiImageCallback callback,
+                                void* user_data);
+  FlutterSpiResult SceneToImageSync(FlutterSpiScene* scene,
+                                    int32_t width,
+                                    int32_t height,
+                                    FlutterSpiImage** out_image);
+
+ private:
+  FlutterSpiResult ValidateAsyncRequest(int32_t width,
+                                        int32_t height,
+                                        FlutterSpiImageCallback callback) const;
+  FlutterSpiResult ValidateSyncRequest(int32_t width,
+                                       int32_t height,
+                                       FlutterSpiImage** out_image) const;
+  void PostImageResult(FlutterSpiImageCallback callback,
+                       void* user_data,
+                       sk_sp<DlImage> image);
+  FlutterSpiResult WrapImage(sk_sp<DlImage> image,
+                             FlutterSpiImage** out_image) const;
+
+  ImageSnapshotContext context_;
+  fml::TaskRunnerAffineWeakPtrFactory<SpiImageSnapshot> weak_factory_;
+};
