+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/spi_runtime_backend_factory.h"
+
+#include <chrono>
+#include <memory>
+#include <thread>
+
+#include "flutter/fml/synchronization/waitable_event.h"
+#include "flutter/fml/time/time_delta.h"
+#include "flutter/runtime_spi/scene/spi_scene_trace.h"
+#include "flutter/runtime_spi/testing/c_test_runtime.h"
+#include "flutter/runtime_spi/testing/test_icu.h"
+#include "flutter/runtime_spi/spi_scene.h"
+#include "flutter/shell/common/shell_test.h"
+#include "flutter/shell/common/shell_test_platform_view.h"
+#include "flutter/testing/testing.h"
+
+namespace flutter::testing {
+namespace {
+
+constexpr int64_t kViewId = 0;
+
+struct ImageCallbackState {
+  fml::AutoResetWaitableEvent completed;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  FlutterSpiImage* image = nullptr;
+  int32_t width = 0;
+  int32_t height = 0;
+};
+
+void CaptureImage(void* user_data,
+                  FlutterSpiResult result,
+                  FlutterSpiImage* image) {
+  auto* state = static_cast<ImageCallbackState*>(user_data);
+  state->result = result;
+  state->image = image;
+  state->completed.Signal();
+}
+
+void PostSync(const fml::RefPtr<fml::TaskRunner>& task_runner,
+              const fml::closure& task) {
+  fml::AutoResetWaitableEvent completed;
+  task_runner->PostTask([&completed, &task] {
+    task();
+    completed.Signal();
+  });
+  completed.Wait();
+}
+
+class SpiImageSnapshotTest : public ShellTest {
+ protected:
+  void SetUp() override {
+    InitializeIcuForTesting();
+    runtime_ = c_test_runtime_create();
+    task_runners_ = std::make_unique<TaskRunners>(GetTaskRunnersForFixture());
+  }
+
+  void TearDown() override {
+    if (shell_ != nullptr) {
+      DestroyShell(std::move(shell_), *task_runners_);
+    }
+    c_test_runtime_free(runtime_);
+  }
+
+  void StartShell() {
+    auto settings = CreateSettingsForFixture();
+    settings.icu_data_path = IcuDataPathForTesting();
+    auto factory = std::make_shared<SpiRuntimeBackendFactory>(
+        c_test_runtime_table(runtime_));
+    shell_ = Shell::Create(
+        PlatformData(), *task_runners_, settings,
+        ShellTestPlatformViewBuilder({}),
+        [](Shell& shell) { return std::make_unique<Rasterizer>(shell); },
+        factory);
+    ASSERT_TRUE(shell_->IsSetup());
+    PlatformViewNotifyCreated(shell_.get());
+    RunEngine(shell_.get(), RunConfiguration::InferFromSettings(settings));
+  }
+
+  FlutterSpiPicture* CreatePicture() {
+    const auto* scene_api = runtime_->engine_api->scene;
+    FlutterSpiPictureRecorder* recorder = nullptr;
+    FlutterSpiPicture* picture = nullptr;
+    const FlutterSpiRect rect = {.left = 0.0f,
+                                 .top = 0.0f,
+                                 .right = 1.0f,
+                                 .bottom = 1.0f};
+    const FlutterSpiPaint paint = {
+        .struct_size = sizeof(FlutterSpiPaint),
+        .color = {.red = 1.0f,
+                  .green = 0.0f,
+                  .blue = 0.0f,
+                  .alpha = 1.0f,
+                  .color_space = kFlutterSpiColorSpaceSRGB},
+        .blend_mode = kFlutterSpiBlendModeSrcOver,
+        .style = kFlutterSpiPaintStyleFill,
+        .anti_alias = true,
+    };
+    EXPECT_EQ(scene_api->recorder_create(runtime_->engine, nullptr, &recorder),
+              kFlutterSpiOk);
+    EXPECT_EQ(scene_api->canvas_draw_rect(recorder, &rect, &paint),
+              kFlutterSpiOk);
+    EXPECT_EQ(scene_api->recorder_finish(recorder, &picture), kFlutterSpiOk);
+    return picture;
+  }
+
+  FlutterSpiScene* CreateScene(FlutterSpiPicture* picture) {
+    const auto* scene_api = runtime_->engine_api->scene;
+    FlutterSpiSceneBuilder* builder = nullptr;
+    FlutterSpiScene* scene = nullptr;
+    EXPECT_EQ(scene_api->scene_builder_create(runtime_->engine, &builder),
+              kFlutterSpiOk);
+    EXPECT_EQ(scene_api->scene_add_picture(builder, 0.0f, 0.0f, picture, false,
+                                           false),
+              kFlutterSpiOk);
+    EXPECT_EQ(scene_api->scene_build(builder, 1, 1, &scene), kFlutterSpiOk);
+    return scene;
+  }
+
+  void WaitForImage(ImageCallbackState* state) { state->completed.Wait(); }
+
+  CTestRuntime* runtime_ = nullptr;
+  std::unique_ptr<TaskRunners> task_runners_;
+  std::unique_ptr<Shell> shell_;
+};
+
+TEST_F(SpiImageSnapshotTest, PictureToImageHasRequestedSize) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  ImageCallbackState callback;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture();
+    ASSERT_EQ(runtime_->engine_api->image->picture_to_image(
+                  runtime_->engine, picture, 7, 5, CaptureImage, &callback),
+              kFlutterSpiOk);
+  });
+
+  WaitForImage(&callback);
+  ASSERT_EQ(callback.result, kFlutterSpiOk);
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    ASSERT_EQ(runtime_->engine_api->image->image_get_size(
+                  callback.image, &callback.width, &callback.height),
+              kFlutterSpiOk);
+    EXPECT_EQ(callback.width, 7);
+    EXPECT_EQ(callback.height, 5);
+    runtime_->engine_api->image->image_release(callback.image);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+TEST_F(SpiImageSnapshotTest, PictureToImageSyncIsDeferredAndDrawable) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  FlutterSpiImage* image = nullptr;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture();
+    ASSERT_EQ(runtime_->engine_api->image->picture_to_image_sync(
+                  runtime_->engine, picture, 1, 1, &image),
+              kFlutterSpiOk);
+    FlutterSpiPicture* image_picture = nullptr;
+    const auto* scene_api = runtime_->engine_api->scene;
+    FlutterSpiPictureRecorder* recorder = nullptr;
+    ASSERT_EQ(scene_api->recorder_create(runtime_->engine, nullptr, &recorder),
+              kFlutterSpiOk);
+    ASSERT_EQ(runtime_->engine_api->image->canvas_draw_image(
+                  recorder, image, {.x = 0.0f, .y = 0.0f},
+                  kFlutterSpiFilterQualityNone, nullptr),
+              kFlutterSpiOk);
+    ASSERT_EQ(scene_api->recorder_finish(recorder, &image_picture),
+              kFlutterSpiOk);
+    scene_api->picture_release(picture);
+    picture = image_picture;
+  });
+
+  runtime_->draw_image_on_begin_frame = true;
+  runtime_->image = image;
+  runtime_->image_decode_requested = true;
+  image = nullptr;
+  PumpOneFrame(shell_.get());
+  PostSync(shell_->GetTaskRunners().GetRasterTaskRunner(), [&] {
+    auto* layer_tree = shell_->GetRasterizer()->GetLastLayerTree(kViewId);
+    ASSERT_NE(layer_tree, nullptr);
+    EXPECT_EQ(SceneTrace(*layer_tree),
+              "scene 1x1\n"
+              "container\n"
+              "  picture 0 0\n"
+              "    op drawImage\n");
+  });
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+TEST_F(SpiImageSnapshotTest, SceneToImageHasFrameSize) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  FlutterSpiScene* scene = nullptr;
+  ImageCallbackState callback;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture();
+    scene = CreateScene(picture);
+    ASSERT_EQ(runtime_->engine_api->image->scene_to_image(
+                  runtime_->engine, scene, 9, 6, CaptureImage, &callback),
+              kFlutterSpiOk);
+  });
+  WaitForImage(&callback);
+  ASSERT_EQ(callback.result, kFlutterSpiOk);
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    ASSERT_EQ(runtime_->engine_api->image->image_get_size(
+                  callback.image, &callback.width, &callback.height),
+              kFlutterSpiOk);
+    EXPECT_EQ(callback.width, 9);
+    EXPECT_EQ(callback.height, 6);
+    runtime_->engine_api->image->image_release(callback.image);
+    SpiSceneRelease(scene);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+TEST_F(SpiImageSnapshotTest, SceneStaysUsableAfterToImage) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  FlutterSpiScene* scene = nullptr;
+  ImageCallbackState first_callback;
+  ImageCallbackState second_callback;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture();
+    scene = CreateScene(picture);
+    ASSERT_EQ(runtime_->engine_api->image->scene_to_image(
+                  runtime_->engine, scene, 4, 4, CaptureImage, &first_callback),
+              kFlutterSpiOk);
+  });
+  WaitForImage(&first_callback);
+  ASSERT_EQ(first_callback.result, kFlutterSpiOk);
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    ASSERT_EQ(runtime_->engine_api->image->scene_to_image(
+                  runtime_->engine, scene, 4, 4, CaptureImage,
+                  &second_callback),
+              kFlutterSpiOk);
+    runtime_->engine_api->image->image_release(first_callback.image);
+  });
+  WaitForImage(&second_callback);
+  ASSERT_EQ(second_callback.result, kFlutterSpiOk);
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    runtime_->engine_api->image->image_release(second_callback.image);
+    SpiSceneRelease(scene);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+TEST_F(SpiImageSnapshotTest, ZeroSizeIsRejected) {
+  StartShell();
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    FlutterSpiPicture* picture = CreatePicture();
+    FlutterSpiImage* image = nullptr;
+    EXPECT_EQ(runtime_->engine_api->image->picture_to_image_sync(
+                  runtime_->engine, picture, 0, 1, &image),
+              kFlutterSpiInvalidArgument);
+    EXPECT_EQ(runtime_->engine_api->image->picture_to_image(
+                  runtime_->engine, picture, 1, 0, CaptureImage, nullptr),
+              kFlutterSpiInvalidArgument);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+TEST_F(SpiImageSnapshotTest, SnapshotFailureIsInternalError) {
+  GTEST_SKIP() << "The Shell fixture always supplies a live SnapshotDelegate; "
+                  "a delegate without a surface cannot be injected here.";
+}
+
