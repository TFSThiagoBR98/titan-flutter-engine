+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/image/spi_image_snapshot.h"
+
+#include <utility>
+
+#include "flutter/flow/layers/layer_tree.h"
+#include "flutter/flow/layers/container_layer.h"
+#include "flutter/runtime_spi/image/spi_image.h"
+#include "flutter/runtime_spi/scene/spi_canvas.h"
+#include "flutter/runtime_spi/spi_scene.h"
+
+namespace flutter {
+
+SpiImageSnapshot::SpiImageSnapshot(ImageSnapshotContext context)
+    : context_(std::move(context)), weak_factory_(this) {}
+
+SpiImageSnapshot::~SpiImageSnapshot() = default;
+
+FlutterSpiResult SpiImageSnapshot::ValidateAsyncRequest(
+    int32_t width,
+    int32_t height,
+    FlutterSpiImageCallback callback) const {
+  if (width <= 0 || height <= 0 || callback == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiImageSnapshot::ValidateSyncRequest(
+    int32_t width,
+    int32_t height,
+    FlutterSpiImage** out_image) const {
+  if (width <= 0 || height <= 0 || out_image == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return kFlutterSpiOk;
+}
+
+void SpiImageSnapshot::PostImageResult(FlutterSpiImageCallback callback,
+                                       void* user_data,
+                                       sk_sp<DlImage> image) {
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  context_.ui_task_runner->PostTask(
+      [weak_this, callback, user_data, image = std::move(image)]() mutable {
+        if (!weak_this) {
+          return;
+        }
+        FlutterSpiImage* handle = nullptr;
+        FlutterSpiResult result = image == nullptr ? kFlutterSpiInternalError
+                                                    : kFlutterSpiOk;
+        if (result == kFlutterSpiOk &&
+            SpiImageWrap(std::move(image), &handle) != kFlutterSpiOk) {
+          result = kFlutterSpiInternalError;
+        }
+        callback(user_data, result, handle);
+      });
+}
+
+FlutterSpiResult SpiImageSnapshot::WrapImage(sk_sp<DlImage> image,
+                                             FlutterSpiImage** out_image) const {
+  if (image == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  return SpiImageWrap(std::move(image), out_image) == kFlutterSpiOk
+             ? kFlutterSpiOk
+             : kFlutterSpiInternalError;
+}
+
+FlutterSpiResult SpiImageSnapshot::PictureToImage(
+    FlutterSpiPicture* picture,
+    int32_t width,
+    int32_t height,
+    FlutterSpiImageCallback callback,
+    void* user_data) {
+  if (ValidateAsyncRequest(width, height, callback) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const DisplayList* display_list = SpiPictureDisplayListForTesting(picture);
+  if (display_list == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!context_.snapshot_delegate) {
+    PostImageResult(callback, user_data, nullptr);
+    return kFlutterSpiOk;
+  }
+  RasterizeToImageAsync(
+      context_, sk_ref_sp(display_list), nullptr, width, height,
+      [this, callback, user_data](sk_sp<DlImage> image) mutable {
+        PostImageResult(callback, user_data, std::move(image));
+      });
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiImageSnapshot::PictureToImageSync(
+    FlutterSpiPicture* picture,
+    int32_t width,
+    int32_t height,
+    FlutterSpiImage** out_image) {
+  if (ValidateSyncRequest(width, height, out_image) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const DisplayList* display_list = SpiPictureDisplayListForTesting(picture);
+  if (display_list == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return WrapImage(CreateDeferredImage(context_, sk_ref_sp(display_list), width,
+                                       height,
+                                       SnapshotPixelFormat::kDontCare),
+                   out_image);
+}
+
+FlutterSpiResult SpiImageSnapshot::SceneToImage(FlutterSpiScene* scene,
+                                                int32_t width,
+                                                int32_t height,
+                                                FlutterSpiImageCallback callback,
+                                                void* user_data) {
+  if (ValidateAsyncRequest(width, height, callback) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (scene == nullptr || scene->layer_tree == nullptr ||
+      scene->root_layer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!context_.snapshot_delegate) {
+    PostImageResult(callback, user_data, nullptr);
+    return kFlutterSpiOk;
+  }
+  auto layer_tree = std::make_unique<LayerTree>(
+      scene->root_layer, DlISize(width, height));
+  RasterizeToImageAsync(context_, nullptr, std::move(layer_tree), width, height,
+                        [this, callback, user_data](sk_sp<DlImage> image) {
+                          PostImageResult(callback, user_data,
+                                          std::move(image));
+                        });
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiImageSnapshot::SceneToImageSync(
+    FlutterSpiScene* scene,
+    int32_t width,
+    int32_t height,
+    FlutterSpiImage** out_image) {
+  if (ValidateSyncRequest(width, height, out_image) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (scene == nullptr || scene->layer_tree == nullptr ||
+      scene->root_layer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  auto layer_tree = std::make_unique<LayerTree>(
+      scene->root_layer, DlISize(width, height));
+  return WrapImage(CreateDeferredImage(context_, std::move(layer_tree)),
+                   out_image);
+}
+
+}  // namespace flutter
