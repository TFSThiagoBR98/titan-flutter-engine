@@ -0,0 +1,72 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/scene/spi_paint.h"
+
+#include <cstddef>
+
+#include "flutter/display_list/dl_paint.h"
+#include "flutter/runtime_spi/include/flutter_scene.h"
+#include "flutter/testing/testing.h"
+
+namespace flutter::testing {
+namespace {
+
+TEST(SpiPaint, ConvertsEveryField) {
+  const FlutterSpiPaint input = {
+      .struct_size = sizeof(FlutterSpiPaint),
+      .color = {.red = 0.1f,
+                .green = 0.2f,
+                .blue = 0.3f,
+                .alpha = 0.4f,
+                .color_space = kFlutterSpiColorSpaceDisplayP3},
+      .blend_mode = kFlutterSpiBlendModeMultiply,
+      .style = kFlutterSpiPaintStyleStrokeAndFill,
+      .stroke_width = 2.5f,
+      .stroke_cap = kFlutterSpiStrokeCapRound,
+      .stroke_join = kFlutterSpiStrokeJoinBevel,
+      .stroke_miter = 3.5f,
+      .anti_alias = false,
+      .invert_colors = true,
+  };
+
+  const DlPaint paint = ToDlPaint(input);
+
+  EXPECT_EQ(paint.getColor(),
+            DlColor(0.4f, 0.1f, 0.2f, 0.3f, DlColorSpace::kDisplayP3));
+  EXPECT_EQ(paint.getBlendMode(), DlBlendMode::kMultiply);
+  EXPECT_EQ(paint.getDrawStyle(), DlDrawStyle::kStrokeAndFill);
+  EXPECT_EQ(paint.getStrokeWidth(), 2.5f);
+  EXPECT_EQ(paint.getStrokeCap(), DlStrokeCap::kRound);
+  EXPECT_EQ(paint.getStrokeJoin(), DlStrokeJoin::kBevel);
+  EXPECT_EQ(paint.getStrokeMiter(), 3.5f);
+  EXPECT_FALSE(paint.isAntiAlias());
+  EXPECT_TRUE(paint.isInvertColors());
+}
+
+TEST(SpiPaint, OlderStructUsesDlPaintDefaults) {
+  const FlutterSpiPaint input = {
+      .struct_size = offsetof(FlutterSpiPaint, blend_mode),
+      .color = {.red = 0.1f,
+                .green = 0.2f,
+                .blue = 0.3f,
+                .alpha = 0.4f,
+                .color_space = kFlutterSpiColorSpaceSRGB},
+  };
+
+  const DlPaint paint = ToDlPaint(input);
+
+  EXPECT_EQ(paint.getColor(), DlColor::ARGB(0.4f, 0.1f, 0.2f, 0.3f));
+  EXPECT_EQ(paint.getBlendMode(), DlPaint::kDefault.getBlendMode());
+  EXPECT_EQ(paint.getDrawStyle(), DlPaint::kDefault.getDrawStyle());
+  EXPECT_EQ(paint.getStrokeWidth(), DlPaint::kDefaultWidth);
+  EXPECT_EQ(paint.getStrokeCap(), DlPaint::kDefault.getStrokeCap());
+  EXPECT_EQ(paint.getStrokeJoin(), DlPaint::kDefault.getStrokeJoin());
+  EXPECT_EQ(paint.getStrokeMiter(), DlPaint::kDefaultMiter);
+  EXPECT_EQ(paint.isAntiAlias(), DlPaint::kDefaultAntiAlias);
+  EXPECT_FALSE(paint.isInvertColors());
+}
+
+}  // namespace
+}  // namespace flutter::testing
