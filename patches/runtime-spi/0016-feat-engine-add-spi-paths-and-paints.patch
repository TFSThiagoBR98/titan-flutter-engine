+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/scene/spi_paint.h"
+
+#include <cstddef>
+
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+
+namespace flutter {
+namespace {
+
+bool ContainsField(size_t struct_size, size_t offset, size_t field_size) {
+  return struct_size >= offset && struct_size - offset >= field_size;
+}
+
+}  // namespace
+
+DlPaint ToDlPaint(const FlutterSpiPaint& paint) {
+  DlPaint result;
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, color),
+                    sizeof(paint.color))) {
+    result.setColor(ToDlColor(paint.color));
+  }
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, blend_mode),
+                    sizeof(paint.blend_mode))) {
+    result.setBlendMode(static_cast<DlBlendMode>(paint.blend_mode));
+  }
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, style),
+                    sizeof(paint.style))) {
+    result.setDrawStyle(static_cast<DlDrawStyle>(paint.style));
+  }
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, stroke_width),
+                    sizeof(paint.stroke_width))) {
+    result.setStrokeWidth(paint.stroke_width);
+  }
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, stroke_cap),
+                    sizeof(paint.stroke_cap))) {
+    result.setStrokeCap(static_cast<DlStrokeCap>(paint.stroke_cap));
+  }
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, stroke_join),
+                    sizeof(paint.stroke_join))) {
+    result.setStrokeJoin(static_cast<DlStrokeJoin>(paint.stroke_join));
+  }
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, stroke_miter),
+                    sizeof(paint.stroke_miter))) {
+    result.setStrokeMiter(paint.stroke_miter);
+  }
+  if (ContainsField(paint.struct_size, offsetof(FlutterSpiPaint, anti_alias),
+                    sizeof(paint.anti_alias))) {
+    result.setAntiAlias(paint.anti_alias);
+  }
+  if (ContainsField(paint.struct_size,
+                    offsetof(FlutterSpiPaint, invert_colors),
+                    sizeof(paint.invert_colors))) {
+    result.setInvertColors(paint.invert_colors);
+  }
+  return result;
+}
+
+}  // namespace flutter
