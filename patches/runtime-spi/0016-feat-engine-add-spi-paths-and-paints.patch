@@ -0,0 +1,87 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+#include "flutter/runtime_spi/scene/spi_path.h"
+
+#include <cmath>
+
+#include "flutter/display_list/geometry/dl_path_builder.h"
+#include "flutter/runtime_spi/include/flutter_scene.h"
+#include "flutter/testing/testing.h"
+
+namespace flutter::testing {
+namespace {
+
+TEST(SpiPath, ABIOperationsMatchDirectPathBuilder) {
+  SpiPath actual;
+  actual.SetFillType(DlPathFillType::kOdd);
+  actual.MoveTo({1.0f, 2.0f});
+  actual.LineTo({3.0f, 4.0f});
+  actual.QuadraticCurveTo({5.0f, 6.0f}, {7.0f, 8.0f});
+  actual.ConicCurveTo({9.0f, 10.0f}, {11.0f, 12.0f}, 0.75f);
+  actual.CubicCurveTo({13.0f, 14.0f}, {15.0f, 16.0f}, {17.0f, 18.0f});
+  actual.Close();
+  actual.AddRect(DlRect::MakeLTRB(1.0f, 2.0f, 30.0f, 40.0f));
+  actual.AddOval(DlRect::MakeLTRB(2.0f, 3.0f, 20.0f, 30.0f));
+  actual.AddRoundRect(DlRoundRect::MakeRectXY(
+      DlRect::MakeLTRB(4.0f, 5.0f, 40.0f, 50.0f), 6.0f, 7.0f));
+
+  DlPathBuilder expected;
+  expected.SetFillType(DlPathFillType::kOdd)
+      .MoveTo({1.0f, 2.0f})
+      .LineTo({3.0f, 4.0f})
+      .QuadraticCurveTo({5.0f, 6.0f}, {7.0f, 8.0f})
+      .ConicCurveTo({9.0f, 10.0f}, {11.0f, 12.0f}, 0.75f)
+      .CubicCurveTo({13.0f, 14.0f}, {15.0f, 16.0f}, {17.0f, 18.0f})
+      .Close()
+      .AddRect(DlRect::MakeLTRB(1.0f, 2.0f, 30.0f, 40.0f))
+      .AddOval(DlRect::MakeLTRB(2.0f, 3.0f, 20.0f, 30.0f))
+      .AddRoundRect(DlRoundRect::MakeRectXY(
+          DlRect::MakeLTRB(4.0f, 5.0f, 40.0f, 50.0f), 6.0f, 7.0f));
+
+  EXPECT_EQ(actual.path(), expected.CopyPath());
+}
+
+TEST(SpiGeometry, ConvertsFiniteValues) {
+  const FlutterSpiPoint spi_point = {.x = 1.0f, .y = 2.0f};
+  const FlutterSpiRect spi_rect = {
+      .left = 1.0f, .top = 2.0f, .right = 30.0f, .bottom = 40.0f};
+  const FlutterSpiRRect spi_rrect = {
+      .rect = spi_rect,
+      .radii = {{3.0f, 4.0f}, {5.0f, 6.0f}, {7.0f, 8.0f}, {9.0f, 10.0f}},
+  };
+  FlutterSpiMatrix spi_matrix = {};
+  for (size_t index = 0; index < 16; ++index) {
+    spi_matrix.m[index] = static_cast<float>(index);
+  }
+
+  DlPoint point;
+  DlRect rect;
+  DlRoundRect rrect;
+  DlMatrix matrix;
+
+  ASSERT_TRUE(ToDlPoint(spi_point, &point));
+  ASSERT_TRUE(ToDlRect(spi_rect, &rect));
+  ASSERT_TRUE(ToDlRoundRect(spi_rrect, &rrect));
+  ASSERT_TRUE(ToDlMatrix(spi_matrix, &matrix));
+
+  EXPECT_EQ(point, DlPoint(1.0f, 2.0f));
+  EXPECT_EQ(rect, DlRect::MakeLTRB(1.0f, 2.0f, 30.0f, 40.0f));
+  EXPECT_TRUE(rrect.IsFinite());
+  for (size_t index = 0; index < 16; ++index) {
+    EXPECT_EQ(matrix.m[index], static_cast<float>(index));
+  }
+}
+
+TEST(SpiGeometry, RejectsNonFiniteMatrix) {
+  FlutterSpiMatrix spi_matrix = {};
+  spi_matrix.m[7] = NAN;
+  DlMatrix matrix;
+
+  EXPECT_FALSE(ToDlMatrix(spi_matrix, &matrix));
+}
+
+}  // namespace
+}  // namespace flutter::testing
