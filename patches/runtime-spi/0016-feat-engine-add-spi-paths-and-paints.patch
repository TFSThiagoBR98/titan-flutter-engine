@@ -0,0 +1,80 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+
+#include <cmath>
+
+namespace flutter {
+namespace {
+
+bool IsFinite(const FlutterSpiPoint& point) {
+  return std::isfinite(point.x) && std::isfinite(point.y);
+}
+
+bool IsFinite(const FlutterSpiRect& rect) {
+  return std::isfinite(rect.left) && std::isfinite(rect.top) &&
+         std::isfinite(rect.right) && std::isfinite(rect.bottom);
+}
+
+}  // namespace
+
+DlColor ToDlColor(const FlutterSpiColor& color) {
+  return DlColor(color.alpha, color.red, color.green, color.blue,
+                 static_cast<DlColorSpace>(color.color_space));
+}
+
+bool ToDlPoint(const FlutterSpiPoint& point, DlPoint* out_point) {
+  if (out_point == nullptr || !IsFinite(point)) {
+    return false;
+  }
+  *out_point = DlPoint(point.x, point.y);
+  return true;
+}
+
+bool ToDlRect(const FlutterSpiRect& rect, DlRect* out_rect) {
+  if (out_rect == nullptr || !IsFinite(rect)) {
+    return false;
+  }
+  *out_rect = DlRect::MakeLTRB(rect.left, rect.top, rect.right, rect.bottom);
+  return true;
+}
+
+bool ToDlRoundRect(const FlutterSpiRRect& round_rect,
+                  DlRoundRect* out_rrect) {
+  if (out_rrect == nullptr || !IsFinite(round_rect.rect) ||
+      !IsFinite(round_rect.radii[0]) || !IsFinite(round_rect.radii[1]) ||
+      !IsFinite(round_rect.radii[2]) || !IsFinite(round_rect.radii[3])) {
+    return false;
+  }
+
+  *out_rrect = DlRoundRect::MakeRectRadii(
+      DlRect::MakeLTRB(round_rect.rect.left, round_rect.rect.top,
+                       round_rect.rect.right, round_rect.rect.bottom),
+      {
+          .top_left = DlSize(round_rect.radii[0].x, round_rect.radii[0].y),
+          .top_right = DlSize(round_rect.radii[1].x, round_rect.radii[1].y),
+          .bottom_left = DlSize(round_rect.radii[3].x, round_rect.radii[3].y),
+          .bottom_right =
+              DlSize(round_rect.radii[2].x, round_rect.radii[2].y),
+      });
+  return true;
+}
+
+bool ToDlMatrix(const FlutterSpiMatrix& matrix, DlMatrix* out_matrix) {
+  if (out_matrix == nullptr) {
+    return false;
+  }
+  for (float value : matrix.m) {
+    if (!std::isfinite(value)) {
+      return false;
+    }
+  }
+  for (size_t index = 0; index < 16; ++index) {
+    out_matrix->m[index] = matrix.m[index];
+  }
+  return true;
+}
+
+}  // namespace flutter
