+TEST(SpiGeometry, RSuperellipseContainsMatchesImpeller) {
+  const FlutterSpiSceneApi* api = SpiSceneApi();
+  ASSERT_NE(api->rsuperellipse_contains, nullptr);
+
+  constexpr FlutterSpiRSuperellipse shape = {
+      .rect = {.left = -50.0f, .top = -50.0f, .right = 50.0f, .bottom = 50.0f},
+      .radii = {{5.0f, 5.0f},
+                {5.0f, 5.0f},
+                {5.0f, 5.0f},
+                {5.0f, 5.0f}},
+  };
+  const impeller::Rect bounds =
+      impeller::Rect::MakeLTRB(shape.rect.left, shape.rect.top,
+                               shape.rect.right, shape.rect.bottom)
+          .GetPositive();
+  const impeller::RoundingRadii radii = {
+      .top_left = {shape.radii[0].x, shape.radii[0].y},
+      .top_right = {shape.radii[1].x, shape.radii[1].y},
+      .bottom_left = {shape.radii[3].x, shape.radii[3].y},
+      .bottom_right = {shape.radii[2].x, shape.radii[2].y},
+  };
+  const auto param =
+      impeller::RoundSuperellipseParam::MakeBoundsRadii(bounds, radii);
+
+  for (const impeller::Point point : {
+           impeller::Point{0.0f, 0.0f},
+           impeller::Point{60.0f, 0.0f},
+           impeller::Point{48.53f, 48.53f},
+       }) {
+    bool actual = false;
+    ASSERT_EQ(api->rsuperellipse_contains(&shape, point.x, point.y, &actual),
+              kFlutterSpiOk);
+    const bool expected = bounds.Contains(point) && param.Contains(point);
+    EXPECT_EQ(actual, expected);
+  }
+}
+
 }  // namespace
 }  // namespace flutter::testing
