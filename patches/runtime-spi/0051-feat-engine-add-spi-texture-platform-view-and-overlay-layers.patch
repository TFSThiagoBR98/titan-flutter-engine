+FlutterSpiResult SpiSceneAddTexture(FlutterSpiSceneBuilder* builder,
+                                    float dx,
+                                    float dy,
+                                    float width,
+                                    float height,
+                                    int64_t texture_id,
+                                    bool freeze,
+                                    int32_t filter_quality) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!std::isfinite(dx) || !std::isfinite(dy) || !std::isfinite(width) ||
+      !std::isfinite(height) || !IsValidFilterQuality(filter_quality)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  AddLayer(std::make_shared<TextureLayer>(
+                DlPoint(dx, dy), DlSize(width, height), texture_id, freeze,
+                SamplingFromFilterQuality(filter_quality)),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiSceneAddPlatformView(FlutterSpiSceneBuilder* builder,
+                                         float dx,
+                                         float dy,
+                                         float width,
+                                         float height,
+                                         int64_t view_id) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!std::isfinite(dx) || !std::isfinite(dy) || !std::isfinite(width) ||
+      !std::isfinite(height)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  AddLayer(std::make_shared<PlatformViewLayer>(
+                DlPoint(dx, dy), DlSize(width, height), view_id),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiSceneAddPerformanceOverlay(
+    FlutterSpiSceneBuilder* builder,
+    uint64_t enabled_options,
+    const FlutterSpiRect* bounds) {
+  const auto builder_value = FindBuilder(builder);
+  DlRect dl_bounds;
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (bounds == nullptr || !ToDlRect(*bounds, &dl_bounds)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto layer = std::make_shared<PerformanceOverlayLayer>(enabled_options);
+  layer->set_paint_bounds(dl_bounds);
+  AddLayer(layer, builder_value);
+  return kFlutterSpiOk;
+}
