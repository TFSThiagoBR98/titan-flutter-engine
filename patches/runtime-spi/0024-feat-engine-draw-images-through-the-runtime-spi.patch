+namespace flutter::testing {
+namespace {
+
+sk_sp<DlImage> MakeTestImage() {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(4, 3))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(SK_ColorBLUE);
+  bitmap.setImmutable();
+  return DlImageSkia::Make(SkImages::RasterFromBitmap(bitmap));
+}
+
+TEST(SpiImage, WrapGetSizeAndRetainRelease) {
+  FlutterSpiImage* image = nullptr;
+  ASSERT_EQ(SpiImageWrap(MakeTestImage(), &image), kFlutterSpiOk);
+
+  int32_t width = 0;
+  int32_t height = 0;
+  EXPECT_EQ(SpiImageGetSize(image, &width, &height), kFlutterSpiOk);
+  EXPECT_EQ(width, 4);
+  EXPECT_EQ(height, 3);
+
+  EXPECT_EQ(SpiImageRetain(image), kFlutterSpiOk);
+  EXPECT_EQ(SpiImageRelease(image), kFlutterSpiOk);
+  EXPECT_EQ(SpiImageRelease(image), kFlutterSpiOk);
+  EXPECT_EQ(SpiImageGetSize(image, &width, &height), kFlutterSpiInvalidHandle);
+}
