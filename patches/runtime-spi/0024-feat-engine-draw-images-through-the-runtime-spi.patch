+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/image/spi_image.h"
+
+#include <cstdint>
+#include <memory>
+
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+
+namespace flutter {
+namespace {
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+class SpiImage final {
+ public:
+  explicit SpiImage(sk_sp<DlImage> image) : image_(std::move(image)) {}
+
+  const sk_sp<DlImage>& image() const { return image_; }
+
+ private:
+  sk_sp<DlImage> image_;
+};
+
+SpiHandleTable<SpiImage>& Images() {
+  static SpiHandleTable<SpiImage> images;
+  return images;
+}
+
+std::shared_ptr<SpiImage> FindImage(FlutterSpiImage* image) {
+  return Images().Find(HandleValue(image));
+}
+
+}  // namespace
+
+FlutterSpiResult SpiImageWrap(sk_sp<DlImage> image,
+                              FlutterSpiImage** out_image) {
+  if (image == nullptr || out_image == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const uintptr_t handle = Images().Insert(std::make_shared<SpiImage>(image));
+  *out_image = MakeHandle<FlutterSpiImage>(handle);
+  return kFlutterSpiOk;
+}
+
+sk_sp<DlImage> SpiImageGet(FlutterSpiImage* image) {
+  const auto image_value = FindImage(image);
+  return image_value == nullptr ? nullptr : image_value->image();
+}
+
+FlutterSpiResult SpiImageGetSize(FlutterSpiImage* image,
+                                 int32_t* out_width,
+                                 int32_t* out_height) {
+  const auto image_value = FindImage(image);
+  if (image_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_width == nullptr || out_height == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const DlISize size = image_value->image()->GetSize();
+  *out_width = size.width;
+  *out_height = size.height;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiImageRetain(FlutterSpiImage* image) {
+  return Images().Retain(HandleValue(image)) ? kFlutterSpiOk
+                                              : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiImageRelease(FlutterSpiImage* image) {
+  return Images().Release(HandleValue(image)) ? kFlutterSpiOk
+                                               : kFlutterSpiInvalidHandle;
+}
+
+}  // namespace flutter
