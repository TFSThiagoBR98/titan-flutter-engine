diff --git a/engine/src/flutter/runtime_spi/image/spi_image_canvas.cc b/engine/src/flutter/runtime_spi/image/spi_image_canvas.cc
new file mode 100644
index 00000000000..38e9d80c864
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/image/spi_image_canvas.cc
@@ -0,0 +1,244 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/image/spi_image_canvas.h"
+
+#include <cmath>
+#include <limits>
+#include <optional>
+#include <vector>
+
+#include "flutter/display_list/dl_builder.h"
+#include "flutter/display_list/dl_paint.h"
+#include "flutter/runtime_spi/image/spi_image.h"
+#include "flutter/runtime_spi/scene/spi_canvas.h"
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+#include "flutter/runtime_spi/scene/spi_paint.h"
+
+namespace flutter {
+namespace {
+
+std::optional<DlPaint> ToOptionalPaint(const FlutterSpiPaint* paint) {
+  if (paint == nullptr) {
+    return std::nullopt;
+  }
+  return ToDlPaint(*paint);
+}
+
+bool IsFinite(const FlutterSpiRSTransform& transform) {
+  return std::isfinite(transform.scos) && std::isfinite(transform.ssin) &&
+         std::isfinite(transform.tx) && std::isfinite(transform.ty);
+}
+
+bool IsValidFilterQuality(int32_t quality) {
+  return quality >= kFlutterSpiFilterQualityNone &&
+         quality <= kFlutterSpiFilterQualityHigh;
+}
+
+FlutterSpiResult FindCanvasDependencies(FlutterSpiPictureRecorder* recorder,
+                                        FlutterSpiImage* image,
+                                        DisplayListBuilder** out_builder,
+                                        sk_sp<DlImage>* out_image) {
+  DisplayListBuilder* builder = SpiPictureRecorderBuilder(recorder);
+  if (builder == nullptr || out_builder == nullptr || out_image == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  sk_sp<DlImage> dl_image = SpiImageGet(image);
+  if (dl_image == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  *out_builder = builder;
+  *out_image = std::move(dl_image);
+  return kFlutterSpiOk;
+}
+
+}  // namespace
+
+DlImageSampling SpiSamplingFromFilterQuality(int32_t quality, bool* ok) {
+  if (!IsValidFilterQuality(quality)) {
+    if (ok != nullptr) {
+      *ok = false;
+    }
+    return DlImageSampling::kNearestNeighbor;
+  }
+  if (ok != nullptr) {
+    *ok = true;
+  }
+  return static_cast<DlImageSampling>(quality);
+}
+
+DlFilterMode SpiFilterModeFromFilterQuality(int32_t quality, bool* ok) {
+  if (!IsValidFilterQuality(quality)) {
+    if (ok != nullptr) {
+      *ok = false;
+    }
+    return DlFilterMode::kNearest;
+  }
+  if (ok != nullptr) {
+    *ok = true;
+  }
+  return quality == kFlutterSpiFilterQualityNone ? DlFilterMode::kNearest
+                                                  : DlFilterMode::kLinear;
+}
+
+FlutterSpiResult SpiCanvasDrawImage(FlutterSpiPictureRecorder* recorder,
+                                    FlutterSpiImage* image,
+                                    FlutterSpiPoint offset,
+                                    int32_t filter_quality,
+                                    const FlutterSpiPaint* paint) {
+  DisplayListBuilder* builder = nullptr;
+  sk_sp<DlImage> dl_image;
+  const FlutterSpiResult dependencies =
+      FindCanvasDependencies(recorder, image, &builder, &dl_image);
+  if (dependencies != kFlutterSpiOk) {
+    return dependencies;
+  }
+  DlPoint dl_offset;
+  bool quality_ok = false;
+  const DlImageSampling sampling =
+      SpiSamplingFromFilterQuality(filter_quality, &quality_ok);
+  if (!quality_ok || !ToDlPoint(offset, &dl_offset)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const std::optional<DlPaint> dl_paint = ToOptionalPaint(paint);
+  builder->DrawImage(dl_image, dl_offset, sampling,
+                     dl_paint.has_value() ? &dl_paint.value() : nullptr);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiCanvasDrawImageRect(
+    FlutterSpiPictureRecorder* recorder,
+    FlutterSpiImage* image,
+    const FlutterSpiRect* src,
+    const FlutterSpiRect* dst,
+    int32_t filter_quality,
+    const FlutterSpiPaint* paint) {
+  DisplayListBuilder* builder = nullptr;
+  sk_sp<DlImage> dl_image;
+  const FlutterSpiResult dependencies =
+      FindCanvasDependencies(recorder, image, &builder, &dl_image);
+  if (dependencies != kFlutterSpiOk) {
+    return dependencies;
+  }
+  DlRect dl_src;
+  DlRect dl_dst;
+  bool quality_ok = false;
+  const DlImageSampling sampling =
+      SpiSamplingFromFilterQuality(filter_quality, &quality_ok);
+  if (!quality_ok || src == nullptr || dst == nullptr ||
+      !ToDlRect(*src, &dl_src) || !ToDlRect(*dst, &dl_dst)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const std::optional<DlPaint> dl_paint = ToOptionalPaint(paint);
+  builder->DrawImageRect(dl_image, dl_src, dl_dst, sampling,
+                         dl_paint.has_value() ? &dl_paint.value()
+                                              : nullptr,
+                         DlSrcRectConstraint::kFast);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiCanvasDrawImageNine(
+    FlutterSpiPictureRecorder* recorder,
+    FlutterSpiImage* image,
+    const FlutterSpiRect* center,
+    const FlutterSpiRect* dst,
+    int32_t filter_quality,
+    const FlutterSpiPaint* paint) {
+  DisplayListBuilder* builder = nullptr;
+  sk_sp<DlImage> dl_image;
+  const FlutterSpiResult dependencies =
+      FindCanvasDependencies(recorder, image, &builder, &dl_image);
+  if (dependencies != kFlutterSpiOk) {
+    return dependencies;
+  }
+  DlRect dl_center;
+  DlRect dl_dst;
+  bool quality_ok = false;
+  const DlFilterMode filter =
+      SpiFilterModeFromFilterQuality(filter_quality, &quality_ok);
+  if (!quality_ok || center == nullptr || dst == nullptr ||
+      !ToDlRect(*center, &dl_center) || !ToDlRect(*dst, &dl_dst)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const std::optional<DlPaint> dl_paint = ToOptionalPaint(paint);
+  builder->DrawImageNine(dl_image, DlIRect::Round(dl_center), dl_dst, filter,
+                         dl_paint.has_value() ? &dl_paint.value() : nullptr);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiCanvasDrawAtlas(
+    FlutterSpiPictureRecorder* recorder,
+    FlutterSpiImage* image,
+    const FlutterSpiRSTransform* transforms,
+    const FlutterSpiRect* rects,
+    const FlutterSpiColor* colors,
+    size_t count,
+    int32_t blend_mode,
+    int32_t filter_quality,
+    const FlutterSpiRect* cull_rect,
+    const FlutterSpiPaint* paint) {
+  DisplayListBuilder* builder = nullptr;
+  sk_sp<DlImage> dl_image;
+  const FlutterSpiResult dependencies =
+      FindCanvasDependencies(recorder, image, &builder, &dl_image);
+  if (dependencies != kFlutterSpiOk) {
+    return dependencies;
+  }
+  bool quality_ok = false;
+  const DlImageSampling sampling =
+      SpiSamplingFromFilterQuality(filter_quality, &quality_ok);
+  if (!quality_ok || count > static_cast<size_t>(std::numeric_limits<int>::max())) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (count == 0) {
+    return kFlutterSpiOk;
+  }
+  if (transforms == nullptr || rects == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  std::vector<DlRSTransform> dl_transforms;
+  std::vector<DlRect> dl_rects;
+  dl_transforms.reserve(count);
+  dl_rects.reserve(count);
+  for (size_t index = 0; index < count; ++index) {
+    if (!IsFinite(transforms[index])) {
+      return kFlutterSpiInvalidArgument;
+    }
+    DlRect dl_rect;
+    if (!ToDlRect(rects[index], &dl_rect)) {
+      return kFlutterSpiInvalidArgument;
+    }
+    dl_transforms.emplace_back(transforms[index].scos, transforms[index].ssin,
+                               transforms[index].tx, transforms[index].ty);
+    dl_rects.push_back(dl_rect);
+  }
+
+  std::vector<DlColor> dl_colors;
+  if (colors != nullptr) {
+    dl_colors.reserve(count);
+    for (size_t index = 0; index < count; ++index) {
+      dl_colors.push_back(ToDlColor(colors[index]));
+    }
+  }
+
+  std::optional<DlRect> dl_cull_rect;
+  if (cull_rect != nullptr) {
+    DlRect converted_cull_rect;
+    if (!ToDlRect(*cull_rect, &converted_cull_rect)) {
+      return kFlutterSpiInvalidArgument;
+    }
+    dl_cull_rect = converted_cull_rect;
+  }
+  const std::optional<DlPaint> dl_paint = ToOptionalPaint(paint);
+  builder->DrawAtlas(
+      dl_image, dl_transforms.data(), dl_rects.data(),
+      colors == nullptr ? nullptr : dl_colors.data(), static_cast<int>(count),
+      static_cast<DlBlendMode>(blend_mode), sampling,
+      dl_cull_rect.has_value() ? &dl_cull_rect.value() : nullptr,
+      dl_paint.has_value() ? &dl_paint.value() : nullptr);
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
