+TEST_F(SpiImageCanvasTest, DrawAtlasMatchesDl) {
+  const auto image = MakeTestImage();
+  FlutterSpiImage* handle = WrapImage(image);
+  FlutterSpiPictureRecorder* recorder = CreateRecorder();
+  const FlutterSpiRSTransform transforms[] = {
+      {.scos = 1.0f, .ssin = 0.0f, .tx = 2.0f, .ty = 3.0f},
+      {.scos = 0.5f, .ssin = 0.5f, .tx = 4.0f, .ty = 5.0f},
+  };
+  const FlutterSpiRect rects[] = {
+      {0.0f, 0.0f, 2.0f, 3.0f},
+      {1.0f, 1.0f, 3.0f, 4.0f},
+  };
+  const FlutterSpiColor colors[] = {
+      {.red = 1.0f, .green = 0.0f, .blue = 0.0f, .alpha = 1.0f,
+       .color_space = kFlutterSpiColorSpaceSRGB},
+      {.red = 0.0f, .green = 1.0f, .blue = 0.0f, .alpha = 0.5f,
+       .color_space = kFlutterSpiColorSpaceSRGB},
+  };
+  const FlutterSpiRect cull_rect = {0.0f, 0.0f, 50.0f, 50.0f};
+  ASSERT_EQ(SpiCanvasDrawAtlas(
+                recorder, handle, transforms, rects, colors, 2,
+                kFlutterSpiBlendModeSrcOver, kFlutterSpiFilterQualityLow,
+                &cull_rect, nullptr),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiCanvasDrawAtlas(
+                recorder, handle, transforms, rects, nullptr, 2,
+                kFlutterSpiBlendModeSrcOver, kFlutterSpiFilterQualityLow,
+                nullptr, nullptr),
+            kFlutterSpiOk);
+
+  const DlColor dl_colors[] = {
+      DlColor::kRed(),
+      DlColor(0.5f, 0.0f, 1.0f, 0.0f, DlColorSpace::kSRGB),
+  };
+  DisplayListBuilder expected(DlRect::MakeLTRB(0, 0, 100, 100));
+  expected.DrawAtlas(image, reinterpret_cast<const DlRSTransform*>(transforms),
+                     reinterpret_cast<const DlRect*>(rects), dl_colors, 2,
+                     DlBlendMode::kSrcOver, DlImageSampling::kLinear,
+                     reinterpret_cast<const DlRect*>(&cull_rect));
+  expected.DrawAtlas(image, reinterpret_cast<const DlRSTransform*>(transforms),
+                     reinterpret_cast<const DlRect*>(rects), nullptr, 2,
+                     DlBlendMode::kSrcOver, DlImageSampling::kLinear, nullptr);
+  const auto expected_list = expected.Build();
+  const auto actual = Finish(recorder);
+  EXPECT_TRUE(actual->Equals(expected_list));
+  ExpectAtlasOp(actual.get(), 2);
+  EXPECT_EQ(SpiImageRelease(handle), kFlutterSpiOk);
+}
