+constexpr FlutterSpiRect kCullRect = {
+    .left = 0.0f, .top = 0.0f, .right = 100.0f, .bottom = 100.0f};
+
+sk_sp<DlImage> MakeTestImage() {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(4, 3))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(SK_ColorBLUE);
+  bitmap.setImmutable();
+  return DlImageSkia::Make(SkImages::RasterFromBitmap(bitmap));
+}
+
+class ImageOpProbe final : public IgnoreAttributeDispatchHelper,
+                           public IgnoreClipDispatchHelper,
+                           public IgnoreTransformDispatchHelper,
+                           public IgnoreDrawDispatchHelper {
+ public:
+  void drawImage(const sk_sp<DlImage>,
+                 const DlPoint&,
+                 DlImageSampling,
+                 bool) override {
+    image_count++;
+  }
+
+  void drawImageRect(const sk_sp<DlImage>,
+                     const DlRect&,
+                     const DlRect&,
+                     DlImageSampling,
+                     bool,
+                     DlSrcRectConstraint) override {
+    image_rect_count++;
+  }
+
+  void drawImageNine(const sk_sp<DlImage>,
+                     const DlIRect&,
+                     const DlRect&,
+                     DlFilterMode,
+                     bool) override {
+    image_nine_count++;
+  }
+
+  void drawAtlas(const sk_sp<DlImage>,
+                 const DlRSTransform[],
+                 const DlRect[],
+                 const DlColor[],
+                 int,
+                 DlBlendMode,
+                 DlImageSampling,
+                 const DlRect*,
+                 bool) override {
+    atlas_count++;
+  }
+
+  int image_count = 0;
+  int image_rect_count = 0;
+  int image_nine_count = 0;
+  int atlas_count = 0;
+};
+
+class SpiImageCanvasTest : public ::testing::Test {
+ protected:
+  void SetUp() override { engine_ = std::make_unique<FlutterSpiEngine>(); }
+
+  FlutterSpiPictureRecorder* CreateRecorder() {
+    FlutterSpiPictureRecorder* recorder = nullptr;
+    EXPECT_EQ(SpiSceneApi()->recorder_create(engine_.get(), &kCullRect,
+                                             &recorder),
+              kFlutterSpiOk);
+    return recorder;
+  }
+
+  FlutterSpiImage* WrapImage(const sk_sp<DlImage>& image) {
+    FlutterSpiImage* handle = nullptr;
+    EXPECT_EQ(SpiImageWrap(image, &handle), kFlutterSpiOk);
+    return handle;
+  }
+
+  sk_sp<DisplayList> Finish(FlutterSpiPictureRecorder* recorder) {
+    FlutterSpiPicture* picture = nullptr;
+    EXPECT_EQ(SpiSceneApi()->recorder_finish(recorder, &picture),
+              kFlutterSpiOk);
+    const DisplayList* display_list = SpiPictureDisplayListForTesting(picture);
+    EXPECT_NE(display_list, nullptr);
+    sk_sp<DisplayList> retained_display_list = sk_ref_sp(display_list);
+    EXPECT_EQ(SpiSceneApi()->picture_release(picture), kFlutterSpiOk);
+    return retained_display_list;
+  }
+
+  std::unique_ptr<FlutterSpiEngine> engine_;
+};
+
+void ExpectImageOp(const DisplayList* display_list, int expected_count) {
+  ImageOpProbe probe;
+  display_list->Dispatch(probe);
+  EXPECT_EQ(probe.image_count, expected_count);
+}
+
+void ExpectImageRectOp(const DisplayList* display_list, int expected_count) {
+  ImageOpProbe probe;
+  display_list->Dispatch(probe);
+  EXPECT_EQ(probe.image_rect_count, expected_count);
+}
+
+void ExpectImageNineOp(const DisplayList* display_list, int expected_count) {
+  ImageOpProbe probe;
+  display_list->Dispatch(probe);
+  EXPECT_EQ(probe.image_nine_count, expected_count);
+}
+
+void ExpectAtlasOp(const DisplayList* display_list, int expected_count) {
+  ImageOpProbe probe;
+  display_list->Dispatch(probe);
+  EXPECT_EQ(probe.atlas_count, expected_count);
+}
