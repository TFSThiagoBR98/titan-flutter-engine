+float SafeNarrow(double value) {
+  if (!std::isfinite(value)) {
+    return static_cast<float>(value);
+  }
+  return static_cast<float>(std::clamp(
+      value, static_cast<double>(std::numeric_limits<float>::lowest()),
+      static_cast<double>(std::numeric_limits<float>::max())));
+}
+
+SkMatrix ToSkMatrix(const double matrix4[16]) {
+  return SkMatrix::MakeAll(
+      SafeNarrow(matrix4[0]), SafeNarrow(matrix4[4]), SafeNarrow(matrix4[12]),
+      SafeNarrow(matrix4[1]), SafeNarrow(matrix4[5]), SafeNarrow(matrix4[13]),
+      SafeNarrow(matrix4[3]), SafeNarrow(matrix4[7]), SafeNarrow(matrix4[15]));
