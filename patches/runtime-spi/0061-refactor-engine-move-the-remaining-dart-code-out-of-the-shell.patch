+void WriteServiceProtocolDescription(
+    const FlutterSpiServiceHandler* handler,
+    const ServiceProtocolDescription& description,
+    rapidjson::Value& view,
+    rapidjson::MemoryPoolAllocator<>& allocator) {
+  std::ostringstream view_id;
+  view_id << "_flutterView/0x" << std::hex
+          << reinterpret_cast<intptr_t>(handler);
+
+  view.SetObject();
+  view.AddMember("type", "FlutterView", allocator);
+  view.AddMember("id", view_id.str(), allocator);
+  if (description.isolate_port == 0) {
+    return;
+  }
+
+  std::ostringstream isolate_id;
+  isolate_id << "isolates/" << description.isolate_port;
+  rapidjson::Value isolate(rapidjson::Type::kObjectType);
+  isolate.AddMember("type", "@Isolate", allocator);
+  isolate.AddMember("fixedId", true, allocator);
+  isolate.AddMember("id", isolate_id.str(), allocator);
+  isolate.AddMember("name", description.isolate_name, allocator);
+  isolate.AddMember("number", description.isolate_port, allocator);
+  view.AddMember("isolate", isolate, allocator);
+}
