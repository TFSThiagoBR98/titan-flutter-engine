+TEST_F(SpiConformance, PointerDispatchHonorsRuntimeCode) {
+  ThreadHost thread_host("io.flutter.test." + GetCurrentTestName() + ".",
+                         ThreadHost::Type::kPlatform);
+  auto task_runner = thread_host.platform_thread->GetTaskRunner();
+  task_runners_ = std::make_unique<TaskRunners>(
+      "test", task_runner, task_runner, task_runner, task_runner);
+  runtime_->runtime_code_running = true;
+  StartShell();
+
+  auto dispatch_pointer_packet = [&](size_t expected_event_count) {
+    fml::AutoResetWaitableEvent latch;
+    bool dispatched_synchronously = false;
+    task_runners_->GetUITaskRunner()->PostTask([&] {
+      auto packet = std::make_unique<PointerDataPacket>(1);
+      packet->SetPointerData(0, PointerData{
+                                    .change = PointerData::Change::kDown,
+                                    .view_id = kImplicitViewId,
+                                });
+      shell_->GetPlatformView()->DispatchPointerDataPacket(std::move(packet));
+      dispatched_synchronously =
+          runtime_->pointer_events_count == expected_event_count;
+      latch.Signal();
+    });
+    latch.Wait();
+    return dispatched_synchronously;
+  };
+
+  EXPECT_FALSE(dispatch_pointer_packet(1u));
+  EXPECT_EQ(runtime_->pointer_events_count, 0u);
+  FlushUi();
+  ASSERT_EQ(runtime_->pointer_events_count, 1u);
+
+  runtime_->extensions.is_running_runtime_code = nullptr;
+  EXPECT_TRUE(dispatch_pointer_packet(2u));
+  EXPECT_EQ(runtime_->pointer_events_count, 2u);
+
+  DestroyShell(std::move(shell_), *task_runners_);
+}
