# Why: preserve the legacy failed-send contract by releasing the reply context
# without calling back into the Dart VM while the native send is still active.
diff --git a/engine/src/flutter/lib/ui/window/platform_message_sender.cc b/engine/src/flutter/lib/ui/window/platform_message_sender.cc
index 210245fda31..c7ae9519024 100644
--- a/engine/src/flutter/lib/ui/window/platform_message_sender.cc
+++ b/engine/src/flutter/lib/ui/window/platform_message_sender.cc
@@ -79,8 +79,8 @@ bool PlatformMessageSender::Send(std::unique_ptr<PlatformMessage> message) {
   const FlutterSpiResult result = send_(
       sender_, message->channel().c_str(), data, message->data().GetSize(),
       context == nullptr ? nullptr : CompleteEngineReply, context);
-  if (result != kFlutterSpiOk && context != nullptr) {
-    CompleteEngineReply(context, nullptr, 0);
+  if (result != kFlutterSpiOk) {
+    std::unique_ptr<EngineReplyContext> failed_context(context);
   }
   return result == kFlutterSpiOk;
 }
