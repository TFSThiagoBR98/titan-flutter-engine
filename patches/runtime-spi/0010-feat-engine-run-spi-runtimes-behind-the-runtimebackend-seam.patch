+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/spi_scene.h"
+
+#include "flutter/flow/layers/container_layer.h"
+#include "flutter/flow/layers/layer_tree.h"
+
+FlutterSpiResult SpiSceneCreateEmpty(int64_t width_px,
+                                     int64_t height_px,
+                                     FlutterSpiScene** out_scene) {
+  if (out_scene == nullptr || width_px <= 0 || height_px <= 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  auto scene = std::make_unique<FlutterSpiScene>();
+  scene->width_px = width_px;
+  scene->height_px = height_px;
+  scene->layer_tree = std::make_unique<flutter::LayerTree>(
+      std::make_shared<flutter::ContainerLayer>(),
+      flutter::DlISize(static_cast<int32_t>(width_px),
+                       static_cast<int32_t>(height_px)));
+  *out_scene = scene.release();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiSceneRelease(FlutterSpiScene* scene) {
+  delete scene;
+  return kFlutterSpiOk;
+}
