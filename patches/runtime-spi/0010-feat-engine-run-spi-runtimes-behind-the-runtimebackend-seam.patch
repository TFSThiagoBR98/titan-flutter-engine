+class SpiEngineResponse final : public PlatformMessageResponse {
+ public:
+  SpiEngineResponse(fml::RefPtr<fml::TaskRunner> ui_task_runner,
+                    void (*on_reply)(void*, const uint8_t*, size_t),
+                    void* user_data)
+      : ui_task_runner_(std::move(ui_task_runner)),
+        on_reply_(on_reply),
+        user_data_(user_data) {}
+
+  void Complete(std::unique_ptr<fml::Mapping> data) override {
+    std::vector<uint8_t> bytes;
+    if (data != nullptr && data->GetSize() != 0) {
+      bytes.assign(data->GetMapping(),
+                   data->GetMapping() + data->GetSize());
+    }
+    CompleteOnUi(std::move(bytes));
+  }
+
+  void CompleteEmpty() override { CompleteOnUi({}); }
+
+ private:
+  void CompleteOnUi(std::vector<uint8_t> data) {
+    if (completed_.exchange(true)) {
+      return;
+    }
+    auto callback = [on_reply = on_reply_, user_data = user_data_,
+                     data = std::move(data)]() {
+      if (on_reply != nullptr) {
+        on_reply(user_data, data.data(), data.size());
+      }
+    };
+    fml::TaskRunner::RunNowOrPostTask(ui_task_runner_, callback);
+  }
+
+  fml::RefPtr<fml::TaskRunner> ui_task_runner_;
+  void (*on_reply_)(void*, const uint8_t*, size_t) = nullptr;
+  void* user_data_ = nullptr;
+  std::atomic_bool completed_ = false;
+};
