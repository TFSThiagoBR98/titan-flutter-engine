+bool SpiRuntimeBackend::SetViewportMetrics(int64_t view_id,
+                                           const ViewportMetrics& metrics) {
+  FlutterSpiViewMetrics spi_metrics = ConvertMetrics(view_id, metrics);
+  views_[view_id] = spi_metrics;
+  if (table_.set_view_metrics != nullptr) {
+    table_.set_view_metrics(table_.user_data, &spi_metrics);
+  }
+  return true;
+}
