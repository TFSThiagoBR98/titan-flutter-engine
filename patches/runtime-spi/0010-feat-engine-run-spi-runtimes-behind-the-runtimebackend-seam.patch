+  return nullptr;
+}
+
+bool SpiRuntimeBackend::HasUiThread() const {
+  return static_cast<bool>(task_runners_.GetUITaskRunner()) &&
+         task_runners_.GetUITaskRunner()->RunsTasksOnCurrentThread();
+}
+
+bool SpiRuntimeBackend::HasCapability(
+    FlutterSpiCapabilities capability) const {
+  return (engine_api_.capabilities & capability) != 0;
+}
+
+bool SpiRuntimeBackend::IsTableCompatible() const {
+  return table_.struct_size >= kMinimumRuntimeTableSize &&
+         table_.start != nullptr && table_.stop != nullptr &&
+         table_.destroy != nullptr;
+}
+
+bool SpiRuntimeBackend::IsCallbackAvailable(size_t offset, size_t size) const {
+  return table_.struct_size >= offset + size;
+}
+
+SpiRuntimeBackend* SpiRuntimeBackend::FindBackendForResponse(
+    FlutterSpiResponseHandle* response) {
+  if (response == nullptr) {
+    return nullptr;
+  }
+  for (SpiRuntimeBackend* backend : live_backends_) {
+    if (backend->response_handles_.find(response) !=
+        backend->response_handles_.end()) {
+      return backend;
+    }
+  }
+  return nullptr;
+}
+
+void SpiRuntimeBackend::CompletePendingResponses() {
+  for (FlutterSpiResponseHandle* handle : response_handles_) {
+    if (handle->response) {
+      handle->response->CompleteEmpty();
+    }
+    delete handle;
+  }
+  response_handles_.clear();
+}
+
+bool SpiRuntimeBackend::DispatchKeyDataMessage(
+    const PlatformMessage& message) {
+  bool handled = false;
+  const fml::Mapping& mapping = message.data();
+  const size_t minimum_size = kKeyDataCharacterSize + sizeof(KeyData);
+  if (mapping.GetSize() >= minimum_size) {
+    uint64_t character_size = 0;
+    KeyData key_data;
+    std::memcpy(&character_size, mapping.GetMapping(), sizeof(character_size));
+    std::memcpy(&key_data, mapping.GetMapping() + kKeyDataCharacterSize,
+                sizeof(key_data));
+    const size_t remaining_size = mapping.GetSize() - minimum_size;
+    if (character_size <= remaining_size &&
+        character_size < std::numeric_limits<size_t>::max()) {
+      std::string character(
+          reinterpret_cast<const char*>(mapping.GetMapping() + minimum_size),
+          static_cast<size_t>(character_size));
+      character.push_back('\0');
+      FlutterSpiKeyEvent event = {
+          .struct_size = sizeof(FlutterSpiKeyEvent),
+          .timestamp_us = key_data.timestamp,
+          .type = static_cast<int32_t>(key_data.type),
+          .device_type = static_cast<int32_t>(key_data.device_type),
+          .physical = key_data.physical,
+          .logical = key_data.logical,
+          .character = character.c_str(),
+          .synthesized = key_data.synthesized != 0,
+      };
+      if (IsCallbackAvailable(offsetof(FlutterSpiRuntimeTable, key_event),
+                              sizeof(table_.key_event)) &&
+          table_.key_event != nullptr) {
+        handled = table_.key_event(table_.user_data, &event);
+      }
+    }
+  }
+  SendKeyDataResponse(message.response(), handled);
+  return true;
+}
+
+bool SpiRuntimeBackend::DispatchRegularPlatformMessage(
+    std::unique_ptr<PlatformMessage> message) {
+  if (table_.platform_message == nullptr) {
+    return true;
+  }
+  FlutterSpiResponseHandle* handle = nullptr;
+  if (message->response()) {
+    handle = new FlutterSpiResponseHandle{
+        .backend = this,
+        .response = message->response(),
+    };
+    response_handles_.insert(handle);
+  }
+  FlutterSpiPlatformMessage spi_message = {
+      .struct_size = sizeof(FlutterSpiPlatformMessage),
+      .channel = message->channel().c_str(),
+      .data = message->data().GetMapping(),
+      .data_size = message->data().GetSize(),
+      .response = handle,
+  };
+  table_.platform_message(table_.user_data, &spi_message);
+  return true;
+}
+
+void SpiRuntimeBackend::SendKeyDataResponse(
+    const fml::RefPtr<PlatformMessageResponse>& response,
+    bool handled) const {
+  if (!response) {
+    return;
+  }
+  const uint8_t result = handled ? 1 : 0;
+  response->Complete(std::make_unique<fml::MallocMapping>(
+      fml::MallocMapping::Copy(&result, sizeof(result))));
+}
+
+FlutterSpiResult SpiRuntimeBackend::RequestFrame() {
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  runtime_delegate_.ScheduleFrame();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiRuntimeBackend::SubmitFrame(int64_t view_id,
+                                                uint64_t frame_token,
+                                                FlutterSpiScene* scene,
+                                                double device_pixel_ratio) {
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  if (scene == nullptr || frame_token != current_frame_token_ ||
+      views_.find(view_id) == views_.end()) {
+    SpiSceneRelease(scene);
+    return kFlutterSpiStaleFrame;
+  }
+  std::unique_ptr<LayerTree> layer_tree = std::move(scene->layer_tree);
+  SpiSceneRelease(scene);
+  runtime_delegate_.Render(view_id, std::move(layer_tree),
+                           static_cast<float>(device_pixel_ratio));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiRuntimeBackend::FramesDone() {
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  runtime_delegate_.OnAllViewsRendered();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiRuntimeBackend::SendPlatformMessage(
+    const char* channel,
+    const uint8_t* data,
+    size_t data_size,
+    void (*on_reply)(void* user_data, const uint8_t* data, size_t size),
+    void* reply_user_data) {
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  if (channel == nullptr || (data == nullptr && data_size != 0)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  fml::RefPtr<PlatformMessageResponse> response;
+  if (on_reply != nullptr) {
+    response = fml::AdoptRef(new SpiEngineResponse(
+        task_runners_.GetUITaskRunner(), on_reply, reply_user_data));
+  }
+  auto message = std::make_unique<PlatformMessage>(
+      channel, fml::MallocMapping::Copy(data, data_size), response);
+  runtime_delegate_.HandlePlatformMessage(std::move(message));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiRuntimeBackend::Respond(FlutterSpiResponseHandle* response,
+                                            const uint8_t* data,
+                                            size_t data_size) {
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  if (response_handles_.find(response) == response_handles_.end()) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (data == nullptr && data_size != 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (response->response) {
+    if (data_size == 0) {
+      response->response->CompleteEmpty();
+    } else {
+      response->response->Complete(std::make_unique<fml::MallocMapping>(
+          fml::MallocMapping::Copy(data, data_size)));
+    }
+  }
+  response_handles_.erase(response);
+  delete response;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiRuntimeBackend::PostTask(void (*task)(void* user_data),
+                                             void* user_data,
+                                             int64_t delay_ns) {
+  if (task == nullptr || !task_runners_.GetUITaskRunner()) {
+    return kFlutterSpiInvalidArgument;
+  }
+  task_runners_.GetUITaskRunner()->PostDelayedTask(
+      [task, user_data]() { task(user_data); },
+      fml::TimeDelta::FromNanoseconds(delay_ns));
+  return kFlutterSpiOk;
+}
+
+int64_t SpiRuntimeBackend::NowNs() const {
+  return fml::TimePoint::Now().ToEpochDelta().ToNanoseconds();
+}
+
+void SpiRuntimeBackend::Log(int32_t level,
+                            const char* tag,
+                            const char* message) const {
+  (void)level;
+  FML_LOG(INFO) << (tag == nullptr ? "runtime-spi" : tag) << ": "
+                << (message == nullptr ? "" : message);
+}
+
+FlutterSpiResult SpiRuntimeBackend::ReportError(const char* message) {
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  FML_LOG(ERROR) << (message == nullptr ? "Runtime SPI error" : message);
+  running_ = false;
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
