+std::unordered_set<SpiRuntimeBackend*> SpiRuntimeBackend::live_backends_;
+
+SpiRuntimeBackend::SpiRuntimeBackend(
+    RuntimeDelegate& runtime_delegate,
+    const TaskRunners& task_runners,
+    const FlutterSpiRuntimeTable& table)
+    : runtime_delegate_(runtime_delegate),
+      task_runners_(task_runners),
+      table_(table),
+      engine_api_(SpiEngineApi::Create()),
+      engine_handle_(new FlutterSpiEngine{this}) {
+  live_backends_.insert(this);
+}
+
+SpiRuntimeBackend::~SpiRuntimeBackend() {
+  if (started_ && table_.stop != nullptr) {
+    table_.stop(table_.user_data);
+  }
+  CompletePendingResponses();
+  live_backends_.erase(this);
+  if (table_.destroy != nullptr) {
+    table_.destroy(table_.user_data);
+  }
+  delete engine_handle_;
+}
+
+std::unique_ptr<RuntimeBackend> SpiRuntimeBackend::Clone() const {
+  return nullptr;
+}
+
+bool SpiRuntimeBackend::Launch(
+    RunConfiguration&& configuration,
+    const Settings& settings,
+    const fml::closure& root_isolate_create_callback,
+    std::optional<int64_t> engine_id) {
+  (void)configuration;
+  (void)settings;
+  (void)root_isolate_create_callback;
+  (void)engine_id;
+  if (!IsTableCompatible()) {
+    FML_LOG(ERROR) << "Runtime SPI table is incompatible";
+    return false;
+  }
+  if (table_.version_major != FLUTTER_SPI_VERSION_MAJOR ||
+      table_.version_minor < FLUTTER_SPI_VERSION_MINOR ||
+      (table_.required_capabilities & ~engine_api_.capabilities) != 0) {
+    FML_LOG(ERROR) << "Runtime SPI version or capabilities are incompatible";
+    return false;
+  }
+  const FlutterSpiResult result =
+      table_.start(table_.user_data, &engine_api_, engine_handle_);
+  started_ = result == kFlutterSpiOk;
+  running_ = started_;
+  return started_;
+}
+
+void SpiRuntimeBackend::AddView(int64_t view_id,
+                                const ViewportMetrics& view_metrics,
+                                AddViewCallback callback) {
+  FlutterSpiViewMetrics metrics = ConvertMetrics(view_id, view_metrics);
+  views_[view_id] = metrics;
+  if (table_.add_view != nullptr) {
+    table_.add_view(table_.user_data, &metrics);
+  }
+  if (callback != nullptr) {
+    callback(true);
+  }
+}
+
+bool SpiRuntimeBackend::RemoveView(int64_t view_id) {
+  views_.erase(view_id);
+  if (table_.remove_view != nullptr) {
+    table_.remove_view(table_.user_data, view_id);
+  }
+  return true;
+}
