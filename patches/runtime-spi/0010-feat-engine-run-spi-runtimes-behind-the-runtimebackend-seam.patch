+FlutterSpiEngineApi SpiEngineApi::Create() {
+  return {
+      .struct_size = sizeof(FlutterSpiEngineApi),
+      .version_major = FLUTTER_SPI_VERSION_MAJOR,
+      .version_minor = FLUTTER_SPI_VERSION_MINOR,
+      .capabilities = kFlutterSpiCapTasks | kFlutterSpiCapPlatformMessages |
+                      kFlutterSpiCapPointerEvents | kFlutterSpiCapKeyEvents |
+                      kFlutterSpiCapSemantics | kFlutterSpiCapViewFocus |
+                      kFlutterSpiCapEmptyScene,
+      .request_frame = RequestFrame,
+      .scene_create_empty = SceneCreateEmpty,
+      .scene_release = SceneRelease,
+      .submit_frame = SubmitFrame,
+      .frames_done = FramesDone,
+      .send_platform_message = SendPlatformMessage,
+      .respond = Respond,
+      .post_task = PostTask,
+      .now_ns = NowNs,
+      .log = Log,
+      .report_error = ReportError,
+  };
+}
+
+FlutterSpiResult SpiEngineApi::RequestFrame(FlutterSpiEngine* engine) {
+  return engine == nullptr ? kFlutterSpiInvalidArgument
+                           : engine->backend->RequestFrame();
+}
+
+FlutterSpiResult SpiEngineApi::SceneCreateEmpty(FlutterSpiEngine* engine,
+                                                int64_t width_px,
+                                                int64_t height_px,
+                                                FlutterSpiScene** out_scene) {
+  if (engine == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return SpiSceneCreateEmpty(width_px, height_px, out_scene);
+}
+
+FlutterSpiResult SpiEngineApi::SceneRelease(FlutterSpiScene* scene) {
+  return scene == nullptr ? kFlutterSpiInvalidArgument
+                          : SpiSceneRelease(scene);
+}
+
+FlutterSpiResult SpiEngineApi::SubmitFrame(FlutterSpiEngine* engine,
+                                           int64_t view_id,
+                                           uint64_t frame_token,
+                                           FlutterSpiScene* scene,
+                                           double device_pixel_ratio) {
+  if (engine == nullptr) {
+    SpiSceneRelease(scene);
+    return kFlutterSpiInvalidArgument;
+  }
+  return engine->backend->SubmitFrame(view_id, frame_token, scene,
+                                      device_pixel_ratio);
+}
+
+FlutterSpiResult SpiEngineApi::FramesDone(FlutterSpiEngine* engine) {
+  return engine == nullptr ? kFlutterSpiInvalidArgument
+                           : engine->backend->FramesDone();
+}
+
+FlutterSpiResult SpiEngineApi::SendPlatformMessage(
+    FlutterSpiEngine* engine,
+    const char* channel,
+    const uint8_t* data,
+    size_t data_size,
+    void (*on_reply)(void* user_data, const uint8_t* data, size_t size),
+    void* reply_user_data) {
+  if (engine == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return engine->backend->SendPlatformMessage(channel, data, data_size,
+                                              on_reply, reply_user_data);
+}
+
+FlutterSpiResult SpiEngineApi::Respond(FlutterSpiResponseHandle* response,
+                                       const uint8_t* data,
+                                       size_t data_size) {
+  SpiRuntimeBackend* backend =
+      SpiRuntimeBackend::FindBackendForResponse(response);
+  if (backend == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return backend->Respond(response, data, data_size);
+}
+
+FlutterSpiResult SpiEngineApi::PostTask(FlutterSpiEngine* engine,
+                                        void (*task)(void* user_data),
+                                        void* user_data,
+                                        int64_t delay_ns) {
+  if (engine == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return engine->backend->PostTask(task, user_data, delay_ns);
+}
+
+int64_t SpiEngineApi::NowNs(FlutterSpiEngine* engine) {
+  return engine == nullptr ? 0 : engine->backend->NowNs();
+}
+
+void SpiEngineApi::Log(FlutterSpiEngine* engine,
+                       int32_t level,
+                       const char* tag,
+                       const char* message) {
+  if (engine != nullptr) {
+    engine->backend->Log(level, tag, message);
+  }
+}
+
+FlutterSpiResult SpiEngineApi::ReportError(FlutterSpiEngine* engine,
+                                           const char* message) {
+  return engine == nullptr ? kFlutterSpiInvalidArgument
+                           : engine->backend->ReportError(message);
+}
+
+}  // namespace flutter
