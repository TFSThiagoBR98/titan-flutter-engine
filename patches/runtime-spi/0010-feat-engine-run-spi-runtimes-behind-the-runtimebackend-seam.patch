+bool SpiRuntimeBackend::BeginFrame(fml::TimePoint frame_time,
+                                   uint64_t frame_number) {
+  if (table_.begin_frame == nullptr) {
+    return true;
+  }
+  FlutterSpiFrameInfo frame_info = {
+      .struct_size = sizeof(FlutterSpiFrameInfo),
+      .frame_token = ++current_frame_token_,
+      .frame_number = frame_number,
+      .frame_start_ns = 0,
+      .deadline_ns = frame_time.ToEpochDelta().ToNanoseconds(),
+  };
+  current_frame_deadline_ns_ = frame_info.deadline_ns;
+  table_.begin_frame(table_.user_data, &frame_info);
+  return true;
+}
+
+bool SpiRuntimeBackend::DispatchPlatformMessage(
+    std::unique_ptr<PlatformMessage> message) {
+  if (message == nullptr) {
+    return false;
+  }
+  if (message->channel() == kKeyDataChannel) {
+    return DispatchKeyDataMessage(*message);
+  }
+  return DispatchRegularPlatformMessage(std::move(message));
+}
+
+bool SpiRuntimeBackend::DispatchPointerDataPacket(
+    const PointerDataPacket& packet) {
+  if (table_.pointer_events == nullptr) {
+    return true;
+  }
+  std::vector<FlutterSpiPointerEvent> events;
+  events.reserve(packet.GetLength());
+  for (size_t index = 0; index < packet.GetLength(); index++) {
+    const PointerData data = packet.GetPointerData(index);
+    events.push_back({
+        .struct_size = sizeof(FlutterSpiPointerEvent),
+        .view_id = data.view_id,
+        .timestamp_us = data.time_stamp,
+        .change = static_cast<int32_t>(data.change),
+        .device_kind = static_cast<int32_t>(data.kind),
+        .device = data.device,
+        .pointer_id = data.pointer_identifier,
+        .physical_x = data.physical_x,
+        .physical_y = data.physical_y,
+        .buttons = data.buttons,
+        .scroll_delta_x = data.scroll_delta_x,
+        .scroll_delta_y = data.scroll_delta_y,
+        .pressure = data.pressure,
+    });
+  }
+  table_.pointer_events(table_.user_data, events.data(), events.size());
+  return true;
+}
