+FlutterSpiViewMetrics ConvertMetrics(int64_t view_id,
+                                     const ViewportMetrics& metrics) {
+  return {
+      .struct_size = sizeof(FlutterSpiViewMetrics),
+      .view_id = view_id,
+      .device_pixel_ratio = metrics.device_pixel_ratio,
