+  std::unique_ptr<SpiRuntimeBackend> CreateBackend(
+      FlutterSpiRuntimeTable table) {
+    return std::make_unique<SpiRuntimeBackend>(delegate, *task_runners, table);
+  }
+
+  void LaunchBackend(SpiRuntimeBackend* backend) {
+    Settings settings;
+    EXPECT_TRUE(backend->Launch(RunConfiguration(nullptr), settings, {}, 1));
+  }
+
+  FakeRuntimeDelegate delegate;
+  std::unique_ptr<TaskRunners> task_runners;
+  CTestRuntime* runtime = nullptr;
+};
+
+TEST_F(SpiRuntimeBackendTest, RejectsMajorVersionMismatch) {
+  auto table = c_test_runtime_table(runtime);
+  table.version_major++;
+  auto backend = CreateBackend(table);
+
+  Settings settings;
+  EXPECT_FALSE(backend->Launch(RunConfiguration(nullptr), settings, {}, 1));
+  EXPECT_EQ(runtime->start_count, 0u);
+}
+
+TEST_F(SpiRuntimeBackendTest, RejectsMissingRequiredCallback) {
+  auto table = c_test_runtime_table(runtime);
+  table.start = nullptr;
+  auto backend = CreateBackend(table);
+
+  Settings settings;
+  EXPECT_FALSE(backend->Launch(RunConfiguration(nullptr), settings, {}, 1));
+  EXPECT_EQ(runtime->start_count, 0u);
+}
+
+TEST_F(SpiRuntimeBackendTest, RejectsUnannouncedCapability) {
+  auto table = c_test_runtime_table(runtime);
+  table.required_capabilities = 1ULL << 63;
+  auto backend = CreateBackend(table);
+
+  Settings settings;
+  EXPECT_FALSE(backend->Launch(RunConfiguration(nullptr), settings, {}, 1));
+  EXPECT_EQ(runtime->start_count, 0u);
+}
+
+TEST_F(SpiRuntimeBackendTest, StartFailureLeavesBackendStopped) {
+  runtime->fail_start = true;
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+
+  Settings settings;
+  EXPECT_FALSE(backend->Launch(RunConfiguration(nullptr), settings, {}, 1));
+  EXPECT_FALSE(backend->IsRunning());
+  EXPECT_EQ(runtime->start_count, 1u);
+}
+
+TEST_F(SpiRuntimeBackendTest, BeginFrameCarriesIncreasingTokens) {
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+
+  EXPECT_TRUE(backend->BeginFrame(fml::TimePoint::FromTicks(100), 7));
+  const uint64_t first_token = runtime->last_frame_info.frame_token;
+  EXPECT_TRUE(backend->BeginFrame(fml::TimePoint::FromTicks(200), 8));
+
+  EXPECT_GT(runtime->last_frame_info.frame_token, first_token);
+  EXPECT_EQ(runtime->last_frame_info.deadline_ns, 200);
+}
+
+TEST_F(SpiRuntimeBackendTest, SubmitWithStaleTokenIsRejectedAndReleasesScene) {
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+  EXPECT_TRUE(backend->BeginFrame(fml::TimePoint::FromTicks(100), 7));
+
+  FlutterSpiScene* scene = nullptr;
+  ASSERT_EQ(runtime->engine_api->scene_create_empty(runtime->engine, 10, 10,
+                                                     &scene),
+            kFlutterSpiOk);
+  EXPECT_EQ(runtime->engine_api->submit_frame(runtime->engine, 1,
+                                               runtime->last_frame_info.frame_token - 1,
+                                               scene, 1.0),
+            kFlutterSpiStaleFrame);
+}
+
+TEST_F(SpiRuntimeBackendTest, CallsFromOtherThreadsAreRejected) {
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+  std::atomic<FlutterSpiResult> result{kFlutterSpiInternalError};
+
+  std::thread worker([&] {
+    result = runtime->engine_api->request_frame(runtime->engine);
+  });
+  worker.join();
+
+  EXPECT_EQ(result.load(), kFlutterSpiWrongThread);
+}
+
+TEST_F(SpiRuntimeBackendTest, RespondTwiceIsInvalidHandle) {
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+  runtime->respond_to_messages = false;
+  auto response = fml::AdoptRef(new TestPlatformMessageResponse());
+  auto message = std::make_unique<PlatformMessage>(
+      "test", fml::MallocMapping::Copy("payload", 7), response);
+
+  ASSERT_TRUE(backend->DispatchPlatformMessage(std::move(message)));
+  ASSERT_NE(runtime->pending_response, nullptr);
+  EXPECT_EQ(runtime->engine_api->respond(runtime->pending_response, nullptr, 0),
+            kFlutterSpiOk);
+  EXPECT_EQ(runtime->engine_api->respond(runtime->pending_response, nullptr, 0),
+            kFlutterSpiInvalidHandle);
+}
+
+}  // namespace
+}  // namespace flutter::testing
