+SpiRuntimeBackendFactory::SpiRuntimeBackendFactory(
+    const FlutterSpiRuntimeTable& table)
+    : table_(table),
+      valid_(table.struct_size >=
+                 offsetof(FlutterSpiRuntimeTable, destroy) +
+                     sizeof(void (*)(void*)) &&
+             table.start != nullptr && table.stop != nullptr &&
+             table.destroy != nullptr) {
+  if (!valid_) {
+    FML_LOG(ERROR) << "Runtime SPI table is missing required callbacks";
+  }
+}
+
+SpiRuntimeBackendFactory::~SpiRuntimeBackendFactory() = default;
+
+std::unique_ptr<RuntimeBackend> SpiRuntimeBackendFactory::Create(
+    RuntimeDelegate& runtime_delegate,
+    const TaskRunners& task_runners,
+    const PlatformData& platform_data,
+    const Settings& settings,
+    fml::WeakPtr<IOManager> io_manager,
+    fml::RefPtr<SkiaUnrefQueue> unref_queue,
+    fml::TaskRunnerAffineWeakPtr<SnapshotDelegate> snapshot_delegate,
+    fml::TaskRunnerAffineWeakPtr<ImageDecoder> image_decoder,
+    fml::TaskRunnerAffineWeakPtr<ImageGeneratorRegistry>
+        image_generator_registry,
+    const std::shared_future<impeller::RuntimeStageBackend>&
+        runtime_stage_backend) {
+  (void)platform_data;
+  (void)settings;
+  (void)io_manager;
+  (void)unref_queue;
+  (void)snapshot_delegate;
+  (void)image_decoder;
+  (void)image_generator_registry;
+  (void)runtime_stage_backend;
+  if (!valid_) {
+    return nullptr;
+  }
+  return std::make_unique<SpiRuntimeBackend>(runtime_delegate, task_runners,
+                                             table_);
+}
+
