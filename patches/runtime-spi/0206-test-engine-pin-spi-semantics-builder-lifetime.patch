+TEST_F(SpiRuntimeBackendSemantics, ReleaseAfterBackendDestroyedSucceeds) {
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+
+  ASSERT_NE(runtime->engine_api, nullptr);
+  ASSERT_NE(runtime->engine_api->semantics, nullptr);
+  const FlutterSpiSemanticsApi* api = runtime->engine_api->semantics;
+  FlutterSpiSemanticsUpdateBuilder* builder = nullptr;
+  ASSERT_EQ(api->update_builder_create(runtime->engine, &builder),
+            kFlutterSpiOk);
+
+  backend.reset();
+
+  ASSERT_EQ(api->update_builder_release(builder), kFlutterSpiOk);
+}
+
+TEST_F(SpiRuntimeBackendSemantics, OrphanBuilderRejectsUpdates) {
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+
+  ASSERT_NE(runtime->engine_api, nullptr);
+  ASSERT_NE(runtime->engine_api->semantics, nullptr);
+  const FlutterSpiSemanticsApi* api = runtime->engine_api->semantics;
+  FlutterSpiSemanticsUpdateBuilder* builder = nullptr;
+  ASSERT_EQ(api->update_builder_create(runtime->engine, &builder),
+            kFlutterSpiOk);
+
+  backend.reset();
+
+  FlutterSpiSemanticsNode node = {};
+  node.struct_size = sizeof(FlutterSpiSemanticsNode);
+  node.id = 7;
+  node.label.text = "orphan";
+  EXPECT_EQ(api->update_node(builder, &node), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(api->update_submit(builder, 42), kFlutterSpiInvalidHandle);
+  api->update_builder_release(builder);
+}
+
+TEST_F(SpiRuntimeBackendSemantics, SecondSubmitIsRejected) {
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+
+  ASSERT_NE(runtime->engine_api, nullptr);
+  ASSERT_NE(runtime->engine_api->semantics, nullptr);
+  const FlutterSpiSemanticsApi* api = runtime->engine_api->semantics;
+  FlutterSpiSemanticsUpdateBuilder* builder = nullptr;
+  ASSERT_EQ(api->update_builder_create(runtime->engine, &builder),
+            kFlutterSpiOk);
+
+  EXPECT_EQ(api->update_submit(builder, 42), kFlutterSpiOk);
+  EXPECT_EQ(api->update_submit(builder, 42), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(delegate.semantics_update_count, 1u);
+  EXPECT_EQ(api->update_builder_release(builder), kFlutterSpiOk);
+}
