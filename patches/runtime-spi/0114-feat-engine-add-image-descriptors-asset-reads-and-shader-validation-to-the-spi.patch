+struct AssetReadCapture {
+  bool called = false;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  std::vector<uint8_t> bytes;
+  std::thread::id callback_thread_id;
+};
+
+void CaptureAssetRead(void* user_data,
+                      FlutterSpiResult result,
+                      const uint8_t* bytes,
+                      size_t size) {
+  auto* capture = static_cast<AssetReadCapture*>(user_data);
+  capture->called = true;
+  capture->result = result;
+  capture->callback_thread_id = std::this_thread::get_id();
+  if (bytes != nullptr) {
+    capture->bytes.assign(bytes, bytes + size);
+  }
+}
+
+class WorkerCheckingAssetResolver final : public AssetResolver {
+ public:
+  explicit WorkerCheckingAssetResolver(std::thread::id ui_thread_id)
+      : ui_thread_id_(ui_thread_id) {}
+
+  bool IsValid() const override { return true; }
+
+  bool IsValidAfterAssetManagerChange() const override { return true; }
+
+  AssetResolverType GetType() const override {
+    return AssetResolverType::kApkAssetProvider;
+  }
+
+  std::unique_ptr<fml::Mapping> GetAsMapping(
+      const std::string& asset_name) const override {
+    mapping_requests.push_back(asset_name);
+    called_on_worker = std::this_thread::get_id() != ui_thread_id_;
+    request_latch_.Signal();
+    return std::make_unique<fml::DataMapping>("asset-data");
+  }
+
+  bool operator==(const AssetResolver& other) const override {
+    return this == &other;
+  }
+
+  void WaitForRequest() { request_latch_.Wait(); }
+
+  mutable std::vector<std::string> mapping_requests;
+  mutable bool called_on_worker = false;
+
+ private:
+  std::thread::id ui_thread_id_;
+  mutable fml::AutoResetWaitableEvent request_latch_;
+};
+
+void RunPendingTasks() {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  fml::MessageLoop::GetCurrent().RunExpiredTasksNow();
+#pragma clang diagnostic pop
+}
