+FlutterSpiResult SpiRuntimeBackend::ReadAsset(
+    const char* name,
+    FlutterSpiBytesCallback callback,
+    void* user_data) {
+  if (stop_requested_) {
+    return kFlutterSpiInternalError;
+  }
+  if (!HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  if (name == nullptr || callback == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const std::shared_ptr<AssetManager> asset_manager =
+      runtime_delegate_.GetAssetManager();
+  auto post_result = [ui_task_runner = task_runners_.GetUITaskRunner(),
+                      callback, user_data](FlutterSpiResult result,
+                                           std::vector<uint8_t> bytes) {
+    ui_task_runner->PostTask([callback, user_data, result,
+                              bytes = std::move(bytes)]() mutable {
+      const uint8_t* data = result == kFlutterSpiOk ? bytes.data() : nullptr;
+      callback(user_data, result, data, bytes.size());
+    });
+  };
+  if (asset_manager == nullptr) {
+    post_result(kFlutterSpiInternalError, {});
+    return kFlutterSpiOk;
+  }
+
+  const std::string asset_name(name);
+  auto read_asset = [asset_manager, asset_name, post_result]() mutable {
+    std::unique_ptr<fml::Mapping> mapping =
+        asset_manager->GetAsMapping(asset_name);
+    if (mapping == nullptr) {
+      post_result(kFlutterSpiInvalidArgument, {});
+      return;
+    }
+    std::vector<uint8_t> bytes(mapping->GetMapping(),
+                               mapping->GetMapping() + mapping->GetSize());
+    post_result(kFlutterSpiOk, std::move(bytes));
+  };
+  if (concurrent_worker_task_runner_ != nullptr) {
+    concurrent_worker_task_runner_->PostTask(std::move(read_asset));
+  } else {
+    read_asset();
+  }
+  return kFlutterSpiOk;
+}
