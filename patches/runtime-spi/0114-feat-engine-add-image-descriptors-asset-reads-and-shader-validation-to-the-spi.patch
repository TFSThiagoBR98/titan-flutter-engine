+FlutterSpiResult SpiImageDecoding::CreateEncodedDescriptor(
+    const uint8_t* data,
+    size_t size,
+    const TaskRunners& task_runners,
+    FlutterSpiImageDescriptorCallback callback,
+    void* user_data) {
+  if (callback == nullptr || data == nullptr || size == 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!registry_) {
+    PostDescriptorResult(callback, user_data, kFlutterSpiInternalError, nullptr);
+    return kFlutterSpiOk;
+  }
+  auto data_descriptor = ImageDescriptorData::MakeEncoded(
+      SkData::MakeWithCopy(data, size), *registry_);
+  if (data_descriptor == nullptr) {
+    PostDescriptorResult(callback, user_data, kFlutterSpiInvalidArgument,
+                         nullptr);
+    return kFlutterSpiOk;
+  }
+  auto* descriptor = new (std::nothrow) FlutterSpiImageDescriptor{
+      .data = std::move(data_descriptor),
+      .image_decoding = this,
+      .task_runners = task_runners,
+  };
+  if (descriptor == nullptr) {
+    PostDescriptorResult(callback, user_data, kFlutterSpiInternalError, nullptr);
+    return kFlutterSpiOk;
+  }
+  PostDescriptorResult(callback, user_data, kFlutterSpiOk, descriptor);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiImageDecoding::CreateRawDescriptor(
+    const FlutterSpiPixels* pixels,
+    const TaskRunners& task_runners,
+    FlutterSpiImageDescriptor** out) {
+  if (pixels == nullptr || pixels->pixels == nullptr || out == nullptr ||
+      pixels->width <= 0 || pixels->height <= 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out = nullptr;
+  PixelFormatInfo format_info;
+  if (!GetPixelFormatInfo(pixels->pixel_format, &format_info)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t minimum_row_bytes =
+      static_cast<size_t>(pixels->width) * format_info.bytes_per_pixel;
+  const size_t row_bytes = pixels->row_bytes == 0
+                               ? minimum_row_bytes
+                               : static_cast<size_t>(pixels->row_bytes);
+  if (row_bytes < minimum_row_bytes ||
+      row_bytes > std::numeric_limits<size_t>::max() /
+                       static_cast<size_t>(pixels->height)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto data_descriptor = ImageDescriptorData::MakeRaw(
+      SkData::MakeWithCopy(pixels->pixels, pixels->pixels_size), pixels->width,
+      pixels->height, row_bytes, format_info.format);
+  auto* descriptor = new (std::nothrow) FlutterSpiImageDescriptor{
+      .data = std::move(data_descriptor),
+      .image_decoding = this,
+      .task_runners = task_runners,
+  };
+  if (descriptor == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  *out = descriptor;
+  return kFlutterSpiOk;
+}
