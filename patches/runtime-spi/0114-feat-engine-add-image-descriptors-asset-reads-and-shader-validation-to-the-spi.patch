+TEST_F(SpiRuntimeBackendTest, SpiAsset_ReadsOnTheConcurrentWorker) {
+  auto* runtime = c_test_runtime_create();
+  auto factory = std::make_shared<SpiRuntimeBackendFactory>(
+      c_test_runtime_table(runtime));
+  auto worker_runner = factory->GetConcurrentWorkerTaskRunner();
+  ASSERT_NE(worker_runner, nullptr);
+
+  delegate.asset_manager = std::make_shared<AssetManager>();
+  auto resolver = std::make_unique<WorkerCheckingAssetResolver>(
+      std::this_thread::get_id());
+  auto* resolver_pointer = resolver.get();
+  ASSERT_TRUE(delegate.asset_manager->PushBack(std::move(resolver)));
+
+  Settings settings;
+  auto backend = factory->Create(
+      delegate, *task_runners, PlatformData{}, settings,
+      fml::WeakPtr<IOManager>(), nullptr, {}, {}, {}, {}, {});
+  ASSERT_NE(backend, nullptr);
+  LaunchBackend(static_cast<SpiRuntimeBackend*>(backend.get()));
+
+  AssetReadCapture capture;
+  const std::thread::id ui_thread_id = std::this_thread::get_id();
+  ASSERT_NE(runtime->engine_api, nullptr);
+  ASSERT_NE(runtime->engine_api->asset_read, nullptr);
+  EXPECT_EQ(runtime->engine_api->asset_read(runtime->engine, "asset.txt",
+                                             CaptureAssetRead, &capture),
+            kFlutterSpiOk);
+
+  resolver_pointer->WaitForRequest();
+  const auto callback_deadline =
+      std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (!capture.called &&
+         std::chrono::steady_clock::now() < callback_deadline) {
+    RunPendingTasks();
+    if (!capture.called) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+  }
+
+  ASSERT_TRUE(capture.called);
+  EXPECT_TRUE(resolver_pointer->called_on_worker);
+  EXPECT_EQ(capture.callback_thread_id, ui_thread_id);
+  EXPECT_EQ(capture.result, kFlutterSpiOk);
+  EXPECT_EQ(std::string(capture.bytes.begin(), capture.bytes.end()),
+            "asset-data");
+  EXPECT_EQ(resolver_pointer->mapping_requests,
+            std::vector<std::string>{"asset.txt"});
+  backend.reset();
+  factory.reset();
+  c_test_runtime_free(runtime);
+}
