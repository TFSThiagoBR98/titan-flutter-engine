+TEST(SpiPath, SetVolatileThroughTheAbi) {
+  const FlutterSpiSceneApi* api = SpiSceneApi();
+  ASSERT_NE(api->path_set_volatile, nullptr);
+
+  FlutterSpiPath* path = nullptr;
+  ASSERT_EQ(api->path_create(nullptr, &path), kFlutterSpiOk);
+  ASSERT_NE(path, nullptr);
+
+  ASSERT_EQ(api->path_set_volatile(path, true), kFlutterSpiOk);
+  ASSERT_TRUE(SpiPathForTesting(path)->GetSkPath().isVolatile());
+
+  ASSERT_EQ(api->path_set_volatile(path, false), kFlutterSpiOk);
+  EXPECT_FALSE(SpiPathForTesting(path)->GetSkPath().isVolatile());
+  EXPECT_EQ(api->path_release(path), kFlutterSpiOk);
+}
