+static void test_runtime_release_fragment_resources(
+    CTestRuntime* runtime,
+    FlutterSpiPictureRecorder* recorder,
+    FlutterSpiFragmentProgram* program,
+    FlutterSpiFragmentShader* fragment_shader,
+    FlutterSpiShader* shader) {
+  const FlutterSpiSceneApi* scene_api = runtime->engine_api->scene;
+  const FlutterSpiFragmentApi* fragment_api = runtime->engine_api->fragment;
+  const FlutterSpiPaintEffectsApi* effects_api =
+      runtime->engine_api->paint_effects;
+
+  if (shader != NULL && effects_api != NULL) {
+    effects_api->shader_release(shader);
+  }
+  if (fragment_shader != NULL && fragment_api != NULL) {
+    fragment_api->shader_release(fragment_shader);
+  }
+  if (program != NULL && fragment_api != NULL) {
+    fragment_api->program_release(program);
+  }
+  if (recorder != NULL && scene_api != NULL) {
+    scene_api->recorder_release(recorder);
+  }
+}
+
+static bool test_runtime_create_fragment_picture(
+    CTestRuntime* runtime,
+    FlutterSpiPicture** out_picture) {
+  const FlutterSpiSceneApi* scene_api = runtime->engine_api->scene;
+  const FlutterSpiFragmentApi* fragment_api = runtime->engine_api->fragment;
+  const FlutterSpiPaintEffectsApi* effects_api =
+      runtime->engine_api->paint_effects;
+  const FlutterSpiRect rect = {
+      .left = 0.0f, .top = 0.0f, .right = 16.0f, .bottom = 16.0f};
+  FlutterSpiPictureRecorder* recorder = NULL;
+  FlutterSpiFragmentProgram* program = NULL;
+  FlutterSpiFragmentShader* fragment_shader = NULL;
+  FlutterSpiShader* shader = NULL;
+  FlutterSpiPaint paint = k_scene_paint;
+  size_t uniform_count = 0;
+  size_t float_count = 0;
+  size_t sampler_count = 0;
+
+  if (scene_api == NULL || fragment_api == NULL || effects_api == NULL ||
+      runtime->fragment_program_data == NULL ||
+      runtime->fragment_program_size == 0 ||
+      scene_api->recorder_create(runtime->engine, NULL, &recorder) !=
+          kFlutterSpiOk ||
+      fragment_api->program_from_bytes(
+          runtime->engine, runtime->fragment_program_data,
+          runtime->fragment_program_size, "fragment_on_begin_frame", &program,
+          NULL) != kFlutterSpiOk ||
+      fragment_api->program_get_counts(program, &uniform_count, &float_count,
+                                       &sampler_count) != kFlutterSpiOk ||
+      sampler_count != 0 ||
+      fragment_api->shader_create(program, &fragment_shader) != kFlutterSpiOk) {
+    test_runtime_release_fragment_resources(runtime, recorder, program,
+                                            fragment_shader, shader);
+    return false;
+  }
+
+  for (size_t index = 0; index < float_count; index++) {
+    if (fragment_api->shader_set_float(fragment_shader, index,
+                                       1.0f + (float)index) != kFlutterSpiOk) {
+      test_runtime_release_fragment_resources(runtime, recorder, program,
+                                              fragment_shader, shader);
+      return false;
+    }
+  }
+
+  if (fragment_api->shader_to_shader(fragment_shader,
+                                     kFlutterSpiFilterQualityNone,
+                                     &shader) != kFlutterSpiOk) {
+    test_runtime_release_fragment_resources(runtime, recorder, program,
+                                            fragment_shader, shader);
+    return false;
+  }
+  paint.shader = shader;
+  if (scene_api->canvas_draw_rect(recorder, &rect, &paint) != kFlutterSpiOk ||
+      scene_api->recorder_finish(recorder, out_picture) != kFlutterSpiOk) {
+    test_runtime_release_fragment_resources(runtime, recorder, program,
+                                            fragment_shader, shader);
+    return false;
+  }
+
+  effects_api->shader_release(shader);
+  fragment_api->shader_release(fragment_shader);
+  fragment_api->program_release(program);
+  return true;
+}
+
+static void test_runtime_submit_fragment_scene(
+    CTestRuntime* runtime,
+    const FlutterSpiFrameInfo* frame_info) {
+  const FlutterSpiSceneApi* scene_api = runtime->engine_api->scene;
+  FlutterSpiPicture* picture = NULL;
+  FlutterSpiSceneBuilder* builder = NULL;
+  FlutterSpiScene* scene = NULL;
+
+  if (!test_runtime_create_fragment_picture(runtime, &picture) ||
+      scene_api->scene_builder_create(runtime->engine, &builder) !=
+          kFlutterSpiOk ||
+      scene_api->scene_add_picture(builder, 0.0f, 0.0f, picture, false,
+                                   false) != kFlutterSpiOk ||
+      scene_api->scene_build(
+          builder, (int64_t)runtime->last_view_metrics.physical_width,
+          (int64_t)runtime->last_view_metrics.physical_height,
+          &scene) != kFlutterSpiOk) {
+    if (builder != NULL) {
+      scene_api->scene_builder_release(builder);
+    }
+    if (picture != NULL) {
+      scene_api->picture_release(picture);
+    }
+    return;
+  }
+
+  scene_api->picture_release(picture);
+  runtime->engine_api->submit_frame(
+      runtime->engine, runtime->last_view_metrics.view_id,
+      frame_info->frame_token, scene,
+      runtime->last_view_metrics.device_pixel_ratio);
+}
