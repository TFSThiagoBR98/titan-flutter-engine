 bool HasSetFields(const FlutterSpiTextStyle& style) {
   return HasField(style, offsetof(FlutterSpiTextStyle, set_fields),
-                  sizeof(style.set_fields));
+                  sizeof(style.set_fields)) &&
+         (style.set_fields & kFlutterSpiStyleFieldsMasked) != 0;
 }
 
 bool HasSetFields(const FlutterSpiParagraphStyle& style) {
   return HasField(style, offsetof(FlutterSpiParagraphStyle, set_fields),
-                  sizeof(style.set_fields));
+                  sizeof(style.set_fields)) &&
+         (style.set_fields & kFlutterSpiStyleFieldsMasked) != 0;
 }
 
 bool HasField(uint32_t fields, uint32_t field) {
@@ -158,15 +160,16 @@ void ApplyStrutStyle(const FlutterSpiParagraphStyle& style,
   }
 
   result->strut_enabled = true;
-  const uint32_t strut_fields =
+  const bool has_strut_set_fields =
       HasField(style, offsetof(FlutterSpiParagraphStyle, strut_set_fields),
-               sizeof(style.strut_set_fields))
-          ? style.strut_set_fields
-          : kAllStrutStyleFields;
+               sizeof(style.strut_set_fields)) &&
+      (style.strut_set_fields & kFlutterSpiStyleFieldsMasked) != 0;
+  const uint32_t strut_fields =
+      has_strut_set_fields ? style.strut_set_fields : kAllStrutStyleFields;
 
-  result->strut_half_leading =
-      HasField(strut_fields,
-               kFlutterSpiStrutStyleFieldLeadingDistribution);
+  if (HasField(strut_fields, kFlutterSpiStrutStyleFieldLeadingDistribution)) {
+    result->strut_half_leading = style.strut_half_leading;
+  }
   if (HasField(strut_fields, kFlutterSpiStrutStyleFieldFontWeight)) {
     result->strut_font_weight = style.strut_font_weight;
   }
