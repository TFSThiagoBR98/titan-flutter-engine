# Why: preserve ABI 0.17 full-field decoding for zeroed 0.18 structs while
# making dart:ui masks opt-in.
diff --git a/engine/src/flutter/runtime_spi/include/flutter_text.h b/engine/src/flutter/runtime_spi/include/flutter_text.h
index a508292c20b..123d35121ba 100644
--- a/engine/src/flutter/runtime_spi/include/flutter_text.h
+++ b/engine/src/flutter/runtime_spi/include/flutter_text.h
@@ -61,6 +61,12 @@ typedef enum {
   kFlutterSpiTextHeightBehaviorDisableAll = 3,
 } FlutterSpiTextHeightBehavior;
 
+enum {
+  // The mask fields are active only when this bit is set. Without it, all
+  // fields retain the ABI 0.17 behavior.
+  kFlutterSpiStyleFieldsMasked = 1u << 31,
+};
+
 enum {
   // These masks use the same bit positions as the dart:ui encoding.
   kFlutterSpiTextStyleFieldLeadingDistribution = 1u << 0,
