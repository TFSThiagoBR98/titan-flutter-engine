+TEST(SpiSemantics, RejectedFirstUpdateLeavesNoNode) {
+  FlutterSpiEngine engine = {};
+  FlutterSpiSemanticsUpdateBuilder* builder = nullptr;
+  const FlutterSpiSemanticsApi* api = SpiSemantics::Api();
+  ASSERT_EQ(api->update_builder_create(&engine, &builder), kFlutterSpiOk);
+
+  const char invalid_utf8[] = {static_cast<char>(0xc3), '(', '\0'};
+  FlutterSpiSemanticsNode node = EmptyNode();
+  node.label.text = invalid_utf8;
+  EXPECT_EQ(api->update_node(builder, &node), kFlutterSpiInvalidArgument);
+  EXPECT_TRUE(builder->nodes.empty());
+  EXPECT_EQ(api->update_builder_release(builder), kFlutterSpiOk);
+}
+
+TEST(SpiSemantics, RejectedUpdateKeepsThePreviousNode) {
+  FlutterSpiEngine engine = {};
+  FlutterSpiSemanticsUpdateBuilder* builder = nullptr;
+  const FlutterSpiSemanticsApi* api = SpiSemantics::Api();
+  ASSERT_EQ(api->update_builder_create(&engine, &builder), kFlutterSpiOk);
+
+  FlutterSpiSemanticsNode first = EmptyNode();
+  first.id = 7;
+  first.label.text = "a";
+  ASSERT_EQ(api->update_node(builder, &first), kFlutterSpiOk);
+
+  const char invalid_utf8[] = {static_cast<char>(0xc3), '(', '\0'};
+  FlutterSpiSemanticsNode second = EmptyNode();
+  second.id = 7;
+  second.label.text = invalid_utf8;
+  EXPECT_EQ(api->update_node(builder, &second), kFlutterSpiInvalidArgument);
+  ASSERT_EQ(builder->nodes.size(), 1u);
+  EXPECT_EQ(builder->nodes.at(7).label, "a");
+  EXPECT_EQ(api->update_builder_release(builder), kFlutterSpiOk);
+}
