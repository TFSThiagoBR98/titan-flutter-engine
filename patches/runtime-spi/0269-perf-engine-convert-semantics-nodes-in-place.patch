# Why: avoid constructing a temporary semantics node for new IDs while
# preserving the previous node when an update is rejected.
diff --git a/engine/src/flutter/runtime_spi/semantics/spi_semantics.cc b/engine/src/flutter/runtime_spi/semantics/spi_semantics.cc
index 4da70f709ce..8de804065df 100644
--- a/engine/src/flutter/runtime_spi/semantics/spi_semantics.cc
+++ b/engine/src/flutter/runtime_spi/semantics/spi_semantics.cc
@@ -184,13 +184,20 @@ FlutterSpiResult UpdateNode(FlutterSpiSemanticsUpdateBuilder* builder,
   if (input == nullptr) {
     return kFlutterSpiInvalidArgument;
   }
-  SemanticsNode node;
-  FlutterSpiResult result = SpiSemanticsToNode(*input, &node);
-  if (result != kFlutterSpiOk) {
+  auto [iterator, inserted] = builder->nodes.try_emplace(input->id);
+  if (inserted) {
+    FlutterSpiResult result = SpiSemanticsToNode(*input, &iterator->second);
+    if (result != kFlutterSpiOk) {
+      builder->nodes.erase(iterator);
+    }
     return result;
   }
-  builder->nodes.insert_or_assign(node.id, std::move(node));
-  return kFlutterSpiOk;
+  SemanticsNode replacement;
+  FlutterSpiResult result = SpiSemanticsToNode(*input, &replacement);
+  if (result == kFlutterSpiOk) {
+    iterator->second = std::move(replacement);
+  }
+  return result;
 }
 
