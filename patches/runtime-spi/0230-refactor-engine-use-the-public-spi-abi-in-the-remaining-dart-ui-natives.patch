+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/lib/ui/painting/image.h"
+
+#include <utility>
+
+#include "flutter/runtime_spi/image/spi_image.h"
+
+namespace flutter {
+
+// Ponte do flutter_gpu até a S7 (API C de GPU no SPI).
+fml::RefPtr<CanvasImage> CanvasImage::CreateFromDlImageForGpu(
+    sk_sp<DlImage> image) {
+  FlutterSpiImage* spi_image = nullptr;
+  if (SpiImageWrap(std::move(image), &spi_image) != kFlutterSpiOk) {
+    return nullptr;
+  }
+  return Create(spi_image);
+}
+
+sk_sp<DlImage> CanvasImage::GetDlImageForGpu() const {
+  return SpiImageGet(spi_image_);
+}
+
+}  // namespace flutter
