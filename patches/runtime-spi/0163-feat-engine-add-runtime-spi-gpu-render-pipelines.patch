+
+PipelineShaderHandles MakePipelineShaderHandles(FlutterSpiGpuContext* context) {
+  auto bundle = BuildPipelineShaderBundle();
+  auto descriptor = MakeShaderLibraryDescriptor(bundle);
+  PipelineShaderHandles handles;
+  if (SpiGpuShaderLibraryCreate(context, &descriptor, &handles.library,
+                                nullptr) != kFlutterSpiOk) {
+    return {};
+  }
+  if (SpiGpuShaderLibraryGetShader(handles.library, "vertex", &handles.vertex) !=
+      kFlutterSpiOk) {
+    return {};
+  }
+  if (SpiGpuShaderLibraryGetShader(handles.library, "fragment",
+                                   &handles.fragment) != kFlutterSpiOk) {
+    return {};
+  }
+  return handles;
+}
+
+void ReleasePipelineShaderHandles(PipelineShaderHandles* handles) {
+  if (handles->vertex != nullptr) {
+    EXPECT_EQ(SpiGpuShaderRelease(handles->vertex), kFlutterSpiOk);
+  }
+  if (handles->fragment != nullptr) {
+    EXPECT_EQ(SpiGpuShaderRelease(handles->fragment), kFlutterSpiOk);
+  }
+  if (handles->library != nullptr) {
+    EXPECT_EQ(SpiGpuShaderLibraryRelease(handles->library), kFlutterSpiOk);
+  }
+}
