@@ -0,0 +1,381 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/gpu/spi_gpu_render_pipeline.h"
+
+#include <array>
+#include <cstdlib>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "flutter/runtime_spi/gpu/spi_gpu_context.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "impeller/base/validation.h"
+#include "impeller/core/shader_types.h"
+#include "impeller/renderer/shader_library.h"
+#include "third_party/abseil-cpp/absl/strings/str_cat.h"
+
+namespace flutter {
+namespace {
+
+SpiHandleTable<SpiGpuRenderPipeline>& Pipelines() {
+  return LeakedHandleTable<SpiGpuRenderPipeline>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuRenderPipeline* pipeline) {
+  return reinterpret_cast<uintptr_t>(pipeline);
+}
+
+FlutterSpiGpuRenderPipeline* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuRenderPipeline*>(value);
+}
+
+SpiGpuRenderPipeline* FindPipeline(FlutterSpiGpuRenderPipeline* pipeline) {
+  return Pipelines().FindRaw(HandleValue(pipeline));
+}
+
+char* AllocateError(const std::string& error) {
+  char* result = static_cast<char*>(std::malloc(error.size() + 1));
+  if (result == nullptr) {
+    return nullptr;
+  }
+  std::memcpy(result, error.c_str(), error.size() + 1);
+  return result;
+}
+
+void SetError(char** out_error, const std::string& error) {
+  if (out_error != nullptr) {
+    *out_error = AllocateError(error);
+  }
+}
+
+struct VertexFormatInfo {
+  impeller::ShaderType type;
+  size_t bit_width;
+  size_t vec_size;
+  size_t bytes_per_element;
+};
+
+// The order must remain synchronized with lib/src/vertex_layout.dart and the
+// FlutterSpiGpuVertexFormat values in flutter_gpu.h.
+constexpr std::array<VertexFormatInfo, 12> kVertexFormatTable = {{
+    {impeller::ShaderType::kFloat, 32, 1, 4},
+    {impeller::ShaderType::kFloat, 32, 2, 8},
+    {impeller::ShaderType::kFloat, 32, 3, 12},
+    {impeller::ShaderType::kFloat, 32, 4, 16},
+    {impeller::ShaderType::kUnsignedInt, 32, 1, 4},
+    {impeller::ShaderType::kUnsignedInt, 32, 2, 8},
+    {impeller::ShaderType::kUnsignedInt, 32, 3, 12},
+    {impeller::ShaderType::kUnsignedInt, 32, 4, 16},
+    {impeller::ShaderType::kSignedInt, 32, 1, 4},
+    {impeller::ShaderType::kSignedInt, 32, 2, 8},
+    {impeller::ShaderType::kSignedInt, 32, 3, 12},
+    {impeller::ShaderType::kSignedInt, 32, 4, 16},
+}};
+
+bool HasFullStruct(const FlutterSpiGpuVertexAttribute& attribute) {
+  return attribute.struct_size >= sizeof(FlutterSpiGpuVertexAttribute);
+}
+
+bool HasFullStruct(const FlutterSpiGpuVertexBufferLayout& layout) {
+  return layout.struct_size >= sizeof(FlutterSpiGpuVertexBufferLayout);
+}
+
+std::shared_ptr<impeller::VertexDescriptor> BuildDefaultVertexDescriptor(
+    const SpiGpuShader& vertex_shader) {
+  return vertex_shader.CreateVertexDescriptor();
+}
+
+std::shared_ptr<impeller::VertexDescriptor> BuildCustomVertexDescriptor(
+    const SpiGpuShader& vertex_shader,
+    const FlutterSpiGpuVertexBufferLayout* buffer_layouts,
+    size_t buffer_layout_count,
+    std::string* error) {
+  std::vector<impeller::ShaderStageBufferLayout> stage_layouts;
+  std::vector<impeller::ShaderStageIOSlot> stage_inputs;
+
+  size_t total_attribute_count = 0;
+  for (size_t buffer_index = 0; buffer_index < buffer_layout_count;
+       ++buffer_index) {
+    const auto& layout = buffer_layouts[buffer_index];
+    if (!HasFullStruct(layout)) {
+      *error = "VertexBufferLayout descriptor is smaller than expected.";
+      return nullptr;
+    }
+    if (layout.attributes == nullptr && layout.attribute_count != 0) {
+      *error = "VertexBufferLayout.attributes must not be null.";
+      return nullptr;
+    }
+    total_attribute_count += layout.attribute_count;
+  }
+  stage_inputs.reserve(total_attribute_count);
+  stage_layouts.reserve(buffer_layout_count);
+
+  for (size_t buffer_index = 0; buffer_index < buffer_layout_count;
+       ++buffer_index) {
+    const auto& layout = buffer_layouts[buffer_index];
+    if (layout.stride <= 0) {
+      *error = absl::StrCat(
+          "VertexBuffer.strideInBytes must be positive (got ", layout.stride,
+          ") on buffer at index ", buffer_index, ".");
+      return nullptr;
+    }
+    if (layout.step_mode < kFlutterSpiGpuVertexStepModeVertex ||
+        layout.step_mode > kFlutterSpiGpuVertexStepModeInstance) {
+      *error = absl::StrCat(
+          "VertexBuffer.stepMode is out of range (got ", layout.step_mode,
+          ") on buffer at index ", buffer_index, ".");
+      return nullptr;
+    }
+    stage_layouts.push_back(
+        {.stride = static_cast<size_t>(layout.stride),
+         .binding = static_cast<uint32_t>(buffer_index),
+         .input_rate = layout.step_mode == kFlutterSpiGpuVertexStepModeVertex
+                           ? impeller::VertexInputRate::kVertex
+                           : impeller::VertexInputRate::kInstance});
+
+    struct AttributeRange {
+      std::string name;
+      size_t begin;
+      size_t end;
+    };
+    std::vector<AttributeRange> ranges;
+    ranges.reserve(layout.attribute_count);
+
+    for (size_t local_index = 0; local_index < layout.attribute_count;
+         ++local_index) {
+      const auto& attribute = layout.attributes[local_index];
+      if (!HasFullStruct(attribute)) {
+        *error = "VertexAttribute descriptor is smaller than expected.";
+        return nullptr;
+      }
+      if (attribute.name == nullptr) {
+        *error = "VertexAttribute.name must not be null.";
+        return nullptr;
+      }
+      const std::string name(attribute.name);
+      if (attribute.offset < 0) {
+        *error = absl::StrCat(
+            "VertexAttribute '", name,
+            "' offsetInBytes must be non-negative (got ", attribute.offset,
+            ").");
+        return nullptr;
+      }
+      if (attribute.format < 0 ||
+          static_cast<size_t>(attribute.format) >= kVertexFormatTable.size()) {
+        *error = absl::StrCat("VertexAttribute '", name, "' format index ",
+                             attribute.format, " is out of range.");
+        return nullptr;
+      }
+      const VertexFormatInfo& format = kVertexFormatTable[attribute.format];
+      const size_t offset = static_cast<size_t>(attribute.offset);
+      if (offset > static_cast<size_t>(layout.stride) ||
+          format.bytes_per_element >
+              static_cast<size_t>(layout.stride) - offset) {
+        *error = absl::StrCat(
+            "VertexAttribute '", name, "' (offset ", attribute.offset,
+            " + ", format.bytes_per_element, " bytes) overruns stride of ",
+            layout.stride, " on buffer at index ", buffer_index, ".");
+        return nullptr;
+      }
+
+      const size_t end = offset + format.bytes_per_element;
+      for (const auto& range : ranges) {
+        if (offset < range.end && range.begin < end) {
+          *error = absl::StrCat(
+              "VertexAttribute '", name, "' (bytes [", offset, ", ", end,
+              ")) overlaps VertexAttribute '", range.name, "' (bytes [",
+              range.begin, ", ", range.end, ")) on buffer at index ",
+              buffer_index, ".");
+          return nullptr;
+        }
+      }
+      ranges.push_back({name, offset, end});
+
+      const impeller::ShaderStageIOSlot* shader_slot = nullptr;
+      for (const auto& slot : vertex_shader.GetStageInputs()) {
+        if (slot.name != nullptr && name == slot.name) {
+          shader_slot = &slot;
+          break;
+        }
+      }
+      if (shader_slot == nullptr) {
+        *error = absl::StrCat(
+            "VertexAttribute name '", name,
+            "' does not match any input declared by the bound vertex shader.");
+        return nullptr;
+      }
+      if (shader_slot->type != format.type ||
+          shader_slot->bit_width != format.bit_width) {
+        *error = absl::StrCat(
+            "VertexAttribute '", name,
+            "' format does not match the vertex shader's declared input type.");
+        return nullptr;
+      }
+      impeller::ShaderStageIOSlot built = *shader_slot;
+      built.binding = static_cast<uint32_t>(buffer_index);
+      built.offset = offset;
+      stage_inputs.push_back(built);
+    }
+  }
+
+  auto descriptor = std::make_shared<impeller::VertexDescriptor>();
+  descriptor->SetStageInputs(stage_inputs, stage_layouts);
+  return descriptor;
+}
+
+}  // namespace
+
+SpiGpuRenderPipeline::SpiGpuRenderPipeline(
+    FlutterSpiGpuShader* vertex_shader,
+    FlutterSpiGpuShader* fragment_shader,
+    std::shared_ptr<impeller::VertexDescriptor> vertex_descriptor)
+    : vertex_shader_(vertex_shader),
+      fragment_shader_(fragment_shader),
+      vertex_descriptor_(std::move(vertex_descriptor)) {
+  SpiGpuShaderRetain(vertex_shader_);
+  SpiGpuShaderRetain(fragment_shader_);
+  SpiGpuShader* vertex_core = SpiGpuShaderGetCore(vertex_shader_);
+  SpiGpuShader* fragment_core = SpiGpuShaderGetCore(fragment_shader_);
+  vertex_descriptor_->RegisterDescriptorSetLayouts(
+      vertex_core->GetDescriptorSetLayouts().data(),
+      vertex_core->GetDescriptorSetLayouts().size());
+  vertex_descriptor_->RegisterDescriptorSetLayouts(
+      fragment_core->GetDescriptorSetLayouts().data(),
+      fragment_core->GetDescriptorSetLayouts().size());
+}
+
+SpiGpuRenderPipeline::~SpiGpuRenderPipeline() {
+  SpiGpuShaderRelease(vertex_shader_);
+  SpiGpuShaderRelease(fragment_shader_);
+}
+
+bool SpiGpuRenderPipeline::BindToPipelineDescriptor(
+    impeller::ShaderLibrary& library,
+    impeller::PipelineDescriptor& descriptor) {
+  SpiGpuShader* vertex_core = SpiGpuShaderGetCore(vertex_shader_);
+  SpiGpuShader* fragment_core = SpiGpuShaderGetCore(fragment_shader_);
+  if (vertex_core == nullptr || fragment_core == nullptr) {
+    return false;
+  }
+  auto vertex_function = vertex_core->GetFunctionFromLibrary(library);
+  if (!vertex_function) {
+    VALIDATION_LOG << "Unable to resolve the vertex shader function '"
+                   << vertex_core->GetEntrypoint()
+                   << "' from the shader library.";
+    return false;
+  }
+  auto fragment_function = fragment_core->GetFunctionFromLibrary(library);
+  if (!fragment_function) {
+    VALIDATION_LOG << "Unable to resolve the fragment shader function '"
+                   << fragment_core->GetEntrypoint()
+                   << "' from the shader library.";
+    return false;
+  }
+  descriptor.SetVertexDescriptor(vertex_descriptor_);
+  descriptor.AddStageEntrypoint(std::move(vertex_function));
+  descriptor.AddStageEntrypoint(std::move(fragment_function));
+  return true;
+}
+
+const char* ValidateRenderPipelineShaderStages(
+    const SpiGpuShader& vertex_shader,
+    const SpiGpuShader& fragment_shader) {
+  if (vertex_shader.GetShaderStage() != impeller::ShaderStage::kVertex) {
+    return "The shader given for the vertex stage is not a vertex shader.";
+  }
+  if (fragment_shader.GetShaderStage() != impeller::ShaderStage::kFragment) {
+    return "The shader given for the fragment stage is not a fragment shader.";
+  }
+  return nullptr;
+}
+
+FlutterSpiResult SpiGpuRenderPipelineCreate(
+    FlutterSpiGpuContext* context,
+    const FlutterSpiGpuRenderPipelineDescriptor* descriptor,
+    FlutterSpiGpuRenderPipeline** out_pipeline,
+    char** out_error) {
+  if (out_error != nullptr) {
+    *out_error = nullptr;
+  }
+  if (context == nullptr || descriptor == nullptr || out_pipeline == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_pipeline = nullptr;
+  if (descriptor->struct_size <
+      offsetof(FlutterSpiGpuRenderPipelineDescriptor, buffer_layout_count) +
+          sizeof(descriptor->buffer_layout_count)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if ((descriptor->buffer_layouts == nullptr &&
+       descriptor->buffer_layout_count != 0) ||
+      (descriptor->buffer_layouts != nullptr &&
+       descriptor->buffer_layout_count == 0)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  SpiGpuShader* vertex_shader = SpiGpuShaderGetCore(descriptor->vertex_shader);
+  SpiGpuShader* fragment_shader =
+      SpiGpuShaderGetCore(descriptor->fragment_shader);
+  if (vertex_shader == nullptr || fragment_shader == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (const char* error =
+          ValidateRenderPipelineShaderStages(*vertex_shader, *fragment_shader)) {
+    SetError(out_error, error);
+    return kFlutterSpiInvalidArgument;
+  }
+  std::shared_ptr<impeller::Context> context_value =
+      SpiGpuContextGetImpeller(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  vertex_shader->RegisterSync(*context_value);
+  fragment_shader->RegisterSync(*context_value);
+
+  std::shared_ptr<impeller::VertexDescriptor> vertex_descriptor;
+  if (descriptor->buffer_layouts == nullptr) {
+    vertex_descriptor = BuildDefaultVertexDescriptor(*vertex_shader);
+  } else {
+    std::string error;
+    vertex_descriptor = BuildCustomVertexDescriptor(
+        *vertex_shader, descriptor->buffer_layouts,
+        descriptor->buffer_layout_count, &error);
+    if (vertex_descriptor == nullptr) {
+      SetError(out_error, error);
+      return kFlutterSpiInvalidArgument;
+    }
+  }
+
+  auto pipeline = std::make_shared<SpiGpuRenderPipeline>(
+      descriptor->vertex_shader, descriptor->fragment_shader,
+      std::move(vertex_descriptor));
+  const uintptr_t handle = Pipelines().Insert(std::move(pipeline));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_pipeline = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPipelineRetain(
+    FlutterSpiGpuRenderPipeline* pipeline) {
+  return Pipelines().Retain(HandleValue(pipeline)) ? kFlutterSpiOk
+                                                   : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuRenderPipelineRelease(
+    FlutterSpiGpuRenderPipeline* pipeline) {
+  return Pipelines().Release(HandleValue(pipeline)) ? kFlutterSpiOk
+                                                    : kFlutterSpiInvalidHandle;
+}
+
+SpiGpuRenderPipeline* SpiGpuRenderPipelineGetCore(
+    FlutterSpiGpuRenderPipeline* pipeline) {
+  return FindPipeline(pipeline);
+}
+
+}  // namespace flutter
