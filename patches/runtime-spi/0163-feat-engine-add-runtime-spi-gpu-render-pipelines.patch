+class FakeShaderLibrary final : public impeller::ShaderLibrary {
+ public:
+  bool IsValid() const override { return true; }
+
+  std::shared_ptr<const impeller::ShaderFunction> GetFunction(
+      std::string_view, impeller::ShaderStage) override {
+    return nullptr;
+  }
+
+  void RegisterFunction(std::string name,
+                        impeller::ShaderStage stage,
+                        std::shared_ptr<fml::Mapping>,
+                        RegistrationCallback callback) override {
+    registered_functions_.emplace_back(std::move(name), stage);
+    if (callback) {
+      callback(true);
+    }
+  }
+
+  void UnregisterFunction(std::string name,
+                          impeller::ShaderStage stage) override {
+    const auto iterator = std::find_if(
+        registered_functions_.begin(), registered_functions_.end(),
+        [&name, stage](const auto& function) {
+          return function.first == name && function.second == stage;
+        });
+    if (iterator != registered_functions_.end()) {
+      registered_functions_.erase(iterator);
+    }
+  }
+
+  bool HasFunction(std::string_view name, impeller::ShaderStage stage) const {
+    return std::any_of(
+        registered_functions_.begin(), registered_functions_.end(),
+        [name, stage](const auto& function) {
+          return function.first == name && function.second == stage;
+        });
+  }
+
+ private:
+  std::vector<std::pair<std::string, impeller::ShaderStage>>
+      registered_functions_;
+};
