+absl::Status ResultToStatus(FlutterSpiResult result,
+                            const char* operation,
+                            const char* detail = nullptr) {
+  if (result == kFlutterSpiOk) {
+    return absl::OkStatus();
+  }
+  const std::string message = detail == nullptr
+                                  ? std::string(operation)
+                                  : std::string(operation) + ": " + detail;
+  if (result == kFlutterSpiInvalidArgument) {
+    return absl::InvalidArgumentError(message);
+  }
+  if (result == kFlutterSpiUnsupported) {
+    return absl::UnimplementedError(message);
+  }
+  return absl::InternalError(message);
+}
