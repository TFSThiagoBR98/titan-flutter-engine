+FlutterSpiResult SpiGpuShaderGetStorageBufferIndex(FlutterSpiGpuShader* shader,
+                                                   const char* name,
+                                                   int32_t* out_index) {
+  SpiGpuShader* shader_value = FindShader(shader);
+  if (shader_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (name == nullptr || out_index == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_index = shader_value->GetStorageBufferIndex(name);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderGetStorageBufferSizeAt(FlutterSpiGpuShader* shader,
+                                                    int32_t index,
+                                                    int32_t* out_size) {
+  SpiGpuShader* shader_value = FindShader(shader);
+  if (shader_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (index < 0 || out_size == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto* binding = shader_value->GetStorageBufferAt(index);
+  *out_size =
+      binding == nullptr ? -1 : static_cast<int32_t>(binding->size_in_bytes);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuShaderGetStorageBufferRuntimeArrayStrideAt(
+    FlutterSpiGpuShader* shader,
+    int32_t index,
+    int32_t* out_stride) {
+  SpiGpuShader* shader_value = FindShader(shader);
+  if (shader_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (index < 0 || out_stride == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto* binding = shader_value->GetStorageBufferAt(index);
+  *out_stride = binding == nullptr
+                    ? -1
+                    : static_cast<int32_t>(binding->runtime_array_stride);
+  return kFlutterSpiOk;
+}
