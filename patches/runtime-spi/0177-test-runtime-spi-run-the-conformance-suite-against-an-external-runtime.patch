+using ExternalRuntimeTableFunction = FlutterSpiRuntimeTable (*)(CTestRuntime*);
+using ExternalRuntimeSupportsFunction = bool (*)(const char*);
+
+struct ExternalRuntime {
+  bool configured = false;
+  void* library = nullptr;
+  ExternalRuntimeTableFunction table = nullptr;
+  ExternalRuntimeSupportsFunction supports = nullptr;
+  std::string error;
+};
+
+ExternalRuntime& GetExternalRuntime() {
+  static ExternalRuntime runtime = [] {
+    ExternalRuntime result;
+    const char* path = std::getenv("FLUTTER_SPI_CONFORMANCE_RUNTIME");
+    if (path == nullptr || path[0] == '\0') {
+      return result;
+    }
+    result.configured = true;
+    result.library = ::dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (result.library == nullptr) {
+      const char* error = ::dlerror();
+      result.error = error == nullptr ? "dlopen failed" : error;
+      return result;
+    }
+    result.table = reinterpret_cast<ExternalRuntimeTableFunction>(
+        ::dlsym(result.library, "flutter_spi_conformance_runtime_table"));
+    const char* table_error = ::dlerror();
+    if (result.table == nullptr) {
+      result.error = table_error == nullptr ? "symbol not found" : table_error;
+      return result;
+    }
+    result.supports = reinterpret_cast<ExternalRuntimeSupportsFunction>(
+        ::dlsym(result.library, "flutter_spi_conformance_supports"));
+    const char* supports_error = ::dlerror();
+    if (result.supports == nullptr) {
+      result.error =
+          supports_error == nullptr ? "symbol not found" : supports_error;
+    }
+    return result;
+  }();
+  return runtime;
+}
