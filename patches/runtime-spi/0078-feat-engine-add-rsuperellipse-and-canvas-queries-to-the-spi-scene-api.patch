+  ASSERT_EQ(api()->canvas_scale(recorder, 2.0f, 3.0f), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_rotate(recorder, 0.5f), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_save(recorder), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_translate(recorder, -1.0f, 5.0f), kFlutterSpiOk);
+
+  double actual_matrix[16] = {};
+  ASSERT_EQ(api()->canvas_get_transform(recorder, actual_matrix), kFlutterSpiOk);
+
+  DisplayListBuilder expected_builder(DlRect::MakeLTRB(1, 2, 30, 40));
+  expected_builder.Translate(3.0f, 4.0f);
+  expected_builder.Scale(2.0f, 3.0f);
+  expected_builder.Rotate(0.5f * 180.0f / 3.14159265358979323846f);
+  expected_builder.Save();
+  expected_builder.Translate(-1.0f, 5.0f);
+  const DlMatrix expected_matrix = expected_builder.GetMatrix();
+  for (size_t index = 0; index < 16; ++index) {
+    EXPECT_FLOAT_EQ(actual_matrix[index], expected_matrix.m[index]);
