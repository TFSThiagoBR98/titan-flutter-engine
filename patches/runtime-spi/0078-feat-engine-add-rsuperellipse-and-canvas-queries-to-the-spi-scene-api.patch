+bool IsFinite(const FlutterSpiRRect& rrect) {
+  if (!std::isfinite(rrect.rect.left) || !std::isfinite(rrect.rect.top) ||
+      !std::isfinite(rrect.rect.right) ||
+      !std::isfinite(rrect.rect.bottom)) {
+    return false;
+  }
+  for (const FlutterSpiPoint& radius : rrect.radii) {
+    if (!std::isfinite(radius.x) || !std::isfinite(radius.y)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+DlRoundSuperellipse ToDlRoundSuperellipse(const FlutterSpiRRect& rrect) {
+  return DlRoundSuperellipse::MakeRectRadii(
+      DlRect::MakeLTRB(rrect.rect.left, rrect.rect.top, rrect.rect.right,
+                       rrect.rect.bottom)
+          .GetPositive(),
+      {.top_left = {rrect.radii[0].x, rrect.radii[0].y},
+       .top_right = {rrect.radii[1].x, rrect.radii[1].y},
+       .bottom_left = {rrect.radii[3].x, rrect.radii[3].y},
+       .bottom_right = {rrect.radii[2].x, rrect.radii[2].y}});
+}
