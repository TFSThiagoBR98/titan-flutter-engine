+
+  ASSERT_EQ(api()->canvas_restore(recorder), kFlutterSpiOk);
+  double restored_matrix[16] = {};
+  ASSERT_EQ(api()->canvas_get_transform(recorder, restored_matrix),
+            kFlutterSpiOk);
+  expected_builder.Restore();
+  const DlMatrix expected_restored_matrix = expected_builder.GetMatrix();
+  for (size_t index = 0; index < 16; ++index) {
