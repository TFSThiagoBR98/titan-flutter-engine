@@ -0,0 +1,56 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/scene/spi_engine_layer.h"
+
+#include <cstdint>
+#include <utility>
+
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+
+struct FlutterSpiEngineLayer {
+  explicit FlutterSpiEngineLayer(std::shared_ptr<flutter::Layer> value)
+      : layer(std::move(value)) {}
+
+  std::shared_ptr<flutter::Layer> layer;
+};
+
+namespace flutter {
+namespace {
+
+SpiHandleTable<FlutterSpiEngineLayer>& EngineLayers() {
+  static SpiHandleTable<FlutterSpiEngineLayer> layers;
+  return layers;
+}
+
+uintptr_t HandleValue(FlutterSpiEngineLayer* layer) {
+  return reinterpret_cast<uintptr_t>(layer);
+}
+
+FlutterSpiEngineLayer* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiEngineLayer*>(value);
+}
+
+}  // namespace
+
+FlutterSpiEngineLayer* SpiEngineLayerCreate(
+    const std::shared_ptr<Layer>& layer) {
+  if (layer == nullptr) {
+    return nullptr;
+  }
+  return MakeHandle(
+      EngineLayers().Insert(std::make_shared<FlutterSpiEngineLayer>(layer)));
+}
+
+std::shared_ptr<Layer> SpiEngineLayerGet(FlutterSpiEngineLayer* layer) {
+  const auto value = EngineLayers().Find(HandleValue(layer));
+  return value == nullptr ? nullptr : value->layer;
+}
+
+FlutterSpiResult SpiEngineLayerRelease(FlutterSpiEngineLayer* layer) {
+  return EngineLayers().Release(HandleValue(layer)) ? kFlutterSpiOk
+                                                     : kFlutterSpiInvalidHandle;
+}
+
+}  // namespace flutter
