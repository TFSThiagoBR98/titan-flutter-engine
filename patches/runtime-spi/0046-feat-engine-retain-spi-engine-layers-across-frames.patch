+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/include/flutter_scene.h"
+
+#include <memory>
+
+#include "flutter/flow/layers/layer_tree.h"
+#include "flutter/flow/layers/opacity_layer.h"
+#include "flutter/runtime_spi/scene/spi_canvas.h"
+#include "flutter/runtime_spi/scene/spi_scene_builder.h"
+#include "flutter/runtime_spi/spi_runtime_backend.h"
+#include "flutter/runtime_spi/spi_scene.h"
+#include "flutter/testing/testing.h"
+
+namespace flutter::testing {
+namespace {
+
+class SpiRetainedLayersTest : public ::testing::Test {
+ protected:
+  const FlutterSpiSceneApi* api() const { return SpiSceneApi(); }
+
+  FlutterSpiEngine* engine() { return &engine_; }
+
+  FlutterSpiSceneBuilder* MakeBuilder() {
+    FlutterSpiSceneBuilder* builder = nullptr;
+    EXPECT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+    return builder;
+  }
+
+  FlutterSpiEngine engine_{};
+};
+
+TEST_F(SpiRetainedLayersTest, TakeLastLayerReturnsTopOfStack) {
+  ASSERT_NE(api()->scene_take_last_layer, nullptr);
+  FlutterSpiSceneBuilder* builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(builder, 128, 3.0f, 4.0f),
+            kFlutterSpiOk);
+
+  FlutterSpiEngineLayer* layer = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(builder, &layer), kFlutterSpiOk);
+  ASSERT_NE(layer, nullptr);
+
+  FlutterSpiScene* scene = nullptr;
+  ASSERT_EQ(api()->scene_build(builder, 100, 80, &scene), kFlutterSpiOk);
+  ASSERT_EQ(scene->root_layer->layers().size(), 1u);
+  EXPECT_NE(scene->root_layer->layers()[0]->as_opacity_layer(), nullptr);
+  EXPECT_EQ(api()->engine_layer_release(layer), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
+}
+
+TEST_F(SpiRetainedLayersTest, AssignOldLayerKeepsOriginalLayerId) {
+  ASSERT_NE(api()->scene_assign_old_layer, nullptr);
+  ASSERT_NE(api()->scene_take_last_layer, nullptr);
+  FlutterSpiSceneBuilder* old_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(old_builder, 128, 3.0f, 4.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* old_handle = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(old_builder, &old_handle),
+            kFlutterSpiOk);
+  FlutterSpiScene* old_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(old_builder, 100, 80, &old_scene),
+            kFlutterSpiOk);
+  const auto old_layer = old_scene->root_layer->layers()[0];
+
+  FlutterSpiSceneBuilder* new_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(new_builder, 64, 5.0f, 6.0f),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_assign_old_layer(new_builder, old_handle),
+            kFlutterSpiOk);
+  FlutterSpiScene* new_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(new_builder, 100, 80, &new_scene),
+            kFlutterSpiOk);
+  const auto new_layer = new_scene->root_layer->layers()[0];
+
+  EXPECT_EQ(new_layer->original_layer_id(), old_layer->original_layer_id());
+  EXPECT_EQ(api()->engine_layer_release(old_handle), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(new_scene), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(old_scene), kFlutterSpiOk);
+}
+
+TEST_F(SpiRetainedLayersTest, AddRetainedReusesTheSameLayer) {
+  ASSERT_NE(api()->scene_add_retained, nullptr);
+  ASSERT_NE(api()->scene_take_last_layer, nullptr);
+  FlutterSpiSceneBuilder* old_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(old_builder, 128, 3.0f, 4.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* handle = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(old_builder, &handle), kFlutterSpiOk);
+  FlutterSpiScene* old_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(old_builder, 100, 80, &old_scene),
+            kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* new_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_add_retained(new_builder, handle), kFlutterSpiOk);
+  FlutterSpiScene* new_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(new_builder, 100, 80, &new_scene),
+            kFlutterSpiOk);
+
+  EXPECT_EQ(old_scene->root_layer->layers()[0],
+            new_scene->root_layer->layers()[0]);
+  EXPECT_EQ(api()->engine_layer_release(handle), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(new_scene), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(old_scene), kFlutterSpiOk);
+}
+
+TEST_F(SpiRetainedLayersTest, LayerHandleOutlivesBuilder) {
+  ASSERT_NE(api()->scene_add_retained, nullptr);
+  ASSERT_NE(api()->scene_take_last_layer, nullptr);
+  FlutterSpiSceneBuilder* old_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(old_builder, 128, 3.0f, 4.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* handle = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(old_builder, &handle), kFlutterSpiOk);
+  FlutterSpiScene* old_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(old_builder, 100, 80, &old_scene),
+            kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* new_builder = MakeBuilder();
+  EXPECT_EQ(api()->scene_add_retained(new_builder, handle), kFlutterSpiOk);
+  EXPECT_EQ(api()->scene_builder_release(new_builder), kFlutterSpiOk);
+  EXPECT_EQ(api()->engine_layer_release(handle), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(old_scene), kFlutterSpiOk);
+}
+
+TEST_F(SpiRetainedLayersTest, RetainedLayerOnlyOncePerScene) {
+  ASSERT_NE(api()->scene_add_retained, nullptr);
+  ASSERT_NE(api()->scene_take_last_layer, nullptr);
+  FlutterSpiSceneBuilder* old_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(old_builder, 128, 3.0f, 4.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* handle = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(old_builder, &handle), kFlutterSpiOk);
+  FlutterSpiScene* old_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(old_builder, 100, 80, &old_scene),
+            kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* new_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_add_retained(new_builder, handle), kFlutterSpiOk);
+  EXPECT_EQ(api()->scene_add_retained(new_builder, handle),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(api()->scene_builder_release(new_builder), kFlutterSpiOk);
+  EXPECT_EQ(api()->engine_layer_release(handle), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(old_scene), kFlutterSpiOk);
+}
+
+TEST_F(SpiRetainedLayersTest, TakeLastLayerWithoutPushIsRejected) {
+  ASSERT_NE(api()->scene_take_last_layer, nullptr);
+  FlutterSpiSceneBuilder* builder = MakeBuilder();
+  FlutterSpiEngineLayer* layer = nullptr;
+  EXPECT_EQ(api()->scene_take_last_layer(builder, &layer),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(layer, nullptr);
+  EXPECT_EQ(api()->scene_builder_release(builder), kFlutterSpiOk);
+}
+
+TEST_F(SpiRetainedLayersTest, ReleasedLayerIsInvalidHandle) {
+  ASSERT_NE(api()->scene_add_retained, nullptr);
+  ASSERT_NE(api()->scene_take_last_layer, nullptr);
+  FlutterSpiSceneBuilder* old_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(old_builder, 128, 3.0f, 4.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* handle = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(old_builder, &handle), kFlutterSpiOk);
+  FlutterSpiScene* old_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(old_builder, 100, 80, &old_scene),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->engine_layer_release(handle), kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* new_builder = MakeBuilder();
+  EXPECT_EQ(api()->scene_add_retained(new_builder, handle),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(api()->engine_layer_release(handle), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(api()->scene_builder_release(new_builder), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(old_scene), kFlutterSpiOk);
+}
+
+}  // namespace
+}  // namespace flutter::testing
