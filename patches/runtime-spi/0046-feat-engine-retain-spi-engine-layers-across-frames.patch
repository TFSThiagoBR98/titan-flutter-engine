+FlutterSpiResult SpiSceneTakeLastLayer(FlutterSpiSceneBuilder* builder,
+                                       FlutterSpiEngineLayer** out_layer) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_layer == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (builder_value->layer_stack.size() <= 1) {
+    return kFlutterSpiInvalidArgument;
+  }
+  FlutterSpiEngineLayer* layer =
+      SpiEngineLayerCreate(builder_value->layer_stack.back());
+  if (layer == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  *out_layer = layer;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiSceneAssignOldLayer(FlutterSpiSceneBuilder* builder,
+                                        FlutterSpiEngineLayer* old_layer) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const auto old_layer_value = SpiEngineLayerGet(old_layer);
+  if (old_layer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (builder_value->layer_stack.size() <= 1) {
+    return kFlutterSpiInvalidArgument;
+  }
+  builder_value->layer_stack.back()->AssignOldLayer(old_layer_value.get());
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiSceneAddRetained(FlutterSpiSceneBuilder* builder,
+                                     FlutterSpiEngineLayer* layer) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const auto layer_value = SpiEngineLayerGet(layer);
+  if (layer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (builder_value->added_layers.contains(layer_value.get())) {
+    return kFlutterSpiInvalidArgument;
+  }
+  AddLayer(layer_value, builder_value);
+  return kFlutterSpiOk;
+}
