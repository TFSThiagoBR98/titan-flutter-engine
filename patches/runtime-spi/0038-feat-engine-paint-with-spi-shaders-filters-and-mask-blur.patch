+                    offsetof(FlutterSpiPaint, has_mask_blur),
+                    sizeof(paint.has_mask_blur)) &&
+      paint.has_mask_blur) {
+    if (!IsValidBlurStyle(paint.mask_blur_style) ||
+        !std::isfinite(paint.mask_blur_sigma)) {
+      return kFlutterSpiInvalidArgument;
+    }
+    std::shared_ptr<DlMaskFilter> mask_filter = DlBlurMaskFilter::Make(
+        static_cast<DlBlurStyle>(paint.mask_blur_style), paint.mask_blur_sigma);
+    if (mask_filter == nullptr) {
+      return kFlutterSpiInvalidArgument;
+    }
+    result.setMaskFilter(mask_filter);
+  }
+  *out_paint = std::move(result);
+  return kFlutterSpiOk;
+}
+
+DlPaint ToDlPaint(const FlutterSpiPaint& paint) {
+  DlPaint result;
+  (void)TryToDlPaint(paint, &result);
   return result;
 }
 
