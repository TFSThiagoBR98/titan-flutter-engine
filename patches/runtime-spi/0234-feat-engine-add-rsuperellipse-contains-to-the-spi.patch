# Why: Implement the frozen scene ABI entry point with the same positive-
# bounds and raw-radii containment semantics as RSuperellipse.
diff --git a/engine/src/flutter/runtime_spi/scene/spi_canvas.cc b/engine/src/flutter/runtime_spi/scene/spi_canvas.cc
