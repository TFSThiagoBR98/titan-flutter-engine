+  auto bundle = BuildShaderBundle("Frame", 1);
+  auto shader_descriptor = MakeShaderLibraryDescriptor(bundle);
+  FlutterSpiGpuShaderLibrary* library = nullptr;
+  ASSERT_EQ(SpiGpuShaderLibraryCreate(gpu_context, &shader_descriptor, &library,
+                                      nullptr),
