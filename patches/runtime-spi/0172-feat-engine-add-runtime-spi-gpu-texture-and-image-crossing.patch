+  FlutterSpiGpuShader* shader = nullptr;
+  ASSERT_EQ(SpiGpuShaderLibraryGetShader(library, "test", &shader),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiGpuShaderRelease(shader), kFlutterSpiOk);
