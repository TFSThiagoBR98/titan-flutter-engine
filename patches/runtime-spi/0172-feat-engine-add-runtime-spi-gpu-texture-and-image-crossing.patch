+  EXPECT_EQ(SpiGpuTextureAsImage(nullptr, &image), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuTextureAsImage(nullptr, nullptr), kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuTextureGetDescriptor(nullptr, &output_descriptor),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuTextureGetDescriptor(nullptr, nullptr),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceGetCurrentImage(nullptr, &image),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceGetCurrentImage(nullptr, nullptr),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuShaderIsDirty(nullptr, &is_dirty), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuShaderIsDirty(nullptr, nullptr), kFlutterSpiInvalidArgument);
+
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto allocator =
+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  auto impeller_texture = MakeTestTexture();
+  AllowTextureDimensions(*allocator);
+  ON_CALL(*allocator, OnCreateTexture(::testing::_, true))
+      .WillByDefault(Return(impeller_texture));
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  ASSERT_EQ(SpiGpuTextureCreate(gpu_context, &descriptor, &texture),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiGpuTextureAsImage(texture, &image), kFlutterSpiOk);
+  ASSERT_EQ(SpiGpuTextureRelease(texture), kFlutterSpiOk);
+  FlutterSpiImage* failed_image = nullptr;
+  EXPECT_EQ(SpiGpuTextureAsImage(texture, &failed_image),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuTextureFromImage(gpu_context, nullptr, &texture),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuTextureFromImage(gpu_context, image, nullptr),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuTextureGetDescriptor(texture, &output_descriptor),
+            kFlutterSpiInvalidHandle);
