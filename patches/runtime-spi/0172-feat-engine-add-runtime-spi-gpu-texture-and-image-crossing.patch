+FlutterSpiResult SpiGpuTextureAsImage(FlutterSpiGpuTexture* texture,
+                                      FlutterSpiImage** out_image) {
+  if (out_image == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_image = nullptr;
+  SpiGpuTexture* texture_value = FindTexture(texture);
+  if (texture_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return SpiImageWrap(impeller::DlImageImpeller::Make(texture_value->texture()),
+                      out_image);
+}
+
+FlutterSpiResult SpiGpuTextureFromImage(FlutterSpiGpuContext* context,
+                                        FlutterSpiImage* image,
+                                        FlutterSpiGpuTexture** out_texture) {
+  if (out_texture == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_texture = nullptr;
+  std::shared_ptr<impeller::Context> context_value =
+      GetImpellerContext(context);
+  if (context_value == nullptr || image == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const sk_sp<DlImage> dl_image = SpiImageGet(image);
+  if (dl_image == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const impeller::DlImageImpeller* impeller_image = dl_image->asImpellerImage();
+  if (impeller_image == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  impeller::AiksContext aiks_context(context_value, nullptr);
+  std::shared_ptr<impeller::Texture> texture =
+      impeller_image->GetImpellerTexture(aiks_context.GetContentContext());
+  if (texture == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return InsertTexture(std::move(context_value),
+                       SpiGpuContextGetRasterTaskRunner(context),
+                       std::move(texture), out_texture);
+}
+
+FlutterSpiResult SpiGpuTextureGetDescriptor(
+    FlutterSpiGpuTexture* texture,
+    FlutterSpiGpuTextureDescriptor* out_descriptor) {
+  SpiGpuTexture* texture_value = FindTexture(texture);
+  if (texture_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_descriptor == nullptr ||
+      out_descriptor->struct_size < sizeof(size_t)) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  const size_t size = out_descriptor->struct_size;
+  const impeller::TextureDescriptor& descriptor =
+      texture_value->texture()->GetTextureDescriptor();
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, storage_mode) +
+                  sizeof(out_descriptor->storage_mode)) {
+    out_descriptor->storage_mode =
+        static_cast<int32_t>(descriptor.storage_mode);
+  }
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, format) +
+                  sizeof(out_descriptor->format)) {
+    out_descriptor->format = SpiGpuFromImpellerPixelFormat(descriptor.format);
+  }
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, width) +
+                  sizeof(out_descriptor->width)) {
+    out_descriptor->width = descriptor.size.width;
+  }
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, height) +
+                  sizeof(out_descriptor->height)) {
+    out_descriptor->height = descriptor.size.height;
+  }
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, sample_count) +
+                  sizeof(out_descriptor->sample_count)) {
+    out_descriptor->sample_count =
+        static_cast<int32_t>(descriptor.sample_count);
+  }
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, texture_type) +
+                  sizeof(out_descriptor->texture_type)) {
+    out_descriptor->texture_type = static_cast<int32_t>(descriptor.type);
+  }
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, usage) +
+                  sizeof(out_descriptor->usage)) {
+    out_descriptor->usage = 0;
+    if (descriptor.usage & impeller::TextureUsage::kRenderTarget) {
+      out_descriptor->usage |= kFlutterSpiGpuTextureUsageRenderTarget;
+    }
+    if (descriptor.usage & impeller::TextureUsage::kShaderRead) {
+      out_descriptor->usage |= kFlutterSpiGpuTextureUsageShaderRead;
+    }
+    if (descriptor.usage & impeller::TextureUsage::kShaderWrite) {
+      out_descriptor->usage |= kFlutterSpiGpuTextureUsageShaderWrite;
+    }
+  }
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, mip_level_count) +
+                  sizeof(out_descriptor->mip_level_count)) {
+    out_descriptor->mip_level_count =
+        static_cast<int32_t>(descriptor.mip_count);
+  }
+  if (size >= offsetof(FlutterSpiGpuTextureDescriptor, layer_count) +
+                  sizeof(out_descriptor->layer_count)) {
+    out_descriptor->layer_count =
+        static_cast<int32_t>(descriptor.array_layer_count);
+  }
+  return kFlutterSpiOk;
+}
