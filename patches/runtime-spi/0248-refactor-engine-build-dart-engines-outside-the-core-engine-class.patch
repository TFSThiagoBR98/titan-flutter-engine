@@ -0,0 +1,112 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/common/engine_dart.h"
+
+#include <memory>
+#include <utility>
+
+#include "flutter/common/settings.h"
+#include "flutter/lib/ui/painting/image_decoder.h"
+#include "flutter/lib/ui/painting/image_generator_registry.h"
+#include "flutter/lib/ui/snapshot_delegate.h"
+#include "flutter/runtime/runtime_controller.h"
+#include "flutter/runtime_spi/spi_runtime_backend.h"
+#include "flutter/shell/common/dart_runtime_backend_factory.h"
+#include "flutter/shell/common/dart_runtime/dart_runtime_delegate_bridge.h"
+#include "flutter/shell/common/dart_runtime/flutter_dart_runtime.h"
+
+namespace flutter {
+
+namespace {
+
+std::unique_ptr<RuntimeBackend> MakeDartRuntimeBackend(
+    RuntimeDelegate& runtime_delegate,
+    const TaskRunners& task_runners,
+    std::unique_ptr<RuntimeController> controller,
+    const Settings& settings,
+    const fml::closure& root_isolate_create_callback,
+    fml::WeakPtr<IOManager> io_manager,
+    fml::TaskRunnerAffineWeakPtr<ImageDecoder> image_decoder,
+    fml::TaskRunnerAffineWeakPtr<ImageGeneratorRegistry>
+        image_generator_registry,
+    const std::shared_ptr<fml::ConcurrentTaskRunner>&
+        concurrent_worker_task_runner) {
+  auto delegate_bridge = std::make_unique<DartRuntimeDelegateBridge>();
+  auto runtime = std::make_unique<FlutterDartRuntime>(
+      std::move(controller), std::move(delegate_bridge), settings,
+      root_isolate_create_callback);
+  auto backend = std::make_unique<SpiRuntimeBackend>(
+      runtime_delegate, task_runners, runtime->table(),
+      std::move(io_manager), std::move(image_decoder),
+      std::move(image_generator_registry),
+      fml::TaskRunnerAffineWeakPtr<SnapshotDelegate>{}, nullptr, false,
+      std::shared_future<impeller::RuntimeStageBackend>{},
+      concurrent_worker_task_runner);
+  runtime.release();
+  return backend;
+}
+
+}  // namespace
+
+std::unique_ptr<Engine> MakeDartEngine(
+    Engine::Delegate& delegate,
+    const std::shared_ptr<fml::ConcurrentTaskRunner>& image_decoder_task_runner,
+    const TaskRunners& task_runners,
+    const Settings& settings,
+    std::unique_ptr<Animator> animator,
+    const fml::WeakPtr<IOManager>& io_manager,
+    const std::shared_ptr<FontCollection>& font_collection,
+    std::unique_ptr<RuntimeController> runtime_controller,
+    const std::shared_ptr<fml::SyncSwitch>& gpu_disabled_switch) {
+  auto engine = std::make_unique<Engine>(
+      delegate, image_decoder_task_runner, task_runners, settings,
+      std::move(animator), io_manager, font_collection,
+      std::unique_ptr<RuntimeBackend>{}, gpu_disabled_switch);
+  if (runtime_controller == nullptr) {
+    return engine;
+  }
+  engine->SetRootIsolateCreateCallback();
+  engine->runtime_backend_factory_ =
+      std::make_shared<DartRuntimeBackendFactory>();
+  engine->runtime_backend_ = MakeDartRuntimeBackend(
+      *engine, task_runners, std::move(runtime_controller), settings,
+      engine->root_isolate_create_callback_, io_manager,
+      engine->image_decoder_->GetWeakPtr(),
+      engine->image_generator_registry_.GetWeakPtr(), image_decoder_task_runner);
+  return engine;
+}
+
+std::unique_ptr<Engine> MakeDartEngine(
+    Engine::Delegate& delegate,
+    DartVM& vm,
+    fml::RefPtr<const DartSnapshot> isolate_snapshot,
+    const TaskRunners& task_runners,
+    const PlatformData& platform_data,
+    const Settings& settings,
+    std::unique_ptr<Animator> animator,
+    fml::WeakPtr<IOManager> io_manager,
+    const fml::RefPtr<SkiaUnrefQueue>& unref_queue,
+    fml::TaskRunnerAffineWeakPtr<SnapshotDelegate> snapshot_delegate,
+    const std::shared_ptr<fml::SyncSwitch>& gpu_disabled_switch,
+    const std::shared_future<impeller::RuntimeStageBackend>&
+        runtime_stage_backend) {
+  auto engine = std::make_unique<Engine>(
+      delegate, vm.GetConcurrentWorkerTaskRunner(), task_runners, settings,
+      std::move(animator), io_manager, std::make_shared<FontCollection>(),
+      std::unique_ptr<RuntimeBackend>{}, gpu_disabled_switch);
+  engine->SetRootIsolateCreateCallback();
+  engine->runtime_backend_factory_ =
+      std::make_shared<DartRuntimeBackendFactory>(
+          DartVMRef::Create(engine->settings_), isolate_snapshot);
+  engine->runtime_backend_ = engine->runtime_backend_factory_->Create(
+      *engine, engine->task_runners_, platform_data, engine->settings_,
+      std::move(io_manager), unref_queue, std::move(snapshot_delegate),
+      engine->image_decoder_->GetWeakPtr(),
+      engine->image_generator_registry_.GetWeakPtr(),
+      engine->root_isolate_create_callback_, runtime_stage_backend);
+  return engine;
+}
+
+}  // namespace flutter
