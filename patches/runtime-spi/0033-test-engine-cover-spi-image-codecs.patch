+constexpr int32_t kImageWidth = 4;
+constexpr int32_t kImageHeight = 3;
+
+struct FrameCallbackState {
+  fml::AutoResetWaitableEvent completed;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  FlutterSpiImage* image = nullptr;
+  int32_t duration_ms = -1;
+  int calls = 0;
+};
+
+void CaptureFrame(void* user_data,
+                  FlutterSpiResult result,
+                  FlutterSpiImage* image,
+                  int32_t duration_ms) {
+  auto* state = static_cast<FrameCallbackState*>(user_data);
+  state->result = result;
+  state->image = image;
+  state->duration_ms = duration_ms;
+  state->calls++;
+  state->completed.Signal();
+}
+
+struct BytesCallbackState {
+  fml::AutoResetWaitableEvent completed;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  std::vector<uint8_t> bytes;
+};
+
+void CaptureBytes(void* user_data,
+                  FlutterSpiResult result,
+                  const uint8_t* bytes,
+                  size_t size) {
+  auto* state = static_cast<BytesCallbackState*>(user_data);
+  state->result = result;
+  if (bytes != nullptr) {
+    state->bytes.assign(bytes, bytes + size);
+  }
+  state->completed.Signal();
+}
+
+void PostSync(const fml::RefPtr<fml::TaskRunner>& task_runner,
+              const fml::closure& task) {
+  fml::AutoResetWaitableEvent completed;
+  task_runner->PostTask([&completed, &task] {
+    task();
+    completed.Signal();
+  });
+  completed.Wait();
+}
+
+sk_sp<SkData> MakePng(SkColor color) {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(
+          SkImageInfo::MakeN32Premul(kImageWidth, kImageHeight))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(color);
+  const auto image = SkImages::RasterFromBitmap(bitmap);
+  return image == nullptr ? nullptr : SkPngEncoder::Encode(nullptr, image.get(), {});
+}
+
+sk_sp<SkData> MakeAnimatedWebp() {
+  SkBitmap first_bitmap;
+  SkBitmap second_bitmap;
+  if (!first_bitmap.tryAllocPixels(
+          SkImageInfo::MakeN32Premul(kImageWidth, kImageHeight)) ||
+      !second_bitmap.tryAllocPixels(
+          SkImageInfo::MakeN32Premul(kImageWidth, kImageHeight))) {
+    return nullptr;
+  }
+  first_bitmap.eraseColor(SK_ColorRED);
+  second_bitmap.eraseColor(SK_ColorGREEN);
+
+  SkPixmap first_pixmap;
+  SkPixmap second_pixmap;
+  if (!first_bitmap.peekPixels(&first_pixmap) ||
+      !second_bitmap.peekPixels(&second_pixmap)) {
+    return nullptr;
+  }
+
+  const std::vector<SkEncoder::Frame> frames = {
+      {.pixmap = first_pixmap, .duration = 100},
+      {.pixmap = second_pixmap, .duration = 200},
+  };
+  SkDynamicMemoryWStream stream;
+  if (!SkWebpEncoder::EncodeAnimated(&stream, frames,
+                                     {.fCompression = SkWebpEncoder::Compression::kLossless,
+                                      .fQuality = 100.0f})) {
+    return nullptr;
+  }
+  return stream.detachAsData();
+}
