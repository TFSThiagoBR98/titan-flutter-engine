+  void StorePaintBytes(const FlutterSpiPaint& paint, DlTileMode tile_mode);
+
+  std::array<uint8_t, sizeof(FlutterSpiPaint)> paint_bytes_{};
+  std::size_t paint_bytes_size_ = 0;
+  std::size_t struct_size_ = 0;
+  DlTileMode tile_mode_ = DlTileMode::kDecal;
