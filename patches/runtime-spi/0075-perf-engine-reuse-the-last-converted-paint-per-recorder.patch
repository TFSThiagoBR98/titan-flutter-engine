 }
 
+TEST(SpiPaint, CachedPaintIsReusedForIdenticalStructs) {
+  SpiPaintCache cache;
+  const FlutterSpiPaint input = TestPaint();
+  const DlPaint* first = nullptr;
+  const DlPaint* second = nullptr;
+
+  ASSERT_EQ(cache.Convert(input, DlTileMode::kDecal, &first), kFlutterSpiOk);
+  ASSERT_EQ(cache.Convert(input, DlTileMode::kDecal, &second), kFlutterSpiOk);
+
+  EXPECT_EQ(first, second);
+}
+
+TEST(SpiPaint, CacheMissesWhenAFieldChanges) {
+  SpiPaintCache cache;
+  FlutterSpiPaint input = TestPaint();
+  const DlPaint* first = nullptr;
+  const DlPaint* second = nullptr;
+
+  ASSERT_EQ(cache.Convert(input, DlTileMode::kDecal, &first), kFlutterSpiOk);
+  const DlPaint first_paint = *first;
+  input.color.red = 0.9f;
+  ASSERT_EQ(cache.Convert(input, DlTileMode::kDecal, &second), kFlutterSpiOk);
+
+  EXPECT_NE(first_paint, *second);
+}
+
+TEST(SpiPaint, CacheMissesWhenTheShaderHandleWasReleased) {
+  FlutterSpiEngine engine = {};
+  const auto colors = TestGradientColors();
+  FlutterSpiShader* shader = nullptr;
+  ASSERT_EQ(SpiShaderLinearGradient(&engine, {1.0f, 2.0f}, {30.0f, 40.0f},
+                                    colors.data(), nullptr, colors.size(),
+                                    kFlutterSpiTileModeMirror, nullptr,
+                                    &shader),
+            kFlutterSpiOk);
+
+  SpiPaintCache cache;
+  FlutterSpiPaint input = TestPaint();
+  input.shader = shader;
+  const DlPaint* first = nullptr;
+  ASSERT_EQ(cache.Convert(input, DlTileMode::kDecal, &first), kFlutterSpiOk);
+  ASSERT_EQ(SpiShaderRelease(shader), kFlutterSpiOk);
+
+  const DlPaint* second = first;
+  EXPECT_EQ(cache.Convert(input, DlTileMode::kDecal, &second),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(second, nullptr);
+}
+
+TEST(SpiPaint, CacheIsNotPoisonedByAFailedConversion) {
+  FlutterSpiPaint paint_a = TestPaint();
+  SpiPaintCache cache;
+  const DlPaint* out_paint = nullptr;
+
+  ASSERT_EQ(cache.Convert(paint_a, DlTileMode::kDecal, &out_paint),
+            kFlutterSpiOk);
+
+  FlutterSpiEngine engine = {};
+  const auto colors = TestGradientColors();
+  FlutterSpiShader* shader = nullptr;
+  ASSERT_EQ(SpiShaderLinearGradient(
+                &engine, {1.0f, 2.0f}, {30.0f, 40.0f}, colors.data(), nullptr,
+                colors.size(), kFlutterSpiTileModeMirror, nullptr, &shader),
+            kFlutterSpiOk);
+  FlutterSpiPaint paint_b = TestPaint();
+  paint_b.shader = shader;
+  ASSERT_EQ(SpiShaderRelease(shader), kFlutterSpiOk);
+
+  EXPECT_EQ(cache.Convert(paint_b, DlTileMode::kDecal, &out_paint),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(out_paint, nullptr);
+
+  ASSERT_EQ(cache.Convert(paint_a, DlTileMode::kDecal, &out_paint),
+            kFlutterSpiOk);
+  EXPECT_EQ(*out_paint, ToDlPaint(paint_a));
+}
