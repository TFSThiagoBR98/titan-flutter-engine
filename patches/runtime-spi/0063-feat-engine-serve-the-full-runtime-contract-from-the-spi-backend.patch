+FlutterSpiResult SpiEngineApi::ComputePlatformResolvedLocale(
+    FlutterSpiEngine* engine,
+    const char* const* supported,
+    size_t count,
+    char*** out_locale,
+    size_t* out_count) {
+  if (engine == nullptr || engine->backend == nullptr || out_locale == nullptr ||
+      out_count == nullptr || (count != 0 && supported == nullptr)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_locale = nullptr;
+  *out_count = 0;
+  if (!engine->backend->HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  std::vector<std::string> supported_locales;
+  supported_locales.reserve(count);
+  for (size_t index = 0; index < count; index++) {
+    if (supported[index] == nullptr) {
+      return kFlutterSpiInvalidArgument;
+    }
+    supported_locales.emplace_back(supported[index]);
+  }
+  std::unique_ptr<std::vector<std::string>> resolved_locales =
+      engine->backend->runtime_delegate_.ComputePlatformResolvedLocale(
+          supported_locales);
+  if (resolved_locales == nullptr || resolved_locales->empty()) {
+    return resolved_locales == nullptr ? kFlutterSpiInternalError
+                                       : kFlutterSpiOk;
+  }
+  char** result = static_cast<char**>(
+      std::malloc(sizeof(char*) * resolved_locales->size()));
+  if (result == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  std::memset(result, 0, sizeof(char*) * resolved_locales->size());
+  for (size_t index = 0; index < resolved_locales->size(); index++) {
+    result[index] = AllocateString((*resolved_locales)[index]);
+    if (result[index] == nullptr) {
+      FreeStringList(engine, result, index);
+      return kFlutterSpiInternalError;
+    }
+  }
+  *out_locale = result;
+  *out_count = resolved_locales->size();
+  return kFlutterSpiOk;
+}
