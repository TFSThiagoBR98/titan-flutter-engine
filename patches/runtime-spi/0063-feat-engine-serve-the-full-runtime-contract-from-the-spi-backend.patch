+bool SpiEngineApi::AssetGet(FlutterSpiEngine* engine,
+                            const char* name,
+                            FlutterSpiMapping* out_mapping) {
+  if (out_mapping == nullptr || name == nullptr) {
+    return false;
+  }
+  *out_mapping = {};
+  if (engine == nullptr || engine->backend == nullptr ||
+      !engine->backend->HasUiThread() ||
+      engine->backend->asset_manager_ == nullptr) {
+    return false;
+  }
+  std::unique_ptr<fml::Mapping> mapping =
+      engine->backend->asset_manager_->GetAsMapping(name);
+  if (mapping == nullptr) {
+    return false;
+  }
+  auto* holder = new (std::nothrow) SpiMappingHolder{std::move(mapping)};
+  if (holder == nullptr) {
+    return false;
+  }
+  out_mapping->data = holder->mapping->GetMapping();
+  out_mapping->size = holder->mapping->GetSize();
+  out_mapping->release_user_data = holder;
+  out_mapping->release = ReleaseMapping;
+  return true;
+}
