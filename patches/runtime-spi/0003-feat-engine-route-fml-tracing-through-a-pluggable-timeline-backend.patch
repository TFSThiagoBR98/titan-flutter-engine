+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+CHECKER_PATH = Path(__file__).with_name("check_no_dart_deps.py")
+
+
+class CheckNoDartDepsTest(unittest.TestCase):
+    def run_checker(self, source: str, label: str = "//flutter/fml:fml") -> subprocess.CompletedProcess[str]:
+        with tempfile.TemporaryDirectory() as temporary_directory:
+            root = Path(temporary_directory)
+            engine_source = root / "engine/src"
+            checker = engine_source / "flutter/runtime_spi/tools/check_no_dart_deps.py"
+            checker.parent.mkdir(parents=True)
+            shutil.copyfile(CHECKER_PATH, checker)
+
+            gn = engine_source / "flutter/third_party/gn/gn"
+            gn.parent.mkdir(parents=True)
+            gn.write_text(
+                """#!/usr/bin/env python3
+import sys
+
+label = sys.argv[3]
+query = sys.argv[4]
+if query == 'sources':
+    if label == '//flutter/lib/ui:ui_core_types':
+        print('//flutter/lib/ui/window/viewport_metrics.h')
+    else:
+        print('//flutter/fml/trace_event.h')
+elif query == 'public':
+    print('*')
+else:
+    print('//flutter/third_party/dart:runtime')
+"""
+            )
+            gn.chmod(gn.stat().st_mode | stat.S_IEXEC)
+
+            source_path = engine_source / "flutter/fml/trace_event.h"
+            source_path.parent.mkdir(parents=True)
+            source_path.write_text(source)
+            ui_core_header = (
+                engine_source / "flutter/lib/ui/window/viewport_metrics.h"
+            )
+            ui_core_header.parent.mkdir(parents=True)
+            ui_core_header.write_text("")
+
+            environment = os.environ.copy()
+            return subprocess.run(
+                [
+                    sys.executable,
+                    str(checker),
+                    "--includes",
+                    "out/host_debug",
+                    label,
+                ],
+                cwd=engine_source,
+                env=environment,
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+
+    def test_forbidden_include_is_reported_with_line(self) -> None:
+        result = self.run_checker('#include "third_party/dart/runtime/include/dart_api.h"\n')
+
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("flutter/fml/trace_event.h:1", result.stdout)
+        self.assertIn("third_party/dart/runtime/include/dart_api.h", result.stdout)
+
+    def test_ui_core_types_include_is_allowed(self) -> None:
+        result = self.run_checker('#include "flutter/lib/ui/window/viewport_metrics.h"\n')
+
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_comment_with_dart_does_not_count(self) -> None:
+        result = self.run_checker('// #include "third_party/dart/runtime/include/dart_api.h"\n')
+
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
