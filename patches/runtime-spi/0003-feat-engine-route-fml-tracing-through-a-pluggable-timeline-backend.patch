new file mode 100644
index 00000000000..28c40e5a3e7
--- /dev/null
+++ b/engine/src/flutter/fml/trace_event_unittests.cc
@@ -0,0 +1,103 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/fml/trace_event.h"
+
+#include <string>
+#include <vector>
+
+#include "gtest/gtest.h"
+
+namespace fml {
+namespace tracing {
+namespace {
+
+struct RecordedEvent {
+  std::string label;
+  TimelineEventType type;
+  std::vector<std::string> argument_names;
+  std::vector<std::string> argument_values;
+};
+
+class TimelineRecorder {
+ public:
+  void Record(const char* label,
+              int64_t timestamp0,
+              int64_t timestamp1_or_id,
+              intptr_t flow_id_count,
+              const int64_t* flow_ids,
+              TimelineEventType type,
+              intptr_t argument_count,
+              const char** argument_names,
+              const char** argument_values) {
+    RecordedEvent event{.label = label, .type = type};
+    for (intptr_t index = 0; index < argument_count; index++) {
+      event.argument_names.emplace_back(argument_names[index]);
+      event.argument_values.emplace_back(argument_values[index]);
+    }
+    events.push_back(std::move(event));
+  }
+
+  std::vector<RecordedEvent> events;
+};
+
+TimelineRecorder* g_recorder = nullptr;
+
+void RecordEvent(const char* label,
+                 int64_t timestamp0,
+                 int64_t timestamp1_or_id,
+                 intptr_t flow_id_count,
+                 const int64_t* flow_ids,
+                 TimelineEventType type,
+                 intptr_t argument_count,
+                 const char** argument_names,
+                 const char** argument_values) {
+  g_recorder->Record(label, timestamp0, timestamp1_or_id, flow_id_count,
+                     flow_ids, type, argument_count, argument_names,
+                     argument_values);
+}
+
+TEST(TraceEventTest, ForwardsToInstalledBackend) {
+  TimelineRecorder recorder;
+  g_recorder = &recorder;
+  const TimelineBackend backend = {.record = RecordEvent};
+  SetTimelineBackend(&backend);
+
+  TRACE_EVENT0("flutter", "sync event");
+  TRACE_EVENT_ASYNC_BEGIN0("flutter", "async event", 42);
+  FML_TRACE_COUNTER("flutter", "counter event", 7, "value", 3);
+
+  SetTimelineBackend(nullptr);
+  g_recorder = nullptr;
+
+  ASSERT_EQ(recorder.events.size(), 4u);
+  EXPECT_EQ(recorder.events[0].label, "sync event");
+  EXPECT_EQ(recorder.events[0].type, TimelineEventType::Begin);
+  EXPECT_EQ(recorder.events[1].type, TimelineEventType::End);
+  EXPECT_EQ(recorder.events[2].label, "async event");
+  EXPECT_EQ(recorder.events[2].type, TimelineEventType::Async_Begin);
+  EXPECT_EQ(recorder.events[3].label, "counter event");
+  EXPECT_EQ(recorder.events[3].type, TimelineEventType::Counter);
+  ASSERT_EQ(recorder.events[3].argument_names.size(), 1u);
+  EXPECT_EQ(recorder.events[3].argument_names[0], "value");
+  EXPECT_EQ(recorder.events[3].argument_values[0], "3");
+}
+
+TEST(TraceEventTest, NoBackendIsANoOp) {
+  TimelineRecorder recorder;
+  g_recorder = &recorder;
+  SetTimelineBackend(nullptr);
+
+  TRACE_EVENT0("flutter", "sync event");
+  TRACE_EVENT_ASYNC_BEGIN0("flutter", "async event", 42);
+  FML_TRACE_COUNTER("flutter", "counter event", 7, "value", 3);
+
+  g_recorder = nullptr;
+
+  EXPECT_TRUE(recorder.events.empty());
+}
+
+}  // namespace
+}  // namespace tracing
+}  // namespace fml
