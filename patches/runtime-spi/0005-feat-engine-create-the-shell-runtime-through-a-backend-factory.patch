+// found in the LICENSE file.
+
+#include "flutter/shell/common/dart_runtime_backend_factory.h"
+
+#include <utility>
+
+#include "flutter/lib/ui/painting/image_decoder.h"
+#include "flutter/lib/ui/painting/image_generator_registry.h"
+#include "flutter/lib/ui/snapshot_delegate.h"
+#include "flutter/lib/ui/ui_dart_state.h"
+#include "flutter/runtime/runtime_controller.h"
+#include "flutter/runtime/runtime_delegate.h"
+#include "flutter/shell/common/shell_io_manager.h"
+
+namespace flutter {
+
+DartRuntimeBackendFactory::DartRuntimeBackendFactory(
+    DartVMRef vm,
+    fml::RefPtr<const DartSnapshot> isolate_snapshot)
+    : vm_(std::move(vm)), isolate_snapshot_(std::move(isolate_snapshot)) {}
+
+DartRuntimeBackendFactory::~DartRuntimeBackendFactory() = default;
+
+std::unique_ptr<RuntimeBackend> DartRuntimeBackendFactory::Create(
+    RuntimeDelegate& runtime_delegate,
+    const TaskRunners& task_runners,
+    const PlatformData& platform_data,
+    const Settings& settings,
+    fml::RefPtr<const DartSnapshot> isolate_snapshot,
+    fml::WeakPtr<IOManager> io_manager,
+    fml::RefPtr<SkiaUnrefQueue> unref_queue,
+    fml::TaskRunnerAffineWeakPtr<SnapshotDelegate> snapshot_delegate,
+    fml::TaskRunnerAffineWeakPtr<ImageDecoder> image_decoder,
+    fml::TaskRunnerAffineWeakPtr<ImageGeneratorRegistry>
+        image_generator_registry,
+    const std::shared_future<impeller::RuntimeStageBackend>&
+        runtime_stage_backend) {
+  if (isolate_snapshot) {
+    isolate_snapshot_ = std::move(isolate_snapshot);
+  }
+
+  return std::make_unique<RuntimeController>(
+      runtime_delegate,                     // runtime delegate
+      vm_.get(),                            // VM
+      isolate_snapshot_,                    // isolate snapshot
+      settings.idle_notification_callback,  // idle callback
+      platform_data,                        // platform data
+      settings.isolate_create_callback,     // isolate callback
+      settings.isolate_shutdown_callback,   // shutdown callback
+      settings.persistent_isolate_data,     // persistent data
+      UIDartState::Context{
+          task_runners,                                  // task runners
+          std::move(snapshot_delegate),                  // snapshot delegate
+          std::move(io_manager),                         // IO manager
+          std::move(unref_queue),                        // Skia unref queue
+          std::move(image_decoder),                      // image decoder
+          std::move(image_generator_registry),           // image generators
+          settings.advisory_script_uri,                  // script URI
+          settings.advisory_script_entrypoint,           // entrypoint
+          settings.skia_deterministic_rendering_on_cpu,  // deterministic
+          vm_->GetConcurrentWorkerTaskRunner(),          // worker runner
+          runtime_stage_backend,                         // runtime stage
+          settings.enable_impeller,                      // Impeller
+          settings.enable_flutter_gpu                    // Flutter GPU
+      });
+}
+
+DartVM* DartRuntimeBackendFactory::GetDartVM() const {
+  return const_cast<DartVM*>(vm_.get());
+}
+
+}  // namespace flutter
