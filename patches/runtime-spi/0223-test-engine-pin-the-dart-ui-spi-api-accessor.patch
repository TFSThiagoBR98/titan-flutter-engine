@@ -0,0 +1,43 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/lib/ui/spi_api.h"
+
+#include "flutter/testing/testing.h"
+
+namespace flutter::testing {
+namespace {
+
+FlutterSpiEngineApi MakeTestApi(const FlutterSpiSceneApi* scene) {
+  FlutterSpiEngineApi api{};
+  api.struct_size = sizeof(api);
+  api.version_major = FLUTTER_SPI_VERSION_MAJOR;
+  api.version_minor = FLUTTER_SPI_VERSION_MINOR;
+  api.scene = scene;
+  return api;
+}
+
+TEST(SpiApiTest, InstalledCopyOutlivesTheSource) {
+  const FlutterSpiSceneApi* original_scene = nullptr;
+  {
+    FlutterSpiSceneApi source_scene_api{};
+    FlutterSpiEngineApi source_api = MakeTestApi(&source_scene_api);
+    original_scene = source_api.scene;
+    InstallSpiApi(source_api);
+  }
+
+  EXPECT_EQ(SpiApi().scene, original_scene);
+}
+
+TEST(SpiApiTest, SecondInstallKeepsTheFirst) {
+  FlutterSpiSceneApi first_scene_api{};
+  FlutterSpiSceneApi second_scene_api{};
+  InstallSpiApi(MakeTestApi(&first_scene_api));
+  InstallSpiApi(MakeTestApi(&second_scene_api));
+
+  EXPECT_EQ(SpiApi().scene, &first_scene_api);
+}
+
+}  // namespace
+}  // namespace flutter::testing
