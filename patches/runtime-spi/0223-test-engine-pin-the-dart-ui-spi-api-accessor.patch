+#ifndef FLUTTER_LIB_UI_SPI_API_H_
+#define FLUTTER_LIB_UI_SPI_API_H_
+
+#include "flutter/runtime_spi/include/flutter_runtime_spi.h"
+
+namespace flutter {
+
+// Instalada pelo runtime Dart antes de qualquer isolate rodar; todas as chamadas devem passar a mesma ABI (major/minor).
+// Guarda uma cópia: as sub-tabelas do core são estáticas, a struct de cada engine não é.
+void InstallSpiApi(const FlutterSpiEngineApi& api);
+
+// FML_DCHECK de que InstallSpiApi rodou.
+const FlutterSpiEngineApi& SpiApi();
+
+}  // namespace flutter
+
+#endif  // FLUTTER_LIB_UI_SPI_API_H_
