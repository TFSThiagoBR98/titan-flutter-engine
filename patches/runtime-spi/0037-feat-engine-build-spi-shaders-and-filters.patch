@@ -0,0 +1,180 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/effects/spi_image_filter.h"
+
+#include <cmath>
+#include <cstdint>
+#include <memory>
+
+#include "flutter/display_list/dl_sampling_options.h"
+#include "flutter/display_list/dl_tile_mode.h"
+#include "flutter/runtime_spi/effects/spi_color_filter.h"
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+
+namespace flutter {
+namespace {
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+class SpiImageFilter final {
+ public:
+  explicit SpiImageFilter(std::shared_ptr<DlImageFilter> filter)
+      : filter_(std::move(filter)) {}
+
+  const std::shared_ptr<DlImageFilter>& filter() const { return filter_; }
+
+ private:
+  std::shared_ptr<DlImageFilter> filter_;
+};
+
+SpiHandleTable<SpiImageFilter>& ImageFilters() {
+  static SpiHandleTable<SpiImageFilter> filters;
+  return filters;
+}
+
+std::shared_ptr<SpiImageFilter> FindImageFilter(FlutterSpiImageFilter* filter) {
+  return ImageFilters().Find(HandleValue(filter));
+}
+
+bool IsValidTileMode(int32_t tile_mode) {
+  return tile_mode >= kFlutterSpiTileModeClamp &&
+         tile_mode <= kFlutterSpiTileModeDecal;
+}
+
+bool IsFinite(float value) {
+  return std::isfinite(value);
+}
+
+DlImageSampling SamplingFromIndex(int32_t filter_quality) {
+  if (filter_quality <= kFlutterSpiFilterQualityNone) {
+    return DlImageSampling::kNearestNeighbor;
+  }
+  if (filter_quality == kFlutterSpiFilterQualityLow) {
+    return DlImageSampling::kLinear;
+  }
+  if (filter_quality == kFlutterSpiFilterQualityMedium) {
+    return DlImageSampling::kMipmapLinear;
+  }
+  return DlImageSampling::kCubic;
+}
+
+FlutterSpiResult StoreImageFilter(std::shared_ptr<DlImageFilter> filter,
+                                  FlutterSpiImageFilter** out_filter) {
+  if (filter == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  *out_filter = MakeHandle<FlutterSpiImageFilter>(ImageFilters().Insert(
+      std::make_shared<SpiImageFilter>(std::move(filter))));
+  return kFlutterSpiOk;
+}
+
+}  // namespace
+
+FlutterSpiResult SpiImageFilterBlur(FlutterSpiEngine* engine,
+                                    float sigma_x,
+                                    float sigma_y,
+                                    int32_t tile_mode,
+                                    FlutterSpiImageFilter** out_filter) {
+  if (out_filter == nullptr || !IsFinite(sigma_x) || !IsFinite(sigma_y) ||
+      sigma_x < 0.0f || sigma_y < 0.0f || !IsValidTileMode(tile_mode)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreImageFilter(
+      DlImageFilter::MakeBlur(sigma_x, sigma_y,
+                              static_cast<DlTileMode>(tile_mode)),
+      out_filter);
+}
+
+FlutterSpiResult SpiImageFilterDilate(FlutterSpiEngine* engine,
+                                      float radius_x,
+                                      float radius_y,
+                                      FlutterSpiImageFilter** out_filter) {
+  if (out_filter == nullptr || !IsFinite(radius_x) || !IsFinite(radius_y) ||
+      radius_x < 0.0f || radius_y < 0.0f) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreImageFilter(DlImageFilter::MakeDilate(radius_x, radius_y),
+                          out_filter);
+}
+
+FlutterSpiResult SpiImageFilterErode(FlutterSpiEngine* engine,
+                                     float radius_x,
+                                     float radius_y,
+                                     FlutterSpiImageFilter** out_filter) {
+  if (out_filter == nullptr || !IsFinite(radius_x) || !IsFinite(radius_y) ||
+      radius_x < 0.0f || radius_y < 0.0f) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreImageFilter(DlImageFilter::MakeErode(radius_x, radius_y),
+                          out_filter);
+}
+
+FlutterSpiResult SpiImageFilterMatrix(FlutterSpiEngine* engine,
+                                      const FlutterSpiMatrix* matrix,
+                                      int32_t filter_quality,
+                                      FlutterSpiImageFilter** out_filter) {
+  if (matrix == nullptr || out_filter == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  DlMatrix dl_matrix;
+  if (!ToDlMatrix(*matrix, &dl_matrix)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreImageFilter(
+      DlImageFilter::MakeMatrix(dl_matrix, SamplingFromIndex(filter_quality)),
+      out_filter);
+}
+
+FlutterSpiResult SpiImageFilterFromColorFilter(
+    FlutterSpiEngine* engine,
+    FlutterSpiColorFilter* color_filter,
+    FlutterSpiImageFilter** out_filter) {
+  if (out_filter == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto dl_filter = SpiColorFilterGet(color_filter);
+  if (dl_filter == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return StoreImageFilter(DlImageFilter::MakeColorFilter(dl_filter), out_filter);
+}
+
+FlutterSpiResult SpiImageFilterCompose(FlutterSpiEngine* engine,
+                                       FlutterSpiImageFilter* outer,
+                                       FlutterSpiImageFilter* inner,
+                                       FlutterSpiImageFilter** out_filter) {
+  if (out_filter == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto outer_filter = SpiImageFilterGet(outer);
+  const auto inner_filter = SpiImageFilterGet(inner);
+  if (outer_filter == nullptr || inner_filter == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return StoreImageFilter(
+      DlImageFilter::MakeCompose(outer_filter, inner_filter), out_filter);
+}
+
+FlutterSpiResult SpiImageFilterRelease(FlutterSpiImageFilter* filter) {
+  return ImageFilters().Release(HandleValue(filter)) ? kFlutterSpiOk
+                                                       : kFlutterSpiInvalidHandle;
+}
+
+std::shared_ptr<DlImageFilter> SpiImageFilterGet(FlutterSpiImageFilter* filter) {
+  const auto filter_value = FindImageFilter(filter);
+  return filter_value == nullptr ? nullptr : filter_value->filter();
+}
+
+}  // namespace flutter
+
