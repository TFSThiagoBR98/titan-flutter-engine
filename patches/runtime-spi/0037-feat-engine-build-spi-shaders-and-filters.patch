@@ -0,0 +1,292 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/effects/spi_shader.h"
+
+#include <cmath>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+#include "flutter/display_list/dl_sampling_options.h"
+#include "flutter/display_list/dl_tile_mode.h"
+#include "flutter/runtime_spi/image/spi_image.h"
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+
+namespace flutter {
+namespace {
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+class SpiShader final {
+ public:
+  explicit SpiShader(std::shared_ptr<DlColorSource> shader)
+      : shader_(std::move(shader)) {}
+
+  const std::shared_ptr<DlColorSource>& shader() const { return shader_; }
+
+ private:
+  std::shared_ptr<DlColorSource> shader_;
+};
+
+SpiHandleTable<SpiShader>& Shaders() {
+  static SpiHandleTable<SpiShader> shaders;
+  return shaders;
+}
+
+std::shared_ptr<SpiShader> FindShader(FlutterSpiShader* shader) {
+  return Shaders().Find(HandleValue(shader));
+}
+
+bool IsValidTileMode(int32_t tile_mode) {
+  return tile_mode >= kFlutterSpiTileModeClamp &&
+         tile_mode <= kFlutterSpiTileModeDecal;
+}
+
+bool IsFinite(const FlutterSpiPoint& point) {
+  return std::isfinite(point.x) && std::isfinite(point.y);
+}
+
+bool IsFinite(float value) {
+  return std::isfinite(value);
+}
+
+FlutterSpiResult PrepareGradient(
+    const FlutterSpiColor* colors,
+    const float* stops,
+    size_t count,
+    int32_t tile_mode,
+    std::vector<DlColor>* dl_colors,
+    DlTileMode* dl_tile_mode) {
+  if (colors == nullptr || count < 2 || count > UINT32_MAX ||
+      (stops == nullptr && count != 2) ||
+      (stops != nullptr && !std::isfinite(stops[0]))) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!IsValidTileMode(tile_mode)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (stops != nullptr) {
+    for (size_t index = 1; index < count; index++) {
+      if (!std::isfinite(stops[index])) {
+        return kFlutterSpiInvalidArgument;
+      }
+    }
+  }
+  dl_colors->reserve(count);
+  for (size_t index = 0; index < count; index++) {
+    dl_colors->push_back(ToDlColor(colors[index]));
+  }
+  *dl_tile_mode = static_cast<DlTileMode>(tile_mode);
+  return kFlutterSpiOk;
+}
+
+DlImageSampling SamplingFromIndex(int32_t filter_quality) {
+  if (filter_quality <= kFlutterSpiFilterQualityNone) {
+    return DlImageSampling::kNearestNeighbor;
+  }
+  if (filter_quality == kFlutterSpiFilterQualityLow) {
+    return DlImageSampling::kLinear;
+  }
+  if (filter_quality == kFlutterSpiFilterQualityMedium) {
+    return DlImageSampling::kMipmapLinear;
+  }
+  return DlImageSampling::kCubic;
+}
+
+FlutterSpiResult StoreShader(std::shared_ptr<DlColorSource> shader,
+                             FlutterSpiShader** out_shader) {
+  if (shader == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  *out_shader = MakeHandle<FlutterSpiShader>(
+      Shaders().Insert(std::make_shared<SpiShader>(std::move(shader))));
+  return kFlutterSpiOk;
+}
+
+}  // namespace
+
+FlutterSpiResult SpiShaderLinearGradient(
+    FlutterSpiEngine* engine,
+    FlutterSpiPoint from,
+    FlutterSpiPoint to,
+    const FlutterSpiColor* colors,
+    const float* stops,
+    size_t count,
+    int32_t tile_mode,
+    const FlutterSpiMatrix* matrix,
+    FlutterSpiShader** out_shader) {
+  if (out_shader == nullptr || !IsFinite(from) || !IsFinite(to)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::vector<DlColor> dl_colors;
+  DlTileMode dl_tile_mode;
+  const FlutterSpiResult result = PrepareGradient(
+      colors, stops, count, tile_mode, &dl_colors, &dl_tile_mode);
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  DlMatrix dl_matrix;
+  if (matrix != nullptr && !ToDlMatrix(*matrix, &dl_matrix)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreShader(
+      DlColorSource::MakeLinear(
+          {from.x, from.y}, {to.x, to.y}, count, dl_colors.data(), stops,
+          dl_tile_mode, matrix == nullptr ? nullptr : &dl_matrix),
+      out_shader);
+}
+
+FlutterSpiResult SpiShaderRadialGradient(
+    FlutterSpiEngine* engine,
+    FlutterSpiPoint center,
+    float radius,
+    const FlutterSpiColor* colors,
+    const float* stops,
+    size_t count,
+    int32_t tile_mode,
+    const FlutterSpiMatrix* matrix,
+    FlutterSpiShader** out_shader) {
+  if (out_shader == nullptr || !IsFinite(center) || !IsFinite(radius)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::vector<DlColor> dl_colors;
+  DlTileMode dl_tile_mode;
+  const FlutterSpiResult result = PrepareGradient(
+      colors, stops, count, tile_mode, &dl_colors, &dl_tile_mode);
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  DlMatrix dl_matrix;
+  if (matrix != nullptr && !ToDlMatrix(*matrix, &dl_matrix)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreShader(
+      DlColorSource::MakeRadial(
+          {center.x, center.y}, radius, count, dl_colors.data(), stops,
+          dl_tile_mode, matrix == nullptr ? nullptr : &dl_matrix),
+      out_shader);
+}
+
+FlutterSpiResult SpiShaderConicalGradient(
+    FlutterSpiEngine* engine,
+    FlutterSpiPoint start,
+    float start_radius,
+    FlutterSpiPoint end,
+    float end_radius,
+    const FlutterSpiColor* colors,
+    const float* stops,
+    size_t count,
+    int32_t tile_mode,
+    const FlutterSpiMatrix* matrix,
+    FlutterSpiShader** out_shader) {
+  if (out_shader == nullptr || !IsFinite(start) || !IsFinite(end) ||
+      !IsFinite(start_radius) || !IsFinite(end_radius)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::vector<DlColor> dl_colors;
+  DlTileMode dl_tile_mode;
+  const FlutterSpiResult result = PrepareGradient(
+      colors, stops, count, tile_mode, &dl_colors, &dl_tile_mode);
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  DlMatrix dl_matrix;
+  if (matrix != nullptr && !ToDlMatrix(*matrix, &dl_matrix)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreShader(
+      DlColorSource::MakeConical(
+          {start.x, start.y}, start_radius, {end.x, end.y}, end_radius, count,
+          dl_colors.data(), stops, dl_tile_mode,
+          matrix == nullptr ? nullptr : &dl_matrix),
+      out_shader);
+}
+
+FlutterSpiResult SpiShaderSweepGradient(
+    FlutterSpiEngine* engine,
+    FlutterSpiPoint center,
+    float start_angle,
+    float end_angle,
+    const FlutterSpiColor* colors,
+    const float* stops,
+    size_t count,
+    int32_t tile_mode,
+    const FlutterSpiMatrix* matrix,
+    FlutterSpiShader** out_shader) {
+  if (out_shader == nullptr || !IsFinite(center) || !IsFinite(start_angle) ||
+      !IsFinite(end_angle)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::vector<DlColor> dl_colors;
+  DlTileMode dl_tile_mode;
+  const FlutterSpiResult result = PrepareGradient(
+      colors, stops, count, tile_mode, &dl_colors, &dl_tile_mode);
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  DlMatrix dl_matrix;
+  if (matrix != nullptr && !ToDlMatrix(*matrix, &dl_matrix)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreShader(
+      DlColorSource::MakeSweep(
+          {center.x, center.y},
+          start_angle * 180.0f / static_cast<float>(M_PI),
+          end_angle * 180.0f / static_cast<float>(M_PI), count, dl_colors.data(),
+          stops, dl_tile_mode, matrix == nullptr ? nullptr : &dl_matrix),
+      out_shader);
+}
+
+FlutterSpiResult SpiShaderImage(FlutterSpiEngine* engine,
+                                FlutterSpiImage* image,
+                                int32_t tile_mode_x,
+                                int32_t tile_mode_y,
+                                int32_t filter_quality,
+                                const FlutterSpiMatrix* matrix,
+                                FlutterSpiShader** out_shader) {
+  if (out_shader == nullptr || image == nullptr || matrix == nullptr ||
+      filter_quality < -1 || !IsValidTileMode(tile_mode_x) ||
+      !IsValidTileMode(tile_mode_y)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const sk_sp<DlImage> dl_image = SpiImageGet(image);
+  if (dl_image == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  DlMatrix dl_matrix;
+  if (!ToDlMatrix(*matrix, &dl_matrix)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const DlImageSampling sampling = filter_quality == -1
+                                       ? DlImageSampling::kLinear
+                                       : SamplingFromIndex(filter_quality);
+  return StoreShader(
+      DlColorSource::MakeImage(
+          dl_image, static_cast<DlTileMode>(tile_mode_x),
+          static_cast<DlTileMode>(tile_mode_y), sampling, &dl_matrix),
+      out_shader);
+}
+
+FlutterSpiResult SpiShaderRelease(FlutterSpiShader* shader) {
+  return Shaders().Release(HandleValue(shader)) ? kFlutterSpiOk
+                                                 : kFlutterSpiInvalidHandle;
+}
+
+std::shared_ptr<DlColorSource> SpiShaderGet(FlutterSpiShader* shader) {
+  const auto shader_value = FindShader(shader);
+  return shader_value == nullptr ? nullptr : shader_value->shader();
+}
+
+}  // namespace flutter
+
