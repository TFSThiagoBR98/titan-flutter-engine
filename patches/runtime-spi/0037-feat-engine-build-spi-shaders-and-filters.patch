+                colors.size(), kFlutterSpiTileModeMirror, nullptr, &shader),
+            kFlutterSpiOk);
+
+  const auto expected = DlColorSource::MakeConical(
+      {1.0f, 2.0f}, 3.0f, {10.0f, 20.0f}, 6.0f, dl_colors.size(),
+      dl_colors.data(), stops.data(), DlTileMode::kMirror);
+  EXPECT_EQ(*SpiShaderGet(shader), *expected);
+  EXPECT_EQ(SpiShaderRelease(shader), kFlutterSpiOk);
+}
