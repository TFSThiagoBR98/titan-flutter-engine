+  ASSERT_EQ(SpiImageFilterCompose(&engine, outer, inner, &composed),
+            kFlutterSpiOk);
+  EXPECT_EQ(*SpiImageFilterGet(composed),
+            *DlImageFilter::MakeCompose(SpiImageFilterGet(outer),
+                                         SpiImageFilterGet(inner)));
+  EXPECT_EQ(SpiImageFilterRelease(composed), kFlutterSpiOk);
+  EXPECT_EQ(SpiImageFilterRelease(inner), kFlutterSpiOk);
+  EXPECT_EQ(SpiImageFilterRelease(outer), kFlutterSpiOk);
+}
+
+TEST(SpiShader, RejectsMismatchedStops) {
+  FlutterSpiEngine engine = TestEngine();
+  const auto colors = TestColors();
+  FlutterSpiShader* shader = nullptr;
+
+  EXPECT_EQ(SpiShaderLinearGradient(
+                &engine, {0.0f, 0.0f}, {1.0f, 1.0f}, colors.data(), nullptr,
+                3, kFlutterSpiTileModeClamp, nullptr, &shader),
+            kFlutterSpiInvalidArgument);
+}
+
+TEST(SpiImageFilter, RejectsNonFiniteMatrix) {
+  FlutterSpiEngine engine = TestEngine();
+  FlutterSpiMatrix matrix = TestMatrix();
+  matrix.m[4] = NAN;
+  FlutterSpiImageFilter* filter = nullptr;
+
+  EXPECT_EQ(SpiImageFilterMatrix(&engine, &matrix,
+                                 kFlutterSpiFilterQualityMedium, &filter),
+            kFlutterSpiInvalidArgument);
+}
+
+TEST(SpiImageFilter, RejectsNegativeBlurSigma) {
+  FlutterSpiEngine engine = TestEngine();
+  FlutterSpiImageFilter* filter = nullptr;
+
+  EXPECT_EQ(SpiImageFilterBlur(&engine, -1.0f, 2.0f,
+                               kFlutterSpiTileModeClamp, &filter),
+            kFlutterSpiInvalidArgument);
+}
+
+TEST(SpiEffects, RejectsHandleOfAnotherType) {
+  FlutterSpiEngine engine = TestEngine();
+  FlutterSpiColorFilter* color_filter = nullptr;
+  ASSERT_EQ(SpiColorFilterSrgbToLinearGamma(&engine, &color_filter),
+            kFlutterSpiOk);
+
+  EXPECT_EQ(SpiShaderGet(reinterpret_cast<FlutterSpiShader*>(color_filter)),
+            nullptr);
+  EXPECT_EQ(SpiColorFilterRelease(color_filter), kFlutterSpiOk);
+}
+
+}  // namespace
+}  // namespace flutter::testing
