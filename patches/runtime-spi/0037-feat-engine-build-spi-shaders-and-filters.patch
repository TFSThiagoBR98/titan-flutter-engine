+#include "third_party/skia/include/core/SkImage.h"
+
+namespace flutter::testing {
+namespace {
+
+FlutterSpiEngine TestEngine() {
+  return {};
+}
+
+std::array<FlutterSpiColor, 3> TestColors() {
+  return {{
+      {.red = 1.0f, .green = 0.0f, .blue = 0.0f, .alpha = 1.0f,
+       .color_space = kFlutterSpiColorSpaceSRGB},
+      {.red = 0.0f, .green = 1.0f, .blue = 0.0f, .alpha = 1.0f,
+       .color_space = kFlutterSpiColorSpaceSRGB},
+      {.red = 0.0f, .green = 0.0f, .blue = 1.0f, .alpha = 1.0f,
+       .color_space = kFlutterSpiColorSpaceSRGB},
+  }};
+}
+
+std::array<float, 3> TestStops() {
+  return {0.0f, 0.35f, 1.0f};
+}
+
+FlutterSpiMatrix TestMatrix() {
+  FlutterSpiMatrix matrix = {};
+  for (size_t index = 0; index < 16; index++) {
+    matrix.m[index] = static_cast<float>(index + 1);
+  }
+  return matrix;
+}
+
+std::array<DlColor, 3> ToDlColors(
+    const std::array<FlutterSpiColor, 3>& colors) {
+  return {ToDlColor(colors[0]), ToDlColor(colors[1]), ToDlColor(colors[2])};
+}
+
+sk_sp<DlImage> MakeTestImage() {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(4, 3))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(SK_ColorBLUE);
+  bitmap.setImmutable();
+  return DlImageSkia::Make(SkImages::RasterFromBitmap(bitmap));
+}
+
+TEST(SpiShader, LinearMatchesDartUi) {
+  FlutterSpiEngine engine = TestEngine();
+  const auto colors = TestColors();
+  const auto stops = TestStops();
+  const auto dl_colors = ToDlColors(colors);
+  const FlutterSpiPoint from = {.x = 1.0f, .y = 2.0f};
+  const FlutterSpiPoint to = {.x = 30.0f, .y = 40.0f};
+  const FlutterSpiMatrix matrix = TestMatrix();
+
+  for (int32_t tile_mode = kFlutterSpiTileModeClamp;
+       tile_mode <= kFlutterSpiTileModeDecal; tile_mode++) {
+    for (const FlutterSpiMatrix* matrix_ptr :
+         std::array<const FlutterSpiMatrix*, 2>{nullptr, &matrix}) {
+      FlutterSpiShader* shader = nullptr;
+      ASSERT_EQ(SpiShaderLinearGradient(
+                    &engine, from, to, colors.data(), stops.data(),
+                    colors.size(), tile_mode, matrix_ptr, &shader),
+                kFlutterSpiOk);
+      ASSERT_NE(shader, nullptr);
+
+      DlMatrix dl_matrix;
+      ASSERT_TRUE(matrix_ptr == nullptr || ToDlMatrix(*matrix_ptr, &dl_matrix));
+      const auto expected = DlColorSource::MakeLinear(
+          {from.x, from.y}, {to.x, to.y}, dl_colors.size(), dl_colors.data(),
+          stops.data(), static_cast<DlTileMode>(tile_mode),
+          matrix_ptr == nullptr ? nullptr : &dl_matrix);
+      ASSERT_NE(SpiShaderGet(shader), nullptr);
+      EXPECT_EQ(*SpiShaderGet(shader), *expected);
+      EXPECT_EQ(SpiShaderRelease(shader), kFlutterSpiOk);
+    }
+  }
+}
+
+TEST(SpiShader, RadialMatchesDartUi) {
+  FlutterSpiEngine engine = TestEngine();
+  const auto colors = TestColors();
+  const auto stops = TestStops();
+  const auto dl_colors = ToDlColors(colors);
+  const FlutterSpiPoint center = {.x = 5.0f, .y = 6.0f};
+  const FlutterSpiMatrix matrix = TestMatrix();
+
+  for (int32_t tile_mode = kFlutterSpiTileModeClamp;
+       tile_mode <= kFlutterSpiTileModeDecal; tile_mode++) {
+    FlutterSpiShader* shader = nullptr;
+    ASSERT_EQ(SpiShaderRadialGradient(
+                  &engine, center, 12.0f, colors.data(), stops.data(),
+                  colors.size(), tile_mode, &matrix, &shader),
+              kFlutterSpiOk);
+
+    DlMatrix dl_matrix;
+    ASSERT_TRUE(ToDlMatrix(matrix, &dl_matrix));
+    const auto expected = DlColorSource::MakeRadial(
+        {center.x, center.y}, 12.0f, dl_colors.size(), dl_colors.data(),
+        stops.data(), static_cast<DlTileMode>(tile_mode), &dl_matrix);
+    EXPECT_EQ(*SpiShaderGet(shader), *expected);
+    EXPECT_EQ(SpiShaderRelease(shader), kFlutterSpiOk);
+  }
+}
+
+TEST(SpiShader, ConicalMatchesDartUi) {
