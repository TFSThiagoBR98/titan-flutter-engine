+  const auto stops = TestStops();
+  const auto dl_colors = ToDlColors(colors);
+
+  FlutterSpiShader* shader = nullptr;
+  ASSERT_EQ(SpiShaderSweepGradient(
+                &engine, {.x = 5.0f, .y = 6.0f}, 0.25f, 2.5f,
+                colors.data(), stops.data(), colors.size(),
+                kFlutterSpiTileModeRepeated, nullptr, &shader),
+            kFlutterSpiOk);
+
+  const auto expected = DlColorSource::MakeSweep(
+      {5.0f, 6.0f}, 0.25f * 180.0f / static_cast<float>(M_PI),
