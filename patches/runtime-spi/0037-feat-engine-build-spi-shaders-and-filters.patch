+++ b/engine/src/flutter/runtime_spi/effects/spi_color_filter.cc
@@ -0,0 +1,131 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/effects/spi_color_filter.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <memory>
+
+#include "flutter/display_list/dl_blend_mode.h"
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+
+namespace flutter {
+namespace {
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+class SpiColorFilter final {
+ public:
+  explicit SpiColorFilter(std::shared_ptr<const DlColorFilter> filter)
+      : filter_(std::move(filter)) {}
+
+  const std::shared_ptr<const DlColorFilter>& filter() const { return filter_; }
+
+ private:
+  std::shared_ptr<const DlColorFilter> filter_;
+};
+
+SpiHandleTable<SpiColorFilter>& ColorFilters() {
+  static SpiHandleTable<SpiColorFilter> filters;
+  return filters;
+}
+
+std::shared_ptr<SpiColorFilter> FindColorFilter(FlutterSpiColorFilter* filter) {
+  return ColorFilters().Find(HandleValue(filter));
+}
+
+bool IsValidBlendMode(int32_t blend_mode) {
+  return blend_mode >= kFlutterSpiBlendModeClear &&
+         blend_mode <= kFlutterSpiBlendModeLuminosity;
+}
+
+FlutterSpiResult StoreColorFilter(
+    std::shared_ptr<const DlColorFilter> filter,
+    FlutterSpiColorFilter** out_filter) {
+  if (filter == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  *out_filter = MakeHandle<FlutterSpiColorFilter>(ColorFilters().Insert(
+      std::make_shared<SpiColorFilter>(std::move(filter))));
+  return kFlutterSpiOk;
+}
+
+}  // namespace
+
+FlutterSpiResult SpiColorFilterMode(FlutterSpiEngine* engine,
+                                    FlutterSpiColor color,
+                                    int32_t blend_mode,
+                                    FlutterSpiColorFilter** out_filter) {
+  if (out_filter == nullptr || !IsValidBlendMode(blend_mode)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreColorFilter(
+      DlColorFilter::MakeBlend(ToDlColor(color),
+                               static_cast<DlBlendMode>(blend_mode)),
+      out_filter);
+}
+
+FlutterSpiResult SpiColorFilterMatrix(FlutterSpiEngine* engine,
+                                      const float matrix[20],
+                                      FlutterSpiColorFilter** out_filter) {
+  if (matrix == nullptr || out_filter == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  float normalized_matrix[20];
+  std::copy(matrix, matrix + 20, normalized_matrix);
+  for (size_t index = 0; index < 20; index++) {
+    if (!std::isfinite(normalized_matrix[index])) {
+      return kFlutterSpiInvalidArgument;
+    }
+  }
+  normalized_matrix[4] /= 255.0f;
+  normalized_matrix[9] /= 255.0f;
+  normalized_matrix[14] /= 255.0f;
+  normalized_matrix[19] /= 255.0f;
+  return StoreColorFilter(DlColorFilter::MakeMatrix(normalized_matrix),
+                          out_filter);
+}
+
+FlutterSpiResult SpiColorFilterLinearToSrgbGamma(
+    FlutterSpiEngine* engine,
+    FlutterSpiColorFilter** out_filter) {
+  if (out_filter == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreColorFilter(DlColorFilter::MakeLinearToSrgbGamma(), out_filter);
+}
+
+FlutterSpiResult SpiColorFilterSrgbToLinearGamma(
+    FlutterSpiEngine* engine,
+    FlutterSpiColorFilter** out_filter) {
+  if (out_filter == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StoreColorFilter(DlColorFilter::MakeSrgbToLinearGamma(), out_filter);
+}
+
+FlutterSpiResult SpiColorFilterRelease(FlutterSpiColorFilter* filter) {
+  return ColorFilters().Release(HandleValue(filter)) ? kFlutterSpiOk
+                                                      : kFlutterSpiInvalidHandle;
+}
+
+std::shared_ptr<const DlColorFilter> SpiColorFilterGet(
+    FlutterSpiColorFilter* filter) {
+  const auto filter_value = FindColorFilter(filter);
+  return filter_value == nullptr ? nullptr : filter_value->filter();
+}
+
+}  // namespace flutter
+
