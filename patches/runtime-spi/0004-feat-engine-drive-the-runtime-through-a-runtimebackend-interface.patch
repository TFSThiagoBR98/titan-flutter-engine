+TEST_F(EngineTest, RenderFromFakeBackendReachesAnimator) {
+  PostUITaskSync([this] {
+    MockAnimatorDelegate animator_delegate;
+    fml::AutoResetWaitableEvent draw_latch;
+    std::unique_ptr<Engine> engine;
+    auto animator = std::make_unique<Animator>(
+        animator_delegate, task_runners_,
+        std::make_unique<testing::ConstantFiringVsyncWaiter>(task_runners_));
+    auto fake_backend = std::make_unique<FakeRuntimeBackend>(task_runners_);
+    auto* backend = fake_backend.get();
+
+    EXPECT_CALL(animator_delegate, OnAnimatorBeginFrame)
+        .WillOnce([&engine](fml::TimePoint frame_time, uint64_t frame_number) {
+          engine->BeginFrame(frame_time, frame_number);
+        });
+    EXPECT_CALL(animator_delegate, OnAnimatorDraw)
+        .WillOnce([&draw_latch](std::shared_ptr<FramePipeline> pipeline) {
+          pipeline->Consume([&](std::unique_ptr<FrameItem> item) {
+            ASSERT_EQ(item->layer_tree_tasks.size(), 1u);
+            EXPECT_EQ(item->layer_tree_tasks[0]->layer_tree->frame_size(),
+                      DlISize(1, 1));
+          });
+          draw_latch.Signal();
+        });
+
+    engine = std::make_unique<Engine>(
+        delegate_, image_decoder_task_runner_, task_runners_, settings_,
+        std::move(animator), io_manager_, std::make_shared<FontCollection>(),
+        std::move(fake_backend), std::make_shared<fml::SyncSwitch>());
+    backend->SetRuntimeDelegate(*engine);
+    backend->ScheduleFrame();
+
+    draw_latch.Wait();
+  });
