+
+class DartRuntimeExtensions {
+ public:
+  virtual ~DartRuntimeExtensions() = default;
+
+  virtual DartVM* GetDartVM() const = 0;
+  virtual int64_t GetMainPort() = 0;
+  virtual std::string GetIsolateName() = 0;
