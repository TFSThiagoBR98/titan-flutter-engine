+bool FakeRuntimeBackend::SetInitialLifecycleState(const std::string& data) {
+  AssertOnUITaskRunner();
+  return false;
+}
+
+bool FakeRuntimeBackend::SendViewFocusEvent(const ViewFocusEvent& event) {
+  AssertOnUITaskRunner();
+  return false;
+}
+
+bool FakeRuntimeBackend::NotifyIdle(fml::TimeDelta deadline) {
+  AssertOnUITaskRunner();
+  return false;
+}
+
+bool FakeRuntimeBackend::ReportTimings(std::vector<int64_t> timings) {
+  AssertOnUITaskRunner();
+  return false;
+}
+
+HitTestResponse FakeRuntimeBackend::HitTest(int64_t view_id, PointData offset) {
+  AssertOnUITaskRunner();
+  return {.has_platform_view = false};
+}
+
+bool FakeRuntimeBackend::IsRunning() const {
+  AssertOnUITaskRunner();
+  return false;
+}
+
+tonic::DartErrorHandleType FakeRuntimeBackend::GetLastError() {
+  AssertOnUITaskRunner();
+  return tonic::DartErrorHandleType::kNoError;
+}
+
+void FakeRuntimeBackend::AssertOnUITaskRunner() const {
+  FML_DCHECK(task_runners_.GetUITaskRunner()->RunsTasksOnCurrentThread());
+}
+
+void FakeRuntimeBackend::RenderEmptyFrame() {
+  if (!runtime_delegate_) {
+    return;
+  }
+  auto layer_tree = std::make_unique<LayerTree>(
+      std::make_shared<ContainerLayer>(), DlISize(1, 1));
+  runtime_delegate_->Render(kFlutterImplicitViewId, std::move(layer_tree), 1.0f);
+  runtime_delegate_->OnAllViewsRendered();
+}
