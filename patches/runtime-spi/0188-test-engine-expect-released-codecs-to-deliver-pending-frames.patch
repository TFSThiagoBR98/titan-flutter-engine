# Why: Lock the codec contract that already-requested static and animated
# frames are delivered exactly once after release.
diff --git a/engine/src/flutter/runtime_spi/image/spi_image_codec_unittests.cc b/engine/src/flutter/runtime_spi/image/spi_image_codec_unittests.cc
index 9e876c6cb82..ccd7c6817f7 100644
--- a/engine/src/flutter/runtime_spi/image/spi_image_codec_unittests.cc
+++ b/engine/src/flutter/runtime_spi/image/spi_image_codec_unittests.cc
@@ -381,7 +381,7 @@ TEST_F(SpiImageCodecTest, FramesWrapAroundWithDurations) {
   ReleaseCodec(codec);
 }
 
-TEST_F(SpiImageCodecTest, ReleaseWithPendingFrameDropsResult) {
+TEST_F(SpiImageCodecTest, ReleaseWithPendingFrameStillDeliversTheFrame) {
   StartShell();
   const auto png = MakePng(SK_ColorRED);
   ASSERT_TRUE(png);
@@ -397,9 +397,35 @@ TEST_F(SpiImageCodecTest, ReleaseWithPendingFrameDropsResult) {
               kFlutterSpiOk);
   });
 
-  EXPECT_TRUE(callback.completed.WaitWithTimeout(
-      fml::TimeDelta::FromMilliseconds(100)));
-  EXPECT_EQ(callback.calls, 0);
+  callback.completed.Wait();
+  EXPECT_EQ(callback.calls, 1);
+  EXPECT_EQ(callback.result, kFlutterSpiOk);
+  ASSERT_NE(callback.image, nullptr);
+  ReleaseImage(callback.image);
+}
+
+TEST_F(SpiImageCodecTest,
+       ReleaseWithPendingAnimatedFrameStillDeliversTheFrame) {
+  StartShell();
+  const auto webp = MakeAnimatedWebp();
+  ASSERT_TRUE(webp);
+  FlutterSpiCodec* codec = CreateCodec(webp);
+  ASSERT_NE(codec, nullptr);
+
+  FrameCallbackState callback;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    EXPECT_EQ(runtime_->engine_api->image->codec_get_next_frame(
+                  codec, CaptureFrame, &callback),
+              kFlutterSpiOk);
+    EXPECT_EQ(runtime_->engine_api->image->codec_release(codec),
+              kFlutterSpiOk);
+  });
+
+  callback.completed.Wait();
+  EXPECT_EQ(callback.calls, 1);
+  EXPECT_EQ(callback.result, kFlutterSpiOk);
+  ASSERT_NE(callback.image, nullptr);
+  ReleaseImage(callback.image);
 }
 
