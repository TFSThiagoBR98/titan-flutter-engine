+TEST(SpiHandleTable, ReusedSlotGetsANewHandle) {
+  SpiHandleTable<int> table;
+  const uintptr_t first_handle = table.Insert(std::make_shared<int>(1));
+
+  EXPECT_TRUE(table.Release(first_handle));
+  const uintptr_t second_handle = table.Insert(std::make_shared<int>(2));
+  const uintptr_t slot_mask = sizeof(uintptr_t) == 8u ? 0xffffffffu : 0xfffffu;
+
+  EXPECT_NE(second_handle, first_handle);
+  EXPECT_EQ(first_handle & slot_mask, second_handle & slot_mask);
+}
+
+TEST(SpiHandleTable, StaleGenerationIsRejected) {
+  SpiHandleTable<int> table;
+  const uintptr_t stale_handle = table.Insert(std::make_shared<int>(1));
+
+  EXPECT_TRUE(table.Release(stale_handle));
+  const uintptr_t current_handle = table.Insert(std::make_shared<int>(2));
+
+  EXPECT_NE(current_handle, stale_handle);
+  EXPECT_EQ(table.Find(stale_handle), nullptr);
+  EXPECT_EQ(table.FindRaw(stale_handle), nullptr);
+}
+
+TEST(SpiHandleTable, FindRawMatchesFind) {
+  SpiHandleTable<int> table;
+  auto value = std::make_shared<int>(42);
+  const uintptr_t handle = table.Insert(value);
+
+  EXPECT_EQ(table.FindRaw(handle), value.get());
+  EXPECT_EQ(table.Find(handle).get(), table.FindRaw(handle));
+}
