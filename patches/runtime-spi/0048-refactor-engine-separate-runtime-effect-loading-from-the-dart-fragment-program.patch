diff --git a/engine/src/flutter/lib/ui/painting/runtime_effect_loader.cc b/engine/src/flutter/lib/ui/painting/runtime_effect_loader.cc
new file mode 100644
index 00000000000..8eac642d444
--- /dev/null
+++ b/engine/src/flutter/lib/ui/painting/runtime_effect_loader.cc
@@ -0,0 +1,143 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/lib/ui/painting/runtime_effect_loader.h"
+
+#include <sstream>
+#include <utility>
+
+#include "flutter/fml/mapping.h"
+#include "flutter/lib/ui/snapshot_delegate.h"
+#if IMPELLER_SUPPORTS_RENDERING
+#include "flutter/impeller/display_list/dl_runtime_effect_impeller.h"  // nogncheck
+#endif
+#include "flutter/impeller/runtime_stage/runtime_stage.h"
+#include "display_list/effects/dl_runtime_effect_skia.h"
+#include "third_party/skia/include/core/SkString.h"
+#include "third_party/skia/include/effects/SkRuntimeEffect.h"
+
+namespace flutter {
+namespace {
+
+std::string RuntimeStageBackendToString(
+    impeller::RuntimeStageBackend backend) {
+  switch (backend) {
+    case impeller::RuntimeStageBackend::kSkSL:
+      return "SkSL";
+    case impeller::RuntimeStageBackend::kMetal:
+      return "Metal";
+    case impeller::RuntimeStageBackend::kOpenGLES:
+      return "OpenGLES";
+    case impeller::RuntimeStageBackend::kVulkan:
+      return "Vulkan";
+    case impeller::RuntimeStageBackend::kOpenGLES3:
+      return "OpenGLES3";
+  }
+}
+
+std::string LibraryPrefix(const std::string& library_id) {
+  if (library_id.empty()) {
+    return "";
+  }
+  return "Asset '" + library_id + "' ";
+}
+
+fml::Status InvalidArgument(std::string message) {
+  // fml::Status stores a string_view, so keep the diagnostic alive until the
+  // caller has copied it from the returned StatusOr.
+  static thread_local std::string status_message;
+  status_message = std::move(message);
+  return fml::Status(fml::StatusCode::kInvalidArgument, status_message);
+}
+
+}  // namespace
+
+fml::StatusOr<LoadedRuntimeEffect> LoadRuntimeEffect(
+    std::unique_ptr<fml::Mapping> data,
+    const std::string& library_id,
+    const RuntimeEffectLoadContext& context) {
+  std::shared_ptr<fml::Mapping> payload(std::move(data));
+  auto runtime_stages =
+      impeller::RuntimeStage::DecodeRuntimeStages(std::move(payload));
+  if (!runtime_stages.ok()) {
+    return InvalidArgument(LibraryPrefix(library_id) +
+                           "manifest could not be decoded: " +
+                           runtime_stages.status().ToString());
+  }
+
+  if (runtime_stages->empty()) {
+    return InvalidArgument(LibraryPrefix(library_id) +
+                           "does not contain any shader data.");
+  }
+
+  std::shared_ptr<impeller::RuntimeStage> runtime_stage =
+      (*runtime_stages)[context.backend];
+  if (runtime_stage && !library_id.empty()) {
+    // Anchor the registry namespace to the asset path so hot reload of the
+    // same asset evicts the previous registration at the same scoped key,
+    // and so two different FragmentProgram assets cannot collide with each
+    // other or with engine-internal entrypoint names.
+    runtime_stage->SetLibraryId(library_id);
+  }
+  if (!runtime_stage) {
+    std::ostringstream stream;
+    stream << LibraryPrefix(library_id)
+           << "does not contain appropriate runtime stage data for current "
+              "backend ("
+           << RuntimeStageBackendToString(context.backend) << ")." << std::endl
+           << "Found stages: ";
+    for (const auto& kvp : *runtime_stages) {
+      if (kvp.second) {
+        stream << RuntimeStageBackendToString(kvp.first) << " ";
+      }
+    }
+    return InvalidArgument(stream.str());
+  }
+
+  LoadedRuntimeEffect loaded_effect;
+  loaded_effect.uniforms = runtime_stage->GetUniforms();
+  for (const auto& uniform : loaded_effect.uniforms) {
+    if (uniform.type == impeller::RuntimeUniformType::kSampledImage) {
+      loaded_effect.sampled_image_count++;
+    } else {
+      loaded_effect.float_uniform_bytes += uniform.GetDartSize();
+    }
+  }
+  loaded_effect.float_uniform_bytes =
+      (loaded_effect.float_uniform_bytes + sizeof(float) - 1) &
+      ~(sizeof(float) - 1);
+
+  if (context.impeller_enabled) {
+    auto snapshot_delegate = context.snapshot_delegate;
+    context.raster_task_runner->PostTask(
+        [runtime_stage, snapshot_delegate]() {
+          if (!snapshot_delegate) {
+            return;
+          }
+          snapshot_delegate->CacheRuntimeStage(runtime_stage);
+        });
+#if IMPELLER_SUPPORTS_RENDERING
+    loaded_effect.effect =
+        DlRuntimeEffectImpeller::Make(std::move(runtime_stage));
+#endif
+  } else {
+    const auto& code_mapping = runtime_stage->GetCodeMapping();
+    auto code_size = code_mapping->GetSize();
+    const char* sksl =
+        reinterpret_cast<const char*>(code_mapping->GetMapping());
+    // SkString makes a copy.
+    SkRuntimeEffect::Result result =
+        SkRuntimeEffect::MakeForShader(SkString(sksl, code_size));
+    if (result.effect == nullptr) {
+      return InvalidArgument(std::string("Invalid SkSL:\n") + sksl +
+                             std::string("\nSkSL Error:\n") +
+                             result.errorText.c_str());
+    }
+    loaded_effect.effect = DlRuntimeEffectSkia::Make(result.effect);
+  }
+
+  return loaded_effect;
+}
+
+}  // namespace flutter
