+
+#ifndef FLUTTER_LIB_UI_PAINTING_RUNTIME_EFFECT_LOADER_H_
+#define FLUTTER_LIB_UI_PAINTING_RUNTIME_EFFECT_LOADER_H_
+
+#include <cstddef>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "flutter/display_list/effects/dl_runtime_effect.h"
+#include "flutter/fml/mapping.h"
+#include "flutter/fml/memory/weak_ptr.h"
+#include "flutter/fml/status_or.h"
+#include "flutter/fml/task_runner.h"
+#include "flutter/impeller/core/runtime_types.h"
+
+namespace flutter {
+
+class SnapshotDelegate;
+
+struct LoadedRuntimeEffect {
+  sk_sp<DlRuntimeEffect> effect;
+  std::vector<impeller::RuntimeUniformDescription> uniforms;
+  int sampled_image_count = 0;
+  size_t float_uniform_bytes = 0;
+};
+
+struct RuntimeEffectLoadContext {
+  impeller::RuntimeStageBackend backend;
+  bool impeller_enabled;
+  fml::TaskRunnerAffineWeakPtr<SnapshotDelegate> snapshot_delegate;
+  fml::RefPtr<fml::TaskRunner> raster_task_runner;
+};
+
+fml::StatusOr<LoadedRuntimeEffect> LoadRuntimeEffect(
+    std::unique_ptr<fml::Mapping> data,
+    const std::string& library_id,
+    const RuntimeEffectLoadContext& context);
+
+}  // namespace flutter
+
+#endif  // FLUTTER_LIB_UI_PAINTING_RUNTIME_EFFECT_LOADER_H_
