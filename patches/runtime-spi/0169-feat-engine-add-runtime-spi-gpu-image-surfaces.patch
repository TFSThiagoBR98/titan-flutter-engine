+TEST_F(SpiGpuContextTest, ImageSurfaceResizeKeepsFrameCountRules) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto allocator =
+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  auto texture = std::make_shared<NiceMock<impeller::testing::MockTexture>>(
+      impeller::TextureDescriptor{});
+  const std::weak_ptr<impeller::Texture> weak_texture = texture;
+  AllowTextureDimensions(*allocator);
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  ON_CALL(*allocator, OnCreateTexture(::testing::_, true))
+      .WillByDefault([weak_texture]() { return weak_texture.lock(); });
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuImageSurface* surface = nullptr;
+  ASSERT_EQ(SpiGpuImageSurfaceCreate(
+                gpu_context, 64, 32,
+                kFlutterSpiGpuPixelFormatR8G8B8A8UNormInt, &surface, nullptr),
+            kFlutterSpiOk);
+  FlutterSpiGpuTexture* gpu_texture = nullptr;
+  int32_t index = -1;
+  ASSERT_EQ(SpiGpuImageSurfaceAcquireNextFrame(surface, &gpu_texture, &index),
+            kFlutterSpiOk);
+  char* error = nullptr;
+  EXPECT_EQ(SpiGpuImageSurfaceResize(surface, 128, 64, &error),
+            kFlutterSpiInvalidArgument);
+  ASSERT_NE(error, nullptr);
+  EXPECT_STREQ(error,
+               "GpuSurface.resize cannot be called while a SurfaceFrame is "
+               "acquired.");
+  std::free(error);
+  EXPECT_EQ(SpiGpuImageSurfaceDiscardFrame(surface, index), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuTextureRelease(gpu_texture), kFlutterSpiOk);
+
+  int32_t count = -1;
+  ASSERT_EQ(SpiGpuImageSurfaceGetBackingTextureCount(surface, &count),
+            kFlutterSpiOk);
+  EXPECT_EQ(count, 1);
+  EXPECT_EQ(SpiGpuImageSurfaceResize(surface, 128, 64, nullptr), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuImageSurfaceGetBackingTextureCount(surface, &count),
+            kFlutterSpiOk);
+  EXPECT_EQ(count, 0);
+  ASSERT_EQ(SpiGpuImageSurfaceAcquireNextFrame(surface, &gpu_texture, &index),
+            kFlutterSpiOk);
+  EXPECT_EQ(index, 0);
+  EXPECT_EQ(SpiGpuTextureRelease(gpu_texture), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuImageSurfaceRelease(surface), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
