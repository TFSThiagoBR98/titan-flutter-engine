+class SpiGpuImageSurface final {
+ public:
+  SpiGpuImageSurface(FlutterSpiGpuContext* context,
+                     std::shared_ptr<impeller::Context> impeller_context,
+                     impeller::ISize size,
+                     impeller::PixelFormat format);
+  ~SpiGpuImageSurface();
+
+  FlutterSpiResult AcquireNextFrame(FlutterSpiGpuTexture** out_texture,
+                                    int32_t* out_index);
+  FlutterSpiResult PresentFrame(int32_t index,
+                                FlutterSpiGpuCommandBuffer* command_buffer,
+                                char** out_error);
+  FlutterSpiResult DiscardFrame(int32_t index);
+  FlutterSpiResult Resize(impeller::ISize size, char** out_error);
+  FlutterSpiResult GetBackingTextureCount(int32_t* out_count) const;
+
+  std::shared_ptr<impeller::Texture> GetCurrentTexture() const;
+
+ private:
+  struct TextureRecord {
+    TextureRecord(std::shared_ptr<impeller::Texture> texture,
+                  impeller::ISize size,
+                  impeller::PixelFormat format);
+
+    std::shared_ptr<impeller::Texture> texture;
+    impeller::ISize size;
+    impeller::PixelFormat format;
+    bool acquired = false;
+    std::atomic_bool producer_pending = false;
+  };
+
+  std::shared_ptr<TextureRecord> CreateTextureRecord() const;
+  bool IsReusable(const std::shared_ptr<TextureRecord>& record,
+                  size_t index) const;
+  void PruneTextureRecords();
+
+  FlutterSpiGpuContext* context_handle_;
+  std::shared_ptr<impeller::Context> context_;
+  impeller::ISize size_;
+  impeller::PixelFormat format_;
+  std::vector<std::shared_ptr<TextureRecord>> records_;
+  std::optional<size_t> current_index_;
+};
+
+FlutterSpiResult SpiGpuImageSurfaceCreate(
+    FlutterSpiGpuContext* context,
+    int32_t width,
+    int32_t height,
+    int32_t format,
+    FlutterSpiGpuImageSurface** out_surface,
+    char** out_error);
+FlutterSpiResult SpiGpuImageSurfaceAcquireNextFrame(
+    FlutterSpiGpuImageSurface* surface,
+    FlutterSpiGpuTexture** out_texture,
+    int32_t* out_index);
+FlutterSpiResult SpiGpuImageSurfacePresentFrame(
+    FlutterSpiGpuImageSurface* surface,
+    int32_t index,
+    FlutterSpiGpuCommandBuffer* command_buffer,
+    char** out_error);
+FlutterSpiResult SpiGpuImageSurfaceDiscardFrame(
+    FlutterSpiGpuImageSurface* surface,
+    int32_t index);
+FlutterSpiResult SpiGpuImageSurfaceResize(FlutterSpiGpuImageSurface* surface,
+                                          int32_t width,
+                                          int32_t height,
+                                          char** out_error);
+FlutterSpiResult SpiGpuImageSurfaceGetBackingTextureCount(
+    FlutterSpiGpuImageSurface* surface,
+    int32_t* out_count);
+FlutterSpiResult SpiGpuImageSurfaceRetain(FlutterSpiGpuImageSurface* surface);
+FlutterSpiResult SpiGpuImageSurfaceRelease(FlutterSpiGpuImageSurface* surface);
+
+std::shared_ptr<impeller::Texture> SpiGpuSurfaceGetCurrentTexture(
+    FlutterSpiGpuImageSurface* surface);
+
+}  // namespace flutter
+
+#endif  // FLUTTER_RUNTIME_SPI_GPU_SPI_GPU_SURFACE_H_
