--- /dev/null
+++ b/engine/src/flutter/runtime_spi/gpu/spi_gpu_surface.cc
@@ -0,0 +1,405 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/gpu/spi_gpu_surface.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <utility>
+
+#include "flutter/runtime_spi/gpu/spi_gpu_command_buffer.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_context.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_formats.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_texture.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "fml/logging.h"
+#include "impeller/core/allocator.h"
+#include "impeller/core/texture.h"
+#include "impeller/renderer/context.h"
+
+namespace flutter {
+namespace {
+
+constexpr int64_t kMaxInternalTextureReferences = 2;
+
+SpiHandleTable<SpiGpuImageSurface>& ImageSurfaces() {
+  return LeakedHandleTable<SpiGpuImageSurface>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuImageSurface* surface) {
+  return reinterpret_cast<uintptr_t>(surface);
+}
+
+FlutterSpiGpuImageSurface* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuImageSurface*>(value);
+}
+
+SpiGpuImageSurface* FindImageSurface(FlutterSpiGpuImageSurface* surface) {
+  return ImageSurfaces().FindRaw(HandleValue(surface));
+}
+
+char* AllocateError(const std::string& error) {
+  char* result = static_cast<char*>(std::malloc(error.size() + 1));
+  if (result == nullptr) {
+    return nullptr;
+  }
+  std::memcpy(result, error.c_str(), error.size() + 1);
+  return result;
+}
+
+void SetError(char** out_error, const std::string& error) {
+  if (out_error != nullptr) {
+    *out_error = AllocateError(error);
+  }
+}
+
+}  // namespace
+
+SpiGpuImageSurface::TextureRecord::TextureRecord(
+    std::shared_ptr<impeller::Texture> texture,
+    impeller::ISize size,
+    impeller::PixelFormat format)
+    : texture(std::move(texture)), size(size), format(format) {}
+
+SpiGpuImageSurface::SpiGpuImageSurface(
+    FlutterSpiGpuContext* context,
+    std::shared_ptr<impeller::Context> impeller_context,
+    impeller::ISize size,
+    impeller::PixelFormat format)
+    : context_handle_(context),
+      context_(std::move(impeller_context)),
+      size_(size),
+      format_(format) {}
+
+SpiGpuImageSurface::~SpiGpuImageSurface() {
+  SpiGpuContextRelease(context_handle_);
+}
+
+std::shared_ptr<SpiGpuImageSurface::TextureRecord>
+SpiGpuImageSurface::CreateTextureRecord() const {
+#if !IMPELLER_SUPPORTS_RENDERING
+  FML_LOG(ERROR) << "Flutter GPU surfaces require Impeller rendering support.";
+  return nullptr;
+#else
+  impeller::TextureDescriptor descriptor;
+  descriptor.storage_mode = impeller::StorageMode::kDevicePrivate;
+  descriptor.size = size_;
+  descriptor.format = format_;
+  descriptor.sample_count = impeller::SampleCount::kCount1;
+  descriptor.type = impeller::TextureType::kTexture2D;
+  descriptor.mip_count = 1;
+  descriptor.usage = impeller::TextureUsage::kRenderTarget |
+                     impeller::TextureUsage::kShaderRead;
+
+  auto texture =
+      context_->GetResourceAllocator()->CreateTexture(descriptor, true);
+  if (texture == nullptr) {
+    FML_LOG(ERROR) << "Failed to create Flutter GPU surface texture.";
+    return nullptr;
+  }
+  return std::make_shared<TextureRecord>(std::move(texture), size_, format_);
+#endif
+}
+
+bool SpiGpuImageSurface::IsReusable(
+    const std::shared_ptr<TextureRecord>& record,
+    size_t index) const {
+  if (current_index_.has_value() && current_index_.value() == index) {
+    return false;
+  }
+  return record != nullptr && record->size == size_ &&
+         record->format == format_ && !record->acquired &&
+         !record->producer_pending.load() &&
+         static_cast<int64_t>(record->texture.use_count()) <=
+             kMaxInternalTextureReferences;
+}
+
+void SpiGpuImageSurface::PruneTextureRecords() {
+  for (size_t index = 0; index < records_.size(); index++) {
+    auto& record = records_[index];
+    if (record == nullptr) {
+      continue;
+    }
+
+    const bool is_current =
+        current_index_.has_value() && current_index_.value() == index;
+    const bool matches_surface =
+        record->size == size_ && record->format == format_;
+    const bool has_external_references =
+        static_cast<int64_t>(record->texture.use_count()) >
+        kMaxInternalTextureReferences;
+    if (!is_current && !matches_surface && !record->acquired &&
+        !record->producer_pending.load() && !has_external_references) {
+      record.reset();
+    }
+  }
+
+  while (!records_.empty() && records_.back() == nullptr) {
+    records_.pop_back();
+  }
+}
+
+FlutterSpiResult SpiGpuImageSurface::AcquireNextFrame(
+    FlutterSpiGpuTexture** out_texture,
+    int32_t* out_index) {
+  std::optional<size_t> available_index;
+  for (size_t index = 0; index < records_.size(); index++) {
+    const auto& record = records_[index];
+    if (record == nullptr && !available_index.has_value()) {
+      available_index = index;
+    }
+    if (!IsReusable(record, index)) {
+      continue;
+    }
+    record->acquired = true;
+    const FlutterSpiResult result = SpiGpuTextureWrapImpeller(
+        context_handle_, record->texture, out_texture);
+    if (result != kFlutterSpiOk) {
+      record->acquired = false;
+      return result;
+    }
+    *out_index = static_cast<int32_t>(index);
+    return kFlutterSpiOk;
+  }
+
+  auto record = CreateTextureRecord();
+  if (record == nullptr) {
+    return kFlutterSpiOk;
+  }
+  record->acquired = true;
+  size_t index = records_.size();
+  if (available_index.has_value()) {
+    index = available_index.value();
+    records_[index] = record;
+  } else {
+    records_.push_back(record);
+  }
+
+  const FlutterSpiResult result =
+      SpiGpuTextureWrapImpeller(context_handle_, record->texture, out_texture);
+  if (result != kFlutterSpiOk) {
+    record->acquired = false;
+    return result;
+  }
+  *out_index = static_cast<int32_t>(index);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuImageSurface::PresentFrame(
+    int32_t index,
+    FlutterSpiGpuCommandBuffer* command_buffer,
+    char** out_error) {
+  if (index < 0) {
+    SetError(out_error, "Invalid SurfaceFrame texture index.");
+    return kFlutterSpiInvalidArgument;
+  }
+  if (static_cast<size_t>(index) >= records_.size()) {
+    SetError(out_error, "SurfaceFrame does not belong to this GpuSurface.");
+    return kFlutterSpiInvalidArgument;
+  }
+  auto record = records_[static_cast<size_t>(index)];
+  if (record == nullptr || !record->acquired) {
+    SetError(out_error,
+             "SurfaceFrame has already been presented or discarded.");
+    return kFlutterSpiInvalidArgument;
+  }
+
+  SpiGpuCommandBuffer* command_buffer_value =
+      SpiGpuCommandBufferGetCore(command_buffer);
+  if (command_buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+
+  record->producer_pending.store(true);
+  if (!command_buffer_value->AddCompletionCallback(
+          [record](impeller::CommandBuffer::Status) {
+            record->producer_pending.store(false);
+          })) {
+    record->producer_pending.store(false);
+    SetError(out_error,
+             "SurfaceFrame.present must be called before submitting the "
+             "command buffer.");
+    return kFlutterSpiInvalidArgument;
+  }
+
+  record->acquired = false;
+  current_index_ = static_cast<size_t>(index);
+  PruneTextureRecords();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuImageSurface::DiscardFrame(int32_t index) {
+  if (index < 0 || static_cast<size_t>(index) >= records_.size()) {
+    return kFlutterSpiOk;
+  }
+  auto& record = records_[static_cast<size_t>(index)];
+  if (record != nullptr) {
+    record->acquired = false;
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuImageSurface::Resize(impeller::ISize size,
+                                            char** out_error) {
+  for (const auto& record : records_) {
+    if (record != nullptr && record->acquired) {
+      SetError(out_error,
+               "GpuSurface.resize cannot be called while a SurfaceFrame is "
+               "acquired.");
+      return kFlutterSpiInvalidArgument;
+    }
+  }
+  size_ = size;
+  PruneTextureRecords();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuImageSurface::GetBackingTextureCount(
+    int32_t* out_count) const {
+  if (out_count == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_count = 0;
+  for (const auto& record : records_) {
+    if (record != nullptr) {
+      (*out_count)++;
+    }
+  }
+  return kFlutterSpiOk;
+}
+
+std::shared_ptr<impeller::Texture> SpiGpuImageSurface::GetCurrentTexture()
+    const {
+  if (!current_index_.has_value() ||
+      current_index_.value() >= records_.size()) {
+    return nullptr;
+  }
+  const auto& record = records_[current_index_.value()];
+  return record == nullptr ? nullptr : record->texture;
+}
+
+FlutterSpiResult SpiGpuImageSurfaceCreate(
+    FlutterSpiGpuContext* context,
+    int32_t width,
+    int32_t height,
+    int32_t format,
+    FlutterSpiGpuImageSurface** out_surface,
+    char** out_error) {
+  if (out_surface == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_surface = nullptr;
+  if (width <= 0 || height <= 0) {
+    SetError(out_error, "GpuSurface dimensions must be greater than zero.");
+    return kFlutterSpiInvalidArgument;
+  }
+
+#if !IMPELLER_SUPPORTS_RENDERING
+  SetError(out_error, "GpuSurface requires Impeller rendering support.");
+  return kFlutterSpiUnsupported;
+#else
+  const impeller::PixelFormat pixel_format =
+      SpiGpuToImpellerPixelFormat(format);
+  if (pixel_format == impeller::PixelFormat::kUnknown) {
+    SetError(out_error, "Unsupported GpuSurface pixel format.");
+    return kFlutterSpiInvalidArgument;
+  }
+  std::shared_ptr<impeller::Context> context_value =
+      SpiGpuContextGetImpeller(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (SpiGpuContextRetain(context) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const uintptr_t handle =
+      ImageSurfaces().Insert(std::make_shared<SpiGpuImageSurface>(
+          context, std::move(context_value), impeller::ISize{width, height},
+          pixel_format));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_surface = MakeHandle(handle);
+  return kFlutterSpiOk;
+#endif
+}
+
+FlutterSpiResult SpiGpuImageSurfaceAcquireNextFrame(
+    FlutterSpiGpuImageSurface* surface,
+    FlutterSpiGpuTexture** out_texture,
+    int32_t* out_index) {
+  if (out_texture == nullptr || out_index == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_texture = nullptr;
+  *out_index = -1;
+  SpiGpuImageSurface* surface_value = FindImageSurface(surface);
+  return surface_value == nullptr
+             ? kFlutterSpiInvalidHandle
+             : surface_value->AcquireNextFrame(out_texture, out_index);
+}
+
+FlutterSpiResult SpiGpuImageSurfacePresentFrame(
+    FlutterSpiGpuImageSurface* surface,
+    int32_t index,
+    FlutterSpiGpuCommandBuffer* command_buffer,
+    char** out_error) {
+  SpiGpuImageSurface* surface_value = FindImageSurface(surface);
+  return surface_value == nullptr
+             ? kFlutterSpiInvalidHandle
+             : surface_value->PresentFrame(index, command_buffer, out_error);
+}
+
+FlutterSpiResult SpiGpuImageSurfaceDiscardFrame(
+    FlutterSpiGpuImageSurface* surface,
+    int32_t index) {
+  SpiGpuImageSurface* surface_value = FindImageSurface(surface);
+  return surface_value == nullptr ? kFlutterSpiInvalidHandle
+                                  : surface_value->DiscardFrame(index);
+}
+
+FlutterSpiResult SpiGpuImageSurfaceResize(FlutterSpiGpuImageSurface* surface,
+                                          int32_t width,
+                                          int32_t height,
+                                          char** out_error) {
+  if (width <= 0 || height <= 0) {
+    SetError(out_error, "GpuSurface dimensions must be greater than zero.");
+    return kFlutterSpiInvalidArgument;
+  }
+  SpiGpuImageSurface* surface_value = FindImageSurface(surface);
+  return surface_value == nullptr
+             ? kFlutterSpiInvalidHandle
+             : surface_value->Resize(impeller::ISize{width, height}, out_error);
+}
+
+FlutterSpiResult SpiGpuImageSurfaceGetBackingTextureCount(
+    FlutterSpiGpuImageSurface* surface,
+    int32_t* out_count) {
+  SpiGpuImageSurface* surface_value = FindImageSurface(surface);
+  return surface_value == nullptr
+             ? kFlutterSpiInvalidHandle
+             : surface_value->GetBackingTextureCount(out_count);
+}
+
+FlutterSpiResult SpiGpuImageSurfaceRetain(FlutterSpiGpuImageSurface* surface) {
+  return ImageSurfaces().Retain(HandleValue(surface))
+             ? kFlutterSpiOk
+             : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuImageSurfaceRelease(FlutterSpiGpuImageSurface* surface) {
+  return ImageSurfaces().Release(HandleValue(surface))
+             ? kFlutterSpiOk
+             : kFlutterSpiInvalidHandle;
+}
+
+std::shared_ptr<impeller::Texture> SpiGpuSurfaceGetCurrentTexture(
+    FlutterSpiGpuImageSurface* surface) {
+  SpiGpuImageSurface* surface_value = FindImageSurface(surface);
+  return surface_value == nullptr ? nullptr
+                                  : surface_value->GetCurrentTexture();
+}
+
+}  // namespace flutter
