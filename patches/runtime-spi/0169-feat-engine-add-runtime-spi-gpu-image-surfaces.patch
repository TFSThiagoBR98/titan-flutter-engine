+TEST_F(SpiGpuContextTest, ImageSurfaceCallsRejectNullAndReleasedHandles) {
+  FlutterSpiGpuImageSurface* surface = nullptr;
+  FlutterSpiGpuTexture* texture = nullptr;
+  int32_t index = -1;
+  int32_t count = -1;
+  EXPECT_EQ(SpiGpuImageSurfaceCreate(nullptr, 64, 32,
+                                     kFlutterSpiGpuPixelFormatR8G8B8A8UNormInt,
+                                     &surface, nullptr),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceCreate(nullptr, 64, 32,
+                                     kFlutterSpiGpuPixelFormatR8G8B8A8UNormInt,
+                                     nullptr, nullptr),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuImageSurfaceAcquireNextFrame(nullptr, &texture, &index),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceAcquireNextFrame(nullptr, nullptr, &index),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuImageSurfacePresentFrame(nullptr, 0, nullptr, nullptr),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceDiscardFrame(nullptr, 0),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceResize(nullptr, 64, 32, nullptr),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceGetBackingTextureCount(nullptr, &count),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceGetBackingTextureCount(nullptr, nullptr),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceRetain(nullptr), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceRelease(nullptr), kFlutterSpiInvalidHandle);
+
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  SpiGpuSetDefaultContextOverride(CreateMockContext(&capabilities));
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  ASSERT_EQ(SpiGpuImageSurfaceCreate(
+                gpu_context, 64, 32,
+                kFlutterSpiGpuPixelFormatR8G8B8A8UNormInt, &surface, nullptr),
+            kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuImageSurfaceRelease(surface), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuImageSurfaceRetain(surface), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuImageSurfaceRelease(surface), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
