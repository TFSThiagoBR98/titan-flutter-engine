+
+  EXPECT_EQ(SpiGpuImageSurfaceCreate(gpu_context, 64, 32,
+                                     kFlutterSpiGpuPixelFormatUnknown,
+                                     &surface, &error),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(surface, nullptr);
+  ASSERT_NE(error, nullptr);
+  EXPECT_STREQ(error, "Unsupported GpuSurface pixel format.");
+  std::free(error);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
