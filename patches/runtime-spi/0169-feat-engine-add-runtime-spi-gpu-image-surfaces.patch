+TEST_F(SpiGpuContextTest, ImageSurfaceAcquirePresentDiscardCycle) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto allocator =
+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  auto texture = std::make_shared<NiceMock<impeller::testing::MockTexture>>(
+      impeller::TextureDescriptor{});
+  auto command_buffer =
+      std::make_shared<NiceMock<impeller::testing::MockCommandBuffer>>(context);
+  AllowTextureDimensions(*allocator);
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  ON_CALL(*allocator, OnCreateTexture(::testing::_, true))
+      .WillByDefault(Return(texture));
+  ON_CALL(*context, CreateCommandBuffer())
+      .WillByDefault(Return(command_buffer));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuImageSurface* surface = nullptr;
+  ASSERT_EQ(SpiGpuImageSurfaceCreate(
+                gpu_context, 64, 32,
+                kFlutterSpiGpuPixelFormatR8G8B8A8UNormInt, &surface, nullptr),
+            kFlutterSpiOk);
+  FlutterSpiGpuTexture* first_texture = nullptr;
+  int32_t first_index = -1;
+  ASSERT_EQ(SpiGpuImageSurfaceAcquireNextFrame(surface, &first_texture,
+                                               &first_index),
+            kFlutterSpiOk);
+  EXPECT_NE(first_texture, nullptr);
+  EXPECT_EQ(first_index, 0);
+
+  FlutterSpiGpuCommandBuffer* gpu_command_buffer = nullptr;
+  ASSERT_EQ(SpiGpuCommandBufferCreate(gpu_context, &gpu_command_buffer),
+            kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuImageSurfacePresentFrame(surface, first_index,
+                                           gpu_command_buffer, nullptr),
+            kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuTextureRelease(first_texture), kFlutterSpiOk);
+
+  FlutterSpiGpuTexture* second_texture = nullptr;
+  int32_t second_index = -1;
+  ASSERT_EQ(SpiGpuImageSurfaceAcquireNextFrame(surface, &second_texture,
+                                               &second_index),
+            kFlutterSpiOk);
+  EXPECT_NE(second_texture, nullptr);
+  EXPECT_EQ(second_index, 1);
+  EXPECT_EQ(SpiGpuImageSurfaceDiscardFrame(surface, second_index),
+            kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuTextureRelease(second_texture), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuCommandBufferRelease(gpu_command_buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuImageSurfaceRelease(surface), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
