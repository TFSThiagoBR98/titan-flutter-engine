+      ":flutter_engine_core_library",
+      "//flutter/runtime_spi:c_test_runtime",
+      "//flutter/third_party/vulkan-deps/vulkan-headers/src:vulkan_headers",
+    ]
+    data_deps = [ ":copy_core_gpu_triangle_shaderbundle" ]
+    libs = [ "dl" ]
+  }
 }
 
 if (titan_flutter_runtime_dart) {
diff --git a/engine/src/flutter/shell/platform/embedder/tests/core_gpu_triangle.c b/engine/src/flutter/shell/platform/embedder/tests/core_gpu_triangle.c
new file mode 100644
index 00000000000..8be1bc7b481
--- /dev/null
+++ b/engine/src/flutter/shell/platform/embedder/tests/core_gpu_triangle.c
@@ -0,0 +1,385 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#define VK_NO_PROTOTYPES
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <vulkan/vulkan.h>
+
+#include "flutter/runtime_spi/testing/c_test_runtime.h"
+#include "flutter/shell/platform/embedder/flutter_core_host.h"
+
+static const int kTriangleWaitSeconds = 10;
+
+typedef struct {
+  void* loader;
+  PFN_vkGetInstanceProcAddr get_instance_proc_address;
+  PFN_vkCreateInstance create_instance;
+  PFN_vkEnumeratePhysicalDevices enumerate_physical_devices;
+  PFN_vkGetPhysicalDeviceQueueFamilyProperties
+      get_physical_device_queue_family_properties;
+  PFN_vkCreateDevice create_device;
+  PFN_vkGetDeviceQueue get_device_queue;
+  PFN_vkDestroyDevice destroy_device;
+  PFN_vkDestroyInstance destroy_instance;
+  VkInstance instance;
+  VkPhysicalDevice physical_device;
+  VkDevice device;
+  VkQueue queue;
+  uint32_t queue_family_index;
+} VulkanState;
+
+static bool IsAfter(const struct timespec* left, const struct timespec* right) {
+  return left->tv_sec > right->tv_sec ||
+         (left->tv_sec == right->tv_sec && left->tv_nsec >= right->tv_nsec);
+}
+
+static int Fail(const char* message) {
+  fprintf(stderr, "core gpu triangle: %s\n", message);
+  return 1;
+}
+
+static bool WaitForTriangle(CTestRuntime* runtime) {
+  struct timespec deadline;
+  if (clock_gettime(CLOCK_MONOTONIC, &deadline) != 0) {
+    return false;
+  }
+  deadline.tv_sec += kTriangleWaitSeconds;
+
+  while (!__atomic_load_n(&runtime->gpu_triangle_ready, __ATOMIC_ACQUIRE)) {
+    struct timespec current_time;
+    if (clock_gettime(CLOCK_MONOTONIC, &current_time) != 0 ||
+        IsAfter(&current_time, &deadline)) {
+      return false;
+    }
+    const struct timespec sleep_duration = {.tv_sec = 0, .tv_nsec = 1000000};
+    if (nanosleep(&sleep_duration, NULL) != 0 && errno != EINTR) {
+      return false;
+    }
+  }
+  return true;
+}
+
+static void* GetInstanceProcAddress(void* user_data,
+                                    FlutterVulkanInstanceHandle instance,
+                                    const char* name) {
+  VulkanState* state = (VulkanState*)user_data;
+  if (state == NULL || state->get_instance_proc_address == NULL) {
+    return NULL;
+  }
+  return (void*)state->get_instance_proc_address((VkInstance)instance, name);
+}
+
+static FlutterVulkanImage GetNextImage(void* user_data,
+                                       const FlutterFrameInfo* frame_info) {
+  (void)user_data;
+  (void)frame_info;
+  return (FlutterVulkanImage){
+      .struct_size = sizeof(FlutterVulkanImage),
+      .image = 0,
+      .format = 0,
+  };
+}
+
+static bool PresentImage(void* user_data, const FlutterVulkanImage* image) {
+  (void)user_data;
+  (void)image;
+  return false;
+}
+
+static void DestroyVulkan(VulkanState* state) {
+  if (state->device != VK_NULL_HANDLE && state->destroy_device != NULL) {
+    state->destroy_device(state->device, NULL);
+  }
+  if (state->instance != VK_NULL_HANDLE && state->destroy_instance != NULL) {
+    state->destroy_instance(state->instance, NULL);
+  }
+  if (state->loader != NULL) {
+    dlclose(state->loader);
+  }
+}
+
+static bool LoadVulkanFunctions(VulkanState* state) {
+  union {
+    void* object;
+    PFN_vkGetInstanceProcAddr function;
+  } symbol = {.object = dlsym(state->loader, "vkGetInstanceProcAddr")};
+  state->get_instance_proc_address = symbol.function;
+  if (state->get_instance_proc_address == NULL) {
+    return false;
+  }
+
+  state->create_instance = (PFN_vkCreateInstance)state->get_instance_proc_address(
+      VK_NULL_HANDLE, "vkCreateInstance");
+  if (state->create_instance == NULL) {
+    return false;
+  }
+  return true;
+}
+
+static bool LoadInstanceFunctions(VulkanState* state) {
+  state->enumerate_physical_devices =
+      (PFN_vkEnumeratePhysicalDevices)state->get_instance_proc_address(
+          state->instance, "vkEnumeratePhysicalDevices");
+  state->get_physical_device_queue_family_properties =
+      (PFN_vkGetPhysicalDeviceQueueFamilyProperties)
+          state->get_instance_proc_address(
+              state->instance, "vkGetPhysicalDeviceQueueFamilyProperties");
+  state->create_device = (PFN_vkCreateDevice)state->get_instance_proc_address(
+      state->instance, "vkCreateDevice");
+  state->get_device_queue = (PFN_vkGetDeviceQueue)state->get_instance_proc_address(
+      state->instance, "vkGetDeviceQueue");
+  state->destroy_device = (PFN_vkDestroyDevice)state->get_instance_proc_address(
+      state->instance, "vkDestroyDevice");
+  state->destroy_instance =
+      (PFN_vkDestroyInstance)state->get_instance_proc_address(
+          state->instance, "vkDestroyInstance");
+  return state->enumerate_physical_devices != NULL &&
+         state->get_physical_device_queue_family_properties != NULL &&
+         state->create_device != NULL && state->get_device_queue != NULL &&
+         state->destroy_device != NULL && state->destroy_instance != NULL;
+}
+
+static bool CreateVulkanInstance(VulkanState* state) {
+  const char* enabled_extensions[] = {VK_KHR_SURFACE_EXTENSION_NAME,
+                                      VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME};
+  const VkApplicationInfo application_info = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .pApplicationName = "Flutter runtime SPI C GPU triangle",
+      .applicationVersion = 1,
+      .pEngineName = "Flutter",
+      .engineVersion = 1,
+      .apiVersion = VK_API_VERSION_1_1,
+  };
+  const VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &application_info,
+      .enabledExtensionCount = 1,
+      .ppEnabledExtensionNames = enabled_extensions,
+  };
+  return state->create_instance(&instance_info, NULL, &state->instance) ==
+         VK_SUCCESS;
+}
+
+static bool SelectGraphicsDevice(VulkanState* state) {
+  uint32_t device_count = 0;
+  if (state->enumerate_physical_devices(state->instance, &device_count, NULL) !=
+          VK_SUCCESS ||
+      device_count == 0) {
+    return false;
+  }
+  VkPhysicalDevice* devices =
+      (VkPhysicalDevice*)calloc(device_count, sizeof(VkPhysicalDevice));
+  if (devices == NULL) {
+    return false;
+  }
+  if (state->enumerate_physical_devices(state->instance, &device_count,
+                                        devices) != VK_SUCCESS) {
+    free(devices);
+    return false;
+  }
+
+  bool found = false;
+  for (uint32_t device_index = 0; device_index < device_count && !found;
+       device_index++) {
+    uint32_t family_count = 0;
+    state->get_physical_device_queue_family_properties(
+        devices[device_index], &family_count, NULL);
+    VkQueueFamilyProperties* families =
+        (VkQueueFamilyProperties*)calloc(family_count,
+                                         sizeof(VkQueueFamilyProperties));
+    if (families == NULL) {
+      continue;
+    }
+    state->get_physical_device_queue_family_properties(
+        devices[device_index], &family_count, families);
+    for (uint32_t family_index = 0; family_index < family_count;
+         family_index++) {
+      if ((families[family_index].queueFlags & VK_QUEUE_GRAPHICS_BIT) != 0) {
+        state->physical_device = devices[device_index];
+        state->queue_family_index = family_index;
+        found = true;
+        break;
+      }
+    }
+    free(families);
+  }
+  free(devices);
+  return found;
+}
+
+static bool CreateVulkanDevice(VulkanState* state) {
+  const float queue_priority = 1.0f;
+  const char* enabled_extensions[] = {VK_KHR_SWAPCHAIN_EXTENSION_NAME};
+  const VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = state->queue_family_index,
+      .queueCount = 1,
+      .pQueuePriorities = &queue_priority,
+  };
+  const VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .enabledExtensionCount = 1,
+      .ppEnabledExtensionNames = enabled_extensions,
+  };
+  if (state->create_device(state->physical_device, &device_info, NULL,
+                           &state->device) != VK_SUCCESS) {
+    return false;
+  }
+  state->get_device_queue(state->device, state->queue_family_index, 0,
+                          &state->queue);
+  return state->queue != VK_NULL_HANDLE;
+}
+
+static bool InitializeVulkan(VulkanState* state) {
+  state->loader = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+  if (state->loader == NULL || !LoadVulkanFunctions(state) ||
+      !CreateVulkanInstance(state) || !LoadInstanceFunctions(state) ||
+      !SelectGraphicsDevice(state) || !CreateVulkanDevice(state)) {
+    DestroyVulkan(state);
+    return false;
+  }
+  return true;
+}
+
+static bool ReadFile(const char* path, uint8_t** data, size_t* size) {
+  FILE* file = fopen(path, "rb");
+  long file_size;
+  uint8_t* file_data;
+
+  if (file == NULL || fseek(file, 0, SEEK_END) != 0 ||
+      (file_size = ftell(file)) < 0 || fseek(file, 0, SEEK_SET) != 0) {
+    if (file != NULL) {
+      fclose(file);
+    }
+    return false;
+  }
+  file_data = (uint8_t*)malloc((size_t)file_size);
+  if (file_data == NULL ||
+      fread(file_data, 1, (size_t)file_size, file) != (size_t)file_size) {
+    free(file_data);
+    fclose(file);
+    return false;
+  }
+  fclose(file);
+  *data = file_data;
+  *size = (size_t)file_size;
+  return true;
+}
+
+int main(int argc, char** argv) {
+  if (argc != 4) {
+    fprintf(stderr, "usage: %s <icu-data-path> <assets-path> <shaderbundle>\n",
+            argv[0]);
+    return 2;
+  }
+
+  uint8_t* shader_bundle_data = NULL;
+  size_t shader_bundle_size = 0;
+  if (!ReadFile(argv[3], &shader_bundle_data, &shader_bundle_size)) {
+    return Fail("could not read the shader bundle");
+  }
+
+  VulkanState vulkan = {0};
+  if (!InitializeVulkan(&vulkan)) {
+    free(shader_bundle_data);
+    return Fail("could not initialize Vulkan 1.1");
+  }
+
+  CTestRuntime* runtime = c_test_runtime_create();
+  if (runtime == NULL) {
+    DestroyVulkan(&vulkan);
+    free(shader_bundle_data);
+    return Fail("could not create the test runtime");
+  }
+  runtime->gpu_triangle_on_start = true;
+  runtime->gpu_triangle_shader_bundle_data = shader_bundle_data;
+  runtime->gpu_triangle_shader_bundle_size = shader_bundle_size;
+
+  const char* command_line_argv[] = {
+      argv[0], "--enable-impeller", "--enable-flutter-gpu",
+  };
+  FlutterRendererConfig renderer_config = {0};
+  renderer_config.type = kVulkan;
+  renderer_config.vulkan.struct_size = sizeof(FlutterVulkanRendererConfig);
+  renderer_config.vulkan.version = VK_API_VERSION_1_1;
+  renderer_config.vulkan.instance = (FlutterVulkanInstanceHandle)vulkan.instance;
+  renderer_config.vulkan.physical_device =
+      (FlutterVulkanPhysicalDeviceHandle)vulkan.physical_device;
+  renderer_config.vulkan.device = (FlutterVulkanDeviceHandle)vulkan.device;
+  renderer_config.vulkan.queue_family_index = vulkan.queue_family_index;
+  renderer_config.vulkan.queue = (FlutterVulkanQueueHandle)vulkan.queue;
+  const char* enabled_instance_extensions[] = {
+      VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME};
+  renderer_config.vulkan.enabled_instance_extension_count = 2;
+  renderer_config.vulkan.enabled_instance_extensions =
+      enabled_instance_extensions;
+  const char* enabled_device_extensions[] = {VK_KHR_SWAPCHAIN_EXTENSION_NAME};
+  renderer_config.vulkan.enabled_device_extension_count = 1;
+  renderer_config.vulkan.enabled_device_extensions = enabled_device_extensions;
+  renderer_config.vulkan.get_instance_proc_address_callback =
+      GetInstanceProcAddress;
+  renderer_config.vulkan.get_next_image_callback = GetNextImage;
+  renderer_config.vulkan.present_image_callback = PresentImage;
+
+  FlutterCoreHostArgs host_args = {0};
+  host_args.struct_size = sizeof(FlutterCoreHostArgs);
+  host_args.assets_path = argv[2];
+  host_args.icu_data_path = argv[1];
+  host_args.command_line_argc = 3;
+  host_args.command_line_argv = command_line_argv;
+
+  const FlutterSpiRuntimeTable runtime_table = c_test_runtime_table(runtime);
+  FlutterCoreEngine engine = NULL;
+  const FlutterEngineResult run_result = FlutterCoreEngineRun(
+      FLUTTER_ENGINE_VERSION, &renderer_config, &host_args, &runtime_table,
+      &vulkan, &engine);
+  if (run_result != kSuccess || engine == NULL) {
+    c_test_runtime_free(runtime);
+    DestroyVulkan(&vulkan);
+    free(shader_bundle_data);
+    return Fail("could not start the core engine");
+  }
+
+  const bool ready = WaitForTriangle(runtime);
+  const FlutterSpiResult triangle_result =
+      ready ? runtime->gpu_triangle_result : kFlutterSpiInternalError;
+  char triangle_message[sizeof(runtime->gpu_triangle_message)];
+  if (ready) {
+    memcpy(triangle_message, runtime->gpu_triangle_message,
+           sizeof(triangle_message));
+  } else {
+    snprintf(triangle_message, sizeof(triangle_message),
+             "triangle was not ready within 10 seconds");
+  }
+  const FlutterEngineResult shutdown_result =
+      FlutterCoreEngineShutdown(engine);
+  c_test_runtime_free(runtime);
+  DestroyVulkan(&vulkan);
+  free(shader_bundle_data);
+
+  if (!ready) {
+    return Fail(triangle_message);
+  }
+  if (shutdown_result != kSuccess) {
+    return Fail("could not shut down the core engine");
+  }
+  if (triangle_result != kFlutterSpiOk) {
+    return Fail(triangle_message[0] == '\0' ? "triangle failed"
+                                           : triangle_message);
+  }
+
+  printf("core gpu triangle: ok\n");
+  return 0;
+}
