+TEST_F(SpiParagraphDrawTest, DynamicBlurUsesDecalForParagraphOperations) {
+  FlutterSpiEngine engine = {};
+  FlutterSpiImageFilter* filter = nullptr;
+  ASSERT_EQ(SpiImageFilterBlur(&engine, 2.0f, 3.0f, -1, &filter),
+            kFlutterSpiOk);
+  FlutterSpiPaint paint = {};
+  paint.struct_size = sizeof(FlutterSpiPaint);
+  paint.image_filter = filter;
+  FlutterSpiParagraph* paragraph = BuildSpiParagraph(&paint);
+  ASSERT_NE(paragraph, nullptr);
+  ASSERT_EQ(SpiParagraphLayout(paragraph, kLayoutWidth), kFlutterSpiOk);
+
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(SpiSceneApi()->recorder_create(&engine, nullptr, &recorder),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiEngineApi::Create().text->canvas_draw_paragraph(
+                recorder, paragraph, kParagraphX, kParagraphY),
+            kFlutterSpiOk);
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(SpiSceneApi()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+  const DisplayList* display_list = SpiPictureDisplayListForTesting(picture);
+  ASSERT_NE(display_list, nullptr);
+  TextDrawRecorder recorder_probe;
+  display_list->Dispatch(recorder_probe);
+  ASSERT_NE(recorder_probe.image_filter, nullptr);
+  ASSERT_NE(recorder_probe.image_filter->asBlur(), nullptr);
+  EXPECT_EQ(recorder_probe.image_filter->asBlur()->tile_mode(),
+            DlTileMode::kDecal);
+
+  EXPECT_EQ(SpiSceneApi()->picture_release(picture), kFlutterSpiOk);
+  EXPECT_EQ(SpiParagraphRelease(paragraph), kFlutterSpiOk);
+  EXPECT_EQ(SpiImageFilterRelease(filter), kFlutterSpiOk);
