+constexpr float kRadiansToDegrees = 180.0f / 3.14159265358979323846f;
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+DlClipOp ToDlClipOp(int32_t clip_op) {
+  return clip_op == kFlutterSpiClipOpDifference ? DlClipOp::kDifference
+                                                : DlClipOp::kIntersect;
+}
+
+bool IsValidClipOp(int32_t clip_op) {
+  return clip_op == kFlutterSpiClipOpDifference ||
+         clip_op == kFlutterSpiClipOpIntersect;
+}
+
+bool IsValidPointMode(int32_t point_mode) {
+  return point_mode >= kFlutterSpiPointModePoints &&
+         point_mode <= kFlutterSpiPointModePolygon;
+}
+
+DlPointMode ToDlPointMode(int32_t point_mode) {
+  return static_cast<DlPointMode>(point_mode);
+}
+
+class SpiPictureRecorder final {
+ public:
+  explicit SpiPictureRecorder(const DlRect& cull_rect)
+      : builder_(std::make_unique<DisplayListBuilder>(cull_rect)) {}
+
+  DisplayListBuilder* builder() { return builder_.get(); }
+
+  sk_sp<DisplayList> Finish() {
+    if (builder_ == nullptr) {
+      return nullptr;
+    }
+    return builder_->Build();
+  }
+
+ private:
+  std::unique_ptr<DisplayListBuilder> builder_;
+};
+
+class SpiPicture final {
+ public:
+  explicit SpiPicture(sk_sp<DisplayList> display_list)
+      : display_list_(std::move(display_list)) {}
+
+  const DisplayList* display_list() const { return display_list_.get(); }
+
+ private:
+  sk_sp<DisplayList> display_list_;
+};
