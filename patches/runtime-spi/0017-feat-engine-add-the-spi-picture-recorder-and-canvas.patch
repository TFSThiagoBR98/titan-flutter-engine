+FlutterSpiResult CanvasSave(FlutterSpiPictureRecorder* recorder) {
+  const auto recorder_value = FindRecorder(recorder);
+  if (recorder_value == nullptr || recorder_value->builder() == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  recorder_value->builder()->Save();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CanvasSaveLayer(FlutterSpiPictureRecorder* recorder,
+                                 const FlutterSpiRect* bounds,
+                                 const FlutterSpiPaint* paint) {
+  const auto recorder_value = FindRecorder(recorder);
+  std::optional<DlRect> dl_bounds;
+  std::optional<DlPaint> dl_paint;
+  if (recorder_value == nullptr || recorder_value->builder() == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (bounds != nullptr) {
+    DlRect value;
+    if (!ToDlRect(*bounds, &value)) {
+      return kFlutterSpiInvalidArgument;
+    }
+    dl_bounds = value;
+  }
+  if (paint != nullptr) {
+    dl_paint = ToDlPaint(*paint);
+  }
+  recorder_value->builder()->SaveLayer(dl_bounds,
+                                       dl_paint.has_value() ? &*dl_paint
+                                                             : nullptr);
+  return kFlutterSpiOk;
+}
