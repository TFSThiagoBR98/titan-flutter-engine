+  const auto recorder_value = FindRecorder(recorder);
+  DlPoint dl_center;
+  if (recorder_value == nullptr || recorder_value->builder() == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (center == nullptr || paint == nullptr || !ToDlPoint(*center, &dl_center) ||
+      !std::isfinite(radius)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  recorder_value->builder()->DrawCircle(dl_center, radius, ToDlPaint(*paint));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CanvasDrawArc(FlutterSpiPictureRecorder* recorder,
+                               const FlutterSpiRect* rect,
+                               float start_radians,
+                               float sweep_radians,
+                               bool use_center,
+                               const FlutterSpiPaint* paint) {
+  const auto recorder_value = FindRecorder(recorder);
+  DlRect dl_rect;
+  if (recorder_value == nullptr || recorder_value->builder() == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (rect == nullptr || paint == nullptr || !ToDlRect(*rect, &dl_rect) ||
+      !std::isfinite(start_radians) || !std::isfinite(sweep_radians)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  recorder_value->builder()->DrawArc(
+      dl_rect, start_radians * kRadiansToDegrees,
+      sweep_radians * kRadiansToDegrees, use_center, ToDlPaint(*paint));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CanvasDrawPath(FlutterSpiPictureRecorder* recorder,
+                                FlutterSpiPath* path,
+                                const FlutterSpiPaint* paint) {
+  const auto recorder_value = FindRecorder(recorder);
+  const auto path_value = FindPath(path);
+  if (recorder_value == nullptr || recorder_value->builder() == nullptr ||
+      path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (paint == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  recorder_value->builder()->DrawPath(path_value->path(), ToDlPaint(*paint));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CanvasDrawPoints(FlutterSpiPictureRecorder* recorder,
+                                  int32_t point_mode,
+                                  const FlutterSpiPoint* points,
+                                  size_t count,
+                                  const FlutterSpiPaint* paint) {
+  const auto recorder_value = FindRecorder(recorder);
+  if (recorder_value == nullptr || recorder_value->builder() == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!IsValidPointMode(point_mode) || points == nullptr || paint == nullptr ||
+      count > std::numeric_limits<uint32_t>::max()) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::vector<DlPoint> dl_points;
+  dl_points.reserve(count);
+  for (size_t index = 0; index < count; ++index) {
+    DlPoint point;
+    if (!ToDlPoint(points[index], &point)) {
+      return kFlutterSpiInvalidArgument;
+    }
+    dl_points.push_back(point);
+  }
+  recorder_value->builder()->DrawPoints(ToDlPointMode(point_mode), count,
+                                        dl_points.data(), ToDlPaint(*paint));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CanvasDrawPicture(FlutterSpiPictureRecorder* recorder,
+                                   FlutterSpiPicture* picture) {
+  const auto recorder_value = FindRecorder(recorder);
+  const auto picture_value = FindPicture(picture);
+  if (recorder_value == nullptr || recorder_value->builder() == nullptr ||
+      picture_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  recorder_value->builder()->DrawDisplayList(
+      sk_ref_sp(picture_value->display_list()));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CanvasDrawShadow(FlutterSpiPictureRecorder* recorder,
+                                  FlutterSpiPath* path,
+                                  const FlutterSpiColor* color,
+                                  float elevation,
+                                  bool transparent_occluder,
+                                  float device_pixel_ratio) {
+  const auto recorder_value = FindRecorder(recorder);
+  const auto path_value = FindPath(path);
+  if (recorder_value == nullptr || recorder_value->builder() == nullptr ||
+      path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (color == nullptr || !std::isfinite(elevation) ||
+      !std::isfinite(device_pixel_ratio)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  recorder_value->builder()->DrawShadow(path_value->path(), ToDlColor(*color),
+                                        elevation, transparent_occluder,
+                                        device_pixel_ratio);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult RecorderFinish(FlutterSpiPictureRecorder* recorder,
+                                FlutterSpiPicture** out_picture) {
+  const auto recorder_value = FindRecorder(recorder);
+  if (recorder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_picture == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  sk_sp<DisplayList> display_list = recorder_value->Finish();
+  if (display_list == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  Recorders().Release(HandleValue(recorder));
+  const uintptr_t handle =
+      Pictures().Insert(std::make_shared<SpiPicture>(std::move(display_list)));
+  *out_picture = MakeHandle<FlutterSpiPicture>(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult RecorderRelease(FlutterSpiPictureRecorder* recorder) {
+  return ToResult(Recorders().Release(HandleValue(recorder)));
+}
+
+FlutterSpiResult PictureRetain(FlutterSpiPicture* picture) {
+  return ToResult(Pictures().Retain(HandleValue(picture)));
+}
+
+FlutterSpiResult PictureRelease(FlutterSpiPicture* picture) {
+  return ToResult(Pictures().Release(HandleValue(picture)));
+}
+
+const FlutterSpiSceneApi kSceneApi = {
+    .struct_size = sizeof(FlutterSpiSceneApi),
