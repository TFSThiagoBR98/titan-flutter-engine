+FlutterSpiResult RecorderCreate(FlutterSpiEngine* engine,
+                                const FlutterSpiRect* cull_rect,
+                                FlutterSpiPictureRecorder** out_recorder) {
+  if (engine == nullptr || out_recorder == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  DlRect dl_cull_rect = DisplayListBuilder::kMaxCullRect;
+  if (cull_rect != nullptr && !ToDlRect(*cull_rect, &dl_cull_rect)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const uintptr_t handle =
+      Recorders().Insert(std::make_shared<SpiPictureRecorder>(dl_cull_rect));
+  *out_recorder = MakeHandle<FlutterSpiPictureRecorder>(handle);
+  return kFlutterSpiOk;
+}
