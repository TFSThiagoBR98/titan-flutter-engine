+std::shared_ptr<SpiPath> FindPath(FlutterSpiPath* path) {
+  return Paths().Find(HandleValue(path));
+}
+
+std::shared_ptr<SpiPictureRecorder> FindRecorder(
+    FlutterSpiPictureRecorder* recorder) {
+  return Recorders().Find(HandleValue(recorder));
+}
