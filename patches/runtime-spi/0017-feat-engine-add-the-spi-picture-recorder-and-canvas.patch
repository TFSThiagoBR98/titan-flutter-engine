+std::shared_ptr<SpiPicture> FindPicture(FlutterSpiPicture* picture) {
+  return Pictures().Find(HandleValue(picture));
+}
+
+FlutterSpiResult ToResult(bool succeeded) {
+  return succeeded ? kFlutterSpiOk : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult PathCreate(FlutterSpiEngine* engine,
+                            FlutterSpiPath** out_path) {
+  if (engine == nullptr || out_path == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const uintptr_t handle = Paths().Insert(std::make_shared<SpiPath>());
+  *out_path = MakeHandle<FlutterSpiPath>(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult PathSetFillType(FlutterSpiPath* path, int32_t fill_type) {
+  const auto path_value = FindPath(path);
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (fill_type != kFlutterSpiFillTypeNonZero &&
+      fill_type != kFlutterSpiFillTypeEvenOdd) {
+    return kFlutterSpiInvalidArgument;
+  }
+  path_value->SetFillType(fill_type == kFlutterSpiFillTypeNonZero
+                              ? DlPathFillType::kNonZero
+                              : DlPathFillType::kOdd);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult PathMoveTo(FlutterSpiPath* path, float x, float y) {
+  const auto path_value = FindPath(path);
+  DlPoint point;
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!ToDlPoint({x, y}, &point)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  path_value->MoveTo(point);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult PathLineTo(FlutterSpiPath* path, float x, float y) {
+  const auto path_value = FindPath(path);
+  DlPoint point;
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!ToDlPoint({x, y}, &point)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  path_value->LineTo(point);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult PathQuadTo(FlutterSpiPath* path,
+                            float x1,
+                            float y1,
+                            float x2,
+                            float y2) {
+  const auto path_value = FindPath(path);
+  DlPoint control_point;
+  DlPoint point;
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!ToDlPoint({x1, y1}, &control_point) || !ToDlPoint({x2, y2}, &point)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  path_value->QuadraticCurveTo(control_point, point);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult PathConicTo(FlutterSpiPath* path,
+                             float x1,
+                             float y1,
+                             float x2,
+                             float y2,
+                             float weight) {
+  const auto path_value = FindPath(path);
+  DlPoint control_point;
+  DlPoint point;
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!ToDlPoint({x1, y1}, &control_point) || !ToDlPoint({x2, y2}, &point) ||
+      !std::isfinite(weight)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  path_value->ConicCurveTo(control_point, point, weight);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult PathCubicTo(FlutterSpiPath* path,
+                             float x1,
+                             float y1,
+                             float x2,
+                             float y2,
+                             float x3,
+                             float y3) {
+  const auto path_value = FindPath(path);
+  DlPoint control_point_1;
+  DlPoint control_point_2;
+  DlPoint point;
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!ToDlPoint({x1, y1}, &control_point_1) ||
+      !ToDlPoint({x2, y2}, &control_point_2) || !ToDlPoint({x3, y3}, &point)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  path_value->CubicCurveTo(control_point_1, control_point_2, point);
+  return kFlutterSpiOk;
+}
