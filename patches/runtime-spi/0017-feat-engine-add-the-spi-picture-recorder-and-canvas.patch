+#include "flutter/runtime_spi/testing/c_test_runtime.h"
+#include "flutter/testing/testing.h"
+
+namespace flutter::testing {
+namespace {
+
+constexpr FlutterSpiRect kRect = {
+    .left = 1.0f, .top = 2.0f, .right = 30.0f, .bottom = 40.0f};
+constexpr FlutterSpiPaint kPaint = {
+    .struct_size = sizeof(FlutterSpiPaint),
+    .color = {.red = 0.1f,
+              .green = 0.2f,
+              .blue = 0.3f,
+              .alpha = 0.4f,
+              .color_space = kFlutterSpiColorSpaceSRGB},
+    .blend_mode = kFlutterSpiBlendModeSrcOver,
+    .style = kFlutterSpiPaintStyleFill,
+    .stroke_width = 1.0f,
+    .stroke_cap = kFlutterSpiStrokeCapButt,
+    .stroke_join = kFlutterSpiStrokeJoinMiter,
+    .stroke_miter = 4.0f,
+    .anti_alias = true,
+    .invert_colors = false,
+};
+
+class SpiCanvasTest : public ::testing::Test {
+ protected:
+  void SetUp() override { engine_ = std::make_unique<FlutterSpiEngine>(); }
+
+  const FlutterSpiSceneApi* api() const { return SpiSceneApi(); }
+
+  FlutterSpiEngine* engine() const { return engine_.get(); }
+
+ private:
+  std::unique_ptr<FlutterSpiEngine> engine_;
+};
+
+TEST_F(SpiCanvasTest, AbiSequenceMatchesDisplayListBuilder) {
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(api()->recorder_create(engine(), &kRect, &recorder), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_save(recorder), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_translate(recorder, 3.0f, 4.0f), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_draw_rect(recorder, &kRect, &kPaint), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_restore(recorder), kFlutterSpiOk);
+
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(api()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+
+  DisplayListBuilder expected(DlRect::MakeLTRB(1, 2, 30, 40));
+  expected.Save();
+  expected.Translate(3.0f, 4.0f);
+  expected.DrawRect(DlRect::MakeLTRB(1, 2, 30, 40), ToDlPaint(kPaint));
+  expected.Restore();
+  const auto expected_list = expected.Build();
+
+  ASSERT_NE(SpiPictureDisplayListForTesting(picture), nullptr);
+  EXPECT_TRUE(SpiPictureDisplayListForTesting(picture)->Equals(expected_list));
+
+  ASSERT_EQ(api()->picture_release(picture), kFlutterSpiOk);
+  ASSERT_EQ(api()->recorder_release(recorder), kFlutterSpiInvalidHandle);
+}
+
+TEST_F(SpiCanvasTest, FinishConsumesRecorder) {
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(api()->recorder_create(engine(), nullptr, &recorder), kFlutterSpiOk);
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(api()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+  EXPECT_EQ(api()->canvas_save(recorder), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(api()->picture_release(picture), kFlutterSpiOk);
+}
+
+TEST_F(SpiCanvasTest, NonFiniteGeometryIsRejected) {
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(api()->recorder_create(engine(), nullptr, &recorder), kFlutterSpiOk);
+  const FlutterSpiRect invalid_rect = {
+      .left = NAN, .top = 2.0f, .right = 30.0f, .bottom = 40.0f};
+  EXPECT_EQ(api()->canvas_draw_rect(recorder, &invalid_rect, &kPaint),
+            kFlutterSpiInvalidArgument);
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(api()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+  EXPECT_EQ(api()->picture_release(picture), kFlutterSpiOk);
+}
+
+TEST_F(SpiCanvasTest, PictureOutlivesItsHandle) {
+  FlutterSpiPictureRecorder* source_recorder = nullptr;
+  ASSERT_EQ(api()->recorder_create(engine(), nullptr, &source_recorder),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_draw_rect(source_recorder, &kRect, &kPaint),
+            kFlutterSpiOk);
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(api()->recorder_finish(source_recorder, &picture), kFlutterSpiOk);
+
+  FlutterSpiPictureRecorder* target_recorder = nullptr;
+  ASSERT_EQ(api()->recorder_create(engine(), nullptr, &target_recorder),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_draw_picture(target_recorder, picture), kFlutterSpiOk);
+  ASSERT_EQ(api()->picture_release(picture), kFlutterSpiOk);
+  FlutterSpiPicture* target_picture = nullptr;
+  ASSERT_EQ(api()->recorder_finish(target_recorder, &target_picture),
+            kFlutterSpiOk);
+
+  DisplayListBuilder inner(DisplayListBuilder::kMaxCullRect);
+  inner.DrawRect(DlRect::MakeLTRB(1, 2, 30, 40), ToDlPaint(kPaint));
+  const auto expected_inner = inner.Build();
+
+  DisplayListBuilder expected(DisplayListBuilder::kMaxCullRect);
+  expected.DrawDisplayList(expected_inner, 1.0f);
+  const auto expected_list = expected.Build();
+  ASSERT_NE(SpiPictureDisplayListForTesting(target_picture), nullptr);
+  EXPECT_TRUE(
+      SpiPictureDisplayListForTesting(target_picture)->Equals(expected_list));
+  EXPECT_EQ(api()->picture_release(target_picture), kFlutterSpiOk);
+}
+
+TEST_F(SpiCanvasTest, SaveCountMatchesBuilder) {
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(api()->recorder_create(engine(), nullptr, &recorder), kFlutterSpiOk);
+  int32_t count = 0;
+  ASSERT_EQ(api()->canvas_get_save_count(recorder, &count), kFlutterSpiOk);
+  EXPECT_EQ(count, 1);
+  ASSERT_EQ(api()->canvas_save(recorder), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_get_save_count(recorder, &count), kFlutterSpiOk);
+  EXPECT_EQ(count, 2);
+  ASSERT_EQ(api()->canvas_restore_to_count(recorder, 1), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_get_save_count(recorder, &count), kFlutterSpiOk);
+  EXPECT_EQ(count, 1);
+  EXPECT_EQ(api()->recorder_release(recorder), kFlutterSpiOk);
+}
