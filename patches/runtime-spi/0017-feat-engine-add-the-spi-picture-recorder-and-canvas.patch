+    .path_add_oval = PathAddOval,
+    .path_add_rrect = PathAddRRect,
+    .path_retain = PathRetain,
+    .path_release = PathRelease,
+    .recorder_create = RecorderCreate,
+    .canvas_save = CanvasSave,
+    .canvas_save_layer = CanvasSaveLayer,
+    .canvas_restore = CanvasRestore,
+    .canvas_restore_to_count = CanvasRestoreToCount,
+    .canvas_get_save_count = CanvasGetSaveCount,
+    .canvas_translate = CanvasTranslate,
+    .canvas_scale = CanvasScale,
+    .canvas_rotate = CanvasRotate,
+    .canvas_skew = CanvasSkew,
+    .canvas_transform = CanvasTransform,
+    .canvas_clip_rect = CanvasClipRect,
+    .canvas_clip_rrect = CanvasClipRRect,
+    .canvas_clip_path = CanvasClipPath,
+    .canvas_draw_color = CanvasDrawColor,
+    .canvas_draw_paint = CanvasDrawPaint,
+    .canvas_draw_line = CanvasDrawLine,
+    .canvas_draw_rect = CanvasDrawRect,
+    .canvas_draw_rrect = CanvasDrawRRect,
+    .canvas_draw_drrect = CanvasDrawDiffRRect,
+    .canvas_draw_oval = CanvasDrawOval,
+    .canvas_draw_circle = CanvasDrawCircle,
+    .canvas_draw_arc = CanvasDrawArc,
+    .canvas_draw_path = CanvasDrawPath,
+    .canvas_draw_points = CanvasDrawPoints,
+    .canvas_draw_picture = CanvasDrawPicture,
+    .canvas_draw_shadow = CanvasDrawShadow,
+    .recorder_finish = RecorderFinish,
+    .recorder_release = RecorderRelease,
+    .picture_retain = PictureRetain,
+    .picture_release = PictureRelease,
+};
