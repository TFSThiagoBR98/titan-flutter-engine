+void Paint::ToSpiPaint(FlutterSpiPaint* out) const {
+  if (out == nullptr || isNull()) {
+    return;
+  }
+
+  tonic::DartByteData byte_data(paint_data_);
+  FML_CHECK(byte_data.length_in_bytes() == kDataByteCount);
+  const uint32_t* uint_data = static_cast<const uint32_t*>(byte_data.data());
+  const float* float_data = static_cast<const float*>(byte_data.data());
+
+  out->struct_size = sizeof(FlutterSpiPaint);
+  out->color = {float_data[kColorRedIndex],
+                float_data[kColorGreenIndex],
+                float_data[kColorBlueIndex],
+                1.f - float_data[kColorAlphaIndex],
+                static_cast<int32_t>(uint_data[kColorSpaceIndex])};
+  out->blend_mode =
+      static_cast<int32_t>(uint_data[kBlendModeIndex] ^ kBlendModeDefault);
+  out->style = static_cast<int32_t>(uint_data[kStyleIndex]);
+  out->stroke_width = float_data[kStrokeWidthIndex];
+  out->stroke_cap = static_cast<int32_t>(uint_data[kStrokeCapIndex]);
+  out->stroke_join = static_cast<int32_t>(uint_data[kStrokeJoinIndex]);
+  out->stroke_miter =
+      float_data[kStrokeMiterLimitIndex] + kStrokeMiterLimitDefault;
+  out->anti_alias = uint_data[kIsAntiAliasIndex] == 0;
+  out->invert_colors = uint_data[kInvertColorIndex] != 0;
+  out->filter_quality = static_cast<int32_t>(uint_data[kFilterQualityIndex]);
+  out->has_mask_blur = false;
+  out->mask_blur_style = kFlutterSpiBlurStyleNormal;
+  out->mask_blur_sigma = 0.0f;
+
+  Dart_Handle values[kObjectCount];
+  if (Dart_IsNull(paint_objects_)) {
+    out->shader = nullptr;
+    out->color_filter = nullptr;
+    out->image_filter = nullptr;
+    return;
+  }
+
+  FML_DCHECK(Dart_IsList(paint_objects_));
+  intptr_t length = 0;
+  FML_CHECK(!Dart_IsError(Dart_ListLength(paint_objects_, &length)));
+  FML_CHECK(length == kObjectCount);
+  FML_CHECK(!Dart_IsError(
+      Dart_ListGetRange(paint_objects_, 0, kObjectCount, values)));
+
+  Shader* shader = tonic::DartConverter<Shader*>::FromDart(values[kShaderIndex]);
+  out->shader = shader == nullptr ? nullptr : shader->spi_handle();
+  ColorFilter* color_filter =
+      tonic::DartConverter<ColorFilter*>::FromDart(values[kColorFilterIndex]);
+  out->color_filter =
+      color_filter == nullptr ? nullptr : color_filter->spi_handle();
+  ImageFilter* image_filter =
+      tonic::DartConverter<ImageFilter*>::FromDart(values[kImageFilterIndex]);
+  out->image_filter =
+      image_filter == nullptr ? nullptr : image_filter->spi_handle();
+
+  if (uint_data[kMaskFilterIndex] == kBlur) {
+    out->has_mask_blur = true;
+    out->mask_blur_style =
+        static_cast<int32_t>(uint_data[kMaskFilterBlurStyleIndex]);
+    out->mask_blur_sigma = float_data[kMaskFilterSigmaIndex];
+  }
+}
+
 }  // namespace flutter
