+  EXPECT_EQ(dl_paint.getStrokeWidth(), 3.5f);
+  EXPECT_EQ(dl_paint.getStrokeCap(), DlStrokeCap::kRound);
+  EXPECT_EQ(dl_paint.getStrokeJoin(), DlStrokeJoin::kBevel);
+  EXPECT_EQ(dl_paint.getStrokeMiter(), 6.0f);
+  EXPECT_TRUE(dl_paint.isInvertColors());
+  ASSERT_NE(dl_paint.getColorFilter(), nullptr);
+  ASSERT_NE(dl_paint.getImageFilter(), nullptr);
+  ASSERT_NE(dl_paint.getMaskFilter(), nullptr);
