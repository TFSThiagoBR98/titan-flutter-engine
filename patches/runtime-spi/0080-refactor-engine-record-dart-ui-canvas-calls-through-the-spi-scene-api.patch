+@pragma('vm:entry-point')
+void convertPaintToSpiPaint() {
+  Paint paint = Paint()
+    ..blendMode = BlendMode.modulate
+    ..color = const Color(0x11223344)
+    ..colorFilter = ColorFilter.mode(const Color(0x55667788), BlendMode.xor)
+    ..imageFilter = ImageFilter.blur(sigmaX: 1.25, sigmaY: 2.5)
+    ..maskFilter = MaskFilter.blur(BlurStyle.inner, .75)
+    ..style = PaintingStyle.stroke
+    ..strokeWidth = 3.5
+    ..strokeCap = StrokeCap.round
+    ..strokeJoin = StrokeJoin.bevel
+    ..strokeMiterLimit = 6.0
+    ..isAntiAlias = false
+    ..invertColors = true
+    ..filterQuality = FilterQuality.high;
+  _convertPaintToSpiPaint(paint);
+}
+
+@pragma('vm:external-name', 'ConvertPaintToSpiPaint')
+external void _convertPaintToSpiPaint(Paint paint);
