+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef FLUTTER_LIB_UI_PAINTING_IMAGE_DESCRIPTOR_DATA_H_
+#define FLUTTER_LIB_UI_PAINTING_IMAGE_DESCRIPTOR_DATA_H_
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+
+#include "flutter/fml/macros.h"
+#include "flutter/lib/ui/painting/image_generator_registry.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "third_party/skia/include/core/SkSize.h"
+
+namespace flutter {
+
+class ImageDescriptor;
+
+class ImageDescriptorData final {
+ public:
+  // This must be kept in sync with the enum in painting.dart.
+  enum PixelFormat {
+    kUnknown,
+    kRGBA8888,
+    kBGRA8888,
+    kRGBAFloat32,
+    kR32Float,
+    kGray8,
+  };
+
+  struct ImageInfo {
+    const uint32_t width;
+    const uint32_t height;
+    const PixelFormat format;
+    const SkAlphaType alpha_type;
+    const sk_sp<SkColorSpace> color_space;
+  };
+
+  static std::shared_ptr<ImageDescriptorData> MakeEncoded(
+      sk_sp<SkData> data,
+      ImageGeneratorRegistry& registry);
+
+  static std::shared_ptr<ImageDescriptorData> MakeRaw(
+      sk_sp<SkData> data,
+      int width,
+      int height,
+      std::optional<size_t> row_bytes,
+      PixelFormat format);
+
+  ~ImageDescriptorData() = default;
+
+  int width() const { return image_info_.width; }
+  int height() const { return image_info_.height; }
+  int bytesPerPixel() const;
+
+  int row_bytes() const {
+    return row_bytes_.value_or(
+        static_cast<size_t>(image_info_.width * bytesPerPixel()));
+  }
+
+  bool should_resize(int target_width, int target_height) const {
+    return target_width != width() || target_height != height();
+  }
+
+  sk_sp<SkData> data() const { return buffer_; }
+  sk_sp<SkImage> image() const;
+  bool is_compressed() const { return !!generator_; }
+  const ImageInfo& image_info() const { return image_info_; }
+
+  SkISize get_scaled_dimensions(float scale) const {
+    if (generator_) {
+      return generator_->GetScaledDimensions(scale);
+    }
+    return SkISize::Make(image_info_.width, image_info_.height);
+  }
+
+  bool get_pixels(const SkPixmap& pixmap) const;
+
+  static ImageInfo CreateImageInfo(const SkImageInfo& sk_image_info);
+  static SkImageInfo ToSkImageInfo(const ImageInfo& image_info);
+
+ private:
+  ImageDescriptorData(sk_sp<SkData> buffer,
+                      const ImageInfo& image_info,
+                      std::optional<size_t> row_bytes);
+  ImageDescriptorData(sk_sp<SkData> buffer,
+                      std::shared_ptr<ImageGenerator> generator);
+
+  sk_sp<SkData> buffer_;
+  const ImageInfo image_info_;
+  std::shared_ptr<ImageGenerator> generator_;
+  std::optional<size_t> row_bytes_;
+
+  friend class ImageDescriptor;
+  FML_DISALLOW_COPY_AND_ASSIGN(ImageDescriptorData);
+};
+
+}  // namespace flutter
+
+#endif  // FLUTTER_LIB_UI_PAINTING_IMAGE_DESCRIPTOR_DATA_H_
