@@ -0,0 +1,145 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/lib/ui/painting/image_descriptor_data.h"
+
+#include "flutter/fml/logging.h"
+
+namespace flutter {
+
+// static
+std::shared_ptr<ImageDescriptorData> ImageDescriptorData::MakeEncoded(
+    sk_sp<SkData> data,
+    ImageGeneratorRegistry& registry) {
+  auto generator = registry.CreateCompatibleGenerator(data);
+  if (!generator) {
+    return nullptr;
+  }
+  return std::shared_ptr<ImageDescriptorData>(
+      new ImageDescriptorData(std::move(data), std::move(generator)));
+}
+
+// static
+std::shared_ptr<ImageDescriptorData> ImageDescriptorData::MakeRaw(
+    sk_sp<SkData> data,
+    int width,
+    int height,
+    std::optional<size_t> row_bytes,
+    PixelFormat format) {
+  const ImageInfo image_info = {
+      .width = static_cast<uint32_t>(width),
+      .height = static_cast<uint32_t>(height),
+      .format = format,
+      .alpha_type = format == PixelFormat::kRGBAFloat32
+                        ? kUnpremul_SkAlphaType
+                        : kPremul_SkAlphaType,
+      .color_space = SkColorSpace::MakeSRGB(),
+  };
+  return std::shared_ptr<ImageDescriptorData>(
+      new ImageDescriptorData(std::move(data), image_info, row_bytes));
+}
+
+ImageDescriptorData::ImageDescriptorData(
+    sk_sp<SkData> buffer,
+    const ImageInfo& image_info,
+    std::optional<size_t> row_bytes)
+    : buffer_(std::move(buffer)),
+      image_info_(image_info),
+      generator_(nullptr),
+      row_bytes_(row_bytes) {}
+
+ImageDescriptorData::ImageDescriptorData(
+    sk_sp<SkData> buffer,
+    std::shared_ptr<ImageGenerator> generator)
+    : buffer_(std::move(buffer)),
+      image_info_(CreateImageInfo(generator->GetInfo())),
+      generator_(std::move(generator)),
+      row_bytes_(std::nullopt) {}
+
+ImageDescriptorData::ImageInfo ImageDescriptorData::CreateImageInfo(
+    const SkImageInfo& sk_image_info) {
+  PixelFormat format;
+  switch (sk_image_info.colorType()) {
+    case kUnknown_SkColorType:
+      format = kUnknown;
+      break;
+    case kRGBA_8888_SkColorType:
+      format = kRGBA8888;
+      break;
+    case kBGRA_8888_SkColorType:
+      format = kBGRA8888;
+      break;
+    case kRGBA_F32_SkColorType:
+      format = kRGBAFloat32;
+      break;
+    case kGray_8_SkColorType:
+      format = kGray8;
+      break;
+    default:
+      FML_DCHECK(false) << "Unsupported pixel format: "
+                        << sk_image_info.colorType();
+      format = kRGBA8888;
+  }
+  return ImageInfo{
+      .width = static_cast<uint32_t>(sk_image_info.width()),
+      .height = static_cast<uint32_t>(sk_image_info.height()),
+      .format = format,
+      .alpha_type = sk_image_info.alphaType(),
+      .color_space = sk_image_info.refColorSpace(),
+  };
+}
+
+SkImageInfo ImageDescriptorData::ToSkImageInfo(
+    const ImageInfo& image_info) {
+  SkColorType color_type = kUnknown_SkColorType;
+  switch (image_info.format) {
+    case PixelFormat::kUnknown:
+      color_type = kUnknown_SkColorType;
+      break;
+    case PixelFormat::kRGBA8888:
+      color_type = kRGBA_8888_SkColorType;
+      break;
+    case PixelFormat::kBGRA8888:
+      color_type = kBGRA_8888_SkColorType;
+      break;
+    case PixelFormat::kRGBAFloat32:
+      color_type = kRGBA_F32_SkColorType;
+      break;
+    case PixelFormat::kGray8:
+      color_type = kGray_8_SkColorType;
+      break;
+    case PixelFormat::kR32Float:
+      FML_DCHECK(false) << "not a supported skia format";
+      break;
+  }
+  return SkImageInfo::Make(image_info.width, image_info.height, color_type,
+                           image_info.alpha_type, image_info.color_space);
+}
+
+sk_sp<SkImage> ImageDescriptorData::image() const {
+  return generator_->GetImage();
+}
+
+bool ImageDescriptorData::get_pixels(const SkPixmap& pixmap) const {
+  FML_DCHECK(generator_);
+  return generator_->GetPixels(pixmap.info(), pixmap.writable_addr(),
+                               pixmap.rowBytes());
+}
+
+int ImageDescriptorData::bytesPerPixel() const {
+  switch (image_info_.format) {
+    case kUnknown:
+      return 0;
+    case kGray8:
+      return 1;
+    case kRGBA8888:
+    case kBGRA8888:
+    case kR32Float:
+      return 4;
+    case kRGBAFloat32:
+      return 16;
+  }
+}
+
+}  // namespace flutter
