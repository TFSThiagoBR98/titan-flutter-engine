+static bool test_runtime_create_effects_picture(
+    CTestRuntime* runtime,
+    FlutterSpiPicture** out_picture) {
+  const FlutterSpiSceneApi* scene_api = runtime->engine_api->scene;
+  const FlutterSpiPaintEffectsApi* effects_api =
+      runtime->engine_api->paint_effects;
+  const FlutterSpiRect gradient_rect = {
+      .left = 0.0f, .top = 0.0f, .right = 16.0f, .bottom = 16.0f};
+  const FlutterSpiRect mask_blur_rect = {
+      .left = 20.0f, .top = 0.0f, .right = 36.0f, .bottom = 16.0f};
+  const FlutterSpiColor gradient_colors[] = {
+      {.red = 1.0f,
+       .alpha = 1.0f,
+       .color_space = kFlutterSpiColorSpaceSRGB},
+      {.blue = 1.0f,
+       .alpha = 1.0f,
+       .color_space = kFlutterSpiColorSpaceSRGB},
+  };
+  const FlutterSpiPoint triangle_positions[] = {
+      {.x = 40.0f, .y = 0.0f},
+      {.x = 56.0f, .y = 0.0f},
+      {.x = 48.0f, .y = 16.0f},
+  };
+  FlutterSpiPictureRecorder* recorder = NULL;
+  FlutterSpiShader* shader = NULL;
+  FlutterSpiVertices* vertices = NULL;
+  FlutterSpiPaint gradient_paint = k_scene_paint;
+  FlutterSpiPaint mask_blur_paint = k_scene_paint;
+
+  if (scene_api == NULL || effects_api == NULL ||
+      scene_api->recorder_create(runtime->engine, NULL, &recorder) !=
+          kFlutterSpiOk ||
+      effects_api->shader_linear_gradient(
+          runtime->engine, (FlutterSpiPoint){.x = 0.0f, .y = 0.0f},
+          (FlutterSpiPoint){.x = 16.0f, .y = 0.0f}, gradient_colors, NULL, 2,
+          kFlutterSpiTileModeClamp, NULL, &shader) != kFlutterSpiOk) {
+    if (recorder != NULL) {
+      scene_api->recorder_release(recorder);
+    }
+    return false;
+  }
+
+  gradient_paint.shader = shader;
+  if (scene_api->canvas_draw_rect(recorder, &gradient_rect,
+                                  &gradient_paint) != kFlutterSpiOk) {
+    effects_api->shader_release(shader);
+    scene_api->recorder_release(recorder);
+    return false;
+  }
+  effects_api->shader_release(shader);
+
+  mask_blur_paint.has_mask_blur = true;
+  mask_blur_paint.mask_blur_style = kFlutterSpiBlurStyleNormal;
+  mask_blur_paint.mask_blur_sigma = 2.0f;
+  if (scene_api->canvas_draw_rect(recorder, &mask_blur_rect,
+                                  &mask_blur_paint) != kFlutterSpiOk ||
+      effects_api->vertices_create(
+          runtime->engine, kFlutterSpiVertexModeTriangles, triangle_positions,
+          3, NULL, NULL, NULL, 0, &vertices) != kFlutterSpiOk ||
+      effects_api->canvas_draw_vertices(recorder, vertices,
+                                        kFlutterSpiBlendModeSrcOver,
+                                        &k_scene_paint) != kFlutterSpiOk ||
+      scene_api->recorder_finish(recorder, out_picture) != kFlutterSpiOk) {
+    if (vertices != NULL) {
+      effects_api->vertices_release(vertices);
+    }
+    scene_api->recorder_release(recorder);
+    return false;
+  }
+
+  effects_api->vertices_release(vertices);
+  return true;
+}
+
+static void test_runtime_submit_effects_scene(
+    CTestRuntime* runtime,
+    const FlutterSpiFrameInfo* frame_info) {
+  const FlutterSpiSceneApi* api = runtime->engine_api->scene;
+  FlutterSpiPicture* picture = NULL;
+  FlutterSpiSceneBuilder* builder = NULL;
+  FlutterSpiScene* scene = NULL;
+
+  if (!test_runtime_create_effects_picture(runtime, &picture) ||
+      api->scene_builder_create(runtime->engine, &builder) != kFlutterSpiOk ||
+      api->scene_add_picture(builder, 0.0f, 0.0f, picture, false, false) !=
+          kFlutterSpiOk ||
+      api->scene_build(
+          builder, (int64_t)runtime->last_view_metrics.physical_width,
+          (int64_t)runtime->last_view_metrics.physical_height,
+          &scene) != kFlutterSpiOk) {
+    if (builder != NULL) {
+      api->scene_builder_release(builder);
+    }
+    if (picture != NULL) {
+      api->picture_release(picture);
+    }
+    return;
+  }
+
+  api->picture_release(picture);
+  runtime->engine_api->submit_frame(
+      runtime->engine, runtime->last_view_metrics.view_id,
+      frame_info->frame_token, scene,
+      runtime->last_view_metrics.device_pixel_ratio);
+}
