+TEST_F(SpiConformance, PaintEffectsFrameRoundTrip) {
+  runtime_->draw_effects_on_begin_frame = true;
+  StartShell();
+
+  PumpOneFrame(shell_.get());
+  PostSync(shell_->GetTaskRunners().GetRasterTaskRunner(), [&] {
+    auto* layer_tree =
+        shell_->GetRasterizer()->GetLastLayerTree(kImplicitViewId);
+    ASSERT_NE(layer_tree, nullptr);
+    EXPECT_EQ(SceneTrace(*layer_tree),
+              "scene 1x1\n"
+              "container\n"
+              "  picture 0 0\n"
+              "    op setColorSource\n"
+              "    drawRect 0 0 16 16\n"
+              "    op setColorSource\n"
+              "    op setMaskFilter\n"
+              "    drawRect 20 0 36 16\n"
+              "    op drawVertices\n");
+  });
+}
