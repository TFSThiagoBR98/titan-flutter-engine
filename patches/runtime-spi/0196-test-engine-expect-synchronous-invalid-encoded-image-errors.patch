+TEST_F(ShellTest, ImageDescriptorEncodedRejectsInvalidDataSynchronously) {
+  std::string message;
+  fml::AutoResetWaitableEvent message_latch;
+  AddFfiNativeCallback(
+      "NotifyMessage", CREATE_FFI_LAMBDA([&](Dart_Handle message_handle) {
+        message = tonic::DartConverter<std::string>::FromDart(message_handle);
+        message_latch.Signal();
+      }));
+
+  auto settings = CreateSettingsForFixture();
+  auto configuration = RunConfiguration::InferFromSettings(settings);
+  configuration.SetEntrypoint(
+      "imageDescriptorEncodedRejectsInvalidDataSynchronously");
+  std::unique_ptr<Shell> shell = CreateShell(settings);
+  ASSERT_NE(shell.get(), nullptr);
+
+  RunEngine(shell.get(), std::move(configuration));
+  const bool received_message = message_latch.WaitWithTimeout(
+      fml::TimeDelta::FromSeconds(10));
+  DestroyShell(std::move(shell));
+
+  ASSERT_TRUE(received_message);
+  EXPECT_EQ(message, "Exception: Invalid image data");
+}
