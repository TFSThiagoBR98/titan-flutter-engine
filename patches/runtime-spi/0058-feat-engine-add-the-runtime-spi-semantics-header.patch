+#ifndef FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_SEMANTICS_H_
+#define FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_SEMANTICS_H_
+
+typedef struct FlutterSpiSemanticsUpdateBuilder FlutterSpiSemanticsUpdateBuilder;
+
+typedef enum {
+  kFlutterSpiTristateNone = 0,
+  kFlutterSpiTristateTrue = 1,
+  kFlutterSpiTristateFalse = 2,
+} FlutterSpiTristate;
+
+typedef enum {
+  kFlutterSpiCheckStateNone = 0,
+  kFlutterSpiCheckStateTrue = 1,
+  kFlutterSpiCheckStateFalse = 2,
+  kFlutterSpiCheckStateMixed = 3,
+} FlutterSpiCheckState;
+
+typedef enum {
+  kFlutterSpiStringAttributeSpellOut = 0,
+  kFlutterSpiStringAttributeLocale = 1,
+} FlutterSpiStringAttributeType;
+
+typedef struct {
+  size_t struct_size;
+  int32_t is_checked; /* FlutterSpiCheckState */
+  int32_t is_selected, is_enabled, is_toggled, is_expanded, is_required,
+      is_focused; /* FlutterSpiTristate */
+  bool is_button, is_text_field, is_in_mutually_exclusive_group, is_header,
+      is_obscured, scopes_route, names_route, is_hidden, is_image,
+      is_live_region, has_implicit_scrolling, is_multiline, is_read_only,
+      is_link, is_slider, is_keyboard_key, is_accessibility_focus_blocked;
+} FlutterSpiSemanticsFlags; /* = flutter::SemanticsFlags, na mesma ordem */
+
+typedef struct {
+  int32_t start;
+  int32_t end;
+  int32_t type; /* FlutterSpiStringAttributeType */
+  const char* locale; /* só para kFlutterSpiStringAttributeLocale */
+} FlutterSpiStringAttribute;
+
+typedef struct {
+  const char* text; /* UTF-8; NULL = "" */
+  const FlutterSpiStringAttribute* attributes;
+  size_t attribute_count;
+} FlutterSpiAttributedString;
+
+typedef struct {
+  size_t struct_size;
+  int32_t id;
+  FlutterSpiSemanticsFlags flags;
+  int32_t actions;
+  int32_t max_value_length, current_value_length, text_selection_base,
+      text_selection_extent, platform_view_id, scroll_children, scroll_index,
+      traversal_parent;
+  double scroll_position, scroll_extent_max, scroll_extent_min;
+  FlutterSpiRect rect;
+  const char* identifier;
+  FlutterSpiAttributedString label, value, increased_value, decreased_value,
+      hint;
+  const char* tooltip;
+  int32_t text_direction;
+  FlutterSpiMatrix transform; /* coluna-major, como o FlutterSpiMatrix da S3a */
+  FlutterSpiMatrix hit_test_transform;
+  const int32_t* children_in_traversal_order;
+  size_t children_in_traversal_order_count;
+  const int32_t* children_in_hit_test_order;
+  size_t children_in_hit_test_order_count;
+  const int32_t* custom_actions;
+  size_t custom_action_count;
+  int32_t heading_level;
+  const char* link_url;
+  int32_t role; /* = flutter::SemanticsRole */
+  int32_t validation_result; /* = flutter::SemanticsValidationResult */
+  const char* locale;
+  const char* min_value;
+  const char* max_value;
+} FlutterSpiSemanticsNode;
+
+typedef struct {
+  size_t struct_size;
+  int32_t id;
+  int32_t override_id;
+  const char* label;
+  const char* hint;
+} FlutterSpiSemanticsCustomAction;
+
+typedef struct FlutterSpiSemanticsApi {
+  size_t struct_size;
+  FlutterSpiResult (*update_builder_create)(
+      FlutterSpiEngine* engine, FlutterSpiSemanticsUpdateBuilder** out_builder);
+  FlutterSpiResult (*update_node)(FlutterSpiSemanticsUpdateBuilder* builder,
+                                  const FlutterSpiSemanticsNode* node);
+  FlutterSpiResult (*update_custom_action)(
+      FlutterSpiSemanticsUpdateBuilder* builder,
+      const FlutterSpiSemanticsCustomAction* action);
+  FlutterSpiResult (*update_submit)(FlutterSpiSemanticsUpdateBuilder* builder,
+                                    int64_t view_id); /* consome */
+  FlutterSpiResult (*update_builder_release)(
+      FlutterSpiSemanticsUpdateBuilder* builder);
+} FlutterSpiSemanticsApi;
+
+#endif  // FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_SEMANTICS_H_
