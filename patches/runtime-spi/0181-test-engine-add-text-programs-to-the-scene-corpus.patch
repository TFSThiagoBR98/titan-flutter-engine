+
+// TextSceneCorpus.SimpleParagraph
+@pragma('vm:entry-point')
+void sceneCorpus_text_simple_paragraph() {
+  _renderPicture((Canvas canvas) {
+    final ParagraphBuilder builder = ParagraphBuilder(ParagraphStyle(
+      fontFamily: 'Ahem',
+      fontSize: 10,
+    ));
+    builder.addText('A');
+    final Paragraph paragraph = builder.build()..layout(const ParagraphConstraints(width: 100));
+    canvas.drawParagraph(paragraph, Offset.zero);
+  });
+}
+
+// TextSceneCorpus.TwoStyles
+@pragma('vm:entry-point')
+void sceneCorpus_text_two_styles() {
+  _renderPicture((Canvas canvas) {
+    final ParagraphBuilder builder = ParagraphBuilder(ParagraphStyle(
+      fontFamily: 'Ahem',
+      fontSize: 10,
+    ));
+    builder.pushStyle(TextStyle(fontFamily: 'Ahem', fontSize: 10));
+    builder.addText('A');
+    builder.pushStyle(TextStyle(fontWeight: FontWeight.bold));
+    builder.addText('B');
+    builder.pop();
+    builder.pop();
+    final Paragraph paragraph = builder.build()..layout(const ParagraphConstraints(width: 100));
+    canvas.drawParagraph(paragraph, Offset.zero);
+  });
+}
+
+// TextSceneCorpus.CenteredFixedWidth
+@pragma('vm:entry-point')
+void sceneCorpus_text_centered_fixed_width() {
+  _renderPicture((Canvas canvas) {
+    final ParagraphBuilder builder = ParagraphBuilder(ParagraphStyle(
+      textAlign: TextAlign.center,
+      fontFamily: 'Ahem',
+      fontSize: 10,
+    ));
+    builder.addText('A');
+    final Paragraph paragraph = builder.build()..layout(const ParagraphConstraints(width: 100));
+    canvas.drawParagraph(paragraph, Offset.zero);
+  });
+}
+
+// TextSceneCorpus.MaxLinesEllipsis
+@pragma('vm:entry-point')
+void sceneCorpus_text_max_lines_ellipsis() {
+  _renderPicture((Canvas canvas) {
+    final ParagraphBuilder builder = ParagraphBuilder(ParagraphStyle(
+      fontFamily: 'Ahem',
+      fontSize: 10,
+      maxLines: 1,
+      ellipsis: '...',
+    ));
+    builder.addText('A long paragraph that exceeds one line');
+    final Paragraph paragraph = builder.build()..layout(const ParagraphConstraints(width: 40));
+    canvas.drawParagraph(paragraph, Offset.zero);
+  });
+}
+
+// TextSceneCorpus.Placeholder
+@pragma('vm:entry-point')
+void sceneCorpus_text_placeholder() {
+  _renderPicture((Canvas canvas) {
+    final ParagraphBuilder builder = ParagraphBuilder(ParagraphStyle(
+      fontFamily: 'Ahem',
+      fontSize: 10,
+    ));
+    builder.addText('A');
+    builder.addPlaceholder(10, 10, PlaceholderAlignment.middle);
+    final Paragraph paragraph = builder.build()..layout(const ParagraphConstraints(width: 100));
+    canvas.drawParagraph(paragraph, Offset.zero);
+  });
+}
