+TEST_F(SpiImageCodecTest, InstantiateCodecUsesRegisteredDecoders) {
+  StartShell();
+  RegisterSinglePixelImageDecoder();
+  const uint8_t bytes[] = {0xde, 0xad, 0xbe, 0xef};
+  const auto encoded = SkData::MakeWithCopy(bytes, sizeof(bytes));
+
+  DescriptorCallbackState descriptor_state;
+  CreateEncodedDescriptor(encoded, &descriptor_state);
+  ASSERT_EQ(descriptor_state.result, kFlutterSpiOk);
+  ASSERT_NE(descriptor_state.descriptor, nullptr);
+
+  FlutterSpiCodec* codec = InstantiateCodec(descriptor_state.descriptor, 0, 0);
+  ASSERT_NE(codec, nullptr);
+  FrameCallbackState frame;
+  ASSERT_EQ(GetNextFrame(codec, &frame), kFlutterSpiOk);
+  ASSERT_EQ(frame.result, kFlutterSpiOk);
+  ASSERT_NE(frame.image, nullptr);
+  EXPECT_EQ(GetImageSize(frame.image), (std::pair<int32_t, int32_t>{1, 1}));
+  ReleaseImage(frame.image);
+  ReleaseCodec(codec);
+  ReleaseDescriptor(descriptor_state.descriptor);
+}
