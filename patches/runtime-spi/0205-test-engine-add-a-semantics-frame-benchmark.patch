+      flags: SemanticsFlags.none,
+      actions: 0,
+      maxValueLength: 0,
+      currentValueLength: 0,
+      textSelectionBase: -1,
+      textSelectionExtent: -1,
+      platformViewId: -1,
+      scrollChildren: 0,
+      scrollIndex: 0,
+      traversalParent: 0,
+      scrollPosition: 0,
+      scrollExtentMax: 0,
+      scrollExtentMin: 0,
+      rect: Rect.fromLTWH(0, index * 10.0, 100, 10),
+      identifier: 'identifier',
+      label: labels[index],
+      labelAttributes: labelAttributes[index],
+      value: values[index],
+      valueAttributes: const <StringAttribute>[],
+      increasedValue: 'increasedValue',
+      increasedValueAttributes: const <StringAttribute>[],
+      decreasedValue: 'decreasedValue',
+      decreasedValueAttributes: const <StringAttribute>[],
+      hint: hints[index],
+      hintAttributes: const <StringAttribute>[],
+      tooltip: 'tooltip',
+      textDirection: TextDirection.ltr,
+      transform: identityTransform,
+      hitTestTransform: identityTransform,
+      childrenInTraversalOrder: children,
+      childrenInHitTestOrder: children,
+      additionalActions: Int32List(0),
+      headingLevel: 0,
+      linkUrl: '',
+      controlsNodes: null,
+      inputType: SemanticsInputType.none,
+      locale: null,
+      minValue: '0',
+      maxValue: '0',
+    );
+  }
+
+  for (int index = 0; index < 10; index++) {
+    builder.updateCustomAction(id: index, label: 'Action $index');
+  }
+
+  final SemanticsUpdate update = builder.build();
+  PlatformDispatcher.instance.implicitView!.updateSemantics(update);
+  update.dispose();
+}
