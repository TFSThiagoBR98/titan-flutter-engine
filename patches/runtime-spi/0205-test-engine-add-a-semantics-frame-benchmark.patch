+  ]);
+  _semanticsBenchmarkEmptyChildren = Int32List(0);
+}
+
+@pragma('vm:entry-point')
+void buildSemanticsFrame() {
+  _initializeSemanticsBenchmarkData();
+  final SemanticsUpdateBuilder builder = SemanticsUpdateBuilder();
+  final List<String> labels = _semanticsBenchmarkLabels!;
+  final List<String> values = _semanticsBenchmarkValues!;
+  final List<String> hints = _semanticsBenchmarkHints!;
+  final List<List<StringAttribute>> labelAttributes = _semanticsBenchmarkLabelAttributes!;
+  final Float64List identityTransform = _semanticsBenchmarkIdentityTransform!;
+  final Int32List rootChildren = _semanticsBenchmarkRootChildren!;
+  final Int32List emptyChildren = _semanticsBenchmarkEmptyChildren!;
+
+  for (int index = 0; index < _semanticsBenchmarkNodeCount; index++) {
+    final Int32List children = index == 0 ? rootChildren : emptyChildren;
+    builder.updateNode(
