+static void BM_DartSemanticsFrame(benchmark::State& state) {
+  ParagraphBenchmarkShell shell_test;
+  Settings settings = shell_test.CreateSettingsForFixture();
+  settings.icu_data_path = testing::IcuDataPathForTesting();
+  testing::InitializeIcuForTesting();
+  auto shell = shell_test.CreateShell(settings);
+  FML_CHECK(shell);
+
+  testing::ShellTest::PlatformViewNotifyCreated(shell.get());
+
+  auto configuration = RunConfiguration::InferFromSettings(settings);
+  configuration.SetEntrypoint("mainNotifyNative");
+
+  fml::AutoResetWaitableEvent startup_latch;
+  shell_test.AddFfiNativeCallback(
+      "NotifyNative", CREATE_FFI_LAMBDA([&startup_latch]() {
+        startup_latch.Signal();
+      }));
+  testing::ShellTest::RunEngine(shell.get(), std::move(configuration));
+  startup_latch.Wait();
+
+  while (state.KeepRunning()) {
+    fml::AutoResetWaitableEvent frame_latch;
+    fml::TaskRunner::RunNowOrPostTask(
+        shell->GetTaskRunners().GetUITaskRunner(),
+        [&shell, &frame_latch]() {
+          auto engine = shell->GetEngine();
+          FML_CHECK(engine);
+          const auto root_isolate = std::const_pointer_cast<DartIsolate>(
+              engine->GetRuntimeController()->GetRootIsolate().lock());
+          FML_CHECK(root_isolate);
+          tonic::DartState::Scope scope(root_isolate);
+          const Dart_Handle result = Dart_Invoke(
+              Dart_RootLibrary(),
+              Dart_NewStringFromCString("buildSemanticsFrame"), 0, nullptr);
+          FML_CHECK(!Dart_IsError(result));
+          frame_latch.Signal();
+        });
+    frame_latch.Wait();
+  }
+
+  shell_test.DestroyShell(std::move(shell));
+}
+
+BENCHMARK(BM_DartSemanticsFrame)->Unit(benchmark::kMicrosecond);
