+void InvokeImageCallback(void* user_data,
+                         FlutterSpiResult result,
+                         FlutterSpiImage* image) {
+  auto callback = std::unique_ptr<tonic::DartPersistentValue>(
+      static_cast<tonic::DartPersistentValue*>(user_data));
+  auto dart_state = callback->dart_state().lock();
+  if (!dart_state) {
+    return;
+  }
+  tonic::DartState::Scope scope(dart_state);
+  if (result != kFlutterSpiOk || image == nullptr) {
+    tonic::DartInvoke(callback->value(), {Dart_Null()});
+    return;
+  }
+  auto dart_image = CanvasImage::Create(image);
+  tonic::DartInvoke(callback->value(), {tonic::ToDart(dart_image)});
+}
+
+bool ToSpiPixelFormat(int32_t target_format, int32_t* pixel_format) {
+  switch (target_format) {
+    case 0:
+      *pixel_format = kFlutterSpiPixelFormatRGBA8888;
+      return true;
+    case 1:
+      *pixel_format = kFlutterSpiPixelFormatRGBAFloat32;
+      return true;
+    case 2:
+      *pixel_format = kFlutterSpiPixelFormatRFloat32;
+      return true;
+    default:
+      return false;
+  }
+}
