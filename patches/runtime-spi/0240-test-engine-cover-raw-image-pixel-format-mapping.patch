# Why: Prove that dart:ui raw RGBA and BGRA descriptors preserve a red pixel
# through the SPI image decoder before fixing the enum mismatch.
diff --git a/engine/src/flutter/testing/dart/image_descriptor_test.dart b/engine/src/flutter/testing/dart/image_descriptor_test.dart
index 85cdeecfbc3..af47e2cd2a9 100644
--- a/engine/src/flutter/testing/dart/image_descriptor_test.dart
+++ b/engine/src/flutter/testing/dart/image_descriptor_test.dart
@@ -74,6 +74,54 @@ void main() {
     codec.dispose();
   });
 
+  test('raw rgba8888 preserves red pixels', () async {
+    final ImmutableBuffer buffer = await ImmutableBuffer.fromUint8List(
+      Uint8List.fromList(<int>[255, 0, 0, 255]),
+    );
+    final ImageDescriptor descriptor = ImageDescriptor.raw(
+      buffer,
+      width: 1,
+      height: 1,
+      pixelFormat: PixelFormat.rgba8888,
+    );
+
+    final Codec codec = await descriptor.instantiateCodec();
+    final Image image = (await codec.getNextFrame()).image;
+    final ByteData? data = await image.toByteData(
+      format: ImageByteFormat.rawRgba,
+    );
+
+    expect(data, isNotNull);
+    expect(data!.buffer.asUint8List(), <int>[255, 0, 0, 255]);
+
+    image.dispose();
+    codec.dispose();
+  });
+
+  test('raw bgra8888 converts red pixels to rgba', () async {
+    final ImmutableBuffer buffer = await ImmutableBuffer.fromUint8List(
+      Uint8List.fromList(<int>[0, 0, 255, 255]),
+    );
+    final ImageDescriptor descriptor = ImageDescriptor.raw(
+      buffer,
+      width: 1,
+      height: 1,
+      pixelFormat: PixelFormat.bgra8888,
+    );
+
+    final Codec codec = await descriptor.instantiateCodec();
+    final Image image = (await codec.getNextFrame()).image;
+    final ByteData? data = await image.toByteData(
+      format: ImageByteFormat.rawRgba,
+    );
+
+    expect(data, isNotNull);
+    expect(data!.buffer.asUint8List(), <int>[255, 0, 0, 255]);
+
+    image.dispose();
+    codec.dispose();
+  });
+
