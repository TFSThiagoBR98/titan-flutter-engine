diff --git a/engine/src/flutter/shell/platform/embedder/make_static_core.py b/engine/src/flutter/shell/platform/embedder/make_static_core.py
new file mode 100644
index 00000000000..add8a90473b
--- /dev/null
+++ b/engine/src/flutter/shell/platform/embedder/make_static_core.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""Builds the exported static Flutter core archive from its object archive."""
+
+import argparse
+import subprocess
+import tempfile
+from pathlib import Path
+from typing import List, Union
+
+
+def parse_arguments() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--archive", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--ld", type=Path, required=True)
+    parser.add_argument("--objcopy", type=Path, required=True)
+    parser.add_argument("--ar", type=Path, required=True)
+    return parser.parse_args()
+
+
+def run(command: List[Union[Path, str]]) -> None:
+    subprocess.run(command, check=True)
+
+
+def build_static_core(arguments: argparse.Namespace) -> None:
+    arguments.output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory() as temporary_directory:
+        object_path = Path(temporary_directory) / "flutter_engine_core.o"
+        run([
+            arguments.ld,
+            "-r",
+            "--whole-archive",
+            arguments.archive,
+            "-o",
+            object_path,
+        ])
+        run([
+            arguments.objcopy,
+            "--wildcard",
+            "--keep-global-symbol=FlutterCore*",
+            object_path,
+        ])
+        run([arguments.ar, "crs", arguments.output, object_path])
+
+
+def main() -> None:
+    build_static_core(parse_arguments())
+
+
+if __name__ == "__main__":
+    main()
