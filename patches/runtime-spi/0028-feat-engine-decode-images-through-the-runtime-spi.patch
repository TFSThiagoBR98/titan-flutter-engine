@@ -0,0 +1,177 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/image/spi_image_decoding.h"
+
+#include <limits>
+#include <utility>
+
+#include "flutter/lib/ui/painting/image_decoder.h"
+#include "flutter/lib/ui/painting/image_descriptor_data.h"
+#include "flutter/lib/ui/painting/image_generator_registry.h"
+#include "flutter/runtime_spi/image/spi_image.h"
+
+namespace flutter {
+namespace {
+
+struct PixelFormatInfo {
+  ImageDescriptorData::PixelFormat format;
+  size_t bytes_per_pixel;
+};
+
+bool GetPixelFormatInfo(int32_t value, PixelFormatInfo* info) {
+  switch (value) {
+    case kFlutterSpiPixelFormatRGBA8888:
+      *info = {ImageDescriptorData::PixelFormat::kRGBA8888, 4};
+      return true;
+    case kFlutterSpiPixelFormatBGRA8888:
+      *info = {ImageDescriptorData::PixelFormat::kBGRA8888, 4};
+      return true;
+    case kFlutterSpiPixelFormatRGBAFloat32:
+      *info = {ImageDescriptorData::PixelFormat::kRGBAFloat32, 16};
+      return true;
+    case kFlutterSpiPixelFormatRFloat32:
+      *info = {ImageDescriptorData::PixelFormat::kR32Float, 4};
+      return true;
+    default:
+      return false;
+  }
+}
+
+ImageDecoder::Options DecodeOptions(
+    const FlutterSpiImageDecodeOptions* options) {
+  if (options == nullptr) {
+    return {};
+  }
+  return {
+      .target_width = static_cast<uint32_t>(options->target_width),
+      .target_height = static_cast<uint32_t>(options->target_height),
+  };
+}
+
+}  // namespace
+
+SpiImageDecoding::SpiImageDecoding(
+    fml::TaskRunnerAffineWeakPtr<ImageDecoder> decoder,
+    fml::TaskRunnerAffineWeakPtr<ImageGeneratorRegistry> registry,
+    fml::RefPtr<fml::TaskRunner> ui_task_runner)
+    : decoder_(std::move(decoder)),
+      registry_(std::move(registry)),
+      ui_task_runner_(std::move(ui_task_runner)),
+      weak_factory_(this) {}
+
+SpiImageDecoding::~SpiImageDecoding() = default;
+
+FlutterSpiResult SpiImageDecoding::ValidateCallback(
+    FlutterSpiImageCallback callback) const {
+  return callback == nullptr ? kFlutterSpiInvalidArgument : kFlutterSpiOk;
+}
+
+void SpiImageDecoding::PostResult(FlutterSpiImageCallback callback,
+                                  void* user_data,
+                                  FlutterSpiResult result,
+                                  sk_sp<DlImage> image) {
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  ui_task_runner_->PostTask(
+      [weak_this, callback, user_data, result,
+       image = std::move(image)]() mutable {
+        if (!weak_this) {
+          return;
+        }
+        FlutterSpiImage* handle = nullptr;
+        FlutterSpiResult callback_result = result;
+        if (callback_result == kFlutterSpiOk &&
+            SpiImageWrap(std::move(image), &handle) != kFlutterSpiOk) {
+          callback_result = kFlutterSpiInternalError;
+        }
+        callback(user_data, callback_result, handle);
+      });
+}
+
+FlutterSpiResult SpiImageDecoding::DecodeEncoded(
+    const uint8_t* data,
+    size_t size,
+    const FlutterSpiImageDecodeOptions* options,
+    FlutterSpiImageCallback callback,
+    void* user_data) {
+  if (ValidateCallback(callback) != kFlutterSpiOk || data == nullptr ||
+      size == 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!registry_) {
+    PostResult(callback, user_data, kFlutterSpiInternalError, nullptr);
+    return kFlutterSpiOk;
+  }
+  auto descriptor = ImageDescriptorData::MakeEncoded(
+      SkData::MakeWithCopy(data, size), *registry_);
+  if (!descriptor) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!decoder_) {
+    PostResult(callback, user_data, kFlutterSpiInternalError, nullptr);
+    return kFlutterSpiOk;
+  }
+  decoder_->Decode(
+      std::move(descriptor), DecodeOptions(options),
+      [weak_this = weak_factory_.GetWeakPtr(), callback,
+       user_data](sk_sp<DlImage> image, std::string) mutable {
+        if (weak_this) {
+          weak_this->PostResult(callback, user_data,
+                                image == nullptr ? kFlutterSpiInternalError
+                                                 : kFlutterSpiOk,
+                                std::move(image));
+        }
+      });
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiImageDecoding::DecodePixels(
+    const FlutterSpiPixels* pixels,
+    const FlutterSpiImageDecodeOptions* options,
+    FlutterSpiImageCallback callback,
+    void* user_data) {
+  if (ValidateCallback(callback) != kFlutterSpiOk || pixels == nullptr ||
+      pixels->pixels == nullptr || pixels->width <= 0 || pixels->height <= 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PixelFormatInfo format_info;
+  if (!GetPixelFormatInfo(pixels->pixel_format, &format_info)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t minimum_row_bytes =
+      static_cast<size_t>(pixels->width) * format_info.bytes_per_pixel;
+  const size_t row_bytes = pixels->row_bytes == 0
+                               ? minimum_row_bytes
+                               : static_cast<size_t>(pixels->row_bytes);
+  if (row_bytes < minimum_row_bytes ||
+      row_bytes > std::numeric_limits<size_t>::max() /
+                       static_cast<size_t>(pixels->height)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t required_size = row_bytes * static_cast<size_t>(pixels->height);
+  if (pixels->pixels_size < required_size) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!decoder_) {
+    PostResult(callback, user_data, kFlutterSpiInternalError, nullptr);
+    return kFlutterSpiOk;
+  }
+  auto descriptor = ImageDescriptorData::MakeRaw(
+      SkData::MakeWithCopy(pixels->pixels, pixels->pixels_size), pixels->width,
+      pixels->height, row_bytes, format_info.format);
+  decoder_->Decode(
+      std::move(descriptor), DecodeOptions(options),
+      [weak_this = weak_factory_.GetWeakPtr(), callback,
+       user_data](sk_sp<DlImage> image, std::string) mutable {
+        if (weak_this) {
+          weak_this->PostResult(callback, user_data,
+                                image == nullptr ? kFlutterSpiInternalError
+                                                 : kFlutterSpiOk,
+                                std::move(image));
+        }
+      });
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
