+#ifndef FLUTTER_RUNTIME_SPI_IMAGE_SPI_IMAGE_DECODING_H_
+#define FLUTTER_RUNTIME_SPI_IMAGE_SPI_IMAGE_DECODING_H_
+
+#include <cstddef>
+#include <cstdint>
+
+#include "flutter/fml/memory/weak_ptr.h"
+#include "flutter/fml/task_runner.h"
+#include "flutter/display_list/image/dl_image.h"
+#include "flutter/runtime_spi/include/flutter_image.h"
+
+namespace flutter {
+
+class ImageDecoder;
+class ImageGeneratorRegistry;
+
+class SpiImageDecoding final {
+ public:
+  SpiImageDecoding(
+      fml::TaskRunnerAffineWeakPtr<ImageDecoder> decoder,
+      fml::TaskRunnerAffineWeakPtr<ImageGeneratorRegistry> registry,
+      fml::RefPtr<fml::TaskRunner> ui_task_runner);
+  ~SpiImageDecoding();
+
+  FlutterSpiResult DecodeEncoded(const uint8_t* data,
+                                 size_t size,
+                                 const FlutterSpiImageDecodeOptions* options,
+                                 FlutterSpiImageCallback callback,
+                                 void* user_data);
+  FlutterSpiResult DecodePixels(const FlutterSpiPixels* pixels,
+                                const FlutterSpiImageDecodeOptions* options,
+                                FlutterSpiImageCallback callback,
+                                void* user_data);
+
+ private:
+  FlutterSpiResult ValidateCallback(FlutterSpiImageCallback callback) const;
+  void PostResult(FlutterSpiImageCallback callback,
+                  void* user_data,
+                  FlutterSpiResult result,
+                  sk_sp<DlImage> image);
+
+  fml::TaskRunnerAffineWeakPtr<ImageDecoder> decoder_;
+  fml::TaskRunnerAffineWeakPtr<ImageGeneratorRegistry> registry_;
+  fml::RefPtr<fml::TaskRunner> ui_task_runner_;
+  fml::TaskRunnerAffineWeakPtrFactory<SpiImageDecoding> weak_factory_;
+};
+
+}  // namespace flutter
+
+#endif  // FLUTTER_RUNTIME_SPI_IMAGE_SPI_IMAGE_DECODING_H_
diff --git a/engine/src/flutter/runtime_spi/image/spi_image_decoding_unittests.cc b/engine/src/flutter/runtime_spi/image/spi_image_decoding_unittests.cc
