@@ -0,0 +1,298 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/image/spi_image.h"
+#include "flutter/runtime_spi/image/spi_image_decoding.h"
+
+#include <memory>
+#include <string>
+
+#include "flutter/display_list/image/dl_image_skia.h"
+#include "flutter/fml/synchronization/waitable_event.h"
+#include "flutter/lib/ui/painting/image_decoder.h"
+#include "flutter/lib/ui/painting/image_generator_registry.h"
+#include "flutter/testing/post_task_sync.h"
+#include "flutter/testing/testing.h"
+#include "flutter/testing/thread_test.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+#include "third_party/skia/include/encode/SkPngEncoder.h"
+
+namespace flutter::testing {
+namespace {
+
+sk_sp<DlImage> MakeTestImage() {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(3, 2))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(SK_ColorGREEN);
+  bitmap.setImmutable();
+  return DlImageSkia::Make(SkImages::RasterFromBitmap(bitmap));
+}
+
+sk_sp<SkData> MakeTestPng() {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(3, 2))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(SK_ColorGREEN);
+  auto image = SkImages::RasterFromBitmap(bitmap);
+  if (!image) {
+    return nullptr;
+  }
+  return SkPngEncoder::Encode(nullptr, image.get(), {});
+}
+
+class FakeImageDecoder final : public ImageDecoder {
+ public:
+  explicit FakeImageDecoder(const TaskRunners& runners)
+      : ImageDecoder(runners, nullptr, fml::WeakPtr<IOManager>()) {}
+
+  void Decode(std::shared_ptr<ImageDescriptorData> descriptor,
+              const Options& options,
+              const ImageResult& result) override {
+    decode_count_++;
+    descriptor_ = std::move(descriptor);
+    options_ = options;
+    result_ = result;
+    if (respond_synchronously_) {
+      Respond(std::move(synchronous_image_));
+    }
+  }
+
+  void Respond(sk_sp<DlImage> image) {
+    if (result_) {
+      auto result = std::move(result_);
+      result(std::move(image), {});
+    }
+  }
+
+  const Options& options() const { return options_; }
+  size_t decode_count() const { return decode_count_; }
+
+  bool respond_synchronously_ = false;
+  sk_sp<DlImage> synchronous_image_;
+
+ private:
+  std::shared_ptr<ImageDescriptorData> descriptor_;
+  Options options_;
+  ImageResult result_;
+  size_t decode_count_ = 0;
+};
+
+struct CallbackState {
+  size_t calls = 0;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  int32_t width = 0;
+  int32_t height = 0;
+  fml::AutoResetWaitableEvent* latch = nullptr;
+};
+
+void RecordCallback(void* user_data,
+                    FlutterSpiResult result,
+                    FlutterSpiImage* image) {
+  auto* state = static_cast<CallbackState*>(user_data);
+  state->calls++;
+  state->result = result;
+  if (image != nullptr) {
+    EXPECT_EQ(SpiImageGetSize(image, &state->width, &state->height),
+              kFlutterSpiOk);
+    EXPECT_EQ(SpiImageRelease(image), kFlutterSpiOk);
+  }
+  if (state->latch != nullptr) {
+    state->latch->Signal();
+  }
+}
+
+class SpiImageDecodingTest : public ThreadTest {
+ protected:
+  void SetUp() override {
+    ui_task_runner_ = CreateNewThread("spi-image-decoding-ui");
+    PostTaskSync(ui_task_runner_, [&] {
+      runners_ = std::make_unique<TaskRunners>(
+          "spi-image-decoding-test", ui_task_runner_, ui_task_runner_,
+          ui_task_runner_, ui_task_runner_);
+      decoder_ = std::make_unique<FakeImageDecoder>(*runners_);
+      registry_ = std::make_unique<ImageGeneratorRegistry>();
+      decoding_ = std::make_unique<SpiImageDecoding>(
+          decoder_->GetWeakPtr(), registry_->GetWeakPtr(), ui_task_runner_);
+    });
+  }
+
+  void TearDown() override {
+    PostTaskSync(ui_task_runner_, [&] {
+      decoding_.reset();
+      decoder_.reset();
+      registry_.reset();
+      runners_.reset();
+    });
+  }
+
+  fml::RefPtr<fml::TaskRunner> ui_task_runner_;
+  std::unique_ptr<TaskRunners> runners_;
+  std::unique_ptr<FakeImageDecoder> decoder_;
+  std::unique_ptr<ImageGeneratorRegistry> registry_;
+  std::unique_ptr<SpiImageDecoding> decoding_;
+};
+
+TEST_F(SpiImageDecodingTest, EncodedPngReachesCallback) {
+  const auto png = MakeTestPng();
+  ASSERT_TRUE(png);
+  CallbackState state;
+  fml::AutoResetWaitableEvent callback_latch;
+  state.latch = &callback_latch;
+
+  PostTaskSync(ui_task_runner_, [&] {
+    ASSERT_EQ(decoding_->DecodeEncoded(png->bytes(), png->size(), nullptr,
+                                       RecordCallback, &state),
+              kFlutterSpiOk);
+    EXPECT_EQ(state.calls, 0u);
+    decoder_->Respond(MakeTestImage());
+  });
+  callback_latch.Wait();
+
+  EXPECT_EQ(state.calls, 1u);
+  EXPECT_EQ(state.result, kFlutterSpiOk);
+  EXPECT_EQ(state.width, 3);
+  EXPECT_EQ(state.height, 2);
+}
+
+TEST_F(SpiImageDecodingTest, PassesTargetSize) {
+  const auto png = MakeTestPng();
+  ASSERT_TRUE(png);
+  const FlutterSpiImageDecodeOptions options = {
+      .struct_size = sizeof(FlutterSpiImageDecodeOptions),
+      .target_width = 7,
+      .target_height = 5,
+  };
+  CallbackState state;
+
+  PostTaskSync(ui_task_runner_, [&] {
+    ASSERT_EQ(decoding_->DecodeEncoded(png->bytes(), png->size(), &options,
+                                       RecordCallback, &state),
+              kFlutterSpiOk);
+    EXPECT_EQ(decoder_->options().target_width, 7u);
+    EXPECT_EQ(decoder_->options().target_height, 5u);
+  });
+}
+
+TEST_F(SpiImageDecodingTest, DecoderFailureIsInternalError) {
+  const auto png = MakeTestPng();
+  ASSERT_TRUE(png);
+  CallbackState state;
+  fml::AutoResetWaitableEvent callback_latch;
+  state.latch = &callback_latch;
+
+  PostTaskSync(ui_task_runner_, [&] {
+    ASSERT_EQ(decoding_->DecodeEncoded(png->bytes(), png->size(), nullptr,
+                                       RecordCallback, &state),
+              kFlutterSpiOk);
+    decoder_->Respond(nullptr);
+  });
+  callback_latch.Wait();
+
+  EXPECT_EQ(state.calls, 1u);
+  EXPECT_EQ(state.result, kFlutterSpiInternalError);
+}
+
+TEST_F(SpiImageDecodingTest, RejectsUnknownEncoding) {
+  constexpr uint8_t kGarbage[] = {0x01, 0x02, 0x03, 0x04};
+  CallbackState state;
+
+  PostTaskSync(ui_task_runner_, [&] {
+    EXPECT_EQ(decoding_->DecodeEncoded(kGarbage, sizeof(kGarbage), nullptr,
+                                       RecordCallback, &state),
+              kFlutterSpiInvalidArgument);
+    EXPECT_EQ(decoder_->decode_count(), 0u);
+  });
+  EXPECT_EQ(state.calls, 0u);
+}
+
+TEST_F(SpiImageDecodingTest, RejectsShortPixelBuffer) {
+  uint8_t pixels[16] = {};
+  CallbackState state;
+  FlutterSpiPixels input = {
+      .struct_size = sizeof(FlutterSpiPixels),
+      .pixels = pixels,
+      .pixels_size = sizeof(pixels),
+      .width = 2,
+      .height = 2,
+      .row_bytes = 7,
+      .pixel_format = kFlutterSpiPixelFormatRGBA8888,
+  };
+
+  PostTaskSync(ui_task_runner_, [&] {
+    EXPECT_EQ(decoding_->DecodePixels(&input, nullptr, RecordCallback, &state),
+              kFlutterSpiInvalidArgument);
+    input.row_bytes = 8;
+    input.pixels_size = 15;
+    EXPECT_EQ(decoding_->DecodePixels(&input, nullptr, RecordCallback, &state),
+              kFlutterSpiInvalidArgument);
+    input.pixels_size = sizeof(pixels);
+    input.pixels = nullptr;
+    EXPECT_EQ(decoding_->DecodePixels(&input, nullptr, RecordCallback, &state),
+              kFlutterSpiInvalidArgument);
+  });
+  EXPECT_EQ(state.calls, 0u);
+}
+
+TEST_F(SpiImageDecodingTest, RejectsUnknownPixelFormat) {
+  uint8_t pixels[16] = {};
+  const FlutterSpiPixels input = {
+      .struct_size = sizeof(FlutterSpiPixels),
+      .pixels = pixels,
+      .pixels_size = sizeof(pixels),
+      .width = 2,
+      .height = 2,
+      .row_bytes = 0,
+      .pixel_format = 99,
+  };
+  CallbackState state;
+
+  PostTaskSync(ui_task_runner_, [&] {
+    EXPECT_EQ(decoding_->DecodePixels(&input, nullptr, RecordCallback, &state),
+              kFlutterSpiInvalidArgument);
+  });
+  EXPECT_EQ(state.calls, 0u);
+}
+
+TEST_F(SpiImageDecodingTest, CallbackIsNeverSynchronous) {
+  const auto png = MakeTestPng();
+  ASSERT_TRUE(png);
+  CallbackState state;
+  fml::AutoResetWaitableEvent callback_latch;
+  state.latch = &callback_latch;
+
+  PostTaskSync(ui_task_runner_, [&] {
+    decoder_->respond_synchronously_ = true;
+    decoder_->synchronous_image_ = MakeTestImage();
+    ASSERT_EQ(decoding_->DecodeEncoded(png->bytes(), png->size(), nullptr,
+                                       RecordCallback, &state),
+              kFlutterSpiOk);
+    EXPECT_EQ(state.calls, 0u);
+  });
+  callback_latch.Wait();
+  EXPECT_EQ(state.calls, 1u);
+}
+
+TEST_F(SpiImageDecodingTest, ResultAfterShutdownIsDropped) {
+  const auto png = MakeTestPng();
+  ASSERT_TRUE(png);
+  CallbackState state;
+
+  PostTaskSync(ui_task_runner_, [&] {
+    ASSERT_EQ(decoding_->DecodeEncoded(png->bytes(), png->size(), nullptr,
+                                       RecordCallback, &state),
+              kFlutterSpiOk);
+    decoding_.reset();
+  });
+  PostTaskSync(ui_task_runner_, [&] { decoder_->Respond(MakeTestImage()); });
+  PostTaskSync(ui_task_runner_, [] {});
+
+  EXPECT_EQ(state.calls, 0u);
+}
+
+}  // namespace
+}  // namespace flutter::testing
