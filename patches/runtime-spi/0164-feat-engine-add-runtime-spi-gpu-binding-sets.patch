+class SpiGpuBindingSet final {
+ public:
+  struct BufferBinding {
+    impeller::ShaderStage stage;
+    impeller::ShaderUniformSlot slot;
+    const impeller::ShaderMetadata* metadata;
+    impeller::BufferView view;
+  };
+
+  struct TextureBinding {
+    impeller::ShaderStage stage;
+    impeller::SampledImageSlot slot;
+    const impeller::ShaderMetadata* metadata;
+    std::shared_ptr<const impeller::Texture> texture;
+    impeller::raw_ptr<const impeller::Sampler> sampler;
+    std::shared_ptr<impeller::Context> context;
+  };
+
+  ~SpiGpuBindingSet();
+
+  bool AddUniform(SpiGpuShader& shader,
+                  int uniform_struct_index,
+                  const std::shared_ptr<const impeller::DeviceBuffer>& buffer,
+                  size_t offset_in_bytes,
+                  size_t length_in_bytes);
+
+  bool AddTexture(
+      SpiGpuShader& shader,
+      int uniform_texture_index,
+      std::shared_ptr<const impeller::Texture> texture,
+      impeller::raw_ptr<const impeller::Sampler> sampler,
+      std::shared_ptr<impeller::Context> context = nullptr);
+
+  bool RetainShaderHandle(FlutterSpiGpuShader* shader,
+                          SpiGpuShader& core_shader,
+                          bool* out_newly_retained);
+  void ReleaseShaderHandle(FlutterSpiGpuShader* shader);
+  void Clear();
+
+  const std::vector<BufferBinding>& GetBufferBindings() const;
+  const std::vector<TextureBinding>& GetTextureBindings() const;
+
+ private:
+  void RetainShaderCore(SpiGpuShader& shader);
+  void ReleaseShaderHandles();
+
+  std::vector<BufferBinding> buffer_bindings_;
+  std::vector<TextureBinding> texture_bindings_;
+  std::vector<SpiGpuShader*> shaders_;
+  std::vector<FlutterSpiGpuShader*> shader_handles_;
+};
+
+FlutterSpiResult SpiGpuBindingSetCreate(FlutterSpiGpuBindingSet** out_set);
+FlutterSpiResult SpiGpuBindingSetAddUniform(
+    FlutterSpiGpuBindingSet* set,
+    FlutterSpiGpuShader* shader,
+    int32_t uniform_struct_index,
+    FlutterSpiGpuBuffer* buffer,
+    size_t offset,
+    size_t length);
+FlutterSpiResult SpiGpuBindingSetAddTexture(
+    FlutterSpiGpuBindingSet* set,
+    FlutterSpiGpuContext* context,
+    FlutterSpiGpuShader* shader,
+    int32_t uniform_texture_index,
+    FlutterSpiGpuTexture* texture,
+    const FlutterSpiGpuSamplerDescriptor* sampler);
+FlutterSpiResult SpiGpuBindingSetClear(FlutterSpiGpuBindingSet* set);
+FlutterSpiResult SpiGpuBindingSetRetain(FlutterSpiGpuBindingSet* set);
+FlutterSpiResult SpiGpuBindingSetRelease(FlutterSpiGpuBindingSet* set);
