+
+constexpr size_t kFrameInfoExtRes0 = 3;
+constexpr size_t kTextureIndex = 2;
+
+std::shared_ptr<SpiGpuShader> MakeShader(impeller::ShaderStage stage) {
+  std::unordered_map<std::string, SpiGpuShader::UniformBinding>
+      uniform_structs;
+  uniform_structs["FrameInfo"] = SpiGpuShader::UniformBinding{
+      .slot =
+          impeller::ShaderUniformSlot{
+              .name = "FrameInfo",
+              .ext_res_0 = kFrameInfoExtRes0,
+              .set = 0,
+              .binding = 0,
+          },
+      .metadata = impeller::ShaderMetadata{.name = "FrameInfo", .members = {}},
+      .size_in_bytes = 64,
+  };
+
+  std::unordered_map<std::string, SpiGpuShader::TextureBinding>
+      uniform_textures;
+  SpiGpuShader::TextureBinding texture_binding;
+  texture_binding.slot = impeller::SampledImageSlot{
+      .name = "tex",
+      .texture_index = kTextureIndex,
+      .set = 0,
+      .binding = 1,
+  };
+  texture_binding.metadata =
+      impeller::ShaderMetadata{.name = "tex", .members = {}};
+  uniform_textures["tex"] = texture_binding;
+
+  return SpiGpuShader::Make(
+      "library", "Entrypoint", stage, /*code_mapping=*/nullptr,
+      /*inputs=*/{}, /*layouts=*/{}, std::move(uniform_structs),
+      std::move(uniform_textures), /*descriptor_set_layouts=*/{});
+}
+
+std::shared_ptr<impeller::DeviceBuffer> MakeBuffer(size_t size) {
+  impeller::DeviceBufferDescriptor descriptor;
+  descriptor.size = size;
+  return std::make_shared<impeller::testing::MockDeviceBuffer>(descriptor);
+}
+
+std::shared_ptr<impeller::Texture> MakeTexture() {
+  impeller::TextureDescriptor descriptor;
+  descriptor.size = impeller::ISize{1, 1};
+  return std::make_shared<impeller::testing::MockTexture>(descriptor);
+}
+
+TEST(FlutterGpuBindingSetTest, AddUniformResolvesTheShaderBinding) {
+  auto shader = MakeShader(impeller::ShaderStage::kVertex);
+  SpiGpuBindingSet binding_set;
+  auto buffer = MakeBuffer(128);
+
+  EXPECT_TRUE(binding_set.AddUniform(*shader, /*uniform_struct_index=*/0,
+                                     buffer, /*offset_in_bytes=*/16,
+                                     /*length_in_bytes=*/64));
+
+  ASSERT_EQ(binding_set.GetBufferBindings().size(), 1u);
+  const SpiGpuBindingSet::BufferBinding& binding =
+      binding_set.GetBufferBindings()[0];
+  EXPECT_EQ(binding.stage, impeller::ShaderStage::kVertex);
+  EXPECT_EQ(binding.slot.ext_res_0, kFrameInfoExtRes0);
+  ASSERT_NE(binding.metadata, nullptr);
+  EXPECT_EQ(binding.metadata->name, "FrameInfo");
+  EXPECT_EQ(binding.view.GetRange().offset, 16u);
+  EXPECT_EQ(binding.view.GetRange().length, 64u);
+}
+
+TEST(FlutterGpuBindingSetTest, AddUniformRejectsAnOutOfRangeIndex) {
+  auto shader = MakeShader(impeller::ShaderStage::kFragment);
+  SpiGpuBindingSet binding_set;
+  auto buffer = MakeBuffer(128);
+
+  EXPECT_FALSE(binding_set.AddUniform(*shader, /*uniform_struct_index=*/1,
+                                      buffer, /*offset_in_bytes=*/0,
+                                      /*length_in_bytes=*/64));
+  EXPECT_FALSE(binding_set.AddUniform(*shader, /*uniform_struct_index=*/-1,
+                                      buffer, /*offset_in_bytes=*/0,
+                                      /*length_in_bytes=*/64));
+  EXPECT_TRUE(binding_set.GetBufferBindings().empty());
+}
+
+TEST(FlutterGpuBindingSetTest, AddUniformRejectsAViewPastTheEndOfTheBuffer) {
+  auto shader = MakeShader(impeller::ShaderStage::kVertex);
+  SpiGpuBindingSet binding_set;
+  auto buffer = MakeBuffer(64);
+
+  EXPECT_FALSE(binding_set.AddUniform(*shader, /*uniform_struct_index=*/0,
+                                      buffer, /*offset_in_bytes=*/32,
+                                      /*length_in_bytes=*/64));
+  EXPECT_FALSE(binding_set.AddUniform(*shader, /*uniform_struct_index=*/0,
+                                      /*buffer=*/nullptr,
+                                      /*offset_in_bytes=*/0,
+                                      /*length_in_bytes=*/64));
+  EXPECT_TRUE(binding_set.GetBufferBindings().empty());
+}
+
+TEST(FlutterGpuBindingSetTest, AddRejectsNonRenderStages) {
+  auto shader = MakeShader(impeller::ShaderStage::kCompute);
+  SpiGpuBindingSet binding_set;
+  auto buffer = MakeBuffer(128);
+
+  EXPECT_FALSE(binding_set.AddUniform(*shader, /*uniform_struct_index=*/0,
+                                      buffer, /*offset_in_bytes=*/0,
+                                      /*length_in_bytes=*/64));
+  EXPECT_TRUE(binding_set.GetBufferBindings().empty());
+}
+
+TEST(FlutterGpuBindingSetTest, AddTextureResolvesTheShaderBinding) {
+  auto shader = MakeShader(impeller::ShaderStage::kFragment);
+  SpiGpuBindingSet binding_set;
+  auto texture = MakeTexture();
+  std::shared_ptr<const impeller::Sampler> sampler =
+      std::make_shared<impeller::testing::MockSampler>(
+          impeller::SamplerDescriptor{});
+
+  EXPECT_TRUE(binding_set.AddTexture(
+      *shader, /*uniform_texture_index=*/0, texture,
+      impeller::raw_ptr<const impeller::Sampler>(sampler)));
+
+  ASSERT_EQ(binding_set.GetTextureBindings().size(), 1u);
+  const SpiGpuBindingSet::TextureBinding& binding =
+      binding_set.GetTextureBindings()[0];
+  EXPECT_EQ(binding.stage, impeller::ShaderStage::kFragment);
+  EXPECT_EQ(binding.slot.texture_index, kTextureIndex);
+  ASSERT_NE(binding.metadata, nullptr);
+  EXPECT_EQ(binding.metadata->name, "tex");
+  EXPECT_EQ(binding.texture, texture);
+}
+
+TEST(FlutterGpuBindingSetTest, AddTextureRejectsAnOutOfRangeIndex) {
+  auto shader = MakeShader(impeller::ShaderStage::kFragment);
+  SpiGpuBindingSet binding_set;
+  auto texture = MakeTexture();
+  std::shared_ptr<const impeller::Sampler> sampler =
+      std::make_shared<impeller::testing::MockSampler>(
+          impeller::SamplerDescriptor{});
+
+  EXPECT_FALSE(binding_set.AddTexture(
+      *shader, /*uniform_texture_index=*/1, texture,
+      impeller::raw_ptr<const impeller::Sampler>(sampler)));
+  EXPECT_TRUE(binding_set.GetTextureBindings().empty());
+}
+
+TEST(FlutterGpuBindingSetTest, ClearDropsEveryBinding) {
+  auto shader = MakeShader(impeller::ShaderStage::kFragment);
+  SpiGpuBindingSet binding_set;
+  auto buffer = MakeBuffer(128);
+  auto texture = MakeTexture();
+  std::shared_ptr<const impeller::Sampler> sampler =
+      std::make_shared<impeller::testing::MockSampler>(
+          impeller::SamplerDescriptor{});
+
+  ASSERT_TRUE(binding_set.AddUniform(*shader, /*uniform_struct_index=*/0,
+                                     buffer, /*offset_in_bytes=*/0,
+                                     /*length_in_bytes=*/64));
+  ASSERT_TRUE(binding_set.AddTexture(
+      *shader, /*uniform_texture_index=*/0, texture,
+      impeller::raw_ptr<const impeller::Sampler>(sampler)));
+
+  binding_set.Clear();
+
+  EXPECT_TRUE(binding_set.GetBufferBindings().empty());
+  EXPECT_TRUE(binding_set.GetTextureBindings().empty());
+}
+
+}  // namespace
+}  // namespace testing
+}  // namespace flutter
