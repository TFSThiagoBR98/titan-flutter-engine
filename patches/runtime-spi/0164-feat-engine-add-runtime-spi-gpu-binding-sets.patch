+  FlutterSpiGpuBindingSet* set = nullptr;
+  ASSERT_EQ(SpiGpuBindingSetCreate(&set), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuBindingSetRelease(set), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuBindingSetRetain(set), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuBindingSetClear(set), kFlutterSpiInvalidHandle);
+}
