+std::shared_ptr<std::vector<uint8_t>> BuildBindingSetShaderBundle() {
+  namespace fbs = impeller::fb::shaderbundle;
+  auto vulkan = std::make_unique<fbs::BackendShaderT>();
+  vulkan->stage = fbs::ShaderStage::kFragment;
+  vulkan->entrypoint = "main";
+  vulkan->shader = {1};
+
+  auto uniform = std::make_unique<fbs::ShaderUniformStructT>();
+  uniform->name = "FrameInfo";
+  uniform->ext_res_0 = 3;
+  uniform->size_in_bytes = 64;
+  vulkan->uniform_structs.push_back(std::move(uniform));
+
+  auto texture = std::make_unique<fbs::ShaderUniformTextureT>();
+  texture->name = "tex";
+  texture->ext_res_0 = 2;
+  texture->set = 0;
+  texture->binding = 1;
+  vulkan->uniform_textures.push_back(std::move(texture));
+
+  auto shader = std::make_unique<fbs::ShaderT>();
+  shader->name = "test";
+  shader->vulkan = std::move(vulkan);
+  fbs::ShaderBundleT bundle;
+  bundle.format_version =
+      static_cast<uint32_t>(fbs::ShaderBundleFormatVersion::kVersion);
+  bundle.shaders.push_back(std::move(shader));
+  flatbuffers::FlatBufferBuilder builder;
+  builder.Finish(fbs::ShaderBundle::Pack(builder, &bundle),
+                 fbs::ShaderBundleIdentifier());
+  return std::make_shared<std::vector<uint8_t>>(
+      builder.GetBufferPointer(),
+      builder.GetBufferPointer() + builder.GetSize());
+}
