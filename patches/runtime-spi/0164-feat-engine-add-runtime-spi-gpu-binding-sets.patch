+TEST_F(SpiGpuContextTest, BindingSetOutlivesResourceHandles) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto allocator =
+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  auto device_buffer = std::make_shared<NiceMock<impeller::testing::MockDeviceBuffer>>(
+      impeller::DeviceBufferDescriptor{.size = 128});
+  auto texture = std::make_shared<NiceMock<impeller::testing::MockTexture>>(
+      impeller::TextureDescriptor{});
+  AllowTextureDimensions(*allocator);
+  ON_CALL(*allocator, OnCreateBuffer(::testing::_)).WillByDefault(Return(device_buffer));
+  ON_CALL(*allocator, OnCreateTexture(::testing::_, true))
+      .WillByDefault(Return(texture));
+  auto sampler_library =
+      std::make_shared<NiceMock<impeller::testing::MockSamplerLibrary>>();
+  std::shared_ptr<const impeller::Sampler> sampler =
+      std::make_shared<impeller::testing::MockSampler>(
+          impeller::SamplerDescriptor{});
+  ON_CALL(*sampler_library, GetSampler(::testing::_))
+      .WillByDefault(Return(impeller::raw_ptr<const impeller::Sampler>(sampler)));
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  ON_CALL(*context, GetSamplerLibrary()).WillByDefault(Return(sampler_library));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  auto shader_handles = MakeBindingShaderHandles(gpu_context);
+  ASSERT_NE(shader_handles.shader, nullptr);
+  FlutterSpiGpuBindingSet* set = nullptr;
+  ASSERT_EQ(SpiGpuBindingSetCreate(&set), kFlutterSpiOk);
+
+  FlutterSpiGpuBufferDescriptor buffer_descriptor = {
+      .struct_size = sizeof(buffer_descriptor),
+      .storage_mode = kFlutterSpiGpuStorageModeHostVisible,
+      .size = 128,
+  };
+  FlutterSpiGpuBuffer* buffer = nullptr;
+  ASSERT_EQ(SpiGpuBufferCreate(gpu_context, &buffer_descriptor, &buffer),
+            kFlutterSpiOk);
+  FlutterSpiGpuTexture* gpu_texture = nullptr;
+  auto texture_descriptor = MakeTextureDescriptor();
+  ASSERT_EQ(SpiGpuTextureCreate(gpu_context, &texture_descriptor, &gpu_texture),
+            kFlutterSpiOk);
+  auto sampler_descriptor = MakeSamplerDescriptor();
+  ASSERT_EQ(SpiGpuBindingSetAddUniform(set, shader_handles.shader, 0, buffer,
+                                       0, 64),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiGpuBindingSetAddTexture(set, gpu_context, shader_handles.shader,
+                                       0, gpu_texture, &sampler_descriptor),
+            kFlutterSpiOk);
+
+  EXPECT_EQ(SpiGpuShaderRelease(shader_handles.shader), kFlutterSpiOk);
+  shader_handles.shader = nullptr;
+  EXPECT_EQ(SpiGpuShaderLibraryRelease(shader_handles.library), kFlutterSpiOk);
+  shader_handles.library = nullptr;
+  EXPECT_EQ(SpiGpuBufferRelease(buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuTextureRelease(gpu_texture), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+  EXPECT_NE(SpiGpuBindingSetGetCore(set), nullptr);
+  EXPECT_EQ(SpiGpuBindingSetGetCore(set)->GetBufferBindings().size(), 1u);
+  EXPECT_EQ(SpiGpuBindingSetGetCore(set)->GetTextureBindings().size(), 1u);
+  EXPECT_EQ(SpiGpuBindingSetRelease(set), kFlutterSpiOk);
+}
