@@ -0,0 +1,291 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/gpu/spi_gpu_binding_set.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+
+#include "flutter/runtime_spi/gpu/spi_gpu_buffer.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_context.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_formats.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_texture.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "impeller/core/device_buffer.h"
+#include "impeller/renderer/context.h"
+#include "impeller/renderer/sampler_library.h"
+
+namespace flutter {
+namespace {
+
+SpiHandleTable<SpiGpuBindingSet>& BindingSets() {
+  return LeakedHandleTable<SpiGpuBindingSet>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuBindingSet* set) {
+  return reinterpret_cast<uintptr_t>(set);
+}
+
+FlutterSpiGpuBindingSet* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuBindingSet*>(value);
+}
+
+SpiGpuBindingSet* FindBindingSet(FlutterSpiGpuBindingSet* set) {
+  return BindingSets().FindRaw(HandleValue(set));
+}
+
+bool IsRenderStage(impeller::ShaderStage stage) {
+  return stage == impeller::ShaderStage::kVertex ||
+         stage == impeller::ShaderStage::kFragment;
+}
+
+bool HasCompleteSamplerDescriptor(
+    const FlutterSpiGpuSamplerDescriptor* descriptor) {
+  return descriptor != nullptr &&
+         descriptor->struct_size >=
+             offsetof(FlutterSpiGpuSamplerDescriptor, max_anisotropy) +
+                 sizeof(descriptor->max_anisotropy);
+}
+
+}  // namespace
+
+SpiGpuBindingSet::~SpiGpuBindingSet() {
+  ReleaseShaderHandles();
+}
+
+void SpiGpuBindingSet::RetainShaderCore(SpiGpuShader& shader) {
+  if (std::find(shaders_.begin(), shaders_.end(), &shader) == shaders_.end()) {
+    shaders_.push_back(&shader);
+  }
+}
+
+bool SpiGpuBindingSet::RetainShaderHandle(FlutterSpiGpuShader* shader,
+                                          SpiGpuShader& core_shader,
+                                          bool* out_newly_retained) {
+  if (out_newly_retained == nullptr) {
+    return false;
+  }
+  RetainShaderCore(core_shader);
+  if (std::find(shader_handles_.begin(), shader_handles_.end(), shader) !=
+      shader_handles_.end()) {
+    *out_newly_retained = false;
+    return true;
+  }
+  if (SpiGpuShaderRetain(shader) != kFlutterSpiOk) {
+    return false;
+  }
+  shader_handles_.push_back(shader);
+  *out_newly_retained = true;
+  return true;
+}
+
+void SpiGpuBindingSet::ReleaseShaderHandle(FlutterSpiGpuShader* shader) {
+  const auto iterator =
+      std::find(shader_handles_.begin(), shader_handles_.end(), shader);
+  if (iterator == shader_handles_.end()) {
+    return;
+  }
+  SpiGpuShaderRelease(*iterator);
+  shader_handles_.erase(iterator);
+}
+
+void SpiGpuBindingSet::ReleaseShaderHandles() {
+  for (FlutterSpiGpuShader* shader : shader_handles_) {
+    SpiGpuShaderRelease(shader);
+  }
+  shader_handles_.clear();
+  shaders_.clear();
+}
+
+bool SpiGpuBindingSet::AddUniform(
+    SpiGpuShader& shader,
+    int uniform_struct_index,
+    const std::shared_ptr<const impeller::DeviceBuffer>& buffer,
+    size_t offset_in_bytes,
+    size_t length_in_bytes) {
+  if (!IsRenderStage(shader.GetShaderStage())) {
+    return false;
+  }
+  const SpiGpuShader::UniformBinding* uniform_struct =
+      shader.GetUniformStructAt(uniform_struct_index);
+  if (uniform_struct == nullptr || buffer == nullptr) {
+    return false;
+  }
+  const size_t buffer_size = buffer->GetDeviceBufferDescriptor().size;
+  if (offset_in_bytes > buffer_size ||
+      length_in_bytes > buffer_size - offset_in_bytes) {
+    return false;
+  }
+
+  RetainShaderCore(shader);
+  buffer_bindings_.push_back({
+      .stage = shader.GetShaderStage(),
+      .slot = uniform_struct->slot,
+      .metadata = &uniform_struct->metadata,
+      .view = impeller::BufferView(
+          buffer, impeller::Range(offset_in_bytes, length_in_bytes)),
+  });
+  return true;
+}
+
+bool SpiGpuBindingSet::AddTexture(
+    SpiGpuShader& shader,
+    int uniform_texture_index,
+    std::shared_ptr<const impeller::Texture> texture,
+    impeller::raw_ptr<const impeller::Sampler> sampler,
+    std::shared_ptr<impeller::Context> context) {
+  if (!IsRenderStage(shader.GetShaderStage())) {
+    return false;
+  }
+  const SpiGpuShader::TextureBinding* texture_binding =
+      shader.GetUniformTextureAt(uniform_texture_index);
+  if (texture_binding == nullptr || texture == nullptr || !sampler) {
+    return false;
+  }
+
+  RetainShaderCore(shader);
+  texture_bindings_.push_back({
+      .stage = shader.GetShaderStage(),
+      .slot = texture_binding->slot,
+      .metadata = &texture_binding->metadata,
+      .texture = std::move(texture),
+      .sampler = std::move(sampler),
+      .context = std::move(context),
+  });
+  return true;
+}
+
+void SpiGpuBindingSet::Clear() {
+  buffer_bindings_.clear();
+  texture_bindings_.clear();
+  ReleaseShaderHandles();
+}
+
+const std::vector<SpiGpuBindingSet::BufferBinding>&
+SpiGpuBindingSet::GetBufferBindings() const {
+  return buffer_bindings_;
+}
+
+const std::vector<SpiGpuBindingSet::TextureBinding>&
+SpiGpuBindingSet::GetTextureBindings() const {
+  return texture_bindings_;
+}
+
+FlutterSpiResult SpiGpuBindingSetCreate(FlutterSpiGpuBindingSet** out_set) {
+  if (out_set == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_set = nullptr;
+  const uintptr_t handle =
+      BindingSets().Insert(std::make_shared<SpiGpuBindingSet>());
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_set = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuBindingSetAddUniform(
+    FlutterSpiGpuBindingSet* set,
+    FlutterSpiGpuShader* shader,
+    int32_t uniform_struct_index,
+    FlutterSpiGpuBuffer* buffer,
+    size_t offset,
+    size_t length) {
+  SpiGpuBindingSet* set_value = FindBindingSet(set);
+  SpiGpuShader* shader_value = SpiGpuShaderGetCore(shader);
+  const std::shared_ptr<impeller::DeviceBuffer> buffer_value =
+      SpiGpuBufferGetImpeller(buffer);
+  if (set_value == nullptr || shader_value == nullptr ||
+      buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  bool newly_retained = false;
+  if (!set_value->RetainShaderHandle(shader, *shader_value,
+                                     &newly_retained)) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (set_value->AddUniform(*shader_value, uniform_struct_index, buffer_value,
+                            offset, length)) {
+    return kFlutterSpiOk;
+  }
+  if (newly_retained) {
+    set_value->ReleaseShaderHandle(shader);
+  }
+  return kFlutterSpiInvalidArgument;
+}
+
+FlutterSpiResult SpiGpuBindingSetAddTexture(
+    FlutterSpiGpuBindingSet* set,
+    FlutterSpiGpuContext* context,
+    FlutterSpiGpuShader* shader,
+    int32_t uniform_texture_index,
+    FlutterSpiGpuTexture* texture,
+    const FlutterSpiGpuSamplerDescriptor* sampler) {
+  SpiGpuBindingSet* set_value = FindBindingSet(set);
+  SpiGpuShader* shader_value = SpiGpuShaderGetCore(shader);
+  const std::shared_ptr<impeller::Texture> texture_value =
+      SpiGpuTextureGetImpeller(texture);
+  const std::shared_ptr<impeller::Context> context_value =
+      SpiGpuContextGetImpeller(context);
+  if (set_value == nullptr || shader_value == nullptr ||
+      texture_value == nullptr || context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!HasCompleteSamplerDescriptor(sampler)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const std::shared_ptr<impeller::SamplerLibrary> sampler_library =
+      context_value->GetSamplerLibrary();
+  if (sampler_library == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const impeller::SamplerDescriptor sampler_descriptor =
+      SpiGpuToImpellerSamplerDescriptor(*sampler);
+  const impeller::raw_ptr<const impeller::Sampler> sampler_value =
+      sampler_library->GetSampler(sampler_descriptor);
+  if (!sampler_value) {
+    return kFlutterSpiInternalError;
+  }
+
+  bool newly_retained = false;
+  if (!set_value->RetainShaderHandle(shader, *shader_value,
+                                     &newly_retained)) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (set_value->AddTexture(*shader_value, uniform_texture_index,
+                            texture_value, sampler_value, context_value)) {
+    return kFlutterSpiOk;
+  }
+  if (newly_retained) {
+    set_value->ReleaseShaderHandle(shader);
+  }
+  return kFlutterSpiInvalidArgument;
+}
+
+FlutterSpiResult SpiGpuBindingSetClear(FlutterSpiGpuBindingSet* set) {
+  SpiGpuBindingSet* set_value = FindBindingSet(set);
+  if (set_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  set_value->Clear();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuBindingSetRetain(FlutterSpiGpuBindingSet* set) {
+  return BindingSets().Retain(HandleValue(set)) ? kFlutterSpiOk
+                                                : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuBindingSetRelease(FlutterSpiGpuBindingSet* set) {
+  return BindingSets().Release(HandleValue(set)) ? kFlutterSpiOk
+                                                 : kFlutterSpiInvalidHandle;
+}
+
+SpiGpuBindingSet* SpiGpuBindingSetGetCore(FlutterSpiGpuBindingSet* set) {
+  return FindBindingSet(set);
+}
