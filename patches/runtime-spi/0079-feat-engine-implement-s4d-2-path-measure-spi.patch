+FlutterSpiPath* CreateMeasuredPath() {
+  FlutterSpiPath* path = CreatePath();
+  EXPECT_EQ(Api()->path_move_to(path, 0, 0), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_line_to(path, 3, 4), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_close(path), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_move_to(path, 10, 10), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_line_to(path, 13, 14), kFlutterSpiOk);
+  return path;
+}
