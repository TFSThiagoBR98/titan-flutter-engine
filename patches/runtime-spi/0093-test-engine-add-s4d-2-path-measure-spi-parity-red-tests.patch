diff --git a/engine/src/flutter/runtime_spi/scene/spi_path_measure_parity_unittests.cc b/engine/src/flutter/runtime_spi/scene/spi_path_measure_parity_unittests.cc
new file mode 100644
index 00000000000..2af0138c545
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/scene/spi_path_measure_parity_unittests.cc
@@ -0,0 +1,212 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/scene/spi_canvas.h"
+
+#include <memory>
+
+#include "flutter/runtime_spi/include/flutter_scene.h"
+#include "flutter/testing/testing.h"
+#include "third_party/skia/include/core/SkContourMeasure.h"
+#include "third_party/skia/include/core/SkPathBuilder.h"
+
+namespace flutter::testing {
+namespace {
+
+const FlutterSpiSceneApi* Api() {
+  return SpiSceneApi();
+}
+
+FlutterSpiPath* CreatePath() {
+  FlutterSpiPath* path = nullptr;
+  EXPECT_EQ(Api()->path_create(nullptr, &path), kFlutterSpiOk);
+  EXPECT_NE(path, nullptr);
+  return path;
+}
+
+FlutterSpiPath* CreateMeasuredPath() {
+  FlutterSpiPath* path = CreatePath();
+  EXPECT_EQ(Api()->path_move_to(path, 0, 0), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_line_to(path, 3, 4), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_close(path), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_move_to(path, 10, 10), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_line_to(path, 13, 14), kFlutterSpiOk);
+  return path;
+}
+
+const SkPath& SkPathFor(FlutterSpiPath* path) {
+  return SpiPathForTesting(path)->GetSkPath();
+}
+
+TEST(SpiPathMeasureParity, CreateMatchesSkContourMeasure) {
+  ASSERT_NE(Api()->path_measure_create, nullptr);
+  FlutterSpiPath* path = CreateMeasuredPath();
+  FlutterSpiPathMeasure* measure = nullptr;
+  ASSERT_EQ(Api()->path_measure_create(path, false, &measure), kFlutterSpiOk);
+  ASSERT_NE(measure, nullptr);
+
+  std::unique_ptr<SkContourMeasureIter> expected_iter =
+      std::make_unique<SkContourMeasureIter>(SkPathFor(path), false, 1);
+  ASSERT_NE(expected_iter->next(), nullptr);
+  bool has_contour = false;
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  EXPECT_TRUE(has_contour);
+
+  EXPECT_EQ(Api()->path_measure_release(measure), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_release(path), kFlutterSpiOk);
+}
+
+TEST(SpiPathMeasureParity, SetPathMatchesSkContourMeasure) {
+  ASSERT_NE(Api()->path_measure_set_path, nullptr);
+  FlutterSpiPath* path = CreateMeasuredPath();
+  FlutterSpiPath* replacement = CreatePath();
+  ASSERT_EQ(Api()->path_move_to(replacement, 0, 0), kFlutterSpiOk);
+  ASSERT_EQ(Api()->path_line_to(replacement, 0, 8), kFlutterSpiOk);
+  FlutterSpiPathMeasure* measure = nullptr;
+  ASSERT_EQ(Api()->path_measure_create(path, false, &measure), kFlutterSpiOk);
+  ASSERT_EQ(Api()->path_measure_set_path(measure, replacement, false),
+            kFlutterSpiOk);
+
+  float length = 0;
+  bool has_contour = false;
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  ASSERT_TRUE(has_contour);
+  ASSERT_EQ(Api()->path_measure_get_length(measure, 0, &length), kFlutterSpiOk);
+  EXPECT_FLOAT_EQ(length, 8.0f);
+
+  EXPECT_EQ(Api()->path_measure_release(measure), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_release(replacement), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_release(path), kFlutterSpiOk);
+}
+
+TEST(SpiPathMeasureParity, GetLengthMatchesSkia) {
+  ASSERT_NE(Api()->path_measure_get_length, nullptr);
+  FlutterSpiPath* path = CreateMeasuredPath();
+  FlutterSpiPathMeasure* measure = nullptr;
+  ASSERT_EQ(Api()->path_measure_create(path, false, &measure), kFlutterSpiOk);
+  bool has_contour = false;
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  ASSERT_TRUE(has_contour);
+
+  SkContourMeasureIter expected_iter(SkPathFor(path), false, 1);
+  sk_sp<SkContourMeasure> expected = expected_iter.next();
+  ASSERT_NE(expected, nullptr);
+  float length = 0;
+  ASSERT_EQ(Api()->path_measure_get_length(measure, 0, &length), kFlutterSpiOk);
+  EXPECT_FLOAT_EQ(length, expected->length());
+
+  EXPECT_EQ(Api()->path_measure_release(measure), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_release(path), kFlutterSpiOk);
+}
+
+TEST(SpiPathMeasureParity, GetPosTanMatchesSkia) {
+  ASSERT_NE(Api()->path_measure_get_pos_tan, nullptr);
+  FlutterSpiPath* path = CreateMeasuredPath();
+  FlutterSpiPathMeasure* measure = nullptr;
+  ASSERT_EQ(Api()->path_measure_create(path, false, &measure), kFlutterSpiOk);
+  bool has_contour = false;
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  ASSERT_TRUE(has_contour);
+
+  SkContourMeasureIter expected_iter(SkPathFor(path), false, 1);
+  sk_sp<SkContourMeasure> expected = expected_iter.next();
+  ASSERT_NE(expected, nullptr);
+  SkPoint expected_position;
+  SkVector expected_tangent;
+  ASSERT_TRUE(expected->getPosTan(2.0f, &expected_position, &expected_tangent));
+
+  FlutterSpiPoint position;
+  FlutterSpiPoint tangent;
+  bool ok = false;
+  ASSERT_EQ(Api()->path_measure_get_pos_tan(measure, 0, 2.0f, &position,
+                                            &tangent, &ok),
+            kFlutterSpiOk);
+  ASSERT_TRUE(ok);
+  EXPECT_FLOAT_EQ(position.x, expected_position.x());
+  EXPECT_FLOAT_EQ(position.y, expected_position.y());
+  EXPECT_FLOAT_EQ(tangent.x, expected_tangent.x());
+  EXPECT_FLOAT_EQ(tangent.y, expected_tangent.y());
+
+  EXPECT_EQ(Api()->path_measure_release(measure), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_release(path), kFlutterSpiOk);
+}
+
+TEST(SpiPathMeasureParity, GetSegmentMatchesSkia) {
+  ASSERT_NE(Api()->path_measure_get_segment, nullptr);
+  FlutterSpiPath* path = CreateMeasuredPath();
+  FlutterSpiPathMeasure* measure = nullptr;
+  ASSERT_EQ(Api()->path_measure_create(path, false, &measure), kFlutterSpiOk);
+  bool has_contour = false;
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  ASSERT_TRUE(has_contour);
+
+  SkContourMeasureIter expected_iter(SkPathFor(path), false, 1);
+  sk_sp<SkContourMeasure> expected = expected_iter.next();
+  ASSERT_NE(expected, nullptr);
+  SkPathBuilder expected_builder;
+  ASSERT_TRUE(expected->getSegment(1.0f, 5.0f, &expected_builder, true));
+
+  FlutterSpiPath* segment = nullptr;
+  ASSERT_EQ(Api()->path_measure_get_segment(measure, 0, 1.0f, 5.0f, true,
+                                            &segment),
+            kFlutterSpiOk);
+  ASSERT_NE(segment, nullptr);
+  EXPECT_EQ(SkPathFor(segment), expected_builder.detach());
+
+  EXPECT_EQ(Api()->path_release(segment), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_measure_release(measure), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_release(path), kFlutterSpiOk);
+}
+
+TEST(SpiPathMeasureParity, IsClosedMatchesSkia) {
+  ASSERT_NE(Api()->path_measure_is_closed, nullptr);
+  FlutterSpiPath* path = CreateMeasuredPath();
+  FlutterSpiPathMeasure* measure = nullptr;
+  ASSERT_EQ(Api()->path_measure_create(path, false, &measure), kFlutterSpiOk);
+  bool has_contour = false;
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  ASSERT_TRUE(has_contour);
+
+  bool is_closed = false;
+  ASSERT_EQ(Api()->path_measure_is_closed(measure, 0, &is_closed),
+            kFlutterSpiOk);
+  EXPECT_TRUE(is_closed);
+
+  EXPECT_EQ(Api()->path_measure_release(measure), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_release(path), kFlutterSpiOk);
+}
+
+TEST(SpiPathMeasureParity, NextContourMatchesSkia) {
+  ASSERT_NE(Api()->path_measure_next_contour, nullptr);
+  FlutterSpiPath* path = CreateMeasuredPath();
+  FlutterSpiPathMeasure* measure = nullptr;
+  ASSERT_EQ(Api()->path_measure_create(path, false, &measure), kFlutterSpiOk);
+
+  SkContourMeasureIter expected_iter(SkPathFor(path), false, 1);
+  ASSERT_NE(expected_iter.next(), nullptr);
+  ASSERT_NE(expected_iter.next(), nullptr);
+
+  bool has_contour = false;
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  EXPECT_TRUE(has_contour);
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  EXPECT_TRUE(has_contour);
+  ASSERT_EQ(Api()->path_measure_next_contour(measure, &has_contour),
+            kFlutterSpiOk);
+  EXPECT_FALSE(has_contour);
+
+  EXPECT_EQ(Api()->path_measure_release(measure), kFlutterSpiOk);
+  EXPECT_EQ(Api()->path_release(path), kFlutterSpiOk);
+}
+
+}  // namespace
+}  // namespace flutter::testing
