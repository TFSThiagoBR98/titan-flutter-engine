+
+int SpiGpuShader::GetStorageBufferIndex(const std::string& name) const {
+  const StorageBufferBinding* binding = GetStorageBuffer(name);
+  if (binding == nullptr) {
+    return -1;
+  }
+  for (size_t index = 0; index < storage_buffer_order_.size(); ++index) {
+    if (storage_buffer_order_[index] == binding) {
+      return static_cast<int>(index);
