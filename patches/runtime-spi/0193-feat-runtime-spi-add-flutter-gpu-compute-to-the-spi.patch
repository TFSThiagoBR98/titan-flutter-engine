+}  // namespace
+
+SpiGpuComputePipeline::SpiGpuComputePipeline(FlutterSpiGpuShader* shader)
+    : shader_handle_(shader), shader_(GetCoreShader(shader)) {
+  SpiGpuShaderRetain(shader_handle_);
+}
+
+SpiGpuComputePipeline::~SpiGpuComputePipeline() {
+  SpiGpuShaderRelease(shader_handle_);
+}
+
+bool SpiGpuComputePipeline::Build(impeller::Context& context,
+                                  std::string* error) {
+  if (shader_ == nullptr || error == nullptr) {
+    return false;
+  }
+  if (shader_->GetShaderStage() != impeller::ShaderStage::kCompute) {
+    *error = absl::StrCat("The shader '", shader_->GetEntrypoint(),
+                          "' is not a compute shader.");
+    return false;
+  }
+  if (!shader_->RegisterSync(context)) {
+    *error =
+        absl::StrCat("Failed to register the shader '",
+                     shader_->GetEntrypoint(), "' with the shader library.");
+    return false;
+  }
+  const std::shared_ptr<impeller::ShaderLibrary> library =
+      context.GetShaderLibrary();
+  std::shared_ptr<const impeller::ShaderFunction> function =
+      library == nullptr ? nullptr : shader_->GetFunctionFromLibrary(*library);
+  if (function == nullptr) {
+    *error =
+        absl::StrCat("Unable to resolve the compute shader function '",
+                     shader_->GetEntrypoint(), "' from the shader library.");
+    return false;
+  }
+  const auto& workgroup_size = shader_->GetWorkgroupSize();
+  if (!workgroup_size.has_value()) {
+    *error = absl::StrCat("The shader '", shader_->GetEntrypoint(),
+                          "' is not a compute shader.");
+    return false;
+  }
+
+  impeller::ComputePipelineDescriptor descriptor;
+  descriptor.SetLabel(shader_->GetEntrypoint());
+  descriptor.SetStageEntrypoint(std::move(function));
+  descriptor.SetWorkgroupSize(workgroup_size.value());
+  descriptor.RegisterDescriptorSetLayouts(
+      shader_->GetDescriptorSetLayouts().data(),
+      shader_->GetDescriptorSetLayouts().size());
+  const impeller::ComputeLimits limits =
+      context.GetCapabilities()->GetComputeLimits();
+  if (absl::Status status = descriptor.ValidateWorkgroupSize(
+          limits.max_workgroup_size, limits.max_workgroup_invocations);
+      !status.ok()) {
+    *error = std::string(status.message());
+    return false;
+  }
+  pipeline_ = context.GetPipelineLibrary()
+                  ->GetPipeline(descriptor, /*async=*/false)
+                  .Get();
+  if (pipeline_ == nullptr) {
+    const auto& size = workgroup_size.value();
+    *error = absl::StrCat(
+        "Failed to build the compute pipeline for the shader '",
+        shader_->GetEntrypoint(), "'. Its workgroup size of ", size[0], "x",
+        size[1], "x", size[2],
+        " may exceed what this pipeline supports on this device; the Impeller "
+        "validation log has the reason.");
+    return false;
+  }
+  return true;
+}
+
+const std::shared_ptr<SpiGpuBackendComputePipeline>&
+SpiGpuComputePipeline::GetPipeline() const {
+  return pipeline_;
+}
+
+SpiGpuShader* SpiGpuComputePipeline::GetShader() const {
+  return shader_;
+}
+
+FlutterSpiResult SpiGpuComputePipelineCreate(
+    FlutterSpiGpuContext* context,
+    FlutterSpiGpuShader* shader,
+    FlutterSpiGpuComputePipeline** out_pipeline,
+    char** out_error) {
+  if (out_error != nullptr) {
+    *out_error = nullptr;
+  }
+  if (out_pipeline == nullptr || context == nullptr || shader == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_pipeline = nullptr;
+  const std::shared_ptr<impeller::Context> context_value =
+      GetImpellerContext(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (context_value->GetBackendType() ==
+      impeller::Context::BackendType::kOpenGLES) {
+    SetError(out_error, "Compute is not supported on this backend.");
+    return kFlutterSpiUnsupported;
+  }
+  if (GetCoreShader(shader) == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  auto pipeline = std::make_shared<SpiGpuComputePipeline>(shader);
+  std::string error;
+  if (!pipeline->Build(*context_value, &error)) {
+    SetError(out_error, error);
+    return kFlutterSpiInvalidArgument;
+  }
+  const uintptr_t handle = ComputePipelines().Insert(std::move(pipeline));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_pipeline = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuComputePipelineRelease(
+    FlutterSpiGpuComputePipeline* pipeline) {
+  return ComputePipelines().Release(HandleValue(pipeline))
+             ? kFlutterSpiOk
+             : kFlutterSpiInvalidHandle;
+}
+
+std::shared_ptr<SpiGpuComputePipeline> GetSharedComputePipeline(
+    FlutterSpiGpuComputePipeline* pipeline) {
+  return FindPipeline(pipeline);
+}
+
+}  // namespace flutter
