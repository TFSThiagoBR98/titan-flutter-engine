+      const impeller::ShaderMetadata* metadata) const;
+  const SpiGpuBindingSet::TextureBinding* FindTextureInSets(
+      const impeller::ShaderMetadata* metadata) const;
+
+  std::shared_ptr<impeller::Context> context_;
+  std::shared_ptr<impeller::ComputePass> compute_pass_;
+  SpiGpuCommandBuffer* command_buffer_ = nullptr;
+  std::shared_ptr<SpiGpuComputePipeline> pipeline_;
+  std::array<FlutterSpiGpuBindingSet*, kMaxBindingSets> binding_sets_ = {};
