+  EXPECT_TRUE(limits.supports_compute);
+  EXPECT_EQ(limits.max_workgroup_invocations, 256u);
+  EXPECT_EQ(limits.max_workgroup_size[0], 256u);
+  EXPECT_EQ(limits.max_workgroup_size[1], 128u);
+  EXPECT_EQ(limits.max_workgroup_size[2], 64u);
+  EXPECT_EQ(limits.max_workgroup_count[0], 65535u);
+  EXPECT_EQ(limits.max_shared_memory_size, 32768u);
+
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
