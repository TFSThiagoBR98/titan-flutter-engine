+FlutterSpiResult SpiGpuContextGetComputeLimits(
+    FlutterSpiGpuContext* context,
+    FlutterSpiGpuComputeLimits* limits) {
+  SpiGpuContext* context_value = FindContext(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (limits == nullptr || limits->struct_size < sizeof(size_t)) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  const size_t size = limits->struct_size;
+  const auto set_field = [size](size_t offset, size_t field_size, auto* field,
+                                auto value) {
+    if (size >= offset + field_size) {
+      *field = value;
+    }
+  };
+  const impeller::Context& impeller_context = *context_value->context();
+  const bool supports_compute = impeller_context.GetBackendType() !=
+                                impeller::Context::BackendType::kOpenGLES;
+  const impeller::ComputeLimits compute_limits =
+      impeller_context.GetCapabilities()->GetComputeLimits();
+  set_field(offsetof(FlutterSpiGpuComputeLimits, supports_compute),
+            sizeof(limits->supports_compute), &limits->supports_compute,
+            supports_compute);
+
+  const uint32_t max_invocations =
+      supports_compute ? compute_limits.max_workgroup_invocations : 0u;
+  set_field(offsetof(FlutterSpiGpuComputeLimits, max_workgroup_invocations),
+            sizeof(limits->max_workgroup_invocations),
+            &limits->max_workgroup_invocations, max_invocations);
+  for (size_t index = 0; index < 3; ++index) {
+    const uint32_t max_size =
+        supports_compute ? compute_limits.max_workgroup_size[index] : 0u;
+    const uint32_t max_count =
+        supports_compute ? compute_limits.max_workgroup_count[index] : 0u;
+    set_field(offsetof(FlutterSpiGpuComputeLimits, max_workgroup_size) +
+                  index * sizeof(limits->max_workgroup_size[0]),
+              sizeof(limits->max_workgroup_size[0]),
+              &limits->max_workgroup_size[index], max_size);
+    set_field(offsetof(FlutterSpiGpuComputeLimits, max_workgroup_count) +
+                  index * sizeof(limits->max_workgroup_count[0]),
+              sizeof(limits->max_workgroup_count[0]),
+              &limits->max_workgroup_count[index], max_count);
+  }
+  const uint64_t shared_memory =
+      supports_compute ? compute_limits.max_shared_memory_size : 0u;
+  set_field(offsetof(FlutterSpiGpuComputeLimits, max_shared_memory_size),
+            sizeof(limits->max_shared_memory_size),
+            &limits->max_shared_memory_size, shared_memory);
+  return kFlutterSpiOk;
+}
