+uintptr_t HandleValue(FlutterSpiGpuComputePipeline* pipeline) {
+  return reinterpret_cast<uintptr_t>(pipeline);
+}
+
+FlutterSpiGpuComputePipeline* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuComputePipeline*>(value);
+}
+
+std::shared_ptr<SpiGpuComputePipeline> FindPipeline(
+    FlutterSpiGpuComputePipeline* pipeline) {
+  return ComputePipelines().Find(HandleValue(pipeline));
+}
+
+void SetError(char** out_error, const std::string& error) {
+  if (out_error == nullptr) {
+    return;
+  }
+  *out_error = static_cast<char*>(std::malloc(error.size() + 1));
+  if (*out_error != nullptr) {
+    std::memcpy(*out_error, error.c_str(), error.size() + 1);
+  }
+}
