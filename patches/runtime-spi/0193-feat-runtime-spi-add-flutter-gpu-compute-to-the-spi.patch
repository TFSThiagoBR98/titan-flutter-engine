+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuComputePassBindSet(nullptr, nullptr, 0),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuComputePassBindUniform(nullptr, nullptr, 0, nullptr, 0, 0),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(
+      SpiGpuComputePassBindStorageBuffer(nullptr, nullptr, 0, nullptr, 0, 0),
+      kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuComputePassBindTexture(nullptr, nullptr, nullptr, 0, nullptr,
+                                         nullptr),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuComputePassClearBindings(nullptr), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuComputePassDispatch(nullptr, 1, 1, 1),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuComputePassEnd(nullptr), kFlutterSpiInvalidHandle);
