+namespace flutter {
+namespace {
+
+SpiHandleTable<SpiGpuComputePass>& ComputePasses() {
+  return LeakedHandleTable<SpiGpuComputePass>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuComputePass* pass) {
+  return reinterpret_cast<uintptr_t>(pass);
+}
+
+FlutterSpiGpuComputePass* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuComputePass*>(value);
+}
+
+SpiGpuComputePass* FindPass(FlutterSpiGpuComputePass* pass) {
+  return ComputePasses().FindRaw(HandleValue(pass));
+}
+
+bool IsOptimizedOut(size_t backend_index) {
+  return backend_index == impeller::kOptimizedOutBinding;
+}
+
+}  // namespace
+
+SpiGpuComputePass::SpiGpuComputePass() = default;
+
+SpiGpuComputePass::~SpiGpuComputePass() {
+  ReleaseBindingSets();
+  ReleaseBindingShaders();
+}
+
+void SpiGpuComputePass::ReleaseBindingSets() {
+  for (auto& set : binding_sets_) {
+    if (set != nullptr) {
+      SpiGpuBindingSetRelease(set);
+      set = nullptr;
+    }
+  }
+}
+
+void SpiGpuComputePass::ReleaseBindingShaders() {
+  for (FlutterSpiGpuShader* shader : shader_handles_) {
+    SpiGpuShaderRelease(shader);
+  }
+  shader_handles_.clear();
+}
+
+bool SpiGpuComputePass::RetainBindingShader(FlutterSpiGpuShader* shader) {
+  if (std::find(shader_handles_.begin(), shader_handles_.end(), shader) !=
+      shader_handles_.end()) {
+    return true;
+  }
+  if (SpiGpuShaderRetain(shader) != kFlutterSpiOk) {
+    return false;
+  }
+  shader_handles_.push_back(shader);
+  return true;
+}
+
+FlutterSpiResult SpiGpuComputePass::Begin(
+    FlutterSpiGpuCommandBuffer* command_buffer) {
+  if (command_buffer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (command_buffer_ != nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  SpiGpuCommandBuffer* command_buffer_value =
+      SpiGpuCommandBufferGetCore(command_buffer);
+  if (command_buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  compute_pass_ = command_buffer_value->CreateComputePass();
+  if (compute_pass_ == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  context_ = command_buffer_value->GetContext();
+  command_buffer_ = command_buffer_value;
+  bindings_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuComputePass::End() {
+  if (command_buffer_ == nullptr) {
+    return kFlutterSpiOk;
+  }
+  if (compute_pass_ == nullptr ||
+      !command_buffer_->EndComputePass(compute_pass_)) {
+    return kFlutterSpiInternalError;
+  }
+  command_buffer_ = nullptr;
+  compute_pass_.reset();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuComputePass::BindPipeline(
+    FlutterSpiGpuComputePipeline* pipeline) {
+  if (pipeline == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  std::shared_ptr<SpiGpuComputePipeline> pipeline_value =
+      GetSharedComputePipeline(pipeline);
+  if (pipeline_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (pipeline_ != pipeline_value) {
+    pipeline_ = std::move(pipeline_value);
+    bindings_dirty_ = true;
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuComputePass::BindSet(FlutterSpiGpuBindingSet* set,
+                                            int32_t slot) {
+  if (slot < 0 || static_cast<size_t>(slot) >= kMaxBindingSets) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (set == nullptr || GetCoreBindingSet(set) == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (binding_sets_[slot] == set) {
+    return kFlutterSpiOk;
+  }
+  if (SpiGpuBindingSetRetain(set) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (binding_sets_[slot] != nullptr) {
+    SpiGpuBindingSetRelease(binding_sets_[slot]);
+  }
+  binding_sets_[slot] = set;
+  bindings_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuComputePass::BindUniform(FlutterSpiGpuShader* shader,
+                                                int32_t uniform_struct_index,
+                                                FlutterSpiGpuBuffer* buffer,
+                                                size_t offset,
+                                                size_t length) {
+  SpiGpuShader* shader_value = GetCoreShader(shader);
+  const std::shared_ptr<impeller::DeviceBuffer> buffer_value =
+      GetImpellerBuffer(buffer);
+  if (shader_value == nullptr || buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (shader_value->GetShaderStage() != impeller::ShaderStage::kCompute) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const SpiGpuShader::UniformBinding* binding =
+      shader_value->GetUniformStructAt(uniform_struct_index);
+  if (binding == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t buffer_size = buffer_value->GetDeviceBufferDescriptor().size;
+  if (offset > buffer_size || length > buffer_size - offset ||
+      !RetainBindingShader(shader)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  uniform_bindings_.insert_or_assign(
+      &binding->metadata,
+      BufferBinding{.slot = binding->slot,
+                    .view = impeller::BufferView(
+                        buffer_value, impeller::Range(offset, length))});
+  bindings_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuComputePass::BindStorageBuffer(
+    FlutterSpiGpuShader* shader,
+    int32_t storage_buffer_index,
+    FlutterSpiGpuBuffer* buffer,
+    size_t offset,
+    size_t length) {
+  SpiGpuShader* shader_value = GetCoreShader(shader);
+  const std::shared_ptr<impeller::DeviceBuffer> buffer_value =
+      GetImpellerBuffer(buffer);
+  if (shader_value == nullptr || buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (shader_value->GetShaderStage() != impeller::ShaderStage::kCompute) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const SpiGpuShader::StorageBufferBinding* binding =
+      shader_value->GetStorageBufferAt(storage_buffer_index);
+  if (binding == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t buffer_size = buffer_value->GetDeviceBufferDescriptor().size;
+  if (offset > buffer_size || length > buffer_size - offset ||
+      !RetainBindingShader(shader)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  storage_buffer_bindings_.insert_or_assign(
+      &binding->metadata,
+      BufferBinding{.slot = binding->slot,
+                    .view = impeller::BufferView(
+                        buffer_value, impeller::Range(offset, length))});
+  bindings_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuComputePass::BindTexture(
+    FlutterSpiGpuContext* context,
+    FlutterSpiGpuShader* shader,
+    int32_t uniform_texture_index,
+    FlutterSpiGpuTexture* texture,
+    const FlutterSpiGpuSamplerDescriptor* sampler) {
+  SpiGpuShader* shader_value = GetCoreShader(shader);
+  const std::shared_ptr<impeller::Texture> texture_value =
+      SpiGpuTextureGetImpeller(texture);
+  const std::shared_ptr<impeller::Context> context_value =
+      GetImpellerContext(context);
+  if (shader_value == nullptr || texture_value == nullptr ||
+      context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (sampler == nullptr || sampler->struct_size < sizeof(*sampler) ||
+      shader_value->GetShaderStage() != impeller::ShaderStage::kCompute) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const SpiGpuShader::TextureBinding* binding =
+      shader_value->GetUniformTextureAt(uniform_texture_index);
+  if (binding == nullptr || !RetainBindingShader(shader)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto sampler_value = context_value->GetSamplerLibrary()->GetSampler(
+      SpiGpuToImpellerSamplerDescriptor(*sampler));
+  if (!sampler_value) {
+    return kFlutterSpiInternalError;
+  }
+  texture_bindings_.insert_or_assign(&binding->metadata,
+                                     TextureBinding{.slot = binding->slot,
+                                                    .texture = texture_value,
+                                                    .sampler = sampler_value});
+  bindings_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuComputePass::ClearBindings() {
+  uniform_bindings_.clear();
+  storage_buffer_bindings_.clear();
+  texture_bindings_.clear();
+  ReleaseBindingSets();
+  ReleaseBindingShaders();
+  bindings_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+const SpiGpuBindingSet::BufferBinding* SpiGpuComputePass::FindBufferInSets(
+    const impeller::ShaderMetadata* metadata) const {
+  for (size_t index = binding_sets_.size(); index > 0; --index) {
+    const auto* set = GetCoreBindingSet(binding_sets_[index - 1]);
+    if (set == nullptr) {
+      continue;
+    }
+    for (const auto& binding : set->GetBufferBindings()) {
+      if (binding.metadata == metadata) {
+        return &binding;
+      }
+    }
+    for (const auto& binding : set->GetStorageBufferBindings()) {
+      if (binding.metadata == metadata) {
+        return &binding;
+      }
+    }
+  }
+  return nullptr;
+}
+
+const SpiGpuBindingSet::TextureBinding* SpiGpuComputePass::FindTextureInSets(
+    const impeller::ShaderMetadata* metadata) const {
+  for (size_t index = binding_sets_.size(); index > 0; --index) {
+    const auto* set = GetCoreBindingSet(binding_sets_[index - 1]);
+    if (set == nullptr) {
+      continue;
+    }
+    for (const auto& binding : set->GetTextureBindings()) {
+      if (binding.metadata == metadata) {
+        return &binding;
+      }
+    }
+  }
+  return nullptr;
+}
+
+bool SpiGpuComputePass::ApplyBindings() {
+  if (pipeline_ == nullptr || pipeline_->GetShader() == nullptr ||
+      compute_pass_ == nullptr) {
+    return false;
+  }
+  SpiGpuShader* shader = pipeline_->GetShader();
+  for (int index = 0; const auto* binding = shader->GetUniformStructAt(index);
+       ++index) {
+    const BufferBinding* dynamic_binding = nullptr;
+    if (const auto iterator = uniform_bindings_.find(&binding->metadata);
+        iterator != uniform_bindings_.end()) {
+      dynamic_binding = &iterator->second;
+    }
+    const auto* set_binding = dynamic_binding == nullptr
+                                  ? FindBufferInSets(&binding->metadata)
+                                  : nullptr;
+    if (dynamic_binding == nullptr && set_binding == nullptr) {
+      return false;
+    }
+    const auto& slot =
+        dynamic_binding == nullptr ? set_binding->slot : dynamic_binding->slot;
+    const auto& view =
+        dynamic_binding == nullptr ? set_binding->view : dynamic_binding->view;
+    if (!IsOptimizedOut(slot.ext_res_0) &&
+        !compute_pass_->BindResource(impeller::ShaderStage::kCompute,
+                                     impeller::DescriptorType::kUniformBuffer,
+                                     slot, &binding->metadata, view)) {
+      return false;
+    }
+  }
+  for (int index = 0; const auto* binding = shader->GetStorageBufferAt(index);
+       ++index) {
+    const BufferBinding* dynamic_binding = nullptr;
+    if (const auto iterator = storage_buffer_bindings_.find(&binding->metadata);
+        iterator != storage_buffer_bindings_.end()) {
+      dynamic_binding = &iterator->second;
+    }
+    const auto* set_binding = dynamic_binding == nullptr
+                                  ? FindBufferInSets(&binding->metadata)
+                                  : nullptr;
+    if (dynamic_binding == nullptr && set_binding == nullptr) {
+      return false;
+    }
+    const auto& slot =
+        dynamic_binding == nullptr ? set_binding->slot : dynamic_binding->slot;
+    const auto& view =
+        dynamic_binding == nullptr ? set_binding->view : dynamic_binding->view;
+    if (!IsOptimizedOut(slot.ext_res_0) &&
+        !compute_pass_->BindResource(impeller::ShaderStage::kCompute,
+                                     impeller::DescriptorType::kStorageBuffer,
+                                     slot, &binding->metadata, view)) {
+      return false;
+    }
+  }
+  for (int index = 0; const auto* binding = shader->GetUniformTextureAt(index);
+       ++index) {
+    const TextureBinding* dynamic_binding = nullptr;
+    if (const auto iterator = texture_bindings_.find(&binding->metadata);
+        iterator != texture_bindings_.end()) {
+      dynamic_binding = &iterator->second;
+    }
+    const auto* set_binding = dynamic_binding == nullptr
+                                  ? FindTextureInSets(&binding->metadata)
+                                  : nullptr;
+    if (dynamic_binding == nullptr && set_binding == nullptr) {
+      return false;
+    }
+    const auto& slot =
+        dynamic_binding == nullptr ? set_binding->slot : dynamic_binding->slot;
+    const auto& texture = dynamic_binding == nullptr ? set_binding->texture
+                                                     : dynamic_binding->texture;
+    const auto& sampler = dynamic_binding == nullptr ? set_binding->sampler
+                                                     : dynamic_binding->sampler;
+    if (!IsOptimizedOut(slot.texture_index) &&
+        !compute_pass_->BindResource(impeller::ShaderStage::kCompute,
+                                     impeller::DescriptorType::kSampledImage,
+                                     slot, &binding->metadata, texture,
+                                     sampler)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+FlutterSpiResult SpiGpuComputePass::Dispatch(uint32_t workgroup_count_x,
+                                             uint32_t workgroup_count_y,
+                                             uint32_t workgroup_count_z) {
+  if (compute_pass_ == nullptr || command_buffer_ == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (workgroup_count_x == 0u || workgroup_count_y == 0u ||
+      workgroup_count_z == 0u) {
+    return kFlutterSpiOk;
+  }
+  if (pipeline_ == nullptr || pipeline_->GetPipeline() == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto limits = context_->GetCapabilities()->GetComputeLimits();
+  if (workgroup_count_x > limits.max_workgroup_count[0] ||
+      workgroup_count_y > limits.max_workgroup_count[1] ||
+      workgroup_count_z > limits.max_workgroup_count[2]) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (pipeline_ != last_pipeline_) {
+    compute_pass_->SetPipeline(pipeline_->GetPipeline());
+    last_pipeline_ = pipeline_;
+    bindings_dirty_ = true;
+  }
+  if (bindings_dirty_ && !ApplyBindings()) {
+    return kFlutterSpiInvalidArgument;
+  }
+  bindings_dirty_ = false;
+  return compute_pass_
+                 ->Compute(
+                     {workgroup_count_x, workgroup_count_y, workgroup_count_z})
+                 .ok()
+             ? kFlutterSpiOk
+             : kFlutterSpiInternalError;
+}
+
+FlutterSpiResult SpiGpuComputePassCreate(FlutterSpiGpuComputePass** out_pass) {
+  if (out_pass == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_pass = nullptr;
+  const uintptr_t handle =
+      ComputePasses().Insert(std::make_shared<SpiGpuComputePass>());
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_pass = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuCommandBufferCreateComputePass(
+    FlutterSpiGpuCommandBuffer*,
+    FlutterSpiGpuComputePass** out_pass) {
+  return SpiGpuComputePassCreate(out_pass);
+}
+
+#define SPI_COMPUTE_PASS_CALL(name, ...)                \
+  do {                                                  \
+    SpiGpuComputePass* value = FindPass(pass);          \
+    return value == nullptr ? kFlutterSpiInvalidHandle  \
+                            : value->name(__VA_ARGS__); \
+  } while (false)
+
+FlutterSpiResult SpiGpuComputePassBegin(FlutterSpiGpuComputePass* pass,
+                                        FlutterSpiGpuCommandBuffer* buffer) {
+  SPI_COMPUTE_PASS_CALL(Begin, buffer);
+}
+
+FlutterSpiResult SpiGpuComputePassBindPipeline(
+    FlutterSpiGpuComputePass* pass,
+    FlutterSpiGpuComputePipeline* pipeline) {
+  SPI_COMPUTE_PASS_CALL(BindPipeline, pipeline);
+}
+
+FlutterSpiResult SpiGpuComputePassBindSet(FlutterSpiGpuComputePass* pass,
+                                          FlutterSpiGpuBindingSet* set,
+                                          int32_t slot) {
+  SPI_COMPUTE_PASS_CALL(BindSet, set, slot);
+}
+
+FlutterSpiResult SpiGpuComputePassBindUniform(FlutterSpiGpuComputePass* pass,
+                                              FlutterSpiGpuShader* shader,
+                                              int32_t index,
+                                              FlutterSpiGpuBuffer* buffer,
+                                              size_t offset,
+                                              size_t length) {
+  SPI_COMPUTE_PASS_CALL(BindUniform, shader, index, buffer, offset, length);
+}
+
+FlutterSpiResult SpiGpuComputePassBindStorageBuffer(
+    FlutterSpiGpuComputePass* pass,
+    FlutterSpiGpuShader* shader,
+    int32_t index,
+    FlutterSpiGpuBuffer* buffer,
+    size_t offset,
+    size_t length) {
+  SPI_COMPUTE_PASS_CALL(BindStorageBuffer, shader, index, buffer, offset,
+                        length);
+}
+
+FlutterSpiResult SpiGpuComputePassBindTexture(
+    FlutterSpiGpuComputePass* pass,
+    FlutterSpiGpuContext* context,
+    FlutterSpiGpuShader* shader,
+    int32_t index,
+    FlutterSpiGpuTexture* texture,
+    const FlutterSpiGpuSamplerDescriptor* sampler) {
+  SPI_COMPUTE_PASS_CALL(BindTexture, context, shader, index, texture, sampler);
+}
+
+FlutterSpiResult SpiGpuComputePassClearBindings(
+    FlutterSpiGpuComputePass* pass) {
+  SPI_COMPUTE_PASS_CALL(ClearBindings);
+}
+
+FlutterSpiResult SpiGpuComputePassDispatch(FlutterSpiGpuComputePass* pass,
+                                           uint32_t x,
+                                           uint32_t y,
+                                           uint32_t z) {
+  SPI_COMPUTE_PASS_CALL(Dispatch, x, y, z);
+}
+
+FlutterSpiResult SpiGpuComputePassEnd(FlutterSpiGpuComputePass* pass) {
+  SPI_COMPUTE_PASS_CALL(End);
+}
+
+#undef SPI_COMPUTE_PASS_CALL
+
+FlutterSpiResult SpiGpuComputePassRelease(FlutterSpiGpuComputePass* pass) {
+  return ComputePasses().Release(HandleValue(pass)) ? kFlutterSpiOk
+                                                    : kFlutterSpiInvalidHandle;
+}
+
+}  // namespace flutter
