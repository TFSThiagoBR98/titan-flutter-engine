+TEST_F(SpiGpuComputeTest, ContextComputeLimitsHonorsVersionedStructSize) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto* mock_capabilities = const_cast<impeller::testing::MockCapabilities*>(
+      static_cast<const impeller::testing::MockCapabilities*>(
+          capabilities.get()));
+  ON_CALL(*mock_capabilities, GetComputeLimits())
+      .WillByDefault(Return(impeller::ComputeLimits{
+          .max_workgroup_invocations = 256,
+          .max_workgroup_size = {256, 128, 64},
+          .max_workgroup_count = {65535, 65535, 65535},
+          .max_shared_memory_size = 32768,
+      }));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend();
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+
+  FlutterSpiGpuComputeLimits limits = {
+      .struct_size = sizeof(FlutterSpiGpuComputeLimits),
