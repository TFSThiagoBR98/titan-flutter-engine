index 00000000000..b52cbd75fff
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/gpu/spi_gpu_buffer.cc
@@ -0,0 +1,182 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/gpu/spi_gpu_buffer.h"
+
+#include <limits>
+
+#include "flutter/runtime_spi/gpu/spi_gpu_context.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_formats.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "impeller/core/allocator.h"
+#include "impeller/core/device_buffer.h"
+#include "impeller/core/device_buffer_descriptor.h"
+#include "impeller/core/range.h"
+#include "impeller/renderer/context.h"
+
+namespace flutter {
+namespace {
+
+class SpiGpuBuffer final {
+ public:
+  SpiGpuBuffer(std::shared_ptr<impeller::Context> context,
+               std::shared_ptr<impeller::DeviceBuffer> buffer)
+      : context_(std::move(context)), buffer_(std::move(buffer)) {}
+
+  const std::shared_ptr<impeller::Context>& context() const { return context_; }
+
+  const std::shared_ptr<impeller::DeviceBuffer>& buffer() const {
+    return buffer_;
+  }
+
+ private:
+  std::shared_ptr<impeller::Context> context_;
+  std::shared_ptr<impeller::DeviceBuffer> buffer_;
+};
+
+SpiHandleTable<SpiGpuBuffer>& Buffers() {
+  return LeakedHandleTable<SpiGpuBuffer>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuBuffer* buffer) {
+  return reinterpret_cast<uintptr_t>(buffer);
+}
+
+FlutterSpiGpuBuffer* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuBuffer*>(value);
+}
+
+SpiGpuBuffer* FindBuffer(FlutterSpiGpuBuffer* buffer) {
+  return Buffers().FindRaw(HandleValue(buffer));
+}
+
+FlutterSpiResult InsertBuffer(std::shared_ptr<impeller::Context> context,
+                              std::shared_ptr<impeller::DeviceBuffer> buffer,
+                              FlutterSpiGpuBuffer** out_buffer) {
+  if (buffer == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  const uintptr_t handle = Buffers().Insert(
+      std::make_shared<SpiGpuBuffer>(std::move(context), std::move(buffer)));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_buffer = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+bool IsValidStorageMode(int32_t storage_mode) {
+  return storage_mode >= kFlutterSpiGpuStorageModeHostVisible &&
+         storage_mode <= kFlutterSpiGpuStorageModeDeviceTransient;
+}
+
+}  // namespace
+
+FlutterSpiResult SpiGpuBufferCreate(
+    FlutterSpiGpuContext* context,
+    const FlutterSpiGpuBufferDescriptor* descriptor,
+    FlutterSpiGpuBuffer** out_buffer) {
+  if (out_buffer == nullptr || descriptor == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (descriptor->struct_size < offsetof(FlutterSpiGpuBufferDescriptor, size) +
+                                    sizeof(descriptor->size)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!IsValidStorageMode(descriptor->storage_mode)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::shared_ptr<impeller::Context> context_value =
+      SpiGpuContextGetImpeller(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  impeller::DeviceBufferDescriptor impeller_descriptor;
+  impeller_descriptor.storage_mode =
+      SpiGpuToImpellerStorageMode(descriptor->storage_mode);
+  impeller_descriptor.size = descriptor->size;
+  auto buffer =
+      context_value->GetResourceAllocator()->CreateBuffer(impeller_descriptor);
+  return InsertBuffer(std::move(context_value), std::move(buffer), out_buffer);
+}
+
+FlutterSpiResult SpiGpuBufferCreateWithData(FlutterSpiGpuContext* context,
+                                            const uint8_t* data,
+                                            size_t size,
+                                            FlutterSpiGpuBuffer** out_buffer) {
+  if (out_buffer == nullptr || (data == nullptr && size != 0)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::shared_ptr<impeller::Context> context_value =
+      SpiGpuContextGetImpeller(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  auto buffer =
+      context_value->GetResourceAllocator()->CreateBufferWithCopy(data, size);
+  return InsertBuffer(std::move(context_value), std::move(buffer), out_buffer);
+}
+
+FlutterSpiResult SpiGpuBufferOverwrite(FlutterSpiGpuBuffer* buffer,
+                                       const uint8_t* data,
+                                       size_t size,
+                                       size_t destination_offset) {
+  SpiGpuBuffer* buffer_value = FindBuffer(buffer);
+  if (buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (data == nullptr && size != 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t buffer_size =
+      buffer_value->buffer()->GetDeviceBufferDescriptor().size;
+  if (destination_offset > buffer_size ||
+      size > buffer_size - destination_offset) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!buffer_value->buffer()->CopyHostBuffer(data, impeller::Range(0, size),
+                                              destination_offset)) {
+    return kFlutterSpiInternalError;
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuBufferFlush(FlutterSpiGpuBuffer* buffer,
+                                   size_t offset,
+                                   size_t size) {
+  SpiGpuBuffer* buffer_value = FindBuffer(buffer);
+  if (buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const size_t buffer_size =
+      buffer_value->buffer()->GetDeviceBufferDescriptor().size;
+  if (offset > buffer_size) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t remaining = buffer_size - offset;
+  if (size != SIZE_MAX && size > remaining) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t flush_size = size == SIZE_MAX ? remaining : size;
+  buffer_value->buffer()->Flush(impeller::Range(offset, flush_size));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuBufferRetain(FlutterSpiGpuBuffer* buffer) {
+  return Buffers().Retain(HandleValue(buffer)) ? kFlutterSpiOk
+                                               : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuBufferRelease(FlutterSpiGpuBuffer* buffer) {
+  return Buffers().Release(HandleValue(buffer)) ? kFlutterSpiOk
+                                                : kFlutterSpiInvalidHandle;
+}
+
+std::shared_ptr<impeller::DeviceBuffer> SpiGpuBufferGetImpeller(
+    FlutterSpiGpuBuffer* buffer) {
+  SpiGpuBuffer* buffer_value = FindBuffer(buffer);
+  return buffer_value == nullptr ? nullptr : buffer_value->buffer();
+}
+
+}  // namespace flutter
