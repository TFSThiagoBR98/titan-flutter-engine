+TEST_F(SpiGpuContextTest, BufferCreateUsesDescriptor) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto allocator =
+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  auto device_buffer = std::make_shared<NiceMock<impeller::testing::MockDeviceBuffer>>(
+      impeller::DeviceBufferDescriptor{});
+  impeller::DeviceBufferDescriptor received_descriptor;
+  EXPECT_CALL(*allocator, OnCreateBuffer(::testing::_))
+      .WillOnce(::testing::DoAll(::testing::SaveArg<0>(&received_descriptor),
+                                 Return(device_buffer)));
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuBufferDescriptor descriptor = {
+      .struct_size = sizeof(descriptor),
+      .storage_mode = kFlutterSpiGpuStorageModeHostVisible,
+      .size = 64,
+  };
+  FlutterSpiGpuBuffer* buffer = nullptr;
+
+  EXPECT_EQ(SpiGpuBufferCreate(gpu_context, &descriptor, &buffer),
+            kFlutterSpiOk);
+  EXPECT_EQ(received_descriptor.storage_mode,
+            impeller::StorageMode::kHostVisible);
+  EXPECT_EQ(received_descriptor.size, 64u);
+  EXPECT_EQ(SpiGpuBufferRelease(buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
+TEST_F(SpiGpuContextTest, BufferCreateRejectsSmallStruct) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuBufferDescriptor descriptor = {
+      .struct_size = offsetof(FlutterSpiGpuBufferDescriptor, size),
+      .storage_mode = kFlutterSpiGpuStorageModeHostVisible,
+      .size = 64,
+  };
+  FlutterSpiGpuBuffer* buffer = nullptr;
+
+  EXPECT_EQ(SpiGpuBufferCreate(gpu_context, &descriptor, &buffer),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(buffer, nullptr);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
+TEST_F(SpiGpuContextTest, BufferOverwriteRejectsOutOfRange) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto allocator =
+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  auto device_buffer = std::make_shared<NiceMock<impeller::testing::MockDeviceBuffer>>(
+      impeller::DeviceBufferDescriptor{
+          .storage_mode = impeller::StorageMode::kHostVisible,
+          .size = 8,
+      });
+  EXPECT_CALL(*allocator, OnCreateBuffer(::testing::_))
+      .WillOnce(Return(device_buffer));
+  EXPECT_CALL(*device_buffer, OnCopyHostBuffer(::testing::_, ::testing::_,
+                                               ::testing::_))
+      .Times(0);
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuBufferDescriptor descriptor = {
+      .struct_size = sizeof(descriptor),
+      .storage_mode = kFlutterSpiGpuStorageModeHostVisible,
+      .size = 8,
+  };
+  FlutterSpiGpuBuffer* buffer = nullptr;
+  ASSERT_EQ(SpiGpuBufferCreate(gpu_context, &descriptor, &buffer),
+            kFlutterSpiOk);
+  const uint8_t data[4] = {1, 2, 3, 4};
+
+  EXPECT_EQ(SpiGpuBufferOverwrite(buffer, data, sizeof(data), 6),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuBufferRelease(buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
+TEST_F(SpiGpuContextTest, BufferCreateWithDataCopiesBytes) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto allocator =
+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  auto device_buffer = std::make_shared<NiceMock<impeller::testing::MockDeviceBuffer>>(
+      impeller::DeviceBufferDescriptor{
+          .storage_mode = impeller::StorageMode::kHostVisible,
+          .size = 3,
+      });
+  EXPECT_CALL(*allocator, OnCreateBuffer(::testing::_))
+      .WillOnce(Return(device_buffer));
+  const uint8_t data[3] = {7, 8, 9};
+  const uint8_t* copied_data = nullptr;
+  impeller::Range copied_range;
+  EXPECT_CALL(*device_buffer, OnCopyHostBuffer(::testing::_, ::testing::_ , 0))
+      .WillOnce(::testing::DoAll(::testing::SaveArg<0>(&copied_data),
+                                 ::testing::SaveArg<1>(&copied_range),
+                                 Return(true)));
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuBuffer* buffer = nullptr;
+
+  EXPECT_EQ(SpiGpuBufferCreateWithData(gpu_context, data, sizeof(data),
+                                       &buffer),
+            kFlutterSpiOk);
+  EXPECT_EQ(copied_data, data);
+  EXPECT_EQ(copied_range, impeller::Range(0, sizeof(data)));
+  EXPECT_EQ(SpiGpuBufferRelease(buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
+TEST_F(SpiGpuContextTest, BufferCallsRejectNullAndReleasedHandles) {
+  FlutterSpiGpuBufferDescriptor descriptor = {
+      .struct_size = sizeof(descriptor),
+      .storage_mode = kFlutterSpiGpuStorageModeHostVisible,
+      .size = 8,
+  };
+  const uint8_t data[1] = {1};
+  EXPECT_EQ(SpiGpuBufferCreate(nullptr, &descriptor, nullptr),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuBufferCreateWithData(nullptr, data, sizeof(data), nullptr),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuBufferOverwrite(nullptr, data, sizeof(data), 0),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuBufferFlush(nullptr, 0, SIZE_MAX), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuBufferRetain(nullptr), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuBufferRelease(nullptr), kFlutterSpiInvalidHandle);
+
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto allocator =
+      std::make_shared<NiceMock<impeller::testing::MockAllocator>>();
+  auto device_buffer = std::make_shared<NiceMock<impeller::testing::MockDeviceBuffer>>(
+      impeller::DeviceBufferDescriptor{
+          .storage_mode = impeller::StorageMode::kHostVisible,
+          .size = 8,
+      });
+  ON_CALL(*allocator, OnCreateBuffer(::testing::_))
+      .WillByDefault(Return(device_buffer));
+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuBuffer* buffer = nullptr;
+  ASSERT_EQ(SpiGpuBufferCreate(gpu_context, &descriptor, &buffer),
+            kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuBufferRelease(buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuBufferRetain(buffer), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuBufferOverwrite(buffer, data, sizeof(data), 0),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuBufferFlush(buffer, 0, SIZE_MAX), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuBufferGetImpeller(buffer), nullptr);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
 }  // namespace
 }  // namespace flutter::testing
