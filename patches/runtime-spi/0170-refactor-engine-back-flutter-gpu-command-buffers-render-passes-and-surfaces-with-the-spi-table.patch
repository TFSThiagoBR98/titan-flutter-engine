+struct CompletionState {
+  std::unique_ptr<tonic::DartPersistentValue> callback;
+  fml::RefPtr<fml::TaskRunner> ui_task_runner;
+};
+
+void DispatchCompletion(void* user_data, FlutterSpiResult result) {
+  auto* state = static_cast<CompletionState*>(user_data);
+  auto callback = std::move(state->callback);
+  const bool success = result == kFlutterSpiOk;
+  state->ui_task_runner->PostTask(
+      fml::MakeCopyable([callback = std::move(callback), success]() mutable {
+        auto dart_state = callback->dart_state().lock();
+        if (!dart_state) {
+          return;
+        }
+        tonic::DartState::Scope scope(dart_state);
+        tonic::DartInvoke(callback->Get(), {tonic::ToDart(success)});
+        callback.reset();
+      }));
+  delete state;
+}
 
