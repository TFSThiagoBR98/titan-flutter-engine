index 00000000000..70ec78aea6d
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/include/flutter_fragment.h
@@ -0,0 +1,73 @@
+#ifndef FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_FRAGMENT_H_
+#define FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_FRAGMENT_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "flutter_image.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct FlutterSpiFragmentProgram FlutterSpiFragmentProgram;
+typedef struct FlutterSpiFragmentShader FlutterSpiFragmentShader;
+
+typedef enum {
+  kFlutterSpiUniformTypeFloat = 0,
+  kFlutterSpiUniformTypeSampledImage = 1,
+  kFlutterSpiUniformTypeStruct = 2,
+} FlutterSpiUniformType;
+
+typedef struct {
+  size_t struct_size;
+  const char* name;
+  int32_t type;
+  size_t size_bytes;
+} FlutterSpiUniformInfo;
+
+typedef struct FlutterSpiFragmentApi {
+  size_t struct_size;
+  FlutterSpiResult (*program_from_asset)(
+      FlutterSpiEngine* engine,
+      const char* asset_name,
+      FlutterSpiFragmentProgram** out_program,
+      char** out_error);
+  FlutterSpiResult (*program_from_bytes)(
+      FlutterSpiEngine* engine,
+      const uint8_t* data,
+      size_t size,
+      const char* library_id,
+      FlutterSpiFragmentProgram** out_program,
+      char** out_error);
+  FlutterSpiResult (*program_get_counts)(FlutterSpiFragmentProgram* program,
+                                         size_t* out_uniform_count,
+                                         size_t* out_float_count,
+                                         size_t* out_sampler_count);
+  FlutterSpiResult (*program_get_uniform)(FlutterSpiFragmentProgram* program,
+                                          size_t index,
+                                          FlutterSpiUniformInfo* out_info);
+  FlutterSpiResult (*program_release)(FlutterSpiFragmentProgram* program);
+  FlutterSpiResult (*shader_create)(FlutterSpiFragmentProgram* program,
+                                    FlutterSpiFragmentShader** out_shader);
+  FlutterSpiResult (*shader_set_float)(FlutterSpiFragmentShader* shader,
+                                       size_t index,
+                                       float value);
+  FlutterSpiResult (*shader_set_image_sampler)(FlutterSpiFragmentShader* shader,
+                                               size_t index,
+                                               FlutterSpiImage* image,
+                                               int32_t filter_quality);
+  FlutterSpiResult (*shader_to_shader)(FlutterSpiFragmentShader* shader,
+                                       int32_t filter_quality,
+                                       FlutterSpiShader** out_shader);
+  FlutterSpiResult (*shader_to_image_filter)(FlutterSpiFragmentShader* shader,
+                                             int32_t filter_quality,
+                                             FlutterSpiImageFilter** out_filter);
+  FlutterSpiResult (*shader_release)(FlutterSpiFragmentShader* shader);
+} FlutterSpiFragmentApi;
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // FLUTTER_RUNTIME_SPI_INCLUDE_FLUTTER_FRAGMENT_H_
