+@Native<Void Function(Int, Int)>(symbol: 'NotifyRawPixels')
+external void notifyRawPixels(int rgba, int bgra);
+
+Future<Image> _decodeRawImage(Uint8List pixels, PixelFormat format) {
+  final Completer<Image> completer = Completer<Image>();
+  decodeImageFromPixels(pixels, 1, 1, format, completer.complete);
+  return completer.future;
+}
+
+@pragma('vm:entry-point')
+Future<void> rawImagePixelFormatsKeepChannels() async {
+  final Image rgbaImage = await _decodeRawImage(
+    Uint8List.fromList(<int>[255, 0, 0, 255]),
+    PixelFormat.rgba8888,
+  );
+  final Image bgraImage = await _decodeRawImage(
+    Uint8List.fromList(<int>[0, 0, 255, 255]),
+    PixelFormat.bgra8888,
+  );
+  final ByteData rgbaData = (await rgbaImage.toByteData(format: ImageByteFormat.rawRgba))!;
+  final ByteData bgraData = (await bgraImage.toByteData(format: ImageByteFormat.rawRgba))!;
+
+  notifyRawPixels(rgbaData.getUint32(0), bgraData.getUint32(0));
+  rgbaImage.dispose();
+  bgraImage.dispose();
+}
