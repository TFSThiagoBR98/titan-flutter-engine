+TEST_F(ShellTest, RawImagePixelFormatsKeepChannels) {
+  Settings settings = CreateSettingsForFixture();
+  auto task_runner = CreateNewThread();
+  TaskRunners task_runners("test", task_runner, task_runner, task_runner,
+                           task_runner);
+  std::unique_ptr<Shell> shell = CreateShell(settings, task_runners);
+
+  auto configuration = RunConfiguration::InferFromSettings(settings);
+  configuration.SetEntrypoint("rawImagePixelFormatsKeepChannels");
+
+  int rgba_pixel = 0;
+  int bgra_pixel = 0;
+  fml::AutoResetWaitableEvent latch;
+  AddFfiNativeCallback(
+      "NotifyRawPixels",
+      CREATE_FFI_LAMBDA([&](int rgba, int bgra) {
+        rgba_pixel = rgba;
+        bgra_pixel = bgra;
+        latch.Signal();
+      }));
+
+  RunEngine(shell.get(), std::move(configuration));
+
+  const bool timed_out =
+      latch.WaitWithTimeout(fml::TimeDelta::FromSeconds(10));
+  ASSERT_FALSE(timed_out);
+  EXPECT_EQ(rgba_pixel, 0xFF0000FF);
+  EXPECT_EQ(bgra_pixel, 0xFF0000FF);
+  DestroyShell(std::move(shell), task_runners);
+}
