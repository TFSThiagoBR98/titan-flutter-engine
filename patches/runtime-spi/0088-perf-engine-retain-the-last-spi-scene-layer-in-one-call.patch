+TEST_F(SpiRetainedLayersTest, RetainLastLayerMatchesTakeAndAssign) {
+  ASSERT_NE(api()->scene_retain_last_layer, nullptr);
+  FlutterSpiSceneBuilder* old_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(old_builder, 128, 3.0f, 4.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* old_handle = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(old_builder, &old_handle),
+            kFlutterSpiOk);
+  FlutterSpiScene* old_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(old_builder, 100, 80, &old_scene),
+            kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* take_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(take_builder, 64, 5.0f, 6.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* taken_layer = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(take_builder, &taken_layer),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_assign_old_layer(take_builder, old_handle),
+            kFlutterSpiOk);
+  FlutterSpiScene* take_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(take_builder, 100, 80, &take_scene),
+            kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* retain_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(retain_builder, 64, 5.0f, 6.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* retained_layer = nullptr;
+  ASSERT_EQ(api()->scene_retain_last_layer(retain_builder, old_handle,
+                                           &retained_layer),
+            kFlutterSpiOk);
+  FlutterSpiScene* retain_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(retain_builder, 100, 80, &retain_scene),
+            kFlutterSpiOk);
+
+  EXPECT_EQ(SceneTrace(*take_scene->layer_tree),
+            SceneTrace(*retain_scene->layer_tree));
+  EXPECT_EQ(take_scene->root_layer->layers()[0]->original_layer_id(),
+            retain_scene->root_layer->layers()[0]->original_layer_id());
+
+  EXPECT_EQ(api()->engine_layer_release(retained_layer), kFlutterSpiOk);
+  EXPECT_EQ(api()->engine_layer_release(taken_layer), kFlutterSpiOk);
+  EXPECT_EQ(api()->engine_layer_release(old_handle), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(retain_scene), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(take_scene), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(old_scene), kFlutterSpiOk);
+}
