+TEST_F(SpiRetainedLayersTest, RetainLastLayerRejectsInvalidArguments) {
+  ASSERT_NE(api()->scene_retain_last_layer, nullptr);
+  FlutterSpiSceneBuilder* builder = MakeBuilder();
+  FlutterSpiEngineLayer* layer = nullptr;
+
+  EXPECT_EQ(api()->scene_retain_last_layer(nullptr, nullptr, &layer),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(api()->scene_retain_last_layer(builder, nullptr, nullptr),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(api()->scene_retain_last_layer(builder, nullptr, &layer),
+            kFlutterSpiInvalidArgument);
+
+  FlutterSpiSceneBuilder* old_builder = MakeBuilder();
+  ASSERT_EQ(api()->scene_push_opacity(old_builder, 128, 3.0f, 4.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* old_handle = nullptr;
+  ASSERT_EQ(api()->scene_take_last_layer(old_builder, &old_handle),
+            kFlutterSpiOk);
+  FlutterSpiScene* old_scene = nullptr;
+  ASSERT_EQ(api()->scene_build(old_builder, 100, 80, &old_scene),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->engine_layer_release(old_handle), kFlutterSpiOk);
+
+  ASSERT_EQ(api()->scene_push_opacity(builder, 64, 5.0f, 6.0f),
+            kFlutterSpiOk);
+  FlutterSpiEngineLayer* sentinel =
+      reinterpret_cast<FlutterSpiEngineLayer*>(1);
+  layer = sentinel;
+  EXPECT_EQ(api()->scene_retain_last_layer(builder, old_handle, &layer),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(layer, sentinel);
+
+  FlutterSpiScene* scene = nullptr;
+  ASSERT_EQ(api()->scene_build(builder, 100, 80, &scene), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneRelease(old_scene), kFlutterSpiOk);
+}
