+FlutterSpiResult SpiSceneRetainLastLayer(FlutterSpiSceneBuilder* builder,
+                                         FlutterSpiEngineLayer* old_layer,
+                                         FlutterSpiEngineLayer** out_layer) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_layer == nullptr || builder_value->layer_stack.size() <= 1) {
+    return kFlutterSpiInvalidArgument;
+  }
+  Layer* old_layer_value = nullptr;
+  if (old_layer != nullptr) {
+    old_layer_value = SpiEngineLayerGetRaw(old_layer);
+    if (old_layer_value == nullptr) {
+      return kFlutterSpiInvalidHandle;
+    }
+  }
+
+  FlutterSpiEngineLayer* layer =
+      SpiEngineLayerCreate(builder_value->layer_stack.back());
+  if (layer == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  if (old_layer_value != nullptr) {
+    builder_value->layer_stack.back()->AssignOldLayer(old_layer_value);
+  }
+  *out_layer = layer;
+  return kFlutterSpiOk;
+}
