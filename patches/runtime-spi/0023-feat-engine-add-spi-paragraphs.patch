+  ASSERT_EQ(SpiParagraphLayout(paragraph, kLayoutWidth), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphGetRectsForRange(
+                paragraph, 0, 5,
+                static_cast<int32_t>(txt::Paragraph::RectHeightStyle::kTight),
+                static_cast<int32_t>(txt::Paragraph::RectWidthStyle::kTight),
+                nullptr, 0, &count),
+            kFlutterSpiOk);
+  EXPECT_GT(count, 0u);
+  const size_t total_boxes = count;
+  ASSERT_EQ(SpiParagraphGetRectsForRange(
+                paragraph, 0, 5,
+                static_cast<int32_t>(txt::Paragraph::RectHeightStyle::kTight),
+                static_cast<int32_t>(txt::Paragraph::RectWidthStyle::kTight),
+                &box, 1, &count),
+            kFlutterSpiOk);
+  EXPECT_EQ(count, total_boxes);
+  ASSERT_EQ(SpiParagraphGetLineMetrics(paragraph, nullptr, 0, &count),
+            kFlutterSpiOk);
+  EXPECT_GT(count, 0u);
+  const size_t total_lines = count;
+  ASSERT_EQ(SpiParagraphGetLineMetrics(paragraph, &line, 1, &count),
