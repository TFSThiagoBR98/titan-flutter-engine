index 00000000000..3b6846b6a53
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/text/spi_paragraph.cc
@@ -0,0 +1,447 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/text/spi_paragraph.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "flutter/display_list/dl_builder.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "flutter/runtime_spi/text/spi_text_style.h"
+#include "third_party/icu/source/common/unicode/ustring.h"
+#include "txt/paragraph_builder.h"
+#include "txt/placeholder_run.h"
+
+namespace flutter {
+namespace {
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+class SpiParagraphBuilder final {
+ public:
+  SpiParagraphBuilder(const FlutterSpiParagraphStyle& style,
+                      const std::shared_ptr<txt::FontCollection>& fonts,
+                      bool impeller_enabled)
+      : builder_(txt::ParagraphBuilder::CreateSkiaBuilder(
+            ToTxtParagraphStyle(&style), fonts, impeller_enabled)) {}
+
+  FlutterSpiResult PushStyle(const FlutterSpiTextStyle& style) {
+    builder_->PushStyle(ToTxtTextStyle(&style));
+    return kFlutterSpiOk;
+  }
+
+  FlutterSpiResult Pop() {
+    builder_->Pop();
+    return kFlutterSpiOk;
+  }
+
+  FlutterSpiResult AddText(const char* utf8, size_t size) {
+    if (utf8 == nullptr && size != 0) {
+      return kFlutterSpiInvalidArgument;
+    }
+    if (!IsValidUtf8(utf8, size)) {
+      return kFlutterSpiInvalidArgument;
+    }
+    builder_->AddText(reinterpret_cast<const uint8_t*>(utf8), size);
+    return kFlutterSpiOk;
+  }
+
+  FlutterSpiResult AddPlaceholder(float width,
+                                   float height,
+                                   int32_t alignment,
+                                   float baseline_offset,
+                                   int32_t baseline) {
+    if (!std::isfinite(width) || !std::isfinite(height) || width < 0.0f ||
+        height < 0.0f || !std::isfinite(baseline_offset) ||
+        alignment < static_cast<int32_t>(txt::PlaceholderAlignment::kBaseline) ||
+        alignment > static_cast<int32_t>(txt::PlaceholderAlignment::kMiddle) ||
+        baseline < static_cast<int32_t>(txt::TextBaseline::kAlphabetic) ||
+        baseline > static_cast<int32_t>(txt::TextBaseline::kIdeographic)) {
+      return kFlutterSpiInvalidArgument;
+    }
+    txt::PlaceholderRun placeholder(
+        width, height, static_cast<txt::PlaceholderAlignment>(alignment),
+        static_cast<txt::TextBaseline>(baseline), baseline_offset);
+    builder_->AddPlaceholder(placeholder);
+    return kFlutterSpiOk;
+  }
+
+  std::unique_ptr<txt::Paragraph> Build() { return builder_->Build(); }
+
+ private:
+  static bool IsValidUtf8(const char* utf8, size_t size) {
+    if (size == 0) {
+      return true;
+    }
+    if (utf8 == nullptr || size > static_cast<size_t>(INT32_MAX)) {
+      return false;
+    }
+    UErrorCode error = U_ZERO_ERROR;
+    int32_t utf16_length = 0;
+    u_strFromUTF8(nullptr, 0, &utf16_length, utf8, static_cast<int32_t>(size),
+                  &error);
+    return error == U_BUFFER_OVERFLOW_ERROR;
+  }
+
+  std::unique_ptr<txt::ParagraphBuilder> builder_;
+};
+
+class SpiParagraph final {
+ public:
+  explicit SpiParagraph(std::unique_ptr<txt::Paragraph> paragraph)
+      : paragraph_(std::move(paragraph)) {}
+
+  FlutterSpiResult Layout(double width) {
+    if (!std::isfinite(width) || width < 0.0) {
+      return kFlutterSpiInvalidArgument;
+    }
+    paragraph_->Layout(width);
+    laid_out_ = true;
+    return kFlutterSpiOk;
+  }
+
+  bool laid_out() const { return laid_out_; }
+  txt::Paragraph& paragraph() { return *paragraph_; }
+
+ private:
+  std::unique_ptr<txt::Paragraph> paragraph_;
+  bool laid_out_ = false;
+};
+
+SpiHandleTable<SpiParagraphBuilder>& Builders() {
+  static SpiHandleTable<SpiParagraphBuilder> builders;
+  return builders;
+}
+
+SpiHandleTable<SpiParagraph>& Paragraphs() {
+  static SpiHandleTable<SpiParagraph> paragraphs;
+  return paragraphs;
+}
+
+std::shared_ptr<SpiParagraphBuilder> FindBuilder(
+    FlutterSpiParagraphBuilder* builder) {
+  return Builders().Find(HandleValue(builder));
+}
+
+std::shared_ptr<SpiParagraph> FindParagraph(FlutterSpiParagraph* paragraph) {
+  return Paragraphs().Find(HandleValue(paragraph));
+}
+
+FlutterSpiResult CopyTextBoxes(const std::vector<txt::Paragraph::TextBox>& boxes,
+                               FlutterSpiTextBox* out,
+                               size_t capacity,
+                               size_t* count) {
+  if (count == nullptr || (capacity != 0 && out == nullptr)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *count = boxes.size();
+  const size_t copied = std::min(capacity, boxes.size());
+  for (size_t index = 0; index < copied; index++) {
+    out[index] = {
+        .rect = {.left = boxes[index].rect.left(),
+                 .top = boxes[index].rect.top(),
+                 .right = boxes[index].rect.right(),
+                 .bottom = boxes[index].rect.bottom()},
+        .direction = static_cast<int32_t>(boxes[index].direction),
+    };
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CopyLineMetrics(const std::vector<txt::LineMetrics>& metrics,
+                                 FlutterSpiLineMetrics* out,
+                                 size_t capacity,
+                                 size_t* count) {
+  if (count == nullptr || (capacity != 0 && out == nullptr)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *count = metrics.size();
+  const size_t copied = std::min(capacity, metrics.size());
+  for (size_t index = 0; index < copied; index++) {
+    const txt::LineMetrics& source = metrics[index];
+    out[index] = {
+        .start_index = source.start_index,
+        .end_index = source.end_index,
+        .end_excluding_whitespace = source.end_excluding_whitespace,
+        .end_including_newline = source.end_including_newline,
+        .hard_break = source.hard_break,
+        .ascent = source.ascent,
+        .descent = source.descent,
+        .unscaled_ascent = source.unscaled_ascent,
+        .height = source.height,
+        .width = source.width,
+        .left = source.left,
+        .baseline = source.baseline,
+        .line_number = source.line_number,
+    };
+  }
+  return kFlutterSpiOk;
+}
+
+bool IsValidRectHeightStyle(int32_t value) {
+  return value >= static_cast<int32_t>(txt::Paragraph::RectHeightStyle::kTight) &&
+         value <= static_cast<int32_t>(txt::Paragraph::RectHeightStyle::kStrut);
+}
+
+bool IsValidRectWidthStyle(int32_t value) {
+  return value >= static_cast<int32_t>(txt::Paragraph::RectWidthStyle::kTight) &&
+         value <= static_cast<int32_t>(txt::Paragraph::RectWidthStyle::kMax);
+}
+
+}  // namespace
+
+FlutterSpiResult SpiParagraphBuilderCreate(
+    const std::shared_ptr<txt::FontCollection>& font_collection,
+    bool impeller_enabled,
+    const FlutterSpiParagraphStyle* style,
+    FlutterSpiParagraphBuilder** out_builder) {
+  if (font_collection == nullptr || style == nullptr || out_builder == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto builder = std::make_shared<SpiParagraphBuilder>(
+      *style, font_collection, impeller_enabled);
+  *out_builder = MakeHandle<FlutterSpiParagraphBuilder>(
+      Builders().Insert(std::move(builder)));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiParagraphBuilderPushStyle(
+    FlutterSpiParagraphBuilder* builder,
+    const FlutterSpiTextStyle* style) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (style == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return builder_value->PushStyle(*style);
+}
+
+FlutterSpiResult SpiParagraphBuilderPop(FlutterSpiParagraphBuilder* builder) {
+  const auto builder_value = FindBuilder(builder);
+  return builder_value == nullptr ? kFlutterSpiInvalidHandle
+                                  : builder_value->Pop();
+}
+
+FlutterSpiResult SpiParagraphBuilderAddText(FlutterSpiParagraphBuilder* builder,
+                                            const char* utf8,
+                                            size_t size) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return builder_value->AddText(utf8, size);
+}
+
+FlutterSpiResult SpiParagraphBuilderAddPlaceholder(
+    FlutterSpiParagraphBuilder* builder,
+    float width,
+    float height,
+    int32_t alignment,
+    float baseline_offset,
+    int32_t baseline) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return builder_value->AddPlaceholder(width, height, alignment,
+                                       baseline_offset, baseline);
+}
+
+FlutterSpiResult SpiParagraphBuilderBuild(
+    FlutterSpiParagraphBuilder* builder,
+    FlutterSpiParagraph** out_paragraph) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_paragraph == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto paragraph = builder_value->Build();
+  if (paragraph == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_paragraph = MakeHandle<FlutterSpiParagraph>(
+      Paragraphs().Insert(std::make_shared<SpiParagraph>(std::move(paragraph))));
+  Builders().Release(HandleValue(builder));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiParagraphBuilderRelease(FlutterSpiParagraphBuilder* builder) {
+  return Builders().Release(HandleValue(builder)) ? kFlutterSpiOk
+                                                   : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiParagraphLayout(FlutterSpiParagraph* paragraph,
+                                    double width) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return paragraph_value->Layout(width);
+}
+
+FlutterSpiResult SpiParagraphGetMetrics(
+    FlutterSpiParagraph* paragraph,
+    FlutterSpiParagraphMetrics* out_metrics) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out() || out_metrics == nullptr ||
+      out_metrics->struct_size < sizeof(FlutterSpiParagraphMetrics)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  txt::Paragraph& source = paragraph_value->paragraph();
+  *out_metrics = {
+      .struct_size = out_metrics->struct_size,
+      .width = source.GetMaxWidth(),
+      .height = source.GetHeight(),
+      .longest_line = source.GetLongestLine(),
+      .min_intrinsic_width = source.GetMinIntrinsicWidth(),
+      .max_intrinsic_width = source.GetMaxIntrinsicWidth(),
+      .alphabetic_baseline = source.GetAlphabeticBaseline(),
+      .ideographic_baseline = source.GetIdeographicBaseline(),
+      .did_exceed_max_lines = source.DidExceedMaxLines(),
+      .line_count = source.GetNumberOfLines(),
+  };
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiParagraphGetRectsForRange(
+    FlutterSpiParagraph* paragraph,
+    size_t start,
+    size_t end,
+    int32_t height_style,
+    int32_t width_style,
+    FlutterSpiTextBox* out,
+    size_t capacity,
+    size_t* count) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out() || start > end ||
+      !IsValidRectHeightStyle(height_style) ||
+      !IsValidRectWidthStyle(width_style)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto boxes = paragraph_value->paragraph().GetRectsForRange(
+      start, end,
+      static_cast<txt::Paragraph::RectHeightStyle>(height_style),
+      static_cast<txt::Paragraph::RectWidthStyle>(width_style));
+  return CopyTextBoxes(boxes, out, capacity, count);
+}
+
+FlutterSpiResult SpiParagraphGetRectsForPlaceholders(
+    FlutterSpiParagraph* paragraph,
+    FlutterSpiTextBox* out,
+    size_t capacity,
+    size_t* count) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out()) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return CopyTextBoxes(paragraph_value->paragraph().GetRectsForPlaceholders(),
+                       out, capacity, count);
+}
+
+FlutterSpiResult SpiParagraphGetGlyphPositionAt(FlutterSpiParagraph* paragraph,
+                                                double dx,
+                                                double dy,
+                                                size_t* offset,
+                                                int32_t* affinity) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out() || !std::isfinite(dx) ||
+      !std::isfinite(dy) || offset == nullptr || affinity == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto position =
+      paragraph_value->paragraph().GetGlyphPositionAtCoordinate(dx, dy);
+  *offset = position.position;
+  *affinity = static_cast<int32_t>(position.affinity);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiParagraphGetWordBoundary(FlutterSpiParagraph* paragraph,
+                                             size_t offset,
+                                             size_t* start,
+                                             size_t* end) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out() || start == nullptr || end == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto boundary = paragraph_value->paragraph().GetWordBoundary(offset);
+  *start = boundary.start;
+  *end = boundary.end;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiParagraphGetLineMetrics(FlutterSpiParagraph* paragraph,
+                                            FlutterSpiLineMetrics* out,
+                                            size_t capacity,
+                                            size_t* count) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out()) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return CopyLineMetrics(paragraph_value->paragraph().GetLineMetrics(), out,
+                         capacity, count);
+}
+
+FlutterSpiResult SpiParagraphRetain(FlutterSpiParagraph* paragraph) {
+  return Paragraphs().Retain(HandleValue(paragraph)) ? kFlutterSpiOk
+                                                      : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiParagraphRelease(FlutterSpiParagraph* paragraph) {
+  return Paragraphs().Release(HandleValue(paragraph)) ? kFlutterSpiOk
+                                                        : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiParagraphPaint(FlutterSpiParagraph* paragraph,
+                                   DisplayListBuilder* builder,
+                                   float x,
+                                   float y) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out() || builder == nullptr || !std::isfinite(x) ||
+      !std::isfinite(y)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return paragraph_value->paragraph().Paint(builder, x, y)
+             ? kFlutterSpiOk
+             : kFlutterSpiInvalidArgument;
+}
+
+}  // namespace flutter
