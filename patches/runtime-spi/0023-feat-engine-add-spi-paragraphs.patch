+  ASSERT_EQ(SpiParagraphBuilderAddText(builder, "two", 3), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderPushStyle(builder, &third), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderAddText(builder, "three", 5), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderPop(builder), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderPop(builder), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderAddText(builder, "four", 4), kFlutterSpiOk);
+  FlutterSpiParagraph* paragraph = nullptr;
+  ASSERT_EQ(SpiParagraphBuilderBuild(builder, &paragraph), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphLayout(paragraph, kLayoutWidth), kFlutterSpiOk);
+
+  auto expected_builder = txt::ParagraphBuilder::CreateSkiaBuilder(
+      ToTxtParagraphStyle(&paragraph_style), TxtFontCollection(), false);
+  expected_builder->PushStyle(ToTxtTextStyle(&first));
+  expected_builder->AddText(u"one");
+  expected_builder->PushStyle(ToTxtTextStyle(&second));
+  expected_builder->AddText(u"two");
+  expected_builder->PushStyle(ToTxtTextStyle(&third));
+  expected_builder->AddText(u"three");
+  expected_builder->Pop();
+  expected_builder->Pop();
+  expected_builder->AddText(u"four");
+  auto expected = expected_builder->Build();
+  expected->Layout(kLayoutWidth);
+  ASSERT_TRUE(HasRenderedText(*expected));
+
+  FlutterSpiParagraphMetrics actual = {
+      .struct_size = sizeof(FlutterSpiParagraphMetrics)};
+  ASSERT_EQ(SpiParagraphGetMetrics(paragraph, &actual), kFlutterSpiOk);
+  ExpectMetricsEqual(actual, *expected);
+  EXPECT_EQ(SpiParagraphRelease(paragraph), kFlutterSpiOk);
+}
