+
+constexpr double kLayoutWidth = 120.0;
+const char* const kRobotoFamilies[] = {"Roboto"};
+
+void RegisterFont(void* user_data,
+                  std::string family_name,
+                  sk_sp<SkTypeface> typeface) {
+  static_cast<FontCollection*>(user_data)->RegisterDynamicFont(
+      std::move(family_name), std::move(typeface));
+}
+
+class SpiParagraphTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    const auto executable_directory =
+        fml::paths::GetExecutableDirectoryPath();
+    ASSERT_TRUE(executable_directory.first);
+    fml::icu::InitializeICU(fml::paths::JoinPaths(
+        {executable_directory.second, "icudtl.dat"}));
+
+    font_collection_ = std::make_shared<FontCollection>();
+    auto mapping = OpenFixtureAsMapping("Roboto-Regular.ttf");
+    ASSERT_NE(mapping, nullptr);
+    ASSERT_EQ(FontLoad(mapping->GetMapping(), mapping->GetSize(), nullptr,
+                       font_collection_.get(), RegisterFont),
+              kFlutterSpiOk);
+  }
+
+  std::shared_ptr<txt::FontCollection> TxtFontCollection() const {
+    return font_collection_->GetFontCollection();
+  }
+
+  FlutterSpiParagraphStyle ParagraphStyle() const {
+    return {
+        .struct_size = sizeof(FlutterSpiParagraphStyle),
+        .font_family = "Roboto",
+        .font_size = 18.0f,
+    };
+  }
+
+  FlutterSpiTextStyle TextStyle(float font_size = 18.0f) const {
+    return {
+        .struct_size = sizeof(FlutterSpiTextStyle),
+        .font_families = kRobotoFamilies,
+        .font_family_count = 1,
+        .font_size = font_size,
+    };
+  }
+
+  FlutterSpiParagraph* BuildSpiParagraph(
+      const FlutterSpiParagraphStyle& paragraph_style,
+      std::string_view text) const {
+    FlutterSpiParagraphBuilder* builder = nullptr;
+    EXPECT_EQ(SpiParagraphBuilderCreate(TxtFontCollection(), false,
+                                        &paragraph_style, &builder),
+              kFlutterSpiOk);
+    EXPECT_NE(builder, nullptr);
+    const FlutterSpiTextStyle text_style = TextStyle();
+    EXPECT_EQ(SpiParagraphBuilderPushStyle(builder, &text_style),
+              kFlutterSpiOk);
+    EXPECT_EQ(SpiParagraphBuilderAddText(
+                  builder, text.data(), text.size()),
+              kFlutterSpiOk);
+    FlutterSpiParagraph* paragraph = nullptr;
+    EXPECT_EQ(SpiParagraphBuilderBuild(builder, &paragraph), kFlutterSpiOk);
+    EXPECT_NE(paragraph, nullptr);
+    return paragraph;
+  }
+
+  std::unique_ptr<txt::Paragraph> BuildTxtParagraph(
+      const FlutterSpiParagraphStyle& paragraph_style,
+      std::string_view text) const {
+    auto builder = txt::ParagraphBuilder::CreateSkiaBuilder(
+        ToTxtParagraphStyle(&paragraph_style), TxtFontCollection(), false);
+    const auto text_style = TextStyle();
+    builder->PushStyle(ToTxtTextStyle(&text_style));
+    builder->AddText(reinterpret_cast<const uint8_t*>(text.data()),
+                     text.size());
+    auto paragraph = builder->Build();
+    paragraph->Layout(kLayoutWidth);
+    return paragraph;
+  }
+
+  std::shared_ptr<FontCollection> font_collection_;
+};
+
+bool HasRenderedText(txt::Paragraph& paragraph) {
+  return paragraph.GetHeight() > 0.0 && paragraph.GetLongestLine() > 0.0 &&
+         paragraph.GetNumberOfLines() > 0;
+}
+
+void ExpectMetricsEqual(const FlutterSpiParagraphMetrics& actual,
+                        txt::Paragraph& expected) {
+  EXPECT_DOUBLE_EQ(actual.width, expected.GetMaxWidth());
+  EXPECT_DOUBLE_EQ(actual.height, expected.GetHeight());
+  EXPECT_DOUBLE_EQ(actual.longest_line, expected.GetLongestLine());
+  EXPECT_DOUBLE_EQ(actual.min_intrinsic_width,
+                   expected.GetMinIntrinsicWidth());
+  EXPECT_DOUBLE_EQ(actual.max_intrinsic_width,
+                   expected.GetMaxIntrinsicWidth());
+  EXPECT_DOUBLE_EQ(actual.alphabetic_baseline,
+                   expected.GetAlphabeticBaseline());
+  EXPECT_DOUBLE_EQ(actual.ideographic_baseline,
+                   expected.GetIdeographicBaseline());
+  EXPECT_EQ(actual.did_exceed_max_lines, expected.DidExceedMaxLines());
+  EXPECT_EQ(actual.line_count, expected.GetNumberOfLines());
+}
