+
+class PlatformMessageSender final {
+ public:
+  static std::shared_ptr<PlatformMessageSender> Create(
+      FlutterSpiEngine* engine,
+      const FlutterSpiEngineApi* api);
+
+  ~PlatformMessageSender();
+
+  bool Send(std::unique_ptr<PlatformMessage> message);
+
+ private:
+  using SendFunction = decltype(FlutterSpiEngineApi::platform_message_sender_send);
+  using ReleaseFunction =
+      decltype(FlutterSpiEngineApi::platform_message_sender_release);
+
+  PlatformMessageSender(FlutterSpiPlatformMessageSender* sender,
+                        SendFunction send,
+                        ReleaseFunction release)
+      : sender_(sender), send_(send), release_(release) {}
+
+  FlutterSpiPlatformMessageSender* sender_ = nullptr;
+  SendFunction send_ = nullptr;
+  ReleaseFunction release_ = nullptr;
+
+  FML_DISALLOW_COPY_AND_ASSIGN(PlatformMessageSender);
+};
+
