@@ -0,0 +1,88 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/lib/ui/window/platform_message_sender.h"
+
+#include <cstddef>
+#include <utility>
+
+#include "flutter/fml/logging.h"
+#include "flutter/lib/ui/window/platform_message.h"
+
+namespace flutter {
+
+void CompleteEngineReply(void* user_data,
+                         const uint8_t* data,
+                         size_t size) {
+  auto context = std::unique_ptr<EngineReplyContext>(
+      static_cast<EngineReplyContext*>(user_data));
+  if (!context->response) {
+    return;
+  }
+  if (data == nullptr || size == 0) {
+    context->response->CompleteEmpty();
+    return;
+  }
+  context->response->Complete(
+      std::make_unique<fml::MallocMapping>(fml::MallocMapping::Copy(data, size)));
+}
+
+std::shared_ptr<PlatformMessageSender> PlatformMessageSender::Create(
+    FlutterSpiEngine* engine,
+    const FlutterSpiEngineApi* api) {
+  if (engine == nullptr || api == nullptr ||
+      api->struct_size <
+          offsetof(FlutterSpiEngineApi, platform_message_sender_release) +
+              sizeof(api->platform_message_sender_release) ||
+      api->platform_message_sender_create == nullptr ||
+      api->platform_message_sender_send == nullptr ||
+      api->platform_message_sender_release == nullptr) {
+    return nullptr;
+  }
+
+  FlutterSpiPlatformMessageSender* sender = nullptr;
+  if (api->platform_message_sender_create(engine, &sender) != kFlutterSpiOk ||
+      sender == nullptr) {
+    return nullptr;
+  }
+  return std::shared_ptr<PlatformMessageSender>(new PlatformMessageSender(
+      sender, api->platform_message_sender_send,
+      api->platform_message_sender_release));
+}
+
+PlatformMessageSender::~PlatformMessageSender() {
+  if (sender_ == nullptr || release_ == nullptr) {
+    return;
+  }
+  const FlutterSpiResult result = release_(sender_);
+  if (result != kFlutterSpiOk) {
+    FML_LOG(ERROR) << "Runtime SPI platform message sender release failed: "
+                   << result;
+  }
+}
+
+bool PlatformMessageSender::Send(std::unique_ptr<PlatformMessage> message) {
+  if (message == nullptr || sender_ == nullptr || send_ == nullptr) {
+    return false;
+  }
+
+  auto* context = !message->response()
+                      ? nullptr
+                      : new EngineReplyContext{message->response()};
+  static const uint8_t kEmptyPayload = 0;
+  const uint8_t* data = nullptr;
+  if (message->hasData()) {
+    data = message->data().GetSize() == 0 ? &kEmptyPayload
+                                          : message->data().GetMapping();
+  }
+  const FlutterSpiResult result = send_(
+      sender_, message->channel().c_str(), data, message->data().GetSize(),
+      context == nullptr ? nullptr : CompleteEngineReply, context);
+  if (result != kFlutterSpiOk && context != nullptr) {
+    CompleteEngineReply(context, nullptr, 0);
+  }
+  return result == kFlutterSpiOk;
+}
+
+}  // namespace flutter
