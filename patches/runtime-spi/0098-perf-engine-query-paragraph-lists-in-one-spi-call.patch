# Why: avoid recalculating paragraph list queries when the initial capacity is
# sufficient.
diff --git a/engine/src/flutter/lib/ui/text/paragraph.cc b/engine/src/flutter/lib/ui/text/paragraph.cc
index 85f2fbfa5bb..f5c437b8454 100644
--- a/engine/src/flutter/lib/ui/text/paragraph.cc
+++ b/engine/src/flutter/lib/ui/text/paragraph.cc
@@ -22,6 +22,8 @@
 namespace flutter {
 namespace {
 
+constexpr size_t kInitialQueryCapacity = 16;
+
 const FlutterSpiTextApi* TextApi() {
   return SpiEngineTextApi(
       UIDartState::Current()->platform_configuration()->client()->GetSpiEngine());
@@ -50,47 +52,50 @@ tonic::Float32List EncodeTextBoxes(
   return result;
 }
 
+template <typename Element, typename Query>
+std::vector<Element> QueryParagraphList(const Query& query) {
+  std::vector<Element> result(kInitialQueryCapacity);
+  size_t count = result.size();
+  FML_CHECK(query(result.data(), result.size(), &count) == kFlutterSpiOk);
+  if (count > result.size()) {
+    result.resize(count);
+    FML_CHECK(query(result.data(), result.size(), &count) == kFlutterSpiOk);
+  }
+  result.resize(count);
+  return result;
+}
+
