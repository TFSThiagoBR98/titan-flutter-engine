                                                 unsigned start,
                                                 unsigned end,
                                                 unsigned height_style,
                                                 unsigned width_style) {
-  size_t count = 0;
-  FML_CHECK(TextApi()->paragraph_get_rects_for_range(
-                paragraph, start, end, height_style, width_style, nullptr, 0,
-                &count) == kFlutterSpiOk);
-  std::vector<FlutterSpiTextBox> boxes(count);
-  FML_CHECK(TextApi()->paragraph_get_rects_for_range(
-                paragraph, start, end, height_style, width_style, boxes.data(),
-                boxes.size(), &count) == kFlutterSpiOk);
-  boxes.resize(count);
-  return boxes;
+  return QueryParagraphList<FlutterSpiTextBox>(
+      [paragraph, start, end, height_style, width_style](
+          FlutterSpiTextBox* boxes, size_t capacity, size_t* count) {
+        return TextApi()->paragraph_get_rects_for_range(
+            paragraph, start, end, height_style, width_style, boxes, capacity,
+            count);
+      });
 }
 
