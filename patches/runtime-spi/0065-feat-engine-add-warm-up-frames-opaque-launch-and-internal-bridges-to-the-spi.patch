+  Settings settings;
+  EXPECT_TRUE(backend->Launch(RunConfiguration(nullptr), settings, {}, 1));
+  EXPECT_EQ(capture.call_count, 1u);
+  EXPECT_NE(capture.run_configuration, nullptr);
+}
