+
+namespace flutter {
+
+FlutterSpiResult SpiSceneFromLayerTree(std::unique_ptr<LayerTree> layer_tree,
+                                       FlutterSpiScene** out) {
+  if (out == nullptr || layer_tree == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  auto scene = std::make_unique<FlutterSpiScene>();
+  scene->width_px = layer_tree->frame_size().width;
+  scene->height_px = layer_tree->frame_size().height;
+  scene->layer_tree = std::move(layer_tree);
+  *out = scene.release();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiSubmitSemantics(
+    FlutterSpiEngine* engine,
+    int64_t view_id,
+    SemanticsNodeUpdates nodes,
+    CustomAccessibilityActionUpdates actions) {
+  if (engine == nullptr || engine->backend == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  engine->backend->runtime_delegate_.UpdateSemantics(
+      view_id, std::move(nodes), std::move(actions));
+  return kFlutterSpiOk;
+}
+
+FontCollection& SpiEngineFontCollection(FlutterSpiEngine* engine) {
+  return engine->backend->runtime_delegate_.GetFontCollection();
+}
+
+std::shared_ptr<AssetManager> SpiEngineAssetManager(FlutterSpiEngine* engine) {
+  return engine->backend->runtime_delegate_.GetAssetManager();
+}
+
+}  // namespace flutter
