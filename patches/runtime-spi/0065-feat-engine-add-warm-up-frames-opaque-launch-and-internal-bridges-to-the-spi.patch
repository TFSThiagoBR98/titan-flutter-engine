+TEST_F(SpiRuntimeBackendTest, WarmUpFrameUsesTokenZero) {
+  auto backend = CreateBackend(c_test_runtime_table(runtime));
+  LaunchBackend(backend.get());
+  backend->AddView(1, ViewportMetrics(), {});
+
+  ASSERT_NE(runtime->engine_api, nullptr);
+  ASSERT_NE(runtime->engine_api->scene_create_empty, nullptr);
+  ASSERT_NE(runtime->engine_api->submit_frame, nullptr);
+  ASSERT_NE(runtime->engine_api->frames_done, nullptr);
+  FlutterSpiScene* scene = nullptr;
+  ASSERT_EQ(runtime->engine_api->scene_create_empty(runtime->engine, 10, 10,
+                                                     &scene),
+            kFlutterSpiOk);
+
+  EXPECT_EQ(runtime->engine_api->submit_frame(runtime->engine, 1, 0, scene,
+                                               1.0),
+            kFlutterSpiOk);
+  EXPECT_EQ(delegate.render_count, 1u);
+  EXPECT_EQ(runtime->engine_api->frames_done(runtime->engine), kFlutterSpiOk);
+  EXPECT_EQ(delegate.all_views_rendered_count, 1u);
+}
