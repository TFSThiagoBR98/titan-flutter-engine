+  auto table = c_test_runtime_table(runtime);
+  LaunchRootIsolateCapture capture;
+  FlutterSpiRuntimeExtensions extensions = *table.extensions;
+  extensions.user_data = &capture;
+  extensions.launch_root_isolate = CaptureLaunchRootIsolate;
+  table.extensions = &extensions;
+  auto backend = CreateBackend(table);
+
+  ASSERT_NE(backend->GetExtensions(), nullptr);
