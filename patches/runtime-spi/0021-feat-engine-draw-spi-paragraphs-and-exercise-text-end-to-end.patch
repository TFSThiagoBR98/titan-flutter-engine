+FlutterSpiResult SpiEngineApi::TextFontLoad(FlutterSpiEngine* engine,
+                                            const uint8_t* data,
+                                            size_t size,
+                                            const char* family_alias) {
+  if (engine == nullptr || engine->backend == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!engine->backend->HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  return FontLoad(data, size, family_alias,
+                  &engine->backend->runtime_delegate_.GetFontCollection(),
+                  RegisterDynamicFont);
