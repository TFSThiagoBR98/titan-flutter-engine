+        .struct_size = sizeof(FlutterSpiParagraphStyle),
+        .font_family = "Roboto",
+        .font_size = 18.0f,
+    };
+    const FlutterSpiTextStyle text_style = {
+        .struct_size = sizeof(FlutterSpiTextStyle),
+        .color = kTextColor,
+        .font_families = kRobotoFamilies,
+        .font_family_count = 1,
+        .font_size = 18.0f,
+    };
+    auto builder = txt::ParagraphBuilder::CreateSkiaBuilder(
+        ToTxtParagraphStyle(&paragraph_style),
+        font_collection_->GetFontCollection(), false);
+    builder->PushStyle(ToTxtTextStyle(&text_style));
+    builder->AddText(u"Hello, SPI");
+    auto paragraph = builder->Build();
+    paragraph->Layout(kLayoutWidth);
+    return paragraph;
+  }
+
+  std::shared_ptr<FontCollection> font_collection_;
+};
+
+struct ColorDrawRecord {
+  DlColor color;
+
+  bool operator==(const ColorDrawRecord&) const = default;
+};
+
+struct TextDrawRecord {
+  DlScalar x;
+  DlScalar y;
+  DlRect bounds;
+  std::vector<SkGlyphID> glyphs;
+
+  bool operator==(const TextDrawRecord&) const = default;
+};
+
+using TextDrawOperation = std::variant<ColorDrawRecord, TextDrawRecord>;
+
+class TextDrawRecorder final
+    : public IgnoreAttributeDispatchHelper,
+      public IgnoreClipDispatchHelper,
+      public IgnoreTransformDispatchHelper,
+      public IgnoreDrawDispatchHelper {
+ public:
+  void setColor(DlColor color) override {
+    operations.emplace_back(ColorDrawRecord{.color = color});
+  }
+
+  void drawText(const std::shared_ptr<DlText>& text,
+                DlScalar x,
+                DlScalar y) override {
+    ASSERT_NE(text, nullptr);
+    const SkTextBlob* blob = text->GetTextBlob();
+    ASSERT_NE(blob, nullptr)
+        << "TextDrawRecorder requires a SkTextBlob-backed DlText";
+    if (blob == nullptr) {
+      return;
+    }
+
+    TextDrawRecord record = {
+        .x = x,
+        .y = y,
+        .bounds = text->GetBounds(),
+    };
+    SkTextBlob::Iter iterator(*blob);
+    SkTextBlob::Iter::Run run = {};
+    while (iterator.next(&run)) {
+      if (run.fGlyphCount == 0) {
+        continue;
+      }
+      record.glyphs.insert(record.glyphs.end(), run.fGlyphIndices,
+                           run.fGlyphIndices + run.fGlyphCount);
+    }
+    operations.emplace_back(std::move(record));
+  }
+
+  bool HasDrawTextWithGlyphs() const {
+    for (const TextDrawOperation& operation : operations) {
+      const auto* text = std::get_if<TextDrawRecord>(&operation);
+      if (text != nullptr && !text->glyphs.empty()) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  std::vector<TextDrawOperation> operations;
+};
+
+TEST_F(SpiParagraphDrawTest, DrawParagraphMatchesTxtPaint) {
+  FlutterSpiEngine engine = {};
+  FlutterSpiParagraph* paragraph = BuildSpiParagraph();
+  ASSERT_NE(paragraph, nullptr);
+  ASSERT_EQ(SpiParagraphLayout(paragraph, kLayoutWidth), kFlutterSpiOk);
+
+  const FlutterSpiTextApi* text_api = SpiEngineApi::Create().text;
+  ASSERT_NE(text_api, nullptr);
+
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(SpiSceneApi()->recorder_create(&engine, nullptr, &recorder),
+            kFlutterSpiOk);
+  ASSERT_EQ(text_api->canvas_draw_paragraph(recorder, paragraph, kParagraphX,
+                                            kParagraphY),
+            kFlutterSpiOk);
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(SpiSceneApi()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+
+  auto expected_paragraph = BuildTxtParagraph();
+  DisplayListBuilder expected(DisplayListBuilder::kMaxCullRect);
+  ASSERT_TRUE(expected_paragraph->Paint(&expected, kParagraphX, kParagraphY));
+  const auto expected_list = expected.Build();
+  const auto actual_list = SpiPictureDisplayListForTesting(picture);
+  ASSERT_NE(actual_list, nullptr);
+
+  EXPECT_EQ(actual_list->op_count(), expected_list->op_count());
+  EXPECT_EQ(actual_list->GetBounds(), expected_list->GetBounds());
+
+  TextDrawRecorder actual_recorder;
+  actual_list->Dispatch(actual_recorder);
+  TextDrawRecorder expected_recorder;
+  expected_list->Dispatch(expected_recorder);
+  EXPECT_EQ(actual_recorder.operations, expected_recorder.operations);
+  EXPECT_TRUE(expected_recorder.HasDrawTextWithGlyphs());
+
+  EXPECT_EQ(SpiParagraphRelease(paragraph), kFlutterSpiOk);
+  EXPECT_EQ(SpiSceneApi()->picture_release(picture), kFlutterSpiOk);
+}
+
+}  // namespace
+}  // namespace flutter::testing
