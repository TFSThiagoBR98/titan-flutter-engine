+              static_cast<int32_t>(impeller::Context::BackendType::kVulkan));
+
+}  // namespace
+
+impeller::StorageMode SpiGpuToImpellerStorageMode(int32_t value) {
+  switch (value) {
+    case kFlutterSpiGpuStorageModeHostVisible:
+      return impeller::StorageMode::kHostVisible;
+    case kFlutterSpiGpuStorageModeDevicePrivate:
+      return impeller::StorageMode::kDevicePrivate;
+    case kFlutterSpiGpuStorageModeDeviceTransient:
+      return impeller::StorageMode::kDeviceTransient;
+    default:
+      return impeller::StorageMode::kDeviceTransient;
+  }
+}
+
+impeller::TextureType SpiGpuToImpellerTextureType(int32_t value) {
+  switch (value) {
+    case kFlutterSpiGpuTextureType2D:
+      return impeller::TextureType::kTexture2D;
+    case kFlutterSpiGpuTextureType2DMultisample:
+      return impeller::TextureType::kTexture2DMultisample;
+    case kFlutterSpiGpuTextureTypeCube:
+      return impeller::TextureType::kTextureCube;
+    case kFlutterSpiGpuTextureTypeExternalOES:
+      return impeller::TextureType::kTextureExternalOES;
+    case kFlutterSpiGpuTextureType2DArray:
+      return impeller::TextureType::kTexture2DArray;
+    default:
+      return impeller::TextureType::kTexture2D;
+  }
+}
+
+impeller::PixelFormat SpiGpuToImpellerPixelFormat(int32_t value) {
+  switch (value) {
+    case kFlutterSpiGpuPixelFormatUnknown:
+      return impeller::PixelFormat::kUnknown;
+    case kFlutterSpiGpuPixelFormatA8UNormInt:
+      return impeller::PixelFormat::kA8UNormInt;
+    case kFlutterSpiGpuPixelFormatR8UNormInt:
+      return impeller::PixelFormat::kR8UNormInt;
+    case kFlutterSpiGpuPixelFormatR8G8UNormInt:
+      return impeller::PixelFormat::kR8G8UNormInt;
+    case kFlutterSpiGpuPixelFormatR8G8B8A8UNormInt:
+      return impeller::PixelFormat::kR8G8B8A8UNormInt;
+    case kFlutterSpiGpuPixelFormatR8G8B8A8UNormIntSRGB:
+      return impeller::PixelFormat::kR8G8B8A8UNormIntSRGB;
+    case kFlutterSpiGpuPixelFormatB8G8R8A8UNormInt:
+      return impeller::PixelFormat::kB8G8R8A8UNormInt;
+    case kFlutterSpiGpuPixelFormatB8G8R8A8UNormIntSRGB:
+      return impeller::PixelFormat::kB8G8R8A8UNormIntSRGB;
+    case kFlutterSpiGpuPixelFormatR32G32B32A32Float:
+      return impeller::PixelFormat::kR32G32B32A32Float;
+    case kFlutterSpiGpuPixelFormatR16G16B16A16Float:
+      return impeller::PixelFormat::kR16G16B16A16Float;
+    case kFlutterSpiGpuPixelFormatR32Float:
+      return impeller::PixelFormat::kR32Float;
+    case kFlutterSpiGpuPixelFormatS8UInt:
+      return impeller::PixelFormat::kS8UInt;
+    case kFlutterSpiGpuPixelFormatD24UnormS8Uint:
+      return impeller::PixelFormat::kD24UnormS8Uint;
+    case kFlutterSpiGpuPixelFormatD32FloatS8UInt:
+      return impeller::PixelFormat::kD32FloatS8UInt;
+    case kFlutterSpiGpuPixelFormatBC1RGBAUNormInt:
+      return impeller::PixelFormat::kBC1RGBAUNormInt;
+    case kFlutterSpiGpuPixelFormatBC1RGBAUNormIntSRGB:
+      return impeller::PixelFormat::kBC1RGBAUNormIntSRGB;
+    case kFlutterSpiGpuPixelFormatBC3RGBAUNormInt:
+      return impeller::PixelFormat::kBC3RGBAUNormInt;
+    case kFlutterSpiGpuPixelFormatBC3RGBAUNormIntSRGB:
+      return impeller::PixelFormat::kBC3RGBAUNormIntSRGB;
+    case kFlutterSpiGpuPixelFormatBC5RGUNormInt:
+      return impeller::PixelFormat::kBC5RGUNormInt;
+    case kFlutterSpiGpuPixelFormatBC7RGBAUNormInt:
+      return impeller::PixelFormat::kBC7RGBAUNormInt;
+    case kFlutterSpiGpuPixelFormatBC7RGBAUNormIntSRGB:
+      return impeller::PixelFormat::kBC7RGBAUNormIntSRGB;
+    case kFlutterSpiGpuPixelFormatETC2RGB8UNormInt:
+      return impeller::PixelFormat::kETC2RGB8UNormInt;
+    case kFlutterSpiGpuPixelFormatETC2RGB8UNormIntSRGB:
+      return impeller::PixelFormat::kETC2RGB8UNormIntSRGB;
+    case kFlutterSpiGpuPixelFormatETC2RGBA8UNormInt:
+      return impeller::PixelFormat::kETC2RGBA8UNormInt;
+    case kFlutterSpiGpuPixelFormatETC2RGBA8UNormIntSRGB:
+      return impeller::PixelFormat::kETC2RGBA8UNormIntSRGB;
+    case kFlutterSpiGpuPixelFormatASTC4x4LDR:
+      return impeller::PixelFormat::kASTC4x4LDR;
+    case kFlutterSpiGpuPixelFormatASTC4x4LDRSRGB:
+      return impeller::PixelFormat::kASTC4x4LDRSRGB;
+    case kFlutterSpiGpuPixelFormatASTC8x8LDR:
+      return impeller::PixelFormat::kASTC8x8LDR;
+    case kFlutterSpiGpuPixelFormatASTC8x8LDRSRGB:
+      return impeller::PixelFormat::kASTC8x8LDRSRGB;
+    case kFlutterSpiGpuPixelFormatASTC4x4HDR:
+      return impeller::PixelFormat::kASTC4x4HDR;
+    case kFlutterSpiGpuPixelFormatASTC8x8HDR:
+      return impeller::PixelFormat::kASTC8x8HDR;
+    default:
+      return impeller::PixelFormat::kUnknown;
+  }
+}
+
+impeller::CompressedTextureFamily SpiGpuToImpellerCompressionFamily(
+    int32_t value) {
+  switch (value) {
+    case kFlutterSpiGpuTextureCompressionFamilyBC:
+      return impeller::CompressedTextureFamily::kBC;
+    case kFlutterSpiGpuTextureCompressionFamilyETC2:
+      return impeller::CompressedTextureFamily::kETC2;
+    case kFlutterSpiGpuTextureCompressionFamilyASTC:
+      return impeller::CompressedTextureFamily::kASTC;
+    case kFlutterSpiGpuTextureCompressionFamilyASTCHDR:
+      return impeller::CompressedTextureFamily::kASTCHDR;
+    default:
+      return impeller::CompressedTextureFamily::kBC;
+  }
+}
+
+impeller::Context::BackendType SpiGpuToImpellerBackend(int32_t value) {
+  switch (value) {
+    case kFlutterSpiGpuBackendMetal:
+      return impeller::Context::BackendType::kMetal;
+    case kFlutterSpiGpuBackendOpenGLES:
+      return impeller::Context::BackendType::kOpenGLES;
+    case kFlutterSpiGpuBackendVulkan:
+      return impeller::Context::BackendType::kVulkan;
+    default:
+      return impeller::Context::BackendType::kVulkan;
+  }
+}
+
+impeller::TextureUsageMask SpiGpuToImpellerTextureUsage(uint32_t value) {
+  impeller::TextureUsageMask usage = {};
+  if ((value & kFlutterSpiGpuTextureUsageRenderTarget) != 0) {
+    usage |= impeller::TextureUsage::kRenderTarget;
+  }
+  if ((value & kFlutterSpiGpuTextureUsageShaderRead) != 0) {
+    usage |= impeller::TextureUsage::kShaderRead;
+  }
+  if ((value & kFlutterSpiGpuTextureUsageShaderWrite) != 0) {
+    usage |= impeller::TextureUsage::kShaderWrite;
+  }
+  return usage;
+}
+
+int32_t SpiGpuFromImpellerPixelFormat(impeller::PixelFormat value) {
+  switch (value) {
+    case impeller::PixelFormat::kUnknown:
+      return kFlutterSpiGpuPixelFormatUnknown;
+    case impeller::PixelFormat::kA8UNormInt:
+      return kFlutterSpiGpuPixelFormatA8UNormInt;
+    case impeller::PixelFormat::kR8UNormInt:
+      return kFlutterSpiGpuPixelFormatR8UNormInt;
+    case impeller::PixelFormat::kR8G8UNormInt:
+      return kFlutterSpiGpuPixelFormatR8G8UNormInt;
+    case impeller::PixelFormat::kR8G8B8A8UNormInt:
+      return kFlutterSpiGpuPixelFormatR8G8B8A8UNormInt;
+    case impeller::PixelFormat::kR8G8B8A8UNormIntSRGB:
+      return kFlutterSpiGpuPixelFormatR8G8B8A8UNormIntSRGB;
+    case impeller::PixelFormat::kB8G8R8A8UNormInt:
+      return kFlutterSpiGpuPixelFormatB8G8R8A8UNormInt;
+    case impeller::PixelFormat::kB8G8R8A8UNormIntSRGB:
+      return kFlutterSpiGpuPixelFormatB8G8R8A8UNormIntSRGB;
+    case impeller::PixelFormat::kR32G32B32A32Float:
+      return kFlutterSpiGpuPixelFormatR32G32B32A32Float;
+    case impeller::PixelFormat::kR16G16B16A16Float:
+      return kFlutterSpiGpuPixelFormatR16G16B16A16Float;
+    case impeller::PixelFormat::kB10G10R10XR:
+    case impeller::PixelFormat::kB10G10R10XRSRGB:
+    case impeller::PixelFormat::kB10G10R10A10XR:
+      return kFlutterSpiGpuPixelFormatUnknown;
+    case impeller::PixelFormat::kR32Float:
+      return kFlutterSpiGpuPixelFormatR32Float;
+    case impeller::PixelFormat::kS8UInt:
+      return kFlutterSpiGpuPixelFormatS8UInt;
+    case impeller::PixelFormat::kD24UnormS8Uint:
+      return kFlutterSpiGpuPixelFormatD24UnormS8Uint;
+    case impeller::PixelFormat::kD32FloatS8UInt:
+      return kFlutterSpiGpuPixelFormatD32FloatS8UInt;
+    case impeller::PixelFormat::kBC1RGBAUNormInt:
+      return kFlutterSpiGpuPixelFormatBC1RGBAUNormInt;
+    case impeller::PixelFormat::kBC1RGBAUNormIntSRGB:
+      return kFlutterSpiGpuPixelFormatBC1RGBAUNormIntSRGB;
+    case impeller::PixelFormat::kBC3RGBAUNormInt:
+      return kFlutterSpiGpuPixelFormatBC3RGBAUNormInt;
+    case impeller::PixelFormat::kBC3RGBAUNormIntSRGB:
+      return kFlutterSpiGpuPixelFormatBC3RGBAUNormIntSRGB;
+    case impeller::PixelFormat::kBC5RGUNormInt:
+      return kFlutterSpiGpuPixelFormatBC5RGUNormInt;
+    case impeller::PixelFormat::kBC7RGBAUNormInt:
+      return kFlutterSpiGpuPixelFormatBC7RGBAUNormInt;
+    case impeller::PixelFormat::kBC7RGBAUNormIntSRGB:
+      return kFlutterSpiGpuPixelFormatBC7RGBAUNormIntSRGB;
+    case impeller::PixelFormat::kETC2RGB8UNormInt:
+      return kFlutterSpiGpuPixelFormatETC2RGB8UNormInt;
+    case impeller::PixelFormat::kETC2RGB8UNormIntSRGB:
+      return kFlutterSpiGpuPixelFormatETC2RGB8UNormIntSRGB;
+    case impeller::PixelFormat::kETC2RGBA8UNormInt:
+      return kFlutterSpiGpuPixelFormatETC2RGBA8UNormInt;
+    case impeller::PixelFormat::kETC2RGBA8UNormIntSRGB:
+      return kFlutterSpiGpuPixelFormatETC2RGBA8UNormIntSRGB;
+    case impeller::PixelFormat::kASTC4x4LDR:
+      return kFlutterSpiGpuPixelFormatASTC4x4LDR;
+    case impeller::PixelFormat::kASTC4x4LDRSRGB:
+      return kFlutterSpiGpuPixelFormatASTC4x4LDRSRGB;
+    case impeller::PixelFormat::kASTC8x8LDR:
+      return kFlutterSpiGpuPixelFormatASTC8x8LDR;
+    case impeller::PixelFormat::kASTC8x8LDRSRGB:
+      return kFlutterSpiGpuPixelFormatASTC8x8LDRSRGB;
+    case impeller::PixelFormat::kASTC4x4HDR:
+      return kFlutterSpiGpuPixelFormatASTC4x4HDR;
+    case impeller::PixelFormat::kASTC8x8HDR:
+      return kFlutterSpiGpuPixelFormatASTC8x8HDR;
+  }
+}
+
