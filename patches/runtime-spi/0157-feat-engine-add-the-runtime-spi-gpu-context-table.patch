+  kFlutterSpiGpuPixelFormatD32FloatS8UInt = 13,
+  kFlutterSpiGpuPixelFormatBC1RGBAUNormInt = 14,
+  kFlutterSpiGpuPixelFormatBC1RGBAUNormIntSRGB = 15,
