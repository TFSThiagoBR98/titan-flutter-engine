+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+#include "impeller/renderer/testing/mocks.h"
+
+namespace flutter::testing {
+namespace {
+
+using ::testing::NiceMock;
+using ::testing::Return;
+using ::testing::ReturnRef;
+
+class TestRuntimeDelegate final : public RuntimeDelegate {
+ public:
+  std::string DefaultRouteName() override { return "/"; }
+  void ScheduleFrame(bool) override {}
+  void OnAllViewsRendered() override {}
+  void RenderScene(int64_t, FlutterSpiScene*, float) override {}
+  void UpdateSemantics(int64_t, FlutterSpiSemanticsUpdateBuilder*) override {}
+  void SetApplicationLocale(std::string) override {}
+  void SetSemanticsTreeEnabled(bool) override {}
+  void HandlePlatformMessage(std::unique_ptr<PlatformMessage>) override {}
+  FlutterSpiEngine* GetSpiEngine() override { return nullptr; }
+  std::shared_ptr<AssetManager> GetAssetManager() override { return nullptr; }
+  void OnRootIsolateCreated() override {}
+  void UpdateIsolateDescription(const std::string, int64_t) override {}
+  void SetNeedsReportTimings(bool) override {}
+  std::unique_ptr<std::vector<std::string>> ComputePlatformResolvedLocale(
+      const std::vector<std::string>&) override {
+    return std::make_unique<std::vector<std::string>>();
+  }
+  void RequestDartDeferredLibrary(intptr_t) override {}
+  std::weak_ptr<PlatformMessageHandler> GetPlatformMessageHandler()
+      const override {
+    return {};
+  }
+  void SendChannelUpdate(std::string, bool) override {}
+  double GetScaledFontSize(double value, int) const override { return value; }
+  void RequestViewFocusChange(const ViewFocusChangeRequest&) override {}
+  void ResetInternalState() override {}
+};
+
+class SpiGpuContextTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    fml::MessageLoop::EnsureInitializedForCurrentThread();
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    auto task_runner = fml::MessageLoop::GetCurrent().GetTaskRunner();
+#pragma clang diagnostic pop
+    task_runners_ = std::make_unique<TaskRunners>(
+        "spi-gpu-test", task_runner, task_runner, task_runner, task_runner);
+  }
+
+  std::unique_ptr<SpiRuntimeBackend> CreateBackend(bool impeller_enabled,
+                                                   bool flutter_gpu_enabled) {
+    FlutterSpiRuntimeTable table = {};
+    return std::unique_ptr<SpiRuntimeBackend>(new SpiRuntimeBackend(
+        delegate_, *task_runners_, table, fml::WeakPtr<IOManager>(), {}, {}, {},
+        nullptr, impeller_enabled,
+        std::shared_future<impeller::RuntimeStageBackend>{}, nullptr,
+        flutter_gpu_enabled));
+  }
+
+  void TearDown() override { SpiGpuSetDefaultContextOverride(nullptr); }
+
+  TestRuntimeDelegate delegate_;
+  std::unique_ptr<TaskRunners> task_runners_;
+};
+
+std::shared_ptr<NiceMock<impeller::testing::MockImpellerContext>>
+CreateMockContext(
+    std::shared_ptr<const impeller::Capabilities>* capabilities_out) {
+  auto context =
+      std::make_shared<NiceMock<impeller::testing::MockImpellerContext>>();
+  auto capabilities =
+      std::make_shared<NiceMock<impeller::testing::MockCapabilities>>();
+  *capabilities_out = capabilities;
+  ON_CALL(*context, GetBackendType())
+      .WillByDefault(Return(impeller::Context::BackendType::kVulkan));
+  ON_CALL(*context, GetCapabilities())
+      .WillByDefault(ReturnRef(*capabilities_out));
+  return context;
+}
+
+FlutterSpiGpuContext* GetDefaultContext(SpiRuntimeBackend* backend) {
+  FlutterSpiGpuContext* context = nullptr;
+  int32_t reason = kFlutterSpiGpuUnavailableNone;
+  EXPECT_EQ(
+      SpiGpuContextGetDefault(backend->engine_handle(), &context, &reason),
+      kFlutterSpiOk);
+  EXPECT_EQ(reason, kFlutterSpiGpuUnavailableNone);
+  return context;
+}
+
+TEST_F(SpiGpuContextTest, ContextGetDefaultUsesOverride) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(false, false);
+
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+
+  EXPECT_EQ(SpiGpuContextGetImpeller(gpu_context), context);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
+TEST_F(SpiGpuContextTest, ContextGetDefaultReportsImpellerDisabled) {
+  auto backend = CreateBackend(false, true);
+  FlutterSpiGpuContext* context = nullptr;
+  int32_t reason = kFlutterSpiGpuUnavailableNone;
+
+  EXPECT_EQ(
+      SpiGpuContextGetDefault(backend->engine_handle(), &context, &reason),
+      kFlutterSpiUnsupported);
+  EXPECT_EQ(reason, kFlutterSpiGpuUnavailableImpellerDisabled);
+  EXPECT_EQ(context, nullptr);
+}
+
+TEST_F(SpiGpuContextTest, ContextGetDefaultReportsFlutterGpuDisabled) {
+  auto backend = CreateBackend(true, false);
+  FlutterSpiGpuContext* context = nullptr;
+  int32_t reason = kFlutterSpiGpuUnavailableNone;
+
+  EXPECT_EQ(
+      SpiGpuContextGetDefault(backend->engine_handle(), &context, &reason),
+      kFlutterSpiUnsupported);
+  EXPECT_EQ(reason, kFlutterSpiGpuUnavailableFlutterGpuDisabled);
+  EXPECT_EQ(context, nullptr);
+}
+
+TEST_F(SpiGpuContextTest, ContextInfoReadsCapabilities) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto* mock_capabilities = const_cast<impeller::testing::MockCapabilities*>(
+      static_cast<const impeller::testing::MockCapabilities*>(
+          capabilities.get()));
+  ON_CALL(*mock_capabilities, GetDefaultColorFormat())
+      .WillByDefault(Return(impeller::PixelFormat::kR8G8B8A8UNormInt));
+  ON_CALL(*mock_capabilities, GetDefaultStencilFormat())
+      .WillByDefault(Return(impeller::PixelFormat::kS8UInt));
+  ON_CALL(*mock_capabilities, GetDefaultDepthStencilFormat())
+      .WillByDefault(Return(impeller::PixelFormat::kD24UnormS8Uint));
+  ON_CALL(*mock_capabilities, GetMinimumUniformAlignment())
+      .WillByDefault(Return(256u));
+  ON_CALL(*mock_capabilities, GetMaxSamplerAnisotropy())
+      .WillByDefault(Return(16u));
+  ON_CALL(*mock_capabilities, SupportsOffscreenMSAA())
+      .WillByDefault(Return(true));
+  ON_CALL(*mock_capabilities, SupportsImplicitResolvingMSAA())
+      .WillByDefault(Return(false));
+  ON_CALL(*mock_capabilities, SupportsFramebufferRenderMipmap())
+      .WillByDefault(Return(true));
+  ON_CALL(*mock_capabilities, SupportsManuallyMippedTextures())
+      .WillByDefault(Return(true));
+  ON_CALL(*mock_capabilities, SupportsTextureArrays())
+      .WillByDefault(Return(true));
+  auto backend = CreateBackend(true, true);
+  SpiGpuSetDefaultContextOverride(context);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+
+  FlutterSpiGpuContextInfo info = {.struct_size = sizeof(info)};
+  EXPECT_EQ(SpiGpuContextGetInfo(gpu_context, &info), kFlutterSpiOk);
+  EXPECT_EQ(info.backend, kFlutterSpiGpuBackendVulkan);
+  EXPECT_EQ(info.default_color_format,
+            kFlutterSpiGpuPixelFormatR8G8B8A8UNormInt);
+  EXPECT_EQ(info.default_stencil_format, kFlutterSpiGpuPixelFormatS8UInt);
+  EXPECT_EQ(info.default_depth_stencil_format,
+            kFlutterSpiGpuPixelFormatD24UnormS8Uint);
+  EXPECT_EQ(info.minimum_uniform_alignment, 256);
+  EXPECT_EQ(info.max_sampler_anisotropy, 16);
+  EXPECT_TRUE(info.supports_offscreen_msaa);
+  EXPECT_TRUE(info.supports_framebuffer_render_mipmap);
+  EXPECT_TRUE(info.supports_manually_mipped_textures);
+  EXPECT_TRUE(info.supports_texture_arrays);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
+TEST_F(SpiGpuContextTest, ContextInfoHonorsSmallStructSize) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuContextInfo info = {
+      .struct_size =
+          offsetof(FlutterSpiGpuContextInfo, backend) + sizeof(info.backend),
+      .backend = -1,
+      .default_color_format = -1,
+      .default_stencil_format = -1,
+      .default_depth_stencil_format = -1,
+      .minimum_uniform_alignment = -1,
+      .max_sampler_anisotropy = -1,
+      .supports_offscreen_msaa = true,
+      .supports_framebuffer_render_mipmap = true,
+      .supports_manually_mipped_textures = true,
+      .supports_texture_arrays = true,
+  };
+
+  EXPECT_EQ(SpiGpuContextGetInfo(gpu_context, &info), kFlutterSpiOk);
+  EXPECT_EQ(info.backend, kFlutterSpiGpuBackendVulkan);
+  EXPECT_EQ(info.default_color_format, -1);
+  EXPECT_TRUE(info.supports_texture_arrays);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
+
+TEST_F(SpiGpuContextTest, ContextCallsRejectNullAndReleasedHandles) {
+  FlutterSpiGpuContextInfo info = {.struct_size = sizeof(info)};
+  bool supported = false;
+  EXPECT_EQ(SpiGpuContextRetain(nullptr), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuContextRelease(nullptr), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuContextGetInfo(nullptr, &info), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuContextSupportsTextureCompression(nullptr, 0, &supported),
+            kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuContextSupportsTextureFormat(nullptr, 0, 0, &supported),
+            kFlutterSpiInvalidHandle);
+
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  SpiGpuSetDefaultContextOverride(CreateMockContext(&capabilities));
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* context = GetDefaultContext(backend.get());
+  EXPECT_EQ(SpiGpuContextRelease(context), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(context), kFlutterSpiInvalidHandle);
+  EXPECT_EQ(SpiGpuContextGetInfo(context, &info), kFlutterSpiInvalidHandle);
+}
+
+}  // namespace
+}  // namespace flutter::testing
