diff --git a/engine/src/flutter/runtime_spi/gpu/spi_gpu_context.cc b/engine/src/flutter/runtime_spi/gpu/spi_gpu_context.cc
new file mode 100644
index 00000000000..88b9e92ce82
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/gpu/spi_gpu_context.cc
@@ -0,0 +1,276 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/gpu/spi_gpu_context.h"
+
+#include <future>
+#include <mutex>
+
+#include "flutter/fml/make_copyable.h"
+#include "flutter/lib/ui/io_manager.h"
+#include "flutter/runtime_spi/gpu/spi_gpu_formats.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "flutter/runtime_spi/spi_runtime_backend.h"
+#include "impeller/renderer/capabilities.h"
+#include "impeller/renderer/context.h"
+
+namespace flutter {
+namespace {
+
+class SpiGpuContext final {
+ public:
+  SpiGpuContext(std::shared_ptr<impeller::Context> context,
+                fml::RefPtr<fml::TaskRunner> raster_task_runner)
+      : context_(std::move(context)),
+        raster_task_runner_(std::move(raster_task_runner)) {}
+
+  const std::shared_ptr<impeller::Context>& context() const { return context_; }
+
+  const fml::RefPtr<fml::TaskRunner>& raster_task_runner() const {
+    return raster_task_runner_;
+  }
+
+ private:
+  std::shared_ptr<impeller::Context> context_;
+  fml::RefPtr<fml::TaskRunner> raster_task_runner_;
+};
+
+SpiHandleTable<SpiGpuContext>& Contexts() {
+  return LeakedHandleTable<SpiGpuContext>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuContext* context) {
+  return reinterpret_cast<uintptr_t>(context);
+}
+
+FlutterSpiGpuContext* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuContext*>(value);
+}
+
+SpiGpuContext* FindContext(FlutterSpiGpuContext* context) {
+  return Contexts().FindRaw(HandleValue(context));
+}
+
+std::mutex& OverrideMutex() {
+  static auto* mutex = new std::mutex();
+  return *mutex;
+}
+
+std::shared_ptr<impeller::Context>& OverrideContext() {
+  static auto* context = new std::shared_ptr<impeller::Context>();
+  return *context;
+}
+
+}  // namespace
+
+void SpiGpuSetDefaultContextOverride(
+    std::shared_ptr<impeller::Context> context) {
+  std::lock_guard<std::mutex> lock(OverrideMutex());
+  OverrideContext() = std::move(context);
+}
+
+std::shared_ptr<impeller::Context> SpiGpuGetDefaultContextOverride() {
+  std::lock_guard<std::mutex> lock(OverrideMutex());
+  return OverrideContext();
+}
+
+FlutterSpiResult SpiGpuContextGetDefault(FlutterSpiEngine* engine,
+                                         FlutterSpiGpuContext** out_context,
+                                         int32_t* out_reason) {
+  if (engine == nullptr || engine->backend == nullptr ||
+      out_context == nullptr || out_reason == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_context = nullptr;
+  *out_reason = kFlutterSpiGpuUnavailableNone;
+
+  SpiRuntimeBackend* backend = engine->backend;
+  if (!backend->HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+
+  std::shared_ptr<impeller::Context> context =
+      SpiGpuGetDefaultContextOverride();
+  if (context == nullptr) {
+    if (!backend->impeller_enabled()) {
+      *out_reason = kFlutterSpiGpuUnavailableImpellerDisabled;
+      return kFlutterSpiUnsupported;
+    }
+    if (!backend->flutter_gpu_enabled()) {
+      *out_reason = kFlutterSpiGpuUnavailableFlutterGpuDisabled;
+      return kFlutterSpiUnsupported;
+    }
+
+    std::promise<std::shared_ptr<impeller::Context>> context_promise;
+    auto context_future = context_promise.get_future();
+    fml::TaskRunner::RunNowOrPostTask(
+        backend->task_runners_.GetIOTaskRunner(),
+        fml::MakeCopyable([promise = std::move(context_promise),
+                           io_manager = backend->io_manager_]() mutable {
+          promise.set_value(io_manager ? io_manager->GetImpellerContext()
+                                       : nullptr);
+        }));
+    context = context_future.get();
+    if (context == nullptr) {
+      *out_reason = kFlutterSpiGpuUnavailableNoContext;
+      return kFlutterSpiInternalError;
+    }
+  }
+
+  const uintptr_t handle = Contexts().Insert(std::make_shared<SpiGpuContext>(
+      std::move(context), backend->task_runners_.GetRasterTaskRunner()));
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_context = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuContextRetain(FlutterSpiGpuContext* context) {
+  return Contexts().Retain(HandleValue(context)) ? kFlutterSpiOk
+                                                 : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuContextRelease(FlutterSpiGpuContext* context) {
+  return Contexts().Release(HandleValue(context)) ? kFlutterSpiOk
+                                                  : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult SpiGpuContextGetInfo(FlutterSpiGpuContext* context,
+                                      FlutterSpiGpuContextInfo* info) {
+  SpiGpuContext* context_value = FindContext(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (info == nullptr || info->struct_size < sizeof(size_t)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto& impeller_context = context_value->context();
+  const auto& capabilities = impeller_context->GetCapabilities();
+  if (capabilities == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  const size_t size = info->struct_size;
+  if (size >=
+      offsetof(FlutterSpiGpuContextInfo, backend) + sizeof(info->backend)) {
+    info->backend = static_cast<int32_t>(impeller_context->GetBackendType());
+  }
+  if (size >= offsetof(FlutterSpiGpuContextInfo, default_color_format) +
+                  sizeof(info->default_color_format)) {
+    info->default_color_format =
+        SpiGpuFromImpellerPixelFormat(capabilities->GetDefaultColorFormat());
+  }
+  if (size >= offsetof(FlutterSpiGpuContextInfo, default_stencil_format) +
+                  sizeof(info->default_stencil_format)) {
+    info->default_stencil_format =
+        SpiGpuFromImpellerPixelFormat(capabilities->GetDefaultStencilFormat());
+  }
+  if (size >= offsetof(FlutterSpiGpuContextInfo, default_depth_stencil_format) +
+                  sizeof(info->default_depth_stencil_format)) {
+    info->default_depth_stencil_format = SpiGpuFromImpellerPixelFormat(
+        capabilities->GetDefaultDepthStencilFormat());
+  }
+  if (size >= offsetof(FlutterSpiGpuContextInfo, minimum_uniform_alignment) +
+                  sizeof(info->minimum_uniform_alignment)) {
+    info->minimum_uniform_alignment =
+        static_cast<int32_t>(capabilities->GetMinimumUniformAlignment());
+  }
+  if (size >= offsetof(FlutterSpiGpuContextInfo, max_sampler_anisotropy) +
+                  sizeof(info->max_sampler_anisotropy)) {
+    info->max_sampler_anisotropy =
+        static_cast<int32_t>(capabilities->GetMaxSamplerAnisotropy());
+  }
+  if (size >= offsetof(FlutterSpiGpuContextInfo, supports_offscreen_msaa) +
+                  sizeof(info->supports_offscreen_msaa)) {
+    info->supports_offscreen_msaa =
+        capabilities->SupportsOffscreenMSAA() &&
+        !capabilities->SupportsImplicitResolvingMSAA();
+  }
+  if (size >=
+      offsetof(FlutterSpiGpuContextInfo, supports_framebuffer_render_mipmap) +
+          sizeof(info->supports_framebuffer_render_mipmap)) {
+    info->supports_framebuffer_render_mipmap =
+        capabilities->SupportsFramebufferRenderMipmap();
+  }
+  if (size >=
+      offsetof(FlutterSpiGpuContextInfo, supports_manually_mipped_textures) +
+          sizeof(info->supports_manually_mipped_textures)) {
+    info->supports_manually_mipped_textures =
+        capabilities->SupportsManuallyMippedTextures();
+  }
+  if (size >= offsetof(FlutterSpiGpuContextInfo, supports_texture_arrays) +
+                  sizeof(info->supports_texture_arrays)) {
+    info->supports_texture_arrays =
+        impeller_context->GetBackendType() !=
+            impeller::Context::BackendType::kOpenGLES &&
+        capabilities->SupportsTextureArrays();
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuContextSupportsTextureCompression(
+    FlutterSpiGpuContext* context,
+    int32_t family,
+    bool* out_supported) {
+  SpiGpuContext* context_value = FindContext(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_supported == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_supported =
+      context_value->context()->GetCapabilities()->SupportsTextureCompression(
+          SpiGpuToImpellerCompressionFamily(family));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuContextSupportsTextureFormat(
+    FlutterSpiGpuContext* context,
+    int32_t format,
+    uint32_t usage,
+    bool* out_supported) {
+  SpiGpuContext* context_value = FindContext(context);
+  if (context_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_supported == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const impeller::PixelFormat impeller_format =
+      SpiGpuToImpellerPixelFormat(format);
+  if (impeller_format == impeller::PixelFormat::kUnknown) {
+    *out_supported = false;
+    return kFlutterSpiOk;
+  }
+  const bool render_target =
+      (usage & kFlutterSpiGpuTextureUsageRenderTarget) != 0;
+  const bool shader_read = (usage & kFlutterSpiGpuTextureUsageShaderRead) != 0;
+  const bool shader_write =
+      (usage & kFlutterSpiGpuTextureUsageShaderWrite) != 0;
+  if (impeller::IsCompressed(impeller_format)) {
+    *out_supported =
+        shader_read && !render_target && !shader_write &&
+        context_value->context()->GetCapabilities()->SupportsTextureCompression(
+            impeller::CompressedTextureFamilyForFormat(impeller_format));
+    return kFlutterSpiOk;
+  }
+  *out_supported = true;
+  return kFlutterSpiOk;
+}
+
+std::shared_ptr<impeller::Context> SpiGpuContextGetImpeller(
+    FlutterSpiGpuContext* context) {
+  SpiGpuContext* context_value = FindContext(context);
+  return context_value == nullptr ? nullptr : context_value->context();
+}
+
+fml::RefPtr<fml::TaskRunner> SpiGpuContextGetRasterTaskRunner(
+    FlutterSpiGpuContext* context) {
+  SpiGpuContext* context_value = FindContext(context);
+  return context_value == nullptr ? nullptr
+                                  : context_value->raster_task_runner();
+}
+
+}  // namespace flutter
