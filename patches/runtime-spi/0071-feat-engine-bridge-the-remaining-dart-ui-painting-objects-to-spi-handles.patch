+constexpr FlutterSpiRect kRect = {
+    .left = 1.0f, .top = 2.0f, .right = 30.0f, .bottom = 40.0f};
+constexpr FlutterSpiPaint kPaint = {
+    .struct_size = sizeof(FlutterSpiPaint),
+    .color = {.red = 0.1f,
+              .green = 0.2f,
+              .blue = 0.3f,
+              .alpha = 0.4f,
+              .color_space = kFlutterSpiColorSpaceSRGB},
+    .blend_mode = kFlutterSpiBlendModeSrcOver,
+    .style = kFlutterSpiPaintStyleFill,
+    .stroke_width = 1.0f,
+    .stroke_cap = kFlutterSpiStrokeCapButt,
+    .stroke_join = kFlutterSpiStrokeJoinMiter,
+    .stroke_miter = 4.0f,
+    .anti_alias = true,
+    .invert_colors = false,
+};
+
+class SpiInternalBridgesTest : public ::testing::Test {
+ protected:
+  const FlutterSpiSceneApi* api() const { return SpiSceneApi(); }
+
+  sk_sp<DisplayList> FinishPicture(FlutterSpiPictureRecorder* recorder) {
+    FlutterSpiPicture* picture = nullptr;
+    EXPECT_EQ(api()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+    const DisplayList* display_list =
+        SpiPictureDisplayListForTesting(picture);
+    EXPECT_NE(display_list, nullptr);
+    sk_sp<DisplayList> result = sk_ref_sp(display_list);
+    EXPECT_EQ(api()->picture_release(picture), kFlutterSpiOk);
+    return result;
+  }
+
+  FlutterSpiPictureRecorder* CreateRecorder() {
+    FlutterSpiPictureRecorder* recorder = nullptr;
+    EXPECT_EQ(api()->recorder_create(nullptr, &kRect, &recorder),
+              kFlutterSpiOk);
+    return recorder;
+  }
+};
+
+TEST_F(SpiInternalBridgesTest, ShaderHandleMatchesDirectColorSource) {
+  const auto shader = DlColorSource::MakeLinear(
+      {1.0f, 2.0f}, {30.0f, 40.0f}, 2,
+      std::array<DlColor, 2>{DlColor::kRed(), DlColor::kBlue()}.data(),
+      nullptr, DlTileMode::kClamp, nullptr);
+  FlutterSpiShader* shader_handle = SpiShaderFromColorSource(shader);
+  ASSERT_NE(shader_handle, nullptr);
+
+  FlutterSpiPaint paint = kPaint;
+  paint.shader = shader_handle;
+  FlutterSpiPictureRecorder* recorder = CreateRecorder();
+  ASSERT_EQ(api()->canvas_draw_rect(recorder, &kRect, &paint), kFlutterSpiOk);
+  const auto actual = FinishPicture(recorder);
+
+  DlPaint expected_paint = ToDlPaint(kPaint);
+  expected_paint.setColorSource(shader);
+  DisplayListBuilder expected_builder(DlRect::MakeLTRB(1, 2, 30, 40));
+  expected_builder.DrawRect(DlRect::MakeLTRB(1, 2, 30, 40), expected_paint);
+  EXPECT_TRUE(actual->Equals(expected_builder.Build()));
+}
+
+TEST_F(SpiInternalBridgesTest, ColorFilterHandleMatchesDirectColorFilter) {
+  const auto filter = DlColorFilter::MakeSrgbToLinearGamma();
+  FlutterSpiColorFilter* filter_handle = SpiColorFilterFromDl(filter);
+  ASSERT_NE(filter_handle, nullptr);
+
+  FlutterSpiPaint paint = kPaint;
+  paint.color_filter = filter_handle;
+  FlutterSpiPictureRecorder* recorder = CreateRecorder();
+  ASSERT_EQ(api()->canvas_draw_rect(recorder, &kRect, &paint), kFlutterSpiOk);
+  const auto actual = FinishPicture(recorder);
+
+  DlPaint expected_paint = ToDlPaint(kPaint);
+  expected_paint.setColorFilter(filter);
+  DisplayListBuilder expected_builder(DlRect::MakeLTRB(1, 2, 30, 40));
+  expected_builder.DrawRect(DlRect::MakeLTRB(1, 2, 30, 40), expected_paint);
+  EXPECT_TRUE(actual->Equals(expected_builder.Build()));
+}
+
+TEST_F(SpiInternalBridgesTest, ImageFilterHandleMatchesDirectImageFilter) {
+  const auto filter = DlImageFilter::MakeBlur(2.0f, 3.0f, DlTileMode::kDecal);
+  FlutterSpiImageFilter* filter_handle = SpiImageFilterFromDl(filter);
+  ASSERT_NE(filter_handle, nullptr);
+
+  FlutterSpiPaint paint = kPaint;
+  paint.image_filter = filter_handle;
+  FlutterSpiPictureRecorder* recorder = CreateRecorder();
+  ASSERT_EQ(api()->canvas_draw_rect(recorder, &kRect, &paint), kFlutterSpiOk);
+  const auto actual = FinishPicture(recorder);
+
+  DlPaint expected_paint = ToDlPaint(kPaint);
+  expected_paint.setImageFilter(filter);
+  DisplayListBuilder expected_builder(DlRect::MakeLTRB(1, 2, 30, 40));
+  expected_builder.DrawRect(DlRect::MakeLTRB(1, 2, 30, 40), expected_paint);
+  EXPECT_TRUE(actual->Equals(expected_builder.Build()));
+}
+
+TEST_F(SpiInternalBridgesTest, PathHandleMatchesDirectPath) {
+  const DlPath path = DlPath::MakeRoundRect(
+      DlRoundRect::MakeRectXY(DlRect::MakeLTRB(1, 2, 30, 40), 4.0f, 5.0f));
+  FlutterSpiPath* path_handle = SpiPathFromDlPath(path);
+  ASSERT_NE(path_handle, nullptr);
+
+  FlutterSpiPictureRecorder* recorder = CreateRecorder();
+  ASSERT_EQ(api()->canvas_draw_path(recorder, path_handle, &kPaint),
+            kFlutterSpiOk);
+  const auto actual = FinishPicture(recorder);
+
+  DisplayListBuilder expected_builder(DlRect::MakeLTRB(1, 2, 30, 40));
+  expected_builder.DrawPath(path, ToDlPaint(kPaint));
+  EXPECT_TRUE(actual->Equals(expected_builder.Build()));
+}
+
+sk_sp<DlImage> MakeTestImage() {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(4, 3))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(SK_ColorBLUE);
+  bitmap.setImmutable();
+  return DlImageSkia::Make(SkImages::RasterFromBitmap(bitmap));
+}
+
+TEST_F(SpiInternalBridgesTest, ImageHandleMatchesDirectImage) {
+  const sk_sp<DlImage> image = MakeTestImage();
+  ASSERT_NE(image, nullptr);
+  FlutterSpiImage* image_handle = SpiImageFromDlImage(image);
+  ASSERT_NE(image_handle, nullptr);
+
+  FlutterSpiPictureRecorder* recorder = CreateRecorder();
+  ASSERT_EQ(SpiCanvasDrawImage(recorder, image_handle, {10.0f, 12.0f},
+                               kFlutterSpiFilterQualityLow, nullptr),
+            kFlutterSpiOk);
+  const auto actual = FinishPicture(recorder);
+
+  DisplayListBuilder expected_builder(DlRect::MakeLTRB(1, 2, 30, 40));
+  expected_builder.DrawImage(image, {10.0f, 12.0f}, DlImageSampling::kLinear,
+                             nullptr);
+  EXPECT_TRUE(actual->Equals(expected_builder.Build()));
+}
+
+TEST_F(SpiInternalBridgesTest, VerticesHandleMatchesDirectVertices) {
+  const std::array<DlPoint, 3> positions = {{{1.0f, 2.0f},
+                                             {30.0f, 2.0f},
+                                             {1.0f, 40.0f}}};
+  const auto vertices = DlVertices::Make(DlVertexMode::kTriangles,
+                                         positions.size(), positions.data(),
+                                         nullptr, nullptr);
+  FlutterSpiVertices* vertices_handle = SpiVerticesFromDl(vertices);
+  ASSERT_NE(vertices_handle, nullptr);
+
+  FlutterSpiPictureRecorder* recorder = CreateRecorder();
+  ASSERT_EQ(CanvasDrawVertices(recorder, vertices_handle,
+                               kFlutterSpiBlendModeSrcOver, &kPaint),
+            kFlutterSpiOk);
+  const auto actual = FinishPicture(recorder);
+
+  DisplayListBuilder expected_builder(DlRect::MakeLTRB(1, 2, 30, 40));
+  expected_builder.DrawVertices(vertices, DlBlendMode::kSrcOver,
+                                ToDlPaint(kPaint));
+  EXPECT_TRUE(actual->Equals(expected_builder.Build()));
+}
+
+TEST_F(SpiInternalBridgesTest, PictureBridgeReturnsTheOriginalDisplayList) {
+  FlutterSpiPictureRecorder* recorder = CreateRecorder();
+  ASSERT_EQ(api()->canvas_draw_rect(recorder, &kRect, &kPaint), kFlutterSpiOk);
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(api()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+
+  const DisplayList* display_list = SpiPictureDisplayList(picture);
+  ASSERT_NE(display_list, nullptr);
+  EXPECT_TRUE(display_list->Equals(*SpiPictureSharedDisplayList(picture)));
+  EXPECT_EQ(api()->picture_release(picture), kFlutterSpiOk);
+}
