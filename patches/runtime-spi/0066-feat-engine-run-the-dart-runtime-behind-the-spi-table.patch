+char* CopyString(const std::string& value) {
+  const size_t size = value.size() + 1;
+  auto* result = static_cast<char*>(std::malloc(size));
+  if (result == nullptr) {
+    return nullptr;
+  }
+  std::memcpy(result, value.c_str(), size);
+  return result;
+}
+
+void FreeString(void*, char* string) {
+  std::free(string);
+}
+
+std::unique_ptr<const fml::Mapping> MakeMapping(FlutterSpiMapping mapping) {
+  return std::make_unique<fml::NonOwnedMapping>(
+      mapping.data, mapping.size,
+      [release = mapping.release,
+       release_user_data = mapping.release_user_data](const uint8_t*, size_t) {
+        if (release != nullptr) {
+          release(release_user_data);
+        }
+      });
+}
