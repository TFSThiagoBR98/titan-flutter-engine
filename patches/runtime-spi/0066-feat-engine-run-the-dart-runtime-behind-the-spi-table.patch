+std::unique_ptr<std::vector<std::string>>
+DartRuntimeDelegateBridge::ComputePlatformResolvedLocale(
+    const std::vector<std::string>& supported_locale_data) {
+  if (!HasEngineApi() ||
+      engine_api_->compute_platform_resolved_locale == nullptr) {
+    return nullptr;
+  }
+  std::vector<const char*> supported;
+  supported.reserve(supported_locale_data.size());
+  for (const std::string& locale : supported_locale_data) {
+    supported.push_back(locale.c_str());
+  }
+  char** resolved = nullptr;
+  size_t resolved_count = 0;
+  if (engine_api_->compute_platform_resolved_locale(
+          engine_, supported.data(), supported.size(), &resolved,
+          &resolved_count) != kFlutterSpiOk) {
+    return nullptr;
+  }
+  auto result = std::make_unique<std::vector<std::string>>();
+  result->reserve(resolved_count);
+  for (size_t index = 0; index < resolved_count; index++) {
+    result->emplace_back(resolved[index] == nullptr ? "" : resolved[index]);
+  }
+  if (engine_api_->free_string_list != nullptr) {
+    engine_api_->free_string_list(engine_, resolved, resolved_count);
+  }
+  return result;
+}
