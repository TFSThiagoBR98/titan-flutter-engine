+TEST(FlutterDartRuntimeTest, PlatformMessageRepliesReachTheEngine) {
+  bool destroyed = false;
+  auto runtime = CreateRuntime(&destroyed);
+  ApiCapture capture;
+  g_api_capture = &capture;
+  FlutterSpiEngineApi api = MakeEngineApi();
+  FlutterSpiEngine engine;
+  ASSERT_EQ(runtime->table().start(runtime->table().user_data, &api, &engine),
+            kFlutterSpiOk);
+  auto response = fml::AdoptRef(new CapturingResponse());
+
+  runtime->delegate_bridge().HandlePlatformMessage(
+      std::make_unique<PlatformMessage>(
+          "test", fml::MallocMapping::Copy(nullptr, 0), response));
+
+  ASSERT_TRUE(response->completed);
+  EXPECT_EQ(response->bytes, std::vector<uint8_t>({'o', 'k'}));
+  g_api_capture = nullptr;
+}
