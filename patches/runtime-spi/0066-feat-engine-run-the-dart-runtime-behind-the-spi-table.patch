+  ASSERT_EQ(runtime->table().start(runtime->table().user_data, &api, &engine),
+            kFlutterSpiOk);
+
+  FlutterSpiFrameInfo frame_info = {
+      .struct_size = sizeof(FlutterSpiFrameInfo),
+      .frame_token = 42,
+      .frame_number = 7,
+      .deadline_ns = 100,
+  };
+  runtime->table().begin_frame(runtime->table().user_data, &frame_info);
+  runtime->delegate_bridge().Render(
+      1, std::make_unique<LayerTree>(std::make_shared<ContainerLayer>(),
+                                     DlISize(10, 10)),
+      2.0f);
+
+  EXPECT_EQ(capture.submitted_frame_count, 1u);
+  EXPECT_EQ(capture.submitted_frame_token, 42u);
+  g_api_capture = nullptr;
+}
