+void DartRuntimeDelegateBridge::HandlePlatformMessage(
+    std::unique_ptr<PlatformMessage> message) {
+  if (!HasEngineApi() || engine_api_->send_platform_message == nullptr ||
+      message == nullptr) {
+    return;
+  }
+  auto* context = !message->response()
+                      ? nullptr
+                      : new EngineReplyContext{message->response()};
+  const FlutterSpiResult result = engine_api_->send_platform_message(
+      engine_, message->channel().c_str(), message->data().GetMapping(),
+      message->data().GetSize(), context == nullptr ? nullptr
+                                                    : CompleteEngineReply,
+      context);
+  if (result != kFlutterSpiOk && context != nullptr) {
+    CompleteEngineReply(context, nullptr, 0);
+  }
+}
