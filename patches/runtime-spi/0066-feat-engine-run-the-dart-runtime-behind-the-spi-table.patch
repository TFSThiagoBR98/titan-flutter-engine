+class SpiRuntimePlatformMessageResponse final
+    : public PlatformMessageResponse {
+ public:
+  SpiRuntimePlatformMessageResponse(const FlutterSpiEngineApi* engine_api,
+                                    FlutterSpiEngine* engine,
+                                    FlutterSpiResponseHandle* response)
+      : engine_api_(engine_api), engine_(engine), response_(response) {}
+
+  void Complete(std::unique_ptr<fml::Mapping> data) override {
+    if (data == nullptr || data->GetSize() == 0) {
+      CompleteEmpty();
+      return;
+    }
+    if (engine_api_ != nullptr && engine_api_->respond != nullptr) {
+      engine_api_->respond(response_, data->GetMapping(), data->GetSize());
+    }
+  }
+
+  void CompleteEmpty() override {
+    if (engine_api_ != nullptr && engine_api_->respond != nullptr) {
+      engine_api_->respond(response_, nullptr, 0);
+    }
+  }
+
+ private:
+  const FlutterSpiEngineApi* engine_api_;
+  FlutterSpiEngine* engine_;
+  FlutterSpiResponseHandle* response_;
+};
