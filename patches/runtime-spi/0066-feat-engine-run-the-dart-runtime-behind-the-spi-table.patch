+class KeyEventResponse final : public PlatformMessageResponse {
+ public:
+  explicit KeyEventResponse(bool* handled) : handled_(handled) {}
+
+  void Complete(std::unique_ptr<fml::Mapping> data) override {
+    *handled_ = data != nullptr && data->GetSize() != 0 &&
+                data->GetMapping()[0] != 0;
+  }
+
+  void CompleteEmpty() override { *handled_ = false; }
+
+ private:
+  bool* handled_;
+};
