+ViewportMetrics ConvertMetrics(const FlutterSpiViewMetrics& metrics) {
+  ViewportMetrics result;
+  result.device_pixel_ratio = metrics.device_pixel_ratio;
+  result.physical_width = metrics.physical_width;
+  result.physical_height = metrics.physical_height;
+  result.physical_padding_top = metrics.physical_padding_top;
+  result.physical_padding_right = metrics.physical_padding_right;
+  result.physical_padding_bottom = metrics.physical_padding_bottom;
+  result.physical_padding_left = metrics.physical_padding_left;
+  result.physical_view_inset_top = metrics.physical_view_inset_top;
+  result.physical_view_inset_right = metrics.physical_view_inset_right;
+  result.physical_view_inset_bottom = metrics.physical_view_inset_bottom;
+  result.physical_view_inset_left = metrics.physical_view_inset_left;
+  return result;
+}
