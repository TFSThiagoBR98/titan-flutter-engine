+
+void FlutterDartRuntime::RegisterServiceHandler(
+    const FlutterSpiServiceHandler* handler) {
+  if (handler == nullptr || service_protocol_handlers_.contains(handler)) {
+    return;
+  }
+  DartVM* vm = controller_->GetDartVM();
+  if (vm == nullptr) {
+    return;
+  }
+  auto service_protocol = vm->GetServiceProtocol();
+  if (service_protocol == nullptr) {
+    return;
+  }
+  ServiceProtocol::Handler::Description description(GetMainPort(),
+                                                    GetIsolateName());
+  auto service_handler =
+      std::make_unique<ServiceProtocolHandler>(handler, description);
+  auto* service_handler_ptr = service_handler.get();
+  service_protocol->AddHandler(service_handler_ptr, description);
+  service_protocol_handlers_.emplace(handler, std::move(service_handler));
+}
+
+void FlutterDartRuntime::UnregisterServiceHandler(
+    const FlutterSpiServiceHandler* handler) {
+  auto found = service_protocol_handlers_.find(handler);
+  if (found == service_protocol_handlers_.end()) {
+    return;
+  }
+  if (DartVM* vm = controller_->GetDartVM(); vm != nullptr) {
+    if (auto service_protocol = vm->GetServiceProtocol();
+        service_protocol != nullptr) {
+      service_protocol->RemoveHandler(found->second.get());
+    }
+  }
+  service_protocol_handlers_.erase(found);
+}
+
+void FlutterDartRuntime::RefreshServiceHandlerDescription(
+    const FlutterSpiServiceHandler* handler) {
+  auto found = service_protocol_handlers_.find(handler);
+  if (found == service_protocol_handlers_.end()) {
+    return;
+  }
+  ServiceProtocol::Handler::Description description(GetMainPort(),
+                                                    GetIsolateName());
+  found->second->SetDescription(description);
+  if (DartVM* vm = controller_->GetDartVM(); vm != nullptr) {
+    if (auto service_protocol = vm->GetServiceProtocol();
+        service_protocol != nullptr) {
+      service_protocol->SetHandlerDescription(found->second.get(), description);
+    }
+  }
+}
