+class FlutterDartRuntime::ServiceProtocolHandler final
+    : public ServiceProtocol::Handler {
+ public:
+  ServiceProtocolHandler(const FlutterSpiServiceHandler* handler,
+                         Description description)
+      : handler_(handler), description_(std::move(description)) {}
+
+  fml::RefPtr<fml::TaskRunner> GetServiceProtocolHandlerTaskRunner(
+      std::string_view) const override {
+    return nullptr;
+  }
+
+  Description GetServiceProtocolDescription() const override {
+    return description_;
+  }
+
+  bool HandleServiceProtocolMessage(
+      std::string_view method,
+      const ServiceProtocolMap& params,
+      rapidjson::Document* response) override {
+    if (handler_ == nullptr || handler_->handle == nullptr ||
+        response == nullptr) {
+      return false;
+    }
+    std::string method_string(method);
+    std::vector<const char*> keys;
+    std::vector<const char*> values;
+    keys.reserve(params.size());
+    values.reserve(params.size());
+    for (const auto& [key, value] : params) {
+      keys.push_back(key.data());
+      values.push_back(value.data());
+    }
+    char* json = nullptr;
+    const bool handled = handler_->handle(
+        handler_->user_data, method_string.c_str(), keys.data(), values.data(),
+        params.size(), &json);
+    if (!handled || json == nullptr) {
+      return false;
+    }
+    response->Parse(json);
+    const bool valid_response = !response->HasParseError() &&
+                                response->IsObject();
+    if (handler_->free_json != nullptr) {
+      handler_->free_json(handler_->user_data, json);
+    }
+    return valid_response;
+  }
+
+  void SetDescription(Description description) {
+    description_ = std::move(description);
+  }
+
+ private:
+  const FlutterSpiServiceHandler* handler_;
+  Description description_;
+};
