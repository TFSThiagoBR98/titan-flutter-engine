+void DartRuntimeDelegateBridge::Render(
+    int64_t view_id,
+    std::unique_ptr<LayerTree> layer_tree,
+    float device_pixel_ratio) {
+  if (!HasEngineApi() || engine_api_->submit_frame == nullptr) {
+    return;
+  }
+  FlutterSpiScene* scene = nullptr;
+  if (SpiSceneFromLayerTree(std::move(layer_tree), &scene) != kFlutterSpiOk) {
+    return;
+  }
+  const FlutterSpiResult result = engine_api_->submit_frame(
+      engine_, view_id, frame_token_, scene, device_pixel_ratio);
+  if (result != kFlutterSpiOk && engine_api_->scene_release != nullptr) {
+    engine_api_->scene_release(scene);
+  }
