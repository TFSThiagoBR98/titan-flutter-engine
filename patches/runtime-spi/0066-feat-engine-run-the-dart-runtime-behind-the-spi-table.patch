+class TrackingRuntimeController final : public RuntimeController {
+ public:
+  TrackingRuntimeController(RuntimeDelegate& delegate,
+                            const TaskRunners& task_runners,
+                            bool* destroyed)
+      : RuntimeController(delegate, task_runners), destroyed_(destroyed) {}
+
+  ~TrackingRuntimeController() override { *destroyed_ = true; }
+
+  bool DispatchPlatformMessage(
+      std::unique_ptr<PlatformMessage> message) override {
+    last_platform_message = std::move(message);
+    return true;
+  }
+
+  bool NotifyIdle(fml::TimeDelta) override {
+    idle_notification_count++;
+    return true;
+  }
+
+  bool IsRootIsolateRunning() const override { return true; }
+
+  size_t idle_notification_count = 0;
+  std::unique_ptr<PlatformMessage> last_platform_message;
+
+ private:
+  bool* destroyed_;
+};
+
+class CapturingResponse final : public PlatformMessageResponse {
+ public:
+  void Complete(std::unique_ptr<fml::Mapping> data) override {
+    if (data != nullptr) {
+      bytes.assign(data->GetMapping(), data->GetMapping() + data->GetSize());
+    }
+    completed = true;
+  }
+
+  void CompleteEmpty() override {
+    bytes.clear();
+    completed = true;
+  }
+
+  bool completed = false;
+  std::vector<uint8_t> bytes;
+};
+
+struct ApiCapture {
+  uint64_t submitted_frame_token = 0;
+  size_t submitted_frame_count = 0;
+  size_t frames_done_count = 0;
+  size_t response_count = 0;
+  std::vector<uint8_t> response_bytes;
+};
+
+ApiCapture* g_api_capture = nullptr;
+
+FlutterSpiResult CaptureSubmitFrame(FlutterSpiEngine*,
+                                    int64_t,
+                                    uint64_t frame_token,
+                                    FlutterSpiScene* scene,
+                                    double) {
+  g_api_capture->submitted_frame_token = frame_token;
+  g_api_capture->submitted_frame_count++;
+  (void)scene;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CaptureFramesDone(FlutterSpiEngine*) {
+  g_api_capture->frames_done_count++;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CaptureRespond(FlutterSpiResponseHandle*,
+                                const uint8_t* data,
+                                size_t data_size) {
+  g_api_capture->response_count++;
+  if (data_size == 0) {
+    g_api_capture->response_bytes.clear();
+  } else {
+    g_api_capture->response_bytes.assign(data, data + data_size);
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CaptureSendPlatformMessage(
+    FlutterSpiEngine*,
+    const char*,
+    const uint8_t*,
+    size_t,
+    void (*on_reply)(void*, const uint8_t*, size_t),
+    void* reply_user_data) {
+  const uint8_t reply[] = {'o', 'k'};
+  if (on_reply != nullptr) {
+    on_reply(reply_user_data, reply, sizeof(reply));
+  }
+  return kFlutterSpiOk;
+}
+
+std::unique_ptr<FlutterDartRuntime> CreateRuntime(bool* destroyed) {
+  auto delegate_bridge = std::make_unique<DartRuntimeDelegateBridge>();
+  auto controller = std::make_unique<TrackingRuntimeController>(
+      *delegate_bridge, TaskRunners("FlutterDartRuntimeTest", nullptr, nullptr,
+                                    nullptr, nullptr),
+      destroyed);
+  return std::make_unique<FlutterDartRuntime>(std::move(controller),
+                                              std::move(delegate_bridge));
+}
+
+FlutterSpiEngineApi MakeEngineApi() {
+  return {
+      .struct_size = sizeof(FlutterSpiEngineApi),
+      .version_major = FLUTTER_SPI_VERSION_MAJOR,
+      .version_minor = FLUTTER_SPI_VERSION_MINOR,
+      .submit_frame = CaptureSubmitFrame,
+      .frames_done = CaptureFramesDone,
+      .send_platform_message = CaptureSendPlatformMessage,
+      .respond = CaptureRespond,
+  };
+}
