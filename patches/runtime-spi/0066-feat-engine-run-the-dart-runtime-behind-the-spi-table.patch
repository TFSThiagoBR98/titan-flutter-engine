+
+void FlutterDartRuntime::PointerEventsThunk(void* user_data,
+                                            const FlutterSpiPointerEvent* events,
+                                            size_t count) {
+  if (count != 0 && events == nullptr) {
+    return;
+  }
+  PointerDataPacket packet(count);
+  for (size_t index = 0; index < count; index++) {
+    PointerData data;
+    data.Clear();
+    data.view_id = events[index].view_id;
+    data.time_stamp = events[index].timestamp_us;
+    data.change = static_cast<PointerData::Change>(events[index].change);
+    data.kind = static_cast<PointerData::DeviceKind>(events[index].device_kind);
+    data.device = events[index].device;
+    data.pointer_identifier = events[index].pointer_id;
+    data.physical_x = events[index].physical_x;
+    data.physical_y = events[index].physical_y;
+    data.buttons = events[index].buttons;
+    data.scroll_delta_x = events[index].scroll_delta_x;
+    data.scroll_delta_y = events[index].scroll_delta_y;
+    data.pressure = events[index].pressure;
+    packet.SetPointerData(index, data);
+  }
+  FromUserData(user_data)->controller_->DispatchPointerDataPacket(packet);
+}
