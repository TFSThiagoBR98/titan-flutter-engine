+TEST(FlutterDartRuntimeTest, IncomingPlatformMessageIsAnsweredThroughRespond) {
+  bool destroyed = false;
+  auto runtime = CreateRuntime(&destroyed);
+  ApiCapture capture;
+  g_api_capture = &capture;
+  FlutterSpiEngineApi api = MakeEngineApi();
+  FlutterSpiEngine engine;
+  ASSERT_EQ(runtime->table().start(runtime->table().user_data, &api, &engine),
+            kFlutterSpiOk);
+  auto& controller =
+      static_cast<TrackingRuntimeController&>(runtime->controller());
+  FlutterSpiResponseHandle response;
+  const uint8_t data[] = {'h', 'i'};
+  FlutterSpiPlatformMessage message = {
+      .struct_size = sizeof(FlutterSpiPlatformMessage),
+      .channel = "test",
+      .data = data,
+      .data_size = sizeof(data),
+      .response = &response,
+  };
+
+  runtime->table().platform_message(runtime->table().user_data, &message);
+
+  ASSERT_NE(controller.last_platform_message, nullptr);
+  const uint8_t reply[] = {'o', 'k'};
+  controller.last_platform_message->response()->Complete(
+      std::make_unique<fml::MallocMapping>(
+          fml::MallocMapping::Copy(reply, sizeof(reply))));
+
+  EXPECT_EQ(capture.response_count, 1u);
+  EXPECT_EQ(capture.response_bytes, std::vector<uint8_t>({'o', 'k'}));
+
+  FlutterSpiResponseHandle empty_response;
+  message.response = &empty_response;
+  runtime->table().platform_message(runtime->table().user_data, &message);
+
+  ASSERT_NE(controller.last_platform_message, nullptr);
+  controller.last_platform_message->response()->CompleteEmpty();
+
+  EXPECT_EQ(capture.response_count, 2u);
+  EXPECT_TRUE(capture.response_bytes.empty());
+  g_api_capture = nullptr;
+}
