+bool FlutterDartRuntime::KeyEventThunk(void* user_data,
+                                       const FlutterSpiKeyEvent* event) {
+  if (event == nullptr) {
+    return false;
+  }
+  const std::string character = event->character == nullptr ? "" : event->character;
+  const uint64_t character_size = character.size();
+  std::vector<uint8_t> bytes(sizeof(character_size) + sizeof(KeyData) +
+                             character.size());
+  KeyData key_data;
+  key_data.Clear();
+  key_data.timestamp = event->timestamp_us;
+  key_data.type = static_cast<KeyEventType>(event->type);
+  key_data.physical = event->physical;
+  key_data.logical = event->logical;
+  key_data.synthesized = event->synthesized ? 1 : 0;
+  key_data.device_type = static_cast<KeyEventDeviceType>(event->device_type);
+  std::memcpy(bytes.data(), &character_size, sizeof(character_size));
+  std::memcpy(bytes.data() + sizeof(character_size), &key_data,
+              sizeof(key_data));
+  std::memcpy(bytes.data() + sizeof(character_size) + sizeof(key_data),
+              character.data(), character.size());
+  bool handled = false;
+  auto response = fml::AdoptRef(new KeyEventResponse(&handled));
+  auto message = std::make_unique<PlatformMessage>(
+      kKeyDataChannel, fml::MallocMapping::Copy(bytes.data(), bytes.size()),
+      response);
+  FromUserData(user_data)->controller_->DispatchPlatformMessage(
+      std::move(message));
+  return handled;
+}
+
+void FlutterDartRuntime::PlatformMessageThunk(
+    void* user_data,
+    const FlutterSpiPlatformMessage* message) {
+  if (message == nullptr || message->channel == nullptr) {
+    return;
+  }
+  auto* runtime = FromUserData(user_data);
+  fml::RefPtr<PlatformMessageResponse> response;
+  if (message->response != nullptr) {
+    response = fml::AdoptRef(new SpiRuntimePlatformMessageResponse(
+        runtime->delegate_bridge_->engine_api(),
+        runtime->delegate_bridge_->engine(), message->response));
+  }
+  runtime->controller_->DispatchPlatformMessage(std::make_unique<PlatformMessage>(
+      message->channel,
+      fml::MallocMapping::Copy(message->data, message->data_size), response));
+}
