+  auto* runtime = FromUserData(user_data);
+  runtime->delegate_bridge_->SetFrameToken(frame_info->frame_token);
+  runtime->controller_->BeginFrame(
+      fml::TimePoint::FromEpochDelta(
+          fml::TimeDelta::FromNanoseconds(frame_info->deadline_ns)),
+      frame_info->frame_number);
