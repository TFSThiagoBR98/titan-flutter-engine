+bool FlutterDartRuntime::LaunchRootIsolateThunk(void* user_data,
+                                                void* run_configuration) {
+  auto* runtime = FromUserData(user_data);
+  auto* configuration = static_cast<RunConfiguration*>(run_configuration);
+  if (runtime == nullptr || configuration == nullptr) {
+    return false;
+  }
+  std::shared_ptr<NativeAssetsManager> native_assets_manager;
+  if (auto asset_manager = configuration->GetAssetManager()) {
+    native_assets_manager = std::make_shared<NativeAssetsManager>();
+    native_assets_manager->RegisterNativeAssets(asset_manager);
+  }
+  return runtime->LaunchRootIsolate(
+      runtime->launch_settings_, runtime->root_isolate_create_callback_,
+      configuration->GetEntrypoint(), configuration->GetEntrypointLibrary(),
+      configuration->GetEntrypointArgs(),
+      configuration->TakeIsolateConfiguration(),
+      std::move(native_assets_manager), runtime->engine_id_);
+}
