 };
 
 class SemanticsCapture final {
@@ -650,6 +657,72 @@ TEST_F(SpiConformance, PointerEventsReachRuntime) {
   EXPECT_EQ(runtime_->pointer_events[0].physical_y, 29.0);
 }
 
+TEST_F(SpiConformance, PointerEventFlushesRuntimeMicrotasks) {
+  StartShell();
+  auto packet = std::make_unique<PointerDataPacket>(1);
+  packet->SetPointerData(0, PointerData{
+                                .change = PointerData::Change::kDown,
+                                .view_id = kImplicitViewId,
+                            });
+
+  DispatchPointerData(shell_.get(), std::move(packet));
+  FlushUi();
+
+  EXPECT_EQ(runtime_->flush_microtask_count, 1u);
+}
+
+TEST_F(SpiConformance, DeferredLibraryReachesRuntime) {
+  constexpr uint8_t kSnapshotData[] = {1, 2, 3};
+  constexpr uint8_t kSnapshotInstructions[] = {4, 5};
+  StartShell();
+
+  auto snapshot_data = std::make_unique<fml::MallocMapping>(
+      fml::MallocMapping::Copy(kSnapshotData, sizeof(kSnapshotData)));
+  auto snapshot_instructions = std::make_unique<fml::MallocMapping>(
+      fml::MallocMapping::Copy(kSnapshotInstructions,
+                               sizeof(kSnapshotInstructions)));
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    shell_->GetEngine()->LoadDartDeferredLibrary(
+        42, std::move(snapshot_data), std::move(snapshot_instructions));
+  });
+  FlushUi();
+
+  ASSERT_TRUE(runtime_->has_deferred_library);
+  EXPECT_EQ(runtime_->deferred_library_id, 42);
+  ASSERT_EQ(runtime_->deferred_snapshot_data.size, sizeof(kSnapshotData));
+  EXPECT_EQ(std::memcmp(runtime_->deferred_snapshot_data.data, kSnapshotData,
+                        sizeof(kSnapshotData)),
+            0);
+  ASSERT_EQ(runtime_->deferred_snapshot_instructions.size,
+            sizeof(kSnapshotInstructions));
+  EXPECT_EQ(std::memcmp(runtime_->deferred_snapshot_instructions.data,
+                        kSnapshotInstructions,
+                        sizeof(kSnapshotInstructions)),
+            0);
+
+  ASSERT_NE(runtime_->deferred_snapshot_data.release, nullptr);
+  ASSERT_NE(runtime_->deferred_snapshot_instructions.release, nullptr);
+  runtime_->deferred_snapshot_data.release(
+      runtime_->deferred_snapshot_data.release_user_data);
+  runtime_->deferred_snapshot_instructions.release(
+      runtime_->deferred_snapshot_instructions.release_user_data);
+}
+
+TEST_F(SpiConformance, ServiceIdIsPublishedOnRun) {
+  constexpr char kServiceId[] = "test-service-id";
+  runtime_->root_isolate_service_id = kServiceId;
+
+  auto handler = std::make_shared<ReplyingPlatformMessageHandler>();
+  StartShellWithHandler(handler);
+  handler->Wait();
+
+  ASSERT_TRUE(handler->handled());
+  EXPECT_EQ(handler->channel(), "flutter/isolate");
+  EXPECT_EQ(
+      handler->payload(),
+      std::vector<uint8_t>(kServiceId, kServiceId + sizeof(kServiceId) - 1));
+}
+
