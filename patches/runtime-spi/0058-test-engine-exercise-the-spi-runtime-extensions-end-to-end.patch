@@ -128,6 +128,9 @@ class ReplyingPlatformMessageHandler final : public PlatformMessageHandler {
  public:
   void HandlePlatformMessage(
       std::unique_ptr<PlatformMessage> message) override {
+    channel_ = message->channel();
+    payload_.assign(message->data().GetMapping(),
+                    message->data().GetMapping() + message->data().GetSize());
     if (message->response()) {
       message->response()->Complete(std::make_unique<fml::MallocMapping>(
           fml::MallocMapping::Copy("reply", 5)));
@@ -149,10 +152,14 @@ class ReplyingPlatformMessageHandler final : public PlatformMessageHandler {
   void Wait() { latch_.Wait(); }
 
   bool handled() const { return handled_; }
+  const std::string& channel() const { return channel_; }
+  const std::vector<uint8_t>& payload() const { return payload_; }
 
  private:
