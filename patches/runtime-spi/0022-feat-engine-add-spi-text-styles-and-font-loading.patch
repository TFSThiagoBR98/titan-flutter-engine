+TEST(SpiTextStyle, ConvertsParagraphStyleFields) {
+  const char* strut_families[] = {"Roboto Mono"};
+  const FlutterSpiParagraphStyle input = {
+      .struct_size = sizeof(FlutterSpiParagraphStyle),
+      .text_align = kFlutterSpiTextAlignJustify,
+      .text_direction = kFlutterSpiTextDirectionRtl,
+      .max_lines = 3,
+      .font_family = "Roboto",
+      .font_size = 20.0f,
+      .height = 1.5f,
+      .text_height_behavior = kFlutterSpiTextHeightBehaviorDisableLastDescent,
+      .font_weight = 600,
+      .font_style = kFlutterSpiFontStyleItalic,
+      .strut_enabled = true,
+      .strut_font_families = strut_families,
+      .strut_font_family_count = 1,
+      .strut_font_size = 18.0f,
+      .strut_height = 1.25f,
+      .strut_leading = 0.5f,
+      .strut_force_height = true,
+      .ellipsis = "...",
+      .locale = "en-US",
+  };
+
+  const txt::ParagraphStyle result = ToTxtParagraphStyle(&input);
+
+  EXPECT_EQ(result.text_align, txt::TextAlign::justify);
+  EXPECT_EQ(result.text_direction, txt::TextDirection::rtl);
+  EXPECT_EQ(result.max_lines, 3u);
+  EXPECT_EQ(result.font_family, "Roboto");
+  EXPECT_DOUBLE_EQ(result.font_size, 20.0);
+  EXPECT_DOUBLE_EQ(result.height, 1.5);
+  EXPECT_TRUE(result.has_height_override);
+  EXPECT_EQ(result.text_height_behavior,
+            txt::TextHeightBehavior::kDisableLastDescent);
+  EXPECT_EQ(result.font_weight, 600);
+  EXPECT_EQ(result.font_style, txt::FontStyle::italic);
+  EXPECT_TRUE(result.strut_enabled);
+  EXPECT_EQ(result.strut_font_families,
+            (std::vector<std::string>{"Roboto Mono"}));
+  EXPECT_DOUBLE_EQ(result.strut_font_size, 18.0);
+  EXPECT_DOUBLE_EQ(result.strut_height, 1.25);
+  EXPECT_DOUBLE_EQ(result.strut_leading, 0.5);
+  EXPECT_TRUE(result.force_strut_height);
+  EXPECT_EQ(result.ellipsis, u"...");
+  EXPECT_EQ(result.locale, "en-US");
+}
+
+TEST(SpiTextStyle, OlderParagraphStructUsesTxtDefaults) {
+  const FlutterSpiParagraphStyle input = {
+      .struct_size = offsetof(FlutterSpiParagraphStyle, text_align),
+  };
+
+  const txt::ParagraphStyle result = ToTxtParagraphStyle(&input);
+  const txt::ParagraphStyle defaults;
+
+  EXPECT_EQ(result.text_align, defaults.text_align);
+  EXPECT_EQ(result.text_direction, defaults.text_direction);
+  EXPECT_EQ(result.max_lines, defaults.max_lines);
+  EXPECT_EQ(result.font_size, defaults.font_size);
+  EXPECT_EQ(result.height, defaults.height);
+  EXPECT_FALSE(result.has_height_override);
+  EXPECT_EQ(result.strut_font_size, defaults.strut_font_size);
+  EXPECT_EQ(result.ellipsis, defaults.ellipsis);
+}
