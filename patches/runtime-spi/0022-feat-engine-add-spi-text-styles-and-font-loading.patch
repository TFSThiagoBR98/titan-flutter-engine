+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/text/spi_font.h"
+
+#include <utility>
+
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkString.h"
+#include "txt/platform.h"
+
+namespace flutter {
+
+FlutterSpiResult FontLoad(const uint8_t* data,
+                          size_t size,
+                          const char* family_alias,
+                          void* user_data,
+                          FontRegistrar registrar) {
+  if (data == nullptr || size == 0 || registrar == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  sk_sp<SkData> font_data = SkData::MakeWithCopy(data, size);
+  sk_sp<SkTypeface> typeface =
+      txt::GetDefaultFontManager()->makeFromData(std::move(font_data));
+  if (typeface == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  SkString typeface_family_name;
+  typeface->getFamilyName(&typeface_family_name);
+  const std::string family_name = family_alias == nullptr
+                                      ? typeface_family_name.c_str()
+                                      : family_alias;
+  registrar(user_data, family_name, std::move(typeface));
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
