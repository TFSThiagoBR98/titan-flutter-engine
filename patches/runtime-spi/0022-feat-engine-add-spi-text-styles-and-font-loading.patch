+      .font_families = families,
+      .font_family_count = 2,
+      .font_size = 22.0f,
+      .letter_spacing = 1.25f,
+      .word_spacing = 2.5f,
+      .height = 1.75f,
+      .locale = "pt-BR",
+      .foreground = &kForeground,
+      .background = &kForeground,
+      .shadows = &kShadow,
+      .shadow_count = 1,
+      .features = &kFeature,
+      .feature_count = 1,
+      .variations = &kVariation,
+      .variation_count = 1,
+  };
+
+  const txt::TextStyle result = ToTxtTextStyle(&input);
+
+  EXPECT_EQ(result.color, ToDlColor(kTextColor).argb());
+  EXPECT_EQ(result.decoration, txt::kUnderline | txt::kOverline);
+  EXPECT_EQ(result.decoration_color, ToDlColor(kDecorationColor).argb());
+  EXPECT_EQ(result.decoration_style, txt::TextDecorationStyle::kDashed);
+  EXPECT_DOUBLE_EQ(result.decoration_thickness_multiplier, 1.5);
+  EXPECT_EQ(result.font_weight, 700);
+  EXPECT_EQ(result.font_style, txt::FontStyle::italic);
+  EXPECT_EQ(result.text_baseline, txt::TextBaseline::kIdeographic);
+  EXPECT_TRUE(result.half_leading);
+  ASSERT_EQ(result.font_families,
+            (std::vector<std::string>{"Roboto", "Noto Sans"}));
+  EXPECT_DOUBLE_EQ(result.font_size, 22.0);
+  EXPECT_DOUBLE_EQ(result.letter_spacing, 1.25);
+  EXPECT_DOUBLE_EQ(result.word_spacing, 2.5);
+  EXPECT_DOUBLE_EQ(result.height, 1.75);
+  EXPECT_TRUE(result.has_height_override);
+  EXPECT_EQ(result.locale, "pt-BR");
+  ASSERT_TRUE(result.foreground.has_value());
+  EXPECT_EQ(*result.foreground, ToDlPaint(kForeground));
+  ASSERT_TRUE(result.background.has_value());
+  EXPECT_EQ(*result.background, ToDlPaint(kForeground));
+  ASSERT_EQ(result.text_shadows.size(), 1u);
+  EXPECT_EQ(result.text_shadows[0].color, ToDlColor(kDecorationColor).argb());
+  EXPECT_EQ(result.text_shadows[0].offset, SkPoint::Make(3.0f, 4.0f));
+  EXPECT_DOUBLE_EQ(result.text_shadows[0].blur_sigma, 5.0);
+  ASSERT_EQ(result.font_features.GetFontFeatures().size(), 1u);
+  EXPECT_EQ(result.font_features.GetFontFeatures().at("smcp"), 1);
+  ASSERT_EQ(result.font_variations.GetAxisValues().size(), 1u);
+  EXPECT_FLOAT_EQ(result.font_variations.GetAxisValues().at("wght"), 650.0f);
+}
