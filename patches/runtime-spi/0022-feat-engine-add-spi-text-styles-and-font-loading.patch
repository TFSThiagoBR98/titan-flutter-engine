@@ -0,0 +1,69 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/text/spi_font.h"
+
+#include <string>
+#include <utility>
+
+#include "flutter/lib/ui/text/font_collection.h"
+#include "flutter/testing/testing.h"
+#include "third_party/skia/include/core/SkString.h"
+
+namespace flutter::testing {
+namespace {
+
+struct RegisteredFont {
+  std::string family_name;
+  sk_sp<SkTypeface> typeface;
+};
+
+void RegisterFont(void* user_data,
+                  std::string family_name,
+                  sk_sp<SkTypeface> typeface) {
+  auto* registered_font = static_cast<RegisteredFont*>(user_data);
+  registered_font->family_name = std::move(family_name);
+  registered_font->typeface = std::move(typeface);
+}
+
+TEST(SpiFont, LoadsRobotoAndRegistersItsFamily) {
+  auto mapping = OpenFixtureAsMapping("Roboto-Regular.ttf");
+  ASSERT_NE(mapping, nullptr);
+
+  RegisteredFont registered_font;
+  EXPECT_EQ(FontLoad(mapping->GetMapping(), mapping->GetSize(), nullptr,
+                     &registered_font, RegisterFont),
+            kFlutterSpiOk);
+  EXPECT_EQ(registered_font.family_name, "Roboto");
+  ASSERT_NE(registered_font.typeface, nullptr);
+  SkString family_name;
+  registered_font.typeface->getFamilyName(&family_name);
+  EXPECT_STREQ(family_name.c_str(), "Roboto");
+}
+
+TEST(SpiFont, LoadsRobotoWithAlias) {
+  auto mapping = OpenFixtureAsMapping("Roboto-Regular.ttf");
+  ASSERT_NE(mapping, nullptr);
+
+  RegisteredFont registered_font;
+  EXPECT_EQ(FontLoad(mapping->GetMapping(), mapping->GetSize(), "Titan Sans",
+                     &registered_font, RegisterFont),
+            kFlutterSpiOk);
+  EXPECT_EQ(registered_font.family_name, "Titan Sans");
+  ASSERT_NE(registered_font.typeface, nullptr);
+}
+
+TEST(SpiFont, RejectsInvalidFontBytes) {
+  constexpr uint8_t kInvalidFontBytes[] = {0x00, 0x01, 0x02, 0x03};
+  RegisteredFont registered_font;
+
+  EXPECT_EQ(FontLoad(kInvalidFontBytes, sizeof(kInvalidFontBytes), nullptr,
+                     &registered_font, RegisterFont),
+            kFlutterSpiInvalidArgument);
+  EXPECT_TRUE(registered_font.family_name.empty());
+  EXPECT_EQ(registered_font.typeface, nullptr);
+}
+
+}  // namespace
+}  // namespace flutter::testing
diff --git a/engine/src/flutter/runtime_spi/text/spi_text_style.cc b/engine/src/flutter/runtime_spi/text/spi_text_style.cc
new file mode 100644
index 00000000000..9234bbb5b83
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/text/spi_text_style.cc
@@ -0,0 +1,283 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/text/spi_text_style.h"
+
+#include <cstddef>
+#include <string>
+
+#include "flutter/fml/string_conversion.h"
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+#include "flutter/runtime_spi/scene/spi_paint.h"
+#include "txt/text_shadow.h"
+
+namespace flutter {
+namespace {
+
+bool ContainsField(size_t struct_size, size_t offset, size_t field_size) {
+  return struct_size >= offset && struct_size - offset >= field_size;
+}
+
+template <typename Structure>
+bool HasField(const Structure& structure, size_t offset, size_t field_size) {
+  return ContainsField(structure.struct_size, offset, field_size);
+}
+
+void AppendFamilies(const char* const* families,
+                    size_t count,
+                    std::vector<std::string>* destination) {
+  if (families == nullptr) {
+    return;
+  }
+  destination->reserve(count);
+  for (size_t index = 0; index < count; index++) {
+    if (families[index] != nullptr) {
+      destination->emplace_back(families[index]);
+    }
+  }
+}
+
+void ReplaceFamilies(const char* const* families,
+                     size_t count,
+                     std::vector<std::string>* destination) {
+  if (families == nullptr || count == 0) {
+    return;
+  }
+  destination->clear();
+  AppendFamilies(families, count, destination);
+}
+
+void AppendFeatures(const FlutterSpiFontFeature* features,
+                    size_t count,
+                    txt::FontFeatures* destination) {
+  if (features == nullptr) {
+    return;
+  }
+  for (size_t index = 0; index < count; index++) {
+    destination->SetFeature(std::string(features[index].tag, 4),
+                            features[index].value);
+  }
+}
+
+void AppendVariations(const FlutterSpiFontVariation* variations,
+                      size_t count,
+                      txt::FontVariations* destination) {
+  if (variations == nullptr) {
+    return;
+  }
+  for (size_t index = 0; index < count; index++) {
+    destination->SetAxisValue(std::string(variations[index].axis, 4),
+                              variations[index].value);
+  }
+}
+
+void AppendShadows(const FlutterSpiTextShadow* shadows,
+                   size_t count,
+                   std::vector<txt::TextShadow>* destination) {
+  if (shadows == nullptr) {
+    return;
+  }
+  destination->reserve(count);
+  for (size_t index = 0; index < count; index++) {
+    const FlutterSpiTextShadow& shadow = shadows[index];
+    destination->emplace_back(ToDlColor(shadow.color).argb(),
+                              SkPoint::Make(shadow.offset.x, shadow.offset.y),
+                              shadow.blur_sigma);
+  }
+}
+
+void SetHeight(float height, double* destination, bool* has_override) {
+  if (height == 0.0f) {
+    return;
+  }
+  *destination = height;
+  *has_override = true;
+}
+
+}  // namespace
+
+txt::TextStyle ToTxtTextStyle(const FlutterSpiTextStyle* style) {
+  txt::TextStyle result;
+  if (style == nullptr) {
+    return result;
+  }
+
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, color),
+               sizeof(style->color))) {
+    result.color = ToDlColor(style->color).argb();
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, decoration),
+               sizeof(style->decoration))) {
+    result.decoration = style->decoration;
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, decoration_color),
+               sizeof(style->decoration_color))) {
+    result.decoration_color = ToDlColor(style->decoration_color).argb();
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, decoration_style),
+               sizeof(style->decoration_style))) {
+    result.decoration_style = static_cast<txt::TextDecorationStyle>(
+        style->decoration_style);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, decoration_thickness),
+               sizeof(style->decoration_thickness))) {
+    result.decoration_thickness_multiplier = style->decoration_thickness;
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, font_weight),
+               sizeof(style->font_weight))) {
+    result.font_weight = style->font_weight;
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, font_style),
+               sizeof(style->font_style))) {
+    result.font_style = static_cast<txt::FontStyle>(style->font_style);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, text_baseline),
+               sizeof(style->text_baseline))) {
+    result.text_baseline = static_cast<txt::TextBaseline>(style->text_baseline);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, half_leading),
+               sizeof(style->half_leading))) {
+    result.half_leading = style->half_leading;
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, font_families),
+               sizeof(style->font_families))) {
+    ReplaceFamilies(style->font_families, style->font_family_count,
+                    &result.font_families);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, font_size),
+               sizeof(style->font_size))) {
+    result.font_size = style->font_size;
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, letter_spacing),
+               sizeof(style->letter_spacing))) {
+    result.letter_spacing = style->letter_spacing;
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, word_spacing),
+               sizeof(style->word_spacing))) {
+    result.word_spacing = style->word_spacing;
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, height),
+               sizeof(style->height))) {
+    SetHeight(style->height, &result.height, &result.has_height_override);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, locale),
+               sizeof(style->locale)) &&
+      style->locale != nullptr) {
+    result.locale = style->locale;
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, foreground),
+               sizeof(style->foreground)) &&
+      style->foreground != nullptr) {
+    result.foreground = ToDlPaint(*style->foreground);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, background),
+               sizeof(style->background)) &&
+      style->background != nullptr) {
+    result.background = ToDlPaint(*style->background);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, shadows),
+               sizeof(style->shadows))) {
+    AppendShadows(style->shadows, style->shadow_count, &result.text_shadows);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, features),
+               sizeof(style->features))) {
+    AppendFeatures(style->features, style->feature_count,
+                   &result.font_features);
+  }
+  if (HasField(*style, offsetof(FlutterSpiTextStyle, variations),
+               sizeof(style->variations))) {
+    AppendVariations(style->variations, style->variation_count,
+                     &result.font_variations);
+  }
+  return result;
+}
+
+txt::ParagraphStyle ToTxtParagraphStyle(
+    const FlutterSpiParagraphStyle* style) {
+  txt::ParagraphStyle result;
+  if (style == nullptr) {
+    return result;
+  }
+
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, text_align),
+               sizeof(style->text_align))) {
+    result.text_align = static_cast<txt::TextAlign>(style->text_align);
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, text_direction),
+               sizeof(style->text_direction))) {
+    result.text_direction =
+        static_cast<txt::TextDirection>(style->text_direction);
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, max_lines),
+               sizeof(style->max_lines)) &&
+      style->max_lines != 0) {
+    result.max_lines = style->max_lines;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, font_family),
+               sizeof(style->font_family)) &&
+      style->font_family != nullptr) {
+    result.font_family = style->font_family;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, font_size),
+               sizeof(style->font_size))) {
+    result.font_size = style->font_size;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, height),
+               sizeof(style->height))) {
+    SetHeight(style->height, &result.height, &result.has_height_override);
+  }
+  if (HasField(*style,
+               offsetof(FlutterSpiParagraphStyle, text_height_behavior),
+               sizeof(style->text_height_behavior))) {
+    result.text_height_behavior = style->text_height_behavior;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, font_weight),
+               sizeof(style->font_weight))) {
+    result.font_weight = style->font_weight;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, font_style),
+               sizeof(style->font_style))) {
+    result.font_style = static_cast<txt::FontStyle>(style->font_style);
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, strut_enabled),
+               sizeof(style->strut_enabled))) {
+    result.strut_enabled = style->strut_enabled;
+  }
+  if (HasField(*style,
+               offsetof(FlutterSpiParagraphStyle, strut_font_families),
+               sizeof(style->strut_font_families))) {
+    ReplaceFamilies(style->strut_font_families,
+                    style->strut_font_family_count,
+                    &result.strut_font_families);
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, strut_font_size),
+               sizeof(style->strut_font_size))) {
+    result.strut_font_size = style->strut_font_size;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, strut_height),
+               sizeof(style->strut_height))) {
+    result.strut_height = style->strut_height;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, strut_leading),
+               sizeof(style->strut_leading))) {
+    result.strut_leading = style->strut_leading;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, strut_force_height),
+               sizeof(style->strut_force_height))) {
+    result.force_strut_height = style->strut_force_height;
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, ellipsis),
+               sizeof(style->ellipsis)) &&
+      style->ellipsis != nullptr) {
+    result.ellipsis = fml::Utf8ToUtf16(style->ellipsis);
+  }
+  if (HasField(*style, offsetof(FlutterSpiParagraphStyle, locale),
+               sizeof(style->locale)) &&
+      style->locale != nullptr) {
+    result.locale = style->locale;
+  }
+  return result;
+}
+
+}  // namespace flutter
