+    .green = 0.2f,
+    .blue = 0.3f,
+    .alpha = 0.4f,
+    .color_space = kFlutterSpiColorSpaceSRGB,
+};
+
+constexpr FlutterSpiColor kDecorationColor = {
+    .red = 0.5f,
+    .green = 0.6f,
+    .blue = 0.7f,
+    .alpha = 0.8f,
+    .color_space = kFlutterSpiColorSpaceDisplayP3,
+};
+
+constexpr FlutterSpiPaint kForeground = {
+    .struct_size = sizeof(FlutterSpiPaint),
+    .color = kTextColor,
+    .blend_mode = kFlutterSpiBlendModeMultiply,
+    .style = kFlutterSpiPaintStyleStroke,
+    .stroke_width = 2.5f,
+    .stroke_cap = kFlutterSpiStrokeCapRound,
+    .stroke_join = kFlutterSpiStrokeJoinBevel,
+    .stroke_miter = 3.5f,
+    .anti_alias = false,
+    .invert_colors = true,
+};
+
+constexpr FlutterSpiTextShadow kShadow = {
+    .color = kDecorationColor,
+    .offset = {.x = 3.0f, .y = 4.0f},
+    .blur_sigma = 5.0f,
+};
+
+constexpr FlutterSpiFontFeature kFeature = {.tag = {'s', 'm', 'c', 'p'},
+                                             .value = 1};
+constexpr FlutterSpiFontVariation kVariation = {.axis = {'w', 'g', 'h', 't'},
+                                                .value = 650.0f};
+
+TEST(SpiTextStyle, ConvertsEveryField) {
+  const char* families[] = {"Roboto", "Noto Sans"};
+  const FlutterSpiTextStyle input = {
+      .struct_size = sizeof(FlutterSpiTextStyle),
+      .color = kTextColor,
+      .decoration = kFlutterSpiTextDecorationUnderline |
+                    kFlutterSpiTextDecorationOverline,
+      .decoration_color = kDecorationColor,
