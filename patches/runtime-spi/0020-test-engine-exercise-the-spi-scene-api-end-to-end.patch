diff --git a/engine/src/flutter/runtime_spi/spi_scene_benchmarks.cc b/engine/src/flutter/runtime_spi/spi_scene_benchmarks.cc
new file mode 100644
index 00000000000..ef4ed04c335
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/spi_scene_benchmarks.cc
@@ -0,0 +1,62 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/benchmarking/benchmarking.h"
+
+#include "flutter/display_list/dl_builder.h"
+#include "flutter/runtime_spi/scene/spi_canvas.h"
+
+namespace flutter {
+namespace {
+
+constexpr int kDrawCount = 10000;
+const DlRect kRect = DlRect::MakeLTRB(1.0f, 2.0f, 3.0f, 4.0f);
+
+FlutterSpiEngine* BenchmarkEngine() {
+  return reinterpret_cast<FlutterSpiEngine*>(1);
+}
+
+void BM_SpiCanvasDrawRect(benchmark::State& state) {
+  const FlutterSpiSceneApi* api = SpiSceneApi();
+  const FlutterSpiRect rect = {
+      .left = kRect.GetLeft(),
+      .top = kRect.GetTop(),
+      .right = kRect.GetRight(),
+      .bottom = kRect.GetBottom(),
+  };
+  const FlutterSpiPaint paint = {.struct_size = sizeof(FlutterSpiPaint)};
+  FlutterSpiPictureRecorder* recorder = nullptr;
+
+  while (state.KeepRunning()) {
+    const FlutterSpiResult create_result =
+        api->recorder_create(BenchmarkEngine(), nullptr, &recorder);
+    if (create_result != kFlutterSpiOk) {
+      state.SkipWithError("could not create the SPI picture recorder");
+      return;
+    }
+    for (int index = 0; index < kDrawCount; ++index) {
+      const FlutterSpiResult result =
+          api->canvas_draw_rect(recorder, &rect, &paint);
+      benchmark::DoNotOptimize(result);
+    }
+    api->recorder_release(recorder);
+  }
+}
+
+void BM_DlBuilderDrawRect(benchmark::State& state) {
+  while (state.KeepRunning()) {
+    DisplayListBuilder builder(DisplayListBuilder::kMaxCullRect);
+    for (int index = 0; index < kDrawCount; ++index) {
+      builder.DrawRect(kRect, DlPaint());
+    }
+    benchmark::DoNotOptimize(builder.Build());
+  }
+}
+
+}  // namespace
+
+BENCHMARK(BM_SpiCanvasDrawRect);
+BENCHMARK(BM_DlBuilderDrawRect);
+
+}  // namespace flutter
