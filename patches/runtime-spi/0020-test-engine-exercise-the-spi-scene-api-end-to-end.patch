+  }
   if (runtime->engine_api->scene_create_empty(
           runtime->engine,
           (int64_t)runtime->last_view_metrics.physical_width,
@@ -240,6 +250,70 @@ static void test_runtime_notify_idle(void* user_data, int64_t deadline_ns) {
   ((CTestRuntime*)user_data)->notify_idle_count++;
 }
 
+static const FlutterSpiPaint k_scene_paint = {
+    .struct_size = sizeof(FlutterSpiPaint),
+    .color = {.alpha = 1.0f, .color_space = kFlutterSpiColorSpaceSRGB},
+    .blend_mode = kFlutterSpiBlendModeSrcOver,
+    .style = kFlutterSpiPaintStyleFill,
+    .anti_alias = true,
+};
+
+static bool create_scene_picture(const FlutterSpiSceneApi* api,
+                                FlutterSpiEngine* engine,
+                                FlutterSpiPicture** out_picture) {
+  FlutterSpiPictureRecorder* recorder = NULL;
+  const FlutterSpiRect rect = {
+      .left = 1.0f, .top = 2.0f, .right = 3.0f, .bottom = 4.0f};
+  const FlutterSpiPoint circle_center = {.x = 5.0f, .y = 6.0f};
+
+  if (api->recorder_create(engine, NULL, &recorder) != kFlutterSpiOk ||
+      api->canvas_draw_rect(recorder, &rect, &k_scene_paint) !=
+          kFlutterSpiOk ||
+      api->canvas_draw_circle(recorder, &circle_center, 2.0f, &k_scene_paint) !=
+          kFlutterSpiOk ||
+      api->recorder_finish(recorder, out_picture) != kFlutterSpiOk) {
+    if (recorder != NULL) {
+      api->recorder_release(recorder);
+    }
+    return false;
+  }
+  return true;
+}
+
+static void test_runtime_submit_drawn_scene(CTestRuntime* runtime,
+                                            const FlutterSpiFrameInfo* frame_info) {
+  const FlutterSpiSceneApi* api = runtime->engine_api->scene;
+  FlutterSpiPicture* picture = NULL;
+  FlutterSpiSceneBuilder* builder = NULL;
+  FlutterSpiScene* scene = NULL;
+
+  if (api == NULL ||
+      !create_scene_picture(api, runtime->engine, &picture) ||
+      api->scene_builder_create(runtime->engine, &builder) != kFlutterSpiOk ||
+      api->scene_push_offset(builder, 3.0f, 4.0f) != kFlutterSpiOk ||
+      api->scene_push_opacity(builder, 128, 5.0f, 6.0f) != kFlutterSpiOk ||
+      api->scene_add_picture(builder, 1.0f, 2.0f, picture, false, false) !=
+          kFlutterSpiOk ||
+      api->scene_build(builder,
+                       (int64_t)runtime->last_view_metrics.physical_width,
+                       (int64_t)runtime->last_view_metrics.physical_height,
+                       &scene) != kFlutterSpiOk) {
+    if (builder != NULL) {
+      api->scene_builder_release(builder);
+    }
+    if (picture != NULL) {
+      api->picture_release(picture);
+    }
+    return;
+  }
+
+  api->picture_release(picture);
+  runtime->engine_api->submit_frame(
+      runtime->engine, runtime->last_view_metrics.view_id,
+      frame_info->frame_token, scene,
+      runtime->last_view_metrics.device_pixel_ratio);
+}
+
 CTestRuntime* c_test_runtime_create(void) {
   return (CTestRuntime*)calloc(1, sizeof(CTestRuntime));
 }
