# Why: Preserve the legacy behavior that failed background-isolate platform
# messages raise an error without completing the reply port.
diff --git a/engine/src/flutter/shell/common/fixtures/shell_test.dart b/engine/src/flutter/shell/common/fixtures/shell_test.dart
index 709ad70a94f..5557ea4e268 100644
--- a/engine/src/flutter/shell/common/fixtures/shell_test.dart
+++ b/engine/src/flutter/shell/common/fixtures/shell_test.dart
@@ -636,6 +636,48 @@ Future<void> backgroundIsolatePlatformMessage() async {
   notifyBackgroundReply(result);
 }
 
+void _backgroundIsolateSendWithoutHandlerMain(List<Object?> arguments) {
+  final RootIsolateToken token = arguments[0]! as RootIsolateToken;
+  final SendPort resultPort = arguments[1]! as SendPort;
+  PlatformDispatcher.instance.registerBackgroundIsolate(token);
+
+  bool responseReceived = false;
+  final ReceivePort replyPort = ReceivePort();
+  replyPort.listen((Object? _) {
+    responseReceived = true;
+  });
+
+  bool didThrow = false;
+  try {
+    PlatformDispatcher.instance.sendPortPlatformMessage(
+      'titan/background',
+      ByteData.sublistView(Uint8List.fromList(<int>[1, 2, 3])),
+      1,
+      replyPort.sendPort,
+    );
+  } catch (_) {
+    didThrow = true;
+  }
+
+  Future<void>.delayed(const Duration(milliseconds: 500), () {
+    resultPort.send(didThrow && !responseReceived);
+    replyPort.close();
+  });
+}
+
+@pragma('vm:entry-point')
+Future<void> backgroundIsolateSendWithoutHandler() async {
+  final ReceivePort resultPort = ReceivePort();
+  final Isolate isolate = await Isolate.spawn(
+    _backgroundIsolateSendWithoutHandlerMain,
+    <Object?>[RootIsolateToken.instance!, resultPort.sendPort],
+  );
+  final bool result = await resultPort.first as bool;
+  resultPort.close();
+  isolate.kill();
+  notifyBackgroundReply(result);
+}
+
 @Native<Void Function(Bool)>(symbol: 'NotifyBackgroundReply')
 external void notifyBackgroundReply(bool result);
 
