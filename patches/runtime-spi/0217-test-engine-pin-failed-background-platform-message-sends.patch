+TEST_F(ShellTest, BackgroundIsolateSendAfterShellIsGoneOnlyThrows) {
+  TaskRunners task_runners = GetTaskRunnersForFixture();
+  auto settings = CreateSettingsForFixture();
+  MockPlatformViewDelegate platform_view_delegate;
+  fml::AutoResetWaitableEvent reply_latch;
+  bool reply_received = false;
+
+  Shell::CreateCallback<PlatformView> platform_view_create_callback =
+      [&platform_view_delegate, task_runners](flutter::Shell& shell) {
+        auto result = std::make_unique<MockPlatformView>(platform_view_delegate,
+                                                         task_runners);
+        EXPECT_CALL(*result, GetPlatformMessageHandler())
+            .WillOnce(Return(nullptr));
+        return result;
+      };
+  auto shell = CreateShell({
+      .settings = settings,
+      .task_runners = task_runners,
+      .platform_view_create_callback = platform_view_create_callback,
+  });
+
+  AddFfiNativeCallback(
+      "NotifyBackgroundReply",
+      CREATE_FFI_LAMBDA([&](bool result) {
+        reply_received = result;
+        reply_latch.Signal();
+      }));
+  auto configuration = RunConfiguration::InferFromSettings(settings);
+  ASSERT_TRUE(configuration.IsValid());
+  configuration.SetEntrypoint("backgroundIsolateSendWithoutHandler");
+  RunEngine(shell.get(), std::move(configuration));
+
+  const bool timed_out =
+      reply_latch.WaitWithTimeout(fml::TimeDelta::FromSeconds(10));
+  ASSERT_FALSE(timed_out);
+  EXPECT_TRUE(reply_received);
+  DestroyShell(std::move(shell));
+}
