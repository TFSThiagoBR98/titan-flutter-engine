+TEST_F(SpiSceneBuilderTest, NullColorFilterPushesPassThroughLayer) {
+  FlutterSpiSceneBuilder* builder = nullptr;
+  ASSERT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_color_filter(builder, nullptr), kFlutterSpiOk);
+
+  FlutterSpiScene* scene = nullptr;
+  ASSERT_EQ(api()->scene_build(builder, 100, 80, &scene), kFlutterSpiOk);
+
+  auto expected_root = std::make_shared<ContainerLayer>();
+  expected_root->Add(std::make_shared<ColorFilterLayer>(nullptr));
+  auto expected = std::make_shared<LayerTree>(expected_root, DlISize(100, 80));
+  EXPECT_EQ(SceneTrace(*scene->layer_tree), SceneTrace(*expected));
+  EXPECT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
+}
+
+TEST_F(SpiSceneBuilderTest, NullImageFilterPushesPassThroughLayer) {
+  FlutterSpiSceneBuilder* builder = nullptr;
+  ASSERT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_image_filter(builder, nullptr, 4.0f, 5.0f),
+            kFlutterSpiOk);
+
+  FlutterSpiScene* scene = nullptr;
+  ASSERT_EQ(api()->scene_build(builder, 100, 80, &scene), kFlutterSpiOk);
+
+  auto expected_root = std::make_shared<ContainerLayer>();
+  expected_root->Add(
+      std::make_shared<ImageFilterLayer>(nullptr, DlPoint(4.0f, 5.0f)));
+  auto expected = std::make_shared<LayerTree>(expected_root, DlISize(100, 80));
+  EXPECT_EQ(SceneTrace(*scene->layer_tree), SceneTrace(*expected));
+  EXPECT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
+}
+
+TEST_F(SpiSceneBuilderTest, NullBackdropFilterPushesPassThroughLayer) {
+  FlutterSpiSceneBuilder* builder = nullptr;
+  ASSERT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_backdrop_filter(
+                builder, nullptr, kFlutterSpiBlendModeScreen, false, 0),
+            kFlutterSpiOk);
+
+  FlutterSpiScene* scene = nullptr;
+  ASSERT_EQ(api()->scene_build(builder, 100, 80, &scene), kFlutterSpiOk);
+
+  auto expected_root = std::make_shared<ContainerLayer>();
+  expected_root->Add(std::make_shared<BackdropFilterLayer>(
+      nullptr, DlBlendMode::kScreen, std::nullopt));
+  auto expected = std::make_shared<LayerTree>(expected_root, DlISize(100, 80));
+  EXPECT_EQ(SceneTrace(*scene->layer_tree), SceneTrace(*expected));
+  EXPECT_EQ(SpiSceneRelease(scene), kFlutterSpiOk);
+}
+
 }  // namespace
 }  // namespace flutter::testing
