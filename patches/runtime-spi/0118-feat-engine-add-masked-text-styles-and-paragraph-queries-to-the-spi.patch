+FlutterSpiResult SpiParagraphGetGlyphInfoAt(FlutterSpiParagraph* paragraph,
+                                            size_t utf16_offset,
+                                            FlutterSpiGlyphInfo* out,
+                                            bool* found) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out() || out == nullptr || found == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  skia::textlayout::Paragraph::GlyphInfo glyph_info;
+  *found = paragraph_value->paragraph().GetGlyphInfoAt(utf16_offset,
+                                                        &glyph_info);
+  if (!*found) {
+    return kFlutterSpiOk;
+  }
+  *out = {
+      .grapheme_bounds = {.left = glyph_info.fGraphemeLayoutBounds.fLeft,
+                          .top = glyph_info.fGraphemeLayoutBounds.fTop,
+                          .right = glyph_info.fGraphemeLayoutBounds.fRight,
+                          .bottom = glyph_info.fGraphemeLayoutBounds.fBottom},
+      .range_start = glyph_info.fGraphemeClusterTextRange.start,
+      .range_end = glyph_info.fGraphemeClusterTextRange.end,
+      .is_ltr = glyph_info.fDirection ==
+                skia::textlayout::TextDirection::kLtr,
+  };
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiParagraphGetClosestGlyphInfo(FlutterSpiParagraph* paragraph,
+                                                 double dx,
+                                                 double dy,
+                                                 FlutterSpiGlyphInfo* out,
+                                                 bool* found) {
+  const auto paragraph_value = FindParagraph(paragraph);
+  if (paragraph_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!paragraph_value->laid_out() || !std::isfinite(dx) ||
+      !std::isfinite(dy) || out == nullptr || found == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  skia::textlayout::Paragraph::GlyphInfo glyph_info;
+  *found = paragraph_value->paragraph().GetClosestGlyphInfoAtCoordinate(
+      dx, dy, &glyph_info);
+  if (!*found) {
+    return kFlutterSpiOk;
+  }
+  *out = {
+      .grapheme_bounds = {.left = glyph_info.fGraphemeLayoutBounds.fLeft,
+                          .top = glyph_info.fGraphemeLayoutBounds.fTop,
+                          .right = glyph_info.fGraphemeLayoutBounds.fRight,
+                          .bottom = glyph_info.fGraphemeLayoutBounds.fBottom},
+      .range_start = glyph_info.fGraphemeClusterTextRange.start,
+      .range_end = glyph_info.fGraphemeClusterTextRange.end,
+      .is_ltr = glyph_info.fDirection ==
+                skia::textlayout::TextDirection::kLtr,
+  };
+  return kFlutterSpiOk;
+}
+
