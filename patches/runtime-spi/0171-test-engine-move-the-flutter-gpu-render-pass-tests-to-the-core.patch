+TEST(FlutterGpuRenderPassTest, SetDepthWriteEnableHonorsArgument) {
+  SpiGpuRenderPass render_pass;
+
+  EXPECT_EQ(render_pass.SetDepthWriteEnable(true), kFlutterSpiOk);
+  EXPECT_TRUE(SpiGpuRenderPassTestPeer::GetDepthDescriptor(render_pass)
+                  .depth_write_enabled);
+
+  EXPECT_EQ(render_pass.SetDepthWriteEnable(false), kFlutterSpiOk);
+  EXPECT_FALSE(SpiGpuRenderPassTestPeer::GetDepthDescriptor(render_pass)
+                   .depth_write_enabled);
+}
