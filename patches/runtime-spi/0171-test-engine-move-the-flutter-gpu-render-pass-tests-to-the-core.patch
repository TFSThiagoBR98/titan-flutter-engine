+class GpuTestEnvironment final {
+ public:
+  GpuTestEnvironment() {
+    fml::MessageLoop::EnsureInitializedForCurrentThread();
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    auto task_runner = fml::MessageLoop::GetCurrent().GetTaskRunner();
+#pragma clang diagnostic pop
+    task_runners_ =
+        std::make_unique<TaskRunners>("spi-render-pass-test", task_runner,
+                                      task_runner, task_runner, task_runner);
+
+    FlutterSpiRuntimeTable table = {};
+    SpiGpuSetDefaultContextOverride(CreateMockContext(&capabilities_));
+    backend_ = std::unique_ptr<SpiRuntimeBackend>(new SpiRuntimeBackend(
+        delegate_, *task_runners_, table, fml::WeakPtr<IOManager>(), {}, {}, {},
+        nullptr, true, std::shared_future<impeller::RuntimeStageBackend>{},
+        nullptr, true));
+
+    FlutterSpiGpuContext* context = nullptr;
+    int32_t reason = kFlutterSpiGpuUnavailableNone;
+    if (SpiGpuContextGetDefault(backend_->engine_handle(), &context, &reason) !=
+        kFlutterSpiOk) {
+      return;
+    }
+    context_ = context;
+
+    auto bundle = BuildPipelineShaderBundle();
+    auto library_descriptor = MakeShaderLibraryDescriptor(bundle);
+    if (SpiGpuShaderLibraryCreate(context_, &library_descriptor, &library_,
+                                  nullptr) != kFlutterSpiOk) {
+      return;
+    }
+    if (SpiGpuShaderLibraryGetShader(library_, "vertex", &vertex_shader_) !=
+            kFlutterSpiOk ||
+        SpiGpuShaderLibraryGetShader(library_, "fragment", &fragment_shader_) !=
+            kFlutterSpiOk) {
+      return;
+    }
+
+    FlutterSpiGpuRenderPipelineDescriptor pipeline_descriptor = {
+        .struct_size = sizeof(FlutterSpiGpuRenderPipelineDescriptor),
+        .vertex_shader = vertex_shader_,
+        .fragment_shader = fragment_shader_,
+        .buffer_layouts = nullptr,
+        .buffer_layout_count = 0,
+    };
+    SpiGpuRenderPipelineCreate(context_, &pipeline_descriptor, &pipeline_,
+                               nullptr);
+  }
+
+  ~GpuTestEnvironment() {
+    if (pipeline_ != nullptr) {
+      SpiGpuRenderPipelineRelease(pipeline_);
+    }
+    if (vertex_shader_ != nullptr) {
+      SpiGpuShaderRelease(vertex_shader_);
+    }
+    if (fragment_shader_ != nullptr) {
+      SpiGpuShaderRelease(fragment_shader_);
+    }
+    if (library_ != nullptr) {
+      SpiGpuShaderLibraryRelease(library_);
+    }
+    if (context_ != nullptr) {
+      SpiGpuContextRelease(context_);
+    }
+    SpiGpuSetDefaultContextOverride(nullptr);
+  }
+
+  FlutterSpiGpuRenderPipeline* pipeline() const { return pipeline_; }
+
+ private:
+  TestRuntimeDelegate delegate_;
+  std::unique_ptr<TaskRunners> task_runners_;
+  std::unique_ptr<SpiRuntimeBackend> backend_;
+  std::shared_ptr<const impeller::Capabilities> capabilities_;
+  FlutterSpiGpuContext* context_ = nullptr;
+  FlutterSpiGpuShaderLibrary* library_ = nullptr;
+  FlutterSpiGpuShader* vertex_shader_ = nullptr;
+  FlutterSpiGpuShader* fragment_shader_ = nullptr;
+  FlutterSpiGpuRenderPipeline* pipeline_ = nullptr;
+};
