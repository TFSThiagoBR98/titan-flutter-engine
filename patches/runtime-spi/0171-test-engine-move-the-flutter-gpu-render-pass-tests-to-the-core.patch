+TEST(FlutterGpuRenderPassTest, BindSetReplacesTheSlotContents) {
+  FlutterSpiGpuBindingSet* first = MakeBindingSet();
+  FlutterSpiGpuBindingSet* second = MakeBindingSet();
+  ASSERT_NE(first, nullptr);
+  ASSERT_NE(second, nullptr);
+  SpiGpuRenderPass render_pass;
+
+  EXPECT_EQ(render_pass.BindSet(first, 0), kFlutterSpiOk);
+  EXPECT_EQ(render_pass.BindSet(first, 0), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuRenderPassTestPeer::GetBindingSetHandles(render_pass)[0],
+            first);
+
+  EXPECT_EQ(render_pass.BindSet(second, 0), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuRenderPassTestPeer::GetBindingSetHandles(render_pass)[0],
+            second);
+
+  EXPECT_EQ(render_pass.BindSet(first, 1), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuRenderPassTestPeer::GetBindingSetHandles(render_pass)[0],
+            second);
+  EXPECT_EQ(SpiGpuRenderPassTestPeer::GetBindingSetHandles(render_pass)[1],
+            first);
+
+  EXPECT_EQ(render_pass.BindSet(first, SpiGpuRenderPass::kMaxBindingSets),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuRenderPassTestPeer::GetBindingSetHandles(render_pass)[0],
