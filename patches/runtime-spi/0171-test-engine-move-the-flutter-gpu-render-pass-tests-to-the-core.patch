+TEST(FlutterGpuRenderPassTest, PipelineStateMutationsMarkStateDirty) {
+  GpuTestEnvironment environment;
+  SpiGpuRenderPass render_pass;
+
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+
+  render_pass.ClearPipelineStateDirtyForTesting();
+  EXPECT_EQ(render_pass.SetDepthWriteEnable(true), kFlutterSpiOk);
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+
+  render_pass.ClearPipelineStateDirtyForTesting();
+  EXPECT_EQ(render_pass.SetColorBlendEnable(0, true), kFlutterSpiOk);
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+
+  render_pass.ClearPipelineStateDirtyForTesting();
+  EXPECT_EQ(render_pass.SetDepthCompare(0), kFlutterSpiOk);
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+
+  render_pass.ClearPipelineStateDirtyForTesting();
+  EXPECT_EQ(render_pass.SetCullMode(
+                static_cast<int32_t>(impeller::CullMode::kBackFace)),
+            kFlutterSpiOk);
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+
+  render_pass.ClearPipelineStateDirtyForTesting();
+  EXPECT_EQ(render_pass.SetWindingOrder(static_cast<int32_t>(
+                impeller::WindingOrder::kCounterClockwise)),
+            kFlutterSpiOk);
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+
+  render_pass.ClearPipelineStateDirtyForTesting();
+  EXPECT_EQ(render_pass.SetPrimitiveType(
+                static_cast<int32_t>(impeller::PrimitiveType::kTriangleStrip)),
+            kFlutterSpiOk);
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+
+  render_pass.ClearPipelineStateDirtyForTesting();
+  EXPECT_EQ(render_pass.SetPolygonMode(
+                static_cast<int32_t>(impeller::PolygonMode::kLine)),
+            kFlutterSpiOk);
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+
+  ASSERT_NE(environment.pipeline(), nullptr);
+  render_pass.ClearPipelineStateDirtyForTesting();
+  EXPECT_EQ(render_pass.BindPipeline(environment.pipeline()), kFlutterSpiOk);
+  EXPECT_TRUE(render_pass.IsPipelineStateDirtyForTesting());
+}
