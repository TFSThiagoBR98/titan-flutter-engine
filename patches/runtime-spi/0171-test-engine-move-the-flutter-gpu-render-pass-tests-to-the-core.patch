+std::shared_ptr<std::vector<uint8_t>> BuildPipelineShaderBundle() {
+  namespace fbs = impeller::fb::shaderbundle;
+  auto vertex_backend = std::make_unique<fbs::BackendShaderT>();
+  vertex_backend->stage = fbs::ShaderStage::kVertex;
+  vertex_backend->entrypoint = "vertex_main";
+  vertex_backend->shader = {1};
+  auto vertex_input = std::make_unique<fbs::ShaderInputT>();
+  vertex_input->name = "position";
+  vertex_input->location = 0;
+  vertex_input->type = fbs::InputDataType::kFloat;
+  vertex_input->bit_width = 32;
+  vertex_input->vec_size = 3;
+  vertex_input->columns = 1;
+  vertex_backend->inputs.push_back(std::move(vertex_input));
+
+  auto fragment_backend = std::make_unique<fbs::BackendShaderT>();
+  fragment_backend->stage = fbs::ShaderStage::kFragment;
+  fragment_backend->entrypoint = "fragment_main";
+  fragment_backend->shader = {2};
+
+  auto vertex = std::make_unique<fbs::ShaderT>();
+  vertex->name = "vertex";
+  vertex->vulkan = std::move(vertex_backend);
+  auto fragment = std::make_unique<fbs::ShaderT>();
+  fragment->name = "fragment";
+  fragment->vulkan = std::move(fragment_backend);
+
+  fbs::ShaderBundleT bundle;
+  bundle.format_version =
+      static_cast<uint32_t>(fbs::ShaderBundleFormatVersion::kVersion);
+  bundle.shaders.push_back(std::move(vertex));
+  bundle.shaders.push_back(std::move(fragment));
+  flatbuffers::FlatBufferBuilder builder;
+  builder.Finish(fbs::ShaderBundle::Pack(builder, &bundle),
+                 fbs::ShaderBundleIdentifier());
+  return std::make_shared<std::vector<uint8_t>>(
+      builder.GetBufferPointer(),
+      builder.GetBufferPointer() + builder.GetSize());
+}
+
+FlutterSpiGpuShaderLibraryDescriptor MakeShaderLibraryDescriptor(
+    const std::shared_ptr<std::vector<uint8_t>>& bundle) {
+  return {
+      .struct_size = sizeof(FlutterSpiGpuShaderLibraryDescriptor),
+      .format = kFlutterSpiGpuShaderFormatImpellerBundle,
+      .data = bundle->data(),
+      .size = bundle->size(),
+      .library_id = "render_pass_test_bundle",
+  };
+}
