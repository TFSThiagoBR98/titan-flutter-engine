+FlutterSpiResult SpiGpuRenderPass::SetViewport(
+    const FlutterSpiGpuViewport* viewport) {
+  if (viewport == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto depth_range = impeller::DepthRange();
+  depth_range.z_near = viewport->z_near;
+  depth_range.z_far = viewport->z_far;
+  auto value = impeller::Viewport();
+  value.rect = impeller::TRect<float>::MakeXYWH(
+      viewport->x, viewport->y, viewport->width, viewport->height);
+  value.depth_range = depth_range;
+  viewport_ = value;
+  return kFlutterSpiOk;
+}
