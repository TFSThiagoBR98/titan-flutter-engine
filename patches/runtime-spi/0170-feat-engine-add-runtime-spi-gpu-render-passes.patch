+FlutterSpiResult SpiGpuRenderPassCreate(FlutterSpiGpuRenderPass** out_pass) {
+  if (out_pass == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_pass = nullptr;
+  const uintptr_t handle = RenderPasses().Insert(
+      std::make_shared<SpiGpuRenderPass>());
+  if (handle == 0) {
+    return kFlutterSpiInternalError;
+  }
+  *out_pass = MakeHandle(handle);
+  return kFlutterSpiOk;
+}
