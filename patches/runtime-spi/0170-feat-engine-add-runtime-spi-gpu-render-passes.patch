+
+SpiHandleTable<SpiGpuRenderPass>& RenderPasses() {
+  return LeakedHandleTable<SpiGpuRenderPass>();
+}
+
+uintptr_t HandleValue(FlutterSpiGpuRenderPass* pass) {
+  return reinterpret_cast<uintptr_t>(pass);
+}
+
+FlutterSpiGpuRenderPass* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<FlutterSpiGpuRenderPass*>(value);
+}
+
+SpiGpuRenderPass* FindRenderPass(FlutterSpiGpuRenderPass* pass) {
+  return RenderPasses().FindRaw(HandleValue(pass));
+}
+
+bool HasFullStruct(size_t actual_size, size_t expected_size) {
+  return actual_size >= expected_size;
+}
+
+bool IsRenderStage(impeller::ShaderStage stage) {
+  return stage == impeller::ShaderStage::kVertex ||
+         stage == impeller::ShaderStage::kFragment;
+}
+
+}  // namespace
+
+SpiGpuRenderPass::SpiGpuRenderPass() = default;
+
+SpiGpuRenderPass::~SpiGpuRenderPass() {
+  ReleaseBoundPipeline();
+  ReleaseBoundSets();
+  ReleaseBoundShaders();
+}
+
+FlutterSpiResult SpiGpuRenderPass::ValidateDescriptorSize(
+    size_t actual_size,
+    size_t expected_size) const {
+  return HasFullStruct(actual_size, expected_size) ? kFlutterSpiOk
+                                                   : kFlutterSpiInvalidArgument;
+}
+
+void SpiGpuRenderPass::ReleaseBoundPipeline() {
+  if (pipeline_handle_ != nullptr) {
+    SpiGpuRenderPipelineRelease(pipeline_handle_);
+    pipeline_handle_ = nullptr;
+  }
+}
+
+void SpiGpuRenderPass::ReleaseBoundSets() {
+  for (auto& set : binding_set_handles_) {
+    if (set != nullptr) {
+      SpiGpuBindingSetRelease(set);
+      set = nullptr;
+    }
+  }
+}
+
+void SpiGpuRenderPass::ReleaseBoundShaders() {
+  for (FlutterSpiGpuShader* shader : shader_handles_) {
+    SpiGpuShaderRelease(shader);
+  }
+  shader_handles_.clear();
+}
+
+bool SpiGpuRenderPass::IsRenderStage(impeller::ShaderStage stage) const {
+  return ::flutter::IsRenderStage(stage);
+}
+
+FlutterSpiResult SpiGpuRenderPass::SetColorAttachment(
+    FlutterSpiGpuContext* context,
+    int32_t index,
+    const FlutterSpiGpuColorAttachment* attachment) {
+  if (context == nullptr || attachment == nullptr || index < 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (ValidateDescriptorSize(attachment->struct_size,
+                             sizeof(FlutterSpiGpuColorAttachment)) !=
+      kFlutterSpiOk) {
+    return kFlutterSpiInvalidArgument;
+  }
+  context_ = SpiGpuContextGetImpeller(context);
+  if (context_ == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  auto texture = SpiGpuTextureGetImpeller(attachment->texture);
+  if (texture == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+
+  impeller::ColorAttachment descriptor;
+  descriptor.load_action =
+      SpiGpuToImpellerLoadAction(attachment->load_action);
+  descriptor.store_action =
+      SpiGpuToImpellerStoreAction(attachment->store_action);
+  descriptor.clear_color = impeller::Color(
+      attachment->clear_color[0], attachment->clear_color[1],
+      attachment->clear_color[2], attachment->clear_color[3]);
+  descriptor.texture = std::move(texture);
+  descriptor.mip_level = attachment->mip_level;
+  descriptor.slice = attachment->slice;
+
+  if (attachment->resolve_texture != nullptr) {
+    descriptor.resolve_texture =
+        SpiGpuTextureGetImpeller(attachment->resolve_texture);
+    if (descriptor.resolve_texture == nullptr) {
+      return kFlutterSpiInvalidHandle;
+    }
+    auto& capabilities = context_->GetCapabilities();
+    if (!capabilities->SupportsOffscreenMSAA() &&
+        !capabilities->SupportsImplicitResolvingMSAA()) {
+      descriptor.texture = descriptor.resolve_texture;
+      descriptor.resolve_texture = nullptr;
+      descriptor.store_action = impeller::StoreAction::kStore;
+    }
+  }
+  render_target_.SetColorAttachment(std::move(descriptor),
+                                    static_cast<size_t>(index));
+  pipeline_state_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::SetDepthStencilAttachment(
+    const FlutterSpiGpuDepthStencilAttachment* attachment) {
+  if (attachment == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (ValidateDescriptorSize(attachment->struct_size,
+                             sizeof(FlutterSpiGpuDepthStencilAttachment)) !=
+      kFlutterSpiOk) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto texture = SpiGpuTextureGetImpeller(attachment->texture);
+  if (texture == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+
+  impeller::DepthAttachment depth;
+  depth.load_action =
+      SpiGpuToImpellerLoadAction(attachment->depth_load_action);
+  depth.store_action =
+      SpiGpuToImpellerStoreAction(attachment->depth_store_action);
+  depth.clear_depth = attachment->depth_clear_value;
+  depth.texture = texture;
+  depth.mip_level = attachment->mip_level;
+  depth.slice = attachment->slice;
+  render_target_.SetDepthAttachment(std::move(depth));
+
+  impeller::StencilAttachment stencil;
+  stencil.load_action =
+      SpiGpuToImpellerLoadAction(attachment->stencil_load_action);
+  stencil.store_action =
+      SpiGpuToImpellerStoreAction(attachment->stencil_store_action);
+  stencil.clear_stencil = attachment->stencil_clear_value;
+  stencil.texture = std::move(texture);
+  stencil.mip_level = attachment->mip_level;
+  stencil.slice = attachment->slice;
+  render_target_.SetStencilAttachment(std::move(stencil));
+  pipeline_state_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::Begin(
+    FlutterSpiGpuCommandBuffer* command_buffer) {
+  if (command_buffer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (begun_) {
+    return kFlutterSpiInvalidArgument;
+  }
+  SpiGpuCommandBuffer* command_buffer_value =
+      SpiGpuCommandBufferGetCore(command_buffer);
+  if (command_buffer_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  auto command_buffer_core = command_buffer_value->GetCommandBuffer();
+  if (command_buffer_core == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  render_pass_ = command_buffer_core->CreateRenderPass(render_target_);
+  if (render_pass_ == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  command_buffer_value->AddRenderPass(render_pass_);
+  begun_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::BindPipeline(
+    FlutterSpiGpuRenderPipeline* pipeline) {
+  if (pipeline == nullptr || SpiGpuRenderPipelineGetCore(pipeline) == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (pipeline_handle_ == pipeline) {
+    return kFlutterSpiOk;
+  }
+  if (SpiGpuRenderPipelineRetain(pipeline) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidHandle;
+  }
+  ReleaseBoundPipeline();
+  pipeline_handle_ = pipeline;
+  pipeline_state_dirty_ = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::BindVertexBuffer(
+    FlutterSpiGpuBuffer* buffer,
+    size_t offset,
+    size_t length,
+    int32_t slot) {
+  if (slot < 0 || static_cast<size_t>(slot) >= kMaxVertexBufferSlots) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto device_buffer = SpiGpuBufferGetImpeller(buffer);
+  if (device_buffer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  const size_t buffer_size = device_buffer->GetDeviceBufferDescriptor().size;
+  if (offset > buffer_size || length > buffer_size - offset) {
+    return kFlutterSpiInvalidArgument;
+  }
+  vertex_buffers_[slot] =
+      impeller::BufferView(device_buffer, impeller::Range(offset, length));
+  vertex_buffer_count_ =
+      std::max(vertex_buffer_count_, static_cast<size_t>(slot) + 1);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::BindIndexBuffer(
+    FlutterSpiGpuBuffer* buffer,
+    size_t offset,
+    size_t length,
+    int32_t index_type) {
+  auto device_buffer = SpiGpuBufferGetImpeller(buffer);
+  if (device_buffer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (index_type < kFlutterSpiGpuIndexType16Bit ||
+      index_type > kFlutterSpiGpuIndexType32Bit) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t buffer_size = device_buffer->GetDeviceBufferDescriptor().size;
+  if (offset > buffer_size || length > buffer_size - offset) {
+    return kFlutterSpiInvalidArgument;
+  }
+  index_buffer_ =
+      impeller::BufferView(device_buffer, impeller::Range(offset, length));
+  index_buffer_type_ = SpiGpuToImpellerIndexType(index_type);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::BindUniform(
+    FlutterSpiGpuShader* shader,
+    int32_t uniform_struct_index,
+    FlutterSpiGpuBuffer* buffer,
+    size_t offset,
+    size_t length) {
+  SpiGpuShader* shader_value = SpiGpuShaderGetCore(shader);
+  auto device_buffer = SpiGpuBufferGetImpeller(buffer);
+  if (shader_value == nullptr || device_buffer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!IsRenderStage(shader_value->GetShaderStage()) ||
+      shader_value->GetUniformStructAt(uniform_struct_index) == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t buffer_size = device_buffer->GetDeviceBufferDescriptor().size;
+  if (offset > buffer_size || length > buffer_size - offset) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (std::find(shader_handles_.begin(), shader_handles_.end(), shader) ==
+      shader_handles_.end()) {
+    if (SpiGpuShaderRetain(shader) != kFlutterSpiOk) {
+      return kFlutterSpiInvalidHandle;
+    }
+    shader_handles_.push_back(shader);
+  }
+  const SpiGpuShader::UniformBinding* uniform =
+      shader_value->GetUniformStructAt(uniform_struct_index);
+  BufferAndUniformSlot binding{
+      .slot = uniform->slot,
+      .view = {&uniform->metadata,
+               impeller::BufferView(device_buffer,
+                                    impeller::Range(offset, length))}};
+  auto& map = shader_value->GetShaderStage() == impeller::ShaderStage::kVertex
+                  ? vertex_uniform_bindings_
+                  : fragment_uniform_bindings_;
+  map.insert_or_assign(uniform, std::move(binding));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::BindTexture(
+    FlutterSpiGpuContext* context,
+    FlutterSpiGpuShader* shader,
+    int32_t uniform_texture_index,
+    FlutterSpiGpuTexture* texture,
+    const FlutterSpiGpuSamplerDescriptor* sampler) {
+  SpiGpuShader* shader_value = SpiGpuShaderGetCore(shader);
+  auto texture_value = SpiGpuTextureGetImpeller(texture);
+  if (shader_value == nullptr || texture_value == nullptr ||
+      SpiGpuContextGetImpeller(context) == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (sampler == nullptr || sampler->struct_size < sizeof(*sampler) ||
+      !IsRenderStage(shader_value->GetShaderStage())) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const SpiGpuShader::TextureBinding* binding =
+      shader_value->GetUniformTextureAt(uniform_texture_index);
+  if (binding == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto sampler_value = SpiGpuContextGetImpeller(context)
+                           ->GetSamplerLibrary()
+                           ->GetSampler(
+                               SpiGpuToImpellerSamplerDescriptor(*sampler));
+  if (!sampler_value) {
+    return kFlutterSpiInternalError;
+  }
+  if (std::find(shader_handles_.begin(), shader_handles_.end(), shader) ==
+      shader_handles_.end()) {
+    if (SpiGpuShaderRetain(shader) != kFlutterSpiOk) {
+      return kFlutterSpiInvalidHandle;
+    }
+    shader_handles_.push_back(shader);
+  }
+  impeller::TextureAndSampler value{
+      .slot = binding->slot,
+      .texture = {&binding->metadata, std::move(texture_value)},
+      .sampler = sampler_value,
+  };
+  auto& map = shader_value->GetShaderStage() == impeller::ShaderStage::kVertex
+                  ? vertex_texture_bindings_
+                  : fragment_texture_bindings_;
+  map.insert_or_assign(binding, std::move(value));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::BindSet(FlutterSpiGpuBindingSet* set,
+                                           int32_t slot) {
+  if (slot < 0 || static_cast<size_t>(slot) >= kMaxBindingSets) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (set == nullptr || SpiGpuBindingSetGetCore(set) == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (binding_set_handles_[slot] == set) {
+    return kFlutterSpiOk;
+  }
+  if (SpiGpuBindingSetRetain(set) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (binding_set_handles_[slot] != nullptr) {
+    SpiGpuBindingSetRelease(binding_set_handles_[slot]);
+  }
+  binding_set_handles_[slot] = set;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiGpuRenderPass::ClearBindings() {
+  vertex_uniform_bindings_.clear();
+  fragment_uniform_bindings_.clear();
+  vertex_texture_bindings_.clear();
+  fragment_texture_bindings_.clear();
+  std::fill(vertex_buffers_.begin(), vertex_buffers_.end(),
+            impeller::BufferView{});
+  vertex_buffer_count_ = 0;
+  index_buffer_ = {};
+  index_buffer_type_ = impeller::IndexType::kNone;
+  ReleaseBoundSets();
+  ReleaseBoundShaders();
+  return kFlutterSpiOk;
+}
