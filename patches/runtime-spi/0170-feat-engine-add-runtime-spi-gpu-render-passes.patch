+  ON_CALL(*context, GetResourceAllocator()).WillByDefault(Return(allocator));
+  ON_CALL(*allocator, OnCreateBuffer(::testing::_))
+      .WillByDefault(Return(device_buffer));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+
+  FlutterSpiGpuBufferDescriptor buffer_descriptor = {
+      .struct_size = sizeof(buffer_descriptor),
+      .storage_mode = kFlutterSpiGpuStorageModeHostVisible,
+      .size = 64,
+  };
+  FlutterSpiGpuBuffer* buffer = nullptr;
+  ASSERT_EQ(SpiGpuBufferCreate(gpu_context, &buffer_descriptor, &buffer),
+            kFlutterSpiOk);
+  FlutterSpiGpuBindingSet* binding_set = nullptr;
+  ASSERT_EQ(SpiGpuBindingSetCreate(&binding_set), kFlutterSpiOk);
+  FlutterSpiGpuRenderPass* render_pass = nullptr;
+  ASSERT_EQ(SpiGpuRenderPassCreate(&render_pass), kFlutterSpiOk);
+
+  EXPECT_EQ(SpiGpuRenderPassBindVertexBuffer(render_pass, buffer, 0, 1, 16),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuRenderPassBindSet(render_pass, binding_set, 4),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(SpiGpuRenderPassRelease(render_pass), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuBindingSetRelease(binding_set), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuBufferRelease(buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
