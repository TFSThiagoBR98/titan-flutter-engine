+std::shared_ptr<impeller::Pipeline<impeller::PipelineDescriptor>>
+SpiGpuRenderPass::GetOrCreatePipeline() {
+  if (!pipeline_state_dirty_) {
+    return memoized_pipeline_;
+  }
+  pipeline_state_dirty_ = false;
+  memoized_pipeline_ = nullptr;
+  if (context_ == nullptr || pipeline_handle_ == nullptr) {
+    return nullptr;
+  }
+
+  auto descriptor = pipeline_descriptor_;
+  descriptor.SetSampleCount(render_target_.GetSampleCount());
+  render_target_.IterateAllColorAttachments(
+      [&](size_t index, const impeller::ColorAttachment&) {
+        auto& color = color_descriptors_[index];
+        color.format = render_target_.GetRenderTargetPixelFormat();
+        return true;
+      });
+  descriptor.SetColorAttachmentDescriptors(color_descriptors_);
+
+  auto stencil = render_target_.GetStencilAttachment();
+  if (stencil && impeller::IsStencilWritable(
+                    stencil->texture->GetTextureDescriptor().format)) {
+    descriptor.SetStencilPixelFormat(
+        stencil->texture->GetTextureDescriptor().format);
+    descriptor.SetStencilAttachmentDescriptors(stencil_front_descriptor_,
+                                               stencil_back_descriptor_);
+  } else {
+    descriptor.ClearStencilAttachments();
+  }
+  auto depth = render_target_.GetDepthAttachment();
+  if (depth && impeller::IsDepthWritable(
+                   depth->texture->GetTextureDescriptor().format)) {
+    descriptor.SetDepthPixelFormat(depth->texture->GetTextureDescriptor().format);
+    descriptor.SetDepthStencilAttachmentDescriptor(depth_descriptor_);
+  } else {
+    descriptor.ClearDepthAttachment();
+  }
+
+  auto* pipeline = SpiGpuRenderPipelineGetCore(pipeline_handle_);
+  if (pipeline == nullptr || context_->GetShaderLibrary() == nullptr ||
+      !pipeline->BindToPipelineDescriptor(*context_->GetShaderLibrary(),
+                                           descriptor)) {
+    return nullptr;
+  }
+  auto result = context_->GetPipelineLibrary()->GetPipeline(descriptor).Get();
+  memoized_pipeline_ = result;
+  return result;
+}
+
+FlutterSpiResult SpiGpuRenderPass::Draw(uint32_t vertex_count,
+                                        uint32_t instance_count) {
+  if (!begun_ || render_pass_ == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (vertex_count == 0 || instance_count == 0) {
+    return kFlutterSpiOk;
+  }
+  auto pipeline = GetOrCreatePipeline();
+  if (pipeline == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  render_pass_->SetPipeline(impeller::PipelineRef(pipeline));
+  for (FlutterSpiGpuBindingSet* handle : binding_set_handles_) {
+    if (handle == nullptr) {
+      continue;
+    }
+    SpiGpuBindingSet* set = SpiGpuBindingSetGetCore(handle);
+    if (set == nullptr) {
+      return kFlutterSpiInvalidHandle;
+    }
+    for (const auto& binding : set->GetBufferBindings()) {
+      render_pass_->BindResource(binding.stage,
+                                 impeller::DescriptorType::kUniformBuffer,
+                                 binding.slot, binding.metadata, binding.view);
+    }
+    for (const auto& binding : set->GetTextureBindings()) {
+      render_pass_->BindResource(binding.stage,
+                                 impeller::DescriptorType::kSampledImage,
+                                 binding.slot, binding.metadata, binding.texture,
+                                 binding.sampler);
+    }
+  }
+  for (const auto& [_, binding] : vertex_uniform_bindings_) {
+    render_pass_->BindDynamicResource(
+        impeller::ShaderStage::kVertex,
+        impeller::DescriptorType::kUniformBuffer, binding.slot,
+        std::make_unique<impeller::ShaderMetadata>(*binding.view.GetMetadata()),
+        binding.view.resource);
+  }
+  for (const auto& [_, binding] : fragment_uniform_bindings_) {
+    render_pass_->BindDynamicResource(
+        impeller::ShaderStage::kFragment,
+        impeller::DescriptorType::kUniformBuffer, binding.slot,
+        std::make_unique<impeller::ShaderMetadata>(*binding.view.GetMetadata()),
+        binding.view.resource);
+  }
+  for (const auto& [_, binding] : vertex_texture_bindings_) {
+    render_pass_->BindDynamicResource(
+        impeller::ShaderStage::kVertex, impeller::DescriptorType::kSampledImage,
+        binding.slot,
+        std::make_unique<impeller::ShaderMetadata>(
+            *binding.texture.GetMetadata()),
+        binding.texture.resource, binding.sampler);
+  }
+  for (const auto& [_, binding] : fragment_texture_bindings_) {
+    render_pass_->BindDynamicResource(
+        impeller::ShaderStage::kFragment,
+        impeller::DescriptorType::kSampledImage, binding.slot,
+        std::make_unique<impeller::ShaderMetadata>(
+            *binding.texture.GetMetadata()),
+        binding.texture.resource, binding.sampler);
+  }
+  render_pass_->SetVertexBuffer(vertex_buffers_.data(), vertex_buffer_count_);
+  render_pass_->SetIndexBuffer({}, impeller::IndexType::kNone);
+  render_pass_->SetElementCount(vertex_count);
+  render_pass_->SetInstanceCount(instance_count);
+  render_pass_->SetStencilReference(stencil_reference_);
+  if (viewport_) {
+    render_pass_->SetViewport(*viewport_);
+  }
+  if (scissor_) {
+    render_pass_->SetScissor(*scissor_);
+  }
+  return render_pass_->Draw().ok() ? kFlutterSpiOk : kFlutterSpiInternalError;
+}
+
+FlutterSpiResult SpiGpuRenderPass::DrawIndexed(uint32_t index_count,
+                                               uint32_t instance_count) {
+  if (!begun_ || render_pass_ == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (index_buffer_type_ == impeller::IndexType::kNone) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (index_count == 0 || instance_count == 0) {
+    return kFlutterSpiOk;
+  }
+  auto pipeline = GetOrCreatePipeline();
+  if (pipeline == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  render_pass_->SetPipeline(impeller::PipelineRef(pipeline));
+  render_pass_->SetVertexBuffer(vertex_buffers_.data(), vertex_buffer_count_);
+  render_pass_->SetIndexBuffer(index_buffer_, index_buffer_type_);
+  render_pass_->SetElementCount(index_count);
+  render_pass_->SetInstanceCount(instance_count);
+  render_pass_->SetStencilReference(stencil_reference_);
+  if (viewport_) {
+    render_pass_->SetViewport(*viewport_);
+  }
+  if (scissor_) {
+    render_pass_->SetScissor(*scissor_);
+  }
+  return render_pass_->Draw().ok() ? kFlutterSpiOk : kFlutterSpiInternalError;
+}
