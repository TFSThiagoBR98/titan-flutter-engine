+FlutterSpiResult SpiGpuRenderPass::SetStencilConfig(
+    const FlutterSpiGpuStencilConfig* config) {
+  if (config == nullptr || config->struct_size < sizeof(*config)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  impeller::StencilAttachmentDescriptor descriptor;
+  descriptor.stencil_compare =
+      SpiGpuToImpellerCompareFunction(config->compare);
+  descriptor.stencil_failure =
+      SpiGpuToImpellerStencilOperation(config->stencil_fail);
+  descriptor.depth_failure =
+      SpiGpuToImpellerStencilOperation(config->depth_fail);
+  descriptor.depth_stencil_pass =
+      SpiGpuToImpellerStencilOperation(config->depth_stencil_pass);
+  descriptor.read_mask = config->read_mask;
+  descriptor.write_mask = config->write_mask;
+  if (config->face != kFlutterSpiGpuStencilFaceBack) {
+    stencil_front_descriptor_ = descriptor;
+  }
+  if (config->face != kFlutterSpiGpuStencilFaceFront) {
+    stencil_back_descriptor_ = descriptor;
+  }
+  pipeline_state_dirty_ = true;
+  return kFlutterSpiOk;
+}
