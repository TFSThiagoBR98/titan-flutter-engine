+FlutterSpiResult SpiGpuRenderPass::SetColorBlendEquation(
+    int32_t index,
+    const FlutterSpiGpuBlendEquation* equation) {
+  if (index < 0 || equation == nullptr || equation->struct_size < sizeof(*equation)) {
+    return equation == nullptr ? kFlutterSpiInvalidArgument
+                               : kFlutterSpiInvalidArgument;
+  }
+  auto& color = color_descriptors_[static_cast<size_t>(index)];
+  color.color_blend_op =
+      SpiGpuToImpellerBlendOperation(equation->color_operation);
+  color.src_color_blend_factor =
+      SpiGpuToImpellerBlendFactor(equation->source_color_factor);
+  color.dst_color_blend_factor =
+      SpiGpuToImpellerBlendFactor(equation->destination_color_factor);
+  color.alpha_blend_op =
+      SpiGpuToImpellerBlendOperation(equation->alpha_operation);
+  color.src_alpha_blend_factor =
+      SpiGpuToImpellerBlendFactor(equation->source_alpha_factor);
+  color.dst_alpha_blend_factor =
+      SpiGpuToImpellerBlendFactor(equation->destination_alpha_factor);
+  pipeline_state_dirty_ = true;
+  return kFlutterSpiOk;
+}
