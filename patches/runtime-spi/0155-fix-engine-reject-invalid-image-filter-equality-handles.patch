# Why: Preserve the ABI contract that every non-null unknown handle is
# invalid, including comparisons against null.
diff --git a/engine/src/flutter/runtime_spi/effects/spi_image_filter.cc b/engine/src/flutter/runtime_spi/effects/spi_image_filter.cc
index 91e3c3ec31e..c5f3b11e88c 100644
--- a/engine/src/flutter/runtime_spi/effects/spi_image_filter.cc
+++ b/engine/src/flutter/runtime_spi/effects/spi_image_filter.cc
@@ -194,15 +194,16 @@ FlutterSpiResult SpiImageFilterEquals(FlutterSpiImageFilter* a,
   if (out_equal == nullptr) {
     return kFlutterSpiInvalidArgument;
   }
+  const auto first = a == nullptr ? nullptr : SpiImageFilterGet(a);
+  const auto second = b == nullptr ? nullptr : SpiImageFilterGet(b);
+  if ((a != nullptr && first == nullptr) ||
+      (b != nullptr && second == nullptr)) {
+    return kFlutterSpiInvalidHandle;
+  }
   if (a == nullptr || b == nullptr) {
     *out_equal = a == b;
     return kFlutterSpiOk;
   }
-  const auto first = SpiImageFilterGet(a);
-  const auto second = SpiImageFilterGet(b);
-  if (first == nullptr || second == nullptr) {
-    return kFlutterSpiInvalidHandle;
-  }
   *out_equal = *first == *second;
   return kFlutterSpiOk;
 }
