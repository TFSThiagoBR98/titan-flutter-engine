# Why: The SPI created a backend render pass before ending the previous pass,
# which left Vulkan resolve state invalid when two render passes shared a
# command buffer. Create the pass through SpiGpuCommandBuffer so the previous
# pass is encoded first. Upstream: 1cc08bfe1b9
diff --git a/engine/src/flutter/runtime_spi/gpu/spi_gpu_command_buffer.cc b/engine/src/flutter/runtime_spi/gpu/spi_gpu_command_buffer.cc
index 8a273fb674a..871cb1382e8 100644
--- a/engine/src/flutter/runtime_spi/gpu/spi_gpu_command_buffer.cc
+++ b/engine/src/flutter/runtime_spi/gpu/spi_gpu_command_buffer.cc
@@ -111,13 +111,17 @@ SpiGpuCommandBuffer::GetCommandBuffer() {
   return command_buffer_;
 }
 
-bool SpiGpuCommandBuffer::AddRenderPass(
-    std::shared_ptr<impeller::RenderPass> render_pass) {
-  if (render_pass == nullptr || !EndOpenPass()) {
-    return false;
+std::shared_ptr<impeller::RenderPass> SpiGpuCommandBuffer::CreateRenderPass(
+    const impeller::RenderTarget& render_target) {
+  if (!EndOpenPass()) {
+    return nullptr;
   }
-  encodables_.push_back({.render_pass = std::move(render_pass)});
-  return true;
+  auto render_pass = command_buffer_->CreateRenderPass(render_target);
+  if (render_pass == nullptr) {
+    return nullptr;
+  }
+  encodables_.push_back({.render_pass = render_pass});
+  return render_pass;
 }
 
 bool SpiGpuCommandBuffer::EndOpenPass() {
