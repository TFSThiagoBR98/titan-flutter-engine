@@ -6,6 +6,7 @@
 
 #include "flutter/flow/layers/container_layer.h"
 #include "flutter/flow/layers/layer_tree.h"
+#include "flutter/runtime_spi/scene/spi_engine_layer.h"
 
 FlutterSpiResult SpiSceneCreateEmpty(int64_t width_px,
                                      int64_t height_px,
@@ -48,6 +49,26 @@ FlutterSpiResult SpiSceneCreateFromLayerTree(
   return kFlutterSpiOk;
 }
 
+FlutterSpiResult SpiSceneCreateFromRoot(FlutterSpiEngineLayer* root,
+                                        int64_t width_px,
+                                        int64_t height_px,
+                                        FlutterSpiScene** out_scene) {
+  const std::shared_ptr<flutter::Layer> root_layer = SpiEngineLayerGet(root);
+  if (root_layer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_scene == nullptr || width_px <= 0 || height_px <= 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto container_layer =
+      std::dynamic_pointer_cast<flutter::ContainerLayer>(root_layer);
+  if (container_layer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return SpiSceneCreateFromLayerTree(width_px, height_px, container_layer,
+                                     out_scene);
+}
+
 FlutterSpiResult SpiSceneRelease(FlutterSpiScene* scene) {
   delete scene;
   return kFlutterSpiOk;
