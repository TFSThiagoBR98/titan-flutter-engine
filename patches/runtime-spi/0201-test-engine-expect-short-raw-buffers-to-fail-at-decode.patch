# Why: Preserve the existing image descriptor contract that accepts a short
# raw buffer and reports the failure during codec decoding.
diff --git a/engine/src/flutter/runtime_spi/image/spi_image_codec_unittests.cc b/engine/src/flutter/runtime_spi/image/spi_image_codec_unittests.cc
index 427e5f98d99..385f7f39fb2 100644
--- a/engine/src/flutter/runtime_spi/image/spi_image_codec_unittests.cc
+++ b/engine/src/flutter/runtime_spi/image/spi_image_codec_unittests.cc
@@ -548,6 +548,40 @@ TEST_F(SpiImageCodecTest,
   ReleaseDescriptor(descriptor);
 }
 
+TEST_F(SpiImageCodecTest, SpiImageDescriptor_ShortRawBufferFailsAtDecode) {
+  StartShell();
+  const std::vector<uint8_t> pixels(1, 0x7f);
+  const FlutterSpiPixels raw_pixels = {
+      .struct_size = sizeof(FlutterSpiPixels),
+      .pixels = pixels.data(),
+      .pixels_size = pixels.size(),
+      .width = kImageWidth,
+      .height = kImageHeight,
+      .row_bytes = 0,
+      .pixel_format = kFlutterSpiPixelFormatRGBA8888,
+  };
+  const FlutterSpiImageApi* api = runtime_->engine_api->image;
+  ASSERT_NE(api, nullptr);
+  ASSERT_NE(api->image_descriptor_create_raw, nullptr);
+  FlutterSpiImageDescriptor* descriptor = nullptr;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    result = api->image_descriptor_create_raw(runtime_->engine, &raw_pixels,
+                                              &descriptor);
+  });
+  ASSERT_EQ(result, kFlutterSpiOk);
+  ASSERT_NE(descriptor, nullptr);
+
+  FlutterSpiCodec* codec = InstantiateCodec(descriptor, 0, 0);
+  ASSERT_NE(codec, nullptr);
+  FrameCallbackState frame;
+  ASSERT_EQ(GetNextFrame(codec, &frame), kFlutterSpiOk);
+  EXPECT_NE(frame.result, kFlutterSpiOk);
+  EXPECT_EQ(frame.image, nullptr);
+  ReleaseCodec(codec);
+  ReleaseDescriptor(descriptor);
+}
