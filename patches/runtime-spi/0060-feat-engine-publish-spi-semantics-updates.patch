+  }
+  const FlutterSpiResult result =
+      SpiSemantics::Api()->update_submit(builder, view_id);
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  runtime_delegate_.UpdateSemantics(view_id, std::move(builder->nodes),
+                                    std::move(builder->actions));
+  return kFlutterSpiOk;
+}
