+FlutterSpiResult SpiEngineApi::SemanticsUpdateBuilderCreate(
+    FlutterSpiEngine* engine,
+    FlutterSpiSemanticsUpdateBuilder** out_builder) {
+  if (engine == nullptr || engine->backend == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!engine->backend->HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  const FlutterSpiResult result =
+      SpiSemantics::Api()->update_builder_create(engine, out_builder);
+  if (result == kFlutterSpiOk) {
+    engine->backend->RegisterSemanticsBuilder(*out_builder);
+  }
+  return result;
+}
+
+FlutterSpiResult SpiEngineApi::SemanticsUpdateNode(
+    FlutterSpiSemanticsUpdateBuilder* builder,
+    const FlutterSpiSemanticsNode* node) {
+  SpiRuntimeBackend* backend = SpiRuntimeBackend::FindSemanticsBackend(builder);
+  if (backend == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!backend->HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  return SpiSemantics::Api()->update_node(builder, node);
+}
