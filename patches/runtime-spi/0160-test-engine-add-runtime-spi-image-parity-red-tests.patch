   EXPECT_EQ(height, kImageHeight);
 }
 
+TEST_F(SpiImageReadbackTest, CreateFromPixelsSyncMatchesAsync) {
+  StartShell();
+  constexpr uint8_t kPixels[] = {
+      0x10, 0x20, 0x30, 0xff,
+      0x40, 0x50, 0x60, 0xff,
+      0x70, 0x80, 0x90, 0xff,
+      0xa0, 0xb0, 0xc0, 0xff,
+  };
+  const FlutterSpiPixels input = {
+      .struct_size = sizeof(FlutterSpiPixels),
+      .pixels = kPixels,
+      .pixels_size = sizeof(kPixels),
+      .width = 2,
+      .height = 2,
+      .row_bytes = 0,
+      .pixel_format = kFlutterSpiPixelFormatRGBA8888,
+  };
+  FlutterSpiImage* synchronous_image = nullptr;
+  ImageCallbackState asynchronous_callback;
+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    ASSERT_EQ(runtime_->engine_api->image->image_create_from_pixels_sync(
+                  runtime_->engine, &input, nullptr, &synchronous_image),
+              kFlutterSpiOk);
+    ASSERT_EQ(runtime_->engine_api->image->image_create_from_pixels(
+                  runtime_->engine, &input, nullptr, CaptureDecodedImage,
+                  &asynchronous_callback),
+              kFlutterSpiOk);
+  });
+  asynchronous_callback.completed.Wait();
+  ASSERT_EQ(asynchronous_callback.result, kFlutterSpiOk);
+
+  BytesCallbackState synchronous_bytes;
+  BytesCallbackState asynchronous_bytes;
+  EXPECT_EQ(RequestBytes(synchronous_image, kFlutterSpiImageByteFormatRawRGBA,
+                         &synchronous_bytes),
+            kFlutterSpiOk);
+  EXPECT_EQ(RequestBytes(asynchronous_callback.image,
+                         kFlutterSpiImageByteFormatRawRGBA,
+                         &asynchronous_bytes),
+            kFlutterSpiOk);
+  EXPECT_EQ(synchronous_bytes.bytes, asynchronous_bytes.bytes);
+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    runtime_->engine_api->image->image_release(synchronous_image);
+    runtime_->engine_api->image->image_release(asynchronous_callback.image);
+  });
+}
