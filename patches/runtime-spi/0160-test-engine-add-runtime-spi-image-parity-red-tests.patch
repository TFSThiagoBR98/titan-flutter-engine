diff --git a/engine/src/flutter/runtime_spi/image/spi_image_snapshot_unittests.cc b/engine/src/flutter/runtime_spi/image/spi_image_snapshot_unittests.cc
index 030e107d269..1405ab00adf 100644
--- a/engine/src/flutter/runtime_spi/image/spi_image_snapshot_unittests.cc
+++ b/engine/src/flutter/runtime_spi/image/spi_image_snapshot_unittests.cc
@@ -7,6 +7,7 @@
 #include <chrono>
 #include <memory>
 #include <thread>
+#include <vector>
 
 #include "flutter/fml/synchronization/waitable_event.h"
 #include "flutter/fml/time/time_delta.h"
@@ -40,6 +41,24 @@ void CaptureImage(void* user_data,
   state->completed.Signal();
 }
 
+struct BytesCallbackState {
+  fml::AutoResetWaitableEvent completed;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  std::vector<uint8_t> bytes;
+};
+
+void CaptureBytes(void* user_data,
+                  FlutterSpiResult result,
+                  const uint8_t* bytes,
+                  size_t size) {
+  auto* state = static_cast<BytesCallbackState*>(user_data);
+  state->result = result;
+  if (bytes != nullptr) {
+    state->bytes.assign(bytes, bytes + size);
+  }
+  state->completed.Signal();
+}
+
 void PostSync(const fml::RefPtr<fml::TaskRunner>& task_runner,
               const fml::closure& task) {
   fml::AutoResetWaitableEvent completed;
@@ -194,6 +213,36 @@ TEST_F(SpiImageSnapshotTest, PictureToImageSyncIsDeferredAndDrawable) {
   });
 }
 
+TEST_F(SpiImageSnapshotTest, ToImageSyncHonorsPixelFormat) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  FlutterSpiImage* image = nullptr;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture();
+    ASSERT_EQ(runtime_->engine_api->image->picture_to_image_sync_with_format(
+                  runtime_->engine, picture, 1, 1,
+                  kFlutterSpiPixelFormatRFloat32, &image),
+              kFlutterSpiOk);
+  });
+
+  BytesCallbackState bytes;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    ASSERT_EQ(runtime_->engine_api->image->image_to_bytes(
+                  runtime_->engine, image,
+                  kFlutterSpiImageByteFormatRawUnmodified, CaptureBytes,
+                  &bytes),
+              kFlutterSpiOk);
+  });
+  bytes.completed.Wait();
+  ASSERT_EQ(bytes.result, kFlutterSpiOk);
+  EXPECT_EQ(bytes.bytes.size(), sizeof(float));
+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    runtime_->engine_api->image->image_release(image);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
