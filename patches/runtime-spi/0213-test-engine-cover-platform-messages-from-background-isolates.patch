+void _backgroundIsolatePlatformMessageMain(List<Object?> arguments) {
+  final RootIsolateToken token = arguments[0]! as RootIsolateToken;
+  final SendPort resultPort = arguments[1]! as SendPort;
+  PlatformDispatcher.instance.registerBackgroundIsolate(token);
+
+  final ReceivePort replyPort = ReceivePort();
+  replyPort.listen((Object? message) {
+    final List<Object?> response = message! as List<Object?>;
+    final Uint8List? bytes = response[1] as Uint8List?;
+    resultPort.send(
+      bytes != null && bytes.length == 2 && bytes[0] == 4 && bytes[1] == 5,
+    );
+    replyPort.close();
+  });
+
+  PlatformDispatcher.instance.sendPortPlatformMessage(
+    'titan/background',
+    ByteData.sublistView(Uint8List.fromList(<int>[1, 2, 3])),
+    1,
+    replyPort.sendPort,
+  );
+}
+
+@pragma('vm:entry-point')
+Future<void> backgroundIsolatePlatformMessage() async {
+  final ReceivePort resultPort = ReceivePort();
+  final Isolate isolate = await Isolate.spawn(
+    _backgroundIsolatePlatformMessageMain,
+    <Object?>[RootIsolateToken.instance!, resultPort.sendPort],
+  );
+  final bool result = await resultPort.first as bool;
+  resultPort.close();
+  isolate.kill();
+  notifyBackgroundReply(result);
+}
+
+@Native<Void Function(Bool)>(symbol: 'NotifyBackgroundReply')
+external void notifyBackgroundReply(bool result);
