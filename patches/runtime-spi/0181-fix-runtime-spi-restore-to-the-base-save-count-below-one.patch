+TEST_F(SpiCanvasTest, RestoreToCountBelowOneResetsStack) {
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(api()->recorder_create(engine(), nullptr, &recorder), kFlutterSpiOk);
+  for (int i = 0; i < 5; ++i) {
+    ASSERT_EQ(api()->canvas_save(recorder), kFlutterSpiOk);
+  }
+
+  int32_t count = 0;
+  ASSERT_EQ(api()->canvas_get_save_count(recorder, &count), kFlutterSpiOk);
+  EXPECT_EQ(count, 6);
+  ASSERT_EQ(api()->canvas_restore_to_count(recorder, 0), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_get_save_count(recorder, &count), kFlutterSpiOk);
+  EXPECT_EQ(count, 1);
+  EXPECT_EQ(api()->recorder_release(recorder), kFlutterSpiOk);
+}
