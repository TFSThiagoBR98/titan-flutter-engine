+  ASSERT_EQ(api->platform_message_sender_create(runtime->engine, &sender),
+            kFlutterSpiOk);
+  ASSERT_NE(sender, nullptr);
+
+  SenderReplyCapture reply;
+  std::atomic<FlutterSpiResult> result{kFlutterSpiInternalError};
+  std::thread worker([&] {
+    const uint8_t payload[] = {1, 2, 3};
+    result = api->platform_message_sender_send(
+        sender, "background", payload, sizeof(payload), CaptureSenderReply,
+        &reply);
