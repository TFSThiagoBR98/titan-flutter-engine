+class SpiPlatformMessageSenderResponse final : public PlatformMessageResponse {
+ public:
+  SpiPlatformMessageSenderResponse(
+      void (*on_reply)(void*, const uint8_t*, size_t),
+      void* user_data)
+      : on_reply_(on_reply), user_data_(user_data) {}
+
+  void Complete(std::unique_ptr<fml::Mapping> data) override {
+    std::vector<uint8_t> bytes;
+    if (data != nullptr && data->GetSize() != 0) {
+      bytes.assign(data->GetMapping(),
+                   data->GetMapping() + data->GetSize());
+    }
+    CompleteReply(std::move(bytes));
+  }
+
+  void CompleteEmpty() override { CompleteReply({}); }
+
+ private:
+  void CompleteReply(std::vector<uint8_t> data) {
+    if (completed_.exchange(true) || on_reply_ == nullptr) {
+      return;
+    }
+    const uint8_t* bytes = data.empty() ? nullptr : data.data();
+    on_reply_(user_data_, bytes, data.size());
+  }
+
+  void (*on_reply_)(void*, const uint8_t*, size_t) = nullptr;
+  void* user_data_ = nullptr;
+  std::atomic_bool completed_ = false;
+};
