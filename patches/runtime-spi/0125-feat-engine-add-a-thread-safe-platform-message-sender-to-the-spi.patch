+TEST_F(ShellTest, BackgroundIsolateSendsPlatformMessages) {
+  TaskRunners task_runners = GetTaskRunnersForFixture();
+  auto settings = CreateSettingsForFixture();
+  MockPlatformViewDelegate platform_view_delegate;
+  auto platform_message_handler =
+      std::make_shared<MockPlatformMessageHandler>();
+  fml::AutoResetWaitableEvent reply_latch;
+  std::atomic<bool> background_message_valid{false};
+  bool reply_received = false;
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"  // Justification: Task 1 explicitly requires WillRepeatedly(Invoke(...)).
+  EXPECT_CALL(*platform_message_handler, HandlePlatformMessage(_))
+      .WillRepeatedly(Invoke([&](std::unique_ptr<PlatformMessage> message) {
+        if (message->channel() != "titan/background") {
+          if (auto response = message->response()) {
+            response->CompleteEmpty();
+          }
+          return;
+        }
+
+        const bool received_expected_message =
+            std::vector<uint8_t>(message->data().GetMapping(),
+                                 message->data().GetMapping() +
+                                     message->data().GetSize()) ==
+                std::vector<uint8_t>{1, 2, 3} &&
+            !task_runners.GetUITaskRunner()->RunsTasksOnCurrentThread() &&
+            !task_runners.GetPlatformTaskRunner()->RunsTasksOnCurrentThread();
+        background_message_valid.store(received_expected_message);
+
+        const std::array<uint8_t, 2> reply = {4, 5};
+        if (auto response = message->response()) {
+          response->Complete(std::make_unique<fml::MallocMapping>(
+              fml::MallocMapping::Copy(reply.data(),
+                                       reply.data() + reply.size())));
+        }
+      }));
+#pragma clang diagnostic pop
+
+  Shell::CreateCallback<PlatformView> platform_view_create_callback =
+      [&platform_view_delegate, task_runners,
+       platform_message_handler](flutter::Shell& shell) {
+        auto result = std::make_unique<MockPlatformView>(platform_view_delegate,
+                                                         task_runners);
+        EXPECT_CALL(*result, GetPlatformMessageHandler())
+            .WillOnce(Return(platform_message_handler));
+        return result;
+      };
+  auto shell = CreateShell({
+      .settings = settings,
+      .task_runners = task_runners,
+      .platform_view_create_callback = platform_view_create_callback,
+  });
+
+  AddFfiNativeCallback(
+      "NotifyBackgroundReply",
+      CREATE_FFI_LAMBDA([&](bool result) {
+        reply_received = result;
+        reply_latch.Signal();
+      }));
+  auto configuration = RunConfiguration::InferFromSettings(settings);
+  ASSERT_TRUE(configuration.IsValid());
+  configuration.SetEntrypoint("backgroundIsolatePlatformMessage");
+  RunEngine(shell.get(), std::move(configuration));
+
+  const bool timed_out =
+      reply_latch.WaitWithTimeout(fml::TimeDelta::FromSeconds(10));
+  ASSERT_FALSE(timed_out);
+  EXPECT_TRUE(background_message_valid.load());
+  DestroyShell(std::move(shell));
+}
