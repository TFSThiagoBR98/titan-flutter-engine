+TEST(SpiHandleTable, FindRawFindsHandlesAcrossSegments) {
+  constexpr int kValueCount = 10000;
+
+  SpiHandleTable<int> table;
+  std::vector<uintptr_t> handles;
+  handles.reserve(kValueCount);
+  for (int value = 0; value < kValueCount; value++) {
+    const uintptr_t handle = table.Insert(std::make_shared<int>(value));
+    ASSERT_NE(handle, 0u);
+    handles.push_back(handle);
+  }
+
+  for (int value = 0; value < kValueCount; value++) {
+    ASSERT_NE(table.FindRaw(handles[value]), nullptr);
+    EXPECT_EQ(*table.FindRaw(handles[value]), value);
+  }
+
+  for (int value = 0; value < kValueCount; value += 2) {
+    EXPECT_TRUE(table.Release(handles[value]));
+  }
+  for (int value = 0; value < kValueCount; value++) {
+    if (value % 2 == 0) {
+      EXPECT_EQ(table.FindRaw(handles[value]), nullptr);
+    } else {
+      ASSERT_NE(table.FindRaw(handles[value]), nullptr);
+      EXPECT_EQ(*table.FindRaw(handles[value]), value);
+    }
+  }
+  for (int value = 1; value < kValueCount; value += 2) {
+    EXPECT_TRUE(table.Release(handles[value]));
+  }
+}
+
+TEST(SpiHandleTable, FindRawRejectsAReusedSlotWithTheOldHandle) {
+  SpiHandleTable<int> table;
