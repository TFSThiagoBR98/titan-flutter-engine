+
+  ASSERT_NE(old_handle, 0u);
+  EXPECT_TRUE(table.Release(old_handle));
+
+  const uintptr_t new_handle = table.Insert(std::make_shared<int>(2));
+
+  ASSERT_NE(new_handle, 0u);
+  EXPECT_EQ(table.FindRaw(old_handle), nullptr);
+  ASSERT_NE(table.FindRaw(new_handle), nullptr);
+  EXPECT_EQ(*table.FindRaw(new_handle), 2);
+  EXPECT_TRUE(table.Release(new_handle));
+}
