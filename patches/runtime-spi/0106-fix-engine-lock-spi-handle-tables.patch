+TEST(SpiHandleTable, FindRawWhileOtherThreadsGrowTheTable) {
+  constexpr int kReaderCount = 4;
+  constexpr int kWriterCount = 4;
+  constexpr int kStableHandleCount = 64;
+  constexpr int kValuesPerWriter = 3000;
+  constexpr int kThreadCount = kReaderCount + kWriterCount;
+
+  SpiHandleTable<int> table;
+  std::vector<std::shared_ptr<int>> stable_values;
+  std::vector<uintptr_t> stable_handles;
+  stable_values.reserve(kStableHandleCount);
+  stable_handles.reserve(kStableHandleCount);
+  for (int value = 0; value < kStableHandleCount; value++) {
+    stable_values.push_back(std::make_shared<int>(value));
+    const uintptr_t handle = table.Insert(stable_values.back());
+    ASSERT_NE(handle, 0u);
+    stable_handles.push_back(handle);
+  }
+
+  std::atomic<int> ready_threads = 0;
+  std::atomic<int> writers_ready = 0;
+  std::atomic<int> readers_observed = 0;
+  std::atomic<bool> start = false;
+  std::atomic<bool> release_writers = false;
+  std::atomic<bool> failed = false;
+  std::vector<std::thread> threads;
+  threads.reserve(kThreadCount);
+
+  for (int reader_index = 0; reader_index < kReaderCount; reader_index++) {
+    threads.emplace_back([&table, &stable_handles, &stable_values,
+                          &ready_threads, &writers_ready, &readers_observed,
+                          &start, &release_writers, &failed]() {
+      ready_threads.fetch_add(1, std::memory_order_relaxed);
+      while (!start.load(std::memory_order_acquire)) {
+        std::this_thread::yield();
+      }
+
+      bool observed_growth = false;
+      while (!release_writers.load(std::memory_order_acquire)) {
+        for (std::size_t value = 0; value < stable_handles.size(); value++) {
+          if (table.FindRaw(stable_handles[value]) !=
+              stable_values[value].get()) {
+            failed.store(true, std::memory_order_relaxed);
+          }
+        }
+        if (!observed_growth &&
+            writers_ready.load(std::memory_order_acquire) == kWriterCount) {
+          observed_growth = true;
+          readers_observed.fetch_add(1, std::memory_order_release);
+        }
+      }
+    });
+  }
+
+  for (int writer_index = 0; writer_index < kWriterCount; writer_index++) {
+    threads.emplace_back([&table, &ready_threads, &writers_ready, &start,
+                          &release_writers, writer_index]() {
+      ready_threads.fetch_add(1, std::memory_order_relaxed);
+      while (!start.load(std::memory_order_acquire)) {
+        std::this_thread::yield();
+      }
+
+      std::vector<uintptr_t> handles;
+      handles.reserve(kValuesPerWriter);
+      for (int value = 0; value < kValuesPerWriter; value++) {
+        const uintptr_t handle =
+            table.Insert(std::make_shared<int>(writer_index));
+        if (handle != 0u) {
+          handles.push_back(handle);
+        }
+      }
+      writers_ready.fetch_add(1, std::memory_order_release);
+      while (!release_writers.load(std::memory_order_acquire)) {
+        std::this_thread::yield();
+      }
+      for (const uintptr_t handle : handles) {
+        table.Release(handle);
+      }
+    });
+  }
+
+  while (ready_threads.load(std::memory_order_acquire) != kThreadCount) {
+    std::this_thread::yield();
+  }
+  start.store(true, std::memory_order_release);
+
+  while (writers_ready.load(std::memory_order_acquire) != kWriterCount ||
+         readers_observed.load(std::memory_order_acquire) != kReaderCount) {
+    std::this_thread::yield();
+  }
+  EXPECT_GT(table.size(), 10000u);
+  release_writers.store(true, std::memory_order_release);
+
+  for (auto& thread : threads) {
+    thread.join();
+  }
+
+  EXPECT_FALSE(failed.load(std::memory_order_relaxed));
+  EXPECT_EQ(table.size(), static_cast<std::size_t>(kStableHandleCount));
+  for (const uintptr_t handle : stable_handles) {
+    EXPECT_TRUE(table.Release(handle));
+  }
+  EXPECT_EQ(table.size(), 0u);
+}
+
+class ReentrantValue final {
+ public:
+  ReentrantValue(SpiHandleTable<ReentrantValue>* table,
+                 std::atomic<uintptr_t>* inserted_handle,
+                 bool insert_on_destroy)
+      : table_(table),
+        inserted_handle_(inserted_handle),
+        insert_on_destroy_(insert_on_destroy) {}
+
+  ~ReentrantValue() {
+    if (insert_on_destroy_) {
+      inserted_handle_->store(
+          table_->Insert(std::make_shared<ReentrantValue>(
+              table_, inserted_handle_, false)),
+          std::memory_order_relaxed);
+    }
+  }
+
+ private:
+  SpiHandleTable<ReentrantValue>* table_;
+  std::atomic<uintptr_t>* inserted_handle_;
+  bool insert_on_destroy_;
+};
+
+TEST(SpiHandleTable, ReleaseDestroysOutsideTheLock) {
+  SpiHandleTable<ReentrantValue> table;
+  std::atomic<uintptr_t> inserted_handle = 0;
+  const uintptr_t handle = table.Insert(std::make_shared<ReentrantValue>(
+      &table, &inserted_handle, true));
+
+  ASSERT_NE(handle, 0u);
+  EXPECT_TRUE(table.Release(handle));
+
+  const uintptr_t reentrant_handle =
+      inserted_handle.load(std::memory_order_relaxed);
+  ASSERT_NE(reentrant_handle, 0u);
+  EXPECT_EQ(table.size(), 1u);
+  EXPECT_TRUE(table.Release(reentrant_handle));
+  EXPECT_EQ(table.size(), 0u);
+}
