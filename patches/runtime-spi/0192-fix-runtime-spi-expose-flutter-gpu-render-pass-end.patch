+FlutterSpiResult SpiGpuRenderPass::End() {
+  if (!begun_) {
+    return kFlutterSpiOk;
+  }
+  if (command_buffer_ == nullptr || render_pass_ == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!command_buffer_->EndRenderPass(render_pass_)) {
+    return kFlutterSpiInternalError;
+  }
+  begun_ = false;
+  command_buffer_ = nullptr;
+  render_pass_.reset();
+  return kFlutterSpiOk;
+}
