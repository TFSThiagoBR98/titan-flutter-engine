+TEST_F(SpiGpuContextTest, RenderPassEndIsIdempotentAndStopsDrawing) {
+  std::shared_ptr<const impeller::Capabilities> capabilities;
+  auto context = CreateMockContext(&capabilities);
+  auto command_buffer =
+      std::make_shared<NiceMock<impeller::testing::MockCommandBuffer>>(context);
+  auto impeller_render_pass =
+      std::make_shared<NiceMock<impeller::testing::MockRenderPass>>(
+          context, impeller::RenderTarget{});
+  const std::weak_ptr<impeller::CommandBuffer> weak_command_buffer =
+      command_buffer;
+  const std::weak_ptr<impeller::RenderPass> weak_render_pass =
+      impeller_render_pass;
+  ON_CALL(*context, CreateCommandBuffer())
+      .WillByDefault([weak_command_buffer]() {
+        return weak_command_buffer.lock();
+      });
+  ON_CALL(*command_buffer, IsValid()).WillByDefault(Return(true));
+  ON_CALL(*command_buffer, OnCreateRenderPass(::testing::_))
+      .WillByDefault([weak_render_pass](impeller::RenderTarget) {
+        return weak_render_pass.lock();
+      });
+  ON_CALL(*impeller_render_pass, IsValid()).WillByDefault(Return(true));
+  ON_CALL(*impeller_render_pass, OnEncodeCommands)
+      .WillByDefault(Return(true));
+  SpiGpuSetDefaultContextOverride(context);
+  auto backend = CreateBackend(true, true);
+  FlutterSpiGpuContext* gpu_context = GetDefaultContext(backend.get());
+  FlutterSpiGpuCommandBuffer* gpu_command_buffer = nullptr;
+  ASSERT_EQ(SpiGpuCommandBufferCreate(gpu_context, &gpu_command_buffer),
+            kFlutterSpiOk);
+  FlutterSpiGpuRenderPass* render_pass = nullptr;
+  ASSERT_EQ(SpiGpuRenderPassCreate(&render_pass), kFlutterSpiOk);
+  ASSERT_EQ(SpiGpuRenderPassBegin(render_pass, gpu_command_buffer),
+            kFlutterSpiOk);
+
+  EXPECT_EQ(SpiGpuRenderPassEnd(render_pass), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuRenderPassEnd(render_pass), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuRenderPassDraw(render_pass, 3, 1),
+            kFlutterSpiInvalidArgument);
+
+  EXPECT_EQ(SpiGpuRenderPassRelease(render_pass), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuCommandBufferRelease(gpu_command_buffer), kFlutterSpiOk);
+  EXPECT_EQ(SpiGpuContextRelease(gpu_context), kFlutterSpiOk);
+}
