+FlutterSpiResult SpiSceneCreateFromRoot(FlutterSpiEngineLayer* root,
+                                        int64_t width_px,
+                                        int64_t height_px,
+                                        FlutterSpiScene** out_scene) {
+  const std::shared_ptr<flutter::Layer> root_layer =
+      flutter::SpiEngineLayerGet(root);
+  if (root_layer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_scene == nullptr || width_px <= 0 || height_px <= 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const flutter::ContainerLayer* container_layer =
+      root_layer->as_container_layer();
+  if (container_layer == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  return SpiSceneCreateFromLayerTree(
+      width_px, height_px,
+      std::shared_ptr<flutter::ContainerLayer>(
+          root_layer, const_cast<flutter::ContainerLayer*>(container_layer)),
+      out_scene);
+}
+
 FlutterSpiResult SpiSceneRelease(FlutterSpiScene* scene) {
   delete scene;
   return kFlutterSpiOk;
