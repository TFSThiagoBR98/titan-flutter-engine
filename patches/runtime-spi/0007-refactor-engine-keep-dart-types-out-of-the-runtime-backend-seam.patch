+DartRuntimeBackend::DartRuntimeBackend(
+    std::unique_ptr<RuntimeController> controller)
+    : controller_(std::move(controller)) {}
+
+DartRuntimeBackend::~DartRuntimeBackend() = default;
+
+std::unique_ptr<RuntimeBackend> DartRuntimeBackend::Clone() const {
+  return std::make_unique<DartRuntimeBackend>(controller_->Clone());
+}
+
+bool DartRuntimeBackend::Launch(
+    RunConfiguration&& configuration,
+    const Settings& settings,
+    const fml::closure& root_isolate_create_callback,
+    std::optional<int64_t> engine_id) {
+  std::shared_ptr<NativeAssetsManager> native_assets_manager;
+  if (auto asset_manager = configuration.GetAssetManager()) {
+    native_assets_manager = std::make_shared<NativeAssetsManager>();
+    native_assets_manager->RegisterNativeAssets(asset_manager);
+  }
+
+  return LaunchRootIsolate(
+      settings, root_isolate_create_callback, configuration.GetEntrypoint(),
+      configuration.GetEntrypointLibrary(), configuration.GetEntrypointArgs(),
+      configuration.TakeIsolateConfiguration(),
+      std::move(native_assets_manager), engine_id);
+}
+
+void DartRuntimeBackend::AddView(int64_t view_id,
+                                 const ViewportMetrics& view_metrics,
+                                 AddViewCallback callback) {
+  controller_->AddView(view_id, view_metrics, std::move(callback));
+}
+
+bool DartRuntimeBackend::RemoveView(int64_t view_id) {
+  return controller_->RemoveView(view_id);
+}
+
+bool DartRuntimeBackend::SetViewportMetrics(int64_t view_id,
+                                            const ViewportMetrics& metrics) {
+  return controller_->SetViewportMetrics(view_id, metrics);
+}
+
+bool DartRuntimeBackend::SetDisplays(const std::vector<DisplayData>& displays) {
+  return controller_->SetDisplays(displays);
+}
+
+bool DartRuntimeBackend::BeginFrame(fml::TimePoint frame_time,
+                                    uint64_t frame_number) {
+  return controller_->BeginFrame(frame_time, frame_number);
+}
+
+bool DartRuntimeBackend::DispatchPlatformMessage(
+    std::unique_ptr<PlatformMessage> message) {
+  return controller_->DispatchPlatformMessage(std::move(message));
+}
+
+bool DartRuntimeBackend::DispatchPointerDataPacket(
+    const PointerDataPacket& packet) {
+  return controller_->DispatchPointerDataPacket(packet);
+}
+
+bool DartRuntimeBackend::DispatchSemanticsAction(int64_t view_id,
+                                                 int32_t node_id,
+                                                 SemanticsAction action,
+                                                 fml::MallocMapping args) {
+  return controller_->DispatchSemanticsAction(view_id, node_id, action,
+                                              std::move(args));
+}
+
+bool DartRuntimeBackend::SetSemanticsEnabled(bool enabled) {
+  return controller_->SetSemanticsEnabled(enabled);
+}
+
+bool DartRuntimeBackend::SetAccessibilityFeatures(int32_t flags) {
+  return controller_->SetAccessibilityFeatures(flags);
+}
+
+bool DartRuntimeBackend::SetLocales(
+    const std::vector<std::string>& locale_data) {
+  return controller_->SetLocales(locale_data);
+}
+
+bool DartRuntimeBackend::SetUserSettingsData(const std::string& data) {
+  return controller_->SetUserSettingsData(data);
+}
+
+bool DartRuntimeBackend::SetInitialLifecycleState(const std::string& data) {
+  return controller_->SetInitialLifecycleState(data);
+}
+
+bool DartRuntimeBackend::SendViewFocusEvent(const ViewFocusEvent& event) {
+  return controller_->SendViewFocusEvent(event);
+}
+
+bool DartRuntimeBackend::NotifyIdle(fml::TimeDelta deadline) {
+  return controller_->NotifyIdle(deadline);
+}
+
+bool DartRuntimeBackend::ReportTimings(std::vector<int64_t> timings) {
+  return controller_->ReportTimings(std::move(timings));
+}
+
+HitTestResponse DartRuntimeBackend::HitTest(int64_t view_id, PointData offset) {
+  return controller_->HitTest(view_id, offset);
+}
+
+bool DartRuntimeBackend::IsRunning() const {
+  return controller_->IsRootIsolateRunning();
+}
+
+std::unique_ptr<RuntimeBackend> DartRuntimeBackend::Spawn(
+    RuntimeDelegate& p_client,
+    const std::string& advisory_script_uri,
+    const std::string& advisory_script_entrypoint,
+    const std::function<void(int64_t)>& idle_notification_callback,
+    const fml::closure& isolate_create_callback,
+    const fml::closure& isolate_shutdown_callback,
+    const std::shared_ptr<const fml::Mapping>& persistent_isolate_data,
+    fml::WeakPtr<IOManager> io_manager,
+    fml::TaskRunnerAffineWeakPtr<ImageDecoder> image_decoder,
+    fml::TaskRunnerAffineWeakPtr<ImageGeneratorRegistry>
+        image_generator_registry,
+    fml::TaskRunnerAffineWeakPtr<SnapshotDelegate> snapshot_delegate) const {
+  return std::make_unique<DartRuntimeBackend>(controller_->Spawn(
+      p_client, advisory_script_uri, advisory_script_entrypoint,
+      idle_notification_callback, isolate_create_callback,
+      isolate_shutdown_callback, persistent_isolate_data, std::move(io_manager),
+      std::move(image_decoder), std::move(image_generator_registry),
+      std::move(snapshot_delegate)));
+}
