+int64_t DartRuntimeBackend::GetMainPort() {
+  return controller_->GetMainPort();
+}
+
+std::string DartRuntimeBackend::GetIsolateName() {
+  return controller_->GetIsolateName();
+}
+
+std::optional<std::string> DartRuntimeBackend::GetRootIsolateServiceID() const {
+  return controller_->GetRootIsolateServiceID();
+}
+
+std::optional<uint32_t> DartRuntimeBackend::GetRootIsolateReturnCode() {
+  return controller_->GetRootIsolateReturnCode();
+}
+
+bool DartRuntimeBackend::HasLivePorts() {
