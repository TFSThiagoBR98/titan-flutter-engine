+void DartRuntimeBackend::ShutdownPlatformIsolates() {
+  controller_->ShutdownPlatformIsolates();
+}
+
+void DartRuntimeBackend::SetRootIsolateOwnerToCurrentThread() {
+  controller_->SetRootIsolateOwnerToCurrentThread();
+}
