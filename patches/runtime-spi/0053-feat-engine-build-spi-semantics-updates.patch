+void ExpectSameAttributes(const StringAttributes& expected,
+                          const StringAttributes& actual) {
+  ASSERT_EQ(actual.size(), expected.size());
+  for (size_t index = 0; index < expected.size(); index++) {
+    ASSERT_EQ(actual[index]->start, expected[index]->start);
+    ASSERT_EQ(actual[index]->end, expected[index]->end);
+    ASSERT_EQ(actual[index]->type, expected[index]->type);
+    if (expected[index]->type == StringAttributeType::kLocale) {
+      const auto expected_locale =
+          std::static_pointer_cast<LocaleStringAttribute>(expected[index]);
+      const auto actual_locale =
+          std::static_pointer_cast<LocaleStringAttribute>(actual[index]);
+      ASSERT_EQ(actual_locale->locale, expected_locale->locale);
+    }
+  }
+}
