+bool HasField(size_t struct_size, size_t offset, size_t field_size) {
+  return struct_size >= offset && struct_size - offset >= field_size;
+}
+
+bool IsValidUtf8(const char* value) {
+  if (value == nullptr) {
+    return true;
+  }
+  UErrorCode error = U_ZERO_ERROR;
+  int32_t utf16_length = 0;
+  u_strFromUTF8(nullptr, 0, &utf16_length, value, -1, &error);
+  return U_SUCCESS(error) || error == U_BUFFER_OVERFLOW_ERROR;
+}
+
+FlutterSpiResult AssignString(const char* value, std::string* output) {
+  if (!IsValidUtf8(value)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *output = value == nullptr ? std::string() : value;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CopyAttributes(const FlutterSpiAttributedString& input,
+                                std::string* text,
+                                StringAttributes* attributes) {
+  FlutterSpiResult result = AssignString(input.text, text);
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  if (input.attribute_count != 0 && input.attributes == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  attributes->clear();
+  attributes->reserve(input.attribute_count);
+  for (size_t index = 0; index < input.attribute_count; index++) {
+    const FlutterSpiStringAttribute& input_attribute = input.attributes[index];
+    StringAttributePtr attribute;
+    if (input_attribute.type == kFlutterSpiStringAttributeSpellOut) {
+      attribute = std::make_shared<SpellOutStringAttribute>();
+    } else if (input_attribute.type == kFlutterSpiStringAttributeLocale) {
+      auto locale_attribute = std::make_shared<LocaleStringAttribute>();
+      result = AssignString(input_attribute.locale, &locale_attribute->locale);
+      if (result != kFlutterSpiOk) {
+        return result;
+      }
+      attribute = std::move(locale_attribute);
+    } else {
+      return kFlutterSpiInvalidArgument;
+    }
+    attribute->start = input_attribute.start;
+    attribute->end = input_attribute.end;
+    attribute->type = static_cast<StringAttributeType>(input_attribute.type);
+    attributes->push_back(std::move(attribute));
+  }
+  return kFlutterSpiOk;
+}
+
+void CopyFlags(const FlutterSpiSemanticsFlags& input, SemanticsFlags* output) {
+  const size_t size = input.struct_size;
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_checked),
+               sizeof(input.is_checked))) {
+    output->isChecked = static_cast<SemanticsCheckState>(input.is_checked);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_selected),
+               sizeof(input.is_selected))) {
+    output->isSelected = static_cast<SemanticsTristate>(input.is_selected);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_enabled),
+               sizeof(input.is_enabled))) {
+    output->isEnabled = static_cast<SemanticsTristate>(input.is_enabled);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_toggled),
+               sizeof(input.is_toggled))) {
+    output->isToggled = static_cast<SemanticsTristate>(input.is_toggled);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_expanded),
+               sizeof(input.is_expanded))) {
+    output->isExpanded = static_cast<SemanticsTristate>(input.is_expanded);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_required),
+               sizeof(input.is_required))) {
+    output->isRequired = static_cast<SemanticsTristate>(input.is_required);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_focused),
+               sizeof(input.is_focused))) {
+    output->isFocused = static_cast<SemanticsTristate>(input.is_focused);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_button),
+               sizeof(input.is_button))) {
+    output->isButton = input.is_button;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_text_field),
+               sizeof(input.is_text_field))) {
+    output->isTextField = input.is_text_field;
+  }
+  if (HasField(size,
+               offsetof(FlutterSpiSemanticsFlags, is_in_mutually_exclusive_group),
+               sizeof(input.is_in_mutually_exclusive_group))) {
+    output->isInMutuallyExclusiveGroup = input.is_in_mutually_exclusive_group;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_header),
+               sizeof(input.is_header))) {
+    output->isHeader = input.is_header;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_obscured),
+               sizeof(input.is_obscured))) {
+    output->isObscured = input.is_obscured;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, scopes_route),
+               sizeof(input.scopes_route))) {
+    output->scopesRoute = input.scopes_route;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, names_route),
+               sizeof(input.names_route))) {
+    output->namesRoute = input.names_route;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_hidden),
+               sizeof(input.is_hidden))) {
+    output->isHidden = input.is_hidden;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_image),
+               sizeof(input.is_image))) {
+    output->isImage = input.is_image;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_live_region),
+               sizeof(input.is_live_region))) {
+    output->isLiveRegion = input.is_live_region;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, has_implicit_scrolling),
+               sizeof(input.has_implicit_scrolling))) {
+    output->hasImplicitScrolling = input.has_implicit_scrolling;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_multiline),
+               sizeof(input.is_multiline))) {
+    output->isMultiline = input.is_multiline;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_read_only),
+               sizeof(input.is_read_only))) {
+    output->isReadOnly = input.is_read_only;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_link),
+               sizeof(input.is_link))) {
+    output->isLink = input.is_link;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_slider),
+               sizeof(input.is_slider))) {
+    output->isSlider = input.is_slider;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsFlags, is_keyboard_key),
