+  ASSERT_EQ(api->update_node(builder, &second), kFlutterSpiOk);
+  ASSERT_EQ(builder->nodes.size(), 1u);
+  EXPECT_EQ(builder->nodes.at(3).label, "second");
+  EXPECT_EQ(api->update_builder_release(builder), kFlutterSpiOk);
+}
