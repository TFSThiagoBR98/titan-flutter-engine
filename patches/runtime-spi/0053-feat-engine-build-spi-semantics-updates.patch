+template <typename T>
+void CopyVector(const T* input, size_t count, std::vector<T>* output) {
+  output->clear();
+  if (count == 0) {
+    return;
+  }
+  output->assign(input, input + count);
+}
+
+FlutterSpiResult UpdateNode(FlutterSpiSemanticsUpdateBuilder* builder,
+                            const FlutterSpiSemanticsNode* input) {
+  if (builder == nullptr || builder->consumed) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (input == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  SemanticsNode node;
+  FlutterSpiResult result = SpiSemanticsToNode(*input, &node);
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  builder->nodes[node.id] = std::move(node);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult UpdateCustomAction(
+    FlutterSpiSemanticsUpdateBuilder* builder,
+    const FlutterSpiSemanticsCustomAction* input) {
+  if (builder == nullptr || builder->consumed) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (input == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  CustomAccessibilityAction action;
+  FlutterSpiResult result = SpiSemanticsToAction(*input, &action);
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  builder->actions[action.id] = std::move(action);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CreateBuilder(FlutterSpiEngine* engine,
+                               FlutterSpiSemanticsUpdateBuilder** output) {
+  if (engine == nullptr || output == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *output = new (std::nothrow) FlutterSpiSemanticsUpdateBuilder();
+  return *output == nullptr ? kFlutterSpiInternalError : kFlutterSpiOk;
+}
+
+FlutterSpiResult SubmitBuilder(FlutterSpiSemanticsUpdateBuilder* builder,
+                               int64_t view_id) {
+  (void)view_id;
+  if (builder == nullptr || builder->consumed) {
+    return kFlutterSpiInvalidHandle;
+  }
+  builder->consumed = true;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult ReleaseBuilder(FlutterSpiSemanticsUpdateBuilder* builder) {
+  if (builder == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  delete builder;
+  return kFlutterSpiOk;
+}
