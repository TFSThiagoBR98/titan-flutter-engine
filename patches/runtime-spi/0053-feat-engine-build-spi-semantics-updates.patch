+FlutterSpiResult SpiSemanticsToNode(const FlutterSpiSemanticsNode& input,
+                                    SemanticsNode* output) {
+  if (output == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *output = SemanticsNode();
+  const size_t size = input.struct_size;
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, id), sizeof(input.id))) {
+    output->id = input.id;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, flags),
+               sizeof(input.flags))) {
+    CopyFlags(input.flags, &output->flags);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, actions),
+               sizeof(input.actions))) {
+    output->actions = input.actions;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, max_value_length),
+               sizeof(input.max_value_length))) {
+    output->maxValueLength = input.max_value_length;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, current_value_length),
+               sizeof(input.current_value_length))) {
+    output->currentValueLength = input.current_value_length;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, text_selection_base),
+               sizeof(input.text_selection_base))) {
+    output->textSelectionBase = input.text_selection_base;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, text_selection_extent),
+               sizeof(input.text_selection_extent))) {
+    output->textSelectionExtent = input.text_selection_extent;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, platform_view_id),
+               sizeof(input.platform_view_id))) {
+    output->platformViewId = input.platform_view_id;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, scroll_children),
+               sizeof(input.scroll_children))) {
+    output->scrollChildren = input.scroll_children;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, scroll_index),
+               sizeof(input.scroll_index))) {
+    output->scrollIndex = input.scroll_index;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, traversal_parent),
+               sizeof(input.traversal_parent))) {
+    output->traversalParent = input.traversal_parent;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, scroll_position),
+               sizeof(input.scroll_position))) {
+    output->scrollPosition = input.scroll_position;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, scroll_extent_max),
+               sizeof(input.scroll_extent_max))) {
+    output->scrollExtentMax = input.scroll_extent_max;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, scroll_extent_min),
+               sizeof(input.scroll_extent_min))) {
+    output->scrollExtentMin = input.scroll_extent_min;
+  }
+  if (input.scroll_children > 0 &&
+      (!HasField(size, offsetof(FlutterSpiSemanticsNode,
+                               children_in_hit_test_order),
+                 sizeof(input.children_in_hit_test_order)) ||
+       input.children_in_hit_test_order == nullptr)) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  FlutterSpiResult result = kFlutterSpiOk;
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, identifier),
+               sizeof(input.identifier))) {
+    result = AssignString(input.identifier, &output->identifier);
+  }
+  if (result == kFlutterSpiOk &&
+      HasField(size, offsetof(FlutterSpiSemanticsNode, label),
+               sizeof(input.label))) {
+    result = CopyAttributes(input.label, &output->label, &output->labelAttributes);
+  }
+  if (result == kFlutterSpiOk &&
+      HasField(size, offsetof(FlutterSpiSemanticsNode, value),
+               sizeof(input.value))) {
+    result = CopyAttributes(input.value, &output->value, &output->valueAttributes);
+  }
+  if (result == kFlutterSpiOk &&
+      HasField(size, offsetof(FlutterSpiSemanticsNode, increased_value),
+               sizeof(input.increased_value))) {
+    result = CopyAttributes(input.increased_value, &output->increasedValue,
+                             &output->increasedValueAttributes);
+  }
+  if (result == kFlutterSpiOk &&
+      HasField(size, offsetof(FlutterSpiSemanticsNode, decreased_value),
+               sizeof(input.decreased_value))) {
+    result = CopyAttributes(input.decreased_value, &output->decreasedValue,
+                             &output->decreasedValueAttributes);
+  }
+  if (result == kFlutterSpiOk &&
+      HasField(size, offsetof(FlutterSpiSemanticsNode, hint),
+               sizeof(input.hint))) {
+    result = CopyAttributes(input.hint, &output->hint, &output->hintAttributes);
+  }
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, tooltip),
+               sizeof(input.tooltip))) {
+    result = AssignString(input.tooltip, &output->tooltip);
+  }
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, text_direction),
+               sizeof(input.text_direction))) {
+    output->textDirection = input.text_direction;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, rect), sizeof(input.rect))) {
+    output->rect = SkRect::MakeLTRB(input.rect.left, input.rect.top,
+                                    input.rect.right, input.rect.bottom);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, transform),
+               sizeof(input.transform))) {
+    SkScalar transform[16];
+    for (size_t index = 0; index < 16; index++) {
+      transform[index] = input.transform.m[index];
+    }
+    output->transform = SkM44::ColMajor(transform);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, hit_test_transform),
+               sizeof(input.hit_test_transform))) {
+    SkScalar transform[16];
+    for (size_t index = 0; index < 16; index++) {
+      transform[index] = input.hit_test_transform.m[index];
+    }
+    output->hitTestTransform = SkM44::ColMajor(transform);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, children_in_traversal_order),
+               sizeof(input.children_in_traversal_order))) {
+    if (input.children_in_traversal_order_count != 0 &&
+        input.children_in_traversal_order == nullptr) {
+      return kFlutterSpiInvalidArgument;
+    }
+    CopyVector(input.children_in_traversal_order,
+               input.children_in_traversal_order_count,
+               &output->childrenInTraversalOrder);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, children_in_hit_test_order),
+               sizeof(input.children_in_hit_test_order))) {
+    if (input.children_in_hit_test_order_count != 0 &&
+        input.children_in_hit_test_order == nullptr) {
+      return kFlutterSpiInvalidArgument;
+    }
+    CopyVector(input.children_in_hit_test_order,
+               input.children_in_hit_test_order_count,
+               &output->childrenInHitTestOrder);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, custom_actions),
+               sizeof(input.custom_actions))) {
+    if (input.custom_action_count != 0 && input.custom_actions == nullptr) {
+      return kFlutterSpiInvalidArgument;
+    }
+    CopyVector(input.custom_actions, input.custom_action_count,
+               &output->customAccessibilityActions);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, heading_level),
+               sizeof(input.heading_level))) {
+    output->headingLevel = input.heading_level;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, link_url),
+               sizeof(input.link_url))) {
+    result = AssignString(input.link_url, &output->linkUrl);
+  }
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, role), sizeof(input.role))) {
+    output->role = static_cast<SemanticsRole>(input.role);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, validation_result),
+               sizeof(input.validation_result))) {
+    output->validationResult =
+        static_cast<SemanticsValidationResult>(input.validation_result);
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, locale),
+               sizeof(input.locale))) {
+    result = AssignString(input.locale, &output->locale);
+  }
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, min_value),
+               sizeof(input.min_value))) {
+    result = AssignString(input.min_value, &output->minValue);
+  }
+  if (result != kFlutterSpiOk) {
+    return result;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsNode, max_value),
+               sizeof(input.max_value))) {
+    result = AssignString(input.max_value, &output->maxValue);
+  }
+  return result;
+}
+
+FlutterSpiResult SpiSemanticsToAction(
+    const FlutterSpiSemanticsCustomAction& input,
+    CustomAccessibilityAction* output) {
+  if (output == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *output = CustomAccessibilityAction();
+  const size_t size = input.struct_size;
+  if (HasField(size, offsetof(FlutterSpiSemanticsCustomAction, id),
+               sizeof(input.id))) {
+    output->id = input.id;
+  }
+  if (HasField(size, offsetof(FlutterSpiSemanticsCustomAction, override_id),
+               sizeof(input.override_id))) {
+    output->overrideId = input.override_id;
+  }
+  FlutterSpiResult result = kFlutterSpiOk;
+  if (HasField(size, offsetof(FlutterSpiSemanticsCustomAction, label),
+               sizeof(input.label))) {
+    result = AssignString(input.label, &output->label);
+  }
+  if (result == kFlutterSpiOk &&
+      HasField(size, offsetof(FlutterSpiSemanticsCustomAction, hint),
+               sizeof(input.hint))) {
+    result = AssignString(input.hint, &output->hint);
+  }
+  return result;
+}
+
+const FlutterSpiSemanticsApi* SpiSemantics::Api() {
+  static const FlutterSpiSemanticsApi api = {
+      .struct_size = sizeof(FlutterSpiSemanticsApi),
+      .update_builder_create = CreateBuilder,
+      .update_node = UpdateNode,
+      .update_custom_action = UpdateCustomAction,
+      .update_submit = SubmitBuilder,
+      .update_builder_release = ReleaseBuilder,
+  };
+  return &api;
+}
