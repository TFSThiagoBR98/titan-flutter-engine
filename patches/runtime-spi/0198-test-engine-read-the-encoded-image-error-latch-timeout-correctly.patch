# Why: AutoResetWaitableEvent::WaitWithTimeout returns true when the timeout
# expires, so the test must assert that the wait did not time out before
# checking the received exception.
diff --git a/engine/src/flutter/shell/common/shell_unittests.cc b/engine/src/flutter/shell/common/shell_unittests.cc
index 560b979e9cf..5298518ae55 100644
--- a/engine/src/flutter/shell/common/shell_unittests.cc
+++ b/engine/src/flutter/shell/common/shell_unittests.cc
@@ -2618,11 +2618,11 @@ TEST_F(ShellTest, ImageDescriptorEncodedRejectsInvalidDataSynchronously) {
   ASSERT_NE(shell.get(), nullptr);
 
   RunEngine(shell.get(), std::move(configuration));
-  const bool received_message = message_latch.WaitWithTimeout(
+  const bool timed_out = message_latch.WaitWithTimeout(
       fml::TimeDelta::FromSeconds(10));
   DestroyShell(std::move(shell));
 
-  ASSERT_TRUE(received_message);
+  ASSERT_FALSE(timed_out);
   EXPECT_EQ(message, "Exception: Invalid image data");
 }
 
