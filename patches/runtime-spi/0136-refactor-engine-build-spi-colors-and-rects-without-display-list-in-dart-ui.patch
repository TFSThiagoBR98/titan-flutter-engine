--- /dev/null
+++ b/engine/src/flutter/lib/ui/painting/spi_color.h
@@ -0,0 +1,27 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef FLUTTER_LIB_UI_PAINTING_SPI_COLOR_H_
+#define FLUTTER_LIB_UI_PAINTING_SPI_COLOR_H_
+
+#include <cstdint>
+
+#include "flutter/runtime_spi/include/flutter_scene.h"
+
+namespace flutter {
+
+inline FlutterSpiColor ToSpiColorFromArgb(uint32_t argb) {
+  return {
+      ((argb >> 16) & 0xff) * (1.0f / 255),
+      ((argb >> 8) & 0xff) * (1.0f / 255),
+      (argb & 0xff) * (1.0f / 255),
+      ((argb >> 24) & 0xff) * (1.0f / 255),
+      // DlColorSpace::kSRGB is represented by zero in the SPI.
+      0,
+  };
+}
+
+}  // namespace flutter
+
+#endif  // FLUTTER_LIB_UI_PAINTING_SPI_COLOR_H_
