+Picture _createScenePicture(Color color, double size) {
+  final PictureRecorder recorder = PictureRecorder();
+  final Canvas canvas = Canvas(recorder, Rect.fromLTWH(0, 0, size, size));
+  canvas.drawRect(Rect.fromLTWH(0, 0, size, size), Paint()..color = color);
+  return recorder.endRecording();
+}
+
+@pragma('vm:entry-point')
+void buildSceneFrame() {
+  const int groupCount = 60;
+  const int retainedGroupCount = 10;
+  const int framesPerRetention = 3;
+  final List<Picture> pictures = <Picture>[
+    _createScenePicture(const Color(0xFF2563EB), 16),
+    _createScenePicture(const Color(0xFF16A34A), 20),
+    _createScenePicture(const Color(0xFFDC2626), 24),
+    _createScenePicture(const Color(0xFFCA8A04), 28),
+  ];
+  final ColorFilter colorFilter = ColorFilter.mode(
+    const Color(0xFFFFFFFF),
+    BlendMode.modulate,
+  );
+  List<OffsetEngineLayer?> previousOffsetLayers = <OffsetEngineLayer?>[];
+  List<TransformEngineLayer?> previousTransformLayers = <TransformEngineLayer?>[];
+  List<ClipRectEngineLayer?> previousClipRectLayers = <ClipRectEngineLayer?>[];
+  List<OpacityEngineLayer?> previousOpacityLayers = <OpacityEngineLayer?>[];
+  List<ClipRRectEngineLayer?> previousClipRRectLayers = <ClipRRectEngineLayer?>[];
+  List<ColorFilterEngineLayer?> previousColorFilterLayers = <ColorFilterEngineLayer?>[];
+
+  for (int frameIndex = 0; frameIndex < framesPerRetention * 2; frameIndex++) {
+    final bool retainFirstGroups =
+        frameIndex % framesPerRetention == framesPerRetention - 1 &&
+        previousOpacityLayers.length == groupCount &&
+        previousOpacityLayers[retainedGroupCount - 1] != null;
+    final SceneBuilder sceneBuilder = SceneBuilder();
+    final List<OffsetEngineLayer?> nextOffsetLayers = <OffsetEngineLayer?>[];
+    final List<TransformEngineLayer?> nextTransformLayers = <TransformEngineLayer?>[];
+    final List<ClipRectEngineLayer?> nextClipRectLayers = <ClipRectEngineLayer?>[];
+    final List<OpacityEngineLayer?> nextOpacityLayers = <OpacityEngineLayer?>[];
+    final List<ClipRRectEngineLayer?> nextClipRRectLayers = <ClipRRectEngineLayer?>[];
+    final List<ColorFilterEngineLayer?> nextColorFilterLayers = <ColorFilterEngineLayer?>[];
+
+    for (int groupIndex = 0; groupIndex < groupCount; groupIndex++) {
+      if (retainFirstGroups && groupIndex < retainedGroupCount) {
+        sceneBuilder.addRetained(previousOpacityLayers[groupIndex]!);
+        nextOffsetLayers.add(null);
+        nextTransformLayers.add(null);
+        nextClipRectLayers.add(null);
+        nextOpacityLayers.add(null);
+        nextClipRRectLayers.add(null);
+        nextColorFilterLayers.add(null);
+        continue;
+      }
+
+      final double offset = groupIndex.toDouble() * 6.0;
+      final OffsetEngineLayer offsetLayer = sceneBuilder.pushOffset(
+        offset,
+        offset * 0.5,
+        oldLayer: groupIndex < previousOffsetLayers.length
+            ? previousOffsetLayers[groupIndex]
+            : null,
+      );
+      final double scale = 1.0 + (groupIndex % 5) * 0.01;
+      final TransformEngineLayer transformLayer = sceneBuilder.pushTransform(
+        Float64List.fromList(<double>[
+          scale,
+          0,
+          0,
+          0,
+          0,
+          scale,
+          0,
+          0,
+          0,
+          0,
+          1,
+          0,
+          offset,
+          offset * 0.5,
+          0,
+          1,
+        ]),
+        oldLayer: groupIndex < previousTransformLayers.length
+            ? previousTransformLayers[groupIndex]
+            : null,
+      );
+      final ClipRectEngineLayer clipRectLayer = sceneBuilder.pushClipRect(
+        Rect.fromLTWH(0, 0, 64, 48),
+        oldLayer: groupIndex < previousClipRectLayers.length
+            ? previousClipRectLayers[groupIndex]
+            : null,
+      );
+      final OpacityEngineLayer opacityLayer = sceneBuilder.pushOpacity(
+        200,
+        oldLayer: groupIndex < previousOpacityLayers.length
+            ? previousOpacityLayers[groupIndex]
+            : null,
+      );
+
+      ClipRRectEngineLayer? clipRRectLayer;
+      ColorFilterEngineLayer? colorFilterLayer;
+      if ((groupIndex + 1) % 10 == 0) {
+        clipRRectLayer = sceneBuilder.pushClipRRect(
+          RRect.fromRectAndRadius(
+            const Rect.fromLTWH(0, 0, 64, 48),
+            const Radius.circular(4),
+          ),
+          oldLayer: groupIndex < previousClipRRectLayers.length
+              ? previousClipRRectLayers[groupIndex]
+              : null,
+        );
+        colorFilterLayer = sceneBuilder.pushColorFilter(
+          colorFilter,
+          oldLayer: groupIndex < previousColorFilterLayers.length
+              ? previousColorFilterLayers[groupIndex]
+              : null,
+        );
+      }
+
+      sceneBuilder.addPicture(
+        Offset.zero,
+        pictures[groupIndex % pictures.length],
+        isComplexHint: groupIndex % 2 == 0,
+        willChangeHint: groupIndex % 3 == 0,
+      );
+      if (colorFilterLayer != null) {
+        sceneBuilder.pop();
+        sceneBuilder.pop();
+      }
+      sceneBuilder.pop();
+      sceneBuilder.pop();
+      sceneBuilder.pop();
+      sceneBuilder.pop();
+
+      nextOffsetLayers.add(offsetLayer);
+      nextTransformLayers.add(transformLayer);
+      nextClipRectLayers.add(clipRectLayer);
+      nextOpacityLayers.add(opacityLayer);
+      nextClipRRectLayers.add(clipRRectLayer);
+      nextColorFilterLayers.add(colorFilterLayer);
+    }
+
+    final Scene scene = sceneBuilder.build();
+    scene.dispose();
+    previousOffsetLayers = nextOffsetLayers;
+    previousTransformLayers = nextTransformLayers;
+    previousClipRectLayers = nextClipRectLayers;
+    previousOpacityLayers = nextOpacityLayers;
+    previousClipRRectLayers = nextClipRRectLayers;
+    previousColorFilterLayers = nextColorFilterLayers;
+  }
+
+  for (final Picture picture in pictures) {
+    picture.dispose();
+  }
+}
+
