 }
 
+FlutterSpiResult SpiEngineFontLoad(FlutterSpiEngine* engine,
+                                   const uint8_t* data,
+                                   size_t size,
+                                   const char* family_alias) {
+  if (engine == nullptr || engine->backend == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const FlutterSpiTextApi* text_api = engine->backend->engine_api().text;
+  if (text_api == nullptr || text_api->font_load == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return text_api->font_load(engine, data, size, family_alias);
+}
+
 FontCollection& SpiEngineFontCollection(FlutterSpiEngine* engine) {
   return static_cast<Engine&>(engine->backend->runtime_delegate_)
       .GetFontCollection();
