# Why: Expose path volatility through the public SPI scene API while
# preserving invalid-handle semantics.
diff --git a/engine/src/flutter/runtime_spi/scene/spi_canvas.cc b/engine/src/flutter/runtime_spi/scene/spi_canvas.cc
index 74c26a82ca6..5c51cb35ee2 100644
--- a/engine/src/flutter/runtime_spi/scene/spi_canvas.cc
+++ b/engine/src/flutter/runtime_spi/scene/spi_canvas.cc
@@ -181,6 +181,15 @@ FlutterSpiResult PathSetFillType(FlutterSpiPath* path, int32_t fill_type) {
   return kFlutterSpiOk;
 }
 
+FlutterSpiResult PathSetVolatile(FlutterSpiPath* path, bool is_volatile) {
+  const auto path_value = FindPath(path);
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  path_value->SetVolatile(is_volatile);
+  return kFlutterSpiOk;
+}
+
 FlutterSpiResult PathMoveTo(FlutterSpiPath* path, float x, float y) {
   const auto path_value = FindPath(path);
   DlPoint point;
@@ -1517,6 +1526,7 @@ const FlutterSpiSceneApi kSceneApi = {
     .scene_build_root = SpiSceneBuildRoot,
     .scene_create_from_root = SpiSceneCreateFromRoot,
     .scene_retain_last_layer = SpiSceneRetainLastLayer,
+    .path_set_volatile = PathSetVolatile,
 };
 
 }  // namespace
