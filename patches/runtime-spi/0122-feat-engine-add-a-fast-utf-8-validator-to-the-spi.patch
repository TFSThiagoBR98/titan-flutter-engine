+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/internal/spi_utf8.h"
+
+#include <cstdint>
+#include <cstring>
+
+namespace flutter {
+namespace {
+
+constexpr uint8_t kAsciiMaximum = 0x7f;
+constexpr uint8_t kContinuationMinimum = 0x80;
+constexpr uint8_t kContinuationMaximum = 0xbf;
+constexpr uint8_t kTwoByteLeadMinimum = 0xc2;
+constexpr uint8_t kTwoByteLeadMaximum = 0xdf;
+constexpr uint8_t kThreeByteLeadMinimum = 0xe0;
+constexpr uint8_t kThreeByteLeadMaximum = 0xef;
+constexpr uint8_t kThreeByteLeadE0 = 0xe0;
+constexpr uint8_t kThreeByteLeadED = 0xed;
+constexpr uint8_t kFourByteLeadMinimum = 0xf0;
+constexpr uint8_t kFourByteLeadMaximum = 0xf4;
+constexpr uint8_t kFourByteLeadF0 = 0xf0;
+constexpr uint8_t kFourByteLeadF4 = 0xf4;
+constexpr uint8_t kE0SecondMinimum = 0xa0;
+constexpr uint8_t kEDSecondMaximum = 0x9f;
+constexpr uint8_t kF0SecondMinimum = 0x90;
+constexpr uint8_t kF4SecondMaximum = 0x8f;
+constexpr uint64_t kAsciiWordHighBitMask = 0x8080808080808080ULL;
+constexpr size_t kAsciiWordSize = sizeof(uint64_t);
+
+bool IsContinuationByte(uint8_t byte) {
+  return byte >= kContinuationMinimum && byte <= kContinuationMaximum;
+}
+
+bool IsValidTwoByteSequence(const uint8_t* bytes, size_t remaining) {
+  return remaining >= 2 && bytes[0] >= kTwoByteLeadMinimum &&
+         bytes[0] <= kTwoByteLeadMaximum && IsContinuationByte(bytes[1]);
+}
+
+bool IsValidThreeByteSequence(const uint8_t* bytes, size_t remaining) {
+  if (remaining < 3 || bytes[0] < kThreeByteLeadMinimum ||
+      bytes[0] > kThreeByteLeadMaximum) {
+    return false;
+  }
+
+  const uint8_t second = bytes[1];
+  if (bytes[0] == kThreeByteLeadE0) {
+    if (!IsContinuationByte(second) || second < kE0SecondMinimum) {
+      return false;
+    }
+  } else if (bytes[0] == kThreeByteLeadED) {
+    if (!IsContinuationByte(second) || second > kEDSecondMaximum) {
+      return false;
+    }
+  } else if (!IsContinuationByte(second)) {
+    return false;
+  }
+  return IsContinuationByte(bytes[2]);
+}
+
+bool IsValidFourByteSequence(const uint8_t* bytes, size_t remaining) {
+  if (remaining < 4 || bytes[0] < kFourByteLeadMinimum ||
+      bytes[0] > kFourByteLeadMaximum) {
+    return false;
+  }
+
+  const uint8_t second = bytes[1];
+  if (bytes[0] == kFourByteLeadF0) {
+    if (!IsContinuationByte(second) || second < kF0SecondMinimum) {
+      return false;
+    }
+  } else if (bytes[0] == kFourByteLeadF4) {
+    if (!IsContinuationByte(second) || second > kF4SecondMaximum) {
+      return false;
+    }
+  } else if (!IsContinuationByte(second)) {
+    return false;
+  }
+  return IsContinuationByte(bytes[2]) && IsContinuationByte(bytes[3]);
+}
+
+}  // namespace
+
+bool SpiIsValidUtf8(const char* data, size_t size) {
+  if (data == nullptr) {
+    return size == 0;
+  }
+
+  const auto* bytes = reinterpret_cast<const uint8_t*>(data);
+  size_t index = 0;
+  while (size - index >= kAsciiWordSize) {
+    uint64_t word = 0;
+    std::memcpy(&word, bytes + index, kAsciiWordSize);
+    if ((word & kAsciiWordHighBitMask) != 0) {
+      break;
+    }
+    index += kAsciiWordSize;
+  }
+
+  while (index < size) {
+    const uint8_t lead = bytes[index];
+    if (lead <= kAsciiMaximum) {
+      index++;
+      continue;
+    }
+
+    const size_t remaining = size - index;
+    if (lead >= kTwoByteLeadMinimum && lead <= kTwoByteLeadMaximum) {
+      if (!IsValidTwoByteSequence(bytes + index, remaining)) {
+        return false;
+      }
+      index += 2;
+    } else if (lead >= kThreeByteLeadMinimum &&
+               lead <= kThreeByteLeadMaximum) {
+      if (!IsValidThreeByteSequence(bytes + index, remaining)) {
+        return false;
+      }
+      index += 3;
+    } else if (lead >= kFourByteLeadMinimum &&
+               lead <= kFourByteLeadMaximum) {
+      if (!IsValidFourByteSequence(bytes + index, remaining)) {
+        return false;
+      }
+      index += 4;
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace flutter
