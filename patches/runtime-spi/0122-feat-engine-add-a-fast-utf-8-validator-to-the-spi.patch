diff --git a/engine/src/flutter/runtime_spi/internal/spi_utf8_unittests.cc b/engine/src/flutter/runtime_spi/internal/spi_utf8_unittests.cc
new file mode 100644
index 00000000000..c4d86cd1ab5
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/internal/spi_utf8_unittests.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/internal/spi_utf8.h"
+
+#include <cstdint>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "flutter/runtime_spi/testing/test_icu.h"
+#include "flutter/testing/testing.h"
+#include "third_party/icu/source/common/unicode/ustring.h"
+
+namespace flutter::testing {
+namespace {
+
+constexpr size_t kRandomBufferCount = 100000;
+constexpr size_t kMaxRandomBufferSize = 24;
+constexpr uint32_t kRandomSeed = 20261028;
+constexpr uint8_t kHighByteMinimum = 0x80;
+constexpr uint8_t kByteMaximum = 0xff;
+
+bool IcuAcceptsUtf8(const char* data, size_t size) {
+  UErrorCode error = U_ZERO_ERROR;
+  int32_t utf16_length = 0;
+  u_strFromUTF8(nullptr, 0, &utf16_length, data, static_cast<int32_t>(size),
+                &error);
+  return U_SUCCESS(error) || error == U_BUFFER_OVERFLOW_ERROR;
+}
+
+class SpiUtf8Test : public ::testing::Test {
+ protected:
+  void SetUp() override { InitializeIcuForTesting(); }
+};
+
+TEST_F(SpiUtf8Test, AcceptsAscii) {
+  constexpr char kAscii[] = "Titan Runtime SPI";
+
+  EXPECT_TRUE(SpiIsValidUtf8(kAscii, sizeof(kAscii) - 1));
+  EXPECT_TRUE(SpiIsValidUtf8(nullptr, 0));
+}
+
+TEST_F(SpiUtf8Test, AcceptsMultibyte) {
+  constexpr char kTwoByte[] = "\xc2\x80";
+  constexpr char kThreeByte[] = "\xe2\x82\xac";
+  constexpr char kFourByte[] = "\xf4\x8f\xbf\xbf";
+
+  EXPECT_TRUE(SpiIsValidUtf8(kTwoByte, sizeof(kTwoByte) - 1));
+  EXPECT_TRUE(SpiIsValidUtf8(kThreeByte, sizeof(kThreeByte) - 1));
+  EXPECT_TRUE(SpiIsValidUtf8(kFourByte, sizeof(kFourByte) - 1));
+}
+
+TEST_F(SpiUtf8Test, RejectsMalformed) {
+  const std::vector<std::string> malformed = {
+      "\x80",       "\xc2",       "\xe0\xa0",       "\xf0\x90\x80",
+      "\xc0\x80",  "\xc1\xbf",  "\xe0\x80\x80",  "\xe0\x9f\xbf",
+      "\xf0\x80\x80\x80",       "\xed\xa0\x80",  "\xed\xbf\xbf",
+      "\xf4\x90\x80\x80",       "\xf5\x80\x80\x80", "\xff",
+  };
+
+  for (const std::string& value : malformed) {
+    EXPECT_FALSE(SpiIsValidUtf8(value.data(), value.size())) << value;
+  }
+}
+
+TEST_F(SpiUtf8Test, MatchesIcuOnRandomBytes) {
+  std::mt19937 generator(kRandomSeed);
+  std::uniform_int_distribution<size_t> size_distribution(
+      0, kMaxRandomBufferSize);
+  std::uniform_int_distribution<uint16_t> byte_distribution(0,
+                                                              kByteMaximum);
+  std::uniform_int_distribution<uint16_t> high_byte_distribution(
+      kHighByteMinimum, kByteMaximum);
+
+  for (size_t iteration = 0; iteration < kRandomBufferCount; iteration++) {
+    const size_t size = size_distribution(generator);
+    std::string value(size, '\0');
+    for (char& byte : value) {
+      const uint16_t generated =
+          iteration % 2 == 0 ? high_byte_distribution(generator)
+                             : byte_distribution(generator);
+      byte = static_cast<char>(generated);
+    }
+
+    const char* data = value.empty() ? nullptr : value.data();
+    EXPECT_EQ(SpiIsValidUtf8(data, size), IcuAcceptsUtf8(data, size))
+        << "iteration=" << iteration << " size=" << size;
+  }
+}
+
+}  // namespace
+}  // namespace flutter::testing
