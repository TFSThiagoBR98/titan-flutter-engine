+  DlPoint offset;
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!ToDlPoint({dx, dy}, &offset)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  path_value->RelativeMoveTo(offset);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult PathRelativeLineTo(FlutterSpiPath* path, float dx, float dy) {
