+  if (src_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return StorePath(src_value->Copy(), out);
+}
+
+FlutterSpiResult PathShift(FlutterSpiPath* src,
+                           float dx,
+                           float dy,
+                           FlutterSpiPath** out) {
+  const auto src_value = FindPath(src);
+  if (src_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!std::isfinite(dx) || !std::isfinite(dy)) {
