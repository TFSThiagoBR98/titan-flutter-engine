+FlutterSpiResult PathOp(FlutterSpiPath* a,
+                        FlutterSpiPath* b,
+                        int32_t operation,
+                        FlutterSpiPath** out) {
+  const auto first_path = FindPath(a);
+  const auto second_path = FindPath(b);
+  if (first_path == nullptr || second_path == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out == nullptr || operation < 0 || operation > 4) {
+    return kFlutterSpiInvalidArgument;
