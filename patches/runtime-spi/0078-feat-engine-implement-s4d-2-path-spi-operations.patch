+
+FlutterSpiResult PathAddPolygon(FlutterSpiPath* path,
+                                const FlutterSpiPoint* points,
+                                size_t count,
+                                bool close) {
+  const auto path_value = FindPath(path);
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (count > 0 && points == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  for (size_t index = 0; index < count; ++index) {
+    if (!std::isfinite(points[index].x) || !std::isfinite(points[index].y)) {
+      return kFlutterSpiInvalidArgument;
