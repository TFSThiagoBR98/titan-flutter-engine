+
+FlutterSpiResult PathAddPath(FlutterSpiPath* dst,
+                             FlutterSpiPath* src,
+                             float dx,
+                             float dy,
+                             const double* matrix4,
+                             int32_t mode) {
+  const auto dst_value = FindPath(dst);
+  const auto src_value = FindPath(src);
+  if (dst_value == nullptr || src_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!std::isfinite(dx) || !std::isfinite(dy) ||
+      (mode != kFlutterSpiPathAddModeAppend &&
+       mode != kFlutterSpiPathAddModeExtend)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  dst_value->AddPath(*src_value, dx, dy, matrix4, mode);
+  return kFlutterSpiOk;
+}
