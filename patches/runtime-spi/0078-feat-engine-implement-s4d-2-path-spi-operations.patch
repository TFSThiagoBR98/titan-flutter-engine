+FlutterSpiResult PathReset(FlutterSpiPath* path) {
+  const auto path_value = FindPath(path);
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  path_value->Reset();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult PathGetFillType(FlutterSpiPath* path, int32_t* out) {
+  const auto path_value = FindPath(path);
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out == nullptr) {
