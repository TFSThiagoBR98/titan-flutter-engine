+    return kFlutterSpiInvalidHandle;
+  }
+  if (out == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const DlRect bounds = path_value->GetBounds();
+  *out = {bounds.GetLeft(), bounds.GetTop(), bounds.GetRight(),
+          bounds.GetBottom()};
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult StorePath(SpiPath path, FlutterSpiPath** out) {
+  *out = MakeHandle<FlutterSpiPath>(
