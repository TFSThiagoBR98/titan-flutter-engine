# Why: keep retained scene root creation compatible with the engine build
# flags and namespace the SPI bridge call.
diff --git a/engine/src/flutter/runtime_spi/spi_scene.cc b/engine/src/flutter/runtime_spi/spi_scene.cc
index 0b1edc4e2ff..d4a628cbce2 100644
--- a/engine/src/flutter/runtime_spi/spi_scene.cc
+++ b/engine/src/flutter/runtime_spi/spi_scene.cc
@@ -53,20 +53,24 @@ FlutterSpiResult SpiSceneCreateFromRoot(FlutterSpiEngineLayer* root,
                                         int64_t width_px,
                                         int64_t height_px,
                                         FlutterSpiScene** out_scene) {
-  const std::shared_ptr<flutter::Layer> root_layer = SpiEngineLayerGet(root);
+  const std::shared_ptr<flutter::Layer> root_layer =
+      flutter::SpiEngineLayerGet(root);
   if (root_layer == nullptr) {
     return kFlutterSpiInvalidHandle;
   }
   if (out_scene == nullptr || width_px <= 0 || height_px <= 0) {
     return kFlutterSpiInvalidArgument;
   }
-  const auto container_layer =
-      std::dynamic_pointer_cast<flutter::ContainerLayer>(root_layer);
+  const flutter::ContainerLayer* container_layer =
+      root_layer->as_container_layer();
   if (container_layer == nullptr) {
     return kFlutterSpiInvalidHandle;
   }
-  return SpiSceneCreateFromLayerTree(width_px, height_px, container_layer,
-                                     out_scene);
+  return SpiSceneCreateFromLayerTree(
+      width_px, height_px,
+      std::shared_ptr<flutter::ContainerLayer>(
+          root_layer, const_cast<flutter::ContainerLayer*>(container_layer)),
+      out_scene);
 }
 
