+void CaptureFrame(void* user_data,
+                  FlutterSpiResult result,
+                  FlutterSpiImage* image,
+                  int32_t duration_ms) {
+  auto* state = static_cast<FrameCallbackState*>(user_data);
+  state->result = result;
+  state->image = image;
+  state->duration_ms = duration_ms;
+  state->completed.Signal();
