+struct SpiFrameCallbackState {
+  fml::AutoResetWaitableEvent completed;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  FlutterSpiImage* image = nullptr;
+  int32_t duration_ms = -1;
+  int calls = 0;
+};
+
+void CaptureSpiFrame(void* user_data,
+                     FlutterSpiResult result,
+                     FlutterSpiImage* image,
+                     int32_t duration_ms) {
+  auto* state = static_cast<SpiFrameCallbackState*>(user_data);
+  state->result = result;
+  state->image = image;
+  state->duration_ms = duration_ms;
+  state->calls++;
+  state->completed.Signal();
+}
+
+void PostSpiTaskSync(const fml::RefPtr<fml::TaskRunner>& task_runner,
+                     const fml::closure& task) {
+  fml::AutoResetWaitableEvent completed;
+  task_runner->PostTask([&completed, &task] {
+    task();
+    completed.Signal();
+  });
+  completed.Wait();
+}
