+TEST(SpiShaderParity, GradientInputsMatchDlFactory) {
+  FlutterSpiEngine engine = TestEngine();
+  const std::array<FlutterSpiColor, 2> two_colors = {
+      FlutterSpiColor{.red = 1.0f,
+                      .green = 0.0f,
+                      .blue = 0.0f,
+                      .alpha = 1.0f,
+                      .color_space = kFlutterSpiColorSpaceSRGB},
+      FlutterSpiColor{.red = 0.0f,
+                      .green = 1.0f,
+                      .blue = 0.0f,
+                      .alpha = 1.0f,
+                      .color_space = kFlutterSpiColorSpaceSRGB},
+  };
+  const std::array<FlutterSpiColor, 1> one_color = {two_colors[0]};
+  const auto dl_two_colors = ToDlColors(TestColors());
+
+  for (const auto& colors :
+       std::array<std::pair<const FlutterSpiColor*, size_t>, 2>{
+           std::pair{two_colors.data(), two_colors.size()},
+           std::pair{one_color.data(), one_color.size()}}) {
+    FlutterSpiShader* shader = nullptr;
+    ASSERT_EQ(SpiShaderLinearGradient(
+                  &engine, {0.0f, 0.0f}, {10.0f, 10.0f}, colors.first,
+                  nullptr, colors.second, kFlutterSpiTileModeClamp, nullptr,
+                  &shader),
+              kFlutterSpiOk);
+    const auto expected = DlColorSource::MakeLinear(
+        {0.0f, 0.0f}, {10.0f, 10.0f}, colors.second,
+        colors.first == two_colors.data() ? dl_two_colors.data()
+                                          : &dl_two_colors[0],
+        nullptr, DlTileMode::kClamp);
+    if (expected == nullptr) {
+      EXPECT_EQ(shader, nullptr);
+    } else {
+      ASSERT_NE(shader, nullptr);
+      EXPECT_EQ(*SpiShaderGet(shader), *expected);
+      EXPECT_EQ(SpiShaderRelease(shader), kFlutterSpiOk);
+    }
+  }
+}
