+TEST_F(SpiParagraphTest, LineMetricsAtNegativeLineIsNotFound) {
+  const auto style = ParagraphStyle();
+  auto* paragraph = BuildSpiParagraph(style, "Hello, SPI world");
+  auto expected = BuildTxtParagraph(style, "Hello, SPI world");
+  skia::textlayout::LineMetrics expected_line = {};
+  FlutterSpiLineMetrics actual_line = {};
+  bool actual_found = true;
+
+  ASSERT_FALSE(expected->GetLineMetricsAt(-1, &expected_line));
+  ASSERT_EQ(SpiParagraphLayout(paragraph, kLayoutWidth), kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphGetLineMetricsAt(paragraph, -1, &actual_line,
+                                         &actual_found),
+            kFlutterSpiOk);
+  EXPECT_FALSE(actual_found);
+  EXPECT_EQ(SpiParagraphRelease(paragraph), kFlutterSpiOk);
+}
