+TEST_F(SpiParagraphTest, PlaceholderWithNegativeSizeMatchesTxt) {
+  const auto style = ParagraphStyle();
+  FlutterSpiParagraphBuilder* builder = nullptr;
+  ASSERT_EQ(SpiParagraphBuilderCreate(TxtFontCollection(), false, &style,
+                                       &builder),
+            kFlutterSpiOk);
+  ASSERT_EQ(SpiParagraphBuilderAddPlaceholder(
+                builder, -20.0f, 10.0f,
+                static_cast<int32_t>(txt::PlaceholderAlignment::kBaseline),
+                0.0f, static_cast<int32_t>(txt::TextBaseline::kAlphabetic)),
+            kFlutterSpiOk);
+  FlutterSpiParagraph* paragraph = nullptr;
+  ASSERT_EQ(SpiParagraphBuilderBuild(builder, &paragraph), kFlutterSpiOk);
+
+  auto expected_builder = txt::ParagraphBuilder::CreateSkiaBuilder(
+      ToTxtParagraphStyle(&style), TxtFontCollection(), false);
+  txt::PlaceholderRun placeholder(
+      -20.0, 10.0, txt::PlaceholderAlignment::kBaseline,
+      txt::TextBaseline::kAlphabetic, 0.0);
+  expected_builder->AddPlaceholder(placeholder);
+  auto expected = expected_builder->Build();
+
+  ASSERT_EQ(SpiParagraphLayout(paragraph, kLayoutWidth), kFlutterSpiOk);
+  expected->Layout(kLayoutWidth);
+  const auto expected_boxes = expected->GetRectsForPlaceholders();
+  FlutterSpiTextBox actual_box = {};
+  size_t actual_count = 0;
+  ASSERT_EQ(SpiParagraphGetRectsForPlaceholders(paragraph, &actual_box, 1,
+                                                &actual_count),
+            kFlutterSpiOk);
+  ASSERT_EQ(actual_count, expected_boxes.size());
+  if (!expected_boxes.empty()) {
+    EXPECT_FLOAT_EQ(actual_box.rect.left, expected_boxes[0].rect.left());
+    EXPECT_FLOAT_EQ(actual_box.rect.top, expected_boxes[0].rect.top());
+    EXPECT_FLOAT_EQ(actual_box.rect.right, expected_boxes[0].rect.right());
+    EXPECT_FLOAT_EQ(actual_box.rect.bottom, expected_boxes[0].rect.bottom());
+  }
+  EXPECT_EQ(SpiParagraphRelease(paragraph), kFlutterSpiOk);
+}
