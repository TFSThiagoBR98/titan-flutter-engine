+namespace flutter::testing {
+namespace {
+
+class PathRecorder final : public IgnoreAttributeDispatchHelper,
+                           public IgnoreClipDispatchHelper,
+                           public IgnoreTransformDispatchHelper,
+                           public IgnoreDrawDispatchHelper {
+ public:
+  void drawPath(const DlPath& path) override { paths.push_back(path); }
+
+  std::vector<DlPath> paths;
+};
+
+class CanvasSpiTest : public ShellTest {
+ protected:
+  void RegisterCallbacks() {
+    AddNativeCallback(
+        "ValidatePicture",
+        CREATE_NATIVE_ENTRY([this](Dart_NativeArguments args) {
+          Dart_Handle picture_handle = Dart_GetNativeArgument(args, 0);
+          intptr_t peer = 0;
+          Dart_Handle result = Dart_GetNativeInstanceField(
+              picture_handle, tonic::DartWrappable::kPeerIndex, &peer);
+          ASSERT_FALSE(Dart_IsError(result)) << Dart_GetError(result);
+
+          auto* picture = reinterpret_cast<Picture*>(peer);
+          ASSERT_NE(picture, nullptr);
+          const DisplayList* display_list =
+              SpiPictureDisplayList(picture->spi_handle());
+          ASSERT_NE(display_list, nullptr);
+
+          op_types.clear();
+          for (DlIndex index = 0; index < display_list->GetRecordCount();
+               index++) {
+            op_types.push_back(display_list->GetOpType(index));
+          }
+
+          PathRecorder path_recorder;
+          display_list->Dispatch(path_recorder);
+          paths = std::move(path_recorder.paths);
+        }));
+    AddNativeCallback(
+        "Finish",
+        CREATE_NATIVE_ENTRY([this](Dart_NativeArguments args) {
+          message_latch.Signal();
+        }));
+  }
+
+  void RunFixture(const char* entrypoint) {
+    Settings settings = CreateSettingsForFixture();
+    TaskRunners task_runners("test",                  // label
+                             GetCurrentTaskRunner(),  // platform
+                             CreateNewThread(),       // raster
+                             CreateNewThread(),       // ui
+                             CreateNewThread()        // io
+    );
+
+    RegisterCallbacks();
+    std::unique_ptr<Shell> shell = CreateShell(settings, task_runners);
+    ASSERT_TRUE(shell->IsSetup());
+
+    auto configuration = RunConfiguration::InferFromSettings(settings);
+    configuration.SetEntrypoint(entrypoint);
+    shell->RunEngine(std::move(configuration), [](auto result) {
+      ASSERT_EQ(result, Engine::RunStatus::Success);
+    });
+
+    message_latch.Wait();
+    DestroyShell(std::move(shell), task_runners);
+  }
+
+  fml::AutoResetWaitableEvent message_latch;
+  std::vector<DisplayListOpType> op_types;
+  std::vector<DlPath> paths;
+};
+
+TEST_F(CanvasSpiTest, EveryCanvasOpReachesTheSpiRecorder) {
+  RunFixture("recordEveryCanvasOp");
+
+  const std::vector<DisplayListOpType> expected = {
+      DisplayListOpType::kSaveLayer,
+      DisplayListOpType::kDrawPaint,
+      DisplayListOpType::kRestore,
+      DisplayListOpType::kSave,
+      DisplayListOpType::kTranslate,
+      DisplayListOpType::kScale,
+      DisplayListOpType::kRotate,
+      DisplayListOpType::kSkew,
+      DisplayListOpType::kTranslate,
+      DisplayListOpType::kRestore,
+      DisplayListOpType::kSave,
+      DisplayListOpType::kClipIntersectRect,
+      DisplayListOpType::kClipIntersectRoundRect,
+      DisplayListOpType::kClipIntersectRoundSuperellipse,
+      DisplayListOpType::kClipIntersectPath,
+      DisplayListOpType::kRestore,
+      DisplayListOpType::kDrawColor,
+      DisplayListOpType::kDrawLine,
+      DisplayListOpType::kDrawRect,
+      DisplayListOpType::kDrawRoundRect,
+      DisplayListOpType::kDrawDiffRoundRect,
+      DisplayListOpType::kDrawRoundSuperellipse,
+      DisplayListOpType::kDrawOval,
+      DisplayListOpType::kDrawCircle,
+      DisplayListOpType::kDrawArc,
+      DisplayListOpType::kDrawPath,
+      DisplayListOpType::kDrawImageWithAttr,
+      DisplayListOpType::kDrawImageRect,
+      DisplayListOpType::kDrawImageNineWithAttr,
+      DisplayListOpType::kDrawDisplayList,
+      DisplayListOpType::kDrawPoints,
+      DisplayListOpType::kDrawVertices,
+      DisplayListOpType::kDrawAtlas,
+      DisplayListOpType::kDrawShadow,
+  };
+
+  ASSERT_EQ(op_types.size(), expected.size());
+  for (size_t index = 0; index < expected.size(); index++) {
+    EXPECT_EQ(op_types[index], expected[index]) << "op index " << index;
+  }
+}
+
+TEST_F(CanvasSpiTest, MutatedPathIsRedrawnWithTheNewShape) {
+  RunFixture("recordMutatedPath");
+
+  ASSERT_EQ(paths.size(), 2u);
+  EXPECT_FALSE(paths[0] == paths[1]);
+  EXPECT_EQ(paths[0].GetSkPath().countVerbs(), 3);
+  EXPECT_EQ(paths[1].GetSkPath().countVerbs(), 4);
+}
