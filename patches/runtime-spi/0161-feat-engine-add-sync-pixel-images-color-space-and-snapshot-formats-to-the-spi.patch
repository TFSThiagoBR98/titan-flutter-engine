+FlutterSpiResult SpiImageDecoding::CreateFromPixelsSync(
+    const FlutterSpiPixels* pixels,
+    const FlutterSpiImageDecodeOptions* options,
+    FlutterSpiImage** out_image) {
+  if (pixels == nullptr || pixels->pixels == nullptr || out_image == nullptr ||
+      pixels->width <= 0 || pixels->height <= 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PixelFormatInfo format_info;
+  if (!GetPixelFormatInfo(pixels->pixel_format, &format_info) ||
+      format_info.color_type == kUnknown_SkColorType) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (options != nullptr &&
+      (options->target_width > 0 || options->target_height > 0)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t minimum_row_bytes =
+      static_cast<size_t>(pixels->width) * format_info.bytes_per_pixel;
+  if (pixels->row_bytes < 0) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const size_t row_bytes = pixels->row_bytes == 0
+                               ? minimum_row_bytes
+                               : static_cast<size_t>(pixels->row_bytes);
+  if (row_bytes < minimum_row_bytes ||
+      row_bytes > std::numeric_limits<size_t>::max() /
+                       static_cast<size_t>(pixels->height) ||
+      pixels->pixels_size < row_bytes * static_cast<size_t>(pixels->height)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!snapshot_delegate_) {
+    return kFlutterSpiInternalError;
+  }
+
+  const auto image_info = SkImageInfo::Make(
+      pixels->width, pixels->height, format_info.color_type,
+      format_info.alpha_type, SkColorSpace::MakeSRGB());
+  const auto image = SkImages::RasterFromData(
+      image_info, SkData::MakeWithCopy(pixels->pixels, pixels->pixels_size),
+      row_bytes);
+  if (!image) {
+    return kFlutterSpiInternalError;
+  }
+#if IMPELLER_SUPPORTS_RENDERING
+  auto deferred_image = PixelDeferredImageGPUImpeller::Make(
+      image, snapshot_delegate_, raster_task_runner_);
+  return SpiImageWrap(std::move(deferred_image), out_image) == kFlutterSpiOk
+             ? kFlutterSpiOk
+             : kFlutterSpiInternalError;
+#else
+  return kFlutterSpiInternalError;
+#endif
+}
+
 }  // namespace flutter
