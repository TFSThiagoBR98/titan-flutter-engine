+constexpr char kRemappedShaderFixtureDirectory[] = "iplr-remap";
+
+std::string ExecutableDirectory() {
+  std::array<char, 4096> buffer = {};
+  const ssize_t size = readlink("/proc/self/exe", buffer.data(), buffer.size());
+  if (size <= 0) {
+    return {};
+  }
+  std::string path(buffer.data(), size);
+  const size_t separator = path.find_last_of('/');
+  return separator == std::string::npos ? std::string()
+                                        : path.substr(0, separator);
+}
+
+std::string FixturePath(const char* fixture_name,
+                        const char* fixture_directory =
+                            kGeneralShaderFixtureDirectory) {
+  return ExecutableDirectory() + "/gen/flutter/lib/ui/fixtures/shaders/" +
+         fixture_directory + "/" + fixture_name;
+}
+
+std::shared_ptr<fml::Mapping> LoadFixtureMapping(
+    const char* fixture_name,
+    const char* fixture_directory = kGeneralShaderFixtureDirectory) {
+  auto mapping = fml::FileMapping::CreateReadOnly(
+      FixturePath(fixture_name, fixture_directory));
+  if (mapping == nullptr || !mapping->IsValid()) {
+    return nullptr;
+  }
+  return std::shared_ptr<fml::Mapping>(std::move(mapping));
+}
+
+std::vector<uint8_t> LoadFixtureBytes(
+    const char* fixture_name,
+    const char* fixture_directory = kGeneralShaderFixtureDirectory) {
+  const auto mapping = LoadFixtureMapping(fixture_name, fixture_directory);
+  if (mapping == nullptr) {
+    return {};
+  }
+  return {mapping->GetMapping(), mapping->GetMapping() + mapping->GetSize()};
+}
+
+std::shared_ptr<impeller::RuntimeStage> DecodeFixtureStage(
+    const char* fixture_name,
+    impeller::RuntimeStageBackend backend) {
+  const auto mapping = LoadFixtureMapping(fixture_name);
+  if (mapping == nullptr) {
+    return nullptr;
+  }
+  auto stages = impeller::RuntimeStage::DecodeRuntimeStages(mapping);
+  if (!stages.ok()) {
+    return nullptr;
+  }
+  return stages.value().at(backend);
+}
+
+struct RuntimeStageCounts {
+  size_t float_count = 0;
+  size_t sampler_count = 0;
+};
+
+RuntimeStageCounts CountUniforms(const impeller::RuntimeStage& stage) {
+  RuntimeStageCounts counts;
+  for (const auto& uniform : stage.GetUniforms()) {
+    if (uniform.type == impeller::kSampledImage) {
+      counts.sampler_count++;
+    } else {
+      counts.float_count += uniform.GetDartSize() / sizeof(float);
+    }
+  }
+  return counts;
+}
+
+sk_sp<DlImage> MakeTestImage() {
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::MakeN32Premul(4, 3))) {
+    return nullptr;
+  }
+  bitmap.eraseColor(SK_ColorBLUE);
+  bitmap.setImmutable();
+  return DlImageSkia::Make(SkImages::RasterFromBitmap(bitmap));
+}
