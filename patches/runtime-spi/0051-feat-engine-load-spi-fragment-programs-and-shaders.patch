@@ -0,0 +1,399 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/effects/spi_fragment.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <new>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "flutter/assets/asset_manager.h"
+#include "flutter/display_list/dl_sampling_options.h"
+#include "flutter/display_list/dl_tile_mode.h"
+#include "flutter/display_list/effects/dl_color_source.h"
+#include "flutter/display_list/effects/dl_image_filter.h"
+#include "flutter/fml/mapping.h"
+#include "flutter/fml/status.h"
+#include "flutter/impeller/core/runtime_types.h"
+#include "flutter/lib/ui/painting/runtime_effect_loader.h"
+#include "flutter/runtime_spi/effects/spi_image_filter.h"
+#include "flutter/runtime_spi/effects/spi_shader.h"
+#include "flutter/runtime_spi/image/spi_image.h"
+#include "flutter/runtime_spi/spi_runtime_backend.h"
+
+namespace flutter {
+
+struct SpiFragmentProgramData {
+  sk_sp<DlRuntimeEffect> effect;
+  std::vector<impeller::RuntimeUniformDescription> uniforms;
+  size_t float_uniform_bytes = 0;
+  size_t float_count = 0;
+  size_t sampler_count = 0;
+  bool impeller_enabled = false;
+};
+
+struct SpiFragmentShaderData {
+  std::shared_ptr<SpiFragmentProgramData> program;
+  std::shared_ptr<std::vector<uint8_t>> uniform_data;
+  std::vector<std::shared_ptr<DlColorSource>> samplers;
+};
+
+}  // namespace flutter
+
+struct FlutterSpiFragmentProgram {
+  std::shared_ptr<flutter::SpiFragmentProgramData> data;
+};
+
+struct FlutterSpiFragmentShader {
+  std::shared_ptr<flutter::SpiFragmentShaderData> data;
+};
+
+namespace flutter {
+
+FlutterSpiResult SpiFragment::CheckEngine(FlutterSpiEngine* engine,
+                                          SpiRuntimeBackend** out_backend) {
+  if (engine == nullptr || engine->backend == nullptr || out_backend == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_backend = engine->backend;
+  if (!(*out_backend)->HasUiThread()) {
+    return kFlutterSpiWrongThread;
+  }
+  return kFlutterSpiOk;
+}
+
+namespace {
+
+FlutterSpiResult CheckProgram(FlutterSpiFragmentProgram* program,
+                              SpiFragmentProgramData** out_data) {
+  if (program == nullptr || program->data == nullptr || out_data == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_data = program->data.get();
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult CheckShader(FlutterSpiFragmentShader* shader,
+                             SpiFragmentShaderData** out_data) {
+  if (shader == nullptr || shader->data == nullptr || out_data == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_data = shader->data.get();
+  return kFlutterSpiOk;
+}
+
+void SetError(char** out_error, std::string_view message) {
+  if (out_error == nullptr) {
+    return;
+  }
+  *out_error = nullptr;
+  char* error = static_cast<char*>(std::malloc(message.size() + 1));
+  if (error == nullptr) {
+    return;
+  }
+  std::memcpy(error, message.data(), message.size());
+  error[message.size()] = '\0';
+  *out_error = error;
+}
+
+DlImageSampling SamplingFromIndex(int32_t filter_quality) {
+  if (filter_quality <= kFlutterSpiFilterQualityNone) {
+    return DlImageSampling::kNearestNeighbor;
+  }
+  if (filter_quality == kFlutterSpiFilterQualityLow) {
+    return DlImageSampling::kLinear;
+  }
+  if (filter_quality == kFlutterSpiFilterQualityMedium) {
+    return DlImageSampling::kMipmapLinear;
+  }
+  return DlImageSampling::kCubic;
+}
+
+bool AreSamplersComplete(const SpiFragmentShaderData& shader) {
+  for (const auto& sampler : shader.samplers) {
+    if (sampler == nullptr) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::shared_ptr<std::vector<uint8_t>> CopyUniformData(
+    const SpiFragmentShaderData& shader) {
+  return std::make_shared<std::vector<uint8_t>>(*shader.uniform_data);
+}
+
+}  // namespace
+
+const FlutterSpiFragmentApi* SpiFragment::Api() {
+  static const FlutterSpiFragmentApi api = {
+      .struct_size = sizeof(FlutterSpiFragmentApi),
+      .program_from_asset = ProgramFromAsset,
+      .program_from_bytes = ProgramFromBytes,
+      .program_get_counts = ProgramGetCounts,
+      .program_get_uniform = ProgramGetUniform,
+      .program_release = ProgramRelease,
+      .shader_create = ShaderCreate,
+      .shader_set_float = ShaderSetFloat,
+      .shader_set_image_sampler = ShaderSetImageSampler,
+      .shader_to_shader = ShaderToShader,
+      .shader_to_image_filter = ShaderToImageFilter,
+      .shader_release = ShaderRelease,
+  };
+  return &api;
+}
+
+FlutterSpiResult SpiFragment::LoadProgram(
+    SpiRuntimeBackend* backend,
+    std::unique_ptr<fml::Mapping> data,
+    const std::string& library_id,
+    FlutterSpiFragmentProgram** out_program,
+    char** out_error) {
+  if (backend == nullptr || data == nullptr || out_program == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_program = nullptr;
+  if (!backend->runtime_stage_backend_.valid()) {
+    SetError(out_error, "Runtime stage backend is unavailable.");
+    return kFlutterSpiInternalError;
+  }
+
+  RuntimeEffectLoadContext context{
+      backend->runtime_stage_backend_.get(),
+      backend->impeller_enabled_,
+      backend->snapshot_delegate_,
+      backend->task_runners_.GetRasterTaskRunner(),
+  };
+  auto loaded_effect =
+      LoadRuntimeEffect(std::move(data), library_id, context);
+  if (!loaded_effect.ok()) {
+    SetError(out_error, loaded_effect.status().message());
+    return kFlutterSpiInvalidArgument;
+  }
+  if (loaded_effect.value().effect == nullptr) {
+    SetError(out_error, "Runtime effect could not be created.");
+    return kFlutterSpiInternalError;
+  }
+
+  auto program_data = std::make_shared<SpiFragmentProgramData>();
+  program_data->effect = std::move(loaded_effect.value().effect);
+  program_data->uniforms = std::move(loaded_effect.value().uniforms);
+  program_data->float_uniform_bytes = loaded_effect.value().float_uniform_bytes;
+  program_data->float_count = program_data->float_uniform_bytes / sizeof(float);
+  program_data->sampler_count = loaded_effect.value().sampled_image_count;
+  program_data->impeller_enabled = backend->impeller_enabled_;
+
+  auto* program = new (std::nothrow) FlutterSpiFragmentProgram();
+  if (program == nullptr) {
+    SetError(out_error, "Could not allocate fragment program.");
+    return kFlutterSpiInternalError;
+  }
+  program->data = std::move(program_data);
+  *out_program = program;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiFragment::ProgramFromAsset(
+    FlutterSpiEngine* engine,
+    const char* asset_name,
+    FlutterSpiFragmentProgram** out_program,
+    char** out_error) {
+  SpiRuntimeBackend* backend = nullptr;
+  const FlutterSpiResult check = SpiFragment::CheckEngine(engine, &backend);
+  if (check != kFlutterSpiOk || asset_name == nullptr || out_program == nullptr) {
+    return check != kFlutterSpiOk ? check : kFlutterSpiInvalidArgument;
+  }
+  if (backend->asset_manager_ == nullptr) {
+    SetError(out_error, "Asset manager is unavailable.");
+    return kFlutterSpiInternalError;
+  }
+  std::unique_ptr<fml::Mapping> data =
+      backend->asset_manager_->GetAsMapping(asset_name);
+  if (data == nullptr) {
+    SetError(out_error, std::string("Asset '") + asset_name + "' not found");
+    return kFlutterSpiInvalidArgument;
+  }
+  return LoadProgram(backend, std::move(data), asset_name, out_program, out_error);
+}
+
+FlutterSpiResult SpiFragment::ProgramFromBytes(
+    FlutterSpiEngine* engine,
+    const uint8_t* data,
+    size_t size,
+    const char* library_id,
+    FlutterSpiFragmentProgram** out_program,
+    char** out_error) {
+  SpiRuntimeBackend* backend = nullptr;
+  const FlutterSpiResult check = SpiFragment::CheckEngine(engine, &backend);
+  if (check != kFlutterSpiOk || data == nullptr || size == 0 ||
+      out_program == nullptr) {
+    return check != kFlutterSpiOk ? check : kFlutterSpiInvalidArgument;
+  }
+  auto mapping = std::make_unique<fml::MallocMapping>(
+      fml::MallocMapping::Copy(data, size));
+  return LoadProgram(backend, std::move(mapping),
+                     library_id == nullptr ? "" : library_id, out_program,
+                     out_error);
+}
+
+FlutterSpiResult SpiFragment::ProgramGetCounts(
+    FlutterSpiFragmentProgram* program,
+    size_t* out_uniform_count,
+    size_t* out_float_count,
+    size_t* out_sampler_count) {
+  SpiFragmentProgramData* data = nullptr;
+  if (CheckProgram(program, &data) != kFlutterSpiOk ||
+      out_uniform_count == nullptr || out_float_count == nullptr ||
+      out_sampler_count == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out_uniform_count = data->uniforms.size();
+  *out_float_count = data->float_count;
+  *out_sampler_count = data->sampler_count;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiFragment::ProgramGetUniform(FlutterSpiFragmentProgram* program,
+                                                size_t index,
+                                                FlutterSpiUniformInfo* out_info) {
+  SpiFragmentProgramData* data = nullptr;
+  if (CheckProgram(program, &data) != kFlutterSpiOk || out_info == nullptr ||
+      index >= data->uniforms.size()) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const auto& uniform = data->uniforms[index];
+  *out_info = {
+      .struct_size = sizeof(FlutterSpiUniformInfo),
+      .name = uniform.name.c_str(),
+      .type = static_cast<int32_t>(uniform.type),
+      .size_bytes = uniform.GetDartSize(),
+  };
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiFragment::ProgramRelease(FlutterSpiFragmentProgram* program) {
+  if (program == nullptr || program->data == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  delete program;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiFragment::ShaderCreate(FlutterSpiFragmentProgram* program,
+                                            FlutterSpiFragmentShader** out_shader) {
+  SpiFragmentProgramData* data = nullptr;
+  if (CheckProgram(program, &data) != kFlutterSpiOk || out_shader == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  auto shader_data = std::make_shared<SpiFragmentShaderData>();
+  shader_data->program = program->data;
+  shader_data->uniform_data = std::make_shared<std::vector<uint8_t>>(
+      data->float_uniform_bytes + data->sampler_count * 2 * sizeof(float), 0);
+  shader_data->samplers.resize(data->sampler_count);
+  auto* shader = new (std::nothrow) FlutterSpiFragmentShader();
+  if (shader == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  shader->data = std::move(shader_data);
+  *out_shader = shader;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiFragment::ShaderSetFloat(FlutterSpiFragmentShader* shader,
+                                             size_t index,
+                                             float value) {
+  SpiFragmentShaderData* data = nullptr;
+  if (CheckShader(shader, &data) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (index >= data->program->float_count) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::memcpy(data->uniform_data->data() + index * sizeof(float), &value,
+              sizeof(float));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiFragment::ShaderSetImageSampler(
+    FlutterSpiFragmentShader* shader,
+    size_t index,
+    FlutterSpiImage* image,
+    int32_t filter_quality) {
+  SpiFragmentShaderData* data = nullptr;
+  if (CheckShader(shader, &data) != kFlutterSpiOk || image == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (index >= data->samplers.size()) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const sk_sp<DlImage> dl_image = SpiImageGet(image);
+  if (dl_image == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  int32_t width = 0;
+  int32_t height = 0;
+  if (SpiImageGetSize(image, &width, &height) != kFlutterSpiOk) {
+    return kFlutterSpiInvalidHandle;
+  }
+  data->samplers[index] = DlColorSource::MakeImage(
+      dl_image, DlTileMode::kClamp, DlTileMode::kClamp,
+      SamplingFromIndex(filter_quality), nullptr);
+  const size_t offset =
+      data->program->float_uniform_bytes + 2 * index * sizeof(float);
+  const float dimensions[] = {static_cast<float>(width),
+                              static_cast<float>(height)};
+  std::memcpy(data->uniform_data->data() + offset, dimensions,
+              sizeof(dimensions));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiFragment::ShaderToShader(FlutterSpiFragmentShader* shader,
+                                             int32_t filter_quality,
+                                             FlutterSpiShader** out_shader) {
+  (void)filter_quality;
+  SpiFragmentShaderData* data = nullptr;
+  if (CheckShader(shader, &data) != kFlutterSpiOk || out_shader == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!AreSamplersComplete(*data)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return SpiShaderCreate(
+      DlColorSource::MakeRuntimeEffect(data->program->effect, data->samplers,
+                                       CopyUniformData(*data)),
+      out_shader);
+}
+
+FlutterSpiResult SpiFragment::ShaderToImageFilter(
+    FlutterSpiFragmentShader* shader,
+    int32_t filter_quality,
+    FlutterSpiImageFilter** out_filter) {
+  SpiFragmentShaderData* data = nullptr;
+  if (CheckShader(shader, &data) != kFlutterSpiOk || out_filter == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  if (!data->program || !data->program->impeller_enabled ||
+      data->samplers.empty() || !AreSamplersComplete(*data)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  return SpiImageFilterCreate(
+      DlImageFilter::MakeRuntimeEffect(
+          data->program->effect, data->samplers, CopyUniformData(*data),
+          SamplingFromIndex(filter_quality)),
+      out_filter);
+}
+
+FlutterSpiResult SpiFragment::ShaderRelease(FlutterSpiFragmentShader* shader) {
+  if (shader == nullptr || shader->data == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  delete shader;
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
