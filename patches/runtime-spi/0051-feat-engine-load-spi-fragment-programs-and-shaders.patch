+      LoadFixtureMapping(kMissingBackendFixture, kRemappedShaderFixtureDirectory);
+  ASSERT_NE(mapping, nullptr);
+  auto stages = impeller::RuntimeStage::DecodeRuntimeStages(mapping);
+  ASSERT_TRUE(stages.ok());
+  const std::array<impeller::RuntimeStageBackend, 5> backends = {
+      impeller::RuntimeStageBackend::kSkSL,
+      impeller::RuntimeStageBackend::kMetal,
+      impeller::RuntimeStageBackend::kOpenGLES,
+      impeller::RuntimeStageBackend::kOpenGLES3,
+      impeller::RuntimeStageBackend::kVulkan};
+  std::optional<impeller::RuntimeStageBackend> missing_backend;
+  for (const auto backend : backends) {
+    if (stages.value().at(backend) == nullptr) {
+      missing_backend = backend;
+      break;
+    }
+  }
+  ASSERT_TRUE(missing_backend.has_value());
+
+  auto backend = CreateBackend(*missing_backend);
+  LaunchBackend(backend.get());
+  const FlutterSpiFragmentApi* api = runtime_->engine_api->fragment;
+  ASSERT_NE(api, nullptr);
+  const auto bytes =
+      LoadFixtureBytes(kMissingBackendFixture, kRemappedShaderFixtureDirectory);
+  FlutterSpiFragmentProgram* program = nullptr;
+  char* error = nullptr;
+  EXPECT_EQ(api->program_from_bytes(runtime_->engine, bytes.data(),
+                                    bytes.size(), "simple", &program, &error),
+            kFlutterSpiInvalidArgument);
+  EXPECT_EQ(program, nullptr);
+  ASSERT_NE(error, nullptr);
+  EXPECT_THAT(
