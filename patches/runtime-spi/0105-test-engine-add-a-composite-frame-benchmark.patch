+Paragraph _buildCompositeTitleParagraph(int groupIndex) {
+  final ParagraphBuilder builder = ParagraphBuilder(
+    ParagraphStyle(textAlign: TextAlign.center),
+  );
+  builder.pushStyle(TextStyle(
+    fontSize: 14,
+    fontFamily: 'sans-serif',
+    color: Color(0xFF111827),
+  ));
+  builder.addText('Dashboard item ${groupIndex + 1}');
+  builder.pushStyle(TextStyle(
+    fontWeight: FontWeight.bold,
+    color: Color(0xFF2563EB),
+  ));
+  builder.addText(' ready');
+  builder.pop();
+  builder.pop();
+
+  final Paragraph paragraph = builder.build();
+  paragraph.layout(const ParagraphConstraints(width: 300));
+  return paragraph;
+}
+
+Picture _buildCompositeGroupPicture(int groupIndex) {
+  final PictureRecorder recorder = PictureRecorder();
+  final Canvas canvas = Canvas(
+    recorder,
+    const Rect.fromLTWH(0, 0, 320, 140),
+  );
+  final Paint backgroundPaint = Paint()..color = const Color(0xFFF8FAFC);
+  canvas.drawRRect(
+    RRect.fromRectAndRadius(
+      const Rect.fromLTWH(0, 0, 320, 140),
+      const Radius.circular(8),
+    ),
+    backgroundPaint,
+  );
+
+  final Path iconPath = Path()
+    ..moveTo(12, 12)
+    ..lineTo(28, 12)
+    ..lineTo(34, 22)
+    ..lineTo(24, 34)
+    ..lineTo(10, 30)
+    ..lineTo(6, 20)
+    ..close();
+  canvas.drawPath(iconPath, Paint()..color = const Color(0xFF2563EB));
+  canvas.drawRect(
+    const Rect.fromLTWH(48, 18, 92, 8),
+    Paint()..color = const Color(0xFF16A34A),
+  );
+  canvas.drawRect(
+    const Rect.fromLTWH(48, 34, 64, 6),
+    Paint()..color = const Color(0xFFCA8A04),
+  );
+  canvas.drawCircle(
+    const Offset(286, 26),
+    12,
+    Paint()..color = Color(0xFFDC2626 + (groupIndex % 3) * 0x00050505),
+  );
+
+  final Paragraph paragraph = _buildCompositeTitleParagraph(groupIndex);
+  canvas.drawParagraph(paragraph, const Offset(8, 72));
+  paragraph.dispose();
+  return recorder.endRecording();
+}
+
+Picture _buildCompositeBodyPicture() {
+  final ParagraphBuilder builder = ParagraphBuilder(ParagraphStyle(
+    maxLines: 3,
+    ellipsis: '…',
+  ));
+  builder.pushStyle(TextStyle(
+    fontSize: 15,
+    fontFamily: 'sans-serif',
+    color: Color(0xFF111827),
+  ));
+  builder.addText(
+    'A longer application summary describes the current workspace and the '
+    'items that need attention before the next frame is presented. ',
+  );
+  builder.pushStyle(TextStyle(fontWeight: FontWeight.w600));
+  builder.addText(
+    'Important updates remain visible while the surrounding cards are '
+    'recomposed for the user.',
+  );
+  builder.pop();
+  builder.pushStyle(TextStyle(fontStyle: FontStyle.italic));
+  builder.addText(
+    'Recent activity and helpful status details complete this realistic text '
+    'block for the composed frame benchmark.',
+  );
+  builder.pop();
+  builder.pop();
+
+  final Paragraph paragraph = builder.build();
+  paragraph.layout(const ParagraphConstraints(width: 620));
+  paragraph.computeLineMetrics();
+
+  final PictureRecorder recorder = PictureRecorder();
+  final Canvas canvas = Canvas(
+    recorder,
+    const Rect.fromLTWH(0, 0, 640, 100),
+  );
+  canvas.drawParagraph(paragraph, Offset.zero);
+  paragraph.dispose();
+  return recorder.endRecording();
+}
+
+List<OffsetEngineLayer?> _compositePreviousOffsetLayers = <OffsetEngineLayer?>[];
+List<ClipRectEngineLayer?> _compositePreviousClipRectLayers = <ClipRectEngineLayer?>[];
+List<OpacityEngineLayer?> _compositePreviousOpacityLayers = <OpacityEngineLayer?>[];
+
+@pragma('vm:entry-point')
+void buildCompositeFrame() {
+  const int groupCount = 20;
+
+  final SceneBuilder sceneBuilder = SceneBuilder();
+  final List<OffsetEngineLayer?> nextOffsetLayers = <OffsetEngineLayer?>[];
+  final List<ClipRectEngineLayer?> nextClipRectLayers = <ClipRectEngineLayer?>[];
+  final List<OpacityEngineLayer?> nextOpacityLayers = <OpacityEngineLayer?>[];
+  final List<Picture> pictures = <Picture>[];
+
+  for (int groupIndex = 0; groupIndex < groupCount; groupIndex++) {
+    final OffsetEngineLayer offsetLayer = sceneBuilder.pushOffset(
+      groupIndex.toDouble() * 4,
+      groupIndex.toDouble() * 2,
+      oldLayer: groupIndex < _compositePreviousOffsetLayers.length
+          ? _compositePreviousOffsetLayers[groupIndex]
+          : null,
+    );
+    final ClipRectEngineLayer clipRectLayer = sceneBuilder.pushClipRect(
+      const Rect.fromLTWH(0, 0, 320, 140),
+      oldLayer: groupIndex < _compositePreviousClipRectLayers.length
+          ? _compositePreviousClipRectLayers[groupIndex]
+          : null,
+    );
+    OpacityEngineLayer? opacityLayer;
+    if (groupIndex % 4 == 0) {
+      opacityLayer = sceneBuilder.pushOpacity(
+        220,
+        oldLayer: groupIndex < _compositePreviousOpacityLayers.length
+            ? _compositePreviousOpacityLayers[groupIndex]
+            : null,
+      );
+    }
+
+    final Picture picture = _buildCompositeGroupPicture(groupIndex);
+    sceneBuilder.addPicture(Offset.zero, picture);
+    pictures.add(picture);
+
+    if (opacityLayer != null) {
+      sceneBuilder.pop();
+    }
+    sceneBuilder.pop();
+    sceneBuilder.pop();
+
+    nextOffsetLayers.add(offsetLayer);
+    nextClipRectLayers.add(clipRectLayer);
+    nextOpacityLayers.add(opacityLayer);
+  }
+
+  final Picture bodyPicture = _buildCompositeBodyPicture();
+  sceneBuilder.addPicture(const Offset(12, 160), bodyPicture);
+  pictures.add(bodyPicture);
+
+  final Scene scene = sceneBuilder.build();
+  scene.dispose();
+  for (final Picture picture in pictures) {
+    picture.dispose();
+  }
+
+  _compositePreviousOffsetLayers = nextOffsetLayers;
+  _compositePreviousClipRectLayers = nextClipRectLayers;
+  _compositePreviousOpacityLayers = nextOpacityLayers;
+}
