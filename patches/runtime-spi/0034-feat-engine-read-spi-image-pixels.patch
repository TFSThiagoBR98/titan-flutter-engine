+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/image/spi_image_readback.h"
+
+#include "flutter/display_list/image/dl_image_skia.h"
+#include "flutter/lib/ui/painting/image_readback.h"
+#include "flutter/runtime_spi/image/spi_image.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+
+namespace flutter {
+namespace {
+
+bool IsSupportedFormat(int32_t format) {
+  return format >= static_cast<int32_t>(ImageByteFormat::kRawRGBA) &&
+         format <= static_cast<int32_t>(ImageByteFormat::kPNG);
+}
+
+}  // namespace
+
+FlutterSpiResult SpiImageToBytes(FlutterSpiImage* image,
+                                 int32_t format,
+                                 FlutterSpiBytesCallback callback,
+                                 void* user_data) {
+  if (callback == nullptr || !IsSupportedFormat(format)) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  const sk_sp<DlImage> dl_image = SpiImageGet(image);
+  if (dl_image == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+
+  const DlImageSkia* skia_image = dl_image->asSkiaImage();
+  sk_sp<SkImage> raster_image =
+      skia_image == nullptr ? nullptr : skia_image->skia_image();
+  if (raster_image == nullptr) {
+    callback(user_data, kFlutterSpiInternalError, nullptr, 0);
+    return kFlutterSpiOk;
+  }
+
+  SkPixmap pixmap;
+  if (!raster_image->peekPixels(&pixmap)) {
+    raster_image = raster_image->makeRasterImage(nullptr);
+  }
+  if (raster_image == nullptr) {
+    callback(user_data, kFlutterSpiInternalError, nullptr, 0);
+    return kFlutterSpiOk;
+  }
+
+  const auto encoded =
+      EncodeRasterImage(raster_image, static_cast<ImageByteFormat>(format));
+  if (!encoded.ok()) {
+    callback(user_data, kFlutterSpiInternalError, nullptr, 0);
+    return kFlutterSpiOk;
+  }
+
+  callback(user_data, kFlutterSpiOk,
+           static_cast<const uint8_t*>(encoded.value()->data()),
+           encoded.value()->size());
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
