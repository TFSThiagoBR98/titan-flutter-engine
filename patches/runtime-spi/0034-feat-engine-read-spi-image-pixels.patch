+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    runtime_->engine_api->image->image_release(image);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+TEST_F(SpiImageReadbackTest, ReleasedImageIsInvalidHandle) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture(1.0f);
+  });
+  FlutterSpiImage* image = CreateRasterImage(picture);
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    EXPECT_EQ(runtime_->engine_api->image->image_release(image),
+              kFlutterSpiOk);
+  });
+
+  BytesCallbackState callback;
+  ASSERT_NE(runtime_->engine_api->image->image_to_bytes, nullptr);
+  EXPECT_EQ(RequestBytes(image, kFlutterSpiImageByteFormatRawRGBA, &callback),
+            kFlutterSpiInvalidHandle);
+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+}  // namespace
+}  // namespace flutter::testing
