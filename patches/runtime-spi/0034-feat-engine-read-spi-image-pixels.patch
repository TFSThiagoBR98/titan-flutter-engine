+
+constexpr int32_t kImageWidth = 4;
+constexpr int32_t kImageHeight = 3;
+
+struct ImageCallbackState {
+  fml::AutoResetWaitableEvent completed;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  FlutterSpiImage* image = nullptr;
+};
+
+void CaptureImage(void* user_data,
+                  FlutterSpiResult result,
+                  FlutterSpiImage* image) {
+  auto* state = static_cast<ImageCallbackState*>(user_data);
+  state->result = result;
+  state->image = image;
+  state->completed.Signal();
+}
+
+struct BytesCallbackState {
+  fml::AutoResetWaitableEvent completed;
+  FlutterSpiResult result = kFlutterSpiInternalError;
+  std::vector<uint8_t> bytes;
+};
+
+void CaptureBytes(void* user_data,
+                  FlutterSpiResult result,
+                  const uint8_t* bytes,
+                  size_t size) {
+  auto* state = static_cast<BytesCallbackState*>(user_data);
+  state->result = result;
+  if (bytes != nullptr) {
+    state->bytes.assign(bytes, bytes + size);
+  }
+  state->completed.Signal();
+}
+
+void CaptureDecodedImage(void* user_data,
+                         FlutterSpiResult result,
+                         FlutterSpiImage* image) {
+  CaptureImage(user_data, result, image);
+}
+
+void PostSync(const fml::RefPtr<fml::TaskRunner>& task_runner,
+              const fml::closure& task) {
+  fml::AutoResetWaitableEvent completed;
+  task_runner->PostTask([&completed, &task] {
+    task();
+    completed.Signal();
+  });
+  completed.Wait();
+}
+
+class SpiImageReadbackTest : public ShellTest {
+ protected:
+  void SetUp() override {
+    InitializeIcuForTesting();
+    runtime_ = c_test_runtime_create();
+    task_runners_ = std::make_unique<TaskRunners>(GetTaskRunnersForFixture());
+  }
+
+  void TearDown() override {
+    if (shell_ != nullptr) {
+      DestroyShell(std::move(shell_), *task_runners_);
+    }
+    c_test_runtime_free(runtime_);
+  }
+
+  void StartShell() {
+    auto settings = CreateSettingsForFixture();
+    settings.icu_data_path = IcuDataPathForTesting();
+    auto factory = std::make_shared<SpiRuntimeBackendFactory>(
+        c_test_runtime_table(runtime_));
+    shell_ = Shell::Create(
+        PlatformData(), *task_runners_, settings,
+        ShellTestPlatformViewBuilder({}),
+        [](Shell& shell) { return std::make_unique<Rasterizer>(shell); },
+        factory);
+    ASSERT_TRUE(shell_->IsSetup());
+    PlatformViewNotifyCreated(shell_.get());
+    RunEngine(shell_.get(), RunConfiguration::InferFromSettings(settings));
+  }
+
+  FlutterSpiPicture* CreatePicture(float alpha) {
+    FlutterSpiPictureRecorder* recorder = nullptr;
+    FlutterSpiPicture* picture = nullptr;
+    const FlutterSpiRect rect = {.left = 0.0f,
+                                 .top = 0.0f,
+                                 .right = kImageWidth,
+                                 .bottom = kImageHeight};
+    const FlutterSpiPaint paint = {
+        .struct_size = sizeof(FlutterSpiPaint),
+        .color = {.red = 1.0f,
+                  .green = 0.0f,
+                  .blue = 0.0f,
+                  .alpha = alpha,
+                  .color_space = kFlutterSpiColorSpaceSRGB},
+        .blend_mode = kFlutterSpiBlendModeSrcOver,
+        .style = kFlutterSpiPaintStyleFill,
+        .anti_alias = false,
+    };
+    const auto* scene_api = runtime_->engine_api->scene;
+    EXPECT_EQ(scene_api->recorder_create(runtime_->engine, nullptr, &recorder),
+              kFlutterSpiOk);
+    EXPECT_EQ(scene_api->canvas_draw_rect(recorder, &rect, &paint),
+              kFlutterSpiOk);
+    EXPECT_EQ(scene_api->recorder_finish(recorder, &picture), kFlutterSpiOk);
+    return picture;
+  }
+
+  FlutterSpiImage* CreateRasterImage(FlutterSpiPicture* picture) {
+    ImageCallbackState callback;
+    PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+      ASSERT_EQ(runtime_->engine_api->image->picture_to_image(
+                    runtime_->engine, picture, kImageWidth, kImageHeight,
+                    CaptureImage, &callback),
+                kFlutterSpiOk);
+    });
+    callback.completed.Wait();
+    EXPECT_EQ(callback.result, kFlutterSpiOk);
+    return callback.image;
+  }
+
+  FlutterSpiResult RequestBytes(FlutterSpiImage* image,
+                                int32_t format,
+                                BytesCallbackState* callback) {
+    FlutterSpiResult result = kFlutterSpiInternalError;
+    PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+      result = runtime_->engine_api->image->image_to_bytes(
+          runtime_->engine, image, format, CaptureBytes, callback);
+    });
+    if (result == kFlutterSpiOk) {
+      callback->completed.Wait();
+    }
+    return result;
+  }
+
+  CTestRuntime* runtime_ = nullptr;
+  std::unique_ptr<TaskRunners> task_runners_;
+  std::unique_ptr<Shell> shell_;
+};
+
+TEST_F(SpiImageReadbackTest, RawRgbaHasExpectedSize) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  FlutterSpiImage* image = nullptr;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture(1.0f);
+  });
+  image = CreateRasterImage(picture);
+
+  BytesCallbackState callback;
+  ASSERT_NE(runtime_->engine_api->image->image_to_bytes, nullptr);
+  EXPECT_EQ(RequestBytes(image, kFlutterSpiImageByteFormatRawRGBA, &callback),
+            kFlutterSpiOk);
+  ASSERT_EQ(callback.result, kFlutterSpiOk);
+  ASSERT_EQ(callback.bytes.size(), 48u);
+  EXPECT_EQ(callback.bytes[0], 255u);
+  EXPECT_EQ(callback.bytes[1], 0u);
+  EXPECT_EQ(callback.bytes[2], 0u);
+  EXPECT_EQ(callback.bytes[3], 255u);
+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    runtime_->engine_api->image->image_release(image);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+TEST_F(SpiImageReadbackTest, RawStraightRgbaUnpremultiplies) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture(0.5f);
+  });
+  FlutterSpiImage* image = CreateRasterImage(picture);
+
+  BytesCallbackState callback;
+  ASSERT_NE(runtime_->engine_api->image->image_to_bytes, nullptr);
+  EXPECT_EQ(RequestBytes(image,
+                         kFlutterSpiImageByteFormatRawStraightRGBA,
+                         &callback),
+            kFlutterSpiOk);
+  ASSERT_EQ(callback.result, kFlutterSpiOk);
+  ASSERT_EQ(callback.bytes.size(), 48u);
+  EXPECT_EQ(callback.bytes[0], 255u);
+  EXPECT_EQ(callback.bytes[1], 0u);
+  EXPECT_EQ(callback.bytes[2], 0u);
+  EXPECT_NEAR(callback.bytes[3], 128u, 1u);
+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    runtime_->engine_api->image->image_release(image);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+}
+
+TEST_F(SpiImageReadbackTest, PngRoundTrips) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture(1.0f);
+  });
+  FlutterSpiImage* image = CreateRasterImage(picture);
+
+  BytesCallbackState bytes_callback;
+  ASSERT_NE(runtime_->engine_api->image->image_to_bytes, nullptr);
+  EXPECT_EQ(RequestBytes(image, kFlutterSpiImageByteFormatPNG,
+                         &bytes_callback),
+            kFlutterSpiOk);
+  ASSERT_EQ(bytes_callback.result, kFlutterSpiOk);
+  ASSERT_FALSE(bytes_callback.bytes.empty());
+
+  ImageCallbackState decode_callback;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    EXPECT_EQ(runtime_->engine_api->image->image_decode(
+                  runtime_->engine, bytes_callback.bytes.data(),
+                  bytes_callback.bytes.size(), nullptr,
+                  CaptureDecodedImage, &decode_callback),
+              kFlutterSpiOk);
+  });
+  decode_callback.completed.Wait();
+  ASSERT_EQ(decode_callback.result, kFlutterSpiOk);
+  int32_t width = 0;
+  int32_t height = 0;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    EXPECT_EQ(runtime_->engine_api->image->image_get_size(
+                  decode_callback.image, &width, &height),
+              kFlutterSpiOk);
+    runtime_->engine_api->image->image_release(decode_callback.image);
+    runtime_->engine_api->image->image_release(image);
+    runtime_->engine_api->scene->picture_release(picture);
+  });
+  EXPECT_EQ(width, kImageWidth);
+  EXPECT_EQ(height, kImageHeight);
+}
+
+TEST_F(SpiImageReadbackTest, UnknownFormatIsRejected) {
+  StartShell();
+  FlutterSpiPicture* picture = nullptr;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    picture = CreatePicture(1.0f);
