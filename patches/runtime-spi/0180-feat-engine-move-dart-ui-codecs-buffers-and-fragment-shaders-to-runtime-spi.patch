 #include "third_party/tonic/typed_data/typed_list.h"
@@ -14,7 +17,102 @@ namespace flutter {
 
 IMPLEMENT_WRAPPERTYPEINFO(ui, Codec);
 
+namespace {
+
+struct CodecFrameContext {
+  fml::RefPtr<Codec> codec;
+  std::unique_ptr<tonic::DartPersistentValue> callback;
+};
+
+void InvokeFrameCallback(void* user_data,
+                         FlutterSpiResult result,
+                         FlutterSpiImage* image,
+                         int32_t duration_ms) {
+  auto context = std::unique_ptr<CodecFrameContext>(
+      static_cast<CodecFrameContext*>(user_data));
+  auto dart_state = context->callback->dart_state().lock();
+  if (!dart_state) {
+    if (image != nullptr) {
+      SpiImageRelease(image);
+    }
+    return;
+  }
+  tonic::DartState::Scope scope(dart_state);
+  if (result != kFlutterSpiOk || image == nullptr) {
+    if (image != nullptr) {
+      SpiImageRelease(image);
+    }
+    tonic::DartInvoke(context->callback->value(),
+                      {Dart_Null(), tonic::ToDart(duration_ms),
+                       tonic::ToDart("Image failed to decode")});
+    return;
+  }
+  auto canvas_image = CanvasImage::Create(image);
+  tonic::DartInvoke(context->callback->value(),
+                    {tonic::ToDart(canvas_image),
+                     tonic::ToDart(duration_ms), tonic::ToDart("")});
+}
+
+}  // namespace
+
+Codec::~Codec() {
+  if (spi_codec_ != nullptr) {
+    SpiImageApi()->codec_release(spi_codec_);
+  }
+}
+
+int Codec::frameCount() const {
+  if (spi_codec_ == nullptr) {
+    return 0;
+  }
+  int32_t frame_count = 0;
+  int32_t repetition_count = 0;
+  if (SpiImageApi()->codec_get_info(spi_codec_, &frame_count,
+                                    &repetition_count) != kFlutterSpiOk) {
+    return 0;
+  }
+  return frame_count;
+}
+
+int Codec::repetitionCount() const {
+  if (spi_codec_ == nullptr) {
+    return 0;
+  }
+  int32_t frame_count = 0;
+  int32_t repetition_count = 0;
+  if (SpiImageApi()->codec_get_info(spi_codec_, &frame_count,
+                                    &repetition_count) != kFlutterSpiOk) {
+    return 0;
+  }
+  return repetition_count;
+}
+
+Dart_Handle Codec::getNextFrame(Dart_Handle callback_handle) {
+  if (!Dart_IsClosure(callback_handle)) {
+    return tonic::ToDart("Callback must be a function");
+  }
+  if (spi_codec_ == nullptr) {
+    return tonic::ToDart("Codec has been disposed");
+  }
+
+  auto* dart_state = UIDartState::Current();
+  auto* context = new CodecFrameContext{
+      fml::RefPtr<Codec>(this),
+      std::make_unique<tonic::DartPersistentValue>(dart_state, callback_handle)};
+  const FlutterSpiResult result = SpiImageApi()->codec_get_next_frame(
+      spi_codec_, InvokeFrameCallback, context);
+  if (result != kFlutterSpiOk) {
+    delete context;
+    return tonic::ToDart("Image failed to decode");
+  }
+  return Dart_Null();
+}
+
 void Codec::dispose() {
+  if (spi_codec_ != nullptr) {
+    SpiImageApi()->codec_release(spi_codec_);
+    spi_codec_ = nullptr;
+  }
   ClearDartWrapper();
 }
 
