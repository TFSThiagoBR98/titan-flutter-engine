+#ifndef FLUTTER_RUNTIME_SPI_TESTING_C_TEST_RUNTIME_H_
+#define FLUTTER_RUNTIME_SPI_TESTING_C_TEST_RUNTIME_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "flutter/runtime_spi/include/flutter_runtime_spi.h"
+
+typedef struct CTestRuntime {
+  size_t start_count;
+  size_t stop_count;
+  size_t destroy_count;
+  size_t add_view_count;
+  size_t remove_view_count;
+  size_t set_view_metrics_count;
+  size_t begin_frame_count;
+  size_t pointer_events_count;
+  size_t key_event_count;
+  size_t platform_message_count;
+  size_t set_semantics_enabled_count;
+  size_t semantics_action_count;
+  size_t set_accessibility_features_count;
+  size_t set_locales_count;
+  size_t set_user_settings_count;
+  size_t set_lifecycle_state_count;
+  size_t view_focus_count;
+  size_t notify_idle_count;
+
+  FlutterSpiViewMetrics last_view_metrics;
+  bool has_last_view_metrics;
+  FlutterSpiFrameInfo last_frame_info;
+  bool has_last_frame_info;
+  FlutterSpiPointerEvent* pointer_events;
+  size_t pointer_event_count;
+  FlutterSpiKeyEvent last_key_event;
+  bool has_last_key_event;
+  char* last_key_character;
+  char* last_channel;
+  uint8_t* last_payload;
+  size_t last_payload_size;
+  FlutterSpiResponseHandle* pending_response;
+  const FlutterSpiEngineApi* engine_api;
+  FlutterSpiEngine* engine;
+
+  bool respond_to_messages;
+  bool submit_on_begin_frame;
+  bool fail_start;
+} CTestRuntime;
+
+FlutterSpiRuntimeTable c_test_runtime_table(CTestRuntime* runtime);
+CTestRuntime* c_test_runtime_create(void);
+void c_test_runtime_free(CTestRuntime* runtime);
+
+#endif  // FLUTTER_RUNTIME_SPI_TESTING_C_TEST_RUNTIME_H_
