+constexpr FlutterSpiRect kCullRect = {
+    .left = 0.0f, .top = 0.0f, .right = 100.0f, .bottom = 100.0f};
+
+constexpr FlutterSpiPaint kPaint = {
+    .struct_size = sizeof(FlutterSpiPaint),
+    .color = {.red = 0.1f,
+              .green = 0.2f,
+              .blue = 0.3f,
+              .alpha = 0.4f,
+              .color_space = kFlutterSpiColorSpaceSRGB},
+    .blend_mode = kFlutterSpiBlendModeSrcOver,
+    .style = kFlutterSpiPaintStyleFill,
+    .stroke_width = 1.0f,
+    .stroke_cap = kFlutterSpiStrokeCapButt,
+    .stroke_join = kFlutterSpiStrokeJoinMiter,
+    .stroke_miter = 4.0f,
+    .anti_alias = true,
+    .invert_colors = false,
+    .shader = nullptr,
+    .color_filter = nullptr,
+    .image_filter = nullptr,
+    .filter_quality = kFlutterSpiFilterQualityNone,
+    .has_mask_blur = false,
+    .mask_blur_style = kFlutterSpiBlurStyleNormal,
+    .mask_blur_sigma = 0.0f,
+};
+
+sk_sp<DisplayList> FinishPicture(FlutterSpiPictureRecorder* recorder) {
+  const FlutterSpiSceneApi* scene_api = SpiSceneApi();
+  FlutterSpiPicture* picture = nullptr;
+  EXPECT_EQ(scene_api->recorder_finish(recorder, &picture), kFlutterSpiOk);
+  const DisplayList* display_list = SpiPictureDisplayListForTesting(picture);
+  EXPECT_NE(display_list, nullptr);
+  sk_sp<DisplayList> result = sk_ref_sp(display_list);
+  EXPECT_EQ(scene_api->picture_release(picture), kFlutterSpiOk);
+  return result;
+}
+
+sk_sp<DisplayList> DrawVertices(FlutterSpiEngine* engine,
+                                const FlutterSpiPaintEffectsApi* effects,
+                                FlutterSpiVertices* vertices) {
+  const FlutterSpiSceneApi* scene_api = SpiSceneApi();
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  EXPECT_EQ(scene_api->recorder_create(engine, &kCullRect, &recorder),
+            kFlutterSpiOk);
+  EXPECT_EQ(effects->canvas_draw_vertices(recorder, vertices,
+                                          kFlutterSpiBlendModeSrcOver,
+                                          &kPaint),
+            kFlutterSpiOk);
+  return FinishPicture(recorder);
+}
+
+std::shared_ptr<DlVertices> ExpectedVertices(
+    DlVertexMode mode,
+    const std::array<DlPoint, 4>& positions,
+    const DlPoint* texture_coordinates,
+    const DlColor* colors,
+    const uint16_t* indices,
+    int index_count) {
+  const std::shared_ptr<DlVertices> vertices = DlVertices::Make(
+      mode, static_cast<int>(positions.size()), positions.data(),
+      texture_coordinates, colors, index_count, indices);
+  return vertices;
+}
+
+class VertexProbe final : public IgnoreAttributeDispatchHelper,
+                          public IgnoreClipDispatchHelper,
+                          public IgnoreTransformDispatchHelper,
+                          public IgnoreDrawDispatchHelper {
+ public:
+  void drawVertices(const std::shared_ptr<DlVertices>& value,
+                    DlBlendMode) override {
+    count++;
+    vertices = value;
+  }
+
+  int count = 0;
+  std::shared_ptr<DlVertices> vertices;
+};
+
+void ExpectVerticesMatch(const sk_sp<DisplayList>& actual,
+                         const std::shared_ptr<DlVertices>& expected) {
+  ASSERT_NE(actual, nullptr);
+  VertexProbe probe;
+  actual->Dispatch(probe);
+  ASSERT_EQ(probe.count, 1);
+  ASSERT_NE(probe.vertices, nullptr);
+  EXPECT_TRUE(*probe.vertices == *expected);
+}
+
+TEST(SpiVertices, TrianglesMatchDartUi) {
+  FlutterSpiEngine engine = {};
+  const FlutterSpiEngineApi engine_api = SpiEngineApi::Create();
+  ASSERT_NE(engine_api.paint_effects, nullptr);
+
+  const std::array<FlutterSpiPoint, 4> positions = {
+      FlutterSpiPoint{10.0f, 10.0f}, FlutterSpiPoint{90.0f, 10.0f},
+      FlutterSpiPoint{90.0f, 90.0f}, FlutterSpiPoint{10.0f, 90.0f}};
+  FlutterSpiVertices* vertices = nullptr;
+  ASSERT_EQ(engine_api.paint_effects->vertices_create(
+                &engine, kFlutterSpiVertexModeTriangles, positions.data(),
+                positions.size(), nullptr, nullptr, nullptr, 0, &vertices),
+            kFlutterSpiOk);
+
+  const auto actual = DrawVertices(&engine, engine_api.paint_effects, vertices);
+  const std::array<DlPoint, 4> expected_positions = {
+      DlPoint(10.0f, 10.0f), DlPoint(90.0f, 10.0f), DlPoint(90.0f, 90.0f),
+      DlPoint(10.0f, 90.0f)};
+  const auto expected = ExpectedVertices(
+      DlVertexMode::kTriangles, expected_positions, nullptr, nullptr, nullptr,
+      0);
+  ExpectVerticesMatch(actual, expected);
+  EXPECT_EQ(engine_api.paint_effects->vertices_release(vertices),
+            kFlutterSpiOk);
+}
+
+TEST(SpiVertices, StripWithColorsMatchesDartUi) {
+  FlutterSpiEngine engine = {};
+  const FlutterSpiEngineApi engine_api = SpiEngineApi::Create();
+  ASSERT_NE(engine_api.paint_effects, nullptr);
+
+  const std::array<FlutterSpiPoint, 4> positions = {
+      FlutterSpiPoint{10.0f, 10.0f}, FlutterSpiPoint{90.0f, 10.0f},
+      FlutterSpiPoint{10.0f, 90.0f}, FlutterSpiPoint{90.0f, 90.0f}};
+  const std::array<FlutterSpiColor, 4> colors = {
+      FlutterSpiColor{1.0f, 0.0f, 0.0f, 1.0f, kFlutterSpiColorSpaceSRGB},
+      FlutterSpiColor{0.0f, 1.0f, 0.0f, 1.0f, kFlutterSpiColorSpaceSRGB},
+      FlutterSpiColor{0.0f, 0.0f, 1.0f, 1.0f, kFlutterSpiColorSpaceSRGB},
+      FlutterSpiColor{1.0f, 1.0f, 0.0f, 1.0f, kFlutterSpiColorSpaceSRGB},
+  };
+  FlutterSpiVertices* vertices = nullptr;
+  ASSERT_EQ(engine_api.paint_effects->vertices_create(
+                &engine, kFlutterSpiVertexModeTriangleStrip, positions.data(),
+                positions.size(), nullptr, colors.data(), nullptr, 0,
+                &vertices),
+            kFlutterSpiOk);
+
+  const auto actual = DrawVertices(&engine, engine_api.paint_effects, vertices);
+  const std::array<DlPoint, 4> expected_positions = {
+      DlPoint(10.0f, 10.0f), DlPoint(90.0f, 10.0f), DlPoint(10.0f, 90.0f),
+      DlPoint(90.0f, 90.0f)};
+  const std::array<DlColor, 4> expected_colors = {
+      DlColor::ARGB(1.0f, 1.0f, 0.0f, 0.0f),
+      DlColor::ARGB(1.0f, 0.0f, 1.0f, 0.0f),
+      DlColor::ARGB(1.0f, 0.0f, 0.0f, 1.0f),
+      DlColor::ARGB(1.0f, 1.0f, 1.0f, 0.0f)};
+  const auto expected = ExpectedVertices(
+      DlVertexMode::kTriangleStrip, expected_positions, nullptr,
+      expected_colors.data(), nullptr, 0);
+  ExpectVerticesMatch(actual, expected);
+  EXPECT_EQ(engine_api.paint_effects->vertices_release(vertices),
+            kFlutterSpiOk);
+}
