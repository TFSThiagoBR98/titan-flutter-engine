+  ASSERT_EQ(engine_api.paint_effects->vertices_create(
+                &engine, kFlutterSpiVertexModeTriangleFan, positions.data(),
+                positions.size(), texture_coordinates.data(), nullptr,
+                indices.data(), indices.size(), &vertices),
+            kFlutterSpiOk);
+
+  const auto actual = DrawVertices(&engine, engine_api.paint_effects, vertices);
