@@ -0,0 +1,189 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/effects/spi_vertices.h"
+
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <vector>
+
+#include "flutter/display_list/dl_builder.h"
+#include "flutter/display_list/dl_vertices.h"
+#include "flutter/runtime_spi/scene/spi_canvas.h"
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "flutter/runtime_spi/scene/spi_paint.h"
+
+namespace flutter {
+namespace {
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+SpiHandleTable<DlVertices>& Vertices() {
+  static SpiHandleTable<DlVertices> vertices;
+  return vertices;
+}
+
+std::shared_ptr<DlVertices> FindVertices(FlutterSpiVertices* vertices) {
+  return Vertices().Find(HandleValue(vertices));
+}
+
+bool IsValidVertexMode(int32_t mode) {
+  return mode >= kFlutterSpiVertexModeTriangles &&
+         mode <= kFlutterSpiVertexModeTriangleFan;
+}
+
+bool IsValidBlendMode(int32_t blend_mode) {
+  return blend_mode >= kFlutterSpiBlendModeClear &&
+         blend_mode <= kFlutterSpiBlendModeLuminosity;
+}
+
+DlVertexMode ToDlVertexMode(int32_t mode) {
+  return static_cast<DlVertexMode>(mode);
+}
+
+FlutterSpiResult ConvertVertexData(
+    const FlutterSpiPoint* positions,
+    size_t vertex_count,
+    const FlutterSpiPoint* texture_coordinates,
+    const FlutterSpiColor* colors,
+    std::vector<DlPoint>* dl_positions,
+    std::vector<DlPoint>* dl_texture_coordinates,
+    std::vector<DlColor>* dl_colors) {
+  if (vertex_count > 0 && positions == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  dl_positions->reserve(vertex_count);
+  for (size_t index = 0; index < vertex_count; ++index) {
+    DlPoint point;
+    if (!ToDlPoint(positions[index], &point)) {
+      return kFlutterSpiInvalidArgument;
+    }
+    dl_positions->push_back(point);
+  }
+
+  if (texture_coordinates != nullptr) {
+    dl_texture_coordinates->reserve(vertex_count);
+    for (size_t index = 0; index < vertex_count; ++index) {
+      DlPoint point;
+      if (!ToDlPoint(texture_coordinates[index], &point)) {
+        return kFlutterSpiInvalidArgument;
+      }
+      dl_texture_coordinates->push_back(point);
+    }
+  }
+
+  if (colors != nullptr) {
+    dl_colors->reserve(vertex_count);
+    for (size_t index = 0; index < vertex_count; ++index) {
+      dl_colors->push_back(ToDlColor(colors[index]));
+    }
+  }
+  return kFlutterSpiOk;
+}
+
+}  // namespace
+
+FlutterSpiResult SpiVerticesCreate(
+    FlutterSpiEngine* engine,
+    int32_t mode,
+    const FlutterSpiPoint* positions,
+    size_t vertex_count,
+    const FlutterSpiPoint* texture_coordinates,
+    const FlutterSpiColor* colors,
+    const uint16_t* indices,
+    size_t index_count,
+    FlutterSpiVertices** out_vertices) {
+  if (out_vertices == nullptr || !IsValidVertexMode(mode) ||
+      vertex_count > static_cast<size_t>(std::numeric_limits<int>::max()) ||
+      index_count > static_cast<size_t>(std::numeric_limits<int>::max()) ||
+      (index_count > 0 && indices == nullptr) ||
+      (vertex_count == 0 && index_count > 0)) {
+    return kFlutterSpiInvalidArgument;
+  }
+
+  std::vector<DlPoint> dl_positions;
+  std::vector<DlPoint> dl_texture_coordinates;
+  std::vector<DlColor> dl_colors;
+  const FlutterSpiResult conversion_result = ConvertVertexData(
+      positions, vertex_count, texture_coordinates, colors, &dl_positions,
+      &dl_texture_coordinates, &dl_colors);
+  if (conversion_result != kFlutterSpiOk) {
+    return conversion_result;
+  }
+
+  DlVertices::Builder::Flags flags;
+  if (texture_coordinates != nullptr) {
+    flags |= DlVertices::Builder::kHasTextureCoordinates;
+  }
+  if (colors != nullptr) {
+    flags |= DlVertices::Builder::kHasColors;
+  }
+  DlVertices::Builder builder(ToDlVertexMode(mode), static_cast<int>(vertex_count),
+                              flags, static_cast<int>(index_count));
+  if (!builder.is_valid()) {
+    return kFlutterSpiInternalError;
+  }
+  builder.store_vertices(dl_positions.data());
+  if (texture_coordinates != nullptr) {
+    builder.store_texture_coordinates(dl_texture_coordinates.data());
+  }
+  if (colors != nullptr) {
+    builder.store_colors(dl_colors.data());
+  }
+  if (index_count > 0) {
+    for (size_t index = 0; index < index_count; ++index) {
+      if (indices[index] >= vertex_count) {
+        return kFlutterSpiInvalidArgument;
+      }
+    }
+    builder.store_indices(indices);
+  }
+
+  std::shared_ptr<DlVertices> vertices = builder.build();
+  if (vertices == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  *out_vertices = MakeHandle<FlutterSpiVertices>(
+      Vertices().Insert(std::move(vertices)));
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiVerticesRelease(FlutterSpiVertices* vertices) {
+  return Vertices().Release(HandleValue(vertices)) ? kFlutterSpiOk
+                                                     : kFlutterSpiInvalidHandle;
+}
+
+FlutterSpiResult CanvasDrawVertices(FlutterSpiPictureRecorder* recorder,
+                                    FlutterSpiVertices* vertices,
+                                    int32_t blend_mode,
+                                    const FlutterSpiPaint* paint) {
+  DisplayListBuilder* builder = SpiPictureRecorderBuilder(recorder);
+  const std::shared_ptr<DlVertices> vertices_value = FindVertices(vertices);
+  if (builder == nullptr || vertices_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (paint == nullptr || !IsValidBlendMode(blend_mode)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  DlPaint dl_paint;
+  const FlutterSpiResult paint_result = TryToDlPaint(*paint, &dl_paint);
+  if (paint_result != kFlutterSpiOk) {
+    return paint_result;
+  }
+  builder->DrawVertices(vertices_value, static_cast<DlBlendMode>(blend_mode),
+                        dl_paint);
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
