+  const std::array<FlutterSpiPoint, 4> texture_coordinates = {
+      FlutterSpiPoint{0.5f, 0.0f}, FlutterSpiPoint{1.0f, 0.5f},
+      FlutterSpiPoint{0.5f, 1.0f}, FlutterSpiPoint{0.0f, 0.5f}};
