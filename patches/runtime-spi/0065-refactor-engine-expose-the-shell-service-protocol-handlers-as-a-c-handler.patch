+
+  const FlutterSpiServiceHandler* handler() const { return &handler_; }
+
+ private:
+  static bool Handle(void* user_data,
+                     const char* method,
+                     const char* const* keys,
+                     const char* const* values,
+                     size_t param_count,
+                     char** out_json);
+  static void FreeJson(void* user_data, char* json);
+
+  bool HandleMessage(const char* method,
+                     const char* const* keys,
+                     const char* const* values,
+                     size_t param_count,
+                     char** out_json);
+  bool HasMethod(const char* method) const;
+
+  fml::WeakPtr<Shell> shell_;
+  const TaskRunners task_runners_;
+  std::vector<const char*> methods_;
+  FlutterSpiServiceHandler handler_;
+};
