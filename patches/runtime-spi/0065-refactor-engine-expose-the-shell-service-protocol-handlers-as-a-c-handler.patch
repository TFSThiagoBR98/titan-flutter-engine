+static std::unique_ptr<Shell> CreateShellWithFakeRuntime(ShellTest* test) {
+  auto settings = test->CreateSettingsForFixture();
+  auto task_runners = test->GetTaskRunnersForFixture();
+  auto factory = std::make_shared<FakeRuntimeBackendFactory>();
+  return Shell::Create(
+      PlatformData(), task_runners, settings,
+      ShellTestPlatformViewBuilder({}),
