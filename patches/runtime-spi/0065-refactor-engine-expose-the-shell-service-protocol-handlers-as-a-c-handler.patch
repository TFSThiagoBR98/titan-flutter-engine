+TEST_F(ShellTest, SpiServiceProtocolShellWorksWithoutTransport) {
+  auto shell = CreateShellWithFakeRuntime(this);
+  ASSERT_NE(shell, nullptr);
+
+  EXPECT_NE(GetServiceProtocolHandler(shell.get()), nullptr);
+
+  DestroyShell(std::move(shell));
+}
+
+TEST_F(ShellTest, SpiServiceProtocolHandlerListsEveryMethod) {
+  auto shell = CreateShellWithFakeRuntime(this);
+  ASSERT_NE(shell, nullptr);
+
+  const auto* handler = GetServiceProtocolHandler(shell.get());
+  ASSERT_NE(handler, nullptr);
+  ASSERT_NE(handler->methods, nullptr);
+
+  const std::array<std::string_view, 10> expected_methods = {
+      FLUTTER_SPI_SERVICE_METHOD_SCREENSHOT,
+      FLUTTER_SPI_SERVICE_METHOD_SCREENSHOT_SKP,
+      FLUTTER_SPI_SERVICE_METHOD_RUN_IN_VIEW,
+      FLUTTER_SPI_SERVICE_METHOD_FLUSH_UI_THREAD_TASKS,
+      FLUTTER_SPI_SERVICE_METHOD_SET_ASSET_BUNDLE_PATH,
+      FLUTTER_SPI_SERVICE_METHOD_GET_DISPLAY_REFRESH_RATE,
+      FLUTTER_SPI_SERVICE_METHOD_GET_SKSL,
+      FLUTTER_SPI_SERVICE_METHOD_ESTIMATE_RASTER_CACHE_MEMORY,
+      FLUTTER_SPI_SERVICE_METHOD_RELOAD_ASSET_FONTS,
+      FLUTTER_SPI_SERVICE_METHOD_GET_PIPELINE_USAGE,
+  };
+  ASSERT_EQ(handler->method_count, expected_methods.size());
+  for (size_t index = 0; index < handler->method_count; index++) {
+    EXPECT_STREQ(handler->methods[index], expected_methods[index].data());
+  }
+
+  DestroyShell(std::move(shell));
+}
+
+TEST_F(ShellTest, SpiServiceProtocolUnknownMethodReturnsFalse) {
+  auto shell = CreateShellWithFakeRuntime(this);
+  ASSERT_NE(shell, nullptr);
+
+  const auto* handler = GetServiceProtocolHandler(shell.get());
+  ASSERT_NE(handler, nullptr);
+  char* json = nullptr;
+
+  EXPECT_FALSE(handler->handle(handler->user_data, "_flutter.unknown", nullptr,
+                               nullptr, 0, &json));
+  EXPECT_EQ(json, nullptr);
+
+  DestroyShell(std::move(shell));
+}
+
+TEST_F(ShellTest, SpiServiceProtocolHandleRunsOnTheMethodRunner) {
+  auto shell = CreateShellWithFakeRuntime(this);
+  ASSERT_NE(shell, nullptr);
+
+  const auto* handler = GetServiceProtocolHandler(shell.get());
+  ASSERT_NE(handler, nullptr);
+  char* json = nullptr;
+
+  ASSERT_TRUE(handler->handle(handler->user_data,
+                              FLUTTER_SPI_SERVICE_METHOD_GET_DISPLAY_REFRESH_RATE,
+                              nullptr, nullptr, 0, &json));
+  ASSERT_NE(json, nullptr);
+  EXPECT_NE(std::string(json).find("DisplayRefreshRate"), std::string::npos);
+  handler->free_json(handler->user_data, json);
+
+  DestroyShell(std::move(shell));
+}
+
+TEST_F(ShellTest, SpiServiceProtocolHandlerAfterShellDestructionFails) {
+  auto shell = CreateShellWithFakeRuntime(this);
+  ASSERT_NE(shell, nullptr);
+
+  auto protocol = std::make_unique<ShellServiceProtocol>(
+      GetWeakPtr(shell.get()), shell->GetTaskRunners());
+  const auto* handler = protocol->handler();
+  ASSERT_NE(handler, nullptr);
+  DestroyShell(std::move(shell));
+
+  char* json = nullptr;
+  EXPECT_FALSE(handler->handle(handler->user_data,
+                               FLUTTER_SPI_SERVICE_METHOD_GET_DISPLAY_REFRESH_RATE,
+                               nullptr, nullptr, 0, &json));
+  EXPECT_EQ(json, nullptr);
+}
