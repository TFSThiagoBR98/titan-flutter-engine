@@ -0,0 +1,146 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#define RAPIDJSON_HAS_STDSTRING 1
+
+#include "flutter/shell/common/shell_service_protocol.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "flutter/fml/memory/weak_ptr.h"
+#include "flutter/fml/logging.h"
+#include "flutter/fml/posix_wrappers.h"
+#include "flutter/fml/synchronization/waitable_event.h"
+#include "flutter/shell/common/shell.h"
+#include "rapidjson/document.h"
+#include "rapidjson/stringbuffer.h"
+#include "rapidjson/writer.h"
+
+namespace flutter {
+
+namespace {
+
+using ServiceProtocolMap = ServiceProtocol::Handler::ServiceProtocolMap;
+
+const std::vector<const char*>& ServiceProtocolMethods() {
+  static const std::vector<const char*> methods = {
+      FLUTTER_SPI_SERVICE_METHOD_SCREENSHOT,
+      FLUTTER_SPI_SERVICE_METHOD_SCREENSHOT_SKP,
+      FLUTTER_SPI_SERVICE_METHOD_RUN_IN_VIEW,
+      FLUTTER_SPI_SERVICE_METHOD_FLUSH_UI_THREAD_TASKS,
+      FLUTTER_SPI_SERVICE_METHOD_SET_ASSET_BUNDLE_PATH,
+      FLUTTER_SPI_SERVICE_METHOD_GET_DISPLAY_REFRESH_RATE,
+      FLUTTER_SPI_SERVICE_METHOD_GET_SKSL,
+      FLUTTER_SPI_SERVICE_METHOD_ESTIMATE_RASTER_CACHE_MEMORY,
+      FLUTTER_SPI_SERVICE_METHOD_RELOAD_ASSET_FONTS,
+      FLUTTER_SPI_SERVICE_METHOD_GET_PIPELINE_USAGE,
+  };
+  return methods;
+}
+
+}  // namespace
+
+ShellServiceProtocol::ShellServiceProtocol(fml::WeakPtr<Shell> shell,
+                                           const TaskRunners& task_runners)
+    : shell_(std::move(shell)),
+      task_runners_(task_runners),
+      methods_(ServiceProtocolMethods()),
+      handler_{sizeof(FlutterSpiServiceHandler),
+               this,
+               methods_.data(),
+               methods_.size(),
+               &ShellServiceProtocol::Handle,
+               &ShellServiceProtocol::FreeJson} {
+  FML_DCHECK(task_runners_.IsValid());
+}
+
+ShellServiceProtocol::~ShellServiceProtocol() = default;
+
+bool ShellServiceProtocol::Handle(void* user_data,
+                                  const char* method,
+                                  const char* const* keys,
+                                  const char* const* values,
+                                  size_t param_count,
+                                  char** out_json) {
+  if (user_data == nullptr) {
+    return false;
+  }
+  return static_cast<ShellServiceProtocol*>(user_data)->HandleMessage(
+      method, keys, values, param_count, out_json);
+}
+
+void ShellServiceProtocol::FreeJson(void* user_data, char* json) {
+  std::free(json);
+}
+
+bool ShellServiceProtocol::HasMethod(const char* method) const {
+  if (method == nullptr) {
+    return false;
+  }
+  for (const char* registered_method : methods_) {
+    if (std::strcmp(registered_method, method) == 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ShellServiceProtocol::HandleMessage(const char* method,
+                                         const char* const* keys,
+                                         const char* const* values,
+                                         size_t param_count,
+                                         char** out_json) {
+  if (out_json == nullptr || !HasMethod(method) || !shell_) {
+    return false;
+  }
+  if (param_count != 0 && (keys == nullptr || values == nullptr)) {
+    return false;
+  }
+
+  ServiceProtocolMap params;
+  for (size_t index = 0; index < param_count; index++) {
+    if (keys[index] == nullptr || values[index] == nullptr) {
+      return false;
+    }
+    params[std::string_view(keys[index])] = std::string_view(values[index]);
+  }
+
+  const std::string method_name(method);
+  const auto method_runner = shell_->GetServiceProtocolHandlerTaskRunner(
+      method_name);
+  if (!method_runner) {
+    return false;
+  }
+
+  fml::AutoResetWaitableEvent latch;
+  rapidjson::Document response;
+  bool result = false;
+  fml::TaskRunner::RunNowOrPostTask(
+      method_runner,
+      [shell = shell_, method_name, params, &response, &result, &latch]() {
+        if (shell) {
+          result = shell->HandleServiceProtocolMessage(
+              method_name, params, &response);
+        }
+        latch.Signal();
+      });
+  latch.Wait();
+
+  if (!result) {
+    return false;
+  }
+
+  rapidjson::StringBuffer buffer;
+  rapidjson::Writer<rapidjson::StringBuffer> writer(buffer);
+  response.Accept(writer);
+  *out_json = fml::strdup(buffer.GetString());
+  return *out_json != nullptr;
+}
+
+}  // namespace flutter
