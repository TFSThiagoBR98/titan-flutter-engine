+FlutterSpiRect ToSpiRect(const DlRect& rect) {
+  return {rect.GetLeft(), rect.GetTop(), rect.GetRight(), rect.GetBottom()};
+}
+
+template <typename RoundRect>
+FlutterSpiRRect ToSpiRRect(const RoundRect& round_rect) {
+  const auto& bounds = round_rect.GetBounds();
+  const auto& radii = round_rect.GetRadii();
+  return {ToSpiRect(bounds),
+          {{radii.top_left.width, radii.top_left.height},
+           {radii.top_right.width, radii.top_right.height},
+           {radii.bottom_right.width, radii.bottom_right.height},
+           {radii.bottom_left.width, radii.bottom_left.height}}};
+}
+
+FlutterSpiMatrix ToSpiMatrix(const DlMatrix& matrix) {
+  FlutterSpiMatrix result;
+  for (int index = 0; index < 16; index++) {
+    result.m[index] = matrix.m[index];
+  }
+  return result;
+}
