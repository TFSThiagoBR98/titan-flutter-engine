+class SpiConformance : public ShellTest {
+ protected:
+  void SetUp() override {
+    runtime_ = c_test_runtime_create();
+    task_runners_ = std::make_unique<TaskRunners>(GetTaskRunnersForFixture());
+  }
+
+  void TearDown() override {
+    if (shell_ != nullptr) {
+      DestroyShell(std::move(shell_), *task_runners_);
+    }
+    c_test_runtime_free(runtime_);
+  }
+
+  void StartShell() {
+    auto settings = CreateSettingsForFixture();
+    auto factory = std::make_shared<SpiRuntimeBackendFactory>(
+        c_test_runtime_table(runtime_));
+    shell_ = Shell::Create(
+        PlatformData(), *task_runners_, settings,
+        ShellTestPlatformViewBuilder({}),
+        [](Shell& shell) { return std::make_unique<Rasterizer>(shell); },
+        factory);
+
+    ASSERT_TRUE(shell_->IsSetup());
+    ASSERT_EQ(shell_->GetDartVM(), nullptr);
+    PlatformViewNotifyCreated(shell_.get());
+    RunEngine(shell_.get(), RunConfiguration::InferFromSettings(settings));
+  }
+
+  void StartShellWithHandler(
+      const std::shared_ptr<PlatformMessageHandler>& handler) {
+    auto settings = CreateSettingsForFixture();
+    auto factory = std::make_shared<SpiRuntimeBackendFactory>(
+        c_test_runtime_table(runtime_));
+    shell_ = Shell::Create(
+        PlatformData(), *task_runners_, settings,
+        [handler](Shell& shell) {
+          return std::make_unique<HandlerPlatformView>(
+              shell, shell.GetTaskRunners(), handler);
+        },
+        [](Shell& shell) { return std::make_unique<Rasterizer>(shell); },
+        factory);
+
+    ASSERT_TRUE(shell_->IsSetup());
+    ASSERT_EQ(shell_->GetDartVM(), nullptr);
+    RunEngine(shell_.get(), RunConfiguration::InferFromSettings(settings));
+  }
+
+  void FlushUi() {
+    PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [] {});
+  }
+
+  CTestRuntime* runtime_ = nullptr;
+  std::unique_ptr<TaskRunners> task_runners_;
+  std::unique_ptr<Shell> shell_;
+};
+
+TEST_F(SpiConformance, HandshakeStartsRuntimeWithoutDartVM) {
+  ASSERT_FALSE(DartVMRef::IsInstanceRunning());
+
+  StartShell();
+
+  EXPECT_EQ(runtime_->start_count, 1u);
+  EXPECT_FALSE(DartVMRef::IsInstanceRunning());
+}
+
+TEST_F(SpiConformance, ViewMetricsReachRuntime) {
+  StartShell();
+  ViewportMetrics metrics;
+  metrics.device_pixel_ratio = 2.0;
+  metrics.physical_width = 800;
+  metrics.physical_height = 600;
+  metrics.physical_padding_top = 11;
+  metrics.physical_view_inset_bottom = 13;
+
+  PostSync(shell_->GetTaskRunners().GetPlatformTaskRunner(), [&] {
+    shell_->GetPlatformView()->SetViewportMetrics(kImplicitViewId, metrics);
+  });
+  FlushUi();
+
+  ASSERT_TRUE(runtime_->has_last_view_metrics);
+  EXPECT_EQ(runtime_->last_view_metrics.view_id, kImplicitViewId);
+  EXPECT_EQ(runtime_->last_view_metrics.device_pixel_ratio, 2.0);
+  EXPECT_EQ(runtime_->last_view_metrics.physical_width, 800.0);
+  EXPECT_EQ(runtime_->last_view_metrics.physical_height, 600.0);
+  EXPECT_EQ(runtime_->last_view_metrics.physical_padding_top, 11.0);
+  EXPECT_EQ(runtime_->last_view_metrics.physical_view_inset_bottom, 13.0);
+}
+
+TEST_F(SpiConformance, FrameRoundTrip) {
+  runtime_->submit_on_begin_frame = true;
+  StartShell();
+
+  PumpOneFrame(shell_.get());
+  PostSync(shell_->GetTaskRunners().GetRasterTaskRunner(), [&] {
+    auto* layer_tree =
+        shell_->GetRasterizer()->GetLastLayerTree(kImplicitViewId);
+    ASSERT_NE(layer_tree, nullptr);
+    EXPECT_EQ(layer_tree->frame_size(), DlISize(1, 1));
+  });
+}
+
+TEST_F(SpiConformance, PointerEventsReachRuntime) {
+  StartShell();
+  auto packet = std::make_unique<PointerDataPacket>(1);
+  packet->SetPointerData(0, PointerData{
+                                .change = PointerData::Change::kDown,
+                                .physical_x = 23,
+                                .physical_y = 29,
+                                .view_id = kImplicitViewId,
+                            });
+
+  DispatchPointerData(shell_.get(), std::move(packet));
+  FlushUi();
+
+  ASSERT_EQ(runtime_->pointer_event_count, 1u);
+  EXPECT_EQ(runtime_->pointer_events[0].view_id, kImplicitViewId);
+  EXPECT_EQ(runtime_->pointer_events[0].change, kFlutterSpiPointerChangeDown);
+  EXPECT_EQ(runtime_->pointer_events[0].physical_x, 23.0);
+  EXPECT_EQ(runtime_->pointer_events[0].physical_y, 29.0);
+}
+
+TEST_F(SpiConformance, KeyEventReachesRuntime) {
+  runtime_->key_event_handled = true;
+  StartShell();
+  KeyData key_data;
+  key_data.Clear();
+  key_data.timestamp = 17;
+  key_data.type = KeyEventType::kDown;
+  key_data.physical = 23;
+  key_data.logical = 29;
+  key_data.device_type = KeyEventDeviceType::kKeyboard;
+  KeyDataPacket packet(key_data, "a");
+  auto response = fml::AdoptRef(new CapturingResponse());
+  auto message = std::make_unique<PlatformMessage>(
+      "flutter/keydata",
+      fml::MallocMapping::Copy(packet.data().data(), packet.data().size()),
+      response);
+
+  SendPlatformMessage(shell_.get(), std::move(message));
+  FlushUi();
+  response->Wait();
+
+  ASSERT_TRUE(runtime_->has_last_key_event);
+  EXPECT_EQ(runtime_->last_key_event.timestamp_us, 17u);
+  EXPECT_EQ(runtime_->last_key_event.physical, 23u);
+  EXPECT_EQ(runtime_->last_key_event.logical, 29u);
+  EXPECT_STREQ(runtime_->last_key_event.character, "a");
+  ASSERT_EQ(response->bytes().size(), 1u);
+  EXPECT_EQ(response->bytes()[0], 1u);
+}
+
+TEST_F(SpiConformance, PlatformMessageRoundTrip) {
+  runtime_->respond_to_messages = true;
+  StartShell();
+  auto response = fml::AdoptRef(new CapturingResponse());
+  auto message = std::make_unique<PlatformMessage>(
+      kPlatformChannel,
+      fml::MallocMapping::Copy(kPlatformPayload, sizeof(kPlatformPayload) - 1),
+      response);
+
+  SendPlatformMessage(shell_.get(), std::move(message));
+  FlushUi();
+  response->Wait();
+
+  ASSERT_EQ(runtime_->platform_message_count, 1u);
+  EXPECT_STREQ(runtime_->last_channel, kPlatformChannel);
+  ASSERT_EQ(runtime_->last_payload_size, sizeof(kPlatformPayload) - 1);
+  EXPECT_EQ(std::memcmp(runtime_->last_payload, kPlatformPayload,
+                        runtime_->last_payload_size),
+            0);
+  EXPECT_EQ(
+      response->bytes(),
+      std::vector<uint8_t>(kPlatformPayload,
+                           kPlatformPayload + sizeof(kPlatformPayload) - 1));
+}
+
+TEST_F(SpiConformance, RuntimeSendsPlatformMessageAndGetsReply) {
+  auto handler = std::make_shared<ReplyingPlatformMessageHandler>();
+  StartShellWithHandler(handler);
+  FlushUi();
+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    const uint8_t payload[] = {'r', 'e', 'q'};
+    const FlutterSpiResult result = runtime_->engine_api->send_platform_message(
+        runtime_->engine, "outgoing", payload, sizeof(payload), nullptr,
+        nullptr);
+    EXPECT_EQ(result, kFlutterSpiOk);
+  });
+  handler->Wait();
+
+  EXPECT_TRUE(handler->handled());
+}
+
+TEST_F(SpiConformance, DataIsOnlyBorrowed) {
+  runtime_->respond_to_messages = true;
+  StartShell();
+  auto* source = static_cast<uint8_t*>(std::malloc(3));
+  ASSERT_NE(source, nullptr);
+  std::memcpy(source, "old", 3);
+  auto response = fml::AdoptRef(new MutatingResponse(source));
+  auto message = std::make_unique<PlatformMessage>(
+      "borrowed", fml::MallocMapping(source, 3), response);
+
+  SendPlatformMessage(shell_.get(), std::move(message));
+  FlushUi();
+  response->Wait();
+
+  ASSERT_EQ(runtime_->last_payload_size, 3u);
+  EXPECT_EQ(runtime_->last_payload[0], 'o');
+}
+
+TEST_F(SpiConformance, UnansweredMessageIsCompletedEmptyOnDestroy) {
+  runtime_->respond_to_messages = false;
+  StartShell();
+  auto response = fml::AdoptRef(new CapturingResponse());
+  auto message = std::make_unique<PlatformMessage>(
+      "unanswered", fml::MallocMapping::Copy("x", 1), response);
+
+  SendPlatformMessage(shell_.get(), std::move(message));
+  FlushUi();
+  ASSERT_NE(runtime_->pending_response, nullptr);
+  DestroyShell(std::move(shell_), *task_runners_);
+  response->Wait();
+  EXPECT_TRUE(response->bytes().empty());
+}
+
+TEST_F(SpiConformance, SubmitAfterViewRemovedIsStale) {
+  StartShell();
+  ViewportMetrics metrics;
+  metrics.physical_width = 10;
+  metrics.physical_height = 10;
+  fml::AutoResetWaitableEvent view_latch;
+  bool added = false;
+  PostSync(shell_->GetTaskRunners().GetPlatformTaskRunner(), [&] {
+    shell_->GetPlatformView()->AddView(kTestViewId, metrics,
+                                       [&added, &view_latch](bool success) {
+                                         added = success;
+                                         view_latch.Signal();
+                                       });
+  });
+  view_latch.Wait();
+  ASSERT_TRUE(added);
+  FlushUi();
+
+  fml::AutoResetWaitableEvent remove_latch;
+  bool removed = false;
+  PostSync(shell_->GetTaskRunners().GetPlatformTaskRunner(), [&] {
+    shell_->GetPlatformView()->RemoveView(
+        kTestViewId, [&removed, &remove_latch](bool success) {
+          removed = success;
+          remove_latch.Signal();
+        });
+  });
+  remove_latch.Wait();
+  ASSERT_TRUE(removed);
+  FlushUi();
+
+  FlutterSpiScene* scene = nullptr;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    ASSERT_EQ(runtime_->engine_api->scene_create_empty(runtime_->engine, 10, 10,
+                                                       &scene),
+              kFlutterSpiOk);
+    EXPECT_EQ(runtime_->engine_api->submit_frame(
+                  runtime_->engine, kTestViewId,
+                  runtime_->last_frame_info.frame_token, scene, 1.0),
+              kFlutterSpiStaleFrame);
+  });
+}
+
+TEST_F(SpiConformance, ReportErrorStopsRuntime) {
+  StartShell();
+  PumpOneFrame(shell_.get());
+  const size_t begin_frame_count = runtime_->begin_frame_count;
+
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    EXPECT_EQ(runtime_->engine_api->report_error(runtime_->engine, "failure"),
+              kFlutterSpiOk);
+  });
+  PumpOneFrame(shell_.get());
+
+  EXPECT_EQ(runtime_->begin_frame_count, begin_frame_count);
+  EXPECT_EQ(runtime_->stop_count, 1u);
+
+  DestroyShell(std::move(shell_), *task_runners_);
+  EXPECT_EQ(runtime_->destroy_count, 1u);
+}
+
+TEST_F(SpiConformance, ShutdownCallsStopThenDestroyOnce) {
+  StartShell();
+
+  DestroyShell(std::move(shell_), *task_runners_);
+
+  EXPECT_EQ(runtime_->stop_count, 1u);
+  EXPECT_EQ(runtime_->destroy_count, 1u);
+}
+
