+void PostSync(const fml::RefPtr<fml::TaskRunner>& task_runner,
+              const fml::closure& task) {
+  fml::AutoResetWaitableEvent latch;
+  fml::TaskRunner::RunNowOrPostTask(task_runner, [&latch, &task] {
+    task();
+    latch.Signal();
+  });
+  latch.Wait();
+}
+
+class CapturingResponse final : public PlatformMessageResponse {
+ public:
+  void Complete(std::unique_ptr<fml::Mapping> data) override {
+    if (data != nullptr) {
+      bytes_.assign(data->GetMapping(), data->GetMapping() + data->GetSize());
+    }
+    latch_.Signal();
+  }
+
+  void CompleteEmpty() override { latch_.Signal(); }
+
+  void Wait() { latch_.Wait(); }
+
+  const std::vector<uint8_t>& bytes() const { return bytes_; }
+
+ private:
+  fml::AutoResetWaitableEvent latch_;
+  std::vector<uint8_t> bytes_;
+};
+
+class MutatingResponse final : public PlatformMessageResponse {
+ public:
+  explicit MutatingResponse(uint8_t* source) : source_(source) {}
+
+  void Complete(std::unique_ptr<fml::Mapping> data) override {
+    source_[0] = 'n';
+    latch_.Signal();
+  }
+
+  void CompleteEmpty() override { latch_.Signal(); }
+
+  void Wait() { latch_.Wait(); }
+
+ private:
+  uint8_t* source_;
+  fml::AutoResetWaitableEvent latch_;
+};
+
+class ReplyingPlatformMessageHandler final : public PlatformMessageHandler {
+ public:
+  void HandlePlatformMessage(
+      std::unique_ptr<PlatformMessage> message) override {
+    if (message->response()) {
+      message->response()->Complete(std::make_unique<fml::MallocMapping>(
+          fml::MallocMapping::Copy("reply", 5)));
+    }
+    handled_ = true;
+    latch_.Signal();
+  }
+
+  bool DoesHandlePlatformMessageOnPlatformThread() const override {
+    return false;
+  }
+
+  void InvokePlatformMessageResponseCallback(
+      int response_id,
+      std::unique_ptr<fml::Mapping> mapping) override {}
+
+  void InvokePlatformMessageEmptyResponseCallback(int response_id) override {}
+
+  void Wait() { latch_.Wait(); }
+
+  bool handled() const { return handled_; }
+
+ private:
+  fml::AutoResetWaitableEvent latch_;
+  bool handled_ = false;
+};
+
+class HandlerPlatformView final : public PlatformView {
+ public:
+  HandlerPlatformView(Shell& shell,
+                      const TaskRunners& task_runners,
+                      std::shared_ptr<PlatformMessageHandler> handler)
+      : PlatformView(shell, task_runners), handler_(std::move(handler)) {}
+
+  std::shared_ptr<PlatformMessageHandler> GetPlatformMessageHandler()
+      const override {
+    return handler_;
+  }
+
+ private:
+  std::shared_ptr<PlatformMessageHandler> handler_;
+};
