+@pragma('vm:entry-point')
+void buildParagraphFrame() {
+  const int paragraphCount = 80;
+  final ParagraphStyle paragraphStyle = ParagraphStyle(
+    textAlign: TextAlign.center,
+    maxLines: 3,
+    ellipsis: '…',
+  );
+  const String firstSpanText = 'A compact paragraph with a colored span.';
+  const String secondSpanText = 'A weighted span keeps the layout realistic.';
+  const String thirdSpanText = 'Decorated text completes this benchmark line.';
+
+  for (int index = 0; index < paragraphCount; index++) {
+    final ParagraphBuilder builder = ParagraphBuilder(paragraphStyle);
+    builder.pushStyle(TextStyle(
+      fontSize: 16,
+      fontFamily: 'sans-serif',
+      color: Color(0xFF111827),
+    ));
+    builder.pushStyle(TextStyle(color: Color(0xFF2563EB)));
+    builder.addText(firstSpanText);
+    builder.pop();
+    builder.pushStyle(TextStyle(fontWeight: FontWeight.w600));
+    builder.addText(secondSpanText);
+    builder.pop();
+    builder.pushStyle(TextStyle(
+      letterSpacing: 0.5,
+      decoration: TextDecoration.underline,
+    ));
+    builder.addText(thirdSpanText);
+    builder.pop();
+    builder.pop();
+
+    final Paragraph paragraph = builder.build();
+    paragraph.layout(const ParagraphConstraints(width: 300));
+    paragraph.height;
+    paragraph.computeLineMetrics();
+    paragraph.getBoxesForRange(0, 20);
+    paragraph.getPositionForOffset(const Offset(50, 10));
+
+    final PictureRecorder recorder = PictureRecorder();
+    final Canvas canvas = Canvas(
+      recorder,
+      const Rect.fromLTWH(0, 0, 300, 100),
+    );
+    canvas.drawParagraph(paragraph, Offset.zero);
+    final Picture picture = recorder.endRecording();
+    paragraph.dispose();
+    picture.dispose();
+  }
+}
