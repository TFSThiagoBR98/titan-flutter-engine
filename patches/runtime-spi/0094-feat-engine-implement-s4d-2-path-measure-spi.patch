+
+FlutterSpiResult PathMeasureGetPosTan(FlutterSpiPathMeasure* measure,
+                                      int32_t contour_index,
+                                      float distance,
+                                      FlutterSpiPoint* out_position,
+                                      FlutterSpiPoint* out_tangent,
+                                      bool* out_ok) {
+  const auto measure_value = FindPathMeasure(measure);
+  if (measure_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out_position == nullptr || out_tangent == nullptr || out_ok == nullptr ||
+      !std::isfinite(distance)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  SkPoint position;
+  SkVector tangent;
+  *out_ok = measure_value->GetPosTan(contour_index, distance, &position,
+                                     &tangent);
+  if (*out_ok) {
+    *out_position = {position.x(), position.y()};
+    *out_tangent = {tangent.x(), tangent.y()};
+  }
+  return kFlutterSpiOk;
