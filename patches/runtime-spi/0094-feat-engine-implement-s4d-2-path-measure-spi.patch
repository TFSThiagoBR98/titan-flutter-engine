+  const auto measure_value = FindPathMeasure(measure);
+  const auto path_value = FindPath(path);
+  if (measure_value == nullptr || path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  measure_value->SetPath(*path_value, force_closed);
+  return kFlutterSpiOk;
+}
