+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/scene/spi_path_measure.h"
+
+namespace flutter {
+
+SpiPathMeasure::SpiPathMeasure(const SpiPath& path, bool force_closed)
+    : path_measure_(
+          std::make_unique<SkContourMeasureIter>(path.sk_path(), force_closed,
+                                                 1)) {}
+
+void SpiPathMeasure::SetPath(const SpiPath& path, bool force_closed) {
+  path_measure_->reset(path.sk_path(), force_closed, 1);
+  measures_.clear();
+}
+
+float SpiPathMeasure::GetLength(int32_t contour_index) const {
+  if (contour_index < 0 ||
+      static_cast<size_t>(contour_index) >= measures_.size()) {
+    return -1;
+  }
+  return measures_[contour_index]->length();
+}
+
+bool SpiPathMeasure::GetPosTan(int32_t contour_index,
+                               float distance,
+                               SkPoint* position,
+                               SkVector* tangent) const {
+  if (contour_index < 0 ||
+      static_cast<size_t>(contour_index) >= measures_.size()) {
+    return false;
+  }
+  return measures_[contour_index]->getPosTan(distance, position, tangent);
+}
+
+bool SpiPathMeasure::GetSegment(int32_t contour_index,
+                                float start,
+                                float end,
+                                bool start_with_move_to,
+                                SkPath* path) const {
+  if (contour_index < 0 ||
+      static_cast<size_t>(contour_index) >= measures_.size()) {
+    return false;
+  }
+  SkPathBuilder path_builder;
+  if (!measures_[contour_index]->getSegment(start, end, &path_builder,
+                                            start_with_move_to)) {
+    return false;
+  }
+  *path = path_builder.detach();
+  return true;
+}
+
+bool SpiPathMeasure::IsClosed(int32_t contour_index) const {
+  if (contour_index < 0 ||
+      static_cast<size_t>(contour_index) >= measures_.size()) {
+    return false;
+  }
+  return measures_[contour_index]->isClosed();
+}
+
+bool SpiPathMeasure::NextContour() {
+  sk_sp<SkContourMeasure> measure = path_measure_->next();
+  if (measure == nullptr) {
+    return false;
+  }
+  measures_.push_back(std::move(measure));
+  return true;
+}
+
+}  // namespace flutter
