+  const auto path_value = FindPath(path);
+  if (path_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (out == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  *out = MakeHandle<FlutterSpiPathMeasure>(PathMeasures().Insert(
