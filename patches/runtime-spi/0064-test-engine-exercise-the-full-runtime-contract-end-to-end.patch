+TEST_F(SpiConformance, DisplaysReachRuntime) {
+  StartShell();
+  PostSync(shell_->GetTaskRunners().GetPlatformTaskRunner(), [&] {
+    std::vector<std::unique_ptr<Display>> displays;
+    displays.push_back(std::make_unique<Display>(7, 60.0, 800.0, 600.0, 2.0));
+    shell_->OnDisplayUpdates(std::move(displays));
+  });
+  FlushUi();
+
+  ASSERT_EQ(runtime_->display_count, 1u);
+  EXPECT_EQ(runtime_->displays[0].id, 7u);
+  EXPECT_EQ(runtime_->displays[0].width, 800.0);
+  EXPECT_EQ(runtime_->displays[0].height, 600.0);
+  EXPECT_EQ(runtime_->displays[0].pixel_ratio, 2.0);
+  EXPECT_EQ(runtime_->displays[0].refresh_rate, 60.0);
+}
+
+TEST_F(SpiConformance, HitTestIsAnsweredByRuntime) {
+  runtime_->hit_test_answer = true;
+  StartShell();
+  HitTestResponse response;
+  PostSync(shell_->GetTaskRunners().GetUITaskRunner(), [&] {
+    response = shell_->GetEngine()->HitTest(kImplicitViewId, {12.0, 34.0});
+  });
+
+  EXPECT_TRUE(response.has_platform_view);
+  EXPECT_EQ(runtime_->hit_test_count, 1u);
+  EXPECT_EQ(runtime_->last_hit_test_view_id, kImplicitViewId);
+  EXPECT_EQ(runtime_->last_hit_test_x, 12.0);
+  EXPECT_EQ(runtime_->last_hit_test_y, 34.0);
+}
+
+TEST_F(SpiConformance, DefaultRouteComesFromNavigationMessage) {
