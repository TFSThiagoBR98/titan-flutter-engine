+static void copy_displays(CTestRuntime* runtime,
+                          const FlutterSpiDisplay* displays,
+                          size_t count) {
+  FlutterSpiDisplay* copy;
+
+  free(runtime->displays);
+  runtime->displays = NULL;
+  runtime->display_count = 0;
+  if (displays == NULL || count == 0) {
+    return;
+  }
+  copy = (FlutterSpiDisplay*)malloc(count * sizeof(*copy));
+  if (copy == NULL) {
+    return;
+  }
+  memcpy(copy, displays, count * sizeof(*copy));
+  runtime->displays = copy;
+  runtime->display_count = count;
+}
+
+static void copy_timings(CTestRuntime* runtime,
+                         const int64_t* timings,
+                         size_t count) {
+  int64_t* copy;
+
+  free(runtime->timings);
+  runtime->timings = NULL;
+  runtime->timing_count = 0;
+  if (timings == NULL || count == 0) {
+    return;
+  }
+  copy = (int64_t*)malloc(count * sizeof(*copy));
+  if (copy == NULL) {
+    return;
+  }
+  memcpy(copy, timings, count * sizeof(*copy));
+  runtime->timings = copy;
+  runtime->timing_count = count;
+}
