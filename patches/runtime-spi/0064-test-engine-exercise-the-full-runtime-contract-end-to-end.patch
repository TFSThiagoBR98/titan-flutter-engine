+  PumpOneFrame(shell_.get());
+
+  ASSERT_NE(runtime_->start_default_route_name, nullptr);
+  EXPECT_STREQ(runtime_->start_default_route_name, "/navigation-route");
+}
+
+TEST_F(SpiConformance, AssetIsReadThroughTheSpi) {
