+TEST(SpiSceneTraceTest, KnownTreeHasStableFormatWithoutAddresses) {
+  DisplayListBuilder builder(DisplayListBuilder::kMaxCullRect);
+  builder.DrawRect(DlRect::MakeLTRB(1.0f, 2.0f, 3.0f, 4.0f), DlPaint());
+  auto picture = builder.Build();
+  auto root = std::make_shared<ContainerLayer>();
