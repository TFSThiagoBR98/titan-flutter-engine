+}  // namespace
+
+std::string SceneTrace(const LayerTree& layer_tree) {
+  std::string output = "scene ";
+  AppendNumber(&output, static_cast<float>(layer_tree.frame_size().width));
+  output.push_back('x');
+  AppendNumber(&output, static_cast<float>(layer_tree.frame_size().height));
+  output.push_back('\n');
+  TraceLayer(*layer_tree.root_layer(), &output, 0);
+  return output;
+}
+
+FlutterSpiResult SpiSceneTrace(FlutterSpiScene* scene, char** out_utf8) {
+  if (scene == nullptr || scene->layer_tree == nullptr || out_utf8 == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const std::string trace = SceneTrace(*scene->layer_tree);
+  char* result = static_cast<char*>(std::malloc(trace.size() + 1));
+  if (result == nullptr) {
+    return kFlutterSpiInternalError;
+  }
+  std::memcpy(result, trace.c_str(), trace.size() + 1);
+  *out_utf8 = result;
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiTraceFree(char* trace) {
+  if (trace == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  std::free(trace);
+  return kFlutterSpiOk;
+}
+
+}  // namespace flutter
