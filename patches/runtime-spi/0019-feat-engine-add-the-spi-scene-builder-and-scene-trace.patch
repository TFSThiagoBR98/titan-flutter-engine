+constexpr FlutterSpiRect kClipRect = {
+    .left = 0.0f, .top = 1.0f, .right = 60.0f, .bottom = 70.0f};
+constexpr FlutterSpiRect kPictureRect = {
+    .left = 10.0f, .top = 11.0f, .right = 30.0f, .bottom = 31.0f};
+constexpr FlutterSpiRRect kClipRRect = {
+    .rect = {.left = 2.0f, .top = 3.0f, .right = 50.0f, .bottom = 60.0f},
+    .radii = {{.x = 4.0f, .y = 5.0f},
+              {.x = 6.0f, .y = 7.0f},
+              {.x = 8.0f, .y = 9.0f},
+              {.x = 10.0f, .y = 11.0f}}};
+constexpr FlutterSpiPaint kPaint = {
+    .struct_size = sizeof(FlutterSpiPaint),
+    .color = {.red = 0.1f,
+              .green = 0.2f,
+              .blue = 0.3f,
+              .alpha = 1.0f,
+              .color_space = kFlutterSpiColorSpaceSRGB},
+    .blend_mode = kFlutterSpiBlendModeSrcOver,
+    .style = kFlutterSpiPaintStyleFill,
+    .stroke_width = 1.0f,
+    .stroke_cap = kFlutterSpiStrokeCapButt,
+    .stroke_join = kFlutterSpiStrokeJoinMiter,
+    .stroke_miter = 4.0f,
+    .anti_alias = true,
+    .invert_colors = false,
+};
+
+sk_sp<DisplayList> MakePicture() {
+  DisplayListBuilder builder(DisplayListBuilder::kMaxCullRect);
+  builder.DrawRect(DlRect::MakeLTRB(10.0f, 11.0f, 30.0f, 31.0f),
+                   ToDlPaint(kPaint));
+  builder.DrawCircle({20.0f, 21.0f}, 5.0f,
+                     ToDlPaint(kPaint));
+  return builder.Build();
+}
+
+const DisplayList* FindPictureLayer(const Layer* layer) {
+  if (const auto* picture = layer->as_display_list_layer(); picture != nullptr) {
+    return picture->display_list();
+  }
+  const auto* container = layer->as_container_layer();
+  if (container == nullptr) {
+    return nullptr;
+  }
+  for (const auto& child : container->layers()) {
+    if (const auto* picture = FindPictureLayer(child.get()); picture != nullptr) {
+      return picture;
+    }
+  }
+  return nullptr;
+}
+
+std::shared_ptr<LayerTree> MakeExpectedTree(sk_sp<DisplayList> picture) {
+  auto root = std::make_shared<ContainerLayer>();
+  auto transform = std::make_shared<TransformLayer>(
+      DlMatrix::MakeTranslation({3.0f, 4.0f}));
+  auto clip_rect = std::make_shared<ClipRectLayer>(
+      DlRect::MakeLTRB(0.0f, 1.0f, 60.0f, 70.0f), Clip::kHardEdge);
+  auto clip_rrect = std::make_shared<ClipRRectLayer>(
+      DlRoundRect::MakeRectRadii(
+          DlRect::MakeLTRB(2.0f, 3.0f, 50.0f, 60.0f),
+          {.top_left = {4.0f, 5.0f},
+           .top_right = {6.0f, 7.0f},
+           .bottom_left = {10.0f, 11.0f},
+           .bottom_right = {8.0f, 9.0f}}),
+      Clip::kAntiAlias);
+  DlPathBuilder path_builder;
+  path_builder.AddRect(DlRect::MakeLTRB(0.0f, 1.0f, 60.0f, 70.0f));
+  auto clip_path = std::make_shared<ClipPathLayer>(path_builder.TakePath(),
+                                                   Clip::kAntiAliasWithSaveLayer);
+  auto opacity = std::make_shared<OpacityLayer>(128, DlPoint(5.0f, 6.0f));
+  auto display_list = std::make_shared<DisplayListLayer>(
+      DlPoint(1.0f, 2.0f), std::move(picture), true, true);
+  opacity->Add(display_list);
+  clip_path->Add(opacity);
+  clip_rrect->Add(clip_path);
+  clip_rect->Add(clip_rrect);
+  transform->Add(clip_rect);
+  root->Add(transform);
+  return std::make_shared<LayerTree>(root, DlISize(100, 80));
+}
+
+class SpiSceneBuilderTest : public ::testing::Test {
+ protected:
+  const FlutterSpiSceneApi* api() const { return SpiSceneApi(); }
+
+  FlutterSpiEngine* engine() { return &engine_; }
+
+ private:
+  FlutterSpiEngine engine_{};
+};
+
+TEST_F(SpiSceneBuilderTest, PushesMatchDirectLayerTree) {
+  FlutterSpiPictureRecorder* recorder = nullptr;
+  ASSERT_EQ(api()->recorder_create(engine(), nullptr, &recorder), kFlutterSpiOk);
+  ASSERT_EQ(api()->canvas_draw_rect(recorder, &kPictureRect, &kPaint),
+            kFlutterSpiOk);
+  const FlutterSpiPoint center = {.x = 20.0f, .y = 21.0f};
+  ASSERT_EQ(api()->canvas_draw_circle(recorder, &center, 5.0f, &kPaint),
+            kFlutterSpiOk);
+  FlutterSpiPicture* picture = nullptr;
+  ASSERT_EQ(api()->recorder_finish(recorder, &picture), kFlutterSpiOk);
+
+  FlutterSpiSceneBuilder* builder = nullptr;
+  ASSERT_EQ(api()->scene_builder_create(engine(), &builder), kFlutterSpiOk);
+  FlutterSpiMatrix matrix = {};
+  matrix.m[0] = matrix.m[5] = matrix.m[10] = matrix.m[15] = 1.0f;
+  matrix.m[12] = 3.0f;
+  matrix.m[13] = 4.0f;
+  ASSERT_EQ(api()->scene_push_transform(builder, &matrix), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_clip_rect(builder, &kClipRect,
+                                        kFlutterSpiClipHardEdge),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_clip_rrect(builder, &kClipRRect,
+                                         kFlutterSpiClipAntiAlias),
+            kFlutterSpiOk);
+  FlutterSpiPath* path = nullptr;
+  ASSERT_EQ(api()->path_create(engine(), &path), kFlutterSpiOk);
+  ASSERT_EQ(api()->path_add_rect(path, &kClipRect), kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_clip_path(builder, path,
+                                        kFlutterSpiClipAntiAliasWithSaveLayer),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_push_opacity(builder, 128, 5.0f, 6.0f),
+            kFlutterSpiOk);
+  ASSERT_EQ(api()->scene_add_picture(builder, 1.0f, 2.0f, picture, true, true),
+            kFlutterSpiOk);
+
+  FlutterSpiScene* scene = nullptr;
