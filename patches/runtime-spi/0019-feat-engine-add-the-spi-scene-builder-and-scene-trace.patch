+  const std::string trace = SceneTrace(tree);
+  EXPECT_EQ(trace, "scene 20x30\ncontainer\n  picture 5 6\n    drawRect 1 2 3 4\n");
+  EXPECT_FALSE(std::regex_search(trace, std::regex(R"(0x[0-9a-fA-F]{6,})")));
+}
