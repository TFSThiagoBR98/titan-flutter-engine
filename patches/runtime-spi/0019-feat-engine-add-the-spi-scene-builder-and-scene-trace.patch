+
+std::string Indent(int depth) {
+  return std::string(static_cast<size_t>(depth * kIndentWidth), ' ');
+}
+
+void AppendNumber(std::string* output, float value) {
+  std::array<char, 64> buffer = {};
+  std::snprintf(buffer.data(), buffer.size(), "%.6g", value);
+  output->append(buffer.data());
+}
+
+void AppendRect(std::string* output, const DlRect& rect) {
+  AppendNumber(output, rect.GetLeft());
+  output->push_back(' ');
+  AppendNumber(output, rect.GetTop());
+  output->push_back(' ');
+  AppendNumber(output, rect.GetRight());
+  output->push_back(' ');
+  AppendNumber(output, rect.GetBottom());
+}
+
+void AppendPoint(std::string* output, const DlPoint& point) {
+  AppendNumber(output, point.x);
+  output->push_back(' ');
+  AppendNumber(output, point.y);
+}
