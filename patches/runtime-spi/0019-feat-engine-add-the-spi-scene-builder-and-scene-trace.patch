+class PathTraceReceiver final : public impeller::PathReceiver {
+ public:
+  explicit PathTraceReceiver(std::string* output) : output_(output) {}
+
+  void MoveTo(const impeller::Point& point, bool will_be_closed) override {
+    Append("move ", point);
+    if (will_be_closed) {
+      output_->append(" closed");
+    }
+  }
+
+  void LineTo(const impeller::Point& point) override {
+    Append("line ", point);
+  }
+
+  void QuadTo(const impeller::Point& control_point,
+              const impeller::Point& point) override {
+    output_->append("quad ");
+    AppendPoint(output_, control_point);
+    output_->push_back(' ');
+    AppendPoint(output_, point);
+  }
+
+  bool ConicTo(const impeller::Point& control_point,
+               const impeller::Point& point,
+               impeller::Scalar weight) override {
+    output_->append("conic ");
+    AppendPoint(output_, control_point);
+    output_->push_back(' ');
+    AppendPoint(output_, point);
+    output_->push_back(' ');
+    AppendNumber(output_, weight);
+    return true;
+  }
+
+  void CubicTo(const impeller::Point& control_point_1,
+               const impeller::Point& control_point_2,
+               const impeller::Point& point) override {
+    output_->append("cubic ");
+    AppendPoint(output_, control_point_1);
+    output_->push_back(' ');
+    AppendPoint(output_, control_point_2);
+    output_->push_back(' ');
+    AppendPoint(output_, point);
+  }
+
+  void Close() override { output_->append("close"); }
+
+ private:
+  void Append(const char* prefix, const impeller::Point& point) {
+    output_->append(prefix);
+    AppendPoint(output_, point);
+  }
+
+  std::string* output_;
+};
+
+void AppendPath(std::string* output, const DlPath& path) {
+  output->append(path.GetFillType() == DlPathFillType::kOdd ? "odd" :
+                                                                  "nonzero");
+  output->push_back(' ');
+  PathTraceReceiver receiver(output);
+  path.Dispatch(receiver);
+}
+
+void AppendRRect(std::string* output, const DlRoundRect& rrect) {
+  AppendRect(output, rrect.GetBounds());
+  const auto& radii = rrect.GetRadii();
+  output->push_back(' ');
+  AppendNumber(output, radii.top_left.width);
+  output->push_back(' ');
+  AppendNumber(output, radii.top_left.height);
+  output->push_back(' ');
+  AppendNumber(output, radii.top_right.width);
+  output->push_back(' ');
+  AppendNumber(output, radii.top_right.height);
+  output->push_back(' ');
+  AppendNumber(output, radii.bottom_right.width);
+  output->push_back(' ');
+  AppendNumber(output, radii.bottom_right.height);
+  output->push_back(' ');
+  AppendNumber(output, radii.bottom_left.width);
+  output->push_back(' ');
+  AppendNumber(output, radii.bottom_left.height);
+}
