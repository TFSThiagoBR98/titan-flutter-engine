diff --git a/engine/src/flutter/runtime_spi/scene/spi_scene_builder.cc b/engine/src/flutter/runtime_spi/scene/spi_scene_builder.cc
new file mode 100644
index 00000000000..e0174866df6
--- /dev/null
+++ b/engine/src/flutter/runtime_spi/scene/spi_scene_builder.cc
@@ -0,0 +1,248 @@
+// Copyright 2026 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/runtime_spi/scene/spi_scene_builder.h"
+
+#include <cmath>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "flutter/flow/layers/clip_path_layer.h"
+#include "flutter/flow/layers/clip_rect_layer.h"
+#include "flutter/flow/layers/clip_rrect_layer.h"
+#include "flutter/flow/layers/container_layer.h"
+#include "flutter/flow/layers/display_list_layer.h"
+#include "flutter/flow/layers/opacity_layer.h"
+#include "flutter/flow/layers/transform_layer.h"
+#include "flutter/runtime_spi/scene/spi_canvas.h"
+#include "flutter/runtime_spi/scene/spi_geometry.h"
+#include "flutter/runtime_spi/scene/spi_handle_table.h"
+#include "flutter/runtime_spi/spi_scene.h"
+
+struct FlutterSpiSceneBuilder {
+  std::shared_ptr<flutter::ContainerLayer> root =
+      std::make_shared<flutter::ContainerLayer>();
+  std::vector<std::shared_ptr<flutter::ContainerLayer>> layer_stack = {root};
+};
+
+namespace flutter {
+namespace {
+
+SpiHandleTable<FlutterSpiSceneBuilder>& Builders() {
+  static SpiHandleTable<FlutterSpiSceneBuilder> builders;
+  return builders;
+}
+
+template <typename Handle>
+uintptr_t HandleValue(Handle* handle) {
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+Handle* MakeHandle(uintptr_t value) {
+  return reinterpret_cast<Handle*>(value);
+}
+
+std::shared_ptr<FlutterSpiSceneBuilder> FindBuilder(
+    FlutterSpiSceneBuilder* builder) {
+  return Builders().Find(HandleValue(builder));
+}
+
+FlutterSpiResult ToResult(bool succeeded) {
+  return succeeded ? kFlutterSpiOk : kFlutterSpiInvalidHandle;
+}
+
+bool IsValidClipBehavior(int32_t clip_behavior) {
+  return clip_behavior >= kFlutterSpiClipHardEdge &&
+         clip_behavior <= kFlutterSpiClipAntiAliasWithSaveLayer;
+}
+
+Clip ToClip(int32_t clip_behavior) {
+  return static_cast<Clip>(clip_behavior);
+}
+
+void AddLayer(const std::shared_ptr<Layer>& layer,
+              const std::shared_ptr<FlutterSpiSceneBuilder>& builder) {
+  builder->layer_stack.back()->Add(layer);
+}
+
+void PushLayer(const std::shared_ptr<ContainerLayer>& layer,
+               const std::shared_ptr<FlutterSpiSceneBuilder>& builder) {
+  AddLayer(layer, builder);
+  builder->layer_stack.push_back(layer);
+}
+
+}  // namespace
+
+FlutterSpiResult SpiSceneBuilderCreate(FlutterSpiEngine* engine,
+                                       FlutterSpiSceneBuilder** out_builder) {
+  if (engine == nullptr || out_builder == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  const uintptr_t handle =
+      Builders().Insert(std::make_shared<FlutterSpiSceneBuilder>());
+  *out_builder = MakeHandle<FlutterSpiSceneBuilder>(handle);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushTransform(FlutterSpiSceneBuilder* builder,
+                                       const FlutterSpiMatrix* matrix) {
+  const auto builder_value = FindBuilder(builder);
+  DlMatrix dl_matrix;
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (matrix == nullptr || !ToDlMatrix(*matrix, &dl_matrix)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<TransformLayer>(dl_matrix), builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushOffset(FlutterSpiSceneBuilder* builder,
+                                    float dx,
+                                    float dy) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (!std::isfinite(dx) || !std::isfinite(dy)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<TransformLayer>(
+                DlMatrix::MakeTranslation({dx, dy})),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushClipRect(FlutterSpiSceneBuilder* builder,
+                                      const FlutterSpiRect* rect,
+                                      int32_t clip_behavior) {
+  const auto builder_value = FindBuilder(builder);
+  DlRect dl_rect;
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (rect == nullptr || !ToDlRect(*rect, &dl_rect) ||
+      !IsValidClipBehavior(clip_behavior)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<ClipRectLayer>(dl_rect, ToClip(clip_behavior)),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushClipRRect(FlutterSpiSceneBuilder* builder,
+                                       const FlutterSpiRRect* rrect,
+                                       int32_t clip_behavior) {
+  const auto builder_value = FindBuilder(builder);
+  DlRoundRect dl_rrect;
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (rrect == nullptr || !ToDlRoundRect(*rrect, &dl_rrect) ||
+      !IsValidClipBehavior(clip_behavior)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<ClipRRectLayer>(dl_rrect, ToClip(clip_behavior)),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushClipPath(FlutterSpiSceneBuilder* builder,
+                                      FlutterSpiPath* path,
+                                      int32_t clip_behavior) {
+  const auto builder_value = FindBuilder(builder);
+  const auto path_value = SpiPathForTesting(path);
+  if (builder_value == nullptr || path_value == nullptr) {
+    return builder_value == nullptr ? kFlutterSpiInvalidHandle
+                                    : kFlutterSpiInvalidArgument;
+  }
+  if (!IsValidClipBehavior(clip_behavior)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<ClipPathLayer>(*path_value, ToClip(clip_behavior)),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePushOpacity(FlutterSpiSceneBuilder* builder,
+                                     int32_t alpha,
+                                     float dx,
+                                     float dy) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (alpha < 0 || alpha > 255 || !std::isfinite(dx) ||
+      !std::isfinite(dy)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  PushLayer(std::make_shared<OpacityLayer>(
+                static_cast<uint8_t>(alpha), DlPoint(dx, dy)),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiScenePop(FlutterSpiSceneBuilder* builder) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (builder_value->layer_stack.size() > 1) {
+    builder_value->layer_stack.pop_back();
+  }
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiSceneAddPicture(FlutterSpiSceneBuilder* builder,
+                                    float dx,
+                                    float dy,
+                                    FlutterSpiPicture* picture,
+                                    bool is_complex,
+                                    bool will_change) {
+  const auto builder_value = FindBuilder(builder);
+  const auto* display_list = SpiPictureDisplayListForTesting(picture);
+  if (builder_value == nullptr || display_list == nullptr) {
+    return builder_value == nullptr ? kFlutterSpiInvalidHandle
+                                    : kFlutterSpiInvalidArgument;
+  }
+  if (!std::isfinite(dx) || !std::isfinite(dy)) {
+    return kFlutterSpiInvalidArgument;
+  }
+  AddLayer(std::make_shared<DisplayListLayer>(
+                DlPoint(dx, dy), sk_ref_sp(display_list), is_complex,
+                will_change),
+            builder_value);
+  return kFlutterSpiOk;
+}
+
+FlutterSpiResult SpiSceneBuild(FlutterSpiSceneBuilder* builder,
+                               int64_t width_px,
+                               int64_t height_px,
+                               FlutterSpiScene** out_scene) {
+  const auto builder_value = FindBuilder(builder);
+  if (builder_value == nullptr) {
+    return kFlutterSpiInvalidHandle;
+  }
+  if (width_px <= 0 || height_px <= 0 || out_scene == nullptr) {
+    return kFlutterSpiInvalidArgument;
+  }
+  while (builder_value->layer_stack.size() > 1) {
+    builder_value->layer_stack.pop_back();
+  }
+  const FlutterSpiResult result = SpiSceneCreateFromLayerTree(
+      width_px, height_px, std::move(builder_value->root), out_scene);
+  if (result == kFlutterSpiOk) {
+    Builders().Release(HandleValue(builder));
+  }
+  return result;
+}
+
+FlutterSpiResult SpiSceneBuilderRelease(FlutterSpiSceneBuilder* builder) {
+  return ToResult(Builders().Release(HandleValue(builder)));
+}
+
+}  // namespace flutter
