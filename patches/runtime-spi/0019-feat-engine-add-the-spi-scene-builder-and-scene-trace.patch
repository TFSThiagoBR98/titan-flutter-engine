+
+void TraceChildren(const ContainerLayer& layer,
+                   std::string* output,
+                   int depth);
+
+void TraceLayer(const Layer& layer, std::string* output, int depth) {
+  const std::string indent = Indent(depth);
+  if (const auto* picture = layer.as_display_list_layer(); picture != nullptr) {
+    output->append(indent);
+    output->append("picture ");
+    AppendPoint(output, picture->offset());
+    output->push_back('\n');
+    TraceDisplayList(*picture->display_list(), output, depth + 1);
+    return;
+  }
+  if (const auto* transform = layer.as_transform_layer(); transform != nullptr) {
+    output->append(indent);
+    output->append("transform [");
+    for (size_t index = 0; index < 16; ++index) {
+      if (index != 0) {
+        output->push_back(' ');
+      }
+      AppendNumber(output, transform->transform().m[index]);
+    }
+    output->append("]\n");
+    TraceChildren(*transform, output, depth + 1);
+    return;
+  }
+  if (const auto* clip_rect = layer.as_clip_rect_layer();
+      clip_rect != nullptr) {
+    output->append(indent);
+    output->append("clip_rect ");
+    AppendRect(output, clip_rect->clip_shape());
+    output->push_back(' ');
+    AppendNumber(output, static_cast<float>(clip_rect->clip_behavior()));
+    output->push_back('\n');
+    TraceChildren(*clip_rect, output, depth + 1);
+    return;
+  }
+  if (const auto* clip_rrect = layer.as_clip_rrect_layer();
+      clip_rrect != nullptr) {
+    output->append(indent);
+    output->append("clip_rrect ");
+    AppendRRect(output, clip_rrect->clip_shape());
+    output->push_back(' ');
+    AppendNumber(output, static_cast<float>(clip_rrect->clip_behavior()));
+    output->push_back('\n');
+    TraceChildren(*clip_rrect, output, depth + 1);
+    return;
+  }
+  if (const auto* clip_path = layer.as_clip_path_layer(); clip_path != nullptr) {
+    output->append(indent);
+    output->append("clip_path ");
+    AppendPath(output, clip_path->clip_shape());
+    output->push_back(' ');
+    AppendNumber(output, static_cast<float>(clip_path->clip_behavior()));
+    output->push_back('\n');
+    TraceChildren(*clip_path, output, depth + 1);
+    return;
+  }
+  if (const auto* opacity = layer.as_opacity_layer(); opacity != nullptr) {
+    output->append(indent);
+    output->append("opacity ");
+    AppendNumber(output, static_cast<float>(opacity->alpha()));
+    output->push_back(' ');
+    AppendPoint(output, opacity->offset());
+    output->push_back('\n');
+    TraceChildren(*opacity, output, depth + 1);
+    return;
+  }
+  if (layer.as_container_layer() != nullptr) {
+    output->append(indent);
+    output->append("container\n");
+    TraceChildren(*layer.as_container_layer(), output, depth + 1);
+    return;
+  }
+  output->append(indent);
+  output->append("layer <desconhecida>\n");
+}
+
+void TraceChildren(const ContainerLayer& layer,
+                   std::string* output,
+                   int depth) {
+  for (const auto& child : layer.layers()) {
+    TraceLayer(*child, output, depth);
+  }
+}
