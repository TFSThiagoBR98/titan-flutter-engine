+void ShellTest::PumpOneFrameFromRuntime(
+    Shell* shell,
+    int64_t view_id,
+    const ViewportMetrics& viewport_metrics) {
+  fml::AutoResetWaitableEvent latch;
+  shell->GetTaskRunners().GetUITaskRunner()->PostTask(
+      [&latch, engine = shell->weak_engine_, view_id, viewport_metrics]() {
+        engine->SetViewportMetrics(view_id, viewport_metrics);
+        const auto frame_begin_time = fml::TimePoint::Now();
+        const auto frame_end_time =
+            frame_begin_time + fml::TimeDelta::FromSecondsF(1.0 / 60.0);
+        std::unique_ptr<FrameTimingsRecorder> recorder =
+            std::make_unique<FrameTimingsRecorder>();
+        recorder->RecordVsync(frame_begin_time, frame_end_time);
+        engine->animator_->BeginFrame(std::move(recorder));
+        engine->animator_->EndFrame();
+        latch.Signal();
+      });
+  latch.Wait();
+}
