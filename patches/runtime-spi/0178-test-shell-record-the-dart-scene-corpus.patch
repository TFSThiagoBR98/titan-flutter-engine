+part of 'shell_test.dart';
+
+typedef _ScenePainter = void Function(Canvas canvas);
+typedef _SceneBuilderPainter = void Function(SceneBuilder builder, Picture picture);
+
+const Rect _sceneBounds = Rect.fromLTWH(0, 0, 200, 150);
+const Rect _testRect = Rect.fromLTRB(1, 2, 30, 40);
+final RSuperellipse _testRSuperellipse = RSuperellipse.fromLTRBAndCorners(
+  1,
+  2,
+  30,
+  40,
+  topLeft: Radius.elliptical(4, 5),
+  topRight: Radius.elliptical(6, 7),
+  bottomRight: Radius.elliptical(8, 9),
+  bottomLeft: Radius.elliptical(10, 11),
+);
+
+Paint _testPaint() => Paint()..color = const Color(0xFF1A334D);
+
+void _renderPicture(_ScenePainter painter) {
+  PlatformDispatcher.instance.onError = (Object error, StackTrace? stack) {
+    print('$error\n$stack');
+    return true;
+  };
+  PlatformDispatcher.instance.onBeginFrame = (_) {
+    final FlutterView view = PlatformDispatcher.instance.implicitView!;
+    final PictureRecorder recorder = PictureRecorder();
+    final Canvas canvas = Canvas(recorder, _sceneBounds);
+    painter(canvas);
+    final Picture picture = recorder.endRecording();
+    final SceneBuilder builder = SceneBuilder()..addPicture(Offset.zero, picture);
+    view.render(builder.build());
+  };
+}
+
+void _renderBuilder(_SceneBuilderPainter painter) {
+  PlatformDispatcher.instance.onError = (Object error, StackTrace? stack) {
+    print('$error\n$stack');
+    return true;
+  };
+  PlatformDispatcher.instance.onBeginFrame = (_) {
+    final FlutterView view = PlatformDispatcher.instance.implicitView!;
+    final PictureRecorder recorder = PictureRecorder();
+    final Canvas canvas = Canvas(recorder, _sceneBounds);
+    canvas.drawRect(_testRect, _testPaint());
+    final Picture picture = recorder.endRecording();
+    final SceneBuilder builder = SceneBuilder();
+    painter(builder, picture);
+    view.render(builder.build());
+  };
+}
+
+void _drawPath(Canvas canvas, Path path) {
+  canvas.drawPath(path, _testPaint());
+}
+
+Path _measuredPath() => Path()
+  ..moveTo(0, 0)
+  ..lineTo(3, 4)
+  ..close()
+  ..moveTo(10, 10)
+  ..lineTo(13, 14);
+
+void _drawMeasuredSegment(Canvas canvas, PathMetric metric, double start, double end) {
+  _drawPath(canvas, metric.extractPath(start, end));
+}
