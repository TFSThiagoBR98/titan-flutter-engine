# Why: the flutter tool downloads sky_engine.zip and flutter_gpu.zip for every
# SDK, but the engine only defines their archive targets for Android. Define the
# old-location archives on Linux too so the host SDK artifacts include them.
diff --git a/engine/src/flutter/lib/gpu/dist/BUILD.gn b/engine/src/flutter/lib/gpu/dist/BUILD.gn
index c8ea07f2164..99f63b7fd51 100644
--- a/engine/src/flutter/lib/gpu/dist/BUILD.gn
+++ b/engine/src/flutter/lib/gpu/dist/BUILD.gn
@@ -14,16 +14,20 @@ import("//flutter/build/zip_bundle.gni")
 # complete Dart package. So no additional build steps are necessary beyond
 # zipping it up.
 
-if (is_android) {
-  zip_bundle("zip") {
-    output = "$android_zip_archive_dir/flutter_gpu.zip"
-    files = [
-      {
-        source = "//flutter/lib/gpu"
-        destination = "flutter_gpu"
-      },
-    ]
-    deps = []
+# The Linux SDK artifacts ship these packages too (sky_engine.zip,
+# flutter_gpu.zip at the old location the flutter tool downloads).
+if (is_android || is_linux) {
+  if (is_android) {
+    zip_bundle("zip") {
+      output = "$android_zip_archive_dir/flutter_gpu.zip"
+      files = [
+        {
+          source = "//flutter/lib/gpu"
+          destination = "flutter_gpu"
+        },
+      ]
+      deps = []
+    }
   }
 
   zip_bundle("zip_old_location") {
