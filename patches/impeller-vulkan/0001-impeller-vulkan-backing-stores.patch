+// Impeller needs the embedder-provided Vulkan image wrapped like a swapchain
+// image; without this path, Vulkan backing stores cannot support multiple views.
+static std::unique_ptr<flutter::EmbedderRenderTarget>
+MakeRenderTargetFromBackingStoreImpeller(
+    FlutterBackingStore backing_store,
+    const fml::closure& on_release,
+    const std::shared_ptr<impeller::AiksContext>& aiks_context,
+    const FlutterBackingStoreConfig& config,
+    const FlutterVulkanBackingStore* vulkan) {
+#if defined(SHELL_ENABLE_VULKAN) && defined(IMPELLER_SUPPORTS_RENDERING)
+  if (!vulkan->image) {
+    FML_LOG(ERROR) << "Embedder supplied null Vulkan image.";
+    return nullptr;
+  }
+
+  const impeller::vk::Format vk_format =
+      static_cast<impeller::vk::Format>(vulkan->image->format);
+  const std::optional<impeller::PixelFormat> format =
+      impeller::VkFormatToImpellerFormat(vk_format);
+  if (!format.has_value()) {
+    FML_LOG(ERROR) << "Unsupported Vulkan pixel format: "
+                   << impeller::vk::to_string(vk_format);
+    return nullptr;
+  }
+
+  impeller::TextureDescriptor desc;
+  desc.format = format.value();
+  desc.size = impeller::ISize(config.size.width, config.size.height);
+  desc.storage_mode = impeller::StorageMode::kDevicePrivate;
+  desc.mip_count = 1;
+  desc.compression_type = impeller::CompressionType::kLossless;
+  desc.usage = impeller::TextureUsage::kRenderTarget;
+
+  const impeller::vk::Image vk_image(
+      reinterpret_cast<VkImage>(vulkan->image->image));
+  auto wrapped_image = impeller::WrapTextureSourceVK(
+      aiks_context->GetContext(), desc, vk_image);
+  if (!wrapped_image) {
+    FML_LOG(ERROR) << "Could not wrap embedder supplied Vulkan render texture.";
+    return nullptr;
+  }
+
+  const auto transients = std::make_shared<impeller::SwapchainTransientsVK>(
+      aiks_context->GetContext(), desc, /*enable_msaa=*/true);
+  auto surface = impeller::SurfaceVK::WrapSwapchainImage(
+      transients, wrapped_image, []() -> bool { return true; });
+  if (!surface) {
+    FML_LOG(ERROR) << "Could not create an Impeller Vulkan render target.";
+    return nullptr;
+  }
+
+  impeller::RenderTarget render_target = surface->GetRenderTarget();
+  fml::closure vulkan_destruct =
+      [callback = vulkan->destruction_callback,
+       user_data = vulkan->user_data]() {
+        if (callback) {
+          callback(user_data);
+        }
+      };
+
+  return std::make_unique<flutter::EmbedderRenderTargetImpeller>(
+      backing_store, aiks_context,
+      std::make_unique<impeller::RenderTarget>(std::move(render_target)),
+      on_release, std::move(vulkan_destruct));
+#else
+  return nullptr;
+#endif
+}
