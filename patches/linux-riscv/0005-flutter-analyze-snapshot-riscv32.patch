# Why: Flutter's top-level Linux group requests analyze_snapshot for every
# target, but Dart defines that tool only for 64-bit AOT targets. Keep the
# dependency for supported 64-bit CPUs and omit it for riscv32.
# Repo: engine/src/flutter
diff --git a/engine/src/flutter/BUILD.gn b/engine/src/flutter/BUILD.gn
index 524cc5b8b11..a357553f318 100644
--- a/engine/src/flutter/BUILD.gn
+++ b/engine/src/flutter/BUILD.gn
@@ -128,7 +128,9 @@ group("flutter") {
         ]
       }

-      if (host_os == "linux") {
+      if (host_os == "linux" &&
+          (target_cpu == "x64" || target_cpu == "arm64" ||
+           target_cpu == "riscv64")) {
         public_deps += [
           # Built alongside gen_snapshot for 64 bit targets
           "$dart_src/runtime/bin:analyze_snapshot",
